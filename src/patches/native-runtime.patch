+#include "fixture_expected.h"
+#include "host.h"
+#include <algorithm>
+#include <csignal>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+#include <type_traits>
+static_assert(!std::is_copy_assignable_v<native::AddressSpace> &&
+              !std::is_move_assignable_v<native::AddressSpace>);
+#define MODULE(n)                                                              \
+  extern "C" {                                                                 \
+  BlockFn recomp_image_lookup_##n(uint64_t);                                   \
+  void recomp_image_run_slice_##n(GuestContext *);                             \
+  void recomp_image_set_base_##n(uint64_t);                                    \
+  unsigned recomp_image_guard_v2_##n(unsigned);                                \
+  uint32_t *recomp_image_guard_gen_v1_##n(uint32_t, uint64_t *, uint64_t *,    \
+                                          const uint64_t **);                  \
+  }
+MODULE(a) MODULE(b) MODULE(fixture) using native::Host;
+static const uint32_t a_code[] = {0xd61f0280};
+static const uint32_t b_code[] = {
+    0xf94000a4, 0xf90000c4, 0xd53be027, 0xd40004e1, 0xd2800c80,
+    0xd4000161, 0xd40000e1, 0xd4000fe1, 0xc85f7cad, 0xc80e7cad,
+    0xd5033bbf, 0xd4200000, 0xffffffff};
+static void check(bool good, const char *why) {
+  if (!good)
+    throw std::runtime_error(why);
+}
+template <class F> static void fails(F f, const char *why) {
+  bool failed = false;
+  try {
+    f();
+  } catch (const std::runtime_error &) {
+    failed = true;
+  }
+  check(failed, why);
+}
+static void page(Host &h, uint64_t at, const void *data, size_t n, unsigned p) {
+  std::array<uint8_t, 4096> bytes{};
+  memcpy(bytes.data(), data, n);
+  h.map(at, bytes.data(), bytes.size(), p);
+}
+static void init(Host &h) {
+  page(h, 0x1000, b_code, sizeof(b_code), 5);
+  page(h, 0x2000, a_code, sizeof(a_code), 5);
+  std::array<uint8_t, 4096> data{};
+  memcpy(data.data() + 0x100, "12345678", 8);
+  memcpy(data.data() + 0x300, "OK", 2);
+  h.map(0x3000, data.data(), 4096, 3);
+  h.modules = {{"a", recomp_image_lookup_a, recomp_image_run_slice_a},
+               {"b", recomp_image_lookup_b, recomp_image_run_slice_b}};
+  recomp_image_set_base_a(0);
+  recomp_image_set_base_b(0);
+  recomp_image_guard_v2_a(2);
+  recomp_image_guard_v2_b(2);
+  for (unsigned i = 0; i < 32; ++i) {
+    h.context.x[i] = 0x100 + i;
+    h.context.vreg[i][0] = 0x1200 + i;
+    h.context.vreg[i][1] = 0x3400 + i;
+  }
+  h.context.n = 1;
+  h.context.c = 1;
+  h.context.fpcr = 0x400000;
+  h.context.fpsr = 0x80000000;
+  h.context.tpidr_el0 = 0x5500;
+  h.context.tpidrro_el0 = 0x6600;
+  h.context.pc = 0x2000;
+  h.context.x[20] = 0x1000;
+  h.context.x[0] = 0x3300;
+  h.context.x[1] = 2;
+  h.context.x[5] = 0x3100;
+  h.context.x[6] = 0x3200;
+  h.ticks = 77;
+}
+static Host *guarded;
+static void abort_guard(int) {
+  std::_Exit(guarded && guarded->events.empty() && guarded->context.pc == 0x1000
+                 ? 86
+                 : 87);
+}
+int main(int argc, char **argv) {
+  try {
+    if (argc < 2)
+      return 2;
+    if (argc > 2 && std::string(argv[2]) == "load") {
+      native::load_synthetic(argv[1], expected_text, sizeof(expected_text));
+      return 0;
+    }
+    if (argc > 2 && (std::string(argv[2]) == "seal-cache" ||
+                     std::string(argv[2]) == "seal-bad")) {
+      Host h;
+      init(h);
+      native::AddressSpace space;
+      std::vector<uint8_t> code(h.memory.begin() + 0x1000,
+                                h.memory.begin() + 0x2000),
+          data(h.memory.begin() + 0x3000, h.memory.begin() + 0x4000);
+      if (std::string(argv[2]) == "seal-bad")
+        code[0] ^= 0x20;
+      space.map(0x1000, code, 4096, 5, 3);
+      space.map(0x3000, data, 4096, 3);
+      h.address_space = &space;
+      h.context.pc = 0x1000;
+      uint64_t lo, end;
+      const uint64_t *base;
+      auto word = recomp_image_guard_gen_v1_b(2, &lo, &end, &base);
+      h.seal_code();
+      RECOMP_GG_STORE_RELEASE(*word, 1u);
+      if (std::string(argv[2]) == "seal-bad") {
+        guarded = &h;
+        std::signal(SIGABRT, abort_guard);
+      }
+      h.context.chain_budget = 1;
+      recomp_image_run_slice_b(&h.context);
+      check(h.instruction_reads > 0,
+            "sealed code first entry verifies exact words");
+      const auto reads = h.instruction_reads;
+      h.context.pc = 0x1000;
+      h.context.pending_svc = ~UINT64_C(0);
+      h.context.chain_budget = 1;
+      recomp_image_run_slice_b(&h.context);
+      check(h.instruction_reads == reads,
+            "sealed code repeat uses generation cache");
+      auto rejects = [&](auto action) {
+        try {
+          action();
+        } catch (const std::runtime_error &) {
+          return true;
+        }
+        return false;
+      };
+      const auto original = space.read(0x1000, 4, true);
+      check(rejects([&] { h.write(0x1000, 4, 0); }) &&
+                space.read(0x1000, 4, true) == original,
+            "sealed RX write rejects without changing bytes");
+      check(rejects([&] { space.map(0x1000, code, 4096, 5, 3); }),
+            "sealed overlap rejects");
+      check(rejects([&] { space.map(0x4000, code, 4096, 5, 3); }),
+            "new executable map after seal rejects");
+      code[0] ^= 0x20;
+      check(space.read(0x1000, 4, true) == original,
+            "source vector does not alias sealed backing");
+      native::AddressSpace replacement;
+      h.address_space = &replacement;
+      auto context = h.context;
+      check(rejects([&] { h.dispatch(1); }) &&
+                !memcmp(&context, &h.context, sizeof(context)),
+            "sealed addressspace swap fails before guest effects");
+      return 0;
+    }
+    if (argc > 2 && std::string(argv[2]) == "guard") {
+      Host h;
+      init(h);
+      uint64_t lo, end;
+      const uint64_t *base;
+      auto word = recomp_image_guard_gen_v1_b(2, &lo, &end, &base);
+      *word = 1;
+      h.context.pc = 0x1000;
+      h.context.chain_budget = 1;
+      recomp_image_run_slice_b(&h.context);
+      h.memory[0x1000] ^= 0x20;
+      *word = 2;
+      h.events.clear();
+      h.context.pc = 0x1000;
+      h.context.pending_svc = ~UINT64_C(0);
+      guarded = &h;
+      std::signal(SIGABRT, abort_guard);
+      recomp_image_run_slice_b(&h.context);
+      return 88;
+    }
+    for (unsigned budget : {1u, 3u, 4096u}) {
+      Host h;
+      init(h);
+      GuestContext expected = h.context;
+      expected.x[0] = 100;
+      memcpy(&expected.x[4], h.memory.data() + 0x3100, 8);
+      expected.x[7] = 77;
+      expected.pc = 0x101c;
+      h.dispatch(budget);
+      expected.chain_budget = h.context.chain_budget;
+      check(!memcmp(&expected, &h.context, sizeof(expected)),
+            "complete architectural context across slices/SVC");
+      check(h.exited && h.output == "OK" && h.sleep_ns == 100 && h.ticks == 78,
+            "deterministic native SVC/sleep/exit");
+      check(h.context.x[7] == 77 && h.context.pc == 0x101c,
+            "counter and exact SVC PC");
+      check(!memcmp(h.memory.data() + 0x3100, h.memory.data() + 0x3200, 8),
+            "generated memory copy");
+      check(h.events.size() == 4 && h.events[0].address == 0x3100 &&
+                !h.events[0].write && h.events[1].address == 0x3200 &&
+                h.events[1].write,
+            "ordered bus trace");
+    }
+    {
+      Host h;
+      init(h);
+      h.interrupt = true;
+      auto before = h.context;
+      h.dispatch(3);
+      check(!memcmp(&before, &h.context, sizeof(before)),
+            "interrupt before slice");
+      h.interrupt = false;
+      h.context.pc = 0x101c;
+      fails([&] { h.dispatch(1); }, "unsupported SVC fatal");
+      check(h.context.pending_svc == 0x7f, "unsupported SVC remains pending");
+      h.context.pending_svc = ~UINT64_C(0);
+      h.context.pc = 0xdead;
+      fails([&] { h.dispatch(1); }, "unresolved import/PC fatal");
+      h.context.pc = 0x1030;
+      fails([&] { h.dispatch(1); }, "unhandled never falls back");
+    }
+    {
+      Host h;
+      init(h);
+      h.context.pc = 0x1020;
+      h.context.chain_budget = 1;
+      recomp_image_run_slice_b(&h.context);
+      check(h.context.halted == RECOMP_HALT_BREAKPOINT && h.context.x[14] == 0,
+            "generated exclusive and barrier block");
+      auto value = h.bridge.excl_load(&h, 0x3100, 8);
+      h.write(0x3200, 8, 5);
+      check(h.bridge.excl_store(&h, 0x3100, 8, value) == 1,
+            "shared reservation invalidation");
+      uint64_t lo, hi;
+      h.bridge.excl_load_pair(&h, 0x3100, 8, &lo, &hi);
+      check(h.bridge.excl_store_pair(&h, 0x3100, 8, lo, hi) == 0,
+            "pair reservation");
+      auto image = h.memory;
+      fails([&] { h.write(0x1000, 8, 0); }, "code write protection");
+      fails([&] { h.write(0x3ffc, 8, 0); }, "cross-page unmapped rejection");
+      check(h.memory == image, "failed bus writes have no effects");
+    }
+    {
+      auto loaded =
+          native::load_synthetic(argv[1], expected_text, sizeof(expected_text));
+      check(loaded.program_id == UINT64_C(0x0100000000E57A00) &&
+                loaded.romfs_name == "fixture.txt" &&
+                loaded.romfs_data == "suyu synthetic export fixture\n",
+            "native metadata/RomFS parser");
+      Host h;
+      h.allowed_svcs = loaded.allowed_svcs;
+      h.map(0, loaded.image.data(), 4096, 5);
+      h.map(4096, loaded.image.data() + 4096, 4096, 1);
+      h.map(8192, loaded.image.data() + 8192, 4096, 3);
+      h.modules = {{"fixture", recomp_image_lookup_fixture,
+                    recomp_image_run_slice_fixture}};
+      recomp_image_set_base_fixture(0);
+      recomp_image_guard_v2_fixture(2);
+      h.dispatch(3);
+      check(h.exited && h.output == "SUYU_EXPORT_FIXTURE_OK\n" &&
+                h.sleep_ns == 100000000 && h.ticks == 1920000,
+            "synthetic NSO native boot trace");
+      fails(
+          [&] {
+            native::load_synthetic(std::filesystem::path(argv[1]) / "missing",
+                                   expected_text, sizeof(expected_text));
+          },
+          "missing content fatal");
+    }
+    std::cout << "PASS native StageA two-module CPU/bus/scheduler/SVC/guards; "
+                 "StageB NSO/NPDM/RomFS debug/sleep/exit\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << "FAIL " << e.what() << "\n";
+    return 1;
+  }
+}
