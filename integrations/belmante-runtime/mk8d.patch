+// SPDX-License-Identifier: GPL-3.0-or-later
+// The storage a texture struct described when a command naming it was recorded (render targets, copies).
+//
+// The replay resolves every struct as it was when the submit's lists ended recording (nvn_incarnation.cpp). agl re-
+// initializes one scratch NVNtexture many times within a single command list (a cube, a 2D array, mip chains, ...),
+// rendering into each shape in turn: replayed, every one of those draws went to the last shape, and the cube that the
+// environment generator samples was never written (the characters' image based lighting came out black). Commands
+// keep the shape their struct had when recorded, and a replay whose struct has another shape uses a live texture
+// over exactly the recorded storage instead (NX_TARGET_RECORDED_SHAPE=0: the struct's shape at the mark, as before) (live textures over one storage share one image,
+// nvn_image.cpp), which is the texture the game samples it through.
+#pragma once
+#include <cstdint>
+#include <cstdlib>
+#include <mutex>
+#include <shared_mutex>
+#include <map>
+#include <tuple>
+
+#include "nvn.h"
+
+namespace nx::nvn {
+
+struct RecordedShape {
+    uint64_t memory = 0;
+    uint32_t format = 0, target = 0, width = 0, height = 0, depth = 0, levels = 0, samples = 0, valid = 0;
+    auto tie() const { return std::tie(memory, format, target, width, height, depth, levels, samples); }
+    bool operator<(const RecordedShape& o) const { return tie() < o.tie(); }
+};
+
+inline RecordedShape recorded_shape_of(const Texture* t) {
+    if (!t) return {};
+    return {t->memory, t->format, t->target, t->width, t->height, t->depth, t->levels, t->samples, 1};
+}
+
+inline bool recorded_shape_matches(const Texture& t, const RecordedShape& s) {
+    return t.memory == s.memory && t.format == s.format && t.target == s.target && t.width == s.width &&
+           t.height == s.height && t.depth == s.depth && t.levels == s.levels && t.samples == s.samples;
+}
+
+inline bool target_recorded_shape_on() {
+    static const bool on = [] {
+        const char* e = std::getenv("NX_TARGET_RECORDED_SHAPE");
+        return !e || e[0] != '0';
+    }();
+    return on;
+}
+
+}  // namespace nx::nvn
