@@ -0,0 +1,461 @@
+#include "native_graphics.h"
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#define VK_NO_PROTOTYPES
+#include <cstring>
+#include <functional>
+#include <memory>
+#include <sirit/sirit.h>
+#include <stdexcept>
+#include <vector>
+#include <vulkan/vulkan.h>
+#include <windows.h>
+namespace native_graphics {
+namespace {
+void Check(VkResult r, const char *operation) {
+  if (r != VK_SUCCESS)
+    throw std::runtime_error(std::string(operation) +
+                             " failed VkResult=" + std::to_string(r));
+}
+struct Owned {
+  HMODULE loader = LoadLibraryW(L"vulkan-1.dll");
+  std::vector<std::function<void()>> release;
+  ~Owned() {
+    for (auto i = release.rbegin(); i != release.rend(); ++i)
+      (*i)();
+    if (loader)
+      FreeLibrary(loader);
+  }
+  template <class T> T Get(const char *name) {
+    auto p = loader ? GetProcAddress(loader, name) : nullptr;
+    if (!p)
+      throw std::runtime_error(
+          std::string("Unsupported Vulkan loader export: ") + name);
+    return reinterpret_cast<T>(p);
+  }
+};
+#define V(name) owner.Get<PFN_##name>(#name)
+std::vector<uint32_t> Shader(bool vertex) {
+  Sirit::Module m(0x00010000);
+  m.AddCapability(spv::Capability::Shader);
+  m.SetMemoryModel(spv::AddressingModel::Logical, spv::MemoryModel::GLSL450);
+  auto f = m.TypeFloat(32), v = m.TypeVector(f, 4),
+       out = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Output, v),
+                                 spv::StorageClass::Output);
+  if (vertex)
+    m.Decorate(out, spv::Decoration::BuiltIn, spv::BuiltIn::Position);
+  else
+    m.Decorate(out, spv::Decoration::Location, 0u);
+  Sirit::Id input{};
+  if (vertex) {
+    input = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Input, v),
+                                spv::StorageClass::Input);
+    m.Decorate(input, spv::Decoration::Location, 0u);
+  }
+  auto zero = m.Constant(f, 0.0f), one = m.Constant(f, 1.0f),
+       red = m.ConstantComposite(v, one, zero, zero, one);
+  auto fn = m.OpFunction(m.TypeVoid(), spv::FunctionControlMask::MaskNone,
+                         m.TypeFunction(m.TypeVoid()));
+  m.AddLabel();
+  m.OpStore(out, vertex ? m.OpLoad(v, input) : red);
+  m.OpReturn();
+  m.OpFunctionEnd();
+  if (vertex)
+    m.AddEntryPoint(spv::ExecutionModel::Vertex, fn, "main", input, out);
+  else {
+    m.AddEntryPoint(spv::ExecutionModel::Fragment, fn, "main", out);
+    m.AddExecutionMode(fn, spv::ExecutionMode::OriginUpperLeft);
+  }
+  return m.Assemble();
+}
+} // namespace
+Result RunOffscreenTriangle() {
+  Result result;
+  try {
+    Owned owner;
+    if (!owner.loader)
+      throw std::runtime_error("System vulkan-1.dll unavailable");
+    VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+    app.pApplicationName = "native-offscreen-fixture";
+    app.apiVersion = VK_API_VERSION_1_0;
+    VkInstanceCreateInfo ici{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+    ici.pApplicationInfo = &app;
+    VkInstance instance{};
+    Check(V(vkCreateInstance)(&ici, nullptr, &instance), "vkCreateInstance");
+    owner.release.push_back(
+        [&, instance] { V(vkDestroyInstance)(instance, nullptr); });
+    uint32_t n = 0;
+    Check(V(vkEnumeratePhysicalDevices)(instance, &n, nullptr),
+          "physical device count");
+    if (!n)
+      throw std::runtime_error("No Vulkan physical device");
+    std::vector<VkPhysicalDevice> devices(n);
+    Check(V(vkEnumeratePhysicalDevices)(instance, &n, devices.data()),
+          "physical devices");
+    VkPhysicalDevice physical{};
+    uint32_t family = 0;
+    for (auto p : devices) {
+      uint32_t count = 0;
+      V(vkGetPhysicalDeviceQueueFamilyProperties)(p, &count, nullptr);
+      std::vector<VkQueueFamilyProperties> q(count);
+      V(vkGetPhysicalDeviceQueueFamilyProperties)(p, &count, q.data());
+      for (uint32_t i = 0; i < count; ++i)
+        if (q[i].queueCount && (q[i].queueFlags & VK_QUEUE_GRAPHICS_BIT)) {
+          physical = p;
+          family = i;
+          break;
+        }
+      if (physical)
+        break;
+    }
+    if (!physical)
+      throw std::runtime_error("Unsupported: no graphics queue");
+    VkPhysicalDeviceProperties properties{};
+    V(vkGetPhysicalDeviceProperties)(physical, &properties);
+    result.device = properties.deviceName;
+    result.vendor_id = properties.vendorID;
+    result.device_id = properties.deviceID;
+    result.driver_version = properties.driverVersion;
+    result.api_version = properties.apiVersion;
+    VkFormatProperties format{};
+    V(vkGetPhysicalDeviceFormatProperties)(physical, VK_FORMAT_R8G8B8A8_UNORM,
+                                           &format);
+    if (!(format.optimalTilingFeatures &
+          VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT))
+      throw std::runtime_error("Unsupported RGBA8 color attachment");
+    float priority = 1;
+    VkDeviceQueueCreateInfo qci{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+    qci.queueFamilyIndex = family;
+    qci.queueCount = 1;
+    qci.pQueuePriorities = &priority;
+    VkDeviceCreateInfo dci{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+    dci.queueCreateInfoCount = 1;
+    dci.pQueueCreateInfos = &qci;
+    VkDevice device{};
+    Check(V(vkCreateDevice)(physical, &dci, nullptr, &device),
+          "vkCreateDevice");
+    owner.release.push_back(
+        [&, device] { V(vkDestroyDevice)(device, nullptr); });
+    VkQueue queue{};
+    V(vkGetDeviceQueue)(device, family, 0, &queue);
+    // Cleanup waits before freeing any resources if a later check throws after
+    // submission.
+    auto submitted = std::make_shared<bool>(false);
+    VkPhysicalDeviceMemoryProperties memory{};
+    V(vkGetPhysicalDeviceMemoryProperties)(physical, &memory);
+    auto allocate = [&](VkMemoryRequirements requirements,
+                        VkMemoryPropertyFlags flags) {
+      uint32_t index = memory.memoryTypeCount;
+      for (uint32_t i = 0; i < memory.memoryTypeCount; ++i)
+        if ((requirements.memoryTypeBits & (1u << i)) &&
+            (memory.memoryTypes[i].propertyFlags & flags) == flags) {
+          index = i;
+          break;
+        }
+      if (index == memory.memoryTypeCount)
+        throw std::runtime_error("Unsupported Vulkan memory type");
+      VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+      ai.allocationSize = requirements.size;
+      ai.memoryTypeIndex = index;
+      VkDeviceMemory allocation{};
+      Check(V(vkAllocateMemory)(device, &ai, nullptr, &allocation),
+            "vkAllocateMemory");
+      return allocation;
+    };
+    auto buffer = [&](VkDeviceSize size, VkBufferUsageFlags usage,
+                      VkBuffer &handle, VkDeviceMemory &allocation) {
+      VkBufferCreateInfo bi{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+      bi.size = size;
+      bi.usage = usage;
+      bi.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+      Check(V(vkCreateBuffer)(device, &bi, nullptr, &handle), "vkCreateBuffer");
+      VkMemoryRequirements requirements{};
+      V(vkGetBufferMemoryRequirements)(device, handle, &requirements);
+      try {
+        allocation =
+            allocate(requirements, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                       VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+      } catch (...) {
+        V(vkDestroyBuffer)(device, handle, nullptr);
+        throw;
+      }
+      auto b = handle;
+      auto a = allocation;
+      owner.release.push_back([&, device, b, a] {
+        V(vkDestroyBuffer)(device, b, nullptr);
+        V(vkFreeMemory)(device, a, nullptr);
+      });
+      Check(V(vkBindBufferMemory)(device, handle, allocation, 0),
+            "vkBindBufferMemory");
+    };
+    constexpr uint32_t width = 64, height = 64;
+    VkBuffer vertex{}, readback{};
+    VkDeviceMemory vertex_memory{}, readback_memory{};
+    buffer(48, VK_BUFFER_USAGE_VERTEX_BUFFER_BIT, vertex, vertex_memory);
+    buffer(width * height * 4, VK_BUFFER_USAGE_TRANSFER_DST_BIT, readback,
+           readback_memory);
+    const float vertices[12] = {-0.75f, -0.75f, 0, 1,     0.75f, -0.75f,
+                                0,      1,      0, 0.75f, 0,     1};
+    void *mapped{};
+    Check(V(vkMapMemory)(device, vertex_memory, 0, 48, 0, &mapped),
+          "map vertex");
+    std::memcpy(mapped, vertices, sizeof(vertices));
+    V(vkUnmapMemory)(device, vertex_memory);
+    VkImageCreateInfo image_ci{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    image_ci.imageType = VK_IMAGE_TYPE_2D;
+    image_ci.format = VK_FORMAT_R8G8B8A8_UNORM;
+    image_ci.extent = {width, height, 1};
+    image_ci.mipLevels = 1;
+    image_ci.arrayLayers = 1;
+    image_ci.samples = VK_SAMPLE_COUNT_1_BIT;
+    image_ci.tiling = VK_IMAGE_TILING_OPTIMAL;
+    image_ci.usage =
+        VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    image_ci.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    VkImage image{};
+    Check(V(vkCreateImage)(device, &image_ci, nullptr, &image),
+          "vkCreateImage");
+    VkMemoryRequirements ir{};
+    V(vkGetImageMemoryRequirements)(device, image, &ir);
+    VkDeviceMemory image_memory{};
+    try {
+      image_memory = allocate(ir, 0);
+    } catch (...) {
+      V(vkDestroyImage)(device, image, nullptr);
+      throw;
+    }
+    owner.release.push_back([&, device, image, image_memory] {
+      V(vkDestroyImage)(device, image, nullptr);
+      V(vkFreeMemory)(device, image_memory, nullptr);
+    });
+    Check(V(vkBindImageMemory)(device, image, image_memory, 0),
+          "vkBindImageMemory");
+    VkImageViewCreateInfo ivci{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    ivci.image = image;
+    ivci.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    ivci.format = VK_FORMAT_R8G8B8A8_UNORM;
+    ivci.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    VkImageView view{};
+    Check(V(vkCreateImageView)(device, &ivci, nullptr, &view),
+          "vkCreateImageView");
+    owner.release.push_back(
+        [&, device, view] { V(vkDestroyImageView)(device, view, nullptr); });
+    VkAttachmentDescription attachment{};
+    attachment.format = VK_FORMAT_R8G8B8A8_UNORM;
+    attachment.samples = VK_SAMPLE_COUNT_1_BIT;
+    attachment.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+    attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    attachment.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+    attachment.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+    attachment.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    attachment.finalLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    VkAttachmentReference color{0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+    VkSubpassDescription sub{};
+    sub.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+    sub.colorAttachmentCount = 1;
+    sub.pColorAttachments = &color;
+    VkSubpassDependency dep{};
+    dep.srcSubpass = 0;
+    dep.dstSubpass = VK_SUBPASS_EXTERNAL;
+    dep.srcStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+    dep.dstStageMask = VK_PIPELINE_STAGE_TRANSFER_BIT;
+    dep.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    dep.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    VkRenderPassCreateInfo rpci{VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO};
+    rpci.attachmentCount = 1;
+    rpci.pAttachments = &attachment;
+    rpci.subpassCount = 1;
+    rpci.pSubpasses = &sub;
+    rpci.dependencyCount = 1;
+    rpci.pDependencies = &dep;
+    VkRenderPass pass{};
+    Check(V(vkCreateRenderPass)(device, &rpci, nullptr, &pass),
+          "vkCreateRenderPass");
+    owner.release.push_back(
+        [&, device, pass] { V(vkDestroyRenderPass)(device, pass, nullptr); });
+    VkFramebufferCreateInfo fbci{VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+    fbci.renderPass = pass;
+    fbci.attachmentCount = 1;
+    fbci.pAttachments = &view;
+    fbci.width = width;
+    fbci.height = height;
+    fbci.layers = 1;
+    VkFramebuffer framebuffer{};
+    Check(V(vkCreateFramebuffer)(device, &fbci, nullptr, &framebuffer),
+          "vkCreateFramebuffer");
+    owner.release.push_back([&, device, framebuffer] {
+      V(vkDestroyFramebuffer)(device, framebuffer, nullptr);
+    });
+    VkShaderModule shaders[2]{};
+    for (int i = 0; i < 2; ++i) {
+      auto code = Shader(i == 0);
+      VkShaderModuleCreateInfo ci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+      ci.codeSize = code.size() * 4;
+      ci.pCode = code.data();
+      Check(V(vkCreateShaderModule)(device, &ci, nullptr, &shaders[i]),
+            "vkCreateShaderModule");
+      auto shader = shaders[i];
+      owner.release.push_back([&, device, shader] {
+        V(vkDestroyShaderModule)(device, shader, nullptr);
+      });
+    }
+    VkPipelineLayoutCreateInfo plci{
+        VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+    VkPipelineLayout layout{};
+    Check(V(vkCreatePipelineLayout)(device, &plci, nullptr, &layout),
+          "vkCreatePipelineLayout");
+    owner.release.push_back([&, device, layout] {
+      V(vkDestroyPipelineLayout)(device, layout, nullptr);
+    });
+    VkPipelineShaderStageCreateInfo stages[2]{};
+    for (int i = 0; i < 2; ++i) {
+      stages[i].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+      stages[i].stage =
+          i == 0 ? VK_SHADER_STAGE_VERTEX_BIT : VK_SHADER_STAGE_FRAGMENT_BIT;
+      stages[i].module = shaders[i];
+      stages[i].pName = "main";
+    }
+    VkVertexInputBindingDescription binding{0, 16, VK_VERTEX_INPUT_RATE_VERTEX};
+    VkVertexInputAttributeDescription attribute{
+        0, 0, VK_FORMAT_R32G32B32A32_SFLOAT, 0};
+    VkPipelineVertexInputStateCreateInfo vi{
+        VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+    vi.vertexBindingDescriptionCount = 1;
+    vi.pVertexBindingDescriptions = &binding;
+    vi.vertexAttributeDescriptionCount = 1;
+    vi.pVertexAttributeDescriptions = &attribute;
+    VkPipelineInputAssemblyStateCreateInfo ia{
+        VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+    ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    VkViewport viewport{0, 0, float(width), float(height), 0, 1};
+    VkRect2D scissor{{0, 0}, {width, height}};
+    VkPipelineViewportStateCreateInfo vp{
+        VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+    vp.viewportCount = 1;
+    vp.pViewports = &viewport;
+    vp.scissorCount = 1;
+    vp.pScissors = &scissor;
+    VkPipelineRasterizationStateCreateInfo raster{
+        VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+    raster.polygonMode = VK_POLYGON_MODE_FILL;
+    raster.cullMode = VK_CULL_MODE_NONE;
+    raster.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+    raster.lineWidth = 1;
+    VkPipelineMultisampleStateCreateInfo ms{
+        VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+    ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+    VkPipelineColorBlendAttachmentState ba{};
+    ba.colorWriteMask = 15;
+    VkPipelineColorBlendStateCreateInfo blend{
+        VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+    blend.attachmentCount = 1;
+    blend.pAttachments = &ba;
+    VkGraphicsPipelineCreateInfo pci{
+        VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+    pci.stageCount = 2;
+    pci.pStages = stages;
+    pci.pVertexInputState = &vi;
+    pci.pInputAssemblyState = &ia;
+    pci.pViewportState = &vp;
+    pci.pRasterizationState = &raster;
+    pci.pMultisampleState = &ms;
+    pci.pColorBlendState = &blend;
+    pci.layout = layout;
+    pci.renderPass = pass;
+    VkPipeline pipeline{};
+    Check(V(vkCreateGraphicsPipelines)(device, VK_NULL_HANDLE, 1, &pci, nullptr,
+                                       &pipeline),
+          "vkCreateGraphicsPipelines");
+    owner.release.push_back([&, device, pipeline] {
+      V(vkDestroyPipeline)(device, pipeline, nullptr);
+    });
+    VkCommandPoolCreateInfo cpci{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+    cpci.queueFamilyIndex = family;
+    VkCommandPool pool{};
+    Check(V(vkCreateCommandPool)(device, &cpci, nullptr, &pool),
+          "vkCreateCommandPool");
+    owner.release.push_back(
+        [&, device, pool] { V(vkDestroyCommandPool)(device, pool, nullptr); });
+    VkCommandBufferAllocateInfo cbai{
+        VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+    cbai.commandPool = pool;
+    cbai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    cbai.commandBufferCount = 1;
+    VkCommandBuffer cb{};
+    Check(V(vkAllocateCommandBuffers)(device, &cbai, &cb),
+          "vkAllocateCommandBuffers");
+    VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+    begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    Check(V(vkBeginCommandBuffer)(cb, &begin), "vkBeginCommandBuffer");
+    VkClearValue clear{};
+    clear.color.float32[3] = 1;
+    VkRenderPassBeginInfo rb{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+    rb.renderPass = pass;
+    rb.framebuffer = framebuffer;
+    rb.renderArea = scissor;
+    rb.clearValueCount = 1;
+    rb.pClearValues = &clear;
+    V(vkCmdBeginRenderPass)(cb, &rb, VK_SUBPASS_CONTENTS_INLINE);
+    V(vkCmdBindPipeline)(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+    VkDeviceSize offset = 0;
+    V(vkCmdBindVertexBuffers)(cb, 0, 1, &vertex, &offset);
+    V(vkCmdDraw)(cb, 3, 1, 0, 0);
+    V(vkCmdEndRenderPass)(cb);
+    VkBufferImageCopy copy{};
+    copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    copy.imageExtent = {width, height, 1};
+    V(vkCmdCopyImageToBuffer)(cb, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                              readback, 1, &copy);
+    VkBufferMemoryBarrier barrier{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+    barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+    barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.buffer = readback;
+    barrier.size = VK_WHOLE_SIZE;
+    V(vkCmdPipelineBarrier)(cb, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                            VK_PIPELINE_STAGE_HOST_BIT, 0, 0, nullptr, 1,
+                            &barrier, 0, nullptr);
+    Check(V(vkEndCommandBuffer)(cb), "vkEndCommandBuffer");
+    VkFenceCreateInfo fci{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+    VkFence fence{};
+    Check(V(vkCreateFence)(device, &fci, nullptr, &fence), "vkCreateFence");
+    owner.release.push_back(
+        [&, device, fence] { V(vkDestroyFence)(device, fence, nullptr); });
+    // This cleanup is registered last, so outstanding GPU work finishes before
+    // any resource destruction.
+    owner.release.push_back([&, device, submitted] {
+      if (*submitted)
+        V(vkDeviceWaitIdle)(device);
+    });
+    VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    submit.commandBufferCount = 1;
+    submit.pCommandBuffers = &cb;
+    Check(V(vkQueueSubmit)(queue, 1, &submit, fence), "vkQueueSubmit");
+    *submitted = true;
+    Check(V(vkWaitForFences)(device, 1, &fence, VK_TRUE, 5'000'000'000ull),
+          "vkWaitForFences");
+    result.draw_count = 1;
+    Check(V(vkMapMemory)(device, readback_memory, 0, width * height * 4, 0,
+                         &mapped),
+          "map readback");
+    auto pixels = static_cast<const uint32_t *>(mapped);
+    result.center_rgba = pixels[(height / 2) * width + width / 2];
+    result.corner_rgba = pixels[0];
+    for (uint32_t i = 0; i < width * height; ++i) {
+      result.red_pixels += pixels[i] == 0xff0000ffu;
+      result.black_pixels += pixels[i] == 0xff000000u;
+    }
+    V(vkUnmapMemory)(device, readback_memory);
+    if (result.center_rgba != 0xff0000ffu ||
+        result.corner_rgba != 0xff000000u || result.red_pixels < 1000 ||
+        result.red_pixels > 1300 ||
+        result.black_pixels + result.red_pixels != width * height)
+      throw std::runtime_error("Triangle readback pixel verification failed");
+    result.passed = true;
+  } catch (const std::exception &e) {
+    result.error = e.what();
+  }
+  return result;
+}
+} // namespace native_graphics
diff --git a/native-runtime/graphics/native_graphics.h b/native-runtime/graphics/native_graphics.h
new file mode 100644
--- /dev/null
+++ b/native-runtime/graphics/native_graphics.h
@@ -0,0 +1,16 @@
+#pragma once
+#include <cstdint>
+#include <string>
+namespace native_graphics {
+// Independent native Vulkan fixture. Unsupported hardware/API returns a strict
+// error. This proves resources, one draw and synchronized readback; it is not
+// an NVN adapter.
+struct Result {
+  bool passed = false;
+  std::string device, error;
+  uint32_t vendor_id = 0, device_id = 0, driver_version = 0, api_version = 0;
+  uint32_t draw_count = 0, red_pixels = 0, black_pixels = 0;
+  uint32_t center_rgba = 0, corner_rgba = 0;
+};
+Result RunOffscreenTriangle();
+} // namespace native_graphics
diff --git a/native-runtime/graphics/probe.cpp b/native-runtime/graphics/probe.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/graphics/probe.cpp
@@ -0,0 +1,18 @@
+#include "native_graphics.h"
+#include <iostream>
+int main() {
+  auto r = native_graphics::RunOffscreenTriangle();
+  std::cout << "{\"passed\":" << (r.passed ? "true" : "false")
+            << ",\"device\":\"" << r.device
+            << "\",\"vendor_id\":" << r.vendor_id
+            << ",\"device_id\":" << r.device_id
+            << ",\"driver_version\":" << r.driver_version
+            << ",\"api_version\":" << r.api_version
+            << ",\"draw_count\":" << r.draw_count
+            << ",\"red_pixels\":" << r.red_pixels
+            << ",\"black_pixels\":" << r.black_pixels
+            << ",\"center_rgba\":" << r.center_rgba
+            << ",\"corner_rgba\":" << r.corner_rgba << ",\"error\":\""
+            << r.error << "\"}\n";
+  return r.passed ? 0 : 1;
+}
diff --git a/native-runtime/graphics/resource_test.cpp b/native-runtime/graphics/resource_test.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/graphics/resource_test.cpp
@@ -0,0 +1,98 @@
+#include "vulkan_resources.h"
+#include <array>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <thread>
+using namespace native_graphics;
+int main() {
+  try {
+    unsigned rejected = 0;
+    auto reject = [&](auto action) {
+      try {
+        action();
+      } catch (const std::runtime_error &) {
+        ++rejected;
+        return;
+      }
+      throw std::runtime_error("Expected strict resource error was not raised");
+    };
+    reject([] { VulkanDevice bad({false, false, 1}); });
+    VulkanDevice device({true, true, 0});
+    auto pool = device.CreatePool(4097);
+    auto info = device.GetPoolInfo(pool);
+    auto view = device.CreateView(pool, 17, 4096 - 17);
+    auto alias = device.CreateView(pool, 17, 64);
+    std::array<std::byte, 64> source{}, destination{};
+    for (size_t i = 0; i < source.size(); ++i)
+      source[i] = std::byte(i ^ 0x5a);
+    device.Upload(view, 0, source);
+    device.Flush(view, 1, 31);
+    device.Invalidate(view, 1, 31);
+    device.Download(alias, 0, destination);
+    if (source != destination)
+      throw std::runtime_error("Mapped Vulkan buffer roundtrip mismatch");
+    auto binding = device.GetBufferBinding(view);
+    auto handles = device.GetNativeHandles();
+    if (!binding.native_buffer || binding.offset != 17 ||
+        binding.size != 4079 || !handles.device || !handles.queue)
+      throw std::runtime_error("Invalid native buffer/device interop");
+    const auto address = device.GetDeviceAddress(view);
+    if (!info.device_address || address - info.device_address != 17)
+      throw std::runtime_error("Real Vulkan buffer address offset mismatch");
+    reject([&] { device.DestroyPool(pool); });
+    reject([&] { device.CreateView(pool, UINT64_MAX, 1); });
+    reject([&] { device.CreateView(pool, 4096, 2); });
+    reject([&] { device.CreateView(pool, 0, 0); });
+    reject([&] { device.Upload(alias, 63, source); });
+    reject([&] { device.Download(alias, UINT64_MAX, destination); });
+    reject([&] { device.Flush(alias, UINT64_MAX, 1); });
+    reject([&] { device.Invalidate(alias, 0, 65); });
+    reject([&] { device.CreatePool(0); });
+    reject([&] { device.CreatePool(32, 1); });
+    bool thread_rejected = false;
+    std::thread other([&] {
+      try {
+        device.GetPoolInfo(pool);
+      } catch (const std::runtime_error &) {
+        thread_rejected = true;
+      }
+    });
+    other.join();
+    if (!thread_rejected)
+      throw std::runtime_error("Owner thread contract not enforced");
+    VulkanDevice second;
+    reject([&] { second.GetPoolInfo(pool); });
+    auto p2 = second.CreatePool(64);
+    auto v2 = second.CreateView(p2, 0, 64);
+    reject([&] { second.GetDeviceAddress(v2); });
+    second.DestroyView(v2);
+    second.DestroyPool(p2);
+    device.DestroyView(alias);
+    reject([&] { device.DestroyView(alias); });
+    device.DestroyView(view);
+    reject([&] { device.Upload(view, 0, source); });
+    device.DestroyPool(pool);
+    reject([&] { device.DestroyPool(pool); });
+    reject([&] { device.GetPoolInfo(pool); });
+    // Device teardown also owns cleanup for intentionally retained pools/views.
+    {
+      VulkanDevice cleanup;
+      auto p = cleanup.CreatePool(256);
+      cleanup.CreateView(p, 0, 128);
+    }
+    std::cout << "{\"passed\":true,\"device\":\"" << device.DeviceName()
+              << "\",\"pool_bytes\":" << info.size
+              << ",\"enabled_shader_image_gather_extended\":"
+              << (handles.enabled_shader_image_gather_extended ? "true"
+                                                               : "false")
+              << ",\"coherent\":" << (info.coherent ? "true" : "false")
+              << ",\"real_device_address\":" << address
+              << ",\"rejected_operations\":" << rejected
+              << ",\"thread_rejected\":true,\"roundtrip_bytes\":64}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
diff --git a/native-runtime/graphics/vulkan_resources.cpp b/native-runtime/graphics/vulkan_resources.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/graphics/vulkan_resources.cpp
@@ -0,0 +1,573 @@
+#include "vulkan_resources.h"
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#define VK_NO_PROTOTYPES
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <limits>
+#include <map>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+#include <windows.h>
+#define VK_USE_PLATFORM_WIN32_KHR
+#include <set>
+#include <vulkan/vulkan.h>
+namespace native_graphics {
+namespace {
+void Check(VkResult r, const char *what) {
+  if (r != VK_SUCCESS)
+    throw std::runtime_error(std::string(what) +
+                             ": VkResult=" + std::to_string(r));
+}
+void Range(uint64_t total, uint64_t offset, uint64_t size) {
+  if (offset > total || size > total - offset)
+    throw std::runtime_error("Resource range out of bounds");
+}
+std::atomic<uint64_t> next_handle{1};
+uint64_t Handle() {
+  auto h = next_handle.fetch_add(1);
+  if (!h)
+    throw std::runtime_error("Resource handle space exhausted");
+  return h;
+}
+} // namespace
+struct VulkanDevice::Impl {
+  struct Pool {
+    VkBuffer buffer{};
+    VkDeviceMemory memory{};
+    void *mapped{};
+    uint64_t size = 0, allocation_size = 0, address = 0;
+    bool coherent = false;
+    uint64_t views = 0;
+  };
+  struct View {
+    uint64_t pool, offset, size;
+  };
+  HMODULE loader{};
+  VkInstance instance{};
+  VkPhysicalDevice physical{};
+  VkSurfaceKHR surface{};
+  bool maintenance_khr = false;
+  std::vector<std::string> enabled_instance_extensions,
+      enabled_device_extensions;
+  std::shared_ptr<const Win32SurfaceTarget> surface_target;
+  VkDevice device{};
+  VkQueue queue{};
+  uint32_t queue_family = 0, enabled_api_version = VK_API_VERSION_1_0;
+  VkPhysicalDeviceProperties properties{};
+  VkPhysicalDeviceMemoryProperties memory{};
+  bool addresses = false, prefer_noncoherent = false;
+  bool enabled_shader_image_gather_extended = false;
+  std::thread::id owner = std::this_thread::get_id();
+  std::map<uint64_t, Pool> pools;
+  std::map<uint64_t, View> views;
+  template <class T> T Get(const char *name) const {
+    if (!loader)
+      throw std::runtime_error("Vulkan loader is unavailable");
+    auto p = GetProcAddress(loader, name);
+    if (!p && device) {
+      auto get = reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+          GetProcAddress(loader, "vkGetDeviceProcAddr"));
+      if (get)
+        p = reinterpret_cast<FARPROC>(get(device, name));
+    }
+    if (!p && instance) {
+      auto get = reinterpret_cast<PFN_vkGetInstanceProcAddr>(
+          GetProcAddress(loader, "vkGetInstanceProcAddr"));
+      if (get)
+        p = reinterpret_cast<FARPROC>(get(instance, name));
+    }
+    if (!p)
+      throw std::runtime_error(std::string("Unsupported Vulkan export: ") +
+                               name);
+    return reinterpret_cast<T>(p);
+  }
+  void Thread() const {
+    if (owner != std::this_thread::get_id())
+      throw std::runtime_error("VulkanDevice requires its owner thread");
+  }
+  Pool &GetPool(PoolHandle h) {
+    auto it = pools.find(h.value);
+    if (it == pools.end())
+      throw std::runtime_error("Invalid or destroyed pool handle");
+    return it->second;
+  }
+  const Pool &GetPool(PoolHandle h) const {
+    auto it = pools.find(h.value);
+    if (it == pools.end())
+      throw std::runtime_error("Invalid or destroyed pool handle");
+    return it->second;
+  }
+  View &GetView(BufferViewHandle h) {
+    auto it = views.find(h.value);
+    if (it == views.end())
+      throw std::runtime_error("Invalid or destroyed view handle");
+    return it->second;
+  }
+  const View &GetView(BufferViewHandle h) const {
+    auto it = views.find(h.value);
+    if (it == views.end())
+      throw std::runtime_error("Invalid or destroyed view handle");
+    return it->second;
+  }
+  void Release(Pool &p) {
+    if (p.mapped)
+      Get<PFN_vkUnmapMemory>("vkUnmapMemory")(device, p.memory);
+    if (p.buffer)
+      Get<PFN_vkDestroyBuffer>("vkDestroyBuffer")(device, p.buffer, nullptr);
+    if (p.memory)
+      Get<PFN_vkFreeMemory>("vkFreeMemory")(device, p.memory, nullptr);
+    p = {};
+  }
+  ~Impl() {
+    if (device) {
+      for (auto &[id, p] : pools)
+        Release(p);
+      Get<PFN_vkDestroyDevice>("vkDestroyDevice")(device, nullptr);
+      device = VK_NULL_HANDLE;
+    }
+    if (surface)
+      Get<PFN_vkDestroySurfaceKHR>("vkDestroySurfaceKHR")(instance, surface,
+                                                          nullptr);
+    if (instance)
+      Get<PFN_vkDestroyInstance>("vkDestroyInstance")(instance, nullptr);
+    if (loader)
+      FreeLibrary(loader);
+  }
+  void Sync(BufferViewHandle h, uint64_t offset, uint64_t size,
+            bool invalidate) {
+    Thread();
+    auto &v = GetView(h);
+    Range(v.size, offset, size);
+    auto &p = GetPool({v.pool});
+    if (!size || p.coherent)
+      return;
+    const uint64_t start = v.offset + offset,
+                   atom = properties.limits.nonCoherentAtomSize;
+    const uint64_t aligned = start - start % atom;
+    const uint64_t end = start + size;
+    uint64_t length = VK_WHOLE_SIZE;
+    if (end <= p.allocation_size && end % atom == 0)
+      length = end - aligned;
+    else if (atom - end % atom <= p.allocation_size - end)
+      length = end + (atom - end % atom) - aligned;
+    VkMappedMemoryRange range{VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE};
+    range.memory = p.memory;
+    range.offset = aligned;
+    range.size = length;
+    if (invalidate)
+      Check(Get<PFN_vkInvalidateMappedMemoryRanges>(
+                "vkInvalidateMappedMemoryRanges")(device, 1, &range),
+            "vkInvalidateMappedMemoryRanges");
+    else
+      Check(Get<PFN_vkFlushMappedMemoryRanges>("vkFlushMappedMemoryRanges")(
+                device, 1, &range),
+            "vkFlushMappedMemoryRanges");
+  }
+};
+#define V(name) impl->Get<PFN_##name>(#name)
+VulkanDevice::VulkanDevice(DeviceOptions options)
+    : impl(std::make_unique<Impl>()) {
+  if (options.unsupported_flags)
+    throw std::runtime_error("Unsupported device flags");
+  impl->prefer_noncoherent = options.prefer_noncoherent;
+  impl->loader = LoadLibraryW(L"vulkan-1.dll");
+  if (!impl->loader)
+    throw std::runtime_error("System Vulkan loader unavailable");
+  VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+  app.pApplicationName = "native-resource-device";
+  app.apiVersion = options.require_device_address || options.presentation
+                       ? VK_API_VERSION_1_2
+                       : VK_API_VERSION_1_0;
+  impl->enabled_api_version = app.apiVersion;
+  VkInstanceCreateInfo ici{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+  ici.pApplicationInfo = &app;
+  std::vector<const char *> instance_extensions;
+  bool instance_khr = false, instance_ext = false;
+  if (options.presentation) {
+    const auto &t = *options.presentation;
+    DWORD pid = 0;
+    if (!t.window_owner || !t.surface_pin ||
+        t.owner_thread != std::this_thread::get_id() ||
+        GetWindowThreadProcessId(reinterpret_cast<HWND>(t.window), &pid) !=
+            GetCurrentThreadId() ||
+        pid != GetCurrentProcessId() || !t.instance)
+      throw std::runtime_error(
+          "Invalid/foreign/wrong-thread presentation window");
+    uint32_t count = 0;
+    Check(V(vkEnumerateInstanceExtensionProperties)(nullptr, &count, nullptr),
+          "Instance extension count");
+    std::vector<VkExtensionProperties> ext(count);
+    Check(
+        V(vkEnumerateInstanceExtensionProperties)(nullptr, &count, ext.data()),
+        "Instance extensions");
+    std::set<std::string> names;
+    for (auto &e : ext)
+      names.insert(e.extensionName);
+    instance_khr = names.contains(VK_KHR_SURFACE_MAINTENANCE_1_EXTENSION_NAME);
+    instance_ext = names.contains(VK_EXT_SURFACE_MAINTENANCE_1_EXTENSION_NAME);
+    if (!instance_khr && !instance_ext)
+      throw std::runtime_error("Presentation surface maintenance1 unsupported");
+    instance_extensions = {VK_KHR_SURFACE_EXTENSION_NAME,
+                           VK_KHR_WIN32_SURFACE_EXTENSION_NAME,
+                           VK_KHR_GET_SURFACE_CAPABILITIES_2_EXTENSION_NAME};
+    if (instance_khr)
+      instance_extensions.push_back(
+          VK_KHR_SURFACE_MAINTENANCE_1_EXTENSION_NAME);
+    if (instance_ext)
+      instance_extensions.push_back(
+          VK_EXT_SURFACE_MAINTENANCE_1_EXTENSION_NAME);
+    for (auto name : instance_extensions)
+      if (!names.contains(name))
+        throw std::runtime_error(
+            std::string("Required presentation instance extension missing: ") +
+            name);
+    impl->surface_target = options.presentation;
+    for (auto name : instance_extensions)
+      impl->enabled_instance_extensions.emplace_back(name);
+    ici.enabledExtensionCount = uint32_t(instance_extensions.size());
+    ici.ppEnabledExtensionNames = instance_extensions.data();
+  }
+  Check(V(vkCreateInstance)(&ici, nullptr, &impl->instance),
+        "vkCreateInstance");
+  if (options.presentation) {
+    VkWin32SurfaceCreateInfoKHR ci{
+        VK_STRUCTURE_TYPE_WIN32_SURFACE_CREATE_INFO_KHR};
+    ci.hwnd = reinterpret_cast<HWND>(options.presentation->window);
+    ci.hinstance = reinterpret_cast<HINSTANCE>(options.presentation->instance);
+    Check(V(vkCreateWin32SurfaceKHR)(impl->instance, &ci, nullptr,
+                                     &impl->surface),
+          "Create Win32 surface");
+  }
+  uint32_t n = 0;
+  Check(V(vkEnumeratePhysicalDevices)(impl->instance, &n, nullptr),
+        "vkEnumeratePhysicalDevices");
+  std::vector<VkPhysicalDevice> devices(n);
+  Check(V(vkEnumeratePhysicalDevices)(impl->instance, &n, devices.data()),
+        "vkEnumeratePhysicalDevices");
+  uint32_t family = 0;
+  for (auto p : devices) {
+    VkPhysicalDeviceProperties prop{};
+    V(vkGetPhysicalDeviceProperties)(p, &prop);
+    if ((options.require_device_address || options.presentation) &&
+        prop.apiVersion < VK_API_VERSION_1_2)
+      continue;
+    if (options.presentation) {
+      uint32_t count = 0;
+      Check(
+          V(vkEnumerateDeviceExtensionProperties)(p, nullptr, &count, nullptr),
+          "Device extension count");
+      std::vector<VkExtensionProperties> ext(count);
+      Check(V(vkEnumerateDeviceExtensionProperties)(p, nullptr, &count,
+                                                    ext.data()),
+            "Device extensions");
+      std::set<std::string> names;
+      for (auto &e : ext)
+        names.insert(e.extensionName);
+      const bool khr =
+          instance_khr &&
+          names.contains(VK_KHR_SWAPCHAIN_MAINTENANCE_1_EXTENSION_NAME);
+      const bool ext_supported =
+          instance_ext &&
+          names.contains(VK_EXT_SWAPCHAIN_MAINTENANCE_1_EXTENSION_NAME);
+      if (!names.contains(VK_KHR_SWAPCHAIN_EXTENSION_NAME) ||
+          (!khr && !ext_supported))
+        continue;
+      impl->maintenance_khr = khr;
+      VkPhysicalDeviceSwapchainMaintenance1FeaturesKHR f{
+          VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SWAPCHAIN_MAINTENANCE_1_FEATURES_KHR};
+      VkPhysicalDeviceFeatures2 features{
+          VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+      features.pNext = &f;
+      V(vkGetPhysicalDeviceFeatures2)(p, &features);
+      if (!f.swapchainMaintenance1)
+        continue;
+    }
+    uint32_t count = 0;
+    V(vkGetPhysicalDeviceQueueFamilyProperties)(p, &count, nullptr);
+    std::vector<VkQueueFamilyProperties> q(count);
+    V(vkGetPhysicalDeviceQueueFamilyProperties)(p, &count, q.data());
+    for (uint32_t i = 0; i < count; ++i)
+      if (q[i].queueCount && (q[i].queueFlags & VK_QUEUE_GRAPHICS_BIT)) {
+        if (options.presentation) {
+          VkBool32 supported = VK_FALSE;
+          Check(V(vkGetPhysicalDeviceSurfaceSupportKHR)(p, i, impl->surface,
+                                                        &supported),
+                "Surface queue support");
+          if (!supported)
+            continue;
+        }
+        if (options.require_device_address) {
+          VkPhysicalDeviceBufferDeviceAddressFeatures bda{
+              VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_BUFFER_DEVICE_ADDRESS_FEATURES};
+          VkPhysicalDeviceFeatures2 features{
+              VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+          features.pNext = &bda;
+          V(vkGetPhysicalDeviceFeatures2)(p, &features);
+          if (!bda.bufferDeviceAddress)
+            continue;
+        }
+        impl->physical = p;
+        family = i;
+        break;
+      }
+    if (impl->physical)
+      break;
+  }
+  if (!impl->physical)
+    throw std::runtime_error("Unsupported graphics queue or requested buffer "
+                             "device address feature");
+  V(vkGetPhysicalDeviceProperties)(impl->physical, &impl->properties);
+  V(vkGetPhysicalDeviceMemoryProperties)(impl->physical, &impl->memory);
+  float priority = 1;
+  VkDeviceQueueCreateInfo q{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+  q.queueFamilyIndex = family;
+  q.queueCount = 1;
+  q.pQueuePriorities = &priority;
+  VkDeviceCreateInfo d{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+  d.queueCreateInfoCount = 1;
+  d.pQueueCreateInfos = &q;
+  VkPhysicalDeviceFeatures supported{}, enabled{};
+  V(vkGetPhysicalDeviceFeatures)(impl->physical, &supported);
+  enabled.shaderImageGatherExtended = supported.shaderImageGatherExtended;
+  d.pEnabledFeatures = &enabled;
+  VkPhysicalDeviceBufferDeviceAddressFeatures bda{
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_BUFFER_DEVICE_ADDRESS_FEATURES};
+  bda.bufferDeviceAddress = VK_TRUE;
+  if (options.require_device_address)
+    d.pNext = &bda;
+  VkPhysicalDeviceSwapchainMaintenance1FeaturesKHR maintenance{
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SWAPCHAIN_MAINTENANCE_1_FEATURES_KHR};
+  std::vector<const char *> device_extensions;
+  if (options.presentation) {
+    maintenance.swapchainMaintenance1 = VK_TRUE;
+    if (options.require_device_address)
+      bda.pNext = &maintenance;
+    else
+      d.pNext = &maintenance;
+    device_extensions = {VK_KHR_SWAPCHAIN_EXTENSION_NAME,
+                         impl->maintenance_khr
+                             ? VK_KHR_SWAPCHAIN_MAINTENANCE_1_EXTENSION_NAME
+                             : VK_EXT_SWAPCHAIN_MAINTENANCE_1_EXTENSION_NAME};
+    for (auto name : device_extensions)
+      impl->enabled_device_extensions.emplace_back(name);
+    d.enabledExtensionCount = uint32_t(device_extensions.size());
+    d.ppEnabledExtensionNames = device_extensions.data();
+  }
+  Check(V(vkCreateDevice)(impl->physical, &d, nullptr, &impl->device),
+        "vkCreateDevice");
+  impl->addresses = options.require_device_address;
+  impl->enabled_shader_image_gather_extended =
+      enabled.shaderImageGatherExtended == VK_TRUE;
+  impl->queue_family = family;
+  V(vkGetDeviceQueue)(impl->device, family, 0, &impl->queue);
+}
+VulkanDevice::~VulkanDevice() = default;
+PoolHandle VulkanDevice::CreatePool(uint64_t size, uint32_t flags) {
+  impl->Thread();
+  if (flags)
+    throw std::runtime_error("Unsupported pool flags");
+  if (!size || size > std::numeric_limits<size_t>::max())
+    throw std::runtime_error("Invalid pool size");
+  Impl::Pool p{};
+  p.size = size;
+  VkBufferCreateInfo b{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+  b.size = size;
+  b.usage =
+      VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT |
+      VK_BUFFER_USAGE_VERTEX_BUFFER_BIT | VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT |
+      VK_BUFFER_USAGE_INDEX_BUFFER_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT;
+  if (impl->addresses)
+    b.usage |= VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT;
+  b.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  Check(V(vkCreateBuffer)(impl->device, &b, nullptr, &p.buffer),
+        "vkCreateBuffer");
+  try {
+    VkMemoryRequirements req{};
+    V(vkGetBufferMemoryRequirements)(impl->device, p.buffer, &req);
+    uint32_t index = impl->memory.memoryTypeCount;
+    int best = -1;
+    for (uint32_t i = 0; i < impl->memory.memoryTypeCount; ++i) {
+      auto f = impl->memory.memoryTypes[i].propertyFlags;
+      if (!(req.memoryTypeBits & (1u << i)) ||
+          !(f & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
+        continue;
+      int score = ((f & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) != 0) ==
+                          !impl->prefer_noncoherent
+                      ? 1
+                      : 0;
+      if (score > best) {
+        index = i;
+        best = score;
+      }
+    }
+    if (index == impl->memory.memoryTypeCount)
+      throw std::runtime_error("Unsupported host-visible Vulkan buffer memory");
+    p.coherent = (impl->memory.memoryTypes[index].propertyFlags &
+                  VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) != 0;
+    p.allocation_size = req.size;
+    VkMemoryAllocateFlagsInfo af{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO};
+    af.flags = VK_MEMORY_ALLOCATE_DEVICE_ADDRESS_BIT;
+    VkMemoryAllocateInfo a{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    a.allocationSize = req.size;
+    a.memoryTypeIndex = index;
+    if (impl->addresses)
+      a.pNext = &af;
+    Check(V(vkAllocateMemory)(impl->device, &a, nullptr, &p.memory),
+          "vkAllocateMemory");
+    Check(V(vkBindBufferMemory)(impl->device, p.buffer, p.memory, 0),
+          "vkBindBufferMemory");
+    Check(
+        V(vkMapMemory)(impl->device, p.memory, 0, VK_WHOLE_SIZE, 0, &p.mapped),
+        "vkMapMemory");
+    if (impl->addresses) {
+      VkBufferDeviceAddressInfo ai{
+          VK_STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO};
+      ai.buffer = p.buffer;
+      p.address = V(vkGetBufferDeviceAddress)(impl->device, &ai);
+      if (!p.address)
+        throw std::runtime_error("Driver returned zero buffer device address");
+    }
+    auto id = Handle();
+    impl->pools.emplace(id, p);
+    return {id};
+  } catch (...) {
+    impl->Release(p);
+    throw;
+  }
+}
+void VulkanDevice::DestroyPool(PoolHandle h) {
+  impl->Thread();
+  auto &p = impl->GetPool(h);
+  if (p.views)
+    throw std::runtime_error("Pool still owns live buffer views");
+  impl->Release(p);
+  impl->pools.erase(h.value);
+}
+BufferViewHandle VulkanDevice::CreateView(PoolHandle h, uint64_t offset,
+                                          uint64_t size) {
+  impl->Thread();
+  auto &p = impl->GetPool(h);
+  Range(p.size, offset, size);
+  if (!size)
+    throw std::runtime_error("Empty buffer view unsupported");
+  auto id = Handle();
+  impl->views.emplace(id, Impl::View{h.value, offset, size});
+  ++p.views;
+  return {id};
+}
+void VulkanDevice::DestroyView(BufferViewHandle h) {
+  impl->Thread();
+  auto v = impl->GetView(h);
+  --impl->GetPool({v.pool}).views;
+  impl->views.erase(h.value);
+}
+void VulkanDevice::Upload(BufferViewHandle h, uint64_t offset,
+                          std::span<const std::byte> bytes) {
+  impl->Thread();
+  auto v = impl->GetView(h);
+  Range(v.size, offset, bytes.size());
+  auto &p = impl->GetPool({v.pool});
+  if (!bytes.empty())
+    std::memcpy(static_cast<std::byte *>(p.mapped) + v.offset + offset,
+                bytes.data(), bytes.size());
+  impl->Sync(h, offset, bytes.size(), false);
+}
+void VulkanDevice::Download(BufferViewHandle h, uint64_t offset,
+                            std::span<std::byte> bytes) {
+  impl->Thread();
+  auto v = impl->GetView(h);
+  Range(v.size, offset, bytes.size());
+  impl->Sync(h, offset, bytes.size(), true);
+  auto &p = impl->GetPool({v.pool});
+  if (!bytes.empty())
+    std::memcpy(bytes.data(),
+                static_cast<std::byte *>(p.mapped) + v.offset + offset,
+                bytes.size());
+}
+void VulkanDevice::Flush(BufferViewHandle h, uint64_t offset, uint64_t size) {
+  impl->Sync(h, offset, size, false);
+}
+void VulkanDevice::Invalidate(BufferViewHandle h, uint64_t offset,
+                              uint64_t size) {
+  impl->Sync(h, offset, size, true);
+}
+PoolInfo VulkanDevice::GetPoolInfo(PoolHandle h) const {
+  impl->Thread();
+  auto &p = impl->GetPool(h);
+  return {p.size, p.coherent, p.address};
+}
+uint64_t VulkanDevice::GetDeviceAddress(BufferViewHandle h) const {
+  impl->Thread();
+  auto &v = impl->GetView(h);
+  auto &p = impl->GetPool({v.pool});
+  if (!impl->addresses)
+    throw std::runtime_error("Buffer device address feature was not requested");
+  if (v.offset > UINT64_MAX - p.address)
+    throw std::runtime_error("GPU device address overflow");
+  return p.address + v.offset;
+}
+std::string VulkanDevice::DeviceName() const {
+  impl->Thread();
+  return impl->properties.deviceName;
+}
+} // namespace native_graphics
+
+namespace native_graphics {
+BufferBinding VulkanDevice::GetBufferBinding(BufferViewHandle h) const {
+  impl->Thread();
+  auto &v = impl->GetView(h);
+  auto &p = impl->GetPool({v.pool});
+  return {reinterpret_cast<uint64_t>(p.buffer), v.offset, v.size};
+}
+PresentationDiagnostics VulkanDevice::GetPresentationDiagnostics() const {
+  impl->Thread();
+  if (!impl->surface)
+    throw std::runtime_error("Device has no WSI diagnostics");
+  return {std::min(impl->enabled_api_version, impl->properties.apiVersion),
+          impl->properties.driverVersion,
+          impl->properties.vendorID,
+          impl->properties.deviceID,
+          impl->queue_family,
+          impl->maintenance_khr,
+          impl->enabled_instance_extensions,
+          impl->enabled_device_extensions};
+}
+uintptr_t VulkanDevice::PresentationWindow() const {
+  impl->Thread();
+  return impl->surface_target ? impl->surface_target->window : 0;
+}
+uintptr_t VulkanDevice::PresentationSurface() const {
+  impl->Thread();
+  return reinterpret_cast<uintptr_t>(impl->surface);
+}
+bool VulkanDevice::PresentationUsesKhrMaintenance() const {
+  impl->Thread();
+  if (!impl->surface)
+    throw std::runtime_error("No presentation surface");
+  return impl->maintenance_khr;
+}
+GraphicsCapabilities VulkanDevice::GetCapabilities() const {
+  impl->Thread();
+  const auto &limits = impl->properties.limits;
+  const uint32_t version =
+      std::min(impl->enabled_api_version, impl->properties.apiVersion);
+  return {version,
+          limits.maxImageDimension2D,
+          {limits.maxViewportDimensions[0], limits.maxViewportDimensions[1]},
+          {limits.viewportBoundsRange[0], limits.viewportBoundsRange[1]},
+          limits.maxSamplerLodBias,
+          version >= VK_API_VERSION_1_1};
+}
+VulkanHandles VulkanDevice::GetNativeHandles() const {
+  impl->Thread();
+  return {reinterpret_cast<uintptr_t>(impl->instance),
+          reinterpret_cast<uintptr_t>(impl->physical),
+          reinterpret_cast<uintptr_t>(impl->device),
+          reinterpret_cast<uintptr_t>(impl->queue),
+          impl->queue_family,
+          impl->enabled_shader_image_gather_extended};
+}
+} // namespace native_graphics
diff --git a/native-runtime/graphics/vulkan_resources.h b/native-runtime/graphics/vulkan_resources.h
new file mode 100644
--- /dev/null
+++ b/native-runtime/graphics/vulkan_resources.h
@@ -0,0 +1,92 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <span>
+#include <string>
+#include <thread>
+#include <vector>
+namespace native {
+class Window;
+}
+namespace native_graphics {
+struct PoolHandle {
+  uint64_t value = 0;
+};
+struct BufferViewHandle {
+  uint64_t value = 0;
+};
+// Host-only retained Win32 surface target. Never copied into guest storage.
+struct Win32SurfaceTarget {
+  std::shared_ptr<native::Window> window_owner;
+  std::shared_ptr<const uint8_t> surface_pin;
+  uintptr_t window = 0, instance = 0;
+  std::thread::id owner_thread;
+};
+struct DeviceOptions {
+  bool require_device_address = false;
+  bool prefer_noncoherent = false;
+  uint32_t unsupported_flags = 0;
+  std::shared_ptr<const Win32SurfaceTarget> presentation;
+};
+struct BufferBinding {
+  uint64_t native_buffer = 0, offset = 0, size = 0;
+};
+struct VulkanHandles {
+  uintptr_t instance = 0, physical_device = 0, device = 0, queue = 0;
+  uint32_t queue_family = 0;
+  bool enabled_shader_image_gather_extended = false;
+};
+struct GraphicsCapabilities {
+  uint32_t api_version = 0, max_image_dimension_2d = 0;
+  uint32_t max_viewport_dimensions[2]{};
+  float viewport_bounds[2]{}, max_sampler_lod_bias = 0;
+  bool negative_viewport_height = false;
+};
+struct PresentationDiagnostics {
+  uint32_t api_version = 0, driver_version = 0, vendor_id = 0, device_id = 0,
+           queue_family = 0;
+  bool maintenance_khr = false;
+  std::vector<std::string> instance_extensions, device_extensions;
+};
+struct PoolInfo {
+  uint64_t size = 0;
+  bool coherent = false;
+  uint64_t device_address = 0;
+};
+// Owner-thread API. No guest addresses or layouts are interpreted here.
+// Errors throw std::runtime_error; invalid operations leave existing resources
+// intact. Destroy views before pools. Device destruction releases all remaining
+// resources.
+class VulkanDevice {
+public:
+  explicit VulkanDevice(DeviceOptions options = {});
+  ~VulkanDevice();
+  VulkanDevice(const VulkanDevice &) = delete;
+  VulkanDevice &operator=(const VulkanDevice &) = delete;
+  PoolHandle CreatePool(uint64_t size, uint32_t unsupported_flags = 0);
+  void DestroyPool(PoolHandle pool);
+  BufferViewHandle CreateView(PoolHandle pool, uint64_t offset, uint64_t size);
+  void DestroyView(BufferViewHandle view);
+  void Upload(BufferViewHandle view, uint64_t offset,
+              std::span<const std::byte> bytes);
+  void Download(BufferViewHandle view, uint64_t offset,
+                std::span<std::byte> bytes);
+  void Flush(BufferViewHandle view, uint64_t offset, uint64_t size);
+  void Invalidate(BufferViewHandle view, uint64_t offset, uint64_t size);
+  PoolInfo GetPoolInfo(PoolHandle pool) const;
+  uint64_t GetDeviceAddress(BufferViewHandle view) const;
+  std::string DeviceName() const;
+  BufferBinding GetBufferBinding(BufferViewHandle view) const;
+  VulkanHandles GetNativeHandles() const;
+  GraphicsCapabilities GetCapabilities() const;
+  uintptr_t PresentationSurface() const;
+  uintptr_t PresentationWindow() const;
+  PresentationDiagnostics GetPresentationDiagnostics() const;
+  bool PresentationUsesKhrMaintenance() const;
+
+private:
+  struct Impl;
+  std::unique_ptr<Impl> impl;
+};
+} // namespace native_graphics
diff --git a/native-runtime/host.cpp b/native-runtime/host.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/host.cpp
@@ -0,0 +1,506 @@
+#include "host.h"
+#include <algorithm>
+#include <cstring>
+#include <stdexcept>
+#if defined(_M_X64) || defined(__x86_64__)
+#include <xmmintrin.h>
+#endif
+namespace native {
+static Host &owner(void *p) { return *static_cast<Host *>(p); }
+static uint64_t load(void *p, uint64_t a, uint32_t n) {
+  auto &h = owner(p);
+  return n ? h.read(a, n) : h.read(a, 4, true) | UINT64_C(0x100000000);
+}
+static void store(void *p, uint64_t a, uint32_t n, uint64_t v) {
+  owner(p).write(a, n, v);
+}
+static uint64_t exclusive_load(void *p, uint64_t a, uint32_t n) {
+  auto &h = owner(p);
+  h.clear_reservation();
+  if (!n || n > 8 || (n & (n - 1)) || a % n)
+    throw std::runtime_error("exclusive load alignment");
+  h.check(a, n, 1);
+  auto v = h.read(a, n);
+  h.reservation = a;
+  h.reservation_size = n;
+  h.reservation_epoch = h.epoch;
+  return v;
+}
+static uint32_t exclusive_store(void *p, uint64_t a, uint32_t n, uint64_t v) {
+  auto &h = owner(p);
+  bool valid = h.reservation == a && h.reservation_size == n &&
+               h.reservation_epoch == h.epoch;
+  h.clear_reservation();
+  if (!n || n > 8 || (n & (n - 1)) || a % n)
+    throw std::runtime_error("exclusive store alignment");
+  if (!valid)
+    return 1;
+  h.check(a, n, 2);
+  h.write(a, n, v);
+  return 0;
+}
+static void clear(void *p) { owner(p).clear_reservation(); }
+static void pair_load(void *p, uint64_t a, uint32_t n, uint64_t *lo,
+                      uint64_t *hi) {
+  auto &h = owner(p);
+  h.clear_reservation();
+  if ((n != 4 && n != 8) || a % (2 * n))
+    throw std::runtime_error("exclusive pair load alignment");
+  h.check(a, 2 * n, 1);
+  const auto first = h.read(a, n), second = h.read(a + n, n);
+  *lo = first;
+  *hi = second;
+  h.reservation = a;
+  h.reservation_size = 2 * n;
+  h.reservation_epoch = h.epoch;
+}
+static uint32_t pair_store(void *p, uint64_t a, uint32_t n, uint64_t lo,
+                           uint64_t hi) {
+  auto &h = owner(p);
+  bool valid = h.reservation == a && h.reservation_size == 2 * n &&
+               h.reservation_epoch == h.epoch;
+  h.clear_reservation();
+  if ((n != 4 && n != 8) || a % (2 * n))
+    throw std::runtime_error("exclusive pair store alignment");
+  if (!valid)
+    return 1;
+  h.check(a, 2 * n, 2);
+  h.write(a, n, lo);
+  h.write(a + n, n, hi);
+  return 0;
+}
+static uint64_t counter(void *p) {
+  auto &h = owner(p);
+  return h.counter_override ? h.counter_override() : h.ticks;
+}
+Host::Host() : memory(64 * 4096) {
+  bridge.user = this;
+  bridge.load = load;
+  bridge.store = store;
+  bridge.excl_load = exclusive_load;
+  bridge.excl_store = exclusive_store;
+  bridge.clear_excl = clear;
+  bridge.excl_load_pair = pair_load;
+  bridge.excl_store_pair = pair_store;
+  bridge.read_cntpct = counter;
+  bridge.page_entries = nullptr; // Callback bus remains authoritative until
+                                 // fastmem invalidation is integrated.
+  bridge.page_entry_stride = sizeof(Page);
+  bridge.page_bits = 12;
+  bridge.pointer_mask = ~UINT64_C(3);
+  bridge.address_space_max = memory.size();
+  context.host_mem = &bridge;
+#ifdef RECOMP_FEATURE_FASTMEM_PT1
+  context.fm_table = reinterpret_cast<const unsigned char *>(table.data());
+  context.fm_limit = 0;
+#endif
+  context.pending_svc = ~UINT64_C(0);
+}
+void Host::map(uint64_t a, const void *bytes, size_t n, unsigned permission) {
+  if (!bytes || (permission != 1 && permission != 3 && permission != 5))
+    throw std::runtime_error("unsupported mapping permission/source");
+  if (a % 4096 || !n || n % 4096 || a > memory.size() || n > memory.size() - a)
+    throw std::runtime_error("map range/alignment");
+  for (size_t i = a / 4096; i < (a + n) / 4096; ++i)
+    if (permissions[i])
+      throw std::runtime_error("overlapping mapping");
+  memcpy(memory.data() + a, bytes, n);
+  for (size_t i = a / 4096; i < (a + n) / 4096; ++i) {
+    permissions[i] = uint8_t(permission);
+    table[i].pointer =
+        (permission == 3)
+            ? (reinterpret_cast<uintptr_t>(memory.data() + i * 4096) -
+               i * 4096) |
+                  1
+            : 0;
+    table[i].watch = (permission & 4) ? 1 : 0;
+  }
+}
+uint64_t Host::read(uint64_t a, unsigned n, bool instruction) {
+  last_address = a;
+  last_access_size = n;
+  last_access_write = false;
+  if (instruction)
+    ++instruction_reads;
+  else
+    ++data_reads;
+  if (address_space) {
+    auto value = address_space->read(a, n, instruction);
+    if (!instruction && record_events)
+      events.push_back({a, value, n, false});
+    return value;
+  }
+  if (!n || n > 8 || a > memory.size() || n > memory.size() - a)
+    throw std::runtime_error("read range");
+  for (unsigned i = 0; i < n; ++i)
+    if (!(permissions[(a + i) / 4096] & (instruction ? 4 : 1)))
+      throw std::runtime_error("read permission");
+  uint64_t value = 0;
+  memcpy(&value, memory.data() + a, n);
+  if (!instruction && record_events)
+    events.push_back({a, value, n, false});
+  return value;
+}
+void Host::write(uint64_t a, unsigned n, uint64_t v) {
+  last_address = a;
+  last_access_size = n;
+  last_access_write = true;
+  if (address_space) {
+    address_space->write(a, n, v);
+    if (record_events)
+      events.push_back({a, v, n, true});
+    ++data_writes;
+    ++epoch;
+    return;
+  }
+  if (!n || n > 8 || a > memory.size() || n > memory.size() - a)
+    throw std::runtime_error("write range");
+  for (unsigned i = 0; i < n; ++i)
+    if (!(permissions[(a + i) / 4096] & 2))
+      throw std::runtime_error("write permission");
+  if (record_events)
+    events.push_back({a, v, n, true});
+  ++data_writes;
+  memcpy(memory.data() + a, &v, n);
+  ++epoch;
+}
+void Host::clear_reservation() { reservation_size = 0; }
+uint32_t Host::register_current_thread(uint64_t id, int32_t priority,
+                                       unsigned core) {
+  if (current_thread_handle || !id || priority < 0 || priority > 63 || core > 3)
+    throw std::runtime_error("invalid native main thread registration");
+  current_thread_handle = MainThreadHandle;
+  threads.emplace(current_thread_handle,
+                  ThreadObject{id, priority, core, UINT64_C(1) << core,
+                               &context, context.tpidrro_el0});
+  return current_thread_handle;
+}
+const ThreadObject *Host::find_thread(uint32_t handle) const {
+  if (handle == CurrentThreadHandle)
+    handle = current_thread_handle;
+  auto it = threads.find(handle);
+  return it == threads.end() ? nullptr : &it->second;
+}
+void Host::seal_code() {
+  if (!address_space || sealed_code_space_)
+    throw std::runtime_error("invalid code seal binding");
+  address_space->seal_code();
+  sealed_code_space_ = address_space;
+}
+void Host::check(uint64_t a, unsigned n, unsigned permission) const {
+  if (!n || n > 16 || a > UINT64_MAX - n)
+    throw std::runtime_error("bus preflight range");
+  if (address_space) {
+    for (unsigned i = 0; i < n; i += 8)
+      address_space->check(a + i, std::min(8u, n - i), permission);
+    return;
+  }
+  if (a > memory.size() || n > memory.size() - a)
+    throw std::runtime_error("bus preflight bounds");
+  for (unsigned i = 0; i < n; ++i)
+    if ((permissions[(a + i) / 4096] & permission) != permission)
+      throw std::runtime_error("bus preflight permission");
+}
+void Host::advance_time(uint64_t ns) {
+  constexpr uint64_t frequency = 19200000, denominator = 1000000000;
+  if (clock_remainder >= denominator)
+    throw std::runtime_error("invalid virtual clock remainder");
+  const uint64_t fraction = (ns % denominator) * frequency + clock_remainder;
+  const uint64_t whole = (ns / denominator) * frequency;
+  const uint64_t increment = whole + fraction / denominator;
+  if (ns > UINT64_MAX - sleep_ns || increment > UINT64_MAX - ticks)
+    throw std::runtime_error("virtual clock overflow");
+  ticks += increment;
+  clock_remainder = fraction % denominator;
+  sleep_ns += ns;
+}
+void Host::service() {
+  const auto svc = context.pending_svc;
+  ++svc_calls;
+  if (svc_observer)
+    svc_observer(context, false);
+  if (std::find(allowed_svcs.begin(), allowed_svcs.end(), svc) ==
+      allowed_svcs.end())
+    throw std::runtime_error("SVC capability denied");
+  switch (svc) {
+  case 31: {
+    const auto address = context.x[1];
+    if (address > UINT64_MAX - 12)
+      throw std::runtime_error("native port name address overflow");
+    std::string name;
+    for (unsigned i = 0; i < 12; ++i) {
+      auto c = read(address + i, 1);
+      if (!c)
+        break;
+      name += char(c);
+    }
+    if (name.size() > 11)
+      name.resize(11);
+    if (!connect_named_port)
+      throw std::runtime_error("native named port provider unavailable: " +
+                               name);
+    auto result = connect_named_port(name);
+    if (!result.result &&
+        (result.handle < 0x10000u || find_thread(result.handle) ||
+         result.handle >= 0xffff8000u))
+      throw std::runtime_error("invalid native session handle");
+    context.x[0] = result.result;
+    context.x[1] = result.handle;
+    break;
+  }
+  case 33: {
+    if (!send_sync_request)
+      throw std::runtime_error("native synchronous IPC provider unavailable");
+    auto thread = find_thread(0xffff8000u);
+    if (!thread || thread->tls_address != context.tpidrro_el0)
+      throw std::runtime_error("native IPC TLS binding unavailable");
+    context.x[0] =
+        send_sync_request(uint32_t(context.x[0]), thread->tls_address);
+    break;
+  }
+  case 0x18:
+    if (begin_wait())
+      return;
+    break;
+  case 0x16: { // CloseHandle; WaitSynchronization uses 0x18 above.
+    const auto handle = uint32_t(context.x[0]);
+    if (handle >= 0xffff8000u) {
+      context.x[0] = 1u | (114u << 9);
+      break;
+    }
+    if (find_thread(handle))
+      throw std::runtime_error("native thread handle closure unsupported");
+    if (handle >= EventHandleBegin && handle < EventHandleEnd) {
+      context.x[0] = event_registry.Close(handle) ? 0 : (1u | (114u << 9));
+      break;
+    }
+    if (handle < SessionHandleBegin || handle >= SessionHandleEnd) {
+      context.x[0] = 1u | (114u << 9);
+      break;
+    }
+    if (!close_session)
+      throw std::runtime_error("native session closure provider unavailable");
+    context.x[0] = close_session(handle);
+    break;
+  }
+  case 29: {
+    const auto key = context.x[0] & ~UINT64_C(3);
+    auto it = condition_waiters.find(key);
+    if (it != condition_waiters.end() && !it->second.empty())
+      throw std::runtime_error(
+          "condition signal with blocked native waiters unsupported");
+    check(key, 4, 2);
+    write(key, 4, 0);
+    break;
+  }
+  case 30:
+    context.x[0] = bridge.read_cntpct(bridge.user);
+    break;
+  case 12: {
+    auto thread = find_thread(uint32_t(context.x[1]));
+    context.x[0] = thread ? 0 : 1u | (114u << 9);
+    context.x[1] = thread ? uint32_t(thread->priority) : 0;
+    break;
+  }
+  case 14: {
+    auto thread = find_thread(uint32_t(context.x[2]));
+    context.x[0] = thread ? 0 : 1u | (114u << 9);
+    context.x[1] = thread ? thread->ideal_core : 0;
+    context.x[2] = thread ? thread->affinity_mask : 0;
+    break;
+  }
+  case 16: {
+    auto thread = find_thread(0xffff8000u);
+    if (!thread)
+      throw std::runtime_error("native current thread unavailable");
+    context.x[0] = thread->ideal_core;
+    break;
+  }
+  case 37: {
+    auto thread = find_thread(uint32_t(context.x[1]));
+    context.x[0] = thread ? 0 : 1u | (114u << 9);
+    context.x[1] = thread ? thread->id : 0;
+    break;
+  }
+  case 6: {
+    if (!address_space)
+      throw std::runtime_error("QueryMemory requires process address space");
+    auto info = address_space->query(context.x[2]);
+    const auto destination = context.x[0];
+    if (destination > UINT64_MAX - 40)
+      throw std::runtime_error("QueryMemory output overflow");
+    for (unsigned i = 0; i < 40; i += 8)
+      check(destination + i, 8, 2);
+    write(destination, 8, info.address);
+    write(destination + 8, 8, info.size);
+    write(destination + 16, 8, info.state);
+    write(destination + 24, 8, info.permission);
+    write(destination + 32, 8, 0);
+    context.x[0] = 0;
+    context.x[1] = 0;
+    break;
+  }
+  case 41: {
+    const auto type = uint32_t(context.x[1]), handle = uint32_t(context.x[2]);
+    const auto sub = context.x[3];
+    uint64_t result = 0, info_value = 0;
+    if ((type >= 2 && type <= 7) || type == 12 || type == 13 || type == 14 ||
+        type == 15 || type == 16 || type == 17) {
+      if (sub)
+        result = 1u | (120u << 9);
+      else if (handle != 0xffff8001u)
+        result = 1u | (114u << 9);
+      else if (type == 16 || type == 17) {
+        if (!default_system_resources)
+          throw std::runtime_error(
+              "native system-resource ownership unavailable");
+        // KProcess default/non-secure system resources have no dedicated arena.
+        info_value = 0;
+      } else {
+        if (!process_layout)
+          throw std::runtime_error("native process layout unavailable");
+        if (type == 6 || type == 7) {
+          if (!address_space)
+            throw std::runtime_error("native memory accounting unavailable");
+          if (type == 6 && address_space->physical_budget() == UINT64_MAX)
+            throw std::runtime_error("native physical budget not configured");
+          info_value = type == 6 ? address_space->physical_budget()
+                                 : address_space->committed_bytes();
+        } else if (type == 12 || type == 13)
+          info_value = type == 12 ? process_layout->aslr_address
+                                  : process_layout->aslr_size;
+        else {
+          if (!address_space)
+            throw std::runtime_error(
+                "native process address space unavailable");
+          auto range = address_space->reserved_range(type < 4   ? 7
+                                                     : type < 6 ? 5
+                                                                : 11);
+          info_value = (type % 2) ? range.size : range.address;
+        }
+      }
+    } else if (type != 11)
+      throw std::runtime_error("unsupported GetInfo type " +
+                               std::to_string(type));
+    else if (handle)
+      result = 1u | (114u << 9);
+    else if (sub >= 4)
+      result = 1u | (116u << 9);
+    else {
+      if (!entropy_available)
+        throw std::runtime_error("process entropy unavailable");
+      info_value = entropy[size_t(sub)];
+    }
+    context.x[0] = result;
+    context.x[1] = info_value;
+    break;
+  }
+  case 0x27: {
+    if (context.x[1] > 4096)
+      throw std::runtime_error("debug string limit");
+    std::string text;
+    for (uint64_t i = 0; i < context.x[1]; ++i)
+      text += char(read(context.x[0] + i, 1));
+    output += text;
+    context.x[0] = 0;
+    break;
+  }
+  case 0xb:
+    if (context.x[0] > UINT64_C(1000000000))
+      throw std::runtime_error("unsupported sleep interval");
+    advance_time(context.x[0]);
+    if (sleep_override)
+      sleep_override(context.x[0]);
+    clear_reservation();
+    break;
+  case 7:
+    exited = true;
+    clear_reservation();
+    break;
+  default:
+    throw std::runtime_error("unsupported SVC " + std::to_string(svc));
+  }
+  if (svc_observer)
+    svc_observer(context, true);
+  context.pending_svc = ~UINT64_C(0);
+}
+bool Host::code_binding_valid() const noexcept {
+  return !sealed_code_space_ ||
+         (address_space == sealed_code_space_ && address_space->code_sealed());
+}
+void Host::dispatch(unsigned budget, unsigned max_slices,
+                    bool yield_after_limit) {
+  if (dispatch_active_)
+    throw std::runtime_error("recursive host dispatch");
+  struct DispatchScope {
+    bool &active;
+    ~DispatchScope() { active = false; }
+  } scope{dispatch_active_};
+  dispatch_active_ = true;
+  if (!budget || budget > 4096)
+    throw std::runtime_error("slice budget");
+  for (unsigned step = 0; step < max_slices && !exited; ++step) {
+    if (interrupt)
+      return;
+    if (event_wait_failed_)
+      throw std::runtime_error("native wait terminal ownership fault");
+    if (event_wait_) {
+      if (!poll_wait())
+        return;
+      continue;
+    }
+    if (pending_scheduler &&
+        pending_scheduler->recognizes(uint32_t(context.halted))) {
+      const auto outcome = pending_scheduler->poll(*this);
+      if (outcome == PendingDispatch::Parked)
+        return;
+      if (outcome != PendingDispatch::Committed)
+        throw std::runtime_error("native pending operation terminated");
+      continue;
+    }
+    if (!code_binding_valid())
+      throw std::runtime_error("sealed code address-space binding changed");
+    if (context.halted)
+      throw std::runtime_error("guest halted " +
+                               std::to_string(context.halted));
+    if (context.pending_svc != ~UINT64_C(0)) {
+      service();
+      if (event_wait_)
+        return;
+      continue;
+    }
+    const Module *selected = nullptr;
+    for (const auto &m : modules)
+      if (m.lookup(context.pc)) {
+        if (selected)
+          throw std::runtime_error("ambiguous module");
+        selected = &m;
+      }
+    if (!selected)
+      throw std::runtime_error("unresolved static PC/import");
+    context.chain_budget = budget;
+#if defined(RECOMP_FEATURE_FPX1) && (defined(_M_X64) || defined(__x86_64__))
+    _mm_setcsr((_mm_getcsr() & 0x3fu) | 0x1f80u);
+#endif
+    if (guest_active_)
+      throw std::runtime_error("recursive guest dispatch");
+    ++slices;
+    guest_active_ = true;
+    try {
+      selected->slice(&context);
+    } catch (...) {
+      guest_active_ = false;
+      throw;
+    }
+    guest_active_ = false;
+    blocks += budget - unsigned(context.chain_budget) +
+              (context.chain_budget > 0 ? 1 : 0);
+    // Return through all generated C frames before any scheduled work runs.
+    if (pending_scheduler &&
+        pending_scheduler->recognizes(uint32_t(context.halted)))
+      return;
+  }
+  if (!exited && !interrupt && !yield_after_limit)
+    throw std::runtime_error("execution budget exhausted");
+}
+} // namespace native
