+      std::vector<VkImage> native(count);
+      Check(
+          P(vkGetSwapchainImagesKHR)(device, swapchain, &count, native.data()),
+          "Swap images");
+      images.resize(count);
+      for (uint32_t n = 0; n < count; ++n) {
+        auto &i = images[n];
+        i.image = native[n];
+        VkImageViewCreateInfo vi{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+        vi.image = i.image;
+        vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        vi.format = ci.imageFormat;
+        vi.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+        Check(P(vkCreateImageView)(device, &vi, nullptr, &i.view),
+              "Swap image view");
+        VkSemaphoreCreateInfo si{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+        Check(P(vkCreateSemaphore)(device, &si, nullptr, &i.finished),
+              "Per-image render semaphore");
+        VkFenceCreateInfo fi{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+        Check(P(vkCreateFence)(device, &fi, nullptr, &i.present),
+              "Per-image present fence");
+      }
+      const bool encode = format == PresentationFormat::Bgra8Unorm ||
+                          format == PresentationFormat::Rgba8Unorm;
+      vertex = ConversionShader(true, false);
+      fragment = ConversionShader(false, encode);
+      ++counters.recreated;
+    } catch (...) {
+      DestroyImages();
+      terminal = true;
+      throw;
+    }
+  }
+  void Consume(VkSemaphore sem) {
