@@ -0,0 +1,13 @@
+#pragma once
+#include <cstdint>
+namespace native {
+inline constexpr uint32_t MainThreadHandle = 0x100;
+inline constexpr uint32_t SessionHandleBegin = 0x10000,
+                          SessionHandleEnd = 0x20000;
+inline constexpr uint32_t EventHandleBegin = 0x20000, EventHandleEnd = 0x30000;
+inline constexpr uint32_t CurrentThreadHandle = 0xffff8000u,
+                          CurrentProcessHandle = 0xffff8001u;
