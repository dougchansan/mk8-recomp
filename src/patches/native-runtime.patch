+inline const char* NativeApiH() {
+    return R"RT(
+#ifndef RECOMP_NATIVE_API_V2
+#define RECOMP_NATIVE_API_V2 2u
+#define RECOMP_NATIVE_API_SYNC_INT32_AAPCS64 UINT64_C(1)
+#define RECOMP_NATIVE_API_CODESEALED UINT64_C(2)
+#define RECOMP_NATIVE_API_LAYOUT_TAG ((uint64_t)sizeof(GuestContext) ^ ((uint64_t)offsetof(GuestContext,pc)<<16) ^ ((uint64_t)offsetof(GuestContext,vreg)<<32) ^ ((uint64_t)offsetof(GuestContext,chain_budget)<<48) ^ (uint64_t)offsetof(GuestContext,fpcr) ^ ((uint64_t)offsetof(GuestContext,fpsr)<<8))
+enum RecompNativeApiOutcomeV2 { RECOMP_NATIVE_API_DECLINE=0, RECOMP_NATIVE_API_HANDLED=1, RECOMP_NATIVE_API_FAULT=2 };
+typedef struct RecompNativeApiRangeV2 { uint64_t relative_pc; uint32_t count; const uint32_t* words; } RecompNativeApiRangeV2;
+/* Quiescent installation/removal; immutable binding/user storage must outlive
+   dispatch. Attest must be a pure check of ACTUAL verified module ID/text SHA,
+   immutable executable backing and no writable aliases, not descriptor echoing.
+   Revoke before any backing/protection change. Invoke is synchronous bounded
+   metadata work only. DECLINE has zero context/memory/native-object effects.
+   No pending operations, GPU allocation/compilation/waits or SVC reuse here.
+   Each handled API consumes only its enclosing real dispatch; counters below
+   report native calls independently and never fabricate skipped block work. */
+typedef struct RecompNativeApiBindingV2 {
+  uint32_t revision,size,context_size,reserved;
+  uint64_t layout_tag,capabilities;
+  void* user;
+  int (*attest)(void*,const char* build_id,const char* text_sha256,uint64_t guest_entry,uint32_t operation,uint32_t signature);
+  int (*invoke)(void*,GuestContext*,uint32_t operation,uint32_t signature,uint64_t guest_entry);
+} RecompNativeApiBindingV2;
+extern uint64_t recomp_native_api_calls_v2,recomp_native_api_faults_v2;
+int recomp_native_api_bind_v2(const RecompNativeApiBindingV2*);
+int recomp_try_native_api_v2(GuestContext*,uint64_t,const char*,const char*,uint32_t,uint32_t,const RecompNativeApiRangeV2*,uint32_t,int);
+#endif
+)RT";
+}
+inline const char* NativeApiC() {
+    return R"RT(
+#ifdef _MSC_VER
+#include <intrin.h>
+#endif
+static const RecompNativeApiBindingV2* recomp_native_api_binding_v2;
+uint64_t recomp_native_api_calls_v2=0,recomp_native_api_faults_v2=0;
+static void recomp_native_api_increment_v2(uint64_t* counter){
+#ifdef _MSC_VER
+  _InterlockedIncrement64((volatile __int64*)counter);
+#else
+  __atomic_fetch_add(counter,1u,__ATOMIC_RELAXED);
+#endif
+}
+int recomp_native_api_bind_v2(const RecompNativeApiBindingV2* binding){
+  recomp_native_api_binding_v2=0;
+  if(!binding)return 1;
+  if(binding->revision!=2 || binding->size!=sizeof(*binding) || binding->context_size!=sizeof(GuestContext) ||
+     binding->reserved || binding->layout_tag!=RECOMP_NATIVE_API_LAYOUT_TAG ||
+     binding->capabilities!=(RECOMP_NATIVE_API_SYNC_INT32_AAPCS64|RECOMP_NATIVE_API_CODESEALED) ||
+     !binding->attest || !binding->invoke)return 0;
+  recomp_native_api_binding_v2=binding;return 1;
+}
+int recomp_try_native_api_v2(GuestContext* c,uint64_t module_base,const char* build,const char* digest,
+    uint32_t operation,uint32_t signature,const RecompNativeApiRangeV2* ranges,uint32_t count,int guard_version){
+  const RecompNativeApiBindingV2* binding=recomp_native_api_binding_v2;
+  uint64_t saved[14],vectors[8][2],fpcr,fpsr,entry=c->pc;
+  int budget=c->chain_budget;
+  uint32_t i,total=0;int outcome;
+  if(!ranges || !count || count>32)return 0;
+  for(i=0;i<count;++i){if(!ranges[i].words || !ranges[i].count || ranges[i].count>4096-total)return 0;total+=ranges[i].count;}
+  if(!binding || c->halted || (c->x[31]&15u) || c->pending_svc!=~UINT64_C(0) ||
+     !binding->attest(binding->user,build,digest,entry,operation,signature))return 0;
+  for(i=0;i<count;++i){
+    if(module_base>UINT64_MAX-ranges[i].relative_pc){c->halted=RECOMP_HALT_UNHANDLED;return 1;}
+    recomp_code_guard(c,module_base+ranges[i].relative_pc,ranges[i].words,ranges[i].count,guard_version);
+    if(c->halted)return 1;
+  }
+  for(i=0;i<14;++i)saved[i]=c->x[18+i];
+  for(i=0;i<8;++i){vectors[i][0]=c->vreg[8+i][0];vectors[i][1]=c->vreg[8+i][1];}
+  fpcr=c->fpcr;fpsr=c->fpsr;
+  outcome=binding->invoke(binding->user,c,operation,signature,entry);
+  if(outcome==RECOMP_NATIVE_API_DECLINE)return 0;
+  for(i=0;i<14;++i)c->x[18+i]=saved[i];
+  for(i=0;i<8;++i){c->vreg[8+i][0]=vectors[i][0];c->vreg[8+i][1]=vectors[i][1];}
+  c->fpcr=fpcr;c->fpsr=fpsr;
+  c->chain_budget=budget;c->pending_svc=~UINT64_C(0);
+  recomp_native_api_increment_v2(&recomp_native_api_calls_v2);
+  if(outcome==RECOMP_NATIVE_API_HANDLED){c->x[0]=(uint32_t)c->x[0];c->pc=saved[12];}
+  else {if(!c->halted)c->halted=RECOMP_HALT_UNHANDLED;recomp_native_api_increment_v2(&recomp_native_api_faults_v2);}
+  return 1;
+}
+)RT";
+}
