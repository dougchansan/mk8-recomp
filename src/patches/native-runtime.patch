diff --git a/native-runtime/textures/README.md b/native-runtime/textures/README.md
new file mode 100644
--- /dev/null
+++ b/native-runtime/textures/README.md
@@ -0,0 +1,39 @@
+# Bounded native texture asset conversion
+
+This CPU-only component interprets the existing `TICEntry` data schema and
+converts supported 2D level-zero asset bytes into native upload data. It invokes
+the existing pure block-linear conversion functions in `textures/decoders.cpp`
+and the existing MPL-2.0 Skyline/SwiftShader-derived `bc_decoder` source. It does
+not instantiate the guest GPU, command processor, kernel or emulator system.
+The compiled helpers retain their original source and license notices.
+
+Supported inputs are UNORM RGBA8 (including sRGB), packed A2B10G10R10, BC4 and
+BC5. The result preserves sRGB metadata, packed ten-bit precision and component
+swizzles. BC4/BC5 become R8/RG8 texels with their original swizzles; no gamma
+conversion, invented alpha, resizing or padding of missing input data occurs.
+Unsupported shapes and short backing reject before conversion.
+
+Limits are one normalized 2D mip/layer, no sparse/depth/multisample interpretation,
+8192-pixel dimensions, 64 MiB buffers, pitch or ordinary block-linear layout and
+block-height log2 0–5. Buffer sizes and all source ranges are checked before the
+existing unchecked conversion helpers are called.
+
+Descriptor border value 7 selects sampler-provided border color, as specified
+by NVIDIA's [Maxwell texture header](https://github.com/NVIDIA/open-gpu-doc/blob/master/classes/3d/clb197tex.h).
+Stored border modes 0–3 are rejected; they cannot be treated as ordinary image
+storage. The converter does not infer layout from another title's NVN enums.
+
+Configure this directory independently and run its CTest. The development build
+uses existing fmt headers through `NATIVE_TEXTURE_FMT_ROOT`; no download is
+performed. The native assertion adapter avoids linking emulator settings or
+logging libraries. The GPU header formerly included by the pure tiling helper
+was unused and is removed. Clean-machine and cross-platform builds remain
+unverified.
+
+`native_texture_probe DESCRIPTOR32 STORAGE TEXELS JSON` consumes caller-owned
+inputs and writes unused output paths. Synthetic tests cover an independent
+coordinate-address oracle, odd and multi-GOB dimensions, block heights, short
+backing, pitch, clipped multi-block BC4/BC5, metadata and precision preservation.
+Successful asset conversion is separate from native image upload, sampling,
+rendering or game-frame equivalence. GPU-produced image contents require their
+actual producers; CPU backing is not a substitute for completed GPU writes.
diff --git a/native-runtime/textures/codec.cpp b/native-runtime/textures/codec.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/textures/codec.cpp
@@ -0,0 +1,181 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "codec.h"
+#include "bc_decoder.h"
+#include "video_core/textures/decoders.h"
+#include <algorithm>
+#include <cstring>
+#include <stdexcept>
+
+namespace native_textures {
+namespace {
+constexpr uint64_t MaximumBytes = 64u << 20;
+constexpr uint32_t MaximumDimension = 8192;
+void Require(bool condition, const char *message) {
+  if (!condition)
+    throw std::runtime_error(message);
+}
+struct Shape {
+  uint32_t width, height, bytes;
+};
+Shape Blocks(const Layout &layout) {
+  Require(layout.width && layout.height && layout.width <= MaximumDimension &&
+              layout.height <= MaximumDimension,
+          "Texture dimensions outside native bound");
+  Require(layout.block_height_log2 <= 5, "Unsupported block height");
+  for (const auto source : layout.swizzle)
+    Require(source == 0 || (source >= 2 && source <= 5) || source == 7,
+            "Unsupported UNORM swizzle");
+  switch (layout.format) {
+  case Format::Rgba8Unorm:
+  case Format::Rgba8Srgb:
+  case Format::A2b10g10r10Unorm:
+    return {layout.width, layout.height, 4};
+  case Format::Bc4Unorm:
+    return {(layout.width + 3) / 4, (layout.height + 3) / 4, 8};
+  case Format::Bc5Unorm:
+    return {(layout.width + 3) / 4, (layout.height + 3) / 4, 16};
+  default:
+    throw std::runtime_error("Unsupported encoded texture format");
+  }
+}
+uint64_t Bounded(uint64_t bytes) {
+  Require(bytes && bytes <= MaximumBytes,
+          "Texture storage exceeds native bound");
+  return bytes;
+}
+} // namespace
+
+Layout ParseDescriptor(std::span<const std::byte> descriptor) {
+  Require(descriptor.size() == sizeof(Tegra::Texture::TICEntry),
+          "Descriptor must be exactly 32 bytes");
+  Tegra::Texture::TICEntry tic{};
+  std::memcpy(&tic, descriptor.data(), descriptor.size());
+  using namespace Tegra::Texture;
+  Require(tic.texture_type == TextureType::Texture2D && tic.Depth() == 1 &&
+              tic.BaseLayer() == 0 && tic.res_min_mip_level == 0 &&
+              tic.res_max_mip_level == 0 && tic.max_mip_level == 0 &&
+              tic.msaa_mode == MsaaMode::Msaa1x1 && !tic.is_sparse &&
+              !tic.depth_texture && tic.border_size == 7 &&
+              tic.normalized_coords,
+          "Unsupported texture view/mip/layer/sample/coordinate mode");
+  // NVIDIA clb197tex.h identifies border value 7 as sampler-color mode.
+  // Values 0..3 describe stored texture borders and require a different layout.
+  Require(tic.r_type == ComponentType::UNORM &&
+              tic.g_type == ComponentType::UNORM &&
+              tic.b_type == ComponentType::UNORM &&
+              tic.a_type == ComponentType::UNORM,
+          "Unsupported texture component type");
+  Layout result{Format::Rgba8Unorm,
+                tic.Width(),
+                tic.Height(),
+                0,
+                0,
+                false,
+                {static_cast<uint8_t>(tic.x_source.Value()),
+                 static_cast<uint8_t>(tic.y_source.Value()),
+                 static_cast<uint8_t>(tic.z_source.Value()),
+                 static_cast<uint8_t>(tic.w_source.Value())}};
+  switch (tic.format.Value()) {
+  case TextureFormat::A8B8G8R8:
+    result.format =
+        tic.srgb_conversion ? Format::Rgba8Srgb : Format::Rgba8Unorm;
+    break;
+  case TextureFormat::A2B10G10R10:
+    Require(!tic.srgb_conversion, "Packed ten-bit sRGB is unsupported");
+    result.format = Format::A2b10g10r10Unorm;
+    break;
+  case TextureFormat::DXN1:
+    Require(!tic.srgb_conversion, "BC4 sRGB is unsupported");
+    result.format = Format::Bc4Unorm;
+    break;
+  case TextureFormat::DXN2:
+    Require(!tic.srgb_conversion, "BC5 sRGB is unsupported");
+    result.format = Format::Bc5Unorm;
+    break;
+  default:
+    throw std::runtime_error("Unsupported texture descriptor format");
+  }
+  if (tic.header_version == TICHeaderVersion::BlockLinear) {
+    Require(tic.block_width == 0 && tic.block_depth == 0 &&
+                tic.tile_width_spacing == 0,
+            "Unsupported block-linear geometry");
+    result.tiled = true;
+    result.block_height_log2 = tic.block_height;
+  } else if (tic.header_version == TICHeaderVersion::Pitch) {
+    // The primary TIC schema specifies a 32-byte pitch unit.
+    result.pitch = static_cast<uint32_t>(tic.pitch_high) << 5;
+  } else {
+    throw std::runtime_error("Unsupported texture header version");
+  }
+  (void)RequiredStorage(result);
+  return result;
+}
+
+uint64_t RequiredStorage(const Layout &layout) {
+  const auto blocks = Blocks(layout);
+  const uint64_t row = uint64_t(blocks.width) * blocks.bytes;
+  if (layout.tiled) {
+    Require(layout.pitch == 0, "Tiled texture cannot declare a linear pitch");
+    const uint64_t rows = UINT64_C(8) << layout.block_height_log2;
+    return Bounded(((row + 63) & ~UINT64_C(63)) *
+                   ((blocks.height + rows - 1) / rows) * rows);
+  }
+  Require(layout.block_height_log2 == 0 && layout.pitch >= row &&
+              !(layout.pitch & 31),
+          "Invalid linear texture pitch");
+  return Bounded(uint64_t(layout.pitch) * blocks.height);
+}
+
+std::vector<std::byte> Linearize(const Layout &layout,
+                                 std::span<const std::byte> storage) {
+  const uint64_t required = RequiredStorage(layout);
+  Require(required <= storage.size(), "Texture backing is truncated");
+  const auto blocks = Blocks(layout);
+  const size_t row = size_t(blocks.width) * blocks.bytes;
+  std::vector<std::byte> result(
+      static_cast<size_t>(Bounded(row * blocks.height)));
+  if (layout.tiled) {
+    Tegra::Texture::UnswizzleTexture(
+        {reinterpret_cast<uint8_t *>(result.data()), result.size()},
+        {reinterpret_cast<const uint8_t *>(storage.data()),
+         static_cast<size_t>(required)},
+        blocks.bytes, blocks.width, blocks.height, 1, layout.block_height_log2,
+        0, 0);
+  } else {
+    for (uint32_t y = 0; y < blocks.height; ++y)
+      std::memcpy(result.data() + size_t(y) * row,
+                  storage.data() + size_t(y) * layout.pitch, row);
+  }
+  return result;
+}
+
+Texels Decode(const Layout &layout, std::span<const std::byte> storage) {
+  auto linear = Linearize(layout, storage);
+  Texels result{layout.format, layout.width, layout.height, layout.swizzle, {}};
+  if (layout.format != Format::Bc4Unorm && layout.format != Format::Bc5Unorm) {
+    result.bytes = std::move(linear);
+    return result;
+  }
+  const bool bc5 = layout.format == Format::Bc5Unorm;
+  const size_t channels = bc5 ? 2 : 1;
+  result.format = bc5 ? Format::Rg8Unorm : Format::R8Unorm;
+  result.bytes.resize(static_cast<size_t>(
+      Bounded(uint64_t(layout.width) * layout.height * channels)));
+  const auto blocks = Blocks(layout);
+  for (uint32_t y = 0; y < blocks.height; ++y) {
+    for (uint32_t x = 0; x < blocks.width; ++x) {
+      const auto *source = reinterpret_cast<const uint8_t *>(linear.data()) +
+                           (size_t(y) * blocks.width + x) * blocks.bytes;
+      auto *destination = reinterpret_cast<uint8_t *>(result.bytes.data()) +
+                          (size_t(y) * 4 * layout.width + x * 4) * channels;
+      if (bc5)
+        bcn::DecodeBc5(source, destination, x * 4, y * 4, layout.width,
+                       layout.height, false);
+      else
+        bcn::DecodeBc4(source, destination, x * 4, y * 4, layout.width,
+                       layout.height, false);
+    }
+  }
+  return result;
+}
+} // namespace native_textures
diff --git a/native-runtime/textures/codec.h b/native-runtime/textures/codec.h
new file mode 100644
--- /dev/null
+++ b/native-runtime/textures/codec.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace native_textures {
+enum class Format {
+  Rgba8Unorm,
+  Rgba8Srgb,
+  A2b10g10r10Unorm,
+  Bc4Unorm,
+  Bc5Unorm,
+  R8Unorm,
+  Rg8Unorm
+};
+struct Layout {
+  Format format;
+  uint32_t width, height, block_height_log2, pitch;
+  bool tiled;
+  std::array<uint8_t, 4> swizzle;
+};
+struct Texels {
+  Format format;
+  uint32_t width, height;
+  std::array<uint8_t, 4> swizzle;
+  std::vector<std::byte> bytes;
+};
+// Bounded, single-level 2D asset conversion. No guest memory or GPU ownership.
+// Gamma, packed ten-bit precision and component swizzles remain explicit.
+Layout ParseDescriptor(std::span<const std::byte> descriptor);
+uint64_t RequiredStorage(const Layout &layout);
+std::vector<std::byte> Linearize(const Layout &layout,
+                                 std::span<const std::byte> storage);
+Texels Decode(const Layout &layout, std::span<const std::byte> storage);
+} // namespace native_textures
diff --git a/native-runtime/textures/probe.cpp b/native-runtime/textures/probe.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/textures/probe.cpp
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "codec.h"
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <sstream>
+#include <stdexcept>
+#include <string_view>
+#ifdef _WIN32
+#define NOMINMAX
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#else
+#include <cerrno>
+#include <fcntl.h>
+#include <unistd.h>
+#endif
+
+static bool SameOutput(const std::filesystem::path &left,
+                       const std::filesystem::path &right) {
+  const auto a = std::filesystem::weakly_canonical(left).lexically_normal();
+  const auto b = std::filesystem::weakly_canonical(right).lexically_normal();
+#ifdef _WIN32
+  return CompareStringOrdinal(a.c_str(), -1, b.c_str(), -1, TRUE) == CSTR_EQUAL;
+#else
+  return a == b;
+#endif
+}
+class Output {
+public:
+  explicit Output(const std::filesystem::path &path) {
+#ifdef _WIN32
+    file_ = CreateFileW(path.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_NEW,
+                        FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file_ == INVALID_HANDLE_VALUE)
+      throw std::runtime_error("Cannot exclusively create output");
+#else
+    file_ = open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL, 0600);
+    if (file_ < 0)
+      throw std::runtime_error("Cannot exclusively create output");
+#endif
+  }
+  Output(const Output &) = delete;
+  Output &operator=(const Output &) = delete;
+  ~Output() {
+#ifdef _WIN32
+    if (file_ != INVALID_HANDLE_VALUE)
+      CloseHandle(file_);
+#else
+    if (file_ >= 0)
+      close(file_);
+#endif
+  }
+  void Write(std::span<const std::byte> bytes) {
+    while (!bytes.empty()) {
+      const size_t count =
+          bytes.size() > (1u << 20) ? (1u << 20) : bytes.size();
+#ifdef _WIN32
+      DWORD written = 0;
+      if (!WriteFile(file_, bytes.data(), static_cast<DWORD>(count), &written,
+                     nullptr) ||
+          written != count)
+        throw std::runtime_error("Output write failed");
+#else
+      const auto written = write(file_, bytes.data(), count);
+      if (written < 0 && errno == EINTR)
+        continue;
+      if (written <= 0)
+        throw std::runtime_error("Output write failed");
+      bytes = bytes.subspan(static_cast<size_t>(written));
+      continue;
+#endif
+      bytes = bytes.subspan(count);
+    }
+  }
+  void Finish() {
+#ifdef _WIN32
+    if (!FlushFileBuffers(file_))
+      throw std::runtime_error("Output flush failed");
+    const auto file = file_;
+    file_ = INVALID_HANDLE_VALUE;
+    if (!CloseHandle(file))
+      throw std::runtime_error("Output close failed");
+#else
+    if (fsync(file_) != 0)
+      throw std::runtime_error("Output flush failed");
+    const auto file = file_;
+    file_ = -1;
+    if (close(file) != 0)
+      throw std::runtime_error("Output close failed");
+#endif
+  }
+
+private:
+#ifdef _WIN32
+  HANDLE file_ = INVALID_HANDLE_VALUE;
+#else
+  int file_ = -1;
+#endif
+};
+
+static std::vector<std::byte> Read(const char *name, size_t maximum) {
+  std::ifstream stream(name, std::ios::binary | std::ios::ate);
+  if (!stream)
+    throw std::runtime_error("Cannot open input");
+  const auto size = stream.tellg();
+  if (size < 0 || static_cast<uint64_t>(size) > maximum)
+    throw std::runtime_error("Input file exceeds codec bound");
+  std::vector<std::byte> bytes(static_cast<size_t>(size));
+  stream.seekg(0);
+  if (!stream.read(reinterpret_cast<char *>(bytes.data()), size))
+    throw std::runtime_error("Truncated input read");
+  return bytes;
+}
+static std::string_view Name(native_textures::Format format) {
+  using native_textures::Format;
+  switch (format) {
+  case Format::Rgba8Unorm:
+    return "RGBA8_UNORM";
+  case Format::Rgba8Srgb:
+    return "RGBA8_SRGB";
+  case Format::A2b10g10r10Unorm:
+    return "A2B10G10R10_UNORM_PACK32";
+  case Format::R8Unorm:
+    return "R8_UNORM";
+  case Format::Rg8Unorm:
+    return "RG8_UNORM";
+  default:
+    throw std::runtime_error("Unsupported decoded format");
+  }
+}
+int main(int argc, char **argv) {
+  try {
+    if (argc != 5)
+      throw std::runtime_error("Usage: native_texture_probe descriptor32 "
+                               "input-storage output-texels output-json");
+    if (SameOutput(argv[3], argv[4]))
+      throw std::runtime_error("Output paths must be distinct");
+    if (std::filesystem::exists(argv[3]) || std::filesystem::exists(argv[4]))
+      throw std::runtime_error("Output paths must be unused");
+    auto descriptor = Read(argv[1], 32), storage = Read(argv[2], 64u << 20);
+    const auto layout = native_textures::ParseDescriptor(descriptor);
+    const auto decoded = native_textures::Decode(layout, storage);
+    std::ostringstream metadata;
+    metadata << "{\"width\":" << decoded.width
+             << ",\"height\":" << decoded.height << ",\"format\":\""
+             << Name(decoded.format) << "\",\"bytes\":" << decoded.bytes.size()
+             << ",\"required_storage\":"
+             << native_textures::RequiredStorage(layout) << ",\"swizzle\":[";
+    for (unsigned i = 0; i < 4; ++i)
+      metadata << (i ? "," : "") << unsigned(decoded.swizzle[i]);
+    metadata << "]}\n";
+    const auto text = metadata.str();
+    Output texels(argv[3]);
+    texels.Write(decoded.bytes);
+    texels.Finish();
+    Output description(argv[4]);
+    description.Write(
+        {reinterpret_cast<const std::byte *>(text.data()), text.size()});
+    description.Finish();
+    std::cout << "Decoded bounded texture " << decoded.width << 'x'
+              << decoded.height << ' ' << Name(decoded.format) << '\n';
+  } catch (const std::exception &error) {
+    std::cerr << error.what() << '\n';
+    return 1;
+  }
+}
diff --git a/native-runtime/textures/test.cpp b/native-runtime/textures/test.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/textures/test.cpp
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "codec.h"
+#include <algorithm>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+using namespace native_textures;
+static void Check(bool value) {
+  if (!value)
+    throw std::runtime_error("Texture fixture mismatch");
+}
+template <class F> static void Reject(F function) {
+  try {
+    function();
+  } catch (const std::runtime_error &) {
+    return;
+  }
+  throw std::runtime_error("Missing rejection");
+}
+// Independent coordinate-address oracle, not a roundtrip through production
+// Swizzle.
+static size_t Address(size_t xb, size_t y, size_t row, uint32_t bh) {
+  Check(bh <= 5);
+  const size_t height = size_t(8) << bh;
+  const size_t block = size_t(512) << bh;
+  return (y / height) * ((row + 63) / 64) * block +
+         (xb / 64) * block + ((y % height) / 8) * 512u +
+         ((xb % 64) / 32) * 256u + ((y % 8) / 2) * 64u +
+         ((xb % 32) / 16) * 32u + (y % 2) * 16u + xb % 16;
+}
+int main() {
+  try {
+    unsigned cases = 0;
+    for (auto width : {1u, 3u, 16u, 17u, 63u, 64u, 127u}) {
+      for (auto height : {1u, 7u, 8u, 9u, 31u}) {
+        for (uint32_t bh = 0; bh <= 5; ++bh) {
+          Layout layout{Format::Rgba8Srgb, width, height, bh, 0, true,
+                        {2, 3, 4, 5}};
+          std::vector<std::byte> tiled(
+              static_cast<size_t>(RequiredStorage(layout)), std::byte{0xa5});
+          std::vector<std::byte> expected(size_t(width) * height * 4);
+          for (uint32_t y = 0; y < height; ++y)
+            for (uint32_t x = 0; x < width * 4; ++x) {
+              auto value = std::byte((x * 13 + y * 29) & 255);
+              tiled.at(Address(x, y, width * 4, bh)) = value;
+              expected[size_t(y) * width * 4 + x] = value;
+            }
+          auto result = Decode(layout, tiled);
+          Check(result.format == Format::Rgba8Srgb && result.bytes == expected);
+          Reject([&] {
+            Linearize(layout, std::span(tiled).first(tiled.size() - 1));
+          });
+          ++cases;
+        }
+      }
+    }
+    for (auto format : {Format::Bc4Unorm, Format::Bc5Unorm}) {
+      const bool bc5 = format == Format::Bc5Unorm;
+      Layout layout{
+          format, 3, 2, 0, 0, true, {2, 2, 2, bc5 ? uint8_t(3) : uint8_t(7)}};
+      std::vector<std::byte> encoded(
+          static_cast<size_t>(RequiredStorage(layout)));
+      encoded[0] = std::byte{64};
+      if (bc5)
+        encoded[8] = std::byte{192};
+      auto result = Decode(layout, encoded);
+      Check(result.format == (bc5 ? Format::Rg8Unorm : Format::R8Unorm));
+      Check(result.bytes.size() == (bc5 ? 12u : 6u));
+      for (size_t i = 0; i < result.bytes.size(); i += bc5 ? 2u : 1u) {
+        Check(result.bytes[i] == std::byte{64});
+        if (bc5)
+          Check(result.bytes[i + 1] == std::byte{192});
+      }
+      Check(result.swizzle == layout.swizzle);
+      layout.width = 7;
+      layout.height = 5;
+      std::vector<std::byte> multi(
+          static_cast<size_t>(RequiredStorage(layout)));
+      const uint32_t block_bytes = bc5 ? 16 : 8;
+      for (uint32_t by = 0; by < 2; ++by)
+        for (uint32_t bx = 0; bx < 2; ++bx) {
+          multi.at(Address(bx * block_bytes, by, 2 * block_bytes, 0)) =
+              std::byte(20 + bx * 50 + by * 90);
+          if (bc5)
+            multi.at(Address(bx * block_bytes + 8, by, 2 * block_bytes, 0)) =
+                std::byte(230 - bx * 50 - by * 90);
+        }
+      result = Decode(layout, multi);
+      for (uint32_t y = 0; y < 5; ++y)
+        for (uint32_t x = 0; x < 7; ++x) {
+          const size_t pixel = (size_t(y) * 7 + x) * (bc5 ? 2u : 1u);
+          Check(result.bytes[pixel] ==
+                std::byte(20 + (x / 4) * 50 + (y / 4) * 90));
+          if (bc5)
+            Check(result.bytes[pixel + 1] ==
+                  std::byte(230 - (x / 4) * 50 - (y / 4) * 90));
+        }
+    }
+    std::array<uint32_t, 8> words{8u | (2u << 7) | (2u << 10) | (2u << 13) |
+                                      (2u << 16) | (2u << 19) | (3u << 22) |
+                                      (4u << 25) | (5u << 28),
+                                  0,
+                                  3u << 21,
+                                  4u << 3,
+                                  1279u | (1u << 22) | (1u << 23) | (7u << 29),
+                                  719u | (1u << 31),
+                                  0,
+                                  0};
+    std::array<std::byte, 32> descriptor{};
+    std::memcpy(descriptor.data(), words.data(), 32);
+    auto parsed = ParseDescriptor(descriptor);
+    Check(parsed.width == 1280 && parsed.height == 720 &&
+          parsed.format == Format::Rgba8Srgb);
+    Check(RequiredStorage(parsed) == 3932160);
+    Reject([&] { ParseDescriptor(std::span(descriptor).first(31)); });
+    words[7] = 16;
+    std::memcpy(descriptor.data(), words.data(), 32);
+    Reject([&] { ParseDescriptor(descriptor); });
+    words[7] = 0;
+    words[3] |= 1u << 27;
+    std::memcpy(descriptor.data(), words.data(), 32);
+    Reject([&] { ParseDescriptor(descriptor); });
+    words[3] &= ~(1u << 27);
+    words[4] &= ~(7u << 29);
+    std::memcpy(descriptor.data(), words.data(), 32);
+    Reject([&] { ParseDescriptor(descriptor); });
+    Layout linear{Format::A2b10g10r10Unorm, 3, 2, 0, 32, false, {2, 3, 4, 5}};
+    std::vector<std::byte> data(64, std::byte{0xa7});
+    Check(Decode(linear, data).bytes ==
+          std::vector<std::byte>(24, std::byte{0xa7}));
+    linear.pitch = 8;
+    Reject([&] { RequiredStorage(linear); });
+    linear.pitch = 32;
+    linear.width = 0;
+    Reject([&] { RequiredStorage(linear); });
+    linear.width = 8192;
+    linear.height = 8192;
+    linear.pitch = 32768;
+    Reject([&] { RequiredStorage(linear); });
+    std::cout << "{\"passed\":true,\"independent_tiled_cases\":" << cases
+              << ",\"bc_formats\":2,\"clipped_block_fixtures\":4,\"preserves_"
+                 "srgb_swizzle_packed_precision\":true}\n";
+  } catch (const std::exception &error) {
+    std::cerr << error.what() << '\n';
+    return 1;
+  }
+}
