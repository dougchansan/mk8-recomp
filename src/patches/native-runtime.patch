diff --git a/native-runtime/services/logging.cpp b/native-runtime/services/logging.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..99905eeeadf6814fd277f771929bd27032ea27f5
--- /dev/null
+++ b/native-runtime/services/logging.cpp
@@ -0,0 +1,175 @@
+// SPDX-FileCopyrightText: Copyright 2026 suyu Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Protocol source: src/core/hle/service/lm/lm.cpp (OpenLogger, ILogger,
+// LogPacketHeader and LogDataChunkKey). This implementation owns its sink.
+#include "logging.h"
+#include <cstdio>
+#include <fcntl.h>
+#include <stdexcept>
+#include <tuple>
+#ifdef _WIN32
+#include <io.h>
+#include <share.h>
+#include <sys/stat.h>
+#else
+#include <unistd.h>
+#endif
+
+namespace native_services {
+namespace {
+uint64_t Integer(std::span<const std::byte> bytes,size_t at,size_t width) {
+    uint64_t value=0;
+    for(size_t i=0;i<width;++i)value|=uint64_t(bytes[at+i])<<(i*8);
+    return value;
+}
+std::string Hex(std::span<const std::byte> bytes) {
+    constexpr char digits[]="0123456789abcdef";
+    std::string text;
+    text.reserve(bytes.size()*2);
+    for(auto b:bytes) { const unsigned c=unsigned(b);text+=digits[c>>4];text+=digits[c&15]; }
+    return text;
+}
+std::string Escape(std::string_view input) {
+    std::string result;
+    constexpr char hex[]="0123456789abcdef";
+    for(unsigned char c:input) {
+        if(c=='"' || c=='\\') { result+='\\';result+=char(c); }
+        else if(c<32 || c>=127) {result+="\\u00";result+=hex[c>>4];result+=hex[c&15];}
+        else result+=char(c);
+    }
+    return result;
+}
+class FileSink final:public LogSink {
+    std::FILE* file_{};
+    uint64_t bytes_{},records_{},max_bytes_,max_records_;
+public:
+    FileSink(const std::filesystem::path& path,uint64_t bytes,uint64_t records)
+        :max_bytes_(bytes),max_records_(records) {
+        if(!bytes || !records)throw std::invalid_argument("LM sink bounds must be nonzero");
+#ifdef _WIN32
+        int fd=-1;
+        if(_wsopen_s(&fd,path.c_str(),_O_WRONLY|_O_CREAT|_O_EXCL|_O_BINARY,
+                     _SH_DENYRW,_S_IREAD|_S_IWRITE)!=0)
+            throw std::runtime_error("LM sink exclusive creation failed");
+        file_=_fdopen(fd,"wb");
+        if(!file_)_close(fd);
+#else
+        const int fd=open(path.c_str(),O_WRONLY|O_CREAT|O_EXCL,0600);
+        if(fd<0)throw std::runtime_error("LM sink exclusive creation failed");
+        file_=fdopen(fd,"wb");
+        if(!file_)close(fd);
+#endif
+        if(!file_)throw std::runtime_error("LM sink stream creation failed");
+    }
+    ~FileSink() override { if(file_)std::fclose(file_); }
+    bool Deliver(const LogRecord& r) override {
+        const std::string line="{\"process_id\":"+std::to_string(r.process_id)+
+            ",\"claimed_process_id\":"+std::to_string(r.claimed_process_id)+
+            ",\"thread_id\":"+std::to_string(r.thread_id)+
+            ",\"destination\":"+std::to_string(r.destination)+
+            ",\"flags\":"+std::to_string(r.flags)+
+            ",\"severity\":"+std::to_string(r.severity)+
+            ",\"verbosity\":"+std::to_string(r.verbosity)+
+            ",\"packet_hex\":\""+Hex(r.packet)+"\",\"text\":\""+Escape(r.text)+"\"}\n";
+        if(records_>=max_records_ || line.size()>max_bytes_-bytes_)return false;
+        if(std::fwrite(line.data(),1,line.size(),file_)!=line.size() || std::fflush(file_))return false;
+        bytes_+=line.size();++records_;return true;
+    }
+};
+Reply Decline(Status status,std::string text) { return {status,0,{},std::move(text),{},nullptr}; }
+bool Leb(std::span<const std::byte> b,size_t& at,uint64_t& value) {
+    value=0;
+    for(unsigned i=0;i<10;++i) {
+        if(at==b.size())return false;
+        unsigned c=unsigned(b[at++]);
+        if(i==9 && (c&0xfe))return false;
+        value|=uint64_t(c&127)<<(7*i);
+        if(!(c&128))return true;
+    }
+    return false;
+}
+bool Decode(std::span<const std::byte> b,std::string& text) {
+    size_t at=0;
+    while(at<b.size()) {
+        uint64_t key=0,length=0;
+        if(!Leb(b,at,key) || !Leb(b,at,length) || length>b.size()-at)return false;
+        // Fixed-width chunks in the repository protocol.
+        if((key==3 && length!=4) || ((key==8 || key==9) && length!=8))return false;
+        if(key==2)for(size_t i=0;i<length;++i)text+=char(b[at+i]);
+        at+=size_t(length);
+    }
+    return true;
+}
+class Logger final:public Endpoint {
+    using Key=std::tuple<uint64_t,uint64_t,uint8_t,uint8_t>;
+    std::shared_ptr<LogSink> sink_;
+    std::map<Key,std::vector<std::byte>> fragments_;
+    uint32_t destination_=0xffff;
+public:
+    explicit Logger(std::shared_ptr<LogSink> sink):sink_(std::move(sink)){}
+    Reply Prepare(const Request& r) override {
+        if(r.command==1) {
+            if(r.payload.size()<4 || !r.read_buffers.empty())return Decline(Status::Malformed,"LM SetDestination needs a u32 and no buffers");
+            const auto value=uint32_t(Integer(r.payload,0,4));
+            return {Status::Ok,0,{},{},[this,value]{destination_=value;},nullptr};
+        }
+        if(r.command!=0)return Decline(Status::Unsupported,"ILogger command is not implemented: "+std::to_string(r.command));
+        if(r.read_buffers.size()!=1)return Decline(Status::Malformed,"LM Log requires exactly one readable packet buffer");
+        const auto buffer=r.read_buffers[0];
+        if(buffer.size<24 || buffer.size>(64u<<10) || buffer.address>UINT64_MAX-buffer.size)
+            return Decline(Status::Malformed,"LM packet size/address exceeds bounds");
+        LogRecord record;
+        record.packet.resize(size_t(buffer.size));
+        if(!r.memory.read || !r.memory.read(r.memory.user,buffer.address,record.packet))
+            return Decline(Status::MemoryFault,"LM packet buffer is unreadable");
+        record.process_id=r.process_id;
+        record.claimed_process_id=Integer(record.packet,0,8);
+        record.thread_id=Integer(record.packet,8,8);
+        record.flags=uint8_t(record.packet[16]);
+        record.severity=uint8_t(record.packet[18]);
+        record.verbosity=uint8_t(record.packet[19]);
+        record.destination=destination_;
+        const uint64_t payload_size=Integer(record.packet,20,4);
+        if(payload_size>buffer.size-24 || record.severity>4 || (record.flags&~7u))
+            return Decline(Status::Malformed,"LM packet header is invalid");
+        const Key key{record.claimed_process_id,record.thread_id,record.severity,record.verbosity};
+        std::vector<std::byte> assembled;
+        const auto previous=fragments_.find(key);
+        if(!(record.flags&1)) {
+            if(previous==fragments_.end())return Decline(Status::Malformed,"LM continuation has no head packet");
+            assembled=previous->second;
+        }
+        if(assembled.size()+payload_size>(1u<<20) ||
+           (previous==fragments_.end() && fragments_.size()>=64))
+            return Decline(Status::Unsupported,"LM fragment accumulation bound reached");
+        assembled.insert(assembled.end(),record.packet.begin()+24,record.packet.begin()+24+size_t(payload_size));
+        const bool tail=bool(record.flags&2);
+        if(tail && !Decode(assembled,record.text))return Decline(Status::Malformed,"LM chunk stream is truncated or invalid");
+        // All owned memory/state and the actual sink are touched only after the
+        // atomic TLS response write. Delivery failures throw before guest resume.
+        return {Status::Ok,0,{},{},[this,key,tail,assembled=std::move(assembled),record=std::move(record)]() mutable {
+            if(!sink_->Deliver(record))throw std::runtime_error("native LM sink delivery failed or reached its explicit bound");
+            if(tail)fragments_.erase(key);
+            else fragments_.insert_or_assign(key,std::move(assembled));
+        },nullptr};
+    }
+};
+class LoggingService final:public Endpoint {
+    std::shared_ptr<LogSink> sink_;
+public:
+    explicit LoggingService(std::shared_ptr<LogSink> sink):sink_(std::move(sink)){}
+    Reply Prepare(const Request& r) override {
+        if(r.command!=0)return Decline(Status::Unsupported,"LM command is not implemented: "+std::to_string(r.command));
+        if(!r.read_buffers.empty())return Decline(Status::Malformed,"LM OpenLogger has unexpected buffers");
+        Reply reply;reply.status=Status::Ok;reply.moved_endpoint=std::make_unique<Logger>(sink_);return reply;
+    }
+};
+} // namespace
+std::shared_ptr<LogSink> CreateFileLogSink(const std::filesystem::path& path,uint64_t bytes,uint64_t records) {
+    return std::make_shared<FileSink>(path,bytes,records);
+}
+std::unique_ptr<Endpoint> CreateLoggingService(std::shared_ptr<LogSink> sink) {
+    if(!sink)throw std::invalid_argument("native LM requires an actual owned sink");
+    return std::make_unique<LoggingService>(std::move(sink));
+}
+} // namespace native_services
