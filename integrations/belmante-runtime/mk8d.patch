+void AddOnContentContext::Retire(){Owner();live_=false;retired_=true;pending_.reset();validated_=0;}
+AddOnContentContext::Ticket AddOnContentContext::Prepare(unsigned index) {
+    Owner();if(!Live() || index>=facts_.size() || !Room(next_) || !Room(facts_[index].prepared))
+        throw std::runtime_error("native AOC reply preparation authority exhausted");
+    Ticket ticket{++next_,generation_,index};pending_=ticket;validated_=0;++facts_[index].prepared;return ticket;
+}
+bool AddOnContentContext::Validate(Ticket ticket) {
+    if(!Live() || !pending_ || pending_->ordinal!=ticket.ordinal || ticket.generation!=generation_ ||
+       ticket.index>=facts_.size() || pending_->index!=ticket.index || ticket.ordinal<=consumed_ ||
+       !Room(facts_[ticket.index].validated))return false;
+    validated_=ticket.ordinal;++facts_[ticket.index].validated;return true;
+}
+void AddOnContentContext::CommitAfterReplyWrite(Ticket ticket) {
+    Owner();
+    if(ticket.index>=facts_.size())throw std::runtime_error("native AOC invalid commit index");
+    auto& facts=facts_[ticket.index];
+    if(Room(facts.commit_callbacks))++facts.commit_callbacks;else uncertain_=true;
+    if(!Live() || !pending_ || pending_->ordinal!=ticket.ordinal || pending_->index!=ticket.index ||
+       ticket.generation!=generation_ || validated_!=ticket.ordinal || ticket.ordinal<=consumed_ || !Room(facts.committed)) {
+        uncertain_=true;live_=false;throw std::runtime_error("native AOC post-write authority uncertainty; guest must stop");
+    }
+    consumed_=ticket.ordinal;pending_.reset();validated_=0;++facts.committed;
+}
+class AddOnContentEndpoint final:public Endpoint {
+    std::shared_ptr<AddOnContentContext> context_;
+public:
+    explicit AddOnContentEndpoint(std::shared_ptr<AddOnContentContext> context):context_(std::move(context)){}
+    Reply Prepare(const Request& request) override {
+        if(request.process_id!=context_->process_)return Decline(Status::InvalidProcess,"AOC owned process mismatch");
+        if(!context_->Live())return Decline(Status::InvalidState,"AOC context retired or owner invalid");
+        unsigned index;
+        switch(request.command){case 2:index=0;break;case 5:index=1;break;case 8:index=2;break;case 10:index=3;break;
+        default:return Decline(Status::Unsupported,"AOC command has no mounted-native implementation: "+std::to_string(request.command));}
+        if(!request.read_buffers.empty() || !request.copied_process_handles.empty() || !request.incoming_domain_objects.empty())
+            return Decline(Status::Malformed,"AOC scalar/event commands accept no buffers or input capabilities");
+        const bool pid=request.command!=8;
+        // Pinned libnx cmifMakeRequest: normal PID methods have8 semantic
+        // bytes plus4 tail bytes; normal no-PID event8 has8 tail bytes. Domain
+        // CMIF sizes exclude these transport tails. Tail bytes are ignored.
+        const size_t expected=request.domain_payload?(pid?8u:0u):(pid?12u:8u);
+        if(request.send_pid!=pid || request.payload.size()!=expected)
+            return Decline(Status::Malformed,"AOC PID descriptor or exact semantic body mismatch");
+        // ClientProcessId's raw u64 slot is not process identity. Router supplied
+        // the authenticated owner; no ProgramID is inferred from either PID.
+        Reply reply;reply.status=Status::Ok;
+        if(request.command==2)Scalar(reply,CountMountedAddOns(context_->program_.ProgramId(),context_->catalog_,context_->disabled_),4);
+        else if(request.command==5){const auto base=AddOnBaseFallback(context_->program_.ProgramId(),AddOnControlState::NotMounted);
+            if(!base)return Decline(Status::InvalidState,"AOC control metadata authority absent");Scalar(reply,*base,8);}
+        else reply.copied_event=context_->event_;
+        const auto ticket=context_->Prepare(index);
+        reply.validate=[context=context_,ticket]{return context->Validate(ticket);};
+        reply.commit=[context=context_,ticket]{context->CommitAfterReplyWrite(ticket);};
+        return reply;
+    }
+};
+std::unique_ptr<Endpoint> CreateAddOnContentService(std::shared_ptr<AddOnContentContext> context) {
+    if(!context || !context->Live())throw std::invalid_argument("AOC requires actual live owned mounted context");
+    context->Owner();if(!Room(context->constructions_))throw std::runtime_error("AOC endpoint count exhausted");
+    auto endpoint=std::make_unique<AddOnContentEndpoint>(context);++context->constructions_;return endpoint;
+}
