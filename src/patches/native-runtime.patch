+for mode in ('on','chain'):
+ d=a.build.resolve()/mode
+ for cmd in [['cmake','-S',str(Path(__file__).resolve().parent),'-B',str(d),'-DPENDING_GENERATED_DIR='+a.generated.resolve().as_posix(),'-DFIXTURE_MODE='+mode],['cmake','--build',str(d),'--config','Release','--parallel','2']]:
+  subprocess.run(cmd,check=True,**flags)
