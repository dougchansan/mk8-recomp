new file mode 100644
--- /dev/null
+++ b/tests/native_rsqrt/README.md
@@ -0,0 +1,10 @@
+# Exact rsqrt lookup synthetic checks
+
+Run `python run.py --build G:/suyu/mk8-native-runtime/native-rsqrt-test` from a shell with CMake and a C/C++ compiler. The runner uses two build jobs and BelowNormal subprocess priority on Windows. Generated outputs stay in the supplied build directory.
+
+The generator obtains original and lookup code from the real emitter, renames only the public helper function, and compiles both against the emitted GuestContext header. It emits complete projects off/on/off in one process compares all disabled project files byte for byte, checks disabled runtime/header against the unchanged canonical RuntimeC/RuntimeH functions, and checks lookup text is present only in the enabled runtime.
+
+Correctness exhausts all 384 raw selectors and 256 table values against the original integer search. It compares result bits and complete sticky FPSR for both widths and both estimate operations over every normal exponent, every selector, both discarded-fraction endpoints, both signs, and all 16 rounding/FZ/DN modes. It adds subnormal bit boundaries, zero/infinities/NaN payloads, varying initial FPSR, and deterministic random patterns.
+
+The execution-only microbenchmark runs identical positive finite inputs, consumes matching checksums, and alternates order across six pairs. Each width (32/64) uses 32,768 repetitions per leg across six alternating pairs. It reports elapsed CRT clock seconds; clock semantics are platform dependent (MSVC uses elapsed wall time). Unrelated system load is uncontrolled. These results are descriptive and do not predict a gameplay improvement. Actual game acceptance, production assembly inspection, independent archived-header comparison, and existing ABI golden smoke remain separate gates.
+
diff --git a/tests/native_rsqrt/generate.cpp b/tests/native_rsqrt/generate.cpp
new file mode 100644
--- /dev/null
+++ b/tests/native_rsqrt/generate.cpp
@@ -0,0 +1,65 @@
+#include "core/recompiler/arm64_to_c.h"
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <map>
+#include <string>
+using namespace suyu::recomp;
+using Files = std::map<std::string, std::string>;
+static void write(const std::filesystem::path &p, const std::string &s) {
+  std::filesystem::create_directories(p.parent_path());
+  std::ofstream f(p, std::ios::binary);
+  f << s;
+  if (!f)
+    throw std::runtime_error("write failed");
+}
+static std::string renamed(std::string s, const std::string &name) {
+  const std::string from = "recomp_fp_estimate";
+  auto pos = s.find(from);
+  if (pos == std::string::npos)
+    throw std::runtime_error("missing estimate");
+  s.replace(pos, from.size(), name);
+  return "#include \"recomp_runtime.h\"\n" + s;
+}
+static Files read(const std::filesystem::path &root) {
+  Files result;
+  for (auto &p : std::filesystem::recursive_directory_iterator(root))
+    if (p.is_regular_file()) {
+      std::ifstream f(p.path(), std::ios::binary);
+      result[p.path().lexically_relative(root).generic_string()] = {
+          std::istreambuf_iterator<char>(f), {}};
+    }
+  return result;
+}
+static Files emit(const std::filesystem::path &path, bool lookup) {
+  g_emit_rsqrt_lookup = lookup;
+  const uint32_t code[] = {0x7ea1d820, 0xd4200000};
+  EmitProject("estimate", reinterpret_cast<const uint8_t *>(code), sizeof(code),
+              0x1000, path.string(), true);
+  return read(path);
+}
+int main(int argc, char **argv) {
+  if (argc != 2)
+    return 2;
+  const std::filesystem::path out = argv[1];
+  const std::string original = EstimateRuntimeC(false),
+                    lookup = EstimateRuntimeC(true);
+  if (original == lookup)
+    return 3;
+  write(out / "recomp_runtime.h", RuntimeH());
+  write(out / "original.c", renamed(original, "original_estimate"));
+  write(out / "lookup.c", renamed(lookup, "lookup_estimate") +
+                              "\nunsigned lookup_table(unsigned i){return "
+                              "recomp_rsqrt_estimates[i];}\n");
+  const auto off = emit(out / "off", false);
+  const auto on = emit(out / "on", true);
+  const auto off2 = emit(out / "off2", false);
+  if (off != off2 || off.at("recomp_runtime.c") != RuntimeC() ||
+      off.at("recomp_runtime.h") != RuntimeH() ||
+      on.at("recomp_runtime.c").find(lookup) == std::string::npos ||
+      on.at("recomp_runtime.c") == off.at("recomp_runtime.c"))
+    return 4;
+  std::cout << "complete EmitProject off/on/off and frozen RuntimeH/C baseline "
+               "passed\n";
+  return 0;
+}
