+    std::lock_guard lock(gpu_lock());
+    const auto command = frame_begin(false);
+    const auto source = upload_alloc(96, 16);
+    std::memset(source.ptr, 0xa5, 96);
+    vk::p_vkCmdFillBuffer(command, source.buffer, source.offset, 96, 0x11223344);
+    VkDescriptorBufferInfo descriptor{source.buffer, source.offset + 16, 32};
+    check(!debug_buffer_snapshot(VK_NULL_HANDLE, descriptor, 0xdfff0001));
+    check(!debug_buffer_snapshot(command, {VK_NULL_HANDLE, 0, 4}, 0xdfff0001));
+    check(!debug_buffer_snapshot(command, {source.buffer, source.offset + 2, 32}, 0xdfff0001));
+    check(!debug_buffer_snapshot(command, {source.buffer, source.offset, 0x10004}, 0xdfff0001));
+    check(debug_buffer_snapshot(command, descriptor, 0xdfff0001));
+    frame_submit(VK_NULL_HANDLE, VK_NULL_HANDLE, {}, true);
+    debug_snapshots_write();
+    FILE* file = plat::fopen_utf8(plat::data_root() + "/frames/00000_dfff0001.raw", "rb");
+    check(file != nullptr);
+    std::array<uint32_t, 11> words{};
+    check(std::fread(words.data(), sizeof(uint32_t), words.size(), file) == words.size());
+    check(std::fgetc(file) == EOF);
+    check(std::fclose(file) == 0);
+    check(words[0] == 8 && words[1] == 1 && words[2] == VK_FORMAT_R32_UINT);
+    for (unsigned index = 3; index < words.size(); ++index) check(words[index] == 0x11223344);
