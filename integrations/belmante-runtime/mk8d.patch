+    std::lock_guard lock(synchronization);
+    state->Arm(timeout, cancelled);
+  }
+  state_ = std::move(state);
+}
+NativeEventWait::~NativeEventWait() {
+  std::lock_guard lock(synchronization);
+  state_->Complete(EventWaitStatus::Cancelled, -1);
+  state_->Unlink();
+}
+EventWaitOutcome NativeEventWait::Poll() const noexcept {
+  std::lock_guard lock(synchronization);
+  state_->Expire();
+  return state_->outcome;
+}
+bool NativeEventWait::Cancellation::Cancel() const noexcept {
+  if (!state_)
+    return false;
+  std::lock_guard lock(synchronization);
+  state_->Expire();
+  return state_->Complete(EventWaitStatus::Cancelled, -1);
+}
