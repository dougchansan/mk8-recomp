+namespace nx {
+
+bool overlay_on();
+// Rasterizes `lines` (upper case, digits, . : / - % x and space) with a 5x7 font at `scale` into BGRA pixels on a
+// dark panel. Returns false when a character has no glyph (drawn as a box). Width and height are set.
+bool overlay_raster(const std::vector<std::string>& lines, uint32_t scale, std::vector<uint32_t>& pixels,
+                    uint32_t& width, uint32_t& height);
