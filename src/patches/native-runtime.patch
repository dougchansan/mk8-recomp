index 0000000000000000000000000000000000000000..0d6fb77592d0ef92ba377ae46e715b756a27917c
--- /dev/null
+++ b/native-runtime/shaders/README.md
@@ -0,0 +1,15 @@
+# Native Maxwell-to-SPIR-V bridge
+
+`Snapshot` owns a checked graphics shader environment. `TranslatePair` calls the existing shader-only flow CFG, Maxwell translation and SPIR-V emitter using native-owned pools; it creates no Maxwell3D, GPU command processor, Core::System or guest-memory objects. The standalone target links the frozen current-host shader_recompiler/common/fmt/Sirit/Boost libraries; no video_core library or public video_core header is used.
+
+Input format is explicitly pinned to little-endian 64-bit suyu `yuzucach` version18. This reader currently accepts only the first pipeline's exactly-two VertexB/Fragment environments. It bounds the file at64MiB, shader code at1MiB+8, metadata counts at65536, checks instruction ranges/alignment, enum values, duplicate metadata, and duplicate SPH agreement. It does not validate or iterate the remaining pipeline records/key suffix. Unknown format/stage, truncated/range-invalid inputs and missing required cbuf/texture metadata fail. Optional cbuf replacements return absent when the recorded map has no entry, matching the shader contract. Compute/tessellation/geometry/dual-vertex and image/texel-buffer resource plans are unsupported.
+
+Translation uses an explicit conservative SPIR-V1.0 profile, float generic attributes/fragment outputs, triangle topology and carried vertex varying/legacy-store state. These are declared assumptions, not decoded raster/vertex state from the cache key. Translation success does not prove complete graphics semantics, pipeline validity, descriptor contents or rendered equivalence. Resource/interface output describes the emitted modules under this profile.
+
+`native_shader_probe owned-vulkan.bin output-directory` reads an owned local capture and writes vertex.spv, fragment.spv and resource-plan.json only to the requested private output directory. Game shader/cache bytes are not embedded in source. The probe tests malformed/truncated/version/count/stage cases and missing metadata before translating the actual pair.
+
+`native_shader_module_check vertex.spv fragment.spv` uses the existing native graphics resource device and system loader to create/destroy both VkShaderModules. This is driver module acceptance, not SPIR-V formal validation, pipeline creation or a draw. It submits no command buffers. Run GPU-facing checks only under the root's replay coordination.
+
+First observed MK8 pair: vertex input location0 float4; vertex output Position and locations1/2 float4; fragment input locations1/2 float4, color output0 float4. Descriptor set0 has vertex cbuf3 at binding0, fragment cbuf3 at binding1, and two fragment combined2D image samplers at bindings2/3, sourced from cbuf2 offsets0x20/0x28. No push constants. The cache supplies compile-time handle/type words, not complete cbuf3 bytes, texels, sampler states, vertex data, viewport/scissor, blend/depth or render-target contents. A correct real native draw requires those runtime resources and state; a fabricated uniform/texture fixture would not establish MK8 rendering correctness.
+
+The parser follows the pinned serialized schema documented in src/video_core/shader_environment.cpp without including that implementation. Existing shader sources carry their GPL/SPDX notices; retain those licenses and frozen-library provenance. No LAS shader translator or shaderc dependency was imported.
diff --git a/native-runtime/shaders/module_check.cpp b/native-runtime/shaders/module_check.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fa6c3b9da09368814f91e95c03ac13d3d62bfa63
--- /dev/null
+++ b/native-runtime/shaders/module_check.cpp
@@ -0,0 +1,65 @@
+#include "vulkan_resources.h"
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#define VK_NO_PROTOTYPES
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+#include <vulkan/vulkan.h>
+#include <windows.h>
+struct OwnedLoader {
+  HMODULE value = LoadLibraryW(L"vulkan-1.dll");
+  ~OwnedLoader() {
+    if (value)
+      FreeLibrary(value);
+  }
+};
+int main(int argc, char **argv) {
+  try {
+    if (argc != 3)
+      throw std::runtime_error("Requires translated vertex/fragment paths");
+    native_graphics::VulkanDevice gpu;
+    auto handles = gpu.GetNativeHandles();
+    auto device = reinterpret_cast<VkDevice>(handles.device);
+    OwnedLoader owned;
+    auto loader = owned.value;
+    if (!loader)
+      throw std::runtime_error("Vulkan loader unavailable");
+    auto create = reinterpret_cast<PFN_vkCreateShaderModule>(
+        GetProcAddress(loader, "vkCreateShaderModule"));
+    auto destroy = reinterpret_cast<PFN_vkDestroyShaderModule>(
+        GetProcAddress(loader, "vkDestroyShaderModule"));
+    if (!create || !destroy) {
+      throw std::runtime_error("Vulkan module exports unavailable");
+    }
+    for (int i = 1; i < 3; ++i) {
+      std::ifstream f(argv[i], std::ios::binary | std::ios::ate);
+      auto bytes = f.tellg();
+      if (bytes < 20 || bytes > 16 * 1024 * 1024 || bytes % 4)
+        throw std::runtime_error("Invalid module length");
+      std::vector<uint32_t> code(size_t(bytes) / 4);
+      f.seekg(0);
+      if (!f.read(reinterpret_cast<char *>(code.data()), bytes) ||
+          code[0] != 0x07230203)
+        throw std::runtime_error("Invalid module data");
+      VkShaderModuleCreateInfo ci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+      ci.codeSize = size_t(bytes);
+      ci.pCode = code.data();
+      VkShaderModule module{};
+      auto status = create(device, &ci, nullptr, &module);
+      if (status != VK_SUCCESS) {
+        throw std::runtime_error("Driver rejected shader module: " +
+                                 std::to_string(status));
+      }
+      destroy(device, module, nullptr);
+    }
+    std::cout << "{\"module_creation_passed\":true,\"device\":\""
+              << gpu.DeviceName()
+              << "\",\"modules\":2,\"pipelines_created\":0,\"draws\":0}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
diff --git a/native-runtime/shaders/native_shaders.cpp b/native-runtime/shaders/native_shaders.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..37aab473b9460c4939812cb45bf7c9f495be3683
--- /dev/null
+++ b/native-runtime/shaders/native_shaders.cpp
@@ -0,0 +1,266 @@
+#include "native_shaders.h"
+#include "shader_recompiler/backend/spirv/emit_spirv.h"
+#include "shader_recompiler/frontend/maxwell/translate_program.h"
+#include "shader_recompiler/host_translate_info.h"
+#include <cstring>
+#include <limits>
+#include <sstream>
+#include <stdexcept>
+namespace native_shaders {
+namespace {
+struct Reader {
+  std::span<const std::byte> data;
+  size_t at = 0;
+  void Bytes(void *out, size_t size) {
+    if (size > data.size() - at)
+      throw std::runtime_error("Truncated snapshot cache");
+    std::memcpy(out, data.data() + at, size);
+    at += size;
+  }
+  template <class T> T Read() {
+    T result;
+    Bytes(&result, sizeof(result));
+    return result;
+  }
+  void Count(u64 count, size_t size) {
+    if (count > 65536 || count > (data.size() - at) / size)
+      throw std::runtime_error("Snapshot metadata count out of bounds");
+  }
+};
+template <class M> auto Required(M &map, typename M::key_type key) {
+  auto i = map.find(key);
+  if (i == map.end())
+    throw std::runtime_error("Missing required shader snapshot metadata");
+  return i->second;
+}
+u64 Key(u32 index, u32 offset) { return (u64(index) << 32) | offset; }
+} // namespace
+std::vector<Snapshot>
+Snapshot::ReadFirstPair(std::span<const std::byte> bytes) {
+  static_assert(sizeof(Shader::ProgramHeader) == 80);
+  if (bytes.size() > 64 * 1024 * 1024)
+    throw std::runtime_error("Snapshot cache exceeds 64MiB");
+  Reader r{bytes};
+  char magic[8];
+  r.Bytes(magic, 8);
+  if (std::memcmp(magic, "yuzucach", 8) || r.Read<u32>() != 18)
+    throw std::runtime_error(
+        "Unsupported shader cache magic/version (requires18)");
+  if (r.Read<u32>() != 2)
+    throw std::runtime_error(
+        "First pipeline must contain exactly vertexB+fragment environments");
+  std::vector<Snapshot> out;
+  for (unsigned i = 0; i < 2; ++i) {
+    Snapshot s;
+    const auto size = r.Read<u64>(), nt = r.Read<u64>(), nf = r.Read<u64>(),
+               nc = r.Read<u64>(), nr = r.Read<u64>();
+    s.local_size = r.Read<u32>();
+    s.texture_bound = r.Read<u32>();
+    s.start_address = r.Read<u32>();
+    s.lowest = r.Read<u32>();
+    s.highest = r.Read<u32>();
+    s.viewport = r.Read<u32>();
+    s.stage = r.Read<Shader::Stage>();
+    if (size < 80 || size > 0x100008 || size % 8 || s.highest < s.lowest ||
+        s.lowest != s.start_address || size != u64(s.highest) - s.lowest + 8 ||
+        s.start_address > UINT32_MAX - 80 ||
+        s.stage != (i == 0 ? Shader::Stage::VertexB : Shader::Stage::Fragment))
+      throw std::runtime_error("Invalid graphics shader snapshot range/stage");
+    s.code.resize(size / 8);
+    r.Bytes(s.code.data(), size);
+    r.Count(nt, 8);
+    for (u64 j = 0; j < nt; ++j) {
+      auto key = r.Read<u32>();
+      auto value = r.Read<u32>();
+      if (value >= Shader::NUM_TEXTURE_TYPES ||
+          !s.types.emplace(key, static_cast<Shader::TextureType>(value)).second)
+        throw std::runtime_error("Invalid/duplicate texture type");
+    }
+    r.Count(nf, 8);
+    for (u64 j = 0; j < nf; ++j) {
+      auto key = r.Read<u32>();
+      auto value = r.Read<u32>();
+      if (value >
+              static_cast<u32>(Shader::TexturePixelFormat::D32_FLOAT_S8_UINT) ||
+          !s.formats
+               .emplace(key, static_cast<Shader::TexturePixelFormat>(value))
+               .second)
+        throw std::runtime_error("Invalid/duplicate texture format");
+    }
+    r.Count(nc, 12);
+    for (u64 j = 0; j < nc; ++j) {
+      auto key = r.Read<u64>();
+      auto value = r.Read<u32>();
+      if (!s.cbufs.emplace(key, value).second)
+        throw std::runtime_error("Duplicate cbuf metadata");
+    }
+    r.Count(nr, 12);
+    for (u64 j = 0; j < nr; ++j) {
+      auto key = r.Read<u64>();
+      auto value = r.Read<u32>();
+      if (value > 2 ||
+          !s.replacements
+               .emplace(key, static_cast<Shader::ReplaceConstant>(value))
+               .second)
+        throw std::runtime_error("Invalid cbuf replacement");
+    }
+    r.Bytes(&s.sph, sizeof(s.sph));
+    if (std::memcmp(&s.sph, s.code.data(), sizeof(s.sph)))
+      throw std::runtime_error(
+          "Snapshot SPH metadata differs from code header");
+    s.is_proprietary_driver = s.texture_bound == 2;
+    out.push_back(std::move(s));
+  }
+  return out;
+}
+u64 Snapshot::ReadInstruction(u32 address) {
+  if (address < lowest || address > highest || (address - lowest) % 8)
+    throw std::runtime_error("Shader instruction read out of bounds/alignment");
+  return code[(address - lowest) / 8];
+}
+u32 Snapshot::ReadCbufValue(u32 index, u32 offset) {
+  return Required(cbufs, Key(index, offset));
+}
+Shader::TextureType Snapshot::ReadTextureType(u32 h) {
+  return Required(types, h);
+}
+Shader::TexturePixelFormat Snapshot::ReadTexturePixelFormat(u32 h) {
+  return Required(formats, h);
+}
+bool Snapshot::IsTexturePixelFormatInteger(u32 h) {
+  using F = Shader::TexturePixelFormat;
+  switch (ReadTexturePixelFormat(h)) {
+  case F::A8B8G8R8_SINT:
+  case F::A8B8G8R8_UINT:
+  case F::A2B10G10R10_UINT:
+  case F::R8_SINT:
+  case F::R8_UINT:
+  case F::R16G16B16A16_SINT:
+  case F::R16G16B16A16_UINT:
+  case F::R32G32B32A32_UINT:
+  case F::R32G32B32A32_SINT:
+  case F::R32G32_SINT:
+  case F::R16_UINT:
+  case F::R16_SINT:
+  case F::R16G16_UINT:
+  case F::R16G16_SINT:
+  case F::R8G8_SINT:
+  case F::R8G8_UINT:
+  case F::R32G32_UINT:
+  case F::R32_UINT:
+  case F::R32_SINT:
+    return true;
+  default:
+    return false;
+  }
+}
+std::array<u32, 3> Snapshot::WorkgroupSize() const {
+  throw std::runtime_error("Compute metadata unavailable in graphics snapshot");
+}
+std::optional<Shader::ReplaceConstant>
+Snapshot::GetReplaceConstBuffer(u32 bank, u32 offset) {
+  auto i = replacements.find(Key(bank, offset));
+  return i == replacements.end() ? std::nullopt : std::optional(i->second);
+}
+CompiledPair TranslatePair(std::vector<Snapshot> &snapshots) {
+  if (snapshots.size() != 2 ||
+      snapshots[0].ShaderStage() != Shader::Stage::VertexB ||
+      snapshots[1].ShaderStage() != Shader::Stage::Fragment)
+    throw std::runtime_error("Requires checked vertexB/fragment pair");
+  Shader::ObjectPool<Shader::IR::Inst> inst;
+  Shader::ObjectPool<Shader::IR::Block> blocks;
+  Shader::ObjectPool<Shader::Maxwell::Flow::Block> flow;
+  Shader::HostTranslateInfo host{};
+  host.ApplyDescriptorLimitPolicy();
+  Shader::Profile profile{};
+  profile.unified_descriptor_binding = true;
+  profile.need_fastmath_off = true;
+  Shader::Backend::Bindings bindings{};
+  CompiledPair out;
+  Shader::VaryingState previous;
+  previous.mask.set();
+  std::map<Shader::IR::Attribute, Shader::IR::Attribute> previous_legacy;
+  std::ostringstream plan;
+  plan << "{\"profile\":\"conservative SPIRV1.0; float attributes/outputs; "
+          "triangle topology\",\"stages\":[";
+  for (size_t i = 0; i < 2; ++i) {
+    auto &env = snapshots[i];
+    Shader::Maxwell::Flow::CFG cfg(env, flow, env.StartAddress() + 80, false);
+    auto program =
+        Shader::Maxwell::TranslateProgram(inst, blocks, env, cfg, host);
+    Shader::RuntimeInfo runtime{};
+    runtime.input_topology = Shader::InputTopology::Triangles;
+    runtime.generic_input_types.fill(Shader::AttributeType::Float);
+    runtime.color_output_types.fill(Shader::AttributeType::Float);
+    runtime.previous_stage_stores = previous;
+    runtime.previous_stage_legacy_stores_mapping = previous_legacy;
+    Shader::Maxwell::ConvertLegacyToGeneric(program, runtime);
+    auto binding_begin = bindings.unified;
+    auto code =
+        Shader::Backend::SPIRV::EmitSPIRV(profile, runtime, program, bindings);
+    if (code.size() < 5 || code[0] != 0x07230203)
+      throw std::runtime_error("Invalid SPIRV module header");
+
+    if (!program.info.texture_buffer_descriptors.empty() ||
+        !program.info.image_buffer_descriptors.empty() ||
+        !program.info.image_descriptors.empty())
+      throw std::runtime_error(
+          "Resource plan for texel/image buffers not implemented");
+    if (i)
+      plan << ',';
+    plan << "{\"stage\":\"" << (i ? "fragment" : "vertex")
+         << "\",\"code_bytes\":" << env.CodeBytes()
+         << ",\"cbuf_metadata_words\":" << env.CbufWords()
+         << ",\"texture_metadata\":" << env.TextureMetadata()
+         << ",\"spirv_words\":" << code.size()
+         << ",\"binding_begin\":" << binding_begin << ",\"bindings\":[";
+    bool comma = false;
+    u32 planned_binding = binding_begin;
+    for (const auto &cb : program.info.constant_buffer_descriptors) {
+      if (comma)
+        plan << ',';
+      comma = true;
+      plan << "{\"kind\":\"uniform_buffer\",\"binding\":" << planned_binding++
+           << ",\"guest_cbuf\":" << cb.index << ",\"count\":" << cb.count
+           << '}';
+    }
+    for (const auto &sb : program.info.storage_buffers_descriptors) {
+      if (comma)
+        plan << ',';
+      comma = true;
+      plan << "{\"kind\":\"storage_buffer\",\"binding\":" << planned_binding++
+           << ",\"guest_cbuf\":" << sb.cbuf_index
+           << ",\"guest_offset\":" << sb.cbuf_offset
+           << ",\"count\":" << sb.count << '}';
+    }
+    for (const auto &t : program.info.texture_descriptors) {
+      if (comma)
+        plan << ',';
+      comma = true;
+      plan << "{\"kind\":\"combined_image_sampler\",\"binding\":"
+           << planned_binding++ << ",\"guest_cbuf\":" << t.cbuf_index
+           << ",\"guest_offset\":" << t.cbuf_offset << ",\"count\":" << t.count
+           << ",\"texture_type\":" << static_cast<u32>(t.type)
+           << ",\"is_depth\":" << (t.is_depth ? "true" : "false") << '}';
+    }
+    if (planned_binding != bindings.unified)
+      throw std::runtime_error("Resource plan binding count mismatch");
+    plan << "],\"input_attribute_mask\":\""
+         << program.info.loads.mask.to_string()
+         << "\",\"output_attribute_mask\":\""
+         << program.info.stores.mask.to_string() << "\"}";
+    previous = program.info.stores;
+    previous_legacy = program.info.legacy_stores_mapping;
+    if (i)
+      out.fragment = std::move(code);
+    else
+      out.vertex = std::move(code);
+  }
+  plan << "],\"unified_binding_end\":" << bindings.unified
+       << ",\"execution_validated\":false}";
+  out.resource_plan = plan.str();
+  return out;
+}
+} // namespace native_shaders
+
+
diff --git a/native-runtime/shaders/native_shaders.h b/native-runtime/shaders/native_shaders.h
