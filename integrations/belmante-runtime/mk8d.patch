+uint32_t ParentalCapabilityResult(uint32_t caps,uint32_t command) {
+    uint32_t required=0;
+    switch(command){
+    case 1:required=uint32_t(ParentalCapability::Application)|uint32_t(ParentalCapability::System);break;
+    case 1031:required=uint32_t(ParentalCapability::Status)|uint32_t(ParentalCapability::Recovery);break;
+    case 1062:required=uint32_t(ParentalCapability::StereoVision);break;
+    // Primary1065's no-PIN helper and1432 have no capability check.
+    case 1065:case 1432:return 0;
+    default:throw std::invalid_argument("PCTL undeclared capability operation");
+    }
+    return (caps&required)?0:ParentalNoCapability;
