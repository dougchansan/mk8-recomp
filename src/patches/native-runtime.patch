+    if (size.width == UINT32_MAX) {
+      size.width = std::clamp(client[0], caps.minImageExtent.width,
+                              caps.maxImageExtent.width);
+      size.height = std::clamp(client[1], caps.minImageExtent.height,
+                               caps.maxImageExtent.height);
