@@ -0,0 +1,31 @@
+"""Run in a compiler-enabled shell; only bounded synthetic fixtures are emitted."""
+import argparse
+from pathlib import Path
+import subprocess
+
+p = argparse.ArgumentParser()
+p.add_argument('--build', type=Path, required=True)
+args = p.parse_args()
+here = Path(__file__).resolve().parent
+source = here.parents[1]
+build = args.build.resolve()
+def run(command):
+    print(' '.join(map(str, command)), flush=True)
+    subprocess.run(list(map(str, command)), check=True)
+def exe(directory, name):
+    return next(p for p in (directory/'Release'/(name+'.exe'), directory/(name+'.exe'), directory/name) if p.exists())
+run(['cmake','-S',here,'-B',build/'generator','-DSUYU_SOURCE='+str(source)])
+run(['cmake','--build',build/'generator','--config','Release','--parallel','2'])
+run([exe(build/'generator','entry_gen'),build/'generated'])
+run(['cmake','-S',here,'-B',build/'test','-DSUYU_SOURCE='+str(source),'-DGENERATED_DIR='+str(build/'generated')])
+run(['cmake','--build',build/'test','--config','Release','--parallel','2'])
+run([exe(build/'test','entry_test')])
+for word in (4,5):
+    result = subprocess.run([str(exe(build/'test','entry_test')),str(word)])
+    if result.returncode != 86:
+        raise RuntimeError(f'word {word} mutation expected 86, got {result.returncode}')
+for change in ('code-write','remap','unmap','protect','table-swap'):
+    result = subprocess.run([str(exe(build/'test','entry_test')),'4',change])
+    if result.returncode != 86:
+        raise RuntimeError(f'GG invalidation {change}: expected 86, got {result.returncode}')
+print('all skipped words reject before callback/guest effects', flush=True)
diff --git a/tests/native_entry/test.c b/tests/native_entry/test.c
new file mode 100644
index 0000000000000000000000000000000000000000..7168dc74199b8de1c42f43de8b2ff811f5d1fd4a
--- /dev/null
+++ b/tests/native_entry/test.c
@@ -0,0 +1,132 @@
+#include "recomp_runtime.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <signal.h>
+extern void original_query(GuestContext*);
+extern int original_guard_host;
+extern void recomp_image_set_base(uint64_t);
+extern unsigned recomp_image_guard_v2(unsigned);
+extern void recomp_image_run_slice(GuestContext*);
+extern BlockFn recomp_image_lookup(uint64_t);
+extern void recomp_image_run_slice_entrycaller(GuestContext*);
+extern void recomp_image_set_base_entrycaller(uint64_t);
+extern unsigned recomp_image_guard_v2_entrycaller(unsigned);
+extern uint32_t* recomp_image_guard_gen_v1(uint32_t,uint64_t*,uint64_t*,const uint64_t**);
+static const uint32_t code[]={0x14000004,0xd4200000,0xd4200000,0xd4200000,
+                             0xf9401000,0xd65f03c0,0xd4200000,0xd4200000,0xd61f0280};
+static unsigned char memory[128];
+static unsigned calls, loads, guard_reads;
+static int decline, mutation=-1;
+static int code_available=1;
+typedef struct {uintptr_t ptr;uint64_t block,address,watch;} Page;
+static Page table[16], replacement_table[16];
+static GuestContext* guarded;
+static GuestContext before;
+static void check(int yes,const char* why){if(!yes){fprintf(stderr,"FAIL %s\n",why);exit(1);}}
+static uint64_t load(void* user,uint64_t address,uint32_t bytes){
+  uint64_t value=0;(void)user;
+  if(!bytes){
+    ++guard_reads;
+    if(address==0x3000)return UINT64_C(0x1d61f0280);
+    if(address<0x1000 || address>=0x1000+sizeof(code))return 0;
+    if(!code_available)return 0;
+    memcpy(&value,(const unsigned char*)code+address-0x1000,4);
+    if((int)((address-0x1000)/4)==mutation)value^=0x20;
+    return value|UINT64_C(0x100000000);
+  }
+  ++loads;
+  if(address<0x2000 || address-0x2000>sizeof(memory)-bytes){guarded->halted=9;return 0;}
+  memcpy(&value,memory+address-0x2000,bytes);return value;
+}
+static int invoke(void* user,GuestContext* c,uint32_t operation,uint64_t entry){
+  check(user==memory && operation==7 && entry==0x1010,"callback identity");
+  ++calls;
+  if(decline)return 0;
+  c->x[0]=recomp_load64(c,c->x[0]+32);
+  c->pc=c->x[30];return 1;
+}
+static void rejected(int sig){(void)sig;
+  /* Existing strict guard reports the offending word in PC before abort. */
+  before.pc=0x1000+(uint64_t)mutation*4;
+  _Exit(guarded && !calls && !loads && !memcmp(guarded,&before,sizeof(before))?86:87);}
+static RecompHostMem host;
+static GuestContext fresh(uint64_t pc){
+  GuestContext c;unsigned i;memset(&c,0,sizeof(c));
+  for(i=0;i<32;++i){c.x[i]=0x12340000u+i;c.vreg[i][0]=i+19;c.vreg[i][1]=i+81;}
+  c.pc=pc;c.x[0]=0x2000;c.x[20]=0x1010;c.x[30]=0x5000;
+  c.n=1;c.z=1;c.v=1;c.fpcr=0x300;c.fpsr=0x80;
+  c.pending_svc=~UINT64_C(0);c.chain_budget=8;c.host_mem=&host;return c;
+}
+int main(int argc,char**argv){
+  RecompNativeEntryBinding binding={RECOMP_NATIVE_ENTRY_V1,sizeof(binding),
+      RECOMP_NATIVE_ENTRY_CAP_BOUNDED_RETURN,memory,invoke};
+  GuestContext a,b;unsigned mode;unsigned char original_memory[sizeof(memory)];
+  host.load=load;host.address_space_max=0x10000;
+  host.page_entries=table;host.page_entry_stride=sizeof(Page);host.page_bits=12;
+  host.pointer_mask=~UINT64_C(3);
+  memcpy(memory+32,"native!!",8);
+  memcpy(original_memory,memory,sizeof(memory));
+  original_guard_host=2;recomp_image_guard_v2(2);recomp_image_set_base(0);
+  recomp_image_guard_v2_entrycaller(2);recomp_image_set_base_entrycaller(0);
+  if(argc>1){
+    mutation=atoi(argv[1]);signal(SIGABRT,rejected);
+    check(recomp_native_entry_bind(&binding),"bind");
+    if(argc>2){
+      uint64_t lo,hi;const uint64_t* base;
+      uint32_t* generation=recomp_image_guard_gen_v1(2,&lo,&hi,&base);
+      check(generation!=NULL,"GG capability");
+      mutation=-1;*generation=1;
+      a=fresh(0x1010);guarded=&a;recomp_image_lookup(a.pc)(&a);
+      check(calls==1,"first native hit before invalidation");
+      guard_reads=0;a=fresh(0x1010);guarded=&a;recomp_image_lookup(a.pc)(&a);
+      check(calls==2 && guard_reads==0,"native hit under cached generation");
+      mutation=atoi(argv[1]);
+      if(!strcmp(argv[2],"unmap") || !strcmp(argv[2],"protect"))code_available=0;
+      if(!strcmp(argv[2],"table-swap")){
+        host.page_entries=replacement_table;code_available=0;
+      }
+      /* The host must publish generation changes for code/mapping changes. */
+      *generation=2;calls=loads=0;
+    }
+    a=fresh(0x1010);guarded=&a;before=a;recomp_image_lookup(a.pc)(&a);return 88;
+  }
+  for(mode=0;mode<6;++mode){
+    RecompNativeEntryBinding invalid=binding;
+    a=fresh(0x1010);b=a;guarded=&a;calls=loads=0;decline=mode==1;
+    if(mode==0 || mode==1)check(recomp_native_entry_bind(&binding),"valid bind");
+    if(mode==2)check(recomp_native_entry_bind(NULL),"unbind");
+    if(mode==3){invalid.revision++;check(!recomp_native_entry_bind(&invalid),"revision");}
+    if(mode==4){invalid.size--;check(!recomp_native_entry_bind(&invalid),"size");}
+    if(mode==5){invalid.capabilities=0;check(!recomp_native_entry_bind(&invalid),"capability");}
+    recomp_image_lookup(a.pc)(&a);guarded=&b;original_query(&b);
+    check(!memcmp(&a,&b,sizeof(a)),"complete context differential");
+    check(!memcmp(memory,original_memory,sizeof(memory)),"query memory unchanged");
+    check(calls==(mode<2?1u:0u) && loads==2,"native/fallback once");
+  }
+  decline=0;check(recomp_native_entry_bind(&binding),"rebind");
+  a=fresh(0x1014);b=a;guarded=&a;calls=loads=0;
+  recomp_image_lookup(a.pc)(&a);original_query(&b);
+  check(!calls && !loads && !memcmp(&a,&b,sizeof(a)),"interior bypass");
+  for(mode=0;mode<3;++mode){
+    a=fresh(mode==0?0x1000:mode==1?0x1020:0x1010);guarded=&a;calls=loads=0;
+    if(mode<2)recomp_image_run_slice(&a);else recomp_image_lookup(a.pc)(&a);
+    check(calls==1 && loads==1 && a.pc==0x5000,"local/indirect/host route once");
+    check(a.chain_budget==(mode<2?7:8),"existing budget preserved");
+  }
+  a=fresh(0x3000);guarded=&a;calls=loads=0;
+  recomp_image_run_slice_entrycaller(&a);
+  check(a.pc==0x1010 && !calls && a.chain_budget==8,"module A guest pointer transfer");
+  /* Host dispatches the unchanged guest address to module B, sharing runtime. */
+  recomp_image_run_slice(&a);
+  check(calls==1 && loads==1 && a.pc==0x5000 && a.chain_budget==8,
+        "cross-module shared-runtime native dispatch once");
+  a=fresh(0x1010);a.halted=1;before=a;calls=loads=0;guarded=&a;
+  recomp_image_lookup(a.pc)(&a);check(!calls && !memcmp(&a,&before,sizeof(a)),"halted");
+  a=fresh(0x1010);a.pending_svc=1;before=a;recomp_image_run_slice(&a);
+  check(!calls && !memcmp(&a,&before,sizeof(a)),"pending SVC");
+  a=fresh(0x1010);a.x[0]=0x9000;b=a;guarded=&a;
+  recomp_image_lookup(a.pc)(&a);guarded=&b;original_query(&b);
+  check(!memcmp(&a,&b,sizeof(a)) && a.halted==9,"memory fault differential");
+  puts("native entry context/memory/binding/interior/local/indirect/host/budget checks passed");return 0;
+}
