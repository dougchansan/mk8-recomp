diff --git a/native-runtime/wait.cpp b/native-runtime/wait.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/wait.cpp
@@ -0,0 +1,99 @@
+#include "host.h"
+#include <array>
+#include <bit>
+#include <cstring>
+namespace native {
+namespace {
+constexpr uint32_t Error(unsigned description) {
+  return 1u | (description << 9);
+}
+void WaitResult(GuestContext &c, EventWaitOutcome outcome) {
+  c.x[0] = outcome.status == EventWaitStatus::Signaled   ? 0
+           : outcome.status == EventWaitStatus::TimedOut ? Error(117)
+                                                         : Error(118);
+  c.x[1] = uint32_t(outcome.index);
+}
+} // namespace
+bool Host::begin_wait() {
+  if (context_owner_ != std::this_thread::get_id() || event_wait_)
+    throw std::runtime_error("native wait owner/state mismatch");
+  const auto count = std::bit_cast<int32_t>(uint32_t(context.x[2]));
+  auto failure = [&](unsigned code) {
+    context.x[0] = Error(code);
+    context.x[1] = 0;
+    return false;
+  };
+  if (count < 0 || count > 64)
+    return failure(119);
+  const auto thread = find_thread(current_thread_handle);
+  if (!thread || thread->context != &context)
+    throw std::runtime_error("native wait thread ownership unavailable");
+  const auto address = context.x[1];
+  if (count && address > UINT64_MAX - uint64_t(count) * 4)
+    return failure(115);
+  try {
+    for (unsigned offset = 0; offset < unsigned(count) * 4; offset += 8)
+      check(address + offset, std::min(8u, unsigned(count) * 4 - offset), 1);
+  } catch (const std::exception &) {
+    return failure(115);
+  }
+  std::array<EventRef, 64> objects;
+  for (int32_t i = 0; i < count; ++i) {
+    auto handle = uint32_t(read(address + uint64_t(i) * 4, 4));
+    if (handle >= CurrentThreadHandle)
+      return failure(114); // GetMultipleObjects has no pseudo handles.
+    if (find_thread(handle) ||
+        (handle >= SessionHandleBegin && handle < SessionHandleEnd))
+      throw std::runtime_error(
+          "native synchronization wait object class unsupported");
+    objects[size_t(i)] = event_registry.GetReadable(handle);
+    if (!objects[size_t(i)])
+      return failure(114);
+  }
+  auto record = std::make_unique<EventWaitFrame>();
+  memcpy(&record->context, &context, sizeof(context));
+  record->thread_id = thread->id;
+  record->wait = std::make_unique<NativeEventWait>(
+      std::span<const EventRef>(objects.data(), size_t(count)),
+      std::bit_cast<int64_t>(context.x[3]), event_clock);
+  const auto outcome = record->wait->Poll();
+  clear_reservation();
+  if (outcome.status != EventWaitStatus::Pending) {
+    WaitResult(context, outcome);
+    return false;
+  }
+  event_wait_ = std::move(record);
+  ++event_wait_parks;
+  return true;
+}
+NativeEventWait::Cancellation Host::wait_cancellation() const {
+  if (context_owner_ != std::this_thread::get_id())
+    throw std::runtime_error("native wait owner mismatch");
+  return event_wait_ ? event_wait_->wait->CancellationHandle()
+                     : NativeEventWait::Cancellation{};
+}
+bool Host::poll_wait() {
+  if (context_owner_ != std::this_thread::get_id() || guest_active_)
+    throw std::runtime_error("native wait owner mismatch");
+  if (!event_wait_)
+    return true;
+  const auto thread = find_thread(current_thread_handle);
+  if (!thread || thread->context != &context ||
+      thread->id != event_wait_->thread_id || !code_binding_valid() ||
+      memcmp(&context, &event_wait_->context, sizeof(context)) != 0) {
+    event_wait_.reset();
+    event_wait_failed_ = true;
+    throw std::runtime_error("parked native wait owner/context changed");
+  }
+  auto outcome = event_wait_->wait->Poll();
+  if (outcome.status == EventWaitStatus::Pending)
+    return false;
+  WaitResult(context, outcome);
+  if (svc_observer)
+    svc_observer(context, true);
+  context.pending_svc = ~UINT64_C(0);
+  event_wait_.reset();
+  ++event_wait_completions;
+  return true;
+}
+} // namespace native
