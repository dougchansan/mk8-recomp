+    if (swapchain)
+      P(vkDestroySwapchainKHR)(device, swapchain, nullptr);
+    swapchain = VK_NULL_HANDLE;
+  }
+  void Recreate() {
+    Owner();
+    Need(!closed && !terminal, "Presenter closed/terminal");
+    RetireImages(false);
+    auto client = window->client_extent();
+    if (!client[0] || !client[1]) {
+      extent = {0, 0};
+      return;
+    }
+    VkSurfaceCapabilitiesKHR caps{};
+    Check(
+        P(vkGetPhysicalDeviceSurfaceCapabilitiesKHR)(physical, surface, &caps),
+        "Surface capabilities");
+    Need((caps.supportedUsageFlags & VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) &&
+             (caps.supportedCompositeAlpha &
+              VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR) &&
+             caps.currentTransform == VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR,
+         "Unsupported surface usage/alpha/transform");
