+      Reject([&] { f.SubmitAndWait(); });
+    }
+    {
+      FrameEncoder f(images);
+      auto sampledDraw = draw;
+      sampledDraw.uniforms = {};
+      SampleBinding binding{0, av, sampler};
+      Reject([&] {
+        f.Draw(consumer, sampledDraw, {av, AttachmentLoad::Clear},
