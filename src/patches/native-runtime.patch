+    if (r == VK_ERROR_DEVICE_LOST) {
+      device_lost = terminal = true;
+      return;
+    }
+    Check(r, "Release acquired image");
+  }
+  void RetireFlight(bool forever) {
+    const auto deadline =
+        std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    while (acquired_index) {
+      if (device_lost) {
+        flight.Retired();
+        acquired_index.reset();
+        return;
+      }
+      try {
