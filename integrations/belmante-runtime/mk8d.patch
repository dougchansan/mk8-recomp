+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace nx {
+struct CPU;
+namespace frame_context {
+enum class Stop { Complete, ZeroLr, UnboundStack, Alignment, OutsideStack, Unreadable, NonIncreasing, Limit };
+struct Stack {
+    std::array<uint64_t, 17> pcs{};
+    size_t count{};
+    Stop stop = Stop::Complete;
+};
+
+// The caller owns the active stack [sp, initial_sp). The reader must validate
+// and copy the complete two-word frame record before returning success.
+template<class Reader>
+Stack capture(uint64_t lr, uint64_t fp, uint64_t sp, uint64_t initial_sp, Reader&& read) {
+    Stack result;
+    if (!lr) { result.stop = Stop::ZeroLr; return result; }
+    result.pcs[result.count++] = lr;
+    if (!sp || initial_sp < sp || initial_sp < 16) {
+        result.stop = Stop::UnboundStack;
+        return result;
+    }
+    for (size_t n = 0; fp && n < 16; ++n) {
+        if (fp & 7) { result.stop = Stop::Alignment; return result; }
+        if (fp < sp || fp > initial_sp - 16) { result.stop = Stop::OutsideStack; return result; }
+        std::array<uint64_t, 2> record{};
+        if (!read(fp, record)) { result.stop = Stop::Unreadable; return result; }
+        // A native-started guest thread has no guest caller. Its outer frame
+        // can contain {previous_fp=0, lr=0}; an interior zero LR is incomplete.
+        if (!record[1]) {
+            result.stop = record[0] ? Stop::ZeroLr : Stop::Complete;
+            return result;
+        }
+        result.pcs[result.count++] = record[1];
+        if (!record[0]) return result;
+        if (record[0] <= fp) { result.stop = Stop::NonIncreasing; return result; }
+        fp = record[0];
+    }
+    if (fp) result.stop = Stop::Limit;
+    return result;
+}
+
+struct WaitToken {
+    uint64_t id{}, frame{}, started{}, mutex{}, key{};
+    uint32_t svc = 0x1c, owner = 0, tag = 0;
+    bool operator==(const WaitToken&) const = default;
+};
+bool enabled();
+void bind(CPU& cpu);
+void present(CPU& cpu);
+WaitToken wait_begin(CPU& cpu, uint64_t mutex, uint64_t key,
+                     uint32_t svc = 0x1c, uint32_t owner = 0, uint32_t tag = 0);
+void wait_end(CPU& cpu, const WaitToken& token, uint32_t result, int blocking_path = -1);
+}  // namespace frame_context
+}  // namespace nx
