--- /dev/null
+++ b/native-runtime/nvn/state_test.cpp
@@ -0,0 +1,789 @@
+#include "frame.h"
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <iostream>
+#include <limits>
+#include <sirit/sirit.h>
+#include <stdexcept>
+using namespace native_nvn;
+namespace {
+void Check(bool v, const char *w) {
+  if (!v)
+    throw std::runtime_error(w);
+}
+unsigned rejected = 0, draws = 0;
+uint64_t pixels = 0;
+template <class F> void Reject(F action) {
+  try {
+    action();
+  } catch (const std::runtime_error &) {
+    ++rejected;
+    return;
+  }
+  throw std::runtime_error("Expected typed-state rejection");
+}
+std::vector<uint32_t> Shader(bool vertex, bool sampled = false,
+                             uint32_t location = 0, bool integer = false) {
+  Sirit::Module m(0x00010000);
+  m.AddCapability(spv::Capability::Shader);
+  m.SetMemoryModel(spv::AddressingModel::Logical, spv::MemoryModel::GLSL450);
+  auto f = m.TypeFloat(32), v = m.TypeVector(f, 4);
+  auto out = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Output, v),
+                                 spv::StorageClass::Output);
+  Sirit::Id input{}, ubo{}, pointer{}, texture{}, sampletype{};
+  if (vertex) {
+    m.Decorate(out, spv::Decoration::BuiltIn, spv::BuiltIn::Position);
+    auto t = integer ? m.TypeVector(m.TypeInt(32, false), 4) : v;
+    input = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Input, t),
+                                spv::StorageClass::Input);
+    m.Decorate(input, spv::Decoration::Location, location);
+  } else {
+    m.Decorate(out, spv::Decoration::Location, 0u);
+    auto block = m.TypeStruct(v);
+    m.Decorate(block, spv::Decoration::Block);
+    m.MemberDecorate(block, 0u, spv::Decoration::Offset, 0u);
+    ubo = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Uniform, block),
+                              spv::StorageClass::Uniform);
+    pointer = m.TypePointer(spv::StorageClass::Uniform, v);
+    m.Decorate(ubo, spv::Decoration::DescriptorSet, 0u);
+    m.Decorate(ubo, spv::Decoration::Binding, 0u);
+    if (sampled) {
+      auto image = m.TypeImage(f, spv::Dim::Dim2D, 0, false, false, 1,
+                               spv::ImageFormat::Unknown);
+      sampletype = m.TypeSampledImage(image);
+      texture = m.AddGlobalVariable(
+          m.TypePointer(spv::StorageClass::UniformConstant, sampletype),
+          spv::StorageClass::UniformConstant);
+      m.Decorate(texture, spv::Decoration::DescriptorSet, 0u);
+      m.Decorate(texture, spv::Decoration::Binding, 1u);
+    }
+  }
+  auto zero = m.Constant(m.TypeInt(32, false), 0u);
+  auto origin = m.ConstantComposite(v, m.Constant(f, 0.f), m.Constant(f, 0.f),
+                                    m.Constant(f, 0.f), m.Constant(f, 1.f));
+  auto fn = m.OpFunction(m.TypeVoid(), spv::FunctionControlMask::MaskNone,
+                         m.TypeFunction(m.TypeVoid()));
+  m.AddLabel();
+  if (vertex)
+    m.OpStore(out, integer ? origin : m.OpLoad(v, input));
+  else {
+    auto control = m.OpLoad(v, m.OpAccessChain(pointer, ubo, zero));
+    if (sampled) {
+      auto uv = m.OpCompositeConstruct(m.TypeVector(f, 2),
+                                       m.OpCompositeExtract(f, control, 0u),
+                                       m.OpCompositeExtract(f, control, 1u));
+      m.OpStore(out, m.OpImageSampleImplicitLod(
+                         v, m.OpLoad(sampletype, texture), uv));
+    } else
+      m.OpStore(out, control);
+  }
+  m.OpReturn();
+  m.OpFunctionEnd();
+  if (vertex)
+    m.AddEntryPoint(spv::ExecutionModel::Vertex, fn, "main", input, out);
+  else {
+    m.AddEntryPoint(spv::ExecutionModel::Fragment, fn, "main", out);
+    m.AddExecutionMode(fn, spv::ExecutionMode::OriginUpperLeft);
+  }
+  return m.Assemble();
+}
+struct Memory {
+  std::array<std::byte, 4096> bytes{};
+  static bool Read(void *p, uint64_t a, std::span<std::byte> b) {
+    auto &m = *static_cast<Memory *>(p);
+    if (a < 0x10000 || a - 0x10000 > m.bytes.size() ||
+        b.size() > m.bytes.size() - (a - 0x10000))
+      return false;
+    std::copy_n(m.bytes.begin() + a - 0x10000, b.size(), b.begin());
+    return true;
+  }
+  static bool Write(void *, uint64_t, std::span<const std::byte>) {
+    return false;
+  }
+};
+int Q(double v) { return int(std::lround(std::clamp(v, 0., 1.) * 255)); }
+std::array<double, 4> Quantized(std::array<float, 4> c) {
+  return {Q(c[0]) / 255., Q(c[1]) / 255., Q(c[2]) / 255., Q(c[3]) / 255.};
+}
+void Constant(const DrawResult &r, std::array<double, 4> expected,
+              int tolerance = 1) {
+  for (size_t i = 0; i < r.rgba8.size(); ++i) {
+    if (std::abs(int(r.rgba8[i]) - Q(expected[i % 4])) > tolerance)
+      throw std::runtime_error("Independent pixel oracle mismatch channel" +
+                               std::to_string(i % 4) + " actual" +
+                               std::to_string(int(r.rgba8[i])) + " expected" +
+                               std::to_string(Q(expected[i % 4])));
+  }
+  pixels += uint64_t(r.width) * r.height;
+}
+} // namespace
+namespace {
+uint32_t Pack10(std::array<unsigned, 4> c) {
+  return (c[0] & 1023u) | ((c[1] & 1023u) << 10) | ((c[2] & 1023u) << 20) |
+         ((c[3] & 3u) << 30);
+}
+std::array<unsigned, 4> Unpack10(uint32_t w) {
+  return {w & 1023u, w >> 10 & 1023u, w >> 20 & 1023u, w >> 30};
+}
+uint32_t Word10(std::span<const std::byte> b, size_t offset) {
+  return uint32_t(b[offset]) | (uint32_t(b[offset + 1]) << 8) |
+         (uint32_t(b[offset + 2]) << 16) | (uint32_t(b[offset + 3]) << 24);
+}
+void Append10(std::vector<std::byte> &b, uint32_t w) {
+  for (unsigned i = 0; i < 4; ++i)
+    b.push_back(std::byte(w >> (8 * i)));
+}
+std::array<unsigned, 4> Quantize10(std::array<double, 4> c) {
+  std::array<unsigned, 4> q;
+  for (unsigned k = 0; k < 4; ++k)
+    q[k] =
+        unsigned(std::lround(std::clamp(c[k], 0., 1.) * (k == 3 ? 3 : 1023)));
+  return q;
+}
+void PackedPixels(const ImageReadback &r, std::array<unsigned, 4> expected,
+                  uint32_t changed_mask = 15) {
+  Check(r.format == ImageFormat::A2B10G10R10Unorm &&
+            r.row_bytes == uint64_t(r.width) * 4 &&
+            r.bytes.size() == r.row_bytes * r.height,
+        "Packed typed metadata mismatch");
+  for (size_t i = 0; i < r.bytes.size(); i += 4) {
+    auto actual = Unpack10(Word10(r.bytes, i));
+    for (unsigned k = 0; k < 4; ++k) {
+      // Alpha samples are chosen away from half-way ties; unchanged channels
+      // exact.
+      const int tolerance = (changed_mask >> k & 1) && k < 3 ? 1 : 0;
+      if (std::abs(int(actual[k]) - int(expected[k])) > tolerance)
+        throw std::runtime_error("Packed10 oracle channel" + std::to_string(k) +
