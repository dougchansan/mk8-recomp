--- /dev/null
+++ b/tests/native_platform/ipc_integration.cpp
@@ -0,0 +1,295 @@
+#include "ipc_bridge.h"
+#include <array>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+using namespace native;
+static void check(bool v, const char *m) {
+  if (!v)
+    throw std::runtime_error(m);
+}
+static void put(std::array<std::byte, 256> &bytes, size_t at, uint32_t value) {
+  memcpy(bytes.data() + at, &value, 4);
+}
+static std::array<std::byte, 256> request(unsigned command, bool pid = false,
+                                          const char *name = "") {
+  std::array<std::byte, 256> bytes{};
+  put(bytes, 0, 4);
+  const unsigned cursor = pid ? 20 : 8, raw = pid ? 32 : 16;
+  put(bytes, 4, (raw + 24 - cursor) / 4 | (pid ? 0x80000000u : 0));
+  if (pid) {
+    put(bytes, 8, 1);
+    put(bytes, 12, 0xdeadbeef);
+    put(bytes, 16, 0xfedcba98);
+  }
+  put(bytes, raw, 0x49434653);
+  put(bytes, raw + 8, command);
+  memcpy(bytes.data() + raw + 16, name, std::min(size_t(8), strlen(name)));
+  return bytes;
+}
+static void message(Host &h, uint64_t base,
+                    const std::array<std::byte, 256> &bytes) {
+  for (unsigned i = 0; i < 256; i += 8) {
+    uint64_t v;
+    memcpy(&v, bytes.data() + i, 8);
+    h.write(base + i, 8, v);
+  }
+}
+static void prepare(Host &h, AddressSpace &space, uint64_t tls) {
+  space.map(0x4000, {'s', 'm', ':', 0}, 4096, 3);
+  h.address_space = &space;
+  h.context.tpidrro_el0 = tls;
+  h.register_current_thread(1, 44, 0);
+  h.allowed_svcs.insert(h.allowed_svcs.end(), {31, 33, 22, 24});
+}
+static uint32_t connect(Host &h) {
+  h.context.pending_svc = 31;
+  h.context.x[1] = 0x4000;
+  h.context.x[2] = 0x123456;
+  h.service();
+  check(h.context.x[0] == 0 && h.context.x[1] >= 0x10000 &&
+            h.context.x[2] == 0x123456,
+        "native SM Connect ABI/handle ownership");
+  return uint32_t(h.context.x[1]);
+}
+class EventEndpoint final : public native_services::Endpoint {
+public:
+  explicit EventEndpoint(EventRef event) : event_(std::move(event)) {}
+  native_services::Reply Prepare(const native_services::Request &r) override {
+    native_services::Reply reply;
+    if (r.command != 0)
+      return reply;
+    reply.status = native_services::Status::Ok;
+    reply.copied_event = event_;
+    return reply;
+  }
+
+private:
+  EventRef event_;
+};
+class ReadProbe final : public native_services::Endpoint {
+public:
+  native_services::Reply Prepare(const native_services::Request &r) override {
+    std::vector<std::byte> bytes(512, std::byte{0x55});
+    check(r.memory.read(r.memory.user, 0x8000, bytes),
+          "descriptor read larger than TLS");
+    for (auto b : bytes)
+      check(b == std::byte{0x6b}, "descriptor full bytes");
+    std::fill(bytes.begin(), bytes.end(), std::byte{0x55});
+    check(!r.memory.read(r.memory.user, 0x9f00, bytes),
+          "descriptor denied boundary");
+    for (auto b : bytes)
+      check(b == std::byte{0x55},
+            "failed descriptor read preserves destination");
+    bytes.resize((64u << 10) + 1, std::byte{0x55});
+    check(!r.memory.read(r.memory.user, 0x8000, bytes),
+          "descriptor size bound");
+    native_services::Reply reply;
+    reply.status = native_services::Status::Ok;
+    return reply;
+  }
+};
+int main() {
+  try {
+    {
+      Host h;
+      AddressSpace space;
+      space.map(0x1000, {}, 4096, 3, 12);
+      prepare(h, space, 0x1000);
+      native_services::Router router(77);
+      attach_services(h, router, 77);
+      auto handle = connect(h);
+      check(router.SessionCount() == 1, "real native SM session allocated");
+      message(h, 0x1000, request(0, true));
+      h.context.pending_svc = 33;
+      h.context.x[0] = handle;
+      h.context.x[1] = 0xabcdef;
+      h.service();
+      check(h.context.x[0] == 0 && h.context.x[1] == 0xabcdef &&
+                h.read(0x1010, 4) == 0x4f434653 && h.read(0x1018, 4) == 0,
+            "actual TLS CMIF Initialize response and SVC ABI");
+      auto missing = request(1, false, "missing");
+      message(h, 0x1000, missing);
+      h.context.pending_svc = 33;
+      h.context.x[0] = handle;
+      bool rejected = false;
+      try {
+        h.service();
+      } catch (const std::runtime_error &e) {
+        rejected = std::string(e.what()).find("missing") != std::string::npos;
+      }
+      check(rejected && router.SessionCount() == 1 && h.context.x[0] == handle,
+            "unknown service explicit diagnostic no fake handle/result");
+      for (unsigned i = 0; i < 256; i += 8) {
+        uint64_t v;
+        memcpy(&v, missing.data() + i, 8);
+        check(h.read(0x1000 + i, 8) == v,
+              "unknown service leaves TLS unchanged");
+      }
+      std::array<std::byte, 256> close_message{};
+      put(close_message, 0, 2);
+      message(h, 0x1000, close_message);
+      h.context.pending_svc = 33;
+      h.context.x[0] = handle;
+      h.service();
+      check(h.context.x[0] == 0 && router.SessionCount() == 1,
+            "HIPC close retains owned kernel client handle");
+      h.context.pending_svc = 33;
+      h.context.x[0] = handle;
+      h.service();
+      check(h.context.x[0] == (1u | (123u << 9)) && router.SessionCount() == 1,
+            "closed endpoint returns actual SessionClosed kernel result");
+      h.context.pending_svc = 22;
+      h.context.x[0] = handle;
+      h.service();
+      check(h.context.x[0] == 0 && router.SessionCount() == 0,
+            "Svc0x16 closes actual provider session");
+    }
+    {
+      Host h;
+      AddressSpace space;
+      auto input = request(0, true);
+      std::vector<uint8_t> first(4096, 0x71), second(4096, 0x72);
+      memcpy(first.data() + 0xf80, input.data(), 128);
+      memcpy(second.data(), input.data() + 128, 128);
+      space.map(0x1000, first, 4096, 3, 12);
+      space.map(0x2000, second, 4096, 1, 12);
+      prepare(h, space, 0x1f80);
+      native_services::Router router(88);
+      attach_services(h, router, 88);
+      auto handle = connect(h);
+      auto epoch = h.epoch;
+      h.context.pending_svc = 33;
+      h.context.x[0] = handle;
+      bool rejected = false;
+      try {
+        h.service();
+      } catch (const std::runtime_error &e) {
+        rejected = std::string(e.what()).find("TLS response write failed") !=
+                   std::string::npos;
+      }
+      check(rejected && h.epoch == epoch && h.data_writes == 0 &&
+                router.SessionCount() == 1,
+            "whole TLS response preflight prevents partial protected-boundary "
+            "writes");
+      for (unsigned i = 0; i < 256; i += 8) {
+        uint64_t v;
+        memcpy(&v, input.data() + i, 8);
+        check(space.read(0x1f80 + i, 8) == v,
+              "failed response leaves entire request unchanged");
+      }
+    }
+    {
+      Host h;
+      AddressSpace space;
+      space.map(0x1000, {}, 4096, 3, 12);
+      space.map(0x8000, std::vector<uint8_t>(4096, 0x6b), 4096, 1);
+      space.map(0x9000, {}, 4096, 1);
+      prepare(h, space, 0x1000);
+      native_services::Router router(99);
+      router.Register("probe", [] { return std::make_unique<ReadProbe>(); });
+      attach_services(h, router, 99);
+      auto handle = connect(h);
+      auto send = [&](uint32_t target, const auto &input) {
+        message(h, 0x1000, input);
+        h.context.pending_svc = 33;
+        h.context.x[0] = target;
+        h.service();
+      };
+      send(handle, request(0, true));
+      send(handle, request(1, false, "probe"));
+      auto probe = uint32_t(h.read(0x100c, 4));
+      check(probe >= 0x10000 && probe != handle, "owned probe session");
+      send(probe, request(0));
+      check(h.context.x[0] == 0, "descriptor adapter complete callback path");
+    }
+    {
+      Host h;
+      AddressSpace space;
+      space.map(0x1000, {}, 4096, 3, 12);
+      prepare(h, space, 0x1000);
+      auto event = std::make_shared<NativeEvent>(111);
+      native_services::Router router(111);
+      router.Register(
+          "event", [event] { return std::make_unique<EventEndpoint>(event); });
+      attach_services(h, router, 111);
+      auto sm = connect(h);
+      auto send = [&](uint32_t handle, const auto &input) {
+        message(h, 0x1000, input);
+        h.context.pending_svc = 33;
+        h.context.x[0] = handle;
+        h.service();
+      };
+      send(sm, request(0, true));
+      send(sm, request(1, false, "event"));
+      auto service = uint32_t(h.read(0x100c, 4));
+      send(service, request(0));
+      auto copied = uint32_t(h.read(0x100c, 4));
+      check(h.read(0x1008, 4) == 2 && copied == EventHandleBegin &&
+                h.event_registry.GetReadable(copied) == event &&
+                !event->IsSignaled(),
+            "real CPU readable-event COPY header/handle/object starts "
+            "unsignaled");
+      event->Signal();
+      check(h.event_registry.GetReadable(copied)->IsSignaled(),
+            "native producer signal observed by copied readable capability");
+      event->Clear();
+      h.context.pending_svc = 22;
+      h.context.x[0] = copied;
+      h.service();
+      check(h.context.x[0] == 0 && h.event_registry.PublishedCount() == 0 &&
+                router.SessionCount() == 2,
+            "kernel CloseHandle routes event independently of real service "
+            "handles");
+      auto input = request(0);
+      AddressSpace protected_space;
+      std::vector<uint8_t> first(4096, 0x71), second(4096, 0x72);
+      memcpy(first.data() + 0xf80, input.data(), 128);
+      memcpy(second.data(), input.data() + 128, 128);
+      protected_space.map(0x1000, first, 4096, 3, 12);
+      protected_space.map(0x2000, second, 4096, 1, 12);
+      h.address_space = &protected_space;
+      h.context.tpidrro_el0 = 0x1f80;
+      h.threads.at(h.current_thread_handle).tls_address = 0x1f80;
+      auto references = event.use_count();
+      auto epoch = h.epoch;
+      h.data_writes = 0;
+      h.context.pending_svc = 33;
+      h.context.x[0] = service;
+      bool rejected = false;
+      try {
+        h.service();
+      } catch (const std::runtime_error &e) {
+        rejected = std::string(e.what()).find("TLS response write failed") !=
+                   std::string::npos;
+      }
+      check(
+          rejected && h.epoch == epoch && h.data_writes == 0 &&
+              h.event_registry.PublishedCount() == 0 &&
+              h.event_registry.ReservedCount() == 0 &&
+              event.use_count() == references,
+          "real event reservation rolls back on atomic TLS boundary rejection");
