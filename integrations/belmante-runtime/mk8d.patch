+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstdint>
+#include <span>
+#include <stdexcept>
+namespace nx::nvn {
+// SDK53 layout helper maps +0x58 bits4..7 to Y,8..11 to Z,12..15 to X.
+inline uint32_t sdk53_packaged_block_height(std::span<const uint8_t> builder) {
+    if(builder.size()<0x5a)throw std::invalid_argument("truncated SDK53 packaged layout");
+    const uint16_t value=uint16_t(builder[0x58])|(uint16_t(builder[0x59])<<8);
+    if(!(value&1))return 0;
+    const auto y=(value>>4)&15,z=(value>>8)&15,x=(value>>12)&15;
+    if(x||z||y>5)throw std::invalid_argument("unsupported packaged GOB dimensions");
+    return 1u<<y;
+}
+}
