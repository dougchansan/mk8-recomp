+    s.process_id=process_;s.program_id=program_.ProgramId();s.context_generation=generation_;s.catalog_generation=1;
+    s.catalog_entries=catalog_.Entries().size();s.disabled_policy_entries=disabled_.size();
+    s.npdm_bytes=program_.MetadataBytes();s.aci_offset=program_.AciOffset();s.aci_bytes=program_.AciBytes();s.npdm_sha256=program_.Digest();
+    s.endpoint_constructions=constructions_;s.control=AddOnControlState::NotMounted;s.event_present=bool(event_);
