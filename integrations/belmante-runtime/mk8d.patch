+namespace {
+
+SaveSnapshot capture_for_save(Engine& e) {  // under e.lock: copy only, no filtering/hashing/merging
+    SaveSnapshot out;
+    out.used.reserve(e.used_order.size());
+    for (const std::string& v : e.used_order) out.used.push_back(e.used.at(v));
+    out.older = e.older;
+    out.rejected = e.rejected;
+    return out;
+}
+
+std::vector<Recipe> snapshot_for_save(Engine& e) {  // under e.lock
+    std::vector<Recipe> used, older;
+    used.reserve(e.used_order.size());
+    for (const std::string& v : e.used_order) used.push_back(e.used.at(v));
+    for (const Recipe& r : e.older)
+        if (!e.rejected.count(value_key(r.vs.digest, r.fs.hash.empty() ? nullptr : &r.fs.digest, r.state)))
+            older.push_back(r);
+    return merge_for_save(used, older, kMaxRecipes);
+}
+
+}  // namespace
+
+void save_async() {
+    if (mode() == Mode::Off) return;
+    Engine& e = engine();
+    SaveSnapshot inputs;
+    std::string path;
+    FileInfo info;
+    {
+        std::lock_guard guard(e.lock);
+        if (!e.started || e.dirty == 0 || e.saving.exchange(true)) return;
+        e.dirty = 0;
+        measurement::Scope measured("recipe-save-snapshot");
+        inputs = capture_for_save(e);
+        path = e.path, info = e.info;
+    }
+    std::thread([inputs = std::move(inputs), path, info] {  // off the replay thread; the rename is atomic
+        std::vector<Recipe> snapshot;
+        {
+            measurement::Scope measured("recipe-save-merge");
+            snapshot = inputs.finish();
+        }
+        std::string why;
+        std::string bytes;
+        {
+            measurement::Scope measured("recipe-save-serialize");
+            bytes = serialize(snapshot, info);
+        }
+        bool written;
+        {
+            measurement::Scope measured("recipe-save-write",0,bytes.size());
+            written = write_atomic(path, bytes, &why);
+        }
+        if (written)
+            log("nvn/vk: pipeline recipes saved: %zu (%zu bytes)", snapshot.size(), bytes.size());
+        else
+            log("nvn/vk: pipeline recipes not saved: %s", why.c_str());
+        engine().saving.store(false);
+    }).detach();
+}
+
+void stop(uint64_t wait_ms) {
+    Engine& e = engine();
+    std::unique_lock lk(e.lock);
+    e.stopping = true;  // queued recipes stay queued: draws claim and build them themselves
+    e.changed.wait_for(lk, std::chrono::milliseconds(wait_ms), [&] { return e.active == 0; });
+}
+
+Counters counters() {
+    Engine& e = engine();
+    std::lock_guard guard(e.lock);
+    return e.c;
+}
+
+void configure_for_test(Mode m, const std::string& directory,
+                        std::vector<std::pair<std::string, std::vector<uint32_t>>> sources) {
+    Engine& e = engine();
+    std::unique_lock lk(e.lock);
+    e.changed.wait(lk, [&] { return e.active == 0; });
+    // Pipelines, modules and layouts made so far stay alive (draws may hold them); only the bookkeeping resets.
+    e.table.clear(), e.queue.clear(), e.used.clear(), e.used_order.clear(), e.older.clear(), e.rejected.clear();
+    e.c = {}, e.last_window = {}, e.dirty = 0;
+    e.stopping = false, e.drained_logged = false, e.prewarm_start_ns = 0;
+    e.started = m != Mode::Off;
+    e.prewarm = m == Mode::Prewarm;
+    e.path = directory + "/pipeline_recipes_v1.bin";
+    {
+        std::lock_guard sg(e.stage_lock);
+        e.sources = std::move(sources);
+        for (auto& [hash, stage] : e.stages) stage->tried = false, stage->ok = false;
+    }
+    g_mode.store(int(m), std::memory_order_release);
+}
+
+void enqueue(const std::vector<Recipe>& list) {
+    Engine& e = engine();
+    std::lock_guard guard(e.lock);
+    enqueue_locked(e, list);
+    e.older.insert(e.older.end(), list.begin(), list.end());
+    if (e.prewarm && !e.stopping) start_workers(e);
+}
+
+bool wait_idle(uint64_t timeout_ms) {
+    Engine& e = engine();
+    std::unique_lock lk(e.lock);
+    return e.changed.wait_for(lk, std::chrono::milliseconds(timeout_ms), [&] { return e.active == 0; });
+}
+
+std::vector<Recipe> used_recipes() {
+    Engine& e = engine();
+    std::lock_guard guard(e.lock);
+    std::vector<Recipe> out;
+    for (const std::string& v : e.used_order) out.push_back(e.used.at(v));
+    return out;
+}
+
+bool save_now(std::string* why) {
+    Engine& e = engine();
+    std::vector<Recipe> snapshot;
+    std::string path;
+    FileInfo info;
+    {
+        std::lock_guard guard(e.lock);
+        snapshot = snapshot_for_save(e);
+        path = e.path, info = e.info;
+        e.dirty = 0;
+    }
+    return write_atomic(path, serialize(snapshot, info), why);
+}
