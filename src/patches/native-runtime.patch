+      auto f = std::make_unique<Fixture>();
+      f->host.dispatch(budget, 64);
+      check(f->host.waiting() && !f->host.exited &&
+                f->host.context.pending_svc == 24 &&
+                f->host.context.pc == 0x5004 && f->host.blocks == 1,
+            "emitted SVC parks owner with exact entered block");
+      auto before = f->host.context;
+      auto slices = f->host.slices;
+      f->host.dispatch(budget, 64);
+      check(memcmp(&before, &f->host.context, sizeof(before)) == 0 &&
+                f->host.blocks == 1 && f->host.slices == slices,
+            "parked wait no repeat SVC/hook/budget reset");
+      f->host.interrupt = true;
+      f->event->Signal();
+      f->event->Clear();
+      f->host.dispatch(budget, 64);
+      check(memcmp(&before, &f->host.context, sizeof(before)) == 0,
+            "interrupt retains ready wait without guest commit");
+      f->host.interrupt = false;
+      check(f->host.event_registry.Close(f->handle),
+            "close client handle while retained wait object exists");
+      f->host.dispatch(budget, 64);
+      check(f->host.exited && !f->host.waiting() && f->host.context.x[0] == 0 &&
+                f->host.context.x[1] == 0 && f->host.blocks == 2 &&
+                f->host.svc_calls == 2 && f->host.event_wait_parks == 1 &&
+                f->host.event_wait_completions == 1,
