+"""Check actual wildcard root ownership, rather than only original-call counts."""
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+invalid_context = len(sys.argv) > 2 and sys.argv[2] == "invalid"
+filtered = invalid_context or len(sys.argv) > 2 and sys.argv[2] == "filtered"
+with tempfile.TemporaryDirectory(prefix="native-worker-inventory-") as temporary:
+    log = Path(temporary) / "native.log"
+    env = os.environ.copy()
+    env["NX_LOG"] = str(log)
+    result = subprocess.run(
+        [sys.argv[1], "--worker-context-invalid" if invalid_context else "--worker-context" if filtered else "--worker-inventory"],
+        env=env, capture_output=True,
+        text=True, timeout=15, check=True,
+    )
+    expected = "original_calls=13 leaves=12 expected_roots=0 PASS" if invalid_context else (
+        "original_calls=13 leaves=12 expected_roots=6 PASS" if filtered else "original_calls=8 leaves=7 expected_roots=5 PASS"
+    )
+    assert expected in result.stdout
+    roots, callbacks, summaries, contexts = [], [], [], []
+    hex_fields = {"caller", "target", "object", "vptr"}
+    for line in log.read_text().splitlines():
+        if line.startswith("call phase: v=1 "):
+            fields = dict(word.split("=", 1) for word in line.split()[2:])
+            roots.append({k: int(v, 16 if k in hex_fields else 10) for k, v in fields.items()})
+        elif line.startswith("call phase callback: v=1 "):
+            fields = dict(word.split("=", 1) for word in line.split()[3:])
+            callbacks.append({k: int(v, 16 if k in hex_fields else 10) for k, v in fields.items()})
+        elif line.startswith("call phase callback summary: "):
+            fields = dict(word.split("=", 1) for word in line.split(";", 1)[0].split()[4:])
+            summaries.append({k: int(v) for k, v in fields.items()})
+        elif line.startswith("call phase context: v=1 "):
+            fields = dict(word.split("=", 1) for word in line.split()[3:])
+            contexts.append({k: int(v, 16 if k in {"offset", "value"} else 10) for k, v in fields.items()})
+    if invalid_context:
+        assert roots == callbacks == summaries == contexts == []
+        assert "call phase: disabled invalid root context configuration" in log.read_text()
+        print(result.stdout.strip())
+        print("native context partial configuration rejected; original calls preserved PASS")
+        raise SystemExit(0)
+    count = 6 if filtered else 5
+    exception = 2 if filtered else 1
+    invalid = 4 if filtered else 3
+    assert len(roots) == len(summaries) == count and len(callbacks) == count - 1, (roots, summaries, callbacks)
+    assert [r["root"] for r in roots] == list(range(1, count + 1))
+    assert all(r["caller"] == 0x100 and r["site"] == 0 and r["frame"] == r["end_frame"] == 0 for r in roots)
+    assert all(r["calls"] == 1 and r["cpu_samples"] == 1 and r["hle_overflow"] == 0 for r in roots)
+    assert all(r["target"] == roots[0]["target"] for i, r in enumerate(roots) if i != exception)
+    assert roots[exception]["target"] != roots[0]["target"] and roots[exception]["threw"] == 1
+    assert all(r["threw"] == 0 for i, r in enumerate(roots) if i != exception)
+    assert roots[0]["object"] == roots[exception]["object"] == roots[-1]["object"]
+    assert roots[invalid - 1]["object"] != roots[0]["object"]
+    assert roots[invalid]["object"] == 1 and roots[invalid]["vptr"] == roots[invalid]["readable"] == 0
+    assert all(r["readable"] == 1 for i, r in enumerate(roots) if i != invalid)
+    assert len({r["tid"] for r in roots[:-1]}) == 1 and roots[-1]["tid"] != roots[0]["tid"]
+    assert {r["root"] for r in callbacks} == set(range(1, count + 1)) - {exception + 1}
+    for summary in summaries:
+        children = [r for r in callbacks if r["root"] == summary["root"]]
+        assert len(children) == summary["entries"] and summary["dropped_calls"] == 0
+        assert all(r["tid"] == roots[summary["root"] - 1]["tid"] and r["caller"] == 0x100 for r in children)
+    if filtered:
+        assert len(contexts) == count and {r["root"] for r in contexts} == set(range(1, count + 1))
+        assert roots[0]["object"] == roots[1]["object"]  # Context changes retain distinct roots.
+        for context in contexts:
+            root = roots[context["root"] - 1]
+            assert context["tid"] == root["tid"] and context["frame"] == root["frame"]
+            assert context["register"] == 21 and context["offset"] == 8
+            assert context["value"] == (0x111 if context["root"] == 1 else 0x222)
+    else:
+        assert contexts == []
+    print(result.stdout.strip())
+print(f"native wildcard stream roots={count} callbacks={count - 1} sampled_exception=1 threads=2 context_filter={int(filtered)} PASS")
