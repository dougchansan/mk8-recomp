+#include <iostream>
+#include <stdexcept>
+using namespace native;
+static void check(bool v, const char *why) {
+  if (!v)
+    throw std::runtime_error(why);
+}
+template <class F> static bool rejects(F f) {
+  try {
+    f();
+  } catch (const std::runtime_error &) {
+    return true;
+  }
+  return false;
+}
+static void put(std::vector<uint8_t> &v, size_t at, uint64_t x,
+                unsigned n = 8) {
+  memcpy(v.data() + at, &x, n);
+}
+static NsoImage image(uint32_t type, uint8_t info = 0x10,
+                      uint8_t visibility = 0, uint16_t section = 1,
+                      uint64_t addend = 0x20) {
+  NsoImage out;
+  out.name = "rtld";
+  out.image_size = 0x3000;
+  for (unsigned i = 0; i < 3; ++i) {
+    out.segments[i].offset = i * 4096;
+    out.segments[i].memory_size = 4096;
+    out.segments[i].permission = i == 0 ? 5 : i == 1 ? 1 : 3;
+    out.segments[i].bytes.resize(4096);
+  }
+  put(out.segments[0].bytes, 4, 0x100, 4);
+  put(out.segments[0].bytes, 0x100, 0x30444f4d, 4);
+  put(out.segments[0].bytes, 0x104, 0x1f00, 4);
+  auto &data = out.segments[2].bytes;
+  put(data, 0, 7);
+  put(data, 8, 0x2100);
+  put(data, 16, 8);
+  put(data, 24, 24);
+  put(data, 32, 9);
+  put(data, 40, 24);
+  put(data, 0x100, 0x2200);
+  put(data, 0x108, (UINT64_C(1) << 32) | type);
+  put(data, 0x110, addend);
+  out.dynsym_offset = 0x100;
+  out.dynsym_size = 48;
+  out.dynstr_offset = 0x200;
+  out.dynstr_size = 8;
+  auto &ro = out.segments[1].bytes;
+  put(ro, 0x118, 1, 4);
+  ro[0x11c] = info;
+  ro[0x11d] = visibility;
+  put(ro, 0x11e, section, 2);
+  put(ro, 0x120, section ? 0x80 : 0);
+  memcpy(ro.data() + 0x201, "foo", 4);
+  return out;
+}
+int main(int argc, char **argv) {
+  try {
+    if (argc != 2)
+      return 2;
+    std::string test = argv[1];
+    if (test == "clock") {
+      Host h;
+      h.context.pending_svc = 11;
+      h.context.x[0] = 100;
+      h.service();
+      check(h.ticks == 1, "100 ns equals one 19.2MHz tick plus carry");
+      for (unsigned i = 0; i < 9; ++i) {
+        h.context.pending_svc = 11;
+        h.context.x[0] = 100;
+        h.service();
+      }
+      check(h.ticks == 19 && h.sleep_ns == 1000,
+            "fractional ticks carry across sleeps");
+      h.ticks = UINT64_MAX;
+      auto sleep = h.sleep_ns;
+      h.context.pending_svc = 11;
+      h.context.x[0] = 100;
+      check(rejects([&] { h.service(); }) && h.ticks == UINT64_MAX &&
+                h.sleep_ns == sleep,
+            "clock overflow beforeeffects");
+    } else if (test == "pair-load") {
+      Host h;
+      std::vector<uint8_t> page(4096, 0x71);
+      h.map(0x3000, page.data(), page.size(), 3);
+      uint64_t lo = 0x1234, hi = 0x5678;
+      check(rejects([&] { h.bridge.excl_load_pair(&h, 0x3ff8, 8, &lo, &hi); }),
+            "pair load misalignment rejection");
+      check(lo == 0x1234 && hi == 0x5678 && h.reservation_size == 0 &&
+                h.events.empty(),
+            "failed pair load preserves output canaries and establishes no "
+            "reservation");
+    } else if (test == "pair-store") {
