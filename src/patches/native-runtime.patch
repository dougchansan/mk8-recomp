+"""Synthetic correctness and descriptive execution-only benchmark; no games."""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--build', type=Path, required=True)
+parser.add_argument('--cmake', default='cmake')
+args = parser.parse_args()
+here = Path(__file__).resolve().parent
+build = args.build.resolve()
+
+def run(command):
+    print(' '.join(map(str, command)), flush=True)
+    subprocess.run(list(map(str, command)), check=True, creationflags=(subprocess.BELOW_NORMAL_PRIORITY_CLASS if os.name == 'nt' else 0))
+
+run([args.cmake, '-S', here, '-B', build, '-DSUYU_SOURCE=' + str(here.parents[1])])
+run([args.cmake, '--build', build, '--config', 'Release', '--parallel', '2'])
+exe = next(p for p in (build / 'Release' / 'rsqrt_test.exe', build / 'rsqrt_test.exe', build / 'rsqrt_test') if p.exists())
+run([exe])
+run([exe, '--benchmark'])
diff --git a/tests/native_rsqrt/test.c b/tests/native_rsqrt/test.c
new file mode 100644
index 0000000000000000000000000000000000000000..bc61ea0ad2643b49a093db6baf123ecc358d548d
--- /dev/null
+++ b/tests/native_rsqrt/test.c
@@ -0,0 +1,170 @@
+#include "recomp_runtime.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+uint64_t original_estimate(GuestContext *, uint64_t, unsigned, int);
+uint64_t lookup_estimate(GuestContext *, uint64_t, unsigned, int);
+unsigned lookup_table(unsigned);
+static uint64_t cases, rng = UINT64_C(0x5ec91f3a);
+static volatile uint64_t checksum;
+static uint64_t random64(void) {
+  rng ^= rng << 13;
+  rng ^= rng >> 7;
+  rng ^= rng << 17;
+  return rng;
+}
+static void check(int ok, const char *why) {
+  if (!ok) {
+    fprintf(stderr, "FAIL %s\n", why);
+    exit(1);
+  }
+}
+static void compare(uint64_t bits, unsigned width, uint32_t fpcr,
+                    uint64_t sticky, int op) {
+  static GuestContext a, b;
+  uint64_t x, y;
+  a.fpcr = b.fpcr = fpcr;
+  a.fpsr = b.fpsr = sticky;
+  x = original_estimate(&a, bits, width, op);
+  y = lookup_estimate(&b, bits, width, op);
+  if (x != y || a.fpsr != b.fpsr) {
+    fprintf(stderr,
+            "FAIL bits=%llx width=%u op=%d fpcr=%x fpsr=%llx "
+            "original=%llx/%llx lookup=%llx/%llx\n",
+            (unsigned long long)bits, width, op, fpcr,
+            (unsigned long long)sticky, (unsigned long long)x,
+            (unsigned long long)a.fpsr, (unsigned long long)y,
+            (unsigned long long)b.fpsr);
+    exit(1);
+  }
+  ++cases;
+}
+static unsigned search(unsigned a) {
+  unsigned lo = 512, hi = 1024;
+  while (lo + 1 < hi) {
+    unsigned mid = (lo + hi) / 2;
+    if ((uint64_t)a * mid * mid < (UINT64_C(1) << 28))
+      lo = mid;
+    else
+      hi = mid;
+  }
+  return ((lo + 1) / 2) & 255;
+}
+static void proof(void) {
+  unsigned raw, seen[256] = {0};
+  for (raw = 128; raw < 512; ++raw) {
+    unsigned a = raw < 256 ? 2 * raw + 1 : 2 * (raw | 1);
+    unsigned index = a < 512 ? (a - 257) / 2 : 128 + (a - 514) / 4;
+    check(index < 256, "selector index bounds");
+    check(lookup_table(index) == search(a), "integer search/table exactness");
+    seen[index]++;
+  }
+  for (raw = 0; raw < 256; ++raw)
+    check(seen[raw] > 0, "all 256 table values reached");
+  puts("384 raw selectors / 256 transformed values exhaustive proof passed");
+}
+static uint32_t mode(unsigned i) {
+  return ((i & 3) << 22) | ((i & 4) ? 1u << 24 : 0) | ((i & 8) ? 1u << 25 : 0);
+}
+static void differential(void) {
+  unsigned width, m, op, exp, selector, edge, sign;
+  for (width = 32; width <= 64; width += 32) {
+    unsigned f = width == 32 ? 23 : 52, maxexp = width == 32 ? 255 : 2047;
+    uint64_t hidden = UINT64_C(1) << f, fracmask = hidden - 1,
+             signbit = UINT64_C(1) << (width - 1);
+    for (m = 0; m < 16; ++m)
+      for (op = 0; op < 2; ++op) {
+        uint64_t sticky =
+            UINT64_C(0x8000000000000000) | ((uint64_t)m << 8) | op;
+        for (exp = 1; exp < maxexp; ++exp)
+          for (selector = 0; selector < 256; ++selector)
+            for (edge = 0; edge < 2; ++edge) {
+              uint64_t frac = ((uint64_t)selector << (f - 8)) |
+                              (edge ? ((UINT64_C(1) << (f - 8)) - 1) : 0);
+              uint64_t bits = ((uint64_t)exp << f) | frac;
+              compare(bits, width, mode(m), sticky, op);
+              compare(bits | signbit, width, mode(m), sticky, op);
+            }
+        for (selector = 0; selector < f; ++selector)
+          for (edge = 0; edge < 2; ++edge)
+            for (sign = 0; sign < 2; ++sign) {
+              uint64_t frac = edge ? ((UINT64_C(1) << (selector + 1)) - 1)
+                                   : (UINT64_C(1) << selector);
+              compare(frac | (sign ? signbit : 0), width, mode(m), sticky, op);
+            }
+        {
+          uint64_t special[] = {0,
+                                signbit,
+                                (uint64_t)maxexp << f,
+                                ((uint64_t)maxexp << f) | signbit,
+                                ((uint64_t)maxexp << f) | 1,
+                                ((uint64_t)maxexp << f) | (hidden >> 1),
+                                ((uint64_t)maxexp << f) | fracmask,
+                                fracmask,
+                                signbit | fracmask};
+          unsigned i;
+          for (i = 0; i < sizeof(special) / sizeof(special[0]); ++i) {
+            compare(special[i], width, mode(m), sticky, op);
+            compare(special[i], width, mode(m), 0, op);
+          }
+        }
+        for (selector = 0; selector < 4096; ++selector)
+          compare(random64(), width, mode(m), random64(), op);
+      }
+  }
+  printf("result/FPSR differential cases=%llu all16 FPCR modes both "
+         "widths/operations\n",
+         (unsigned long long)cases);
+}
+static uint64_t inputs[4096];
+static double bench(int lookup, unsigned repetitions, unsigned width,
+                    uint64_t *sum) {
+  GuestContext c = {0};
+  uint64_t total = 0;
+  unsigned r, i;
+  clock_t start = clock();
+  for (r = 0; r < repetitions; ++r)
+    for (i = 0; i < 4096; ++i) {
+      uint64_t v = lookup ? lookup_estimate(&c, inputs[i], width, 1)
+                          : original_estimate(&c, inputs[i], width, 1);
+      total += v ^ (uint64_t)i;
+    }
+  *sum = total ^ c.fpsr;
+  checksum = *sum;
+  return (double)(clock() - start) / CLOCKS_PER_SEC;
+}
+int main(int argc, char **argv) {
+  unsigned i, pair, width;
+  int benchmark = argc > 1 && !strcmp(argv[1], "--benchmark");
+  if (!benchmark) {
+    proof();
+    differential();
+    return 0;
+  }
+  puts("Loaded execution microbenchmark; unrelated system load uncontrolled; "
+       "descriptive only");
+  for (width = 32; width <= 64; width += 32) {
+    unsigned f = width == 32 ? 23 : 52, maxexp = width == 32 ? 254 : 2046;
+    for (i = 0; i < 4096; ++i)
+      inputs[i] = (random64() & ((UINT64_C(1) << f) - 1)) |
+                  ((uint64_t)(1 + random64() % maxexp) << f);
+    for (pair = 0; pair < 6; ++pair) {
+      uint64_t a, b;
+      double original, lookup;
+      if (pair & 1) {
+        lookup = bench(1, 32768, width, &b);
+        original = bench(0, 32768, width, &a);
+      } else {
+        original = bench(0, 32768, width, &a);
+        lookup = bench(1, 32768, width, &b);
+      }
+      check(a == b, "benchmark consumed checksum");
+      printf("width=%u pair=%u order=%s original_s=%.6f lookup_s=%.6f "
+             "checksum=%llx\n",
+             width, pair, (pair & 1) ? "lookup/original" : "original/lookup",
+             original, lookup, (unsigned long long)a);
+    }
+  }
+  return checksum == UINT64_C(0x123456789abcdef) ? 1 : 0;
+}
