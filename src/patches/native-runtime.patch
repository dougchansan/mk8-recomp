+cmake_minimum_required(VERSION 3.20)
+project(native_platform LANGUAGES C CXX)
+set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
+set(CMAKE_C_STANDARD 11)
+set(CMAKE_CXX_STANDARD 20)
+get_filename_component(SOURCE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/.." ABSOLUTE)
+find_package(Python3 COMPONENTS Interpreter REQUIRED)
+set(fixture "${CMAKE_CURRENT_BINARY_DIR}/fixture")
+execute_process(COMMAND "${Python3_EXECUTABLE}" "${SOURCE_ROOT}/tests/export_integration/make_fixture.py" "${fixture}" COMMAND_ERROR_IS_FATAL ANY)
+add_executable(native_emit "${SOURCE_ROOT}/tests/native_platform/generate.cpp")
+target_include_directories(native_emit PRIVATE "${SOURCE_ROOT}/src")
+set(gen "${CMAKE_CURRENT_BINARY_DIR}/generated")
+# Generated CMake projects must exist before add_subdirectory; the runner performs this bootstrap.
+if(EXISTS "${gen}/a/CMakeLists.txt")
+  set(RECOMP_STATIC_ONLY ON)
+  set(RECOMP_JOBS 2 CACHE STRING "Bounded compile parallelism" FORCE)
+  add_subdirectory("${gen}/a" module_a)
+  add_subdirectory("${gen}/b" module_b)
+  add_subdirectory("${gen}/fixture" module_fixture)
+  add_library(native_host STATIC host.cpp loader.cpp address_space.cpp nso.cpp relocations.cpp)
+  set(NATIVE_LZ4_LIBRARY "" CACHE FILEPATH "Existing static LZ4 library; no download")
+  if(NATIVE_LZ4_LIBRARY)
+    target_compile_definitions(native_host PRIVATE NATIVE_HAVE_LZ4=1)
+    target_link_libraries(native_host PUBLIC "${NATIVE_LZ4_LIBRARY}")
+    if(MSVC)
+      target_link_options(native_host INTERFACE /NODEFAULTLIB:MSVCRT)
+    endif()
+  endif()
+  if(WIN32)
+    target_link_libraries(native_host PUBLIC bcrypt)
+  endif()
+  add_executable(native_primitive_test "${SOURCE_ROOT}/tests/native_platform/primitives.cpp")
+  target_link_libraries(native_primitive_test PRIVATE native_host)
+  add_executable(native_loader_test "${SOURCE_ROOT}/tests/native_platform/nso_test.cpp")
+  target_link_libraries(native_loader_test PRIVATE native_host)
+  if(NATIVE_LZ4_LIBRARY)
+    target_compile_definitions(native_loader_test PRIVATE NATIVE_HAVE_LZ4=1)
+  endif()
+  add_executable(native_admit "${SOURCE_ROOT}/tests/native_platform/admit.cpp")
+  target_link_libraries(native_admit PRIVATE native_host)
+  if(MSVC)
+    foreach(target native_loader_test native_admit native_primitive_test)
+      target_link_options(${target} PRIVATE "/MAP:${CMAKE_CURRENT_BINARY_DIR}/${target}.map")
+    endforeach()
+  endif()
+  target_compile_definitions(native_host PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN)
+  target_include_directories(native_host PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}" "${gen}/a")
+  target_link_libraries(native_host PUBLIC recomp_runtime_shared)
+  add_executable(native_platform_test "${SOURCE_ROOT}/tests/native_platform/test.cpp")
+  if(MSVC)
+    target_link_options(native_platform_test PRIVATE "/MAP:${CMAKE_CURRENT_BINARY_DIR}/native_platform_test.map")
+  endif()
+  target_include_directories(native_platform_test PRIVATE "${gen}")
+  target_link_libraries(native_platform_test PRIVATE native_host recomp_static_a recomp_static_b recomp_static_fixture)
+endif()
+
+
+
+
+
+
+if(NOT DEFINED NATIVE_SERVICES_TESTS)
+  set(NATIVE_SERVICES_TESTS OFF CACHE BOOL "Native router has independent wire tests")
+endif()
+add_subdirectory(services)
+if(TARGET native_host)
+  add_library(native_services_bridge STATIC ipc_bridge.cpp)
+  target_link_libraries(native_services_bridge PUBLIC native_host native_services_router)
+  add_executable(native_ipc_test "${SOURCE_ROOT}/tests/native_platform/ipc_integration.cpp")
+  target_link_libraries(native_ipc_test PRIVATE native_services_bridge)
+  if(MSVC)
+    target_link_options(native_ipc_test PRIVATE "/MAP:${CMAKE_CURRENT_BINARY_DIR}/native_ipc_test.map")
+  endif()
+endif()
+# Optional real static CPU diagnostic. No game archive or generated game code is copied into source.
+set(NATIVE_REAL_LIBS "" CACHE PATH "Authenticated existing four-module static archives")
+set(NATIVE_REAL_RUNTIME "" CACHE PATH "Existing matching generated FPX1 runtime C/header")
+if(NATIVE_REAL_LIBS AND NATIVE_REAL_RUNTIME)
+  if(NOT NATIVE_LZ4_LIBRARY)
+    message(FATAL_ERROR "Real NSO loading requires an explicitly supplied existing LZ4 library")
+  endif()
+  add_library(native_boot_runtime STATIC "${NATIVE_REAL_RUNTIME}/recomp_runtime.c")
+  target_include_directories(native_boot_runtime PUBLIC "${NATIVE_REAL_RUNTIME}")
+  target_compile_definitions(native_boot_runtime PRIVATE SUYU_HOSTED_RECOMP=1 RECOMP_STATIC_HOST=1)
+  add_library(native_boot_host STATIC host.cpp address_space.cpp nso.cpp relocations.cpp ipc_bridge.cpp)
+  target_include_directories(native_boot_host PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}" "${NATIVE_REAL_RUNTIME}")
+  target_compile_definitions(native_boot_host PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN PRIVATE NATIVE_HAVE_LZ4=1)
+  target_link_libraries(native_boot_host PUBLIC "${NATIVE_LZ4_LIBRARY}" bcrypt native_services_router)
+  add_executable(native_boot boot.cpp)
+  target_link_libraries(native_boot PRIVATE native_boot_host native_boot_runtime)
+  foreach(module rtld main subsdk0 sdk)
+    add_library(native_guest_${module} STATIC IMPORTED)
+    set_target_properties(native_guest_${module} PROPERTIES IMPORTED_LOCATION "${NATIVE_REAL_LIBS}/recomp_static_${module}.lib")
+    target_link_libraries(native_boot PRIVATE native_guest_${module})
+  endforeach()
+  if(MSVC)
+    target_link_options(native_boot PRIVATE /NODEFAULTLIB:MSVCRT /INCREMENTAL:NO "/MAP:${CMAKE_CURRENT_BINARY_DIR}/native_boot.map")
+  endif()
+endif()
+
+
