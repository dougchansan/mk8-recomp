+#pragma once
+#include "native_handles.h"
+#include <cstdint>
+#include <memory>
+#include <span>
+#include <stdexcept>
+namespace native {
+namespace detail {
+struct EventWaitState;
+struct EventWaitNode;
+} // namespace detail
+// Actual server-owned manual-reset state. Guests receive only readable handles.
+class NativeEvent final {
+public:
+  explicit NativeEvent(uint64_t process_id);
+  uint64_t OwnerProcessId() const noexcept { return owner_; }
+  bool IsSignaled() const noexcept;
+  void Signal() noexcept;
+  void Clear() noexcept;
+  bool Reset() noexcept;
+
+private:
+  friend struct detail::EventWaitState;
+  const uint64_t owner_;
+  bool signaled_ = false;
+  detail::EventWaitNode *waiters_ = nullptr;
+};
+using EventRef = std::shared_ptr<NativeEvent>;
+class ScopedEventExport {
+public:
+  virtual ~ScopedEventExport() = default;
+  virtual uint32_t Handle() const noexcept = 0;
+  virtual bool Commit() noexcept = 0;
+};
+class EventClock {
+public:
+  virtual ~EventClock() = default;
+  // Monotonic, bounded, nonthrowing; must not reenter event synchronization.
+  virtual uint64_t NowNs() const noexcept = 0;
+};
+enum class EventWaitStatus { Pending, Signaled, TimedOut, Cancelled };
+struct EventWaitOutcome {
+  EventWaitStatus status;
+  int32_t index;
+};
+// Registration never blocks an owner. Signal/timeout/cancel establish one
+// outcome under the shared synchronization lock, including pulses cleared
+// before polling.
+class NativeEventWait final {
+public:
+  class Cancellation {
+  public:
+    Cancellation() = default;
+    bool Cancel() const noexcept;
+
+  private:
+    friend class NativeEventWait;
+    explicit Cancellation(std::shared_ptr<detail::EventWaitState> state)
+        : state_(std::move(state)) {}
+    std::shared_ptr<detail::EventWaitState> state_;
+  };
+  NativeEventWait(std::span<const EventRef>, int64_t timeout_ns,
+                  std::shared_ptr<const EventClock> clock = {},
+                  bool initially_cancelled = false);
+  ~NativeEventWait();
+  NativeEventWait(const NativeEventWait &) = delete;
+  NativeEventWait &operator=(const NativeEventWait &) = delete;
+  EventWaitOutcome Poll() const noexcept;
+  Cancellation CancellationHandle() const noexcept {
+    return Cancellation(state_);
+  }
+
+private:
+  std::shared_ptr<detail::EventWaitState> state_;
+};
+} // namespace native
