@@ -0,0 +1,326 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "cache_index.h"
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <bit>
+#include <cstring>
+#include <limits>
+#include <sstream>
+#include <stdexcept>
+#include <windows.h>
+// clang-format off: bcrypt.h requires Windows SDK types first.
+#include <bcrypt.h>
+// clang-format on
+namespace native_shaders {
+namespace {
+constexpr size_t graphics_key_bytes = 1056, compute_key_bytes = 24;
+struct Reader {
+  std::span<const std::byte> bytes;
+  size_t at = 0;
+  template <class T> T Get() {
+    if (sizeof(T) > bytes.size() - at)
+      throw std::runtime_error("Truncated cache record/key");
+    T v;
+    std::memcpy(&v, bytes.data() + at, sizeof(T));
+    at += sizeof(T);
+    return v;
+  }
+  void Skip(size_t size) {
+    if (size > bytes.size() - at)
+      throw std::runtime_error("Truncated pipeline key");
+    at += size;
+  }
+};
+unsigned Slot(Shader::Stage stage) {
+  return stage == Shader::Stage::VertexA ? 0 : static_cast<unsigned>(stage) + 1;
+}
+template <class T> void Append(std::vector<std::byte> &out, const T &value) {
+  auto p = reinterpret_cast<const std::byte *>(&value);
+  out.insert(out.end(), p, p + sizeof(value));
+}
+void Check(NTSTATUS code) {
+  if (code < 0)
+    throw std::runtime_error("System SHA256 provider failed");
+}
+} // namespace
+std::string CacheIndex::Sha256(std::span<const std::byte> bytes) {
+  if (bytes.size() > ULONG_MAX)
+    throw std::runtime_error("SHA256 input too large");
+  BCRYPT_ALG_HANDLE algorithm{};
+  Check(BCryptOpenAlgorithmProvider(&algorithm, BCRYPT_SHA256_ALGORITHM,
+                                    nullptr, 0));
+  struct AlgorithmGuard {
+    BCRYPT_ALG_HANDLE value;
+    ~AlgorithmGuard() { BCryptCloseAlgorithmProvider(value, 0); }
+  } guard{algorithm};
+  DWORD object_size = 0, written = 0;
+  Check(BCryptGetProperty(algorithm, BCRYPT_OBJECT_LENGTH,
+                          reinterpret_cast<PUCHAR>(&object_size),
+                          sizeof(object_size), &written, 0));
+  std::vector<UCHAR> object(object_size);
+  BCRYPT_HASH_HANDLE hash{};
+  Check(BCryptCreateHash(algorithm, &hash, object.data(), static_cast<ULONG>(object.size()),
+                         nullptr, 0, 0));
+  struct HashGuard {
+    BCRYPT_HASH_HANDLE value;
+    ~HashGuard() { BCryptDestroyHash(value); }
+  } hash_guard{hash};
+  if (!bytes.empty())
+    Check(BCryptHashData(
+        hash, reinterpret_cast<PUCHAR>(const_cast<std::byte *>(bytes.data())),
+        static_cast<ULONG>(bytes.size()), 0));
+  std::array<UCHAR, 32> result{};
+  Check(BCryptFinishHash(hash, result.data(), static_cast<ULONG>(result.size()), 0));
+  constexpr char hex[] = "0123456789abcdef";
+  std::string out;
+  for (auto b : result) {
+    out += hex[b >> 4];
+    out += hex[b & 15];
+  }
+  return out;
+}
+CacheIndex CacheIndex::Read(std::span<const std::byte> bytes) {
+  static_assert(std::endian::native == std::endian::little);
+  if (bytes.size() > 64 * 1024 * 1024)
+    throw std::runtime_error("Cache exceeds 64MiB");
+  Reader r{bytes};
+  if (r.Get<u64>() != 0x68636163757a7579ull || r.Get<u32>() != 18)
+    throw std::runtime_error("Unsupported cache magic/version");
+  CacheIndex out;
+  while (r.at < bytes.size()) {
+    if (out.records >= 4096)
+      throw std::runtime_error("Pipeline record count cap");
+    auto count = r.Get<u32>();
+    if (!count || count > 6 || count > 8192 - out.entries.size())
+      throw std::runtime_error("Environment count cap/invalid count");
+    std::vector<CachedEnvironment> record;
+    bool compute = false;
+    unsigned previous = 0;
+    for (u32 i = 0; i < count; ++i) {
+      CachedEnvironment entry;
+      entry.record = out.records;
+      entry.environment = i;
+      entry.file_offset = r.at;
+      entry.snapshot = Snapshot::ReadEnvironment(bytes, r.at);
+      auto stage = entry.snapshot.ShaderStage();
+      if (i == 0)
+        compute = stage == Shader::Stage::Compute;
+      if (compute && (count != 1 || stage != Shader::Stage::Compute) ||
+          !compute && stage == Shader::Stage::Compute)
+        throw std::runtime_error("Compute/graphics cross-stage cache record");
+      if (!compute) {
+        unsigned slot = Slot(stage);
+        if (i && slot <= previous)
+          throw std::runtime_error("Duplicate/out-of-order graphics stages");
+        previous = slot;
+        unsigned expected = stage == Shader::Stage::VertexA
+                                ? 1
+                                : static_cast<unsigned>(stage) + 1;
+        if (entry.snapshot.SPH().common0.shader_type.Value() != expected)
+          throw std::runtime_error(
+              "SPH stage differs from serialized environment");
+      }
+      std::vector<std::byte> metadata;
+      auto &s = entry.snapshot;
+      Append(metadata, s.stage);
+      Append(metadata, s.start_address);
+      Append(metadata, s.lowest);
+      Append(metadata, s.highest);
+      Append(metadata, s.local_size);
+      Append(metadata, s.texture_bound);
+      Append(metadata, s.viewport);
+      Append(metadata, s.shared_size);
+      Append(metadata, s.workgroup);
+      Append(metadata, s.gp_passthrough_mask);
+      Append(metadata, s.sph);
+      const auto append_map = [&](const auto &values) {
+        u64 n = values.size();
+        Append(metadata, n);
+        for (const auto &[key, value] : values) {
+          Append(metadata, key);
+          Append(metadata, value);
+        }
+      };
+      append_map(s.types);
+      append_map(s.formats);
+      append_map(s.cbufs);
+      append_map(s.replacements);
+      entry.metadata_sha256 = Sha256(metadata);
+      entry.code_sha256 = Sha256(std::as_bytes(std::span(s.code)));
+      auto code = std::as_bytes(std::span(s.code));
+      if (!compute)
+        code = code.subspan(80);
+      if (code.empty())
+        throw std::runtime_error("Missing shader instructions");
+      entry.instructions_sha256 = Sha256(code);
+      record.push_back(std::move(entry));
+    }
+    const size_t key_offset = r.at;
+    if (compute) {
+      record[0].declared_shader_hash = r.Get<u64>();
+      auto shared = r.Get<u32>();
+      std::array<u32, 3> group{};
+      for (auto &d : group)
+        d = r.Get<u32>();
+      if (!record[0].declared_shader_hash ||
+          shared != record[0].snapshot.shared_size ||
+          group != record[0].snapshot.workgroup)
+        throw std::runtime_error("Compute key metadata mismatch");
+    } else {
+      std::array<u64, 6> hashes{};
+      for (auto &h : hashes)
+        h = r.Get<u64>();
+      size_t present = 0;
+      for (unsigned slot = 0; slot < 6; ++slot)
+        if (hashes[slot]) {
+          if (present >= record.size() ||
+              Slot(record[present].snapshot.ShaderStage()) != slot)
+            throw std::runtime_error("Graphics key/environment stage mismatch");
+          record[present++].declared_shader_hash = hashes[slot];
+        }
+      if (present != record.size())
+        throw std::runtime_error("Missing graphics stage key");
+      r.Skip(graphics_key_bytes - 48);
+    }
+    for (auto &entry : record) {
+      entry.serialized_pipeline_key.assign(bytes.begin() + key_offset,
+                                           bytes.begin() + r.at);
+      entry.pipeline_key_sha256 = Sha256(entry.serialized_pipeline_key);
+      out.entries.push_back(std::move(entry));
+    }
+    ++out.records;
+  }
+  return out;
+}
+std::span<const std::byte> CacheIndex::Code(size_t entry,
+                                            CapturedCodeLayout layout) const {
+  if (layout != CapturedCodeLayout::SnapshotCode &&
+      layout != CapturedCodeLayout::InstructionsOnly)
+    throw std::runtime_error("Unknown captured code layout");
+  if (entry >= entries.size())
+    throw std::runtime_error("Cache entry out of bounds");
+  auto code = std::as_bytes(std::span(entries[entry].snapshot.code));
+  if (layout == CapturedCodeLayout::InstructionsOnly &&
+      entries[entry].snapshot.ShaderStage() != Shader::Stage::Compute)
+    code = code.subspan(80);
+  return code;
+}
+CacheMatch CacheIndex::MatchComplete(Shader::Stage stage,
+                                     std::span<const std::byte> captured,
+                                     CapturedCodeLayout layout,
+                                     std::string_view required_metadata) const {
+  if (layout != CapturedCodeLayout::SnapshotCode &&
+      layout != CapturedCodeLayout::InstructionsOnly)
+    throw std::runtime_error("Unknown captured code layout");
+  if (static_cast<u32>(stage) > 6 || captured.empty() || captured.size() % 8 ||
+      captured.size() > 0x100008)
+    throw std::runtime_error("Invalid complete captured code stage/extent");
+  if (!required_metadata.empty() &&
+      (required_metadata.size() != 64 ||
+       required_metadata.find_first_not_of("0123456789abcdef") !=
+           std::string_view::npos))
+    throw std::runtime_error("Invalid required metadata digest");
+  auto digest = Sha256(captured);
+  CacheMatch match;
+  std::string identity;
+  for (size_t i = 0; i < entries.size(); ++i) {
+    const auto &entry = entries[i];
+    if (entry.snapshot.ShaderStage() != stage ||
+        (!required_metadata.empty() &&
+         entry.metadata_sha256 != required_metadata))
+      continue;
+    const auto &expected = layout == CapturedCodeLayout::SnapshotCode
+                               ? entry.code_sha256
+                               : entry.instructions_sha256;
+    if (expected != digest)
+      continue;
+    auto code = Code(i, layout);
+    if (code.size() != captured.size() ||
+        !std::equal(code.begin(), code.end(), captured.begin()))
+      continue;
+    if (match.identical_aliases.empty()) {
+      match.canonical_entry = i;
+      identity = entry.metadata_sha256;
+    } else if (identity != entry.metadata_sha256)
+      throw std::runtime_error(
+          "Ambiguous complete shader code: distinct metadata environments");
+    match.identical_aliases.push_back(i);
+  }
+  if (match.identical_aliases.empty())
+    throw std::runtime_error("Complete shader/stage/metadata match missing");
+  return match;
+}
+std::string CacheIndex::MetadataJson(size_t index) const {
+  if (index >= entries.size())
+    throw std::runtime_error("Cache entry metadata index out of bounds");
+  auto &e = entries[index];
+  auto &s = e.snapshot;
+  std::ostringstream out;
+  out << "{\"record\":" << e.record << ",\"environment\":" << e.environment
+      << ",\"file_offset\":" << e.file_offset << ",\"stage\":" << u32(s.stage)
+      << ",\"declared_shader_hash\":" << e.declared_shader_hash
+      << ",\"code_bytes\":" << s.code.size() * 8 << ",\"instructions_bytes\":"
+      << Code(index, CapturedCodeLayout::InstructionsOnly).size()
+      << ",\"code_sha256\":\"" << e.code_sha256
+      << "\",\"instructions_sha256\":\"" << e.instructions_sha256
+      << "\",\"metadata_sha256\":\"" << e.metadata_sha256
+      << "\",\"start_address\":" << s.start_address
+      << ",\"lowest\":" << s.lowest << ",\"highest\":" << s.highest
+      << ",\"local_memory_size\":" << s.local_size
+      << ",\"texture_bound_buffer\":" << s.texture_bound
+      << ",\"viewport_transform\":" << s.viewport
+      << ",\"shared_memory_size\":" << s.shared_size << ",\"workgroup\":["
+      << s.workgroup[0] << ',' << s.workgroup[1] << ',' << s.workgroup[2]
+      << "],\"geometry_passthrough_mask\":[";
+  for (size_t i = 0; i < 8; ++i) {
+    if (i)
+      out << ',';
+    out << s.gp_passthrough_mask[i];
+  }
+  out << "],\"program_header_hex\":\"";
+  constexpr char hex[] = "0123456789abcdef";
+  for (auto b : std::as_bytes(std::span(&s.sph, 1))) {
+    auto v = std::to_integer<unsigned>(b);
+    out << hex[v >> 4] << hex[v & 15];
+  }
+  out << "\"";
+  auto map = [&](const char *name, const auto &values) {
+    out << ",\"" << name << "\":[";
+    bool comma = false;
+    for (const auto &[key, value] : values) {
+      if (comma)
+        out << ',';
+      comma = true;
+      out << "{\"key\":" << key << ",\"value\":" << static_cast<u64>(value)
+          << '}';
+    }
+    out << ']';
+  };
+  map("texture_types", s.types);
+  map("texture_pixel_formats", s.formats);
+  map("cbuf_words", s.cbufs);
+  map("cbuf_replacements", s.replacements);
+  out << ",\"pipeline_key_sha256\":\"" << e.pipeline_key_sha256
+      << "\",\"pipeline_key_hex\":\"";
+  for (auto b : e.serialized_pipeline_key) {
+    auto v = std::to_integer<unsigned>(b);
+    out << hex[v >> 4] << hex[v & 15];
+  }
+  out << "\",\"catalog_only_pixel_format_ordinals\":[";
+  bool comma = false;
+  for (auto [handle, format] : s.formats)
+    if (u32(format) >= 95) {
+      if (comma)
+        out << ',';
+      comma = true;
+      out << u32(format);
+    }
+  out << "]}";
+  return out.str();
+}
+
+} // namespace native_shaders
