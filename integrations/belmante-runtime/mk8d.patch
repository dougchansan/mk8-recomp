+inline int native_record_capacity_bench() {
+    using namespace nx;
+    using namespace nx::nvn;
+    unsigned checks=0;
+    auto check=[&](bool value){++checks;if(!value)throw std::runtime_error("record capacity assertion "+std::to_string(checks));};
+    memory_init();
+    auto alloc=[](uint64_t bytes){const auto p=kernel_alloc(bytes,4096);vm_set(p,bytes,kMemHeap,3);return p;};
+    const auto device=alloc(7008);check(initialize_native_device(device,0));
