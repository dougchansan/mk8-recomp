new file mode 100644
index 0000000000000000000000000000000000000000..6167750995adf91af2dcfa4be04f2a59f2ff277f
--- /dev/null
+++ b/tests/native_platform/README.md
@@ -0,0 +1,7 @@
+# Native platform Stage A/B tests
+
+Use `run.py --build PATH`. The build entrypoint is the independent `native-runtime/CMakeLists.txt`; it never configures the suyu root project. The tests use real emitted static module C code and one shared runtime.
+
+Expected negative subprocesses print `FAIL` and exit 1 (malformed inputs), or reject a changed instruction through the existing guard and exit 86. The runner checks these exact statuses. The final PASS line therefore includes those deliberate rejections.
+
+On Windows, `dependencies.txt` and the link map provide the independent link-boundary evidence. Only OS DLL dependencies are allowed; generated data, executables and private fixture mutations remain under the supplied build directory.
diff --git a/tests/native_platform/admit.cpp b/tests/native_platform/admit.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c2e8415b4826bc390da1d19c816d182ef82a762e
--- /dev/null
+++ b/tests/native_platform/admit.cpp
@@ -0,0 +1,43 @@
+#include "nso.h"
+#include <iostream>
+#include <stdexcept>
+using namespace native;
+int main(int argc, char **argv) {
+  try {
+    if (argc != 2)
+      return 2;
+    std::filesystem::path exefs = argv[1];
+    AddressSpace space;
+    std::vector<BootModule> modules;
+    uint64_t base = 0x80000000;
+    for (const char *name : {"rtld", "main", "subsdk0", "sdk"}) {
+      auto image = load_nso(exefs / name);
+      map_nso(space, image, base);
+      std::cout << name << " base=0x" << std::hex << base << " image_size=0x"
+                << image.image_size << " build_id=" << build_id_hex(image)
+                << std::dec << "\n";
+      base += image.image_size;
+      modules.push_back({base - image.image_size, std::move(image)});
+    }
+    std::vector<RelocationRecord> audit;
+    auto count = relocate_rtld(space, modules, &audit);
+    unsigned weak = 0;
+    for (const auto &record : audit)
+      if (record.weak_null) {
+        ++weak;
+        std::cout << "weak-null symbol=" << record.symbol << " target=0x"
+                  << std::hex << record.address << " value=0x" << record.value
+                  << std::dec << "\n";
+      }
+
+    std::cout << "ADMITTED modules=" << modules.size()
+              << " regions=" << space.region_count()
+              << " committed_bytes=" << space.committed_bytes()
+              << " rtld_relocations=" << count << " weak_null=" << weak
+              << "; no guest execution\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << "REJECTED " << e.what() << "\n";
+    return 1;
+  }
+}
