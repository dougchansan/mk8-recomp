+   read_exact(u64(h,24),dirs_);read_exact(u64(h,56),files_);
+   visit_dir(0,"",0,0);
+  }catch(...){std::fclose(file_);file_=nullptr;throw;}
+ }
+ ~RomfsImage(){if(file_)std::fclose(file_);}
+ RomfsImage(const RomfsImage&)=delete;
+ RomfsImage& operator=(const RomfsImage&)=delete;
+ const Entry* find(const std::string& path) const {
+  const auto it=entries_.find(path);return it==entries_.end()?nullptr:&it->second;
+ }
+ const std::map<std::string,Entry>& entries()const{return entries_;}
+ uint64_t read(const Entry& entry,uint64_t off,std::span<uint8_t> dst) {
+  if(entry.directory || off>entry.size)throw std::runtime_error("RomFS file read offset");
+  const auto count=std::min<uint64_t>(dst.size(),entry.size-off);
+  std::lock_guard lk(lock_);read_exact(entry.offset+off,dst.first(size_t(count)));return count;
+ }
+private:
+ FILE* file_{};uint64_t size_{},data_{};std::mutex lock_;
+ std::vector<uint8_t> dirs_,files_;std::set<uint32_t> seen_dirs_,seen_files_;
+ std::map<std::string,Entry> entries_;
+ static void range(uint64_t p,uint64_t n,uint64_t size){if(p>size || n>size-p)throw std::runtime_error("RomFS extent outside backing");}
+ static uint32_t u32(std::span<const uint8_t> b,size_t p){range(p,4,b.size());uint32_t v=0;for(unsigned i=0;i<4;++i)v|=uint32_t(b[p+i])<<(8*i);return v;}
+ static uint64_t u64(std::span<const uint8_t> b,size_t p){range(p,8,b.size());return uint64_t(u32(b,p))|(uint64_t(u32(b,p+4))<<32);}
+ void seek(int64_t off,int origin){
+#ifdef _WIN32
+  if(_fseeki64(file_,off,origin))throw std::runtime_error("RomFS seek failed");
+#else
+  if(fseeko(file_,off,origin))throw std::runtime_error("RomFS seek failed");
+#endif
+ }
+ uint64_t tell(){
+#ifdef _WIN32
+  auto p=_ftelli64(file_);
+#else
+  auto p=ftello(file_);
+#endif
+  if(p<0)throw std::runtime_error("RomFS size failed");return uint64_t(p);
+ }
+ void read_exact(uint64_t off,std::span<uint8_t> dst){range(off,dst.size(),size_);if(off>INT64_MAX)throw std::runtime_error("RomFS signed seek");seek(int64_t(off),SEEK_SET);if(!dst.empty()&&std::fread(dst.data(),1,dst.size(),file_)!=dst.size())throw std::runtime_error("short RomFS read");}
