+void TestDomainRegistry() {
+    struct TreeState { unsigned live=0,commits=0;std::vector<uint32_t> inputs; } state;
+    class Tree final:public Endpoint {
+        TreeState& state_;
+    public:
+        explicit Tree(TreeState& s):state_(s){++state_.live;}
+        ~Tree() override {--state_.live;}
+        bool AcceptsDomainObjects() const override {return true;}
+        Reply Prepare(const native_services::Request& r) override {
+            if(r.command==0) {
+                Reply reply;reply.status=Status::Ok;reply.moved_endpoint=std::make_unique<Tree>(state_);return reply;
+            }
+            if(r.command==7) {
+                const std::vector<uint32_t> inputs(r.incoming_domain_objects.begin(),r.incoming_domain_objects.end());
+                return {Status::Ok,0,{std::byte{0x5a}},{},[this,inputs]{++state_.commits;state_.inputs=inputs;},nullptr};
+            }
+            return {Status::Unsupported,0,{},"tree unsupported",{},nullptr};
+        }
+    };
+    Router r(42);Memory m;
+    CHECK(r.Register("tree",[&]{return std::make_unique<Tree>(state);}));
+    const auto sm=r.Connect("sm:").handle;Init(r,m,sm);
+    m.Request(1,false,"tree");CHECK(r.Send(sm,m.Bus(),0x1000,42).status==Status::Ok);
+    const auto session=m.Get(12);CHECK(state.live==1);
+    m.Request(0);m.Put(0,5);m.writable=false;auto before=m.bytes;
+    CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::MemoryFault && before==m.bytes && state.live==1);
+    m.writable=true;m.Request(7);
+    CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::Ok && state.commits==1);
+    m.Request(0);m.Put(0,5);CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::Ok);
+    const auto root=m.Get(32);CHECK(root!=0);
+    m.Request(0);m.Put(0,5);before=m.bytes;
+    CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::InvalidState && before==m.bytes);
+    m.DomainRequest(root,0);m.writable=false;
+    CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::MemoryFault && state.live==1);
+    m.writable=true;m.DomainRequest(root,0);CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::Ok);
+    CHECK(!(m.Get(4)&0x80000000u) && m.Get(16)==1 && m.Get(32)==0x4f434653 && m.Get(40)==0);
+    const auto child=m.Get(48);CHECK(child==root+1 && state.live==2 && r.SessionCount()==2);
+    m.DomainRequest(child,7);CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::Ok);
+    CHECK(m.Get(16)==0 && m.Get(32)==0x4f434653 && m.bytes[48]==std::byte{0x5a});
+    const std::array ids{root,child};m.DomainRequest(child,7,false,ids);
+    CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::Ok && state.inputs==std::vector<uint32_t>(ids.begin(),ids.end()));
+    const auto commits=state.commits;
+    for(unsigned bad=0;bad<9;++bad) {
+        m.DomainRequest(child,7);
+        if(bad==0)m.Put(20,0);
+        if(bad==1)m.Put(20,0xfeed);
+        if(bad==2)m.Put(16,1|(0xffffu<<16));
+        if(bad==3)m.Put(16,1|(255u<<8)|(16u<<16));
+        if(bad==4)m.Put(28,1); // Context/version not implemented.
+        if(bad==5)m.Put(0,6); // RequestWithContext is not silently a normal request.
+        if(bad==6)m.Put(32,0);
+        if(bad==7) {m.Put(16,2|(16u<<16));} // Close cannot include CMIF data.
+        if(bad==8) {const std::array wrong{0xfeedu};m.DomainRequest(child,7,false,wrong);}
+        before=m.bytes;
+        CHECK(r.Send(session,m.Bus(),0x1000,42).status!=Status::Ok && before==m.bytes);
+        CHECK(state.commits==commits && state.live==2);
+    }
+    std::array<uint32_t,17> too_many;too_many.fill(root);
+    m.DomainRequest(child,7,false,too_many);CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::Malformed);
+    m.DomainRequest(child,7);before=m.bytes;
+    CHECK(r.Send(session,m.Bus(),0x1000,99).status==Status::InvalidProcess && before==m.bytes);
+    m.Request(1,false,"tree");CHECK(r.Send(sm,m.Bus(),0x1000,42).status==Status::Ok);
+    const auto other=m.Get(12);m.Request(0);m.Put(0,5);
+    CHECK(r.Send(other,m.Bus(),0x1000,42).status==Status::Ok && state.live==3);
+    m.DomainRequest(child,7);CHECK(r.Send(other,m.Bus(),0x1000,42).status==Status::InvalidHandle);
+    m.DomainRequest(child,0,true);m.writable=false;
+    CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::MemoryFault && state.live==3);
+    m.writable=true;m.DomainRequest(child,7);CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::Ok);
+    m.DomainRequest(child,0,true);CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::Ok && state.live==2);
+    m.DomainRequest(child,0,true);CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::InvalidHandle);
+    m.DomainRequest(root,0);CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::Ok);
+    const auto next=m.Get(48);CHECK(next==child+1); // Closed IDs are never reused.
+    m.DomainRequest(root,0,true);CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::Ok);
+    m.DomainRequest(next,7);CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::Ok);
+    m.bytes.fill(std::byte{});m.Put(0,2);CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::Ok);
+    CHECK(state.live==1);m.DomainRequest(next,7);
+    CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::SessionClosed);
+    CHECK(r.Close(session).status==Status::Ok && r.Close(other).status==Status::Ok && state.live==0);
+    // The registry bound is enforced without publishing an ID or kernel handle.
+    m.Request(1,false,"tree");CHECK(r.Send(sm,m.Bus(),0x1000,42).status==Status::Ok);
+    const auto bounded=m.Get(12);m.Request(0);m.Put(0,5);
+    CHECK(r.Send(bounded,m.Bus(),0x1000,42).status==Status::Ok);
+    const auto bounded_root=m.Get(32);
+    for(unsigned i=0;i<1023;++i) {
+        m.DomainRequest(bounded_root,0);CHECK(r.Send(bounded,m.Bus(),0x1000,42).status==Status::Ok);
+    }
+    CHECK(state.live==1024 && r.SessionCount()==2);
+    m.DomainRequest(bounded_root,0);before=m.bytes;
+    CHECK(r.Send(bounded,m.Bus(),0x1000,42).status==Status::Exhausted && before==m.bytes && state.live==1024);
+    CHECK(r.Close(bounded).status==Status::Ok && state.live==0);
+}
