+      if (node.next)
+        node.next->previous = &node;
+      node.event->waiters_ = &node;
+      node.linked = true;
+    }
+  }
+};
+} // namespace detail
+NativeEvent::NativeEvent(uint64_t pid) : owner_(pid) {
+  if (!pid)
+    throw std::invalid_argument("event process ownership unavailable");
+}
+bool NativeEvent::IsSignaled() const noexcept {
+  std::lock_guard lock(synchronization);
+  return signaled_;
+}
+void NativeEvent::Signal() noexcept {
+  std::lock_guard lock(synchronization);
+  signaled_ = true;
+  while (waiters_)
+    waiters_->state->Notify(this);
+}
+void NativeEvent::Clear() noexcept {
+  std::lock_guard lock(synchronization);
+  signaled_ = false;
+}
+bool NativeEvent::Reset() noexcept {
+  std::lock_guard lock(synchronization);
+  bool old = signaled_;
+  signaled_ = false;
