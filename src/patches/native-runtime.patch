diff --git a/tests/native_api/README.md b/tests/native_api/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..f9dde858d44774d939ec878fc6ce2bf19dd28bd7
--- /dev/null
+++ b/tests/native_api/README.md
@@ -0,0 +1,55 @@
+# Whole API v2 fixtures
+
+Run `python run.py --build <private-build-directory>` in an MSVC-enabled shell.
+That command builds but does not run the GPU-backed `buffer_init_test`.
+Coordinate with the replay owner before running that executable separately.
+
+The emitter fixture is an owned synthetic three-block boolean function, not game
+instructions or title addresses. It proves full-block range matching, closed
+control flow, identity mismatch/default-off output preservation, all five skipped
+word mutations, all interior entries, module-local/direct/host/cross-module entry,
+negotiation, seal revocation, explicit native fault, zero-effect decline and AAPCS
+canaries. Native calls and real dispatch budgets are checked independently; no
+skipped basic blocks are charged. No asynchronous execution is implemented.
+
+V2 descriptors require an exporter-verified full build ID and full text SHA-256,
+complete range words and an operation/signature revision. The exporter must supply
+the verified text digest, not an arbitrary claimed value. At runtime the binding's
+pure attestation must derive identity from the actual verified sealed image,
+immutable executable backing and absence of writable aliases. It must not echo
+the descriptor. Installation/removal, sealing and backing/protection changes
+require quiescent guest threads. Every additional range is guarded uncached after
+attestation and before native effects. The fixture's synthetic seal token models
+that interface; actual host sealing/write-alias enforcement is tested by its
+AddressSpace owner and is not established by this fixture alone.
+
+The v2 profile is synchronous bounded integer-return metadata work only. It
+preserves x18 through x31, v8 through v15 (both halves, a stronger guarantee than
+the minimum ABI), FPCR and FPSR, zero-extends successful x0 to 32 bits and returns
+to the original LR. Volatile registers/NZCV may differ from SDK implementation
+scratch state. A native fault is handled without reference fallback and retains
+its declared fault/partial-memory effects. A declined handler must have no guest
+or native-object effects. Pending jobs, waits, GPU allocation/compilation and SVC
+namespace reuse are unsupported by this capability.
+
+`buffer_init_test` builds an actual native Vulkan pool once, then exercises only
+bounded logical view bookkeeping per API call. `BufferInitializer` uses a separate
+pure NORMAL-owned-RAM probe/peek before any observable reads/writes. Unsupported
+ownership, inaccessible probe, output/builder/pool alias and unrecognized ranges
+decline with no callback/fault/memory effects, allowing the original guarded
+comparison function to retain its clear/read-fault order. Inputs and ownership
+metadata are owner-thread/quiescent; concurrent changes are unsupported.
+
+For a supported call the actual callbacks follow three 16-byte clears in descending
+offset order, then pool/flag reads. A forbidden flag returns zero with cleared
+output. Success copies device/pool/offset/size into the public buffer fields and
+returns one. Every actual callback fault position is tested with zero/partial
+writes: no later access or reference fallback occurs, partial guest bytes remain,
+and the native view is rolled back. Reinitialization requires finalization;
+native/reference objects cannot be mixed. Pool object extent is explicit input
+from verified contract evidence, not a guessed default.
+
+These are API-boundary/component proofs. They do not establish actual MK8 API
+hits, MemoryPoolInitialize/DeviceInitialize ownership, native draw submission or
+standalone game completion. Private game metadata and extracted instructions
+remain outside the repository.
diff --git a/tests/native_api/api_test.c b/tests/native_api/api_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..bbe633e34545204238ea3bf389cb6cd613982a3d
--- /dev/null
+++ b/tests/native_api/api_test.c
@@ -0,0 +1,255 @@
+#include "recomp_runtime.h"
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+extern void recomp_image_set_base(uint64_t);
+extern unsigned recomp_image_guard_v2(unsigned);
+extern BlockFn recomp_image_lookup(uint64_t);
+extern void recomp_image_run_slice(GuestContext *);
+extern void recomp_image_set_base_apicaller(uint64_t);
+extern unsigned recomp_image_guard_v2_apicaller(unsigned);
+extern void recomp_image_run_slice_apicaller(GuestContext *);
+static const uint32_t words[] = {0xb4000060, 0x52800020, 0xd65f03c0,
+                                 0x52800000, 0xd65f03c0, 0x17fffffb};
+static int mutation = -1, seal = 1, invoke_count, attests, invoke_mode;
+static GuestContext *active;
+static GuestContext before;
+static RecompHostMem host;
+static void Check(int value, const char *why) {
+  if (!value) {
+    fprintf(stderr, "FAIL %s\n", why);
+    exit(1);
+  }
+}
+static uint64_t Load(void *user, uint64_t address, uint32_t bytes) {
+  uint64_t word;
+  (void)user;
+  Check(!bytes, "only instruction guards read synthetic code");
+  if (address == 0x3000)
+    return UINT64_C(0x1d61f0280);
+  if (address < 0x1000 || address >= 0x1018)
+    return 0;
+  word = words[(address - 0x1000) / 4];
+  if ((int)((address - 0x1000) / 4) == mutation)
+    word ^= 0x20;
+  return word | UINT64_C(0x100000000);
+}
+static int Attest(void *user, const char *build, const char *hash,
+                  uint64_t entry, uint32_t operation, uint32_t signature) {
+  unsigned i;
+  (void)user;
+  ++attests;
+  if (entry != 0x1000 || operation != 17 || signature != 1)
+    return 0;
+  for (i = 0; i < 64; i++)
+    if (build[i] != 'a' || hash[i] != 'b')
+      return 0;
+  return seal;
+}
+static int Invoke(void *user, GuestContext *c, uint32_t operation,
+                  uint32_t signature, uint64_t entry) {
+  unsigned i;
+  (void)user;
+  Check(operation == 17 && signature == 1 && entry == 0x1000,
+        "invoke association");
+  ++invoke_count;
+  if (invoke_mode == 1)
+    return RECOMP_NATIVE_API_DECLINE;
+  if (invoke_mode == 2) {
+    c->halted = 9;
+    return RECOMP_NATIVE_API_FAULT;
+  }
+  c->x[0] = c->x[0] ? UINT64_C(0x100000001) : 0;
+  // Deliberate volatile changes and callee-saved canaries: wrapper must protect
+  // ABI.
+  for (i = 1; i < 32; i++)
+    c->x[i] ^= UINT64_C(0xfedcba9876543210);
+  for (i = 8; i < 16; i++) {
+    c->vreg[i][0] ^= 17;
+    c->vreg[i][1] ^= 29;
+  }
+  c->fpcr = 0;
+  c->fpsr = 0;
+  c->chain_budget = -99;
+  c->pending_svc = 1234;
+  c->n = 0;
+  return RECOMP_NATIVE_API_HANDLED;
+}
+static GuestContext Fresh(uint64_t pc) {
+  GuestContext c;
+  unsigned i;
+  memset(&c, 0, sizeof(c));
+  for (i = 0; i < 32; i++) {
+    c.x[i] = 0x1000 + i;
+    c.vreg[i][0] = i + 9;
+    c.vreg[i][1] = i + 77;
+  }
+  c.pc = pc;
+  c.x[0] = 7;
+  c.x[20] = 0x1000;
+  c.x[30] = 0x5000;
+  c.x[31] = 0x8000;
+  c.fpcr = 123;
+  c.fpsr = 456;
+  c.pending_svc = ~UINT64_C(0);
+  c.chain_budget = 8;
+  c.host_mem = &host;
+  return c;
+}
+static void Abort(int sig) {
+  (void)sig;
+  before.pc = 0x1000 + mutation * 4;
+  _Exit(active && !invoke_count && !recomp_native_api_calls_v2 &&
+                !memcmp(active, &before, sizeof(before))
+            ? 86
+            : 87);
+}
+int main(int argc, char **argv) {
+  RecompNativeApiBindingV2 binding = {2,
+                                      sizeof(binding),
+                                      sizeof(GuestContext),
+                                      0,
+                                      RECOMP_NATIVE_API_LAYOUT_TAG,
+                                      RECOMP_NATIVE_API_SYNC_INT32_AAPCS64 |
+                                          RECOMP_NATIVE_API_CODESEALED,
+                                      0,
+                                      Attest,
+                                      Invoke};
+  GuestContext c;
+  unsigned i, mode;
+  host.load = Load;
+  host.address_space_max = 0x10000;
+  recomp_image_guard_v2(2);
+  recomp_image_set_base(0);
+  recomp_image_guard_v2_apicaller(2);
+  recomp_image_set_base_apicaller(0);
+  if (argc > 1) {
+    mutation = atoi(argv[1]);
+    signal(SIGABRT, Abort);
+    Check(recomp_native_api_bind_v2(&binding), "bind");
+    c = Fresh(0x1000);
+    active = &c;
+    before = c;
+    recomp_image_lookup(c.pc)(&c);
+    return 88;
+  }
+  for (mode = 0; mode < 12; mode++) {
+    RecompNativeApiBindingV2 invalid = binding;
+    seal = 1;
+    invoke_count = attests = 0;
+    recomp_native_api_calls_v2 = 0;
+    if (mode == 0)
+      Check(recomp_native_api_bind_v2(0), "unbind");
+    if (mode == 1) {
+      invalid.revision = 1;
+      Check(!recomp_native_api_bind_v2(&invalid), "revision");
+    }
+    if (mode == 2) {
+      invalid.context_size--;
+      Check(!recomp_native_api_bind_v2(&invalid), "context size");
+    }
+    if (mode == 3) {
+      invalid.layout_tag++;
+      Check(!recomp_native_api_bind_v2(&invalid), "layout");
+    }
+    if (mode == 4) {
+      invalid.capabilities = 1;
+      Check(!recomp_native_api_bind_v2(&invalid), "seal capability");
+    }
+    if (mode == 5) {
+      invalid.attest = 0;
+      Check(!recomp_native_api_bind_v2(&invalid), "attestation required");
+    }
+    if (mode == 6) {
+      seal = 0;
+      Check(recomp_native_api_bind_v2(&binding), "false seal binding");
+    }
+    if (mode == 7)
+      Check(recomp_native_api_bind_v2(&binding), "valid");
+    if (mode == 8) {
+      invalid.size--;
+      Check(!recomp_native_api_bind_v2(&invalid), "binding size");
+    }
+    if (mode == 9) {
+      invalid.reserved = 1;
+      Check(!recomp_native_api_bind_v2(&invalid), "reserved negotiation");
+    }
+    if (mode == 10) {
+      invalid.invoke = 0;
+      Check(!recomp_native_api_bind_v2(&invalid), "missing handler");
+    }
+    if (mode == 11) {
+      invalid.capabilities |= 4;
+      Check(!recomp_native_api_bind_v2(&invalid), "unknown capability");
+    }
+    c = Fresh(0x1000);
+    before = c;
+    recomp_image_run_slice(&c);
+    Check(c.x[0] == 1 && c.pc == 0x5000, "public API bool/return");
+    Check(c.chain_budget == (mode == 7 ? 8 : 7),
+          "only real block dispatch counted");
+    Check(invoke_count == (mode == 7) &&
+              recomp_native_api_calls_v2 == (mode == 7),
+          "native count separate");
+    for (i = 18; i < 32; i++)
+      Check(c.x[i] == before.x[i], "callee-saved/SP/LR/platform register");
+    Check(c.fpcr == before.fpcr && c.fpsr == before.fpsr, "FP state");
+    for (i = 8; i < 16; i++)
+      Check(!memcmp(c.vreg[i], before.vreg[i], 16), "preserved SIMD");
+  }
+  Check(recomp_native_api_bind_v2(&binding), "restore valid binding");
+  for (i = 0; i < 4; i++) {
+    c = Fresh(0x1004 + i * 4);
+    invoke_count = attests = 0;
+    recomp_image_lookup(c.pc)(&c);
+    Check(!invoke_count && !attests && c.pc == 0x5000, "interior bypass");
+  }
+  c = Fresh(0x1014);
+  invoke_count = 0;
+  recomp_image_run_slice(&c);
+  Check(invoke_count == 1 && c.chain_budget == 7 && c.pc == 0x5000,
+        "module-local direct caller reaches canonical API once");
+  c = Fresh(0x3000);
+  invoke_count = 0;
+  recomp_image_run_slice_apicaller(&c);
+  Check(c.pc == 0x1000 && !invoke_count, "crossmodule guest pointer");
+  recomp_image_run_slice(&c);
+  Check(invoke_count == 1 && c.chain_budget == 8 && c.pc == 0x5000,
+        "crossmodule API once no fabricated work");
+  seal = 0;
+  c = Fresh(0x1000);
+  invoke_count = 0;
+  recomp_native_api_calls_v2 = 0;
+  recomp_image_run_slice(&c);
+  Check(!invoke_count && !recomp_native_api_calls_v2 && c.chain_budget == 7,
+        "seal revocation checked each call");
+  seal = 1;
+  invoke_mode = 1;
+  c = Fresh(0x1000);
+  invoke_count = 0;
+  recomp_image_run_slice(&c);
+  Check(invoke_count == 1 && !recomp_native_api_calls_v2 && c.x[0] == 1 &&
+            c.chain_budget == 7,
+        "zero-effect handler decline retains original");
+  invoke_mode = 2;
+  c = Fresh(0x1000);
+  invoke_count = 0;
+  recomp_native_api_faults_v2 = 0;
+  recomp_image_run_slice(&c);
+  Check(invoke_count == 1 && c.halted == 9 && c.pc == 0x1000 &&
+            c.chain_budget == 8 && recomp_native_api_calls_v2 == 1 &&
+            recomp_native_api_faults_v2 == 1,
+        "fault handled once without original fallback");
+  invoke_mode = 0;
+  c = Fresh(0x1000);
+  c.pending_svc = 3;
+  before = c;
+  invoke_count = 0;
+  recomp_image_run_slice(&c);
+  Check(!invoke_count && !memcmp(&c, &before, sizeof(c)),
+        "pending SVC remains bounded boundary");
+  puts(
+      "v2 ABI/seal/fallback/interior/local/host/crossmodule/accounting passed");
+  return 0;
+}
diff --git a/tests/native_api/buffer_init_test.cpp b/tests/native_api/buffer_init_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5863d80710c4bfbbe3325d55567418b70e00e2b9
--- /dev/null
+++ b/tests/native_api/buffer_init_test.cpp
@@ -0,0 +1,191 @@
+#include "buffer_init.h"
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+using namespace native_nvn;
+namespace {
+struct Event {
+  uint64_t address;
+  size_t size;
+  bool write;
+  std::array<std::byte, 16> bytes;
+};
+struct Memory {
+  std::array<std::byte, 131072> bytes{};
+  std::vector<Event> events;
+  int fail = -1;
+  bool partial = false, probe_fail = false, peek_fail = false;
+  static bool Probe(void *user, uint64_t a, size_t n, bool) {
+    auto &m = *static_cast<Memory *>(user);
+    return !m.probe_fail && a <= m.bytes.size() && n <= m.bytes.size() - a;
+  }
+  static bool Peek(void *user, uint64_t a, std::span<std::byte> out) {
+    auto &m = *static_cast<Memory *>(user);
+    if (m.peek_fail || !Probe(user, a, out.size(), false))
+      return false;
+    std::copy_n(m.bytes.begin() + a, out.size(), out.begin());
+    return true;
+  }
+  static bool Read(void *user, uint64_t a, std::span<std::byte> out) {
+    auto &m = *static_cast<Memory *>(user);
+    Event event{a, out.size(), false, {}};
+    std::copy_n(m.bytes.begin() + a, out.size(), event.bytes.begin());
+    m.events.push_back(event);
+    if (int(m.events.size()) - 1 == m.fail)
+      return false;
+    std::copy_n(m.bytes.begin() + a, out.size(), out.begin());
+    return true;
+  }
+  static bool Write(void *user, uint64_t a, std::span<const std::byte> in) {
+    auto &m = *static_cast<Memory *>(user);
+    Event event{a, in.size(), true, {}};
+    std::copy(in.begin(), in.end(), event.bytes.begin());
+    m.events.push_back(event);
+    const bool fail = int(m.events.size()) - 1 == m.fail;
+    const auto n = fail ? (m.partial ? in.size() / 2 : 0) : in.size();
+    std::copy_n(in.begin(), n, m.bytes.begin() + a);
+    return !fail;
+  }
+};
+void Check(bool condition, const char *reason) {
+  if (!condition)
+    throw std::runtime_error(reason);
+}
+void Put(Memory &m, uint64_t address, uint64_t value) {
+  for (unsigned i = 0; i < 8; i++)
+    m.bytes[address + i] = std::byte(value >> (i * 8));
+}
+uint64_t Get(const Memory &m, uint64_t address) {
+  uint64_t value = 0;
+  for (unsigned i = 0; i < 8; i++)
+    value |= uint64_t(m.bytes[address + i]) << (i * 8);
+  return value;
+}
+} // namespace
+int main() {
+  try {
+    Memory memory;
+    GuestMemory backing{&memory, Memory::Peek, Memory::Write};
+    Resources resources(backing);
+    resources.CreateDevice(0x1000);
+    resources.CreatePool(0x2000, {0x1000, 0x10000, 4096, CpuAccess::Cached});
+    BufferInitializer initializer(
+        resources,
+        {&memory, Memory::Probe, Memory::Peek, Memory::Read, Memory::Write});
+    initializer.RegisterPool(0x2000, 0x1000, 4096, 64);
+    Put(memory, 0x4000, 0x1000);
+    Put(memory, 0x4008, 0x2000);
+    Put(memory, 0x4010, 64);
+    Put(memory, 0x4018, 128);
+    std::fill_n(memory.bytes.begin() + 0x3000, 48, std::byte{0xaa});
+    const auto original = memory.bytes;
+    memory.events.clear();
+    auto result = initializer.Initialize(0x3000, 0x4000);
+    Check(result.outcome == BufferInitOutcome::Success && result.value == 1,
+          "successful native init");
+    Check(Get(memory, 0x3000) == 0 && Get(memory, 0x3008) == 0x1000 &&
+              Get(memory, 0x3010) == 0x2000 && Get(memory, 0x3018) == 64 &&
+              Get(memory, 0x3020) == 128 && Get(memory, 0x3028) == 0,
+          "guest fields");
+    Check(resources.Binding(0x3000).offset == 64 &&
+              resources.Binding(0x3000).size == 128,
+          "real native view ownership");
+    const auto successful = memory.events;
+    Check(successful.size() == 13, "bounded exact access sequence");
+    for (unsigned i = 0; i < 3; i++)
+      Check(successful[i].write && successful[i].size == 16 &&
+                successful[i].address == 0x3020 - i * 16,
+            "clear instruction order");
+    const auto after = memory.bytes;
+    memory.events.clear();
+    result = initializer.Initialize(0x3000, 0x4000);
+    Check(result.outcome == BufferInitOutcome::Decline &&
+              memory.events.empty() && memory.bytes == after,
+          "duplicate declines without effects");
+    initializer.Finalize(0x3000);
+    unsigned faults = 0;
+    for (unsigned i = 0; i < successful.size(); i++)
+      for (bool partial : {false, true}) {
+        memory.bytes = original;
+        memory.events.clear();
+        memory.fail = int(i);
+        memory.partial = partial;
+        result = initializer.Initialize(0x3000, 0x4000);
+        Check(result.outcome == BufferInitOutcome::Fault &&
+                  memory.events.size() == i + 1,
+              "fault does not fall back or execute later accesses");
+        auto expected = original;
+        for (unsigned j = 0; j <= i; j++)
+          if (successful[j].write) {
+            auto n = successful[j].size;
+            if (j == i)
+              n = partial ? n / 2 : 0;
+            std::copy_n(successful[j].bytes.begin(), n,
+                        expected.begin() + successful[j].address);
+          }
+        Check(memory.bytes == expected, "declared partial-write effects");
+        bool stale = false;
+        try {
+          resources.Binding(0x3000);
+        } catch (const std::runtime_error &) {
+          stale = true;
+        }
+        Check(stale, "native object rollback");
+        ++faults;
+      }
+    memory.fail = -1;
+    memory.bytes = original;
+    memory.bytes[0x2011] = std::byte{1};
+    memory.events.clear();
+    result = initializer.Initialize(0x3000, 0x4000);
+    Check(result.outcome == BufferInitOutcome::Failure && result.value == 0 &&
+              memory.events.size() == 5,
+          "pool flag failure");
+    Check(std::all_of(memory.bytes.begin() + 0x3000,
+                      memory.bytes.begin() + 0x3030,
+                      [](std::byte b) { return b == std::byte{}; }),
+          "failure clears output");
+    unsigned declines = 0;
+    for (unsigned mode = 0; mode < 7; mode++) {
+      memory.bytes = original;
+      memory.events.clear();
+      memory.probe_fail = mode == 0;
+      memory.peek_fail = mode == 1;
+      uint64_t output = mode == 2   ? 0x4000
+                        : mode == 3 ? 0x2000
+                        : mode == 4 ? 0x3001
+                                    : 0x3000;
+      if (mode == 5)
+        Put(memory, 0x4008, 0x2500);
+      if (mode == 6)
+        Put(memory, 0x4018, 4097);
+      const auto before = memory.bytes;
+      result = initializer.Initialize(output, 0x4000);
+      Check(result.outcome == BufferInitOutcome::Decline &&
+                memory.events.empty() && memory.bytes == before,
+            "preflight/alias/ownership decline zero effects");
+      ++declines;
+    }
+    memory.probe_fail = memory.peek_fail = false;
+    memory.bytes = original;
+    memory.events.clear();
+    Check(initializer.Initialize(0x3000, 0x4000).outcome ==
+              BufferInitOutcome::Success,
+          "key reuse after rollback/finalize");
+    initializer.Finalize(0x3000);
+    initializer.UnregisterPool(0x2000);
+    resources.DestroyPool(0x2000);
+    resources.DestroyDevice(0x1000);
+    std::cout << "{\"passed\":true,\"actual_native_pool\":true,\"success_"
+                 "accesses\":13,\"fault_cases\":"
+              << faults << ",\"zero_effect_declines\":" << declines
+              << ",\"fake_block_charges\":0}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
