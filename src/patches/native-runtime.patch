+    }
+  }
+  void RetireImages(bool forever) {
+    for (auto &i : images)
+      if (i.present_pending) {
+        if (!Wait(i.present, forever) && !device_lost)
+          throw std::runtime_error(
+              "Presentation retirement timeout; references retained");
+        i.present_pending = false;
+        if (!device_lost)
