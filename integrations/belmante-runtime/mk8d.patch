+    c.x[0]=cb;api("nvnCommandBufferFinalize");c.x[0]=pool_key;api("nvnMemoryPoolFinalize");
+    std::cout<<"native record capacity checks="<<checks<<" records="<<records<<" checksum="<<checksum
+             <<" wall_ns="<<wall<<" cycles="<<cycles<<" cycle_samples="<<cycle_samples<<" PASS\n";
+    return 0;
+}
