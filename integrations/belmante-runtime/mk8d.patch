+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "native_call_phase.h"
+#include "kernel.h"
+#include <cstring>
+#include <cstdio>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+namespace authored_call_phase {
+inline uint64_t root_target{}, child_target{}, leaf_target{};
+inline unsigned root_calls{}, child_calls{}, leaf_calls{};
+inline bool should_throw = false;
+inline bool callbacks = false;
+inline uint64_t callback_objects{};
+inline void leaf(nx::CPU& c) { ++leaf_calls; c.x[2] = 0x8765; }
+inline void child(nx::CPU& c) {
+    ++child_calls;
+    // The nested leaf retains LR but has a different target: no false phase.
+    nx::call(c, leaf_target);
+    nx::g_frame = 100;  // A phase completion must survive sampling-window end.
+    if (should_throw) throw std::runtime_error("authored phase throw");
+    c.x[1] = 0x4321;
+}
+inline void root(nx::CPU& c) {
+    ++root_calls;
+    c.x[30] = 0x200;
+    nx::call(c, child_target);
+    if (callbacks) for (unsigned i = 0; i <= 140; ++i) {
+        c.x[0] = callback_objects + (i % 140) * 16;
+        c.x[30] = 0x200;
+        nx::call(c, leaf_target);
+    }
+    c.x[0] = 0xabcd;
+}
+inline int run(bool callback_probe = false) {
+    using namespace nx::call_phase;
+    unsigned checks = 0;
+    auto check = [&](bool ok) { ++checks; if (!ok) throw std::runtime_error("call phase assertion " + std::to_string(checks)); };
+    Sites sites;
+    check(parse("0x100:200,300:0x400", sites) && sites.count == 2);
+    check(sites.values[0].caller == 0x100 && sites.values[1].target == 0x400);
+    for (const auto text : {"", "100", "100:", ":200", "100:200,", "100:200,100:400", "0:200",
+                           "101:200", "100:201", "100:200:300", "100:200garbage", " 100:200",
+                           "100:fffffffffffffffff", "100:200,300:400,500:600,700:800,900:a00,b00:c00,d00:e00,f00:1000,1100:1200"}) {
+        check(!parse(text, sites));
+        check(sites.count == 2 && sites.values[0].caller == 0x100); // Failure is transactional.
+    }
+    check(sampled(4, 4, 6, 2) && sampled(6, 4, 6, 2));
+    check(!sampled(3, 4, 6, 2) && !sampled(5, 4, 6, 2) && !sampled(7, 4, 6, 2) && !sampled(4, 4, 6, 0));
+    nx::memory_init();
+    nx::create_main_thread(0x4000);
+    auto& cpu = nx::current_cpu();
+    const auto object = nx::kernel_alloc(16, 16);
+    nx::vm_set(object, 16, nx::kMemHeap, 3);
+    nx::st<uint64_t>(object, 0x123400);
+    callbacks = callback_probe;
+    if (callbacks) {
+        callback_objects = nx::kernel_alloc(140 * 16, 16);
+        nx::vm_set(callback_objects, 140 * 16, nx::kMemHeap, 3);
+        for (unsigned i = 0; i < 140; ++i) nx::st<uint64_t>(callback_objects + i * 16, 0x200000 + i * 16);
+    }
+    root_target = nx::hle_address_or("authoredPhaseRoot", root);
+    child_target = nx::hle_address_or("authoredPhaseChild", child);
+    leaf_target = nx::hle_address_or(callbacks ? "nvnCommandBufferDrawAuthoredPhase" : "authoredPhaseLeaf", leaf);
+    auto hex = [](uint64_t value) { char text[32]; std::snprintf(text, sizeof text, "%llx", (unsigned long long)value); return std::string(text); };
+    _putenv_s("NX_CPU_PHASE_PROFILE", "1");
+    _putenv_s("NX_CPU_PHASE_SITES", ("100:" + hex(root_target) + ",200:" + hex(child_target) + ",300:" + hex(leaf_target)).c_str());
+    _putenv_s("NX_CPU_PHASE_START", "0");
+    _putenv_s("NX_CPU_PHASE_STOP", "4");
+    _putenv_s("NX_CPU_PHASE_EVERY", "2");
+    _putenv_s("NX_CPU_PHASE_LIMIT", "2");
+    if (callbacks) _putenv_s("NX_CPU_PHASE_CALLBACK_CALLER", "200");
+    std::array<uint8_t, sizeof(nx::CPU)> before{};
+    nx::CPU expected;
+    std::memcpy(before.data(), &cpu, sizeof cpu);
+    auto invoke = [&](uint64_t frame, uint64_t obj) {
+        std::memcpy(&cpu, before.data(), sizeof cpu);
+        cpu.x[0] = obj;
+        cpu.x[30] = 0x100;
+        nx::g_frame = frame;
+        nx::call(cpu, root_target);
+    };
+    invoke(0, object);
+    const unsigned leaves = callbacks ? 142 : 1;
+    check(root_calls == 1 && child_calls == 1 && leaf_calls == leaves);
+    check(cpu.x[0] == 0xabcd && cpu.x[1] == 0x4321 && cpu.x[2] == 0x8765 && cpu.x[30] == 0x200);
+    std::memcpy(&expected, before.data(), sizeof cpu);
+    // Compare the remaining registers and CPU state, not just return values.
+    expected.x[0] = 0xabcd; expected.x[1] = 0x4321; expected.x[2] = 0x8765; expected.x[30] = 0x200;
+    check(!std::memcmp(&cpu, &expected, sizeof cpu));
+    invoke(0, object); // Same-frame dedup does not suppress the original call.
+    check(root_calls == 2 && child_calls == 2 && leaf_calls == 2 * leaves);
+    invoke(1, object); // Unsampled frame still executes normally.
+    check(root_calls == 3 && child_calls == 3 && leaf_calls == 3 * leaves);
+    should_throw = true;
+    bool threw = false;
+    try { invoke(2, 1); } catch (const std::runtime_error& error) { threw = std::string(error.what()) == "authored phase throw"; }
+    check(threw && root_calls == 4 && child_calls == 4 && leaf_calls == 3 * leaves + 1 && cpu.x[2] == 0x8765);
+    should_throw = false;
+    invoke(4, object); // Cap never changes guest execution.
+    check(root_calls == 5 && child_calls == 5 && leaf_calls == 4 * leaves + 1);
+    std::cout << "native call phase checks=" << checks << " callbacks=" << callbacks << " guest_modules=0 PASS\n";
+    return 0;
+}
+}  // namespace authored_call_phase
