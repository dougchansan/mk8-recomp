+template <class Check> void gpu(uint64_t device, Check check) {
+    using namespace nx;
+    using namespace nx::nvn;
+    namespace R = nx::nvn::recipes;
+    (void)device;
+    const std::vector<uint32_t> vs_words(std::begin(native_point_vertex), std::end(native_point_vertex));
+    const std::vector<uint32_t> fs_words(std::begin(native_point_fragment), std::end(native_point_fragment));
+    std::vector<uint32_t> changed = vs_words;
+    changed.push_back(0x00010000u);  // OpNop: valid, but not the content the recipe was recorded with
+    // Live stages as shader_for would hand them out: set A adopts, B shares A's value, C claims, D is the inline control.
+    static ShaderInfo va, fa, vb, fb, vc, fc, vd, fd;
+    bool ok = false;
+    using Live = std::tuple<ShaderInfo*, const std::vector<uint32_t>*, const char*>;
+    for (auto [s, words, name] : std::initializer_list<Live>{
+             {&va, &vs_words, "recipe-vs"}, {&fa, &fs_words, "recipe-fs"}, {&vb, &vs_words, "recipe-vs"},
+             {&fb, &fs_words, "recipe-fs"}, {&vc, &vs_words, "recipe-vs"}, {&fc, &fs_words, "recipe-fs"},
+             {&vd, &vs_words, "recipe-vs"}, {&fd, &fs_words, "recipe-fs"}})
+        stage(*s, *words, name, ok), check(ok);
+    const std::string dir = plat::data_root();
+    std::remove((dir + "/pipeline_recipes_v1.bin").c_str());
+    auto sources = [&] {
+        return std::vector<std::pair<std::string, std::vector<uint32_t>>>{
+            {"recipe-vs", vs_words}, {"recipe-fs", fs_words}, {"recipe-vs-changed", changed}};
+    };
+    const auto key_address = kernel_alloc(256, 4096);
+    vm_set(key_address, 256, kMemHeap, 3);
+    auto& texture = make<Texture>(key_address);
+    texture.target = 1, texture.width = texture.height = 8, texture.depth = texture.levels = 1, texture.format = 0x25;
+    Targets targets{};
+    targets.color_count = 1, targets.colors[0] = key_address;
+    VkFormat format = VK_FORMAT_UNDEFINED;
+    {
+        std::lock_guard lock(gpu_lock());
+        auto* image = image_of(key_address);
+        check(image != nullptr);
+        format = image->format;
+    }
+    PipelineKey key;
+    std::memset(&key, 0, sizeof key);
+    key.topology = 0, key.point_size = 1, key.polygon.mode = 2, key.color_count = 1, key.color_formats[0] = format;
+    key.mask.mask[0] = 15;
+    auto with = [](PipelineKey k, const ShaderInfo* v, const ShaderInfo* f) { return k.vs = v, k.fs = f, k; };
+    auto recipe = [&](const char* vs_name, const PipelineKey& k) {
+        R::Recipe r;
+        r.vs = {vs_name, R::stage_digest(va)};
+        r.fs = {"recipe-fs", R::stage_digest(fa)};
+        r.state = R::encode_state(k);
+        return r;
+    };
+    PipelineKey stale_key = key, claim_key = key;
+    stale_key.mask.mask[0] = 7;   // distinct values; the changed stage cannot describe this pipeline
+    claim_key.mask.mask[0] = 11;
+
+    // Prewarm: one recipe builds, the one whose stage content changed is rejected.
+    R::configure_for_test(R::Mode::Prewarm, dir, sources());
+    R::enqueue({recipe("recipe-vs", key), recipe("recipe-vs-changed", stale_key)});
+    check(R::wait_idle(20000));
+    R::Counters c = R::counters();
+    check(c.queued == 2 && c.built == 1 && c.rejected == 1 && c.failed == 0 && c.misses == 0);
+    check(c.released_modules == 2);  // the vertex and fragment modules, once the queue drained
+
+    VkPipeline adopted = VK_NULL_HANDLE, stale = VK_NULL_HANDLE;
+    {
+        std::lock_guard lock(gpu_lock());
+        const auto& layout_a = program_layout({&va, &fa});
+        adopted = graphics_pipeline(with(key, &va, &fa), layout_a);
+        c = R::counters();
+        check(adopted != VK_NULL_HANDLE && c.misses == 1 && c.adopted == 1);
+        check(graphics_pipeline(with(key, &va, &fa), layout_a) == adopted && R::counters().misses == 1);  // pointer cache
+        stale = graphics_pipeline(with(stale_key, &va, &fa), layout_a);  // made by the draw itself
+        c = R::counters();
+        check(stale != VK_NULL_HANDLE && stale != adopted && c.misses == 2 && c.adopted == 1);
+        // Other stage objects with the same content and state: the same pipeline.
+        check(graphics_pipeline(with(key, &vb, &fb), program_layout({&vb, &fb})) == adopted && R::counters().adopted == 2);
+    }
+    // Persistence: what this run used, in first-use order, saved atomically and read back.
+    std::string why;
+    check(R::save_now(&why));
+    std::string bytes;
+    std::vector<R::Recipe> saved;
+    check(R::read_whole_file(R::file_path(), bytes, R::kMaxFileBytes) && R::parse(bytes, saved, nullptr, &why));
