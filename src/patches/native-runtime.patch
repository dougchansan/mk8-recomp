+};
+void ValidateSamplerState(const SamplerState &s,
+                          const native_graphics::GraphicsCapabilities &c) {
+  Require(
+      (s.min == TextureFilter::Nearest || s.min == TextureFilter::Linear) &&
+          (s.mag == TextureFilter::Nearest || s.mag == TextureFilter::Linear) &&
+          (s.mip == MipmapFilter::Nearest || s.mip == MipmapFilter::Linear),
+      "Unsupported sampler filter");
+  for (auto a : {s.u, s.v, s.w})
+    Require(a == AddressMode::ClampToEdge || a == AddressMode::Repeat,
+            "Unsupported sampler address mode");
+  Require(std::isfinite(s.min_lod) && std::isfinite(s.max_lod) &&
+              std::isfinite(s.bias) && s.min_lod >= 0 &&
+              s.min_lod <= s.max_lod &&
+              std::abs(s.bias) <= c.max_sampler_lod_bias && s.normalized &&
+              !s.compare && s.anisotropy == 1,
+          "Unsupported sampler LOD/compare/anisotropy/coordinates");
