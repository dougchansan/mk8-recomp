+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "cache_index.h"
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+using namespace native_shaders;
+namespace {
+using Bytes = std::vector<std::byte>;
+template <class T> void Put(Bytes &b, T v) {
+  auto offset = b.size();
+  b.resize(offset + sizeof(v));
+  std::memcpy(b.data() + offset, &v, sizeof(v));
+}
+Bytes Header() {
+  Bytes b;
+  for (char c : std::string("yuzucach"))
+    b.push_back(std::byte(c));
+  Put<u32>(b, 18);
+  return b;
+}
+Bytes Env(Shader::Stage stage, u64 word = 0xe30000000007000full,
+          u32 viewport = 0, bool cbuf = false) {
+  bool compute = stage == Shader::Stage::Compute;
+  Shader::ProgramHeader sph{};
+  u32 sph_word =
+      (stage == Shader::Stage::VertexA ? 1 : static_cast<unsigned>(stage) + 1)
+      << 10;
+  std::memcpy(&sph, &sph_word, 4);
+  Bytes code;
+  if (!compute) {
+    auto p = reinterpret_cast<const std::byte *>(&sph);
+    code.insert(code.end(), p, p + 80);
+  }
+  Put<u64>(code, word);
+  Bytes b;
+  Put<u64>(b, code.size());
+  Put<u64>(b, 0);
+  Put<u64>(b, 0);
+  Put<u64>(b, cbuf ? 1 : 0);
+  Put<u64>(b, 0);
+  Put<u32>(b, 0);
+  Put<u32>(b, 2);
+  Put<u32>(b, 0);
+  Put<u32>(b, 0);
+  Put<u32>(b, code.size() - 8);
+  Put<u32>(b, viewport);
+  Put<u32>(b, static_cast<u32>(stage));
+  b.insert(b.end(), code.begin(), code.end());
+  if (cbuf) {
+    Put<u64>(b, (u64(3) << 32) | 16);
+    Put<u32>(b, 123);
+  }
+  if (compute) {
+    Put<u32>(b, 1);
+    Put<u32>(b, 2);
+    Put<u32>(b, 3);
+    Put<u32>(b, 0);
+  } else {
+    auto p = reinterpret_cast<const std::byte *>(&sph);
+    b.insert(b.end(), p, p + 80);
+    if (stage == Shader::Stage::Geometry)
+      for (unsigned i = 0; i < 8; ++i)
+        Put<u32>(b, i);
+  }
+  return b;
+}
+void Record(Bytes &b,
+            std::initializer_list<std::pair<Shader::Stage, Bytes>> envs,
+            bool missing_key = false) {
+  Put<u32>(b, envs.size());
+  for (auto &e : envs)
+    b.insert(b.end(), e.second.begin(), e.second.end());
+  if (envs.begin()->first == Shader::Stage::Compute) {
+    Put<u64>(b, 99);
+    Put<u32>(b, 0);
+    Put<u32>(b, 1);
+    Put<u32>(b, 2);
+    Put<u32>(b, 3);
+  } else {
+    std::array<u64, 6> hashes{};
+    for (auto &[stage, e] : envs) {
+      unsigned slot = stage == Shader::Stage::VertexA
+                          ? 0
+                          : static_cast<unsigned>(stage) + 1;
+      if(slot<hashes.size())hashes[slot] = 99 + slot;
+    }
+    if (missing_key)
+      hashes = {};
+    for (auto h : hashes)
+      Put<u64>(b, h);
+    b.resize(b.size() + 1008);
+  }
+}
+} // namespace
+int main() {
+  try {
+    unsigned checks = 0, rejections = 0;
+    auto require = [&](bool x) {
+      ++checks;
+      if (!x)
+        throw std::runtime_error("Assertion failed");
+    };
+    auto reject = [&](auto f) {
+      try {
+        f();
+      } catch (const std::exception &) {
+        ++rejections;
+        return;
+      }
+      throw std::runtime_error("Expected rejection absent");
+    };
+    require(CacheIndex::Sha256({}) ==
+            "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
+    std::string abc = "abc";
+    require(CacheIndex::Sha256(std::as_bytes(std::span(abc))) ==
+            "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
+    auto bytes = Header();
+    Record(bytes, {{Shader::Stage::VertexB, Env(Shader::Stage::VertexB)},
+                   {Shader::Stage::Fragment, Env(Shader::Stage::Fragment, 2)}});
+    Record(bytes, {{Shader::Stage::Compute, Env(Shader::Stage::Compute, 3)}});
+    Record(bytes, {{Shader::Stage::Geometry, Env(Shader::Stage::Geometry, 4)}});
+    auto index = CacheIndex::Read(bytes);
+    require(index.RecordCount() == 3 && index.Entries().size() == 4);
+    auto code = index.Code(0, CapturedCodeLayout::SnapshotCode);
+    auto match = index.MatchComplete(Shader::Stage::VertexB, code,
+                                     CapturedCodeLayout::SnapshotCode);
+    require(match.canonical_entry == 0 && match.identical_aliases.size() == 1);
+    require(index.Entries()[2].snapshot.WorkgroupSize() ==
+            std::array<u32, 3>{1, 2, 3});
+    require(index.Entries()[3].snapshot.GpPassthroughMask()[7] == 7);
+    auto instructions = index.Code(0, CapturedCodeLayout::InstructionsOnly);
+    require(index
+                .MatchComplete(Shader::Stage::VertexB, instructions,
+                               CapturedCodeLayout::InstructionsOnly)
+                .canonical_entry == 0);
+    reject([&] {
+      index.MatchComplete(Shader::Stage::Fragment, code,
+                          CapturedCodeLayout::SnapshotCode);
+    });
+    reject([&] {
+      index.MatchComplete(Shader::Stage::VertexB, code.first(code.size() - 8),
+                          CapturedCodeLayout::SnapshotCode);
+    });
+    reject([&] {
+      index.MatchComplete(Shader::Stage::VertexB, {},
+                          CapturedCodeLayout::SnapshotCode);
+    });
+    reject([&] {
+      index.MatchComplete(Shader::Stage::VertexB, code,
+                          CapturedCodeLayout::SnapshotCode, "invalid");
+    });
+    reject([&] {
+      index.MatchComplete(Shader::Stage::VertexB, code,
+                          static_cast<CapturedCodeLayout>(99));
+    });
+    auto corrupt = bytes;
+    corrupt[8] = std::byte{0};
+    reject([&] { CacheIndex::Read(corrupt); });
+    corrupt = bytes;
+    corrupt[12] = std::byte{7};
+    reject([&] { CacheIndex::Read(corrupt); });
+    corrupt = bytes;
+    for (size_t i = 16; i < 24; ++i)
+      corrupt[i] = std::byte{0xff};
+    reject([&] { CacheIndex::Read(corrupt); });
+    corrupt = bytes;
+    for (size_t i = 24; i < 32; ++i)
+      corrupt[i] = std::byte{0xff};
+    reject([&] { CacheIndex::Read(corrupt); });
+    corrupt = bytes;
+    corrupt.pop_back();
+    reject([&] { CacheIndex::Read(corrupt); });
+    auto bad = Header();
+    Record(bad, {{Shader::Stage::Fragment, Env(Shader::Stage::Fragment)},
+                 {Shader::Stage::VertexB, Env(Shader::Stage::VertexB)}});
+    reject([&] { CacheIndex::Read(bad); });
+    bad = Header();
+    Record(bad, {{Shader::Stage::VertexB, Env(Shader::Stage::VertexB)},
+                 {Shader::Stage::Compute, Env(Shader::Stage::Compute)}});
+    reject([&] { CacheIndex::Read(bad); });
+    bad = bytes;
+    u32 bad_sph = 5u << 10;
+    std::memcpy(bad.data() + 84, &bad_sph, 4);
+    std::memcpy(bad.data() + 172, &bad_sph, 4);
+    reject([&] { CacheIndex::Read(bad); });
+    bad = Header();
+    Record(bad, {{Shader::Stage::VertexB, Env(Shader::Stage::VertexB)}}, true);
+    reject([&] { CacheIndex::Read(bad); });
+    auto aliases = Header();
+    Record(aliases, {{Shader::Stage::VertexB, Env(Shader::Stage::VertexB)}});
+    Record(aliases, {{Shader::Stage::VertexB, Env(Shader::Stage::VertexB)}});
+    auto equivalent = CacheIndex::Read(aliases);
+    require(equivalent
+                .MatchComplete(Shader::Stage::VertexB, instructions,
+                               CapturedCodeLayout::InstructionsOnly)
+                .identical_aliases.size() == 2);
+    Record(aliases,
+           {{Shader::Stage::VertexB,
+             Env(Shader::Stage::VertexB, 0xe30000000007000full, 1, true)}});
+    auto ambiguous = CacheIndex::Read(aliases);
+    reject([&] {
+      ambiguous.MatchComplete(Shader::Stage::VertexB, instructions,
+                              CapturedCodeLayout::InstructionsOnly);
+    });
+    auto selected =
+        ambiguous.MatchComplete(Shader::Stage::VertexB, instructions,
+                                CapturedCodeLayout::InstructionsOnly,
+                                ambiguous.Entries()[2].metadata_sha256);
+    require(selected.canonical_entry == 2);
+    auto snapshot = ambiguous.Entries()[2].snapshot;
+    require(snapshot.ReadCbufValue(3, 16) == 123);
+    reject([&] { snapshot.ReadCbufValue(3, 20); });
+    reject([&] { snapshot.ReadTextureType(99); });
+    reject([&] { snapshot.ReadTexturePixelFormat(99); });
+    auto format_cache = Header();
+    Record(format_cache,
+           {{Shader::Stage::VertexB, Env(Shader::Stage::VertexB)}});
+    format_cache[32] = std::byte{1};
+    Bytes format_words;
+    Put<u32>(format_words, 99);
+    Put<u32>(format_words, 105);
+    format_cache.insert(format_cache.begin() + 172, format_words.begin(),
+                        format_words.end());
+    auto format_index = CacheIndex::Read(format_cache);
+    auto format_snapshot = format_index.Entries()[0].snapshot;
+    reject([&] { format_snapshot.ReadTexturePixelFormat(99); });
+    require(format_snapshot.PixelFormatQueries() == std::vector<u32>{105});
+    require(format_index.MetadataJson(0).find("105") != std::string::npos);
+    format_cache[176] = std::byte{112};
+    reject([&] { CacheIndex::Read(format_cache); });
+    std::cout << "{\"passed\":true,\"checks\":" << checks
+              << ",\"strict_rejections\":" << rejections
+              << ",\"synthetic_only\":true}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
diff --git a/native-runtime/shaders/index_probe.cpp b/native-runtime/shaders/index_probe.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/shaders/index_probe.cpp
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "cache_index.h"
+#include <fstream>
+#include <iostream>
+#include <sstream>
+#include <stdexcept>
+std::vector<std::byte> Read(const char *path) {
+  std::ifstream f(path, std::ios::binary | std::ios::ate);
+  if (!f)
+    throw std::runtime_error("Input unavailable");
+  auto size = f.tellg();
+  if (size < 0 || size > 64 * 1024 * 1024)
+    throw std::runtime_error("Input size bound");
+  std::vector<std::byte> b(static_cast<size_t>(size));
+  f.seekg(0);
+  if (!f.read(reinterpret_cast<char *>(b.data()), b.size()))
+    throw std::runtime_error("Input truncated");
+  return b;
+}
+int main(int argc, char **argv) {
+  try {
+    if (argc < 4)
+      throw std::runtime_error(
+          "Usage: index cache out.json | match cache stage "
+          "snapshot|instructions complete-code.bin out.json [metadata-sha256]");
+    auto input = Read(argv[2]);
+    auto index = native_shaders::CacheIndex::Read(input);
+    std::string mode = argv[1];
+    std::ostringstream out;
+    if (mode == "index" && argc == 4) {
+      out << "{\"cache_version\":18,\"records\":" << index.RecordCount()
+          << ",\"environments\":[";
+      for (size_t i = 0; i < index.Entries().size(); ++i) {
+        if (i)
+          out << ',';
+        out << index.MetadataJson(i);
+      }
+      out << "]}";
+      std::ofstream(argv[3]) << out.str();
+    } else if (mode == "match" && (argc == 7 || argc == 8)) {
+      unsigned stage = std::stoul(argv[3]);
+      std::string layout = argv[4];
+      if (layout != "snapshot" && layout != "instructions")
+        throw std::runtime_error("Explicit code layout required");
+      auto code = Read(argv[5]);
+      auto match = index.MatchComplete(
+          static_cast<Shader::Stage>(stage), code,
+          layout == "snapshot"
+              ? native_shaders::CapturedCodeLayout::SnapshotCode
+              : native_shaders::CapturedCodeLayout::InstructionsOnly,
+          argc == 8 ? argv[7] : "");
+      out << "{\"canonical_entry\":" << match.canonical_entry
+          << ",\"identical_aliases\":[";
+      for (size_t i = 0; i < match.identical_aliases.size(); ++i) {
+        if (i)
+          out << ',';
+        out << match.identical_aliases[i];
+      }
+      out << "],\"environment\":" << index.MetadataJson(match.canonical_entry)
+          << '}';
+      std::ofstream(argv[6]) << out.str();
+    } else
+      throw std::runtime_error("Invalid index/match arguments");
+    std::cout << "{\"passed\":true,\"records\":" << index.RecordCount()
+              << ",\"environments\":" << index.Entries().size() << "}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
diff --git a/native-runtime/shaders/matched_pair_probe.cpp b/native-runtime/shaders/matched_pair_probe.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/shaders/matched_pair_probe.cpp
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "cache_index.h"
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+std::vector<std::byte> Read(const char *path) {
+  std::ifstream f(path, std::ios::binary | std::ios::ate);
+  if (!f)
+    throw std::runtime_error("Input unavailable");
+  auto size = f.tellg();
+  if (size < 0 || size > 64 * 1024 * 1024)
+    throw std::runtime_error("Input size bound");
+  std::vector<std::byte> b(static_cast<size_t>(size));
+  f.seekg(0);
+  if (!f.read(reinterpret_cast<char *>(b.data()), b.size()))
+    throw std::runtime_error("Input truncated");
+  return b;
+}
+int main(int argc, char **argv) {
+  try {
+    if (argc != 5)
+      throw std::runtime_error(
+          "Usage: matched_pair cache full-vertex-snapshot-code "
+          "full-fragment-snapshot-code output-dir");
+    auto cache = Read(argv[1]), vertex = Read(argv[2]),
+         fragment = Read(argv[3]);
+    auto index = native_shaders::CacheIndex::Read(cache);
+    auto vm = index.MatchComplete(
+             Shader::Stage::VertexB, vertex,
+             native_shaders::CapturedCodeLayout::SnapshotCode),
+         fm = index.MatchComplete(
+             Shader::Stage::Fragment, fragment,
+             native_shaders::CapturedCodeLayout::SnapshotCode);
+    std::vector<native_shaders::Snapshot> pair = {
+        index.Entries()[vm.canonical_entry].snapshot,
+        index.Entries()[fm.canonical_entry].snapshot};
+    auto result = native_shaders::TranslatePair(pair);
+    std::filesystem::path out(argv[4]);
+    std::filesystem::create_directories(out);
+    for (auto [name, words] : {std::pair{"vertex", &result.vertex},
+                               std::pair{"fragment", &result.fragment}}) {
+      std::ofstream f(out / (std::string(name) + ".spv"), std::ios::binary);
+      f.write(reinterpret_cast<const char *>(words->data()), words->size() * 4);
+      if (!f)
+        throw std::runtime_error("Output write failed");
+    }
+    std::ofstream(out / "resource-plan.json") << result.resource_plan;
+    std::cout << "{\"passed\":true,\"vertex_entry\":" << vm.canonical_entry
+              << ",\"fragment_entry\":" << fm.canonical_entry
+              << ",\"pixel_format_queries\":[";
+    bool comma = false;
+    for (auto &snapshot : pair)
+      for (auto ordinal : snapshot.PixelFormatQueries()) {
+        if (comma)
+          std::cout << ',';
+        comma = true;
+        std::cout << ordinal;
+      }
+    std::cout << "],\"pipeline_or_draw_validated\":false}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
diff --git a/native-runtime/shaders/module_check.cpp b/native-runtime/shaders/module_check.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/shaders/module_check.cpp
@@ -0,0 +1,65 @@
+#include "vulkan_resources.h"
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#define VK_NO_PROTOTYPES
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+#include <vulkan/vulkan.h>
+#include <windows.h>
+struct OwnedLoader {
+  HMODULE value = LoadLibraryW(L"vulkan-1.dll");
+  ~OwnedLoader() {
+    if (value)
+      FreeLibrary(value);
+  }
+};
+int main(int argc, char **argv) {
+  try {
+    if (argc != 3)
+      throw std::runtime_error("Requires translated vertex/fragment paths");
+    native_graphics::VulkanDevice gpu;
+    auto handles = gpu.GetNativeHandles();
+    auto device = reinterpret_cast<VkDevice>(handles.device);
+    OwnedLoader owned;
+    auto loader = owned.value;
+    if (!loader)
+      throw std::runtime_error("Vulkan loader unavailable");
+    auto create = reinterpret_cast<PFN_vkCreateShaderModule>(
+        GetProcAddress(loader, "vkCreateShaderModule"));
+    auto destroy = reinterpret_cast<PFN_vkDestroyShaderModule>(
+        GetProcAddress(loader, "vkDestroyShaderModule"));
+    if (!create || !destroy) {
+      throw std::runtime_error("Vulkan module exports unavailable");
+    }
+    for (int i = 1; i < 3; ++i) {
+      std::ifstream f(argv[i], std::ios::binary | std::ios::ate);
+      auto bytes = f.tellg();
+      if (bytes < 20 || bytes > 16 * 1024 * 1024 || bytes % 4)
+        throw std::runtime_error("Invalid module length");
+      std::vector<uint32_t> code(size_t(bytes) / 4);
+      f.seekg(0);
+      if (!f.read(reinterpret_cast<char *>(code.data()), bytes) ||
+          code[0] != 0x07230203)
+        throw std::runtime_error("Invalid module data");
+      VkShaderModuleCreateInfo ci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+      ci.codeSize = size_t(bytes);
+      ci.pCode = code.data();
+      VkShaderModule module{};
+      auto status = create(device, &ci, nullptr, &module);
+      if (status != VK_SUCCESS) {
+        throw std::runtime_error("Driver rejected shader module: " +
+                                 std::to_string(status));
+      }
+      destroy(device, module, nullptr);
+    }
+    std::cout << "{\"module_creation_passed\":true,\"device\":\""
+              << gpu.DeviceName()
+              << "\",\"modules\":2,\"pipelines_created\":0,\"draws\":0}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
diff --git a/native-runtime/shaders/native_input_test.cpp b/native-runtime/shaders/native_input_test.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/shaders/native_input_test.cpp
@@ -0,0 +1,361 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "native_shaders.h"
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+using namespace native_shaders;
+namespace {
+using Bytes = std::vector<std::byte>;
+unsigned checks = 0, rejections = 0;
+void Check(bool value) {
+  ++checks;
+  if (!value)
+    throw std::runtime_error("native input assertion");
+}
+template <class F> void Reject(F f) {
+  try {
+    f();
+  } catch (const std::exception &) {
+    ++rejections;
+    return;
+  }
+  throw std::runtime_error("expected native input rejection");
+}
+template <class T> void Put(Bytes &bytes, T value) {
+  auto at = bytes.size();
+  bytes.resize(at + sizeof(value));
+  std::memcpy(bytes.data() + at, &value, sizeof(value));
+}
+Bytes Source(NativeStage stage) {
+  Shader::ProgramHeader header{};
+  header.common0.shader_type.Assign(stage == NativeStage::VertexB ? 1u : 5u);
+  Bytes out(sizeof(header));
+  std::memcpy(out.data(), &header, sizeof(header));
+  Put<u64>(out, 0xe30000000007000full); // authored unconditional EXIT
+  return out;
+}
+NativeInput Input(NativeStage stage, const Bytes &bytes) {
+  NativeInput in;
+  in.stage = stage;
+  in.source = bytes;
+  in.start_address = 0;
+  in.local_memory_size = 0;
+  in.viewport_transform = 1;
+  in.texture_bound_bank = 2;
+  in.proprietary_driver = true;
+  return in;
+}
+void Environment(Bytes &cache, const NativeInput &in) {
+  Put<u64>(cache, in.source.size());
+  Put<u64>(cache, in.textures.size());
+  size_t formats = 0;
+  for (auto &t : in.textures)
+    formats += t.format.has_value();
+  Put<u64>(cache, formats);
+  Put<u64>(cache, in.cbuf_words.size());
+  Put<u64>(cache, in.replacements.size());
+  Put<u32>(cache, static_cast<u32>(*in.local_memory_size));
+  Put<u32>(cache, *in.texture_bound_bank);
+  Put<u32>(cache, static_cast<u32>(*in.start_address));
+  Put<u32>(cache, static_cast<u32>(*in.start_address));
+  Put<u32>(cache, static_cast<u32>(*in.start_address + in.source.size() - 8));
+  Put<u32>(cache, *in.viewport_transform);
+  Put<u32>(cache, static_cast<u32>(*in.stage == NativeStage::VertexB
+                                       ? Shader::Stage::VertexB
+                                       : Shader::Stage::Fragment));
+  cache.insert(cache.end(), in.source.begin(), in.source.end());
+  for (auto &t : in.textures) {
+    Put<u32>(cache, static_cast<u32>(t.handle));
+    Put<u32>(cache, static_cast<u32>(t.type));
+  }
+  for (auto &t : in.textures)
+    if (t.format) {
+      Put<u32>(cache, static_cast<u32>(t.handle));
+      Check(*t.format == NativePixelFormat::RGBA8Uint);
+      Put<u32>(cache,
+               static_cast<u32>(Shader::TexturePixelFormat::A8B8G8R8_UINT));
+    }
+  for (auto &w : in.cbuf_words) {
+    Put<u64>(cache, (w.bank << 32) | w.offset);
+    Put<u32>(cache, w.value);
+  }
+  for (auto &r : in.replacements) {
+    Put<u64>(cache, (r.bank << 32) | r.offset);
+    Put<u32>(cache, static_cast<u32>(r.value));
+  }
+  cache.insert(cache.end(), in.source.begin(), in.source.begin() + 80);
+}
+} // namespace
+int main() {
+  try {
+    auto vertex = Source(NativeStage::VertexB),
+         fragment = Source(NativeStage::Fragment);
+    auto vi = Input(NativeStage::VertexB, vertex),
+         fi = Input(NativeStage::Fragment, fragment);
+    std::vector<NativeCbufWord> words{
+        {0, 0, 17}, {1, 0, 19}, {17, 65532, 23}, {3, 16, 29}};
+    std::vector<NativeTexture> textures{
+        {0, Shader::TextureType::Color2D, NativePixelFormat::RGBA8Uint},
+        {0xffffffff, Shader::TextureType::ColorCube, {}}};
+    std::vector<NativeReplacement> replacements{
+        {0, 0, Shader::ReplaceConstant::BaseInstance},
+        {1, 0, Shader::ReplaceConstant::BaseVertex},
+        {17, 65532, Shader::ReplaceConstant::DrawID}};
+    vi.cbuf_words = words;
+    vi.textures = textures;
+    vi.replacements = replacements;
+    auto owned = Snapshot::FromNativeInput(vi);
+    Check(owned.ReadCbufValue(0, 0) == 17 && owned.ReadCbufValue(1, 0) == 19 &&
+          owned.ReadCbufValue(17, 65532) == 23);
+    Check(owned.ReadTextureType(0xffffffff) == Shader::TextureType::ColorCube &&
+          owned.IsTexturePixelFormatInteger(0));
+    Check(owned.GetReplaceConstBuffer(17, 65532) ==
+              Shader::ReplaceConstant::DrawID &&
+          !owned.GetReplaceConstBuffer(3, 0));
+    Reject([&] { owned.ReadCbufValue(0, 4); });
+    Reject([&] { owned.ReadTextureType(7); });
+    Reject([&] { owned.ReadTexturePixelFormat(0xffffffff); });
+    Reject([&] { owned.ReadInstruction(1); });
+    Reject([&] { owned.ReadInstruction(88); });
+    Bytes cache;
+    for (char c : std::string("yuzucach"))
+      cache.push_back(std::byte(c));
+    Put<u32>(cache, 18);
+    Put<u32>(cache, 2);
+    Environment(cache, vi);
+    Environment(cache, fi);
+    auto cached = Snapshot::ReadFirstPair(cache);
+    std::vector<Snapshot> native{owned, Snapshot::FromNativeInput(fi)};
+    Check(cached[0].ReadInstruction(80) == native[0].ReadInstruction(80));
+    Check(cached[0].ReadCbufValue(1, 0) == native[0].ReadCbufValue(1, 0));
+    Check(cached[0].ReadTextureType(0xffffffff) ==
+          native[0].ReadTextureType(0xffffffff));
+    Check(cached[0].ReadTexturePixelFormat(0) ==
+          native[0].ReadTexturePixelFormat(0));
+    auto expected = TranslatePair(cached), actual = TranslatePair(native);
+    Check(expected.vertex == actual.vertex &&
+          expected.fragment == actual.fragment &&
+          expected.resource_plan == actual.resource_plan);
+    for (u32 ordinal : {94u, 95u, 111u, 112u}) {
+      auto shifted = cache;
+      constexpr size_t format_value_offset = 16 + 68 + 88 + 16 + 4;
+      std::memcpy(shifted.data() + format_value_offset, &ordinal, 4);
+      if (ordinal == 112) {
+        Reject([&] { Snapshot::ReadFirstPair(shifted); });
+        continue;
+      }
+      auto pair = Snapshot::ReadFirstPair(shifted);
+      if (ordinal >= 95)
+        Reject([&] { pair[0].ReadTexturePixelFormat(0); });
+      else
+        Check(static_cast<u32>(pair[0].ReadTexturePixelFormat(0)) == 94);
+    }
+    // Every caller-owned storage class may change/disappear after construction.
+    vertex.assign(vertex.size(), std::byte{0xff});
+    words.clear();
+    words.shrink_to_fit();
+    textures.clear();
+    textures.shrink_to_fit();
+    replacements.clear();
+    replacements.shrink_to_fit();
+    Check(owned.ReadInstruction(80) == 0xe30000000007000full &&
+          owned.ReadCbufValue(1, 0) == 19 &&
+          owned.ReadTextureType(0) == Shader::TextureType::Color2D &&
+          owned.IsTexturePixelFormatInteger(0));
+    Check(owned.SPH().common0.shader_type == 1 &&
+          owned.GetReplaceConstBuffer(0, 0) ==
+              Shader::ReplaceConstant::BaseInstance);
+    std::vector<Snapshot> again{owned, Snapshot::FromNativeInput(fi)};
+    auto repeated = TranslatePair(again);
+    Check(repeated.vertex == actual.vertex &&
+          repeated.fragment == actual.fragment &&
+          repeated.resource_plan == actual.resource_plan);
+    vertex = Source(NativeStage::VertexB);
+    vi = Input(NativeStage::VertexB, vertex);
+    for (unsigned field = 0; field < 6; ++field) {
+      auto bad = vi;
+      switch (field) {
+      case 0:
+        bad.stage.reset();
+        break;
+      case 1:
+        bad.start_address.reset();
+        break;
+      case 2:
+        bad.local_memory_size.reset();
+        break;
+      case 3:
+        bad.viewport_transform.reset();
+        break;
+      case 4:
+        bad.texture_bound_bank.reset();
+        break;
+      case 5:
+        bad.proprietary_driver.reset();
+        break;
+      }
+      Reject([&] { Snapshot::FromNativeInput(bad); });
+    }
+    for (auto stage :
+         {static_cast<NativeStage>(2), static_cast<NativeStage>(-1)}) {
+      auto bad = vi;
+      bad.stage = stage;
+      Reject([&] { Snapshot::FromNativeInput(bad); });
+    }
+    for (u64 start :
+         {u64(1), u64(UINT32_MAX), u64(UINT32_MAX) + 1, u64(UINT32_MAX) - 79}) {
+      auto bad = vi;
+      bad.start_address = start;
+      Reject([&] { Snapshot::FromNativeInput(bad); });
+    }
+    auto top = vi;
+    top.start_address = u64(UINT32_MAX) - 87;
+    Check(Snapshot::FromNativeInput(top).ReadInstruction(UINT32_MAX - 7) ==
+          0xe30000000007000full);
+    for (size_t size : {size_t(0), size_t(79), size_t(80), size_t(87),
+                        size_t(89), size_t(0x100010)}) {
+      Bytes source(size);
+      auto bad = vi;
+      bad.source = source;
+      Reject([&] { Snapshot::FromNativeInput(bad); });
+    }
+    Bytes maximum(0x100008);
+    std::memcpy(maximum.data(), vertex.data(), vertex.size());
+    auto max = vi;
+    max.source = maximum;
+    Check(Snapshot::FromNativeInput(max).CodeBytes() == maximum.size());
+    auto bad = vi;
+    bad.local_memory_size = u64(UINT32_MAX) + 1;
+    Reject([&] { Snapshot::FromNativeInput(bad); });
+    bad = vi;
+    bad.viewport_transform = 2;
+    Reject([&] { Snapshot::FromNativeInput(bad); });
+    for (u32 bank : {18u, UINT32_MAX}) {
+      bad = vi;
+      bad.texture_bound_bank = bank;
+      Reject([&] { Snapshot::FromNativeInput(bad); });
+    }
+    bad = vi;
+    bad.proprietary_driver = false;
+    Reject([&] { Snapshot::FromNativeInput(bad); });
+    bad = vi;
+    bad.texture_bound_bank = 0;
+    bad.proprietary_driver = false;
+    bad.viewport_transform = 0;
+    Check(!Snapshot::FromNativeInput(bad).IsProprietaryDriver());
+    auto wrong_header = Source(NativeStage::Fragment);
+    bad = vi;
+    bad.source = wrong_header;
+    Reject([&] { Snapshot::FromNativeInput(bad); });
+    for (auto word : std::vector<NativeCbufWord>{{18, 0, 0},
+                                                 {0, 1, 0},
+                                                 {0, 65536, 0},
+                                                 {0, u64(UINT32_MAX) + 1, 0},
+                                                 {u64(UINT32_MAX) + 1, 0, 0}}) {
+      bad = vi;
+      bad.cbuf_words = std::span(&word, 1);
+      Reject([&] { Snapshot::FromNativeInput(bad); });
+    }
+    words = {{0, 0, 1}, {0, 0, 2}};
+    bad = vi;
+    bad.cbuf_words = words;
+    Reject([&] { Snapshot::FromNativeInput(bad); });
+    words.resize(65537);
+    bad = vi;
+    bad.cbuf_words = words;
+    Reject([&] { Snapshot::FromNativeInput(bad); });
+    textures = {
+        {1, Shader::TextureType::Color2D, {}},
+        {1, Shader::TextureType::ColorCube, NativePixelFormat::R32Float}};
+    bad = vi;
+    bad.textures = textures;
+    Reject([&] { Snapshot::FromNativeInput(bad); });
+    for (auto texture : std::vector<NativeTexture>{
+             {u64(UINT32_MAX) + 1, Shader::TextureType::Color2D, {}},
+             {0, static_cast<Shader::TextureType>(9), {}},
+             {0, Shader::TextureType::Color2D,
+              static_cast<NativePixelFormat>(95)},
+             {0, Shader::TextureType::Color2D,
+              static_cast<NativePixelFormat>(-1)}}) {
+      bad = vi;
+      bad.textures = std::span(&texture, 1);
+      Reject([&] { Snapshot::FromNativeInput(bad); });
+    }
+    replacements = {{0, 0, Shader::ReplaceConstant::BaseVertex},
+                    {0, 0, Shader::ReplaceConstant::DrawID}};
+    bad = vi;
+    bad.replacements = replacements;
+    Reject([&] { Snapshot::FromNativeInput(bad); });
+    for (auto r : std::vector<NativeReplacement>{
+             {18, 0, Shader::ReplaceConstant::DrawID},
+             {0, 2, Shader::ReplaceConstant::DrawID},
+             {0, 65536, Shader::ReplaceConstant::DrawID},
+             {0, 0, static_cast<Shader::ReplaceConstant>(3)}}) {
+      bad = vi;
+      bad.replacements = std::span(&r, 1);
+      Reject([&] { Snapshot::FromNativeInput(bad); });
+    }
+    const std::pair<NativePixelFormat, Shader::TexturePixelFormat>
+        format_cases[] = {
+            {NativePixelFormat::RGBA8Unorm,
+             Shader::TexturePixelFormat::A8B8G8R8_UNORM},
+            {NativePixelFormat::RGBA8Snorm,
+             Shader::TexturePixelFormat::A8B8G8R8_SNORM},
+            {NativePixelFormat::RGBA8Sint,
+             Shader::TexturePixelFormat::A8B8G8R8_SINT},
+            {NativePixelFormat::RGBA8Uint,
+             Shader::TexturePixelFormat::A8B8G8R8_UINT},
+            {NativePixelFormat::BGRA8Unorm,
+             Shader::TexturePixelFormat::B8G8R8A8_UNORM},
+            {NativePixelFormat::R32Float,
+             Shader::TexturePixelFormat::R32_FLOAT},
+            {NativePixelFormat::R32Sint, Shader::TexturePixelFormat::R32_SINT},
+            {NativePixelFormat::R32Uint, Shader::TexturePixelFormat::R32_UINT},
+            {NativePixelFormat::RGBA32Float,
+             Shader::TexturePixelFormat::R32G32B32A32_FLOAT},
+            {NativePixelFormat::RGBA32Sint,
+             Shader::TexturePixelFormat::R32G32B32A32_SINT},
+            {NativePixelFormat::RGBA32Uint,
+             Shader::TexturePixelFormat::R32G32B32A32_UINT}};
+    for (auto [native_format, semantic] : format_cases) {
+      NativeTexture t{7, Shader::TextureType::Color2D, native_format};
+      bad = vi;
+      bad.textures = std::span(&t, 1);
+      Check(Snapshot::FromNativeInput(bad).ReadTexturePixelFormat(7) ==
+            semantic);
+    }
+    textures.resize(65537);
+    bad = vi;
+    bad.textures = textures;
+    Reject([&] { Snapshot::FromNativeInput(bad); });
+    replacements.resize(65537);
+    bad = vi;
+    bad.replacements = replacements;
+    Reject([&] { Snapshot::FromNativeInput(bad); });
+    words.clear();
+    for (u32 n = 0; n < 65536; ++n)
+      words.push_back({n / 16384, (n % 16384) * 4, n});
+    bad = vi;
+    bad.cbuf_words = words;
+    Check(Snapshot::FromNativeInput(bad).ReadCbufValue(3, 65532) == 65535);
+    NativeTexture extra{0, Shader::TextureType::Color2D, {}};
+    bad.textures = std::span(&extra, 1);
+    Reject([&] { Snapshot::FromNativeInput(bad); });
+    bad = vi;
+    bad.local_memory_size = UINT32_MAX;
+    Check(Snapshot::FromNativeInput(bad).LocalMemorySize() == UINT32_MAX);
+    // Rejection leaves prior Snapshot and authored input unchanged.
+    Check(vertex == Source(NativeStage::VertexB) &&
+          owned.ReadCbufValue(1, 0) == 19 &&
+          owned.ReadInstruction(80) == 0xe30000000007000full);
+    cache[8] = std::byte{17};
+    Reject([&] { Snapshot::ReadFirstPair(cache); });
+    std::cout << "{\"passed\":true,\"checks\":" << checks
+              << ",\"rejections\":" << rejections
+              << ",\"equivalent_cache_spirv\":true,\"synthetic_only\":true,"
+                 "\"gpu\":false}\n";
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
diff --git a/native-runtime/shaders/native_shaders.cpp b/native-runtime/shaders/native_shaders.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/shaders/native_shaders.cpp
@@ -0,0 +1,428 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "native_shaders.h"
+#include "shader_recompiler/backend/spirv/emit_spirv.h"
+#include "shader_recompiler/frontend/maxwell/translate_program.h"
+#include "shader_recompiler/host_translate_info.h"
+#include <bit>
+#include <cstring>
+#include <limits>
+#include <sstream>
+#include <stdexcept>
+namespace native_shaders {
+namespace {
+struct Reader {
+  std::span<const std::byte> data;
+  size_t at = 0;
+  void Bytes(void *out, size_t size) {
+    if (size > data.size() - at)
+      throw std::runtime_error("Truncated snapshot cache");
+    std::memcpy(out, data.data() + at, size);
+    at += size;
+  }
+  template <class T> T Read() {
+    T result;
+    Bytes(&result, sizeof(result));
+    return result;
+  }
+  void Count(u64 count, size_t size) {
+    if (count > 65536 || count > (data.size() - at) / size)
+      throw std::runtime_error("Snapshot metadata count out of bounds");
+  }
+};
+template <class M>
+auto Required(M &map, typename M::key_type key, const char *operation) {
+  auto i = map.find(key);
+  if (i == map.end())
+    throw std::runtime_error(std::string(operation) +
+                             " missing shader metadata key " +
+                             std::to_string(key));
+  return i->second;
+}
+u64 Key(u32 index, u32 offset) { return (u64(index) << 32) | offset; }
+} // namespace
+Snapshot Snapshot::FromNativeInput(const NativeInput &input) {
+  static_assert(sizeof(Shader::ProgramHeader) == 80);
+  if constexpr (std::endian::native != std::endian::little)
+    throw std::runtime_error("Native shader input requires little-endian host");
+  auto required = [](bool present, const char *field) {
+    if (!present)
+      throw std::runtime_error(std::string("Native shader input missing ") +
+                               field);
+  };
+  required(input.stage.has_value(), "stage");
+  required(input.start_address.has_value(), "start_address");
+  required(input.local_memory_size.has_value(), "local_memory_size");
+  required(input.viewport_transform.has_value(), "viewport_transform");
+  required(input.texture_bound_bank.has_value(), "texture_bound_bank");
+  required(input.proprietary_driver.has_value(), "proprietary_driver");
+  Shader::Stage shader_stage;
+  switch (*input.stage) {
+  case NativeStage::VertexB:
+    shader_stage = Shader::Stage::VertexB;
+    break;
+  case NativeStage::Fragment:
+    shader_stage = Shader::Stage::Fragment;
+    break;
+  default:
+    throw std::runtime_error("Unsupported native shader stage");
+  }
+  const auto start = *input.start_address;
+  const auto size = input.source.size();
+  if (size < 88 || size > 0x100008 || size % 8 || start % 8 ||
+      start > UINT32_MAX || size - 8 > UINT32_MAX - start)
+    throw std::runtime_error("Invalid native shader source extent/address");
+  if (*input.local_memory_size > UINT32_MAX || *input.viewport_transform > 1 ||
+      *input.texture_bound_bank >= Shader::Info::MAX_CBUFS ||
+      *input.proprietary_driver != (*input.texture_bound_bank == 2))
+    throw std::runtime_error(
+        "Invalid native shader local/viewport/bank/driver metadata");
+  constexpr size_t cap = 65536;
+  if (input.cbuf_words.size() > cap || input.textures.size() > cap ||
+      input.replacements.size() > cap ||
+      input.cbuf_words.size() + input.textures.size() +
+              input.replacements.size() >
+          cap)
+    throw std::runtime_error("Native shader metadata count exceeds 65536");
+  auto cbuf_key = [](u64 bank, u64 offset) {
+    if (bank >= Shader::Info::MAX_CBUFS || offset % 4 || offset > 65536 - 4)
+      throw std::runtime_error(
+          "Invalid native cbuf bank/offset: " + std::to_string(bank) + ":" +
+          std::to_string(offset));
+    return Key(static_cast<u32>(bank), static_cast<u32>(offset));
+  };
+  auto format = [](NativePixelFormat value) {
+    using F = Shader::TexturePixelFormat;
+    switch (value) {
+    case NativePixelFormat::RGBA8Unorm:
+      return F::A8B8G8R8_UNORM;
+    case NativePixelFormat::RGBA8Snorm:
+      return F::A8B8G8R8_SNORM;
+    case NativePixelFormat::RGBA8Sint:
+      return F::A8B8G8R8_SINT;
+    case NativePixelFormat::RGBA8Uint:
+      return F::A8B8G8R8_UINT;
+    case NativePixelFormat::BGRA8Unorm:
+      return F::B8G8R8A8_UNORM;
+    case NativePixelFormat::R32Float:
+      return F::R32_FLOAT;
+    case NativePixelFormat::R32Sint:
+      return F::R32_SINT;
+    case NativePixelFormat::R32Uint:
+      return F::R32_UINT;
+    case NativePixelFormat::RGBA32Float:
+      return F::R32G32B32A32_FLOAT;
+    case NativePixelFormat::RGBA32Sint:
+      return F::R32G32B32A32_SINT;
+    case NativePixelFormat::RGBA32Uint:
+      return F::R32G32B32A32_UINT;
+    default:
+      throw std::runtime_error("Unsupported native semantic pixel format");
+    }
+  };
+  // Complete bounded preflight precedes all owned storage allocation/copies.
+  for (const auto &word : input.cbuf_words)
+    (void)cbuf_key(word.bank, word.offset);
+  for (const auto &entry : input.replacements) {
+    (void)cbuf_key(entry.bank, entry.offset);
+    if (static_cast<u32>(entry.value) > 2)
+      throw std::runtime_error("Invalid native replacement enum");
+  }
+  for (const auto &texture : input.textures) {
+    if (texture.handle > UINT32_MAX ||
+        static_cast<u32>(texture.type) >= Shader::NUM_TEXTURE_TYPES)
+      throw std::runtime_error("Invalid native texture handle/type");
+    if (texture.format)
+      (void)format(*texture.format);
+  }
+  Shader::ProgramHeader header;
+  std::memcpy(&header, input.source.data(), sizeof(header));
+  if (header.common0.shader_type != static_cast<u32>(shader_stage) + 1)
+    throw std::runtime_error("Native SPH stage differs from named stage");
+  Snapshot out;
+  out.stage = shader_stage;
+  out.start_address = static_cast<u32>(start);
+  out.lowest = out.start_address;
+  out.highest = static_cast<u32>(start + size - 8);
+  out.local_size = static_cast<u32>(*input.local_memory_size);
+  out.viewport = *input.viewport_transform;
+  out.texture_bound = *input.texture_bound_bank;
+  out.is_proprietary_driver = *input.proprietary_driver;
+  out.sph = header;
+  for (const auto &word : input.cbuf_words)
+    if (!out.cbufs.emplace(cbuf_key(word.bank, word.offset), word.value).second)
+      throw std::runtime_error("Duplicate native cbuf bank/offset");
+  for (const auto &entry : input.replacements)
+    if (!out.replacements
+             .emplace(cbuf_key(entry.bank, entry.offset), entry.value)
+             .second)
+      throw std::runtime_error("Duplicate native replacement bank/offset");
+  for (const auto &texture : input.textures) {
+    const auto handle = static_cast<u32>(texture.handle);
+    if (!out.types.emplace(handle, texture.type).second)
+      throw std::runtime_error("Duplicate native texture handle");
+    if (texture.format)
+      out.formats.emplace(handle, format(*texture.format));
+  }
+  out.code.resize(size / 8);
+  std::memcpy(out.code.data(), input.source.data(), size);
+  return out;
+}
+std::vector<Snapshot>
+Snapshot::ReadFirstPair(std::span<const std::byte> bytes) {
+  static_assert(sizeof(Shader::ProgramHeader) == 80);
+  if (bytes.size() > 64 * 1024 * 1024)
+    throw std::runtime_error("Snapshot cache exceeds 64MiB");
+  Reader r{bytes};
+  char magic[8];
+  r.Bytes(magic, 8);
+  if (std::memcmp(magic, "yuzucach", 8) || r.Read<u32>() != 18)
+    throw std::runtime_error(
+        "Unsupported shader cache magic/version (requires18)");
+  if (r.Read<u32>() != 2)
+    throw std::runtime_error(
+        "First pipeline must contain exactly vertexB+fragment environments");
+  std::vector<Snapshot> out;
+  for (unsigned i = 0; i < 2; ++i) {
+    auto snapshot = ReadEnvironment(bytes, r.at);
+    if (snapshot.ShaderStage() !=
+        (i == 0 ? Shader::Stage::VertexB : Shader::Stage::Fragment))
+      throw std::runtime_error("First pair stage mismatch");
+    out.push_back(std::move(snapshot));
+  }
+  return out;
+}
+Snapshot Snapshot::ReadEnvironment(std::span<const std::byte> bytes,
+                                   size_t &offset) {
+  Reader r{bytes, offset};
+  Snapshot s;
+  const auto size = r.Read<u64>(), nt = r.Read<u64>(), nf = r.Read<u64>(),
+             nc = r.Read<u64>(), nr = r.Read<u64>();
+  s.local_size = r.Read<u32>();
+  s.texture_bound = r.Read<u32>();
+  s.start_address = r.Read<u32>();
+  s.lowest = r.Read<u32>();
+  s.highest = r.Read<u32>();
+  s.viewport = r.Read<u32>();
+  s.stage = r.Read<Shader::Stage>();
+  if (size < (s.stage == Shader::Stage::Compute ? 8 : 80) || size > 0x100008 ||
+      size % 8 || s.highest < s.lowest || s.lowest != s.start_address ||
+      size != u64(s.highest) - s.lowest + 8 ||
+      s.start_address > UINT32_MAX - 80)
+    throw std::runtime_error("Invalid graphics shader snapshot range/stage");
+  s.code.resize(size / 8);
+  r.Bytes(s.code.data(), size);
+  r.Count(nt, 8);
+  for (u64 j = 0; j < nt; ++j) {
+    auto key = r.Read<u32>();
+    auto value = r.Read<u32>();
+    if (value >= Shader::NUM_TEXTURE_TYPES ||
+        !s.types.emplace(key, static_cast<Shader::TextureType>(value)).second)
+      throw std::runtime_error("Invalid/duplicate texture type");
+  }
+  r.Count(nf, 8);
+  for (u64 j = 0; j < nf; ++j) {
+    auto key = r.Read<u32>();
+    auto value = r.Read<u32>();
+    if (value > 111u /* version18 Surface::PixelFormat serialized maximum, not
+                        the older shader enum */
+        ||
+        !s.formats.emplace(key, static_cast<Shader::TexturePixelFormat>(value))
+             .second)
+      throw std::runtime_error("Invalid/duplicate texture format");
+  }
+  r.Count(nc, 12);
+  for (u64 j = 0; j < nc; ++j) {
+    auto key = r.Read<u64>();
+    auto value = r.Read<u32>();
+    if (!s.cbufs.emplace(key, value).second)
+      throw std::runtime_error("Duplicate cbuf metadata");
+  }
+  r.Count(nr, 12);
+  for (u64 j = 0; j < nr; ++j) {
+    auto key = r.Read<u64>();
+    auto value = r.Read<u32>();
+    if (value > 2 ||
+        !s.replacements
+             .emplace(key, static_cast<Shader::ReplaceConstant>(value))
+             .second)
+      throw std::runtime_error("Invalid cbuf replacement");
+  }
+  if (static_cast<u32>(s.stage) > 6)
+    throw std::runtime_error("Invalid shader stage");
+  if (s.stage == Shader::Stage::Compute) {
+    for (auto &dim : s.workgroup)
+      dim = r.Read<u32>();
+    s.shared_size = r.Read<u32>();
+    if (!s.workgroup[0] || !s.workgroup[1] || !s.workgroup[2])
+      throw std::runtime_error("Missing compute workgroup metadata");
+  } else {
+    r.Bytes(&s.sph, sizeof(s.sph));
+    if (s.stage == Shader::Stage::Geometry)
+      r.Bytes(s.gp_passthrough_mask.data(), sizeof(s.gp_passthrough_mask));
+  }
+  if (s.stage != Shader::Stage::Compute &&
+      std::memcmp(&s.sph, s.code.data(), sizeof(s.sph)))
+    throw std::runtime_error("Snapshot SPH metadata differs from code header");
+  s.is_proprietary_driver = s.texture_bound == 2;
+  offset = r.at;
+  return s;
+}
+u64 Snapshot::ReadInstruction(u32 address) {
+  if (address < lowest || address > highest || (address - lowest) % 8)
+    throw std::runtime_error("Shader instruction read out of bounds/alignment");
+  return code[(address - lowest) / 8];
+}
+u32 Snapshot::ReadCbufValue(u32 index, u32 offset) {
+  return Required(cbufs, Key(index, offset), "ReadCbufValue(bank<<32|offset)");
+}
+Shader::TextureType Snapshot::ReadTextureType(u32 h) {
+  return Required(types, h, "ReadTextureType(handle)");
+}
+Shader::TexturePixelFormat Snapshot::ReadTexturePixelFormat(u32 h) {
+  auto value = Required(formats, h, "ReadTexturePixelFormat(handle)");
+  if (pixel_format_queries.size() >= 65536)
+    throw std::runtime_error("Pixel format query cap");
+  pixel_format_queries.push_back(static_cast<u32>(value));
+  if (static_cast<u32>(value) >= 95)
+    throw std::runtime_error(
+        "Unsupported shifted Surface pixel-format ordinal at shader boundary");
+  return value;
+}
+bool Snapshot::IsTexturePixelFormatInteger(u32 h) {
+  using F = Shader::TexturePixelFormat;
+  switch (ReadTexturePixelFormat(h)) {
+  case F::A8B8G8R8_SINT:
+  case F::A8B8G8R8_UINT:
+  case F::A2B10G10R10_UINT:
+  case F::R8_SINT:
+  case F::R8_UINT:
+  case F::R16G16B16A16_SINT:
+  case F::R16G16B16A16_UINT:
+  case F::R32G32B32A32_UINT:
+  case F::R32G32B32A32_SINT:
+  case F::R32G32_SINT:
+  case F::R16_UINT:
+  case F::R16_SINT:
+  case F::R16G16_UINT:
+  case F::R16G16_SINT:
+  case F::R8G8_SINT:
+  case F::R8G8_UINT:
+  case F::R32G32_UINT:
+  case F::R32_UINT:
+  case F::R32_SINT:
+    return true;
+  default:
+    return false;
+  }
+}
+std::array<u32, 3> Snapshot::WorkgroupSize() const {
+  if (stage != Shader::Stage::Compute)
+    throw std::runtime_error(
+        "Compute metadata unavailable in graphics snapshot");
+  return workgroup;
+}
+std::optional<Shader::ReplaceConstant>
+Snapshot::GetReplaceConstBuffer(u32 bank, u32 offset) {
+  auto i = replacements.find(Key(bank, offset));
+  return i == replacements.end() ? std::nullopt : std::optional(i->second);
+}
+CompiledPair TranslatePair(std::vector<Snapshot> &snapshots) {
+  if (snapshots.size() != 2 ||
+      snapshots[0].ShaderStage() != Shader::Stage::VertexB ||
+      snapshots[1].ShaderStage() != Shader::Stage::Fragment)
+    throw std::runtime_error("Requires checked vertexB/fragment pair");
+  Shader::ObjectPool<Shader::IR::Inst> inst;
+  Shader::ObjectPool<Shader::IR::Block> blocks;
+  Shader::ObjectPool<Shader::Maxwell::Flow::Block> flow;
+  Shader::HostTranslateInfo host{};
+  host.ApplyDescriptorLimitPolicy();
+  Shader::Profile profile{};
+  profile.unified_descriptor_binding = true;
+  profile.need_fastmath_off = true;
+  Shader::Backend::Bindings bindings{};
+  CompiledPair out;
+  Shader::VaryingState previous;
+  previous.mask.set();
+  std::map<Shader::IR::Attribute, Shader::IR::Attribute> previous_legacy;
+  std::ostringstream plan;
+  plan << "{\"profile\":\"conservative SPIRV1.0; float attributes/outputs; "
+          "triangle topology\",\"stages\":[";
+  for (size_t i = 0; i < 2; ++i) {
+    auto &env = snapshots[i];
+    Shader::Maxwell::Flow::CFG cfg(env, flow, env.StartAddress() + 80, false);
+    auto program =
+        Shader::Maxwell::TranslateProgram(inst, blocks, env, cfg, host);
+    Shader::RuntimeInfo runtime{};
+    runtime.input_topology = Shader::InputTopology::Triangles;
+    runtime.generic_input_types.fill(Shader::AttributeType::Float);
+    runtime.color_output_types.fill(Shader::AttributeType::Float);
+    runtime.previous_stage_stores = previous;
+    runtime.previous_stage_legacy_stores_mapping = previous_legacy;
+    Shader::Maxwell::ConvertLegacyToGeneric(program, runtime);
+    auto binding_begin = bindings.unified;
+    auto code =
+        Shader::Backend::SPIRV::EmitSPIRV(profile, runtime, program, bindings);
+    if (code.size() < 5 || code[0] != 0x07230203)
+      throw std::runtime_error("Invalid SPIRV module header");
+
+    if (!program.info.texture_buffer_descriptors.empty() ||
+        !program.info.image_buffer_descriptors.empty() ||
+        !program.info.image_descriptors.empty())
+      throw std::runtime_error(
+          "Resource plan for texel/image buffers not implemented");
+    if (i)
+      plan << ',';
+    plan << "{\"stage\":\"" << (i ? "fragment" : "vertex")
+         << "\",\"code_bytes\":" << env.CodeBytes()
+         << ",\"cbuf_metadata_words\":" << env.CbufWords()
+         << ",\"texture_metadata\":" << env.TextureMetadata()
+         << ",\"spirv_words\":" << code.size()
+         << ",\"binding_begin\":" << binding_begin << ",\"bindings\":[";
+    bool comma = false;
+    u32 planned_binding = binding_begin;
+    for (const auto &cb : program.info.constant_buffer_descriptors) {
+      if (comma)
+        plan << ',';
+      comma = true;
+      plan << "{\"kind\":\"uniform_buffer\",\"binding\":" << planned_binding++
+           << ",\"guest_cbuf\":" << cb.index << ",\"count\":" << cb.count
+           << '}';
+    }
+    for (const auto &sb : program.info.storage_buffers_descriptors) {
+      if (comma)
+        plan << ',';
+      comma = true;
+      plan << "{\"kind\":\"storage_buffer\",\"binding\":" << planned_binding++
+           << ",\"guest_cbuf\":" << sb.cbuf_index
+           << ",\"guest_offset\":" << sb.cbuf_offset
+           << ",\"count\":" << sb.count << '}';
+    }
+    for (const auto &t : program.info.texture_descriptors) {
+      if (comma)
+        plan << ',';
+      comma = true;
+      plan << "{\"kind\":\"combined_image_sampler\",\"binding\":"
+           << planned_binding++ << ",\"guest_cbuf\":" << t.cbuf_index
+           << ",\"guest_offset\":" << t.cbuf_offset << ",\"count\":" << t.count
+           << ",\"texture_type\":" << static_cast<u32>(t.type)
+           << ",\"is_depth\":" << (t.is_depth ? "true" : "false") << '}';
+    }
+    if (planned_binding != bindings.unified)
+      throw std::runtime_error("Resource plan binding count mismatch");
+    plan << "],\"input_attribute_mask\":\""
+         << program.info.loads.mask.to_string()
+         << "\",\"output_attribute_mask\":\""
+         << program.info.stores.mask.to_string() << "\"}";
+    previous = program.info.stores;
+    previous_legacy = program.info.legacy_stores_mapping;
+    if (i)
+      out.fragment = std::move(code);
+    else
+      out.vertex = std::move(code);
+  }
+  plan << "],\"unified_binding_end\":" << bindings.unified
+       << ",\"execution_validated\":false}";
+  out.resource_plan = plan.str();
+  return out;
+}
+} // namespace native_shaders
diff --git a/native-runtime/shaders/native_shaders.h b/native-runtime/shaders/native_shaders.h
new file mode 100644
--- /dev/null
+++ b/native-runtime/shaders/native_shaders.h
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "shader_recompiler/environment.h"
+#include <filesystem>
+#include <map>
+#include <span>
+#include <vector>
+namespace native_shaders {
+class CacheIndex;
+// Offline tooling input. Source begins with the complete 80-byte SPH; the
+// caller is responsible for proving complete extent/provenance. No runtime
+// raster-specialization claim is implied by constructing a snapshot.
+enum class NativeStage { VertexB, Fragment };
+enum class NativePixelFormat {
+  RGBA8Unorm,
+  RGBA8Snorm,
+  RGBA8Sint,
+  RGBA8Uint,
+  BGRA8Unorm,
+  R32Float,
+  R32Sint,
+  R32Uint,
+  RGBA32Float,
+  RGBA32Sint,
+  RGBA32Uint
+};
+struct NativeCbufWord {
+  u64 bank, offset;
+  u32 value;
+};
+struct NativeTexture {
+  u64 handle;
+  Shader::TextureType type;
+  std::optional<NativePixelFormat> format;
+};
+struct NativeReplacement {
+  u64 bank, offset;
+  Shader::ReplaceConstant value;
+};
+struct NativeInput {
+  std::optional<NativeStage> stage;
+  std::span<const std::byte> source;
+  std::optional<u64> start_address, local_memory_size;
+  std::optional<u32> viewport_transform, texture_bound_bank;
+  std::optional<bool> proprietary_driver;
+  std::span<const NativeCbufWord> cbuf_words;
+  std::span<const NativeTexture> textures;
+  std::span<const NativeReplacement> replacements;
+};
+// Native-owned snapshot, independent of VideoCommon and guest memory.
+class Snapshot final : public Shader::Environment {
+public:
+  static Snapshot FromNativeInput(const NativeInput &input);
+  static std::vector<Snapshot> ReadFirstPair(std::span<const std::byte> bytes);
+  u64 ReadInstruction(u32 address) override;
+  u32 ReadCbufValue(u32 index, u32 offset) override;
+  Shader::TextureType ReadTextureType(u32 handle) override;
+  Shader::TexturePixelFormat ReadTexturePixelFormat(u32 handle) override;
+  bool IsTexturePixelFormatInteger(u32 handle) override;
+  u32 ReadViewportTransformState() override { return viewport; }
+  u32 TextureBoundBuffer() const override { return texture_bound; }
+  u32 LocalMemorySize() const override { return local_size; }
+  u32 SharedMemorySize() const override { return shared_size; }
+  std::array<u32, 3> WorkgroupSize() const override;
+  bool HasHLEMacroState() const override { return !replacements.empty(); }
+  std::optional<Shader::ReplaceConstant>
+  GetReplaceConstBuffer(u32 bank, u32 offset) override;
+  void Dump(u64, u64) override {}
+  size_t CodeBytes() const { return code.size() * 8; }
+  size_t CbufWords() const { return cbufs.size(); }
+  size_t TextureMetadata() const { return types.size(); }
+  const std::vector<u32> &PixelFormatQueries() const {
+    return pixel_format_queries;
+  }
+
+private:
+  friend class CacheIndex;
+  static Snapshot ReadEnvironment(std::span<const std::byte> bytes,
+                                  size_t &offset);
+  std::vector<u64> code;
+  std::vector<u32> pixel_format_queries;
+  std::map<u32, Shader::TextureType> types;
+  std::map<u32, Shader::TexturePixelFormat> formats;
+  std::map<u64, u32> cbufs;
+  std::map<u64, Shader::ReplaceConstant> replacements;
+  u32 lowest = 0, highest = 0, local_size = 0, texture_bound = 0, viewport = 0;
+  u32 shared_size = 0;
+  std::array<u32, 3> workgroup{};
+};
+struct CompiledPair {
+  std::vector<u32> vertex, fragment;
+  std::string resource_plan;
+};
+CompiledPair TranslatePair(std::vector<Snapshot> &snapshots);
+} // namespace native_shaders
diff --git a/native-runtime/shaders/probe.cpp b/native-runtime/shaders/probe.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/shaders/probe.cpp
@@ -0,0 +1,74 @@
+#include "native_shaders.h"
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+int main(int argc, char **argv) {
+  try {
+    if (argc != 3)
+      throw std::runtime_error(
+          "Usage: native_shader_probe owned-vulkan.bin output-dir");
+    std::ifstream in(argv[1], std::ios::binary | std::ios::ate);
+    if (!in)
+      throw std::runtime_error("Missing owned cache");
+    auto size = in.tellg();
+    if (size < 0 || size > 64 * 1024 * 1024)
+      throw std::runtime_error("Cache file size rejected");
+    std::vector<std::byte> bytes(static_cast<size_t>(size));
+    in.seekg(0);
+    if (!in.read(reinterpret_cast<char *>(bytes.data()), bytes.size()))
+      throw std::runtime_error("Cache read failed");
+    auto pair = native_shaders::Snapshot::ReadFirstPair(bytes);
+    unsigned rejected = 0;
+    auto reject = [&](auto call) {
+      try {
+        call();
+      } catch (const std::exception &) {
+        ++rejected;
+        return;
+      }
+      throw std::runtime_error("Expected bounds/metadata error absent");
+    };
+    reject([&] {
+      native_shaders::Snapshot::ReadFirstPair(std::span(bytes).first(8));
+    });
+    auto corrupt = bytes;
+    corrupt[8] = std::byte{0};
+    reject([&] { native_shaders::Snapshot::ReadFirstPair(corrupt); });
+    corrupt = bytes;
+    for (size_t i = 16; i < 24; ++i)
+      corrupt[i] = std::byte{0xff};
+    reject([&] { native_shaders::Snapshot::ReadFirstPair(corrupt); });
+    corrupt = bytes;
+    for (size_t i = 24; i < 32; ++i)
+      corrupt[i] = std::byte{0xff};
+    reject([&] { native_shaders::Snapshot::ReadFirstPair(corrupt); });
+    corrupt = bytes;
+    corrupt[80] = std::byte{5};
+    reject([&] { native_shaders::Snapshot::ReadFirstPair(corrupt); });
+    reject([&] { pair[0].ReadInstruction(UINT32_MAX); });
+    reject([&] { pair[0].ReadInstruction(pair[0].StartAddress() + 1); });
+    reject([&] { pair[0].ReadCbufValue(UINT32_MAX, UINT32_MAX); });
+    reject([&] { pair[0].ReadTextureType(UINT32_MAX); });
+    reject([&] { pair[0].ReadTexturePixelFormat(UINT32_MAX); });
+    auto compiled = native_shaders::TranslatePair(pair);
+    std::filesystem::create_directories(argv[2]);
+    auto out = std::filesystem::path(argv[2]);
+    for (auto &&item : {std::pair{"vertex", &compiled.vertex},
+                        std::pair{"fragment", &compiled.fragment}}) {
+      std::ofstream file(out / (std::string(item.first) + ".spv"),
+                         std::ios::binary);
+      file.write(reinterpret_cast<const char *>(item.second->data()),
+                 item.second->size() * 4);
+      if (!file)
+        throw std::runtime_error("SPIRV write failed");
+    }
+    std::ofstream(out / "resource-plan.json") << compiled.resource_plan;
+    std::cout << "{\"passed\":true,\"rejected_inputs\":" << rejected
+              << ",\"vertex_words\":" << compiled.vertex.size()
+              << ",\"fragment_words\":" << compiled.fragment.size() << "}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
