diff --git a/native-runtime/loader.cpp b/native-runtime/loader.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b2ced52e833970c3124da060a338c27eee3e2967
--- /dev/null
+++ b/native-runtime/loader.cpp
@@ -0,0 +1,92 @@
+#include "host.h"
+#include <algorithm>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <stdexcept>
+namespace native {
+static std::vector<uint8_t> file(const std::filesystem::path &p) {
+  std::ifstream f(p, std::ios::binary);
+  if (!f)
+    throw std::runtime_error("missing file");
+  return {(std::istreambuf_iterator<char>(f)), {}};
+}
+static uint64_t integer(const std::vector<uint8_t> &v, size_t at, size_t n) {
+  if (at > v.size() || n > v.size() - at)
+    throw std::runtime_error("metadata bounds");
+  uint64_t x = 0;
+  memcpy(&x, v.data() + at, n);
+  return x;
+}
+static void magic(const std::vector<uint8_t> &v, size_t at, const char *s) {
+  uint32_t expected;
+  memcpy(&expected, s, 4);
+  if (integer(v, at, 4) != expected)
+    throw std::runtime_error("metadata magic");
+}
+Loaded load_synthetic(const std::filesystem::path &root,
+                      const uint8_t *expected, size_t text_size) {
+  Loaded out;
+  auto nso = file(root / "main");
+  magic(nso, 0, "NSO0");
+  if (integer(nso, 12, 4) != 0)
+    throw std::runtime_error("unsupported compressed/hashed NSO");
+  out.image.resize(0x3000);
+  for (unsigned segment = 0; segment < 3; ++segment) {
+    auto field = 16 + 16 * segment;
+    auto off = integer(nso, field, 4), address = integer(nso, field + 4, 4),
+         size = integer(nso, field + 8, 4);
+    if (address != 4096 * segment || size != 4096 || off > nso.size() ||
+        size > nso.size() - off)
+      throw std::runtime_error("unsupported synthetic NSO segment");
+    memcpy(out.image.data() + address, nso.data() + off, size);
+  }
+  if (text_size != 4096 || memcmp(out.image.data(), expected, text_size))
+    throw std::runtime_error("static text identity mismatch");
+  auto npdm = file(root / "main.npdm");
+  magic(npdm, 0, "META");
+  if (integer(npdm, 12, 1) != 7)
+    throw std::runtime_error("unsupported process mode");
+  auto aci = integer(npdm, 0x70, 4), aci_size = integer(npdm, 0x74, 4);
+  if (aci > npdm.size() || aci_size > npdm.size() - aci)
+    throw std::runtime_error("ACI extent");
+  magic(npdm, aci, "ACI0");
+  out.program_id = integer(npdm, aci + 16, 8);
+  auto kac = integer(npdm, aci + 48, 4), kac_size = integer(npdm, aci + 52, 4);
+  if (kac > aci_size || kac_size > aci_size - kac || kac_size % 4)
+    throw std::runtime_error("capability bounds");
+  for (size_t i = 0; i < kac_size; i += 4) {
+    auto cap = integer(npdm, aci + kac + i, 4);
+    if ((cap & 31) == 15) {
+      auto group = cap >> 29, mask = (cap >> 5) & 0xffffff;
+      for (unsigned bit = 0; bit < 24; ++bit)
+        if (mask & (UINT64_C(1) << bit))
+          out.allowed_svcs.push_back(unsigned(group * 24 + bit));
+    }
+  }
+  for (unsigned required : {7u, 11u, 39u})
+    if (std::find(out.allowed_svcs.begin(), out.allowed_svcs.end(), required) ==
+        out.allowed_svcs.end())
+      throw std::runtime_error("missing required SVC capability");
+  auto rom = file(root / "romfs.bin");
+  if (integer(rom, 0, 8) != 0x50)
+    throw std::runtime_error("RomFS header");
+  auto meta = integer(rom, 56, 8), meta_size = integer(rom, 64, 8),
+       data = integer(rom, 72, 8);
+  if (meta > rom.size() || meta_size > rom.size() - meta || meta_size < 32)
+    throw std::runtime_error("RomFS metadata extent");
+  auto length = integer(rom, meta + 28, 4), offset = integer(rom, meta + 8, 8),
+       size = integer(rom, meta + 16, 8);
+  if (length > meta_size - 32 || data > rom.size() ||
+      offset > rom.size() - data || size > rom.size() - data - offset)
+    throw std::runtime_error("RomFS file extent");
+  out.romfs_name.assign(reinterpret_cast<const char *>(rom.data() + meta + 32),
+                        length);
+  if (out.romfs_name != "fixture.txt")
+    throw std::runtime_error("unsupported RomFS path");
+  out.romfs_data.assign(
+      reinterpret_cast<const char *>(rom.data() + data + offset), size);
+  return out;
+}
+} // namespace native
+
diff --git a/native-runtime/nso.cpp b/native-runtime/nso.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..566e407ab43d605ce998c76d68df7fd0ef019f8f
--- /dev/null
+++ b/native-runtime/nso.cpp
@@ -0,0 +1,148 @@
+#include "nso.h"
+#include <algorithm>
+#include <climits>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <limits>
+#include <stdexcept>
+#ifdef _WIN32
+#include <windows.h>
+
+#include <bcrypt.h>
+#endif
+#ifdef NATIVE_HAVE_LZ4
+extern "C" int LZ4_decompress_safe(const char *, char *, int, int);
+#endif
+namespace native {
+static uint64_t number(const std::vector<uint8_t> &v, size_t at,
+                       unsigned size) {
+  if (at > v.size() || size > v.size() - at)
+    throw std::runtime_error("NSO metadata bounds");
+  uint64_t x = 0;
+  memcpy(&x, v.data() + at, size);
+  return x;
+}
+static uint64_t aligned(uint64_t n) {
+  if (n > UINT64_MAX - 4095)
+    throw std::runtime_error("NSO alignment overflow");
+  return (n + 4095) & ~UINT64_C(4095);
+}
+static std::array<uint8_t, 32> sha256(const std::vector<uint8_t> &bytes) {
+#ifdef _WIN32
+  BCRYPT_ALG_HANDLE algorithm = nullptr;
+  std::array<uint8_t, 32> hash{};
+  if (BCryptOpenAlgorithmProvider(&algorithm, BCRYPT_SHA256_ALGORITHM, nullptr,
+                                  0) < 0)
+    throw std::runtime_error("SHA256 provider");
+  auto status =
+      BCryptHash(algorithm, nullptr, 0, const_cast<PUCHAR>(bytes.data()),
+                 ULONG(bytes.size()), hash.data(), ULONG(hash.size()));
+  BCryptCloseAlgorithmProvider(algorithm, 0);
+  if (status < 0)
+    throw std::runtime_error("SHA256 computation");
+  return hash;
+#else
+  (void)bytes;
+  throw std::runtime_error("hashed NSO requires native SHA256 backend");
+#endif
+}
+NsoImage load_nso(const std::filesystem::path &path) {
+  std::ifstream file(path, std::ios::binary | std::ios::ate);
+  if (!file)
+    throw std::runtime_error("missing NSO");
+  auto length = file.tellg();
+  if (length < 0x100 || length > 512 * 1024 * 1024)
+    throw std::runtime_error("NSO file size limit");
+  file.seekg(0);
+  std::vector<uint8_t> input(size_t(length), 0);
+  if (!file.read(reinterpret_cast<char *>(input.data()), length))
+    throw std::runtime_error("NSO read failure");
+  if (number(input, 0, 4) != 0x304f534e || number(input, 4, 4) != 0)
+    throw std::runtime_error("NSO magic/version");
+  auto flags = number(input, 12, 4);
+  if (flags & ~UINT64_C(63))
+    throw std::runtime_error("unsupported NSO flags");
+  NsoImage out;
+  out.name = path.filename().string();
+  memcpy(out.build_id.data(), input.data() + 0x40, 32);
+  std::array<std::pair<uint64_t, uint64_t>, 3> disk{};
+  for (unsigned i = 0; i < 3; ++i) {
+    auto &segment = out.segments[i];
+    uint64_t file_offset = number(input, 16 + 16 * i, 4),
+             raw_size = number(input, 24 + 16 * i, 4);
+    segment.offset = uint32_t(number(input, 20 + 16 * i, 4));
+    auto stored = (flags & (UINT64_C(1) << i)) ? number(input, 0x60 + 4 * i, 4)
+                                               : raw_size;
+    auto bss = i == 2 ? number(input, 28 + 16 * i, 4) : 0;
+    if (segment.offset % 4096 || !raw_size || raw_size > 256 * 1024 * 1024 ||
+        bss > 256 * 1024 * 1024 || file_offset < 0x100 ||
+        file_offset > input.size() || stored > input.size() - file_offset ||
+        !stored)
+      throw std::runtime_error("NSO segment bounds/alignment");
+    segment.memory_size = aligned(raw_size + bss);
+    segment.permission = i == 0 ? 5 : i == 1 ? 1 : 3;
+    segment.bytes.resize(size_t(raw_size));
+    disk[i] = {file_offset, stored};
+    if (flags & (UINT64_C(1) << i)) {
+#ifdef NATIVE_HAVE_LZ4
+      if (stored > INT_MAX || raw_size > INT_MAX ||
+          LZ4_decompress_safe(
+              reinterpret_cast<const char *>(input.data() + file_offset),
+              reinterpret_cast<char *>(segment.bytes.data()), int(stored),
+              int(raw_size)) != int(raw_size))
+        throw std::runtime_error("NSO LZ4 size/decode failure");
+#else
+      throw std::runtime_error(
+          "compressed NSO requires configured existing LZ4 library");
+#endif
+    } else
+      memcpy(segment.bytes.data(), input.data() + file_offset,
+             size_t(raw_size));
+    if (flags & (UINT64_C(1) << (3 + i))) {
+      auto hash = sha256(segment.bytes);
+      if (memcmp(hash.data(), input.data() + 0xa0 + 32 * i, 32))
+        throw std::runtime_error("NSO segment SHA256 mismatch");
+    }
+    auto end = uint64_t(segment.offset) + segment.memory_size;
+    if (end > 512 * 1024 * 1024)
+      throw std::runtime_error("NSO image size limit");
+    out.image_size = std::max(out.image_size, end);
+  }
+  for (unsigned i = 0; i < 3; ++i)
+    for (unsigned j = i + 1; j < 3; ++j) {
+      auto &a = out.segments[i];
+      auto &b = out.segments[j];
+      if (uint64_t(a.offset) < uint64_t(b.offset) + b.memory_size &&
+          uint64_t(b.offset) < uint64_t(a.offset) + a.memory_size)
+        throw std::runtime_error("NSO overlapping memory segments");
+      if (disk[i].first < disk[j].first + disk[j].second &&
+          disk[j].first < disk[i].first + disk[i].second)
+        throw std::runtime_error("NSO overlapping file segments");
+    }
+  out.dynstr_offset = uint32_t(number(input, 0x90, 4));
+  out.dynstr_size = uint32_t(number(input, 0x94, 4));
+  out.dynsym_offset = uint32_t(number(input, 0x98, 4));
+  out.dynsym_size = uint32_t(number(input, 0x9c, 4));
+  return out;
+}
+void map_nso(AddressSpace &space, const NsoImage &image, uint64_t base) {
+  if (base % 4096 || base > UINT64_MAX - image.image_size)
+    throw std::runtime_error("NSO base overflow/alignment");
+  for (const auto &segment : image.segments)
+    if (!space.can_map(base + segment.offset, segment.memory_size,segment.permission==3?4:3))
+      throw std::runtime_error("NSO map overlap/range");
+  for (const auto &segment : image.segments)
+    space.map(base + segment.offset, segment.bytes, segment.memory_size,
+              segment.permission,segment.permission==3?4:3);
+}
+std::string build_id_hex(const NsoImage &image) {
+  static const char hex[] = "0123456789abcdef";
+  std::string out;
+  for (auto c : image.build_id) {
+    out += hex[c >> 4];
+    out += hex[c & 15];
+  }
+  return out;
+}
+} // namespace native
