+"""Optional actual static CPU diagnostic. No emulator, renderer or GPU process."""
+import argparse,hashlib,json,os,re,subprocess
+from datetime import datetime,timezone
+from pathlib import Path
+p=argparse.ArgumentParser()
+for name in ('build','libs','runtime','exefs','lz4'):p.add_argument('--'+name,type=Path,required=True)
+p.add_argument("--memory-budget",type=int,default=4*1024**3)
+a=p.parse_args();build=a.build.resolve();build.mkdir(parents=True,exist_ok=True)
+source=Path(__file__).resolve().parents[2]/'native-runtime'
+flags={'creationflags':subprocess.BELOW_NORMAL_PRIORITY_CLASS if os.name=='nt' else 0}
+def digest(path):
+    h=hashlib.sha256()
+    with path.open('rb') as f:
+        for block in iter(lambda:f.read(1024*1024),b''):h.update(block)
+    return h.hexdigest()
+manifest_path=a.libs.parent/'aot_manifest.json';manifest=json.loads(manifest_path.read_text())
+assert manifest['image_abi']==6 and manifest['image_features']==7 and not manifest['fallback_enabled'] and not manifest['requires_runtime_codegen']
+ids={row['name']:row['build_id'] for row in manifest['modules']}
+proof={'physical_budget':a.memory_budget,'manifest_sha256':digest(manifest_path),'inputs':{},'execute_guest_cpu':False,'emulator':False,'graphics':False,'performance_qualified':False}
+for name in ('rtld','main','subsdk0','sdk'):
+    nso=a.exefs/name
+    with nso.open('rb') as f:header=f.read(256)
+    assert header[0x40:0x60].hex()==ids[name],name+' module identity mismatch'
+    lib=a.libs/('recomp_static_'+name+'.lib')
+    proof['inputs'][name]={'nso_sha256':digest(nso),'archive_sha256':digest(lib),'build_id':ids[name]}
+for name in ('recomp_runtime.h','recomp_runtime.c'):proof['inputs'][name]=digest(a.runtime/name)
+proof['inputs']['lz4']=digest(a.lz4)
+source_files=[p for p in source.iterdir() if p.is_file() and p.suffix in ('.cpp','.h','.txt')]
+source_files += [p for p in (source/'services').rglob('*') if p.is_file() and p.suffix in ('.cpp','.h','.txt')]
+proof['source_sha256']={p.relative_to(source).as_posix():digest(p) for p in sorted(source_files)}
+proof['runner_sha256']=digest(Path(__file__))
+commands=[['cmake','-S',source,'-B',build,'-DNATIVE_REAL_LIBS='+a.libs.resolve().as_posix(),'-DNATIVE_REAL_RUNTIME='+a.runtime.resolve().as_posix(),'-DNATIVE_LZ4_LIBRARY='+a.lz4.resolve().as_posix()],['cmake','--build',build,'--config','Release','--target','native_boot','--parallel','2']]
+with (build/'build.log').open('w') as log:
+    for command in commands:
+        print(' '.join(map(str,command)),flush=True);subprocess.run(list(map(str,command)),stdout=log,stderr=subprocess.STDOUT,check=True,**flags)
+exe=next(path for path in (build/'Release/native_boot.exe',build/'native_boot') if path.exists())
+lm_sink=build/('lm-'+datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')+'.jsonl')
+proof['lm_sink']=str(lm_sink)
+try:
+    result=subprocess.run([str(exe),str(a.exefs.resolve()),str(a.memory_budget),str(lm_sink)],text=True,capture_output=True,timeout=60,**flags)
+    output=result.stdout+result.stderr;proof['exit_code']=result.returncode
+except subprocess.TimeoutExpired as e:
+    output=(e.stdout or b'').decode(errors='replace')+(e.stderr or b'').decode(errors='replace');proof['exit_code']='timeout';proof['bounded_timeout']=True
+(build/'execution.log').write_text(output)
+proof['exe_sha256']=digest(exe)
+proof['lm_sink_sha256']=digest(lm_sink) if lm_sink.exists() else None
+proof['stop']=next((line for line in output.splitlines() if line.startswith('STOP ')),None)
+blocks=re.search(r'\bblocks=(\d+)',proof['stop'] or '')
+proof['execute_guest_cpu']=bool(blocks and int(blocks[1])>0)
+proof['guard_contract']='owned private code sealed; first entry verifies, generation cache thereafter; no executable remap/protection/alias path'
+proof['clock']='steady19.2MHz; native positive single-thread sleep'
+proof['registers']={name:int(value,16) for name,value in re.findall(r'\b(x\d+)=0x([0-9a-f]+)',output)}
+proof['ipc_words']={int(index):int(value,16) for index,value in re.findall(r'ipc_word(\d+)=0x([0-9a-f]+)',output)}
+sessions=re.search(r'native_sessions=(\d+)',output)
+proof['native_session_count']=int(sessions[1]) if sessions else None
+map_text=(build/'native_boot.map').read_text(errors='replace')
+assert not re.search(r'Dynarmic|ArmRecomp|KThread|Core@System|vulkan|SDL_|Qt[0-9]',map_text,re.I),'Forbidden runtime host dependency'
+if os.name=='nt':
+    dumpbin=next(iter(sorted(Path('C:/Program Files/Microsoft Visual Studio').glob('*/*/VC/Tools/MSVC/*/bin/Hostx64/x64/dumpbin.exe'))))
+    deps=subprocess.run([str(dumpbin),'/DEPENDENTS',str(exe)],text=True,capture_output=True,check=True,**flags).stdout
+    (build/'dependencies.txt').write_text(deps)
+    proof['dlls']=re.findall(r'^\s+([^\s]+\.dll)\s*$',deps,re.I|re.M)
+    assert proof['dlls'] and all(name.lower() in ('kernel32.dll','bcrypt.dll') for name in proof['dlls'])
+(build/'proof.json').write_text(json.dumps(proof,indent=2))
+print(output,flush=True)
+print('Diagnostic captured; unsupported stop is not a title boot or gameplay pass',flush=True)
