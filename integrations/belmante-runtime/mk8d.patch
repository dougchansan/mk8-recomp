+inline std::array<char,16> native_display_version(std::span<const uint8_t> bytes) {
+    if(bytes.size()!=0x4000)throw std::invalid_argument("NACP extent");
+    const auto field=bytes.subspan(0x3060,16);
+    const auto end=std::find(field.begin(),field.end(),uint8_t(0));
+    if(end==field.begin()||end==field.end()||!std::all_of(field.begin(),end,[](uint8_t value){return value>=0x20&&value<=0x7e;}))throw std::invalid_argument("NACP display version");
+    std::array<char,16> result{};std::copy(field.begin(),end,result.begin());return result;
+}
