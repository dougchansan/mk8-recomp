+void Need(bool b, const char *w) {
+  if (!b)
+    throw std::runtime_error(w);
+}
+void Check(VkResult r, const char *w) {
+  if (r != VK_SUCCESS)
+    throw std::runtime_error(std::string(w) + " VkResult=" + std::to_string(r));
+}
+} // namespace
+void PresentationFlight::Acquire(AcquireStatus s) {
+  Need(!acquired && !present_pending, "Flight already owns image");
+  if (s == AcquireStatus::Pending)
+    return;
+  if (s == AcquireStatus::OutOfDate) {
+    recreate = true;
+    return;
+  }
+  if (s == AcquireStatus::Failed) {
+    terminal = true;
+    return;
+  }
+  acquired = true;
+  recreate = s == AcquireStatus::Suboptimal;
+}
+void PresentationFlight::RenderComplete() {
+  Need(acquired && !rendered, "Render completion without acquisition");
+  acquire_consumed = true;
+  rendered = true;
+}
+void PresentationFlight::Present(PresentStatus s) {
+  Need(acquired && rendered, "Present without completed render");
+  if (s == PresentStatus::DeviceLost) {
+    terminal = true;
+    return;
+  }
+  if (s == PresentStatus::NotEnqueued) {
+    terminal = true;
+    return;
+  }
+  present_pending = true;
+  recreate |= s == PresentStatus::Suboptimal || s == PresentStatus::OutOfDate;
+}
+void PresentationFlight::SynchronizationConsumed() {
+  Need(acquired, "No acquired synchronization");
+  acquire_consumed = true;
+  if (rendered)
+    render_consumed = true;
+}
+void PresentationFlight::Retired() {
+  acquired = false;
+  acquire_consumed = false;
+  rendered = false;
+  render_consumed = false;
+  present_pending = false;
+}
+Retirement PresentationFlight::RequiredRetirement() const {
+  if (present_pending)
+    return Retirement::WaitPresent;
+  if (acquired) {
+    if (rendered)
+      return render_consumed ? Retirement::ReleaseImage
+                             : Retirement::ConsumeRender;
+    return acquire_consumed ? Retirement::ReleaseImage
+                            : Retirement::ConsumeAcquire;
+  }
+  return Retirement::None;
+}
+double EncodeSrgb(double v) {
+  Need(std::isfinite(v), "Nonfinite presentation color");
+  v = std::clamp(v, 0., 1.);
+  return v <= .0031308 ? 12.92 * v : 1.055 * std::pow(v, 1. / 2.4) - .055;
+}
+std::shared_ptr<const native_graphics::Win32SurfaceTarget>
+RetainPresentationWindow(std::shared_ptr<native::Window> w) {
+  Need(bool(w), "Presentation window missing");
+  auto target = std::make_shared<native_graphics::Win32SurfaceTarget>();
+  target->window_owner = w;
+  target->surface_pin = w->PinSurface();
+  target->window = reinterpret_cast<uintptr_t>(w->handle());
+  target->instance = reinterpret_cast<uintptr_t>(w->instance_handle());
+  target->owner_thread = std::this_thread::get_id();
+  return target;
+}
+namespace {
+struct Loader {
+  HMODULE module = LoadLibraryW(L"vulkan-1.dll");
+  VkInstance instance{};
+  VkDevice device{};
+  ~Loader() {
+    if (module)
+      FreeLibrary(module);
+  }
+  template <class T> T Get(const char *n) {
+    if (!module)
+      throw std::runtime_error("Vulkan presentation loader unavailable");
+    auto p = GetProcAddress(module, n);
+    if (!p && device) {
+      auto get = reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+          GetProcAddress(module, "vkGetDeviceProcAddr"));
+      if (get)
+        p = reinterpret_cast<FARPROC>(get(device, n));
+    }
+    if (!p && instance) {
+      auto get = reinterpret_cast<PFN_vkGetInstanceProcAddr>(
+          GetProcAddress(module, "vkGetInstanceProcAddr"));
+      if (get)
+        p = reinterpret_cast<FARPROC>(get(instance, n));
+    }
+    Need(p, "Missing WSI Vulkan function");
+    return reinterpret_cast<T>(p);
+  }
+};
+#define P(name) loader.Get<PFN_##name>(#name)
+std::vector<uint32_t> ConversionShader(bool vertex, bool encode) {
+  Sirit::Module m(0x00010000);
+  m.AddCapability(spv::Capability::Shader);
+  m.SetMemoryModel(spv::AddressingModel::Logical, spv::MemoryModel::GLSL450);
+  auto f = m.TypeFloat(32), v2 = m.TypeVector(f, 2), v4 = m.TypeVector(f, 4);
+  auto out = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Output, v4),
+                                 spv::StorageClass::Output);
+  Sirit::Id input{}, uvout{}, texture{}, sampletype{};
+  if (vertex) {
+    m.Decorate(out, spv::Decoration::BuiltIn, spv::BuiltIn::Position);
+    input = m.AddGlobalVariable(
+        m.TypePointer(spv::StorageClass::Input, m.TypeInt(32, true)),
+        spv::StorageClass::Input);
+    m.Decorate(input, spv::Decoration::BuiltIn, spv::BuiltIn::VertexIndex);
+    uvout = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Output, v2),
+                                spv::StorageClass::Output);
+    m.Decorate(uvout, spv::Decoration::Location, 0u);
+  } else {
+    m.Decorate(out, spv::Decoration::Location, 0u);
+    input = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Input, v2),
+                                spv::StorageClass::Input);
+    m.Decorate(input, spv::Decoration::Location, 0u);
+    auto image = m.TypeImage(f, spv::Dim::Dim2D, 0, false, false, 1,
+                             spv::ImageFormat::Unknown);
+    sampletype = m.TypeSampledImage(image);
+    texture = m.AddGlobalVariable(
+        m.TypePointer(spv::StorageClass::UniformConstant, sampletype),
+        spv::StorageClass::UniformConstant);
+    m.Decorate(texture, spv::Decoration::DescriptorSet, 0u);
+    m.Decorate(texture, spv::Decoration::Binding, 0u);
+  }
+  auto zero = m.Constant(f, 0.f), one = m.Constant(f, 1.f),
+       minus = m.Constant(f, -1.f), three = m.Constant(f, 3.f),
+       half = m.Constant(f, .5f);
+  auto int1 = m.Constant(m.TypeInt(32, true), 1),
+       int2 = m.Constant(m.TypeInt(32, true), 2);
+  auto threshold = m.Constant(f, .0031308f), slope = m.Constant(f, 12.92f),
+       scale = m.Constant(f, 1.055f), bias = m.Constant(f, .055f),
+       power = m.Constant(f, 1.f / 2.4f);
+  auto fn = m.OpFunction(m.TypeVoid(), spv::FunctionControlMask::MaskNone,
+                         m.TypeFunction(m.TypeVoid()));
+  m.AddLabel();
+  if (vertex) {
+    auto index = m.OpLoad(m.TypeInt(32, true), input);
+    auto x = m.OpSelect(f, m.OpIEqual(m.TypeBool(), index, int1), three, minus),
+         y = m.OpSelect(f, m.OpIEqual(m.TypeBool(), index, int2), three, minus);
+    m.OpStore(out, m.OpCompositeConstruct(v4, x, y, zero, one));
+    m.OpStore(uvout, m.OpCompositeConstruct(
+                         v2, m.OpFAdd(f, m.OpFMul(f, x, half), half),
+                         m.OpFAdd(f, m.OpFMul(f, y, half), half)));
+  } else {
+    auto color = m.OpImageSampleImplicitLod(v4, m.OpLoad(sampletype, texture),
+                                            m.OpLoad(v2, input));
+    Sirit::Id channels[3];
+    for (unsigned i = 0; i < 3; ++i) {
+      auto c = m.OpCompositeExtract(f, color, i);
+      if (encode)
+        c = m.OpSelect(
+            f, m.OpFOrdLessThanEqual(m.TypeBool(), c, threshold),
+            m.OpFMul(f, c, slope),
+            m.OpFSub(f, m.OpFMul(f, scale, m.OpPow(f, c, power)), bias));
+      channels[i] = c;
+    }
+    m.OpStore(out, m.OpCompositeConstruct(v4, channels[0], channels[1],
+                                          channels[2], one));
+  }
+  m.OpReturn();
+  m.OpFunctionEnd();
+  if (vertex)
+    m.AddEntryPoint(spv::ExecutionModel::Vertex, fn, "main", input, out, uvout);
+  else {
+    m.AddEntryPoint(spv::ExecutionModel::Fragment, fn, "main", input, out);
+    m.AddExecutionMode(fn, spv::ExecutionMode::OriginUpperLeft);
+  }
+  return m.Assemble();
+}
+} // namespace
+std::vector<uint32_t> PresentationVertexShader() {
+  return ConversionShader(true, false);
+}
+std::vector<uint32_t> PresentationFragmentShader(bool encode) {
+  return ConversionShader(false, encode);
+}
+struct Presenter::Impl {
+  struct Image {
+    VkImage image{};
+    VkImageView view{};
+    VkSemaphore finished{};
+    VkFence present{};
+    bool present_pending = false, initialized = false;
+  };
+  Resources &resources;
+  GuestAddress key;
+  Resources::Lease device_lease;
+  std::shared_ptr<native::Window> window;
+  native_graphics::VulkanHandles handles;
+  Loader loader;
+  VkDevice device;
+  VkPhysicalDevice physical;
+  VkQueue queue;
+  VkSurfaceKHR surface;
+  VkSwapchainKHR swapchain{};
+  VkSemaphore acquire{};
+  std::vector<Image> images;
+  std::array<uint32_t, 2> extent{};
+  PresentationFormat format = PresentationFormat::Bgra8Srgb;
+  std::thread::id owner = std::this_thread::get_id();
+  PresentationCounters counters;
+  PresentationFlight flight;
+  std::optional<uint32_t> acquired_index;
+  bool closed = false, terminal = false, device_lost = false;
+  std::vector<uint32_t> vertex, fragment;
+  DescriptorPlan plan{0, DescriptorKind::CombinedImageSampler2D,
+                      ShaderStage::Fragment};
+  Impl(Resources &r, GuestAddress k, std::shared_ptr<native::Window> w)
+      : resources(r), key(k), device_lease(r.PinDevice(k)),
+        window(std::move(w)),
+        handles(device_lease.Backend().GetNativeHandles()),
+        device(reinterpret_cast<VkDevice>(handles.device)),
+        physical(reinterpret_cast<VkPhysicalDevice>(handles.physical_device)),
+        queue(reinterpret_cast<VkQueue>(handles.queue)),
+        surface(reinterpret_cast<VkSurfaceKHR>(
+            device_lease.Backend().PresentationSurface())) {
+    Need(window && surface, "Device has no retained presentation surface");
+    Need(device_lease.Backend().PresentationWindow() ==
+             reinterpret_cast<uintptr_t>(window->handle()),
+         "Device surface belongs to another window");
+    loader.instance = reinterpret_cast<VkInstance>(handles.instance);
+    loader.device = device;
+    VkSemaphoreCreateInfo ci{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+    Check(P(vkCreateSemaphore)(device, &ci, nullptr, &acquire),
+          "Create acquire semaphore");
+    try {
+      Recreate();
+    } catch (...) {
+      P(vkDestroySemaphore)(device, acquire, nullptr);
+      acquire = VK_NULL_HANDLE;
+      throw;
+    }
+  }
+  void Owner() const {
+    Need(owner == std::this_thread::get_id(),
+         "Presenter owner thread mismatch");
+  }
+  void Pump() { window->Pump(); }
+  bool Wait(VkFence fence, bool forever) {
+    const auto deadline =
+        std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    for (;;) {
+      auto r = P(vkWaitForFences)(device, 1, &fence, VK_TRUE, 1'000'000);
+      Pump();
+      if (r == VK_SUCCESS)
