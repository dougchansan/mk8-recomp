+// SPDX-FileCopyrightText: Copyright 2026 suyu Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "router.h"
+#include <filesystem>
+
+namespace native_services {
+struct LogRecord {
+    uint64_t process_id{}, claimed_process_id{}, thread_id{};
+    uint32_t destination{};
+    uint8_t flags{}, severity{}, verbosity{};
+    std::vector<std::byte> packet;
+    std::string text;
+};
+class LogSink {
+public:
+    virtual ~LogSink() = default;
+    // Must actually deliver the record, or fail. Failure stops bring-up before
+    // returning to guest code; logging success is never silently fabricated.
+    virtual bool Deliver(const LogRecord&) = 0;
+};
+// Creates a new file exclusively. Never overwrites or appends an existing file.
+// Caller supplies an explicitly owned diagnostic output path.
+std::shared_ptr<LogSink> CreateFileLogSink(const std::filesystem::path& path,
+                                        uint64_t max_bytes = 8u << 20,
+                                        uint64_t max_records = 4096);
+std::unique_ptr<Endpoint> CreateLoggingService(std::shared_ptr<LogSink> sink);
+} // namespace native_services
diff --git a/native-runtime/services/performance.cpp b/native-runtime/services/performance.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/services/performance.cpp
@@ -0,0 +1,86 @@
+// SPDX-FileCopyrightText: Copyright 2026 suyu Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Command/enum source: src/core/hle/service/apm/apm_interface.cpp and
+// apm_controller.{h,cpp}. Native policy deliberately has no frequency claims.
+#include "performance.h"
+#include <stdexcept>
+
+namespace native_services {
+bool PerformancePolicy::ValidMode(uint32_t mode) { return mode<=1; }
+bool PerformancePolicy::ValidConfiguration(uint32_t value) {
+    return (value>=0x10000 && value<=0x10002) ||
+           (value>=0x20000 && value<=0x20006) ||
+           (value>=0x92220007 && value<=0x9222000c);
+}
+PerformancePolicy::PerformancePolicy(uint64_t pid,PerformanceMode mode,uint32_t normal,uint32_t docked)
+    :process_id_(pid),state_{mode,{normal,docked},0} {
+    if(!pid || !ValidMode(uint32_t(mode)) || !ValidConfiguration(normal) || !ValidConfiguration(docked))
+        throw std::invalid_argument("native APM requires explicit valid owned process policy");
+}
+PerformanceSnapshot PerformancePolicy::Snapshot() const {
+    std::lock_guard lock(mutex_);return state_;
+}
+void PerformancePolicy::SetConfiguration(PerformanceMode mode,uint32_t value) {
+    if(!ValidMode(uint32_t(mode)) || !ValidConfiguration(value))
+        throw std::invalid_argument("invalid native performance policy configuration");
+    std::lock_guard lock(mutex_);
+    state_.configurations[uint32_t(mode)]=value;++state_.revision;
+}
+namespace {
+uint32_t Word(std::span<const std::byte> b,size_t at) {
+    uint32_t n=0;for(unsigned i=0;i<4;++i)n|=uint32_t(b[at+i])<<(8*i);return n;
+}
+Reply Decline(Status status,std::string message) { return {status,0,{},std::move(message),{},nullptr}; }
+Reply Value(uint32_t value) {
+    Reply reply;reply.status=Status::Ok;reply.payload.resize(4);
+    for(unsigned i=0;i<4;++i)reply.payload[i]=std::byte(value>>(8*i));
+    return reply;
+}
+class PerformanceSession final:public Endpoint {
+    std::shared_ptr<PerformancePolicy> policy_;
+public:
+    explicit PerformanceSession(std::shared_ptr<PerformancePolicy> policy):policy_(std::move(policy)){}
+    Reply Prepare(const Request& r) override {
+        if(r.process_id!=policy_->ProcessId())return Decline(Status::InvalidProcess,"APM session is owned by another process");
+        if(!r.read_buffers.empty())return Decline(Status::Unsupported,"APM session buffer descriptors are not implemented");
+        if(r.command==0 || r.command==1) {
+            const size_t needed=r.command==0?8:4;
+            if(r.payload.size()<needed)return Decline(Status::Malformed,"APM performance configuration arguments are truncated");
+            const uint32_t mode=Word(r.payload,0);
+            if(!PerformancePolicy::ValidMode(mode))return Decline(Status::Malformed,"APM performance mode is invalid");
+            if(r.command==1)return Value(policy_->Snapshot().configurations[mode]);
+            const uint32_t configuration=Word(r.payload,4);
+            if(!PerformancePolicy::ValidConfiguration(configuration))return Decline(Status::Malformed,"APM performance configuration is invalid");
+            return {Status::Ok,0,{},{},[policy=policy_,mode,configuration] {
+                policy->SetConfiguration(PerformanceMode(mode),configuration);
+            },nullptr};
+        }
+        return Decline(Status::Unsupported,"APM session command requires unimplemented host effects: "+std::to_string(r.command));
+    }
+};
+class PerformanceService final:public Endpoint {
+    std::shared_ptr<PerformancePolicy> policy_;
+public:
+    explicit PerformanceService(std::shared_ptr<PerformancePolicy> policy):policy_(std::move(policy)){}
+    Reply Prepare(const Request& r) override {
+        if(r.process_id!=policy_->ProcessId())return Decline(Status::InvalidProcess,"APM is owned by another process");
+        if(!r.read_buffers.empty())return Decline(Status::Unsupported,"APM buffer descriptors are not implemented");
+        if(r.command==0) {
+            Reply reply;reply.status=Status::Ok;
+            reply.moved_endpoint=std::make_unique<PerformanceSession>(policy_);return reply;
+        }
+        if(r.command==1) {
+            // Matched SDK nn::apm::GetPerformanceMode (+0xd0624) checks the
+            // CMIF result, then reads an Out<PerformanceMode>. Do not reproduce
+            // the older HLE handler's missing ResultSuccess push.
+            return Value(uint32_t(policy_->Snapshot().mode));
+        }
+        return Decline(Status::Unsupported,"APM command requires unimplemented telemetry/host effects: "+std::to_string(r.command));
+    }
+};
+} // namespace
+std::unique_ptr<Endpoint> CreatePerformanceService(std::shared_ptr<PerformancePolicy> policy) {
+    if(!policy)throw std::invalid_argument("native APM requires an actual process-owned policy");
+    return std::make_unique<PerformanceService>(std::move(policy));
+}
+} // namespace native_services
