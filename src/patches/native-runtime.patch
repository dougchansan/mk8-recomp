new file mode 100644
index 0000000000000000000000000000000000000000..91028a7d940483531e684882ca3daf6b27e2e321
--- /dev/null
+++ b/native-runtime/nvn/buffer_init.h
@@ -0,0 +1,45 @@
+#pragma once
+#include "resources.h"
+namespace native_nvn {
+enum class BufferInitOutcome { Decline, Success, Failure, Fault };
+struct BufferInitResult {
+  BufferInitOutcome outcome;
+  uint32_t value = 0;
+};
+struct BufferInitMemory {
+  void *user = nullptr;
+  // Pure NORMAL-owned-RAM checks/snapshots, never bus reads/fault callbacks.
+  bool (*probe)(void *, uint64_t, size_t, bool write) = nullptr;
+  bool (*peek)(void *, uint64_t, std::span<std::byte>) = nullptr;
+  bool (*read)(void *, uint64_t, std::span<std::byte>) = nullptr;
+  bool (*write)(void *, uint64_t, std::span<const std::byte>) = nullptr;
+};
+// Verified builder schema: device,pool,offset,size at +0,+8,+16,+24;
+// output is 48 bytes; pool validation byte at +17, bit0 forbids initialization.
+// No title addresses are selected here. Registration is only for native-owned
+// pools; reference objects must never be registered. Owner-thread/quiescent
+// metadata; no output alias with builder/pool object. All calls are synchronous
+// bounded metadata/view bookkeeping; they allocate no GPU storage and wait on
+// no GPU.
+class BufferInitializer {
+public:
+  BufferInitializer(Resources &, BufferInitMemory);
+  void RegisterPool(GuestAddress pool, GuestAddress device, uint64_t size,
+                    size_t object_bytes);
+  void UnregisterPool(GuestAddress pool);
+  BufferInitResult Initialize(GuestAddress output, GuestAddress builder);
+  void Finalize(GuestAddress output);
+
+private:
+  struct OwnedPool {
+    GuestAddress device;
+    uint64_t size;
+    size_t object_bytes;
+  };
+  Resources &resources_;
+  BufferInitMemory memory_;
+  std::map<GuestAddress, OwnedPool> pools_;
+  std::thread::id owner_;
+  void CheckOwner() const;
+};
+} // namespace native_nvn
diff --git a/native-runtime/nvn/buffer_init_notes.md b/native-runtime/nvn/buffer_init_notes.md
new file mode 100644
index 0000000000000000000000000000000000000000..a8ee0f56136bdfeb9add9bfa2f1fc638ff46128f
--- /dev/null
+++ b/native-runtime/nvn/buffer_init_notes.md
@@ -0,0 +1,50 @@
+# Native API boundary progress and next ownership chain
+
+`buffer_init.h/.cpp` implement synchronous bounded buffer metadata initialization
+using an already native-owned pool. Pure owned-RAM preflight excludes aliasing,
+unsupported ownership and unstable metadata before observable effects. Success
+publishes the verified public fields; forbidden pool flag returns zero after
+the declared clear. Actual callback faults retain declared partial guest bytes,
+roll back the native view and never fall back to reference execution.
+
+The generated v2 bridge independently requires full module identity/text digest,
+all skipped block words, a sealed-image attestation and AAPCS/layout negotiation.
+It preserves the existing v1/legacy route and charges only actual enclosing block
+dispatch, with native calls recorded separately. No GPU storage creation,
+compilation, wait or pending job is permitted by its synchronous metadata profile.
+
+Next steps, in dependency order:
+
+1. Complete the actual native device ownership contract. The observed public
+   DeviceInitialize boundary is an indirect provider thunk; its short named entry
+   is not evidence of the provider implementation. Resolve and pin that provider,
+   public failure/flags/object fields and lifecycle. Describe every excluded
+   driver callee by the native public effect that replaces it. Device creation
+   must run through an explicit host scheduling boundary or a reviewed pending
+   job model; calling the driver from a bounded metadata callback is insufficient.
+2. Complete MemoryPoolInitialize's exact flags and public object contract. The
+   observed wrapper clears a larger pool object, normalizes cache flags, calls a
+   constructor and indirect initialization method, and updates device-owned
+   registration/list state with failure cleanup. Those implementation internals
+   can become native-owned state only after all guest-visible consumers and
+   public errors are established. Do not copy another title's object layout,
+   flag defaults or assumption that GPU and CPU addresses are interchangeable.
+3. Use typed native descriptions for the already supported cached/no-access
+   subset. Unknown/uncached/virtual/physical modes remain explicit errors until
+   implemented. Vulkan allocation, backing upload and device setup remain outside
+   the current synchronous v2 capability. A future job must stage work then
+   publish the guest object exactly once; cancellation/failure rolls back native
+   objects and never fabricates success. Pending state must not reuse SVC values.
+4. Register completed native pools with BufferInitializer using verified device,
+   byte size and guest object extent. Preserve lifetime ordering: buffers before
+   pools, pools before device. Test repeated lifetimes, native/reference mixing,
+   write/read faults, cached/no-access coherence and actual guest API calls.
+
+The current closed-CFG v2 descriptor validator deliberately rejects external BL
+and indirect exits. Extending it for these larger APIs requires complete callee/
+tail-call identity and an explicit excluded-callee contract, not merely adding
+the first block to a descriptor. No such extension or pending implementation is
+claimed here. A pre-created native-owned pool fixture validates the current buffer
+step; it is not an actual DeviceInitialize→MemoryPoolInitialize chain or evidence
+of standalone title rendering. Exact private addresses, instruction bytes and
+original reference bodies remain outside this source tree.
diff --git a/native-runtime/nvn/draw.cpp b/native-runtime/nvn/draw.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..926b885b1b880e5e1e66e529c563d71d5106eec9
--- /dev/null
+++ b/native-runtime/nvn/draw.cpp
@@ -0,0 +1,851 @@
+#include "draw.h"
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#define VK_NO_PROTOTYPES
+#include <cmath>
+#include <cstring>
+#include <functional>
+#include <map>
+#include <memory>
+#include <set>
+#include <stdexcept>
+#include <vector>
+#include <vulkan/vulkan.h>
+#include <windows.h>
+namespace native_nvn {
+namespace {
+void Check(VkResult r, const char *operation) {
+  if (r != VK_SUCCESS)
+    throw std::runtime_error(std::string(operation) +
+                             " failed VkResult=" + std::to_string(r));
+}
+struct Owned {
+  HMODULE loader = LoadLibraryW(L"vulkan-1.dll");
+  std::vector<std::function<void()>> release;
+  ~Owned() {
+    for (auto i = release.rbegin(); i != release.rend(); ++i)
+      (*i)();
+    if (loader)
+      FreeLibrary(loader);
+  }
+  template <class T> T Get(const char *name) {
+    auto p = loader ? GetProcAddress(loader, name) : nullptr;
+    if (!p)
+      throw std::runtime_error(
+          std::string("Unsupported Vulkan loader export: ") + name);
+    return reinterpret_cast<T>(p);
+  }
+};
+#define V(name) owner.Get<PFN_##name>(#name)
+void Need(bool value, const char *message) {
+  if (!value)
+    throw std::runtime_error(message);
+}
+std::map<uint32_t, uint64_t>
+ValidateShader(std::span<const uint32_t> code, ShaderStage stage,
+               std::span<const DescriptorPlan> plan,
+               bool image_gather_extended) {
+  Need(code.size() >= 5 && code.size() <= 262144 && code[0] == 0x07230203 &&
+           code[1] <= 0x00010300,
+       "Unsupported SPIR-V header/version");
+  std::map<uint32_t, uint32_t> bindings, sets, storage;
+  std::map<uint32_t, uint32_t> variables, pointers, types, sampled_types,
+      image_types;
+  std::set<uint32_t> blocks;
+  std::map<uint32_t, std::vector<uint32_t>> type_words;
+  std::map<uint32_t, uint32_t> constants, array_stride;
+  std::map<std::pair<uint32_t, uint32_t>, uint32_t> member_offsets;
+  bool entry = false, model = false;
+  for (size_t offset = 5; offset < code.size();) {
+    const uint32_t size = code[offset] >> 16, op = code[offset] & 65535;
+    Need(size && size <= code.size() - offset, "Malformed SPIR-V instruction");
+    const auto *word = code.data() + offset;
+    if (op == 17)
+      Need(size == 2 &&
+               (word[1] == 0 || word[1] == 1 || word[1] == 50 ||
+                word[1] == 46 || (word[1] == 25 && image_gather_extended)),
+           "SPIR-V capability not enabled by native backend");
+    if (op == 10)
+      throw std::runtime_error("SPIR-V extensions unsupported");
+    if (op == 14) {
+      Need(size == 3 && word[1] == 0 && word[2] == 1,
+           "SPIR-V memory model unsupported");
+      model = true;
+    }
+    if (op == 15) {
+      Need(size >= 5 && word[1] == (stage == ShaderStage::Vertex ? 0u : 4u) &&
+               word[3] == 0x6e69616d && word[4] == 0,
+           "SPIR-V requires single main entry");
+      Need(!entry, "Multiple entry points unsupported");
+      entry = true;
+    }
+    if (op == 71 && size == 3 && word[2] == 2)
+      blocks.insert(word[1]);
+    if (op == 71 && size >= 4) {
+      if (word[2] == 6)
+        array_stride[word[1]] = word[3];
+      if (word[2] == 33)
+        bindings[word[1]] = word[3];
+      if (word[2] == 34)
+        sets[word[1]] = word[3];
+    }
+    if (op == 72 && size == 5 && word[3] == 35)
+      member_offsets[{word[1], word[2]}] = word[4];
+    if (op == 43 && size == 4)
+      constants[word[2]] = word[3];
+    if (op == 59) {
+      Need(size >= 4, "Malformed variable");
+      storage[word[2]] = word[3];
+      variables[word[2]] = word[1];
+      Need(word[3] != 9 && word[3] != 12,
+           "Push constants/storage buffers unsupported");
+    }
+    if (op >= 19 && op <= 33 && size >= 2) {
+      types[word[1]] = op;
+      type_words[word[1]] = std::vector<uint32_t>(word, word + size);
+    }
+    if (op == 32) {
+      Need(size == 4, "Malformed pointer type");
+      pointers[word[1]] = word[3];
+    }
+    if (op == 27) {
+      Need(size == 3, "Malformed sampled image type");
+      sampled_types[word[1]] = word[2];
+    }
+    if (op == 25)
+      Need(size >= 9 && word[3] == 1 && word[4] == 0 && word[5] == 0 &&
+               word[6] == 0 && word[7] == 1,
+           "Only sampled nonarray 2D float images supported");
+    if (op == 25)
+      image_types[word[1]] = word[2];
+    if (op == 21)
+      Need(size == 4 && word[2] == 32, "Only 32-bit integers supported");
+    if (op == 22)
+      Need(size == 3 && word[2] == 32, "Only 32-bit floats supported");
+    if (op >= 48 && op <= 52)
+      throw std::runtime_error("Specialization constants unsupported");
+    offset += size;
+  }
+  Need(entry && model, "Missing SPIR-V entry/model");
+  for (const auto &[id, kind] : storage)
+    if (kind == 0 || kind == 2)
+      Need(bindings.contains(id) && sets.contains(id),
+           "Undeclared shader descriptor");
+  std::set<uint32_t> found;
+  std::map<uint32_t, uint64_t> minimum;
+  std::set<uint32_t> sizing;
+  std::function<uint64_t(uint32_t)> byte_size = [&](uint32_t type) -> uint64_t {
+    Need(sizing.size() < 32 && sizing.insert(type).second &&
+             type_words.contains(type),
+         "Recursive/missing uniform type unsupported");
+    const auto &words = type_words.at(type);
+    uint64_t bytes = 0;
+    if (types[type] == 21 || types[type] == 22)
+      bytes = 4;
+    else if (types[type] == 23) {
+      Need(words.size() == 4 && words[3] <= 4, "Uniform vector unsupported");
+      bytes = byte_size(words[2]) * words[3];
+    } else if (types[type] == 28) {
+      Need(words.size() == 4 && constants.contains(words[3]) &&
+               array_stride.contains(type),
+           "Uniform array layout unknown");
+      const auto stride = array_stride.at(type), count = constants.at(words[3]);
+      const auto element = byte_size(words[2]);
+      Need(count && count <= 65536 && stride >= element,
+           "Uniform array stride/count invalid");
+      bytes = uint64_t(stride) * (count - 1) + element;
+    } else if (types[type] == 30) {
+      for (uint32_t i = 2; i < words.size(); i++) {
+        Need(member_offsets.contains({type, i - 2}),
+             "Uniform member offset unknown");
+        bytes = std::max(bytes, uint64_t(member_offsets.at({type, i - 2})) +
+                                    byte_size(words[i]));
+      }
+    } else
+      throw std::runtime_error(
+          "Uniform type requires unsupported layout metadata");
+    sizing.erase(type);
+    Need(bytes && bytes <= 65536, "Uniform block size unsupported");
+    return bytes;
+  };
+  for (const auto &[id, binding] : bindings) {
+    Need(sets.contains(id) && sets[id] == 0 && storage.contains(id),
+         "Only explicit descriptor set0 supported");
+    const DescriptorPlan *declared = nullptr;
+    for (const auto &item : plan)
+      if (item.binding == binding && item.stage == stage)
+        declared = &item;
+    Need(declared && found.insert(binding).second,
+         "Descriptor metadata mismatch");
+    Need(storage[id] ==
+             (declared->kind == DescriptorKind::UniformBuffer ? 2u : 0u),
+         "Descriptor storage class mismatch");
+    Need(pointers.contains(variables[id]), "Descriptor pointer type missing");
+    const auto type = pointers[variables[id]];
+    if (declared->kind == DescriptorKind::UniformBuffer) {
+      Need(types[type] == 30 && blocks.contains(type),
+           "Only scalar uniform blocks supported");
+      minimum[binding] = byte_size(type);
+    } else
+      Need(types[type] == 27 && sampled_types.contains(type) &&
+               types[sampled_types[type]] == 25 &&
+               types[image_types[sampled_types[type]]] == 22,
+           "Only scalar combined image descriptors supported");
+  }
+  for (const auto &item : plan)
+    if (item.stage == stage)
+      Need(found.contains(item.binding),
+           "Unused or missing descriptor plan entry");
+  return minimum;
+}
+void Validate(Resources &resources, GuestAddress device,
+              const ProgramDescription &program, const DrawDescription &draw) {
+  resources.Backend(device);
+  Need(draw.width && draw.height && draw.width <= 2048 && draw.height <= 2048,
+       "Target size unsupported");
+  Need(draw.stride >= 16 && draw.stride <= 2048 && !(draw.stride & 3) &&
+           draw.count && draw.count <= 1048576,
+       "Vertex stride/count unsupported");
+  Need(draw.topology == Topology::Triangles ||
+           draw.topology == Topology::TriangleStrip,
+       "Topology unsupported");
+  Need(draw.blend == Blend::Disabled || draw.blend == Blend::SourceAlpha,
+       "Blend unsupported");
+  Need(draw.index_format == IndexFormat::None ||
+           draw.index_format == IndexFormat::Uint16 ||
+           draw.index_format == IndexFormat::Uint32,
+       "Index format unsupported");
+  const auto &vp = draw.viewport;
+  Need(std::isfinite(vp.x) && std::isfinite(vp.y) && std::isfinite(vp.width) &&
+           std::isfinite(vp.height) && vp.x >= 0 && vp.y >= 0 && vp.width > 0 &&
+           vp.height > 0 && vp.x + vp.width <= draw.width &&
+           vp.y + vp.height <= draw.height,
+       "Viewport unsupported");
+  Need(draw.scissor.width && draw.scissor.height &&
+           draw.scissor.x <= draw.width &&
+           draw.scissor.width <= draw.width - draw.scissor.x &&
+           draw.scissor.y <= draw.height &&
+           draw.scissor.height <= draw.height - draw.scissor.y,
+       "Scissor unsupported");
+  const auto vertices = resources.Binding(draw.vertices);
+  Need(resources.BufferDevice(draw.vertices) == device,
+       "Vertex buffer device mismatch");
+  const auto capacity =
+      (vertices.size - std::min<uint64_t>(vertices.size, 16)) / draw.stride +
+      (vertices.size >= 16 ? 1 : 0);
+  if (draw.index_format == IndexFormat::None)
+    Need(draw.first <= capacity && draw.count <= capacity - draw.first,
+         "Vertex range invalid");
+  else {
+    const auto index = resources.Binding(draw.indices);
+    const uint32_t width = draw.index_format == IndexFormat::Uint16 ? 2 : 4;
+    Need(resources.BufferDevice(draw.indices) == device,
+         "Index buffer device mismatch");
+    Need(!(index.offset & (width - 1)) && draw.first <= index.size / width &&
+             draw.count <= index.size / width - draw.first,
+         "Index range invalid");
+    std::vector<std::byte> data(uint64_t(draw.count) * width);
+    resources.Backend(device).Download(resources.View(draw.indices),
+                                       uint64_t(draw.first) * width, data);
+    for (size_t i = 0; i < data.size(); i += width) {
+      uint32_t value = 0;
+      for (uint32_t k = 0; k < width; k++)
+        value |= uint32_t(data[i + k]) << (8 * k);
+      Need(value < capacity, "Index references outside vertex view");
+    }
+  }
+  Need(program.set0.size() <= 8 &&
+           draw.uniforms.size() + draw.textures.size() == program.set0.size(),
+       "Descriptor count unsupported");
+  std::set<uint32_t> used;
+  for (const auto &item : program.set0) {
+    Need(used.insert(item.binding).second && item.binding < 32,
+         "Duplicate/unsupported descriptor binding");
+    Need(item.stage == ShaderStage::Vertex ||
+             item.stage == ShaderStage::Fragment,
+         "Descriptor stage unsupported");
+    unsigned matches = 0;
+    if (item.kind == DescriptorKind::UniformBuffer) {
+      for (const auto &u : draw.uniforms)
+        if (u.binding == item.binding) {
+          auto b = resources.Binding(u.buffer);
+          Need(resources.BufferDevice(u.buffer) == device && u.size &&
+                   u.size <= 65536 && u.offset <= b.size &&
+                   u.size <= b.size - u.offset,
+               "Uniform range/device invalid");
+          ++matches;
+        }
+    } else if (item.kind == DescriptorKind::CombinedImageSampler2D) {
+      for (const auto &t : draw.textures)
+        if (t.binding == item.binding) {
+          Need(t.width && t.height && t.width <= 2048 && t.height <= 2048 &&
+                   t.rgba8.size() == uint64_t(t.width) * t.height * 4,
+               "Texture extent/bytes invalid");
+          ++matches;
+        }
+    } else
+      throw std::runtime_error("Descriptor kind unsupported");
+    Need(matches == 1, "Missing/duplicate descriptor resource");
+  }
+  for (auto stage : {ShaderStage::Vertex, ShaderStage::Fragment}) {
+    const auto minimum = ValidateShader(
+        stage == ShaderStage::Vertex ? program.vertex : program.fragment, stage,
+        program.set0,
+        resources.Backend(device)
+            .GetNativeHandles()
+            .enabled_shader_image_gather_extended);
+    for (const auto &[binding, size] : minimum)
+      for (const auto &uniform : draw.uniforms)
+        if (uniform.binding == binding)
+          Need(uniform.size >= size, "Uniform range smaller than shader block");
+  }
+}
+
+} // namespace
+void ValidateProgram(const ProgramDescription &program,
+                     bool image_gather_extended) {
+  Need(program.set0.size() <= 8, "Descriptor count unsupported");
+  std::set<uint32_t> used;
+  for (const auto &item : program.set0)
+    Need(item.binding < 32 && used.insert(item.binding).second &&
+             (item.stage == ShaderStage::Vertex ||
+              item.stage == ShaderStage::Fragment) &&
+             (item.kind == DescriptorKind::UniformBuffer ||
+              item.kind == DescriptorKind::CombinedImageSampler2D),
+         "Duplicate/unsupported descriptor binding");
+  ValidateShader(program.vertex, ShaderStage::Vertex, program.set0,
+                 image_gather_extended);
+  ValidateShader(program.fragment, ShaderStage::Fragment, program.set0,
+                 image_gather_extended);
+}
+static DrawResult BuildOffscreen(Resources &resources, GuestAddress device_key,
+                                 const ProgramDescription &program,
+                                 const DrawDescription &draw,
+                                 bool pipeline_only) {
+  if (!pipeline_only)
+    Validate(resources, device_key, program, draw);
+  auto &backend = resources.Backend(device_key);
+  const auto handles = backend.GetNativeHandles();
+  ValidateProgram(program, handles.enabled_shader_image_gather_extended);
+  const auto vertex_binding = pipeline_only ? native_graphics::BufferBinding{}
+                                            : resources.Binding(draw.vertices);
+  native_graphics::BufferBinding index_binding{};
+  if (draw.index_format != IndexFormat::None)
+    index_binding = resources.Binding(draw.indices);
+  Owned owner;
+  const auto device = reinterpret_cast<VkDevice>(handles.device);
+  const auto physical =
+      reinterpret_cast<VkPhysicalDevice>(handles.physical_device);
+  const auto queue = reinterpret_cast<VkQueue>(handles.queue);
+  const auto family = handles.queue_family;
+  // Cleanup waits before freeing any resources if a later check throws after
+  // submission.
+  auto submitted = std::make_shared<bool>(false);
+  VkPhysicalDeviceMemoryProperties memory{};
+  V(vkGetPhysicalDeviceMemoryProperties)(physical, &memory);
+  auto allocate = [&](VkMemoryRequirements requirements,
+                      VkMemoryPropertyFlags flags) {
+    uint32_t index = memory.memoryTypeCount;
+    for (uint32_t i = 0; i < memory.memoryTypeCount; ++i)
+      if ((requirements.memoryTypeBits & (1u << i)) &&
+          (memory.memoryTypes[i].propertyFlags & flags) == flags) {
+        index = i;
+        break;
+      }
+    if (index == memory.memoryTypeCount)
+      throw std::runtime_error("Unsupported Vulkan memory type");
+    VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    ai.allocationSize = requirements.size;
+    ai.memoryTypeIndex = index;
+    VkDeviceMemory allocation{};
+    Check(V(vkAllocateMemory)(device, &ai, nullptr, &allocation),
+          "vkAllocateMemory");
+    return allocation;
+  };
+  auto buffer = [&](VkDeviceSize size, VkBufferUsageFlags usage,
+                    VkBuffer &handle, VkDeviceMemory &allocation) {
+    VkBufferCreateInfo bi{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+    bi.size = size;
+    bi.usage = usage;
+    bi.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    Check(V(vkCreateBuffer)(device, &bi, nullptr, &handle), "vkCreateBuffer");
+    VkMemoryRequirements requirements{};
+    V(vkGetBufferMemoryRequirements)(device, handle, &requirements);
+    try {
+      allocation =
+          allocate(requirements, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                     VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+    } catch (...) {
+      V(vkDestroyBuffer)(device, handle, nullptr);
+      throw;
+    }
+    auto b = handle;
+    auto a = allocation;
+    owner.release.push_back([&, device, b, a] {
+      V(vkDestroyBuffer)(device, b, nullptr);
+      V(vkFreeMemory)(device, a, nullptr);
+    });
+    Check(V(vkBindBufferMemory)(device, handle, allocation, 0),
+          "vkBindBufferMemory");
+  };
+  const uint32_t width = draw.width, height = draw.height;
+  VkBuffer vertex = reinterpret_cast<VkBuffer>(vertex_binding.native_buffer),
+           readback{};
+  VkDeviceMemory readback_memory{};
+  buffer(uint64_t(width) * height * 4, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+         readback, readback_memory);
+  void *mapped{};
+  VkImageCreateInfo image_ci{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+  image_ci.imageType = VK_IMAGE_TYPE_2D;
+  image_ci.format = VK_FORMAT_R8G8B8A8_UNORM;
+  image_ci.extent = {width, height, 1};
+  image_ci.mipLevels = 1;
+  image_ci.arrayLayers = 1;
+  image_ci.samples = VK_SAMPLE_COUNT_1_BIT;
+  image_ci.tiling = VK_IMAGE_TILING_OPTIMAL;
+  image_ci.usage =
+      VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+  image_ci.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  VkImage image{};
+  Check(V(vkCreateImage)(device, &image_ci, nullptr, &image), "vkCreateImage");
+  VkMemoryRequirements ir{};
+  V(vkGetImageMemoryRequirements)(device, image, &ir);
+  VkDeviceMemory image_memory{};
+  try {
+    image_memory = allocate(ir, 0);
+  } catch (...) {
+    V(vkDestroyImage)(device, image, nullptr);
+    throw;
+  }
+  owner.release.push_back([&, device, image, image_memory] {
+    V(vkDestroyImage)(device, image, nullptr);
+    V(vkFreeMemory)(device, image_memory, nullptr);
+  });
+  Check(V(vkBindImageMemory)(device, image, image_memory, 0),
+        "vkBindImageMemory");
+  VkImageViewCreateInfo ivci{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+  ivci.image = image;
+  ivci.viewType = VK_IMAGE_VIEW_TYPE_2D;
+  ivci.format = VK_FORMAT_R8G8B8A8_UNORM;
+  ivci.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+  VkImageView view{};
+  Check(V(vkCreateImageView)(device, &ivci, nullptr, &view),
+        "vkCreateImageView");
+  owner.release.push_back(
+      [&, device, view] { V(vkDestroyImageView)(device, view, nullptr); });
+  VkAttachmentDescription attachment{};
+  attachment.format = VK_FORMAT_R8G8B8A8_UNORM;
+  attachment.samples = VK_SAMPLE_COUNT_1_BIT;
+  attachment.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+  attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+  attachment.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+  attachment.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+  attachment.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+  attachment.finalLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+  VkAttachmentReference color{0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+  VkSubpassDescription sub{};
+  sub.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+  sub.colorAttachmentCount = 1;
+  sub.pColorAttachments = &color;
+  VkSubpassDependency dep{};
+  dep.srcSubpass = 0;
+  dep.dstSubpass = VK_SUBPASS_EXTERNAL;
+  dep.srcStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+  dep.dstStageMask = VK_PIPELINE_STAGE_TRANSFER_BIT;
+  dep.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+  dep.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+  VkRenderPassCreateInfo rpci{VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO};
+  rpci.attachmentCount = 1;
+  rpci.pAttachments = &attachment;
+  rpci.subpassCount = 1;
+  rpci.pSubpasses = &sub;
+  rpci.dependencyCount = 1;
+  rpci.pDependencies = &dep;
+  VkRenderPass pass{};
+  Check(V(vkCreateRenderPass)(device, &rpci, nullptr, &pass),
+        "vkCreateRenderPass");
+  owner.release.push_back(
+      [&, device, pass] { V(vkDestroyRenderPass)(device, pass, nullptr); });
+  VkFramebufferCreateInfo fbci{VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+  fbci.renderPass = pass;
+  fbci.attachmentCount = 1;
+  fbci.pAttachments = &view;
+  fbci.width = width;
+  fbci.height = height;
+  fbci.layers = 1;
+  VkFramebuffer framebuffer{};
+  Check(V(vkCreateFramebuffer)(device, &fbci, nullptr, &framebuffer),
+        "vkCreateFramebuffer");
+  owner.release.push_back([&, device, framebuffer] {
+    V(vkDestroyFramebuffer)(device, framebuffer, nullptr);
+  });
+  VkShaderModule shaders[2]{};
+  for (int i = 0; i < 2; ++i) {
+    auto code = i == 0 ? program.vertex : program.fragment;
+    VkShaderModuleCreateInfo ci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+    ci.codeSize = code.size() * 4;
+    ci.pCode = code.data();
+    Check(V(vkCreateShaderModule)(device, &ci, nullptr, &shaders[i]),
+          "vkCreateShaderModule");
+    auto shader = shaders[i];
+    owner.release.push_back([&, device, shader] {
+      V(vkDestroyShaderModule)(device, shader, nullptr);
+    });
+  }
+  VkPhysicalDeviceProperties properties{};
+  V(vkGetPhysicalDeviceProperties)(physical, &properties);
+  std::vector<VkDescriptorSetLayoutBinding> descriptor_bindings;
+  for (const auto &item : program.set0)
+    descriptor_bindings.push_back(
+        {item.binding,
+         item.kind == DescriptorKind::UniformBuffer
+             ? VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER
+             : VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+         1,
+         VkShaderStageFlags(item.stage == ShaderStage::Vertex
+                                ? VK_SHADER_STAGE_VERTEX_BIT
+                                : VK_SHADER_STAGE_FRAGMENT_BIT),
+         nullptr});
+  VkDescriptorSetLayoutCreateInfo dlci{
+      VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+  dlci.bindingCount = uint32_t(descriptor_bindings.size());
+  dlci.pBindings = descriptor_bindings.data();
+  VkDescriptorSetLayout descriptor_layout{};
+  Check(V(vkCreateDescriptorSetLayout)(device, &dlci, nullptr,
+                                       &descriptor_layout),
+        "descriptor layout");
+  owner.release.push_back([&, device, descriptor_layout] {
+    V(vkDestroyDescriptorSetLayout)(device, descriptor_layout, nullptr);
+  });
+  VkDescriptorPoolSize pool_sizes[2] = {
+      {VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, 8},
+      {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 8}};
+  VkDescriptorPoolCreateInfo dpci{
+      VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+  dpci.maxSets = 1;
+  dpci.poolSizeCount = 2;
+  dpci.pPoolSizes = pool_sizes;
+  VkDescriptorPool descriptor_pool{};
+  Check(V(vkCreateDescriptorPool)(device, &dpci, nullptr, &descriptor_pool),
+        "descriptor pool");
+  owner.release.push_back([&, device, descriptor_pool] {
+    V(vkDestroyDescriptorPool)(device, descriptor_pool, nullptr);
+  });
+  VkDescriptorSetAllocateInfo dsai{
+      VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+  dsai.descriptorPool = descriptor_pool;
+  dsai.descriptorSetCount = 1;
+  dsai.pSetLayouts = &descriptor_layout;
+  VkDescriptorSet descriptor_set{};
+  Check(V(vkAllocateDescriptorSets)(device, &dsai, &descriptor_set),
+        "descriptor set");
+  for (const auto &uniform : draw.uniforms) {
+    const auto resource = resources.Binding(uniform.buffer);
+    Need((resource.offset + uniform.offset) %
+                     properties.limits.minUniformBufferOffsetAlignment ==
+                 0 &&
+             uniform.size <= properties.limits.maxUniformBufferRange,
+         "Uniform device alignment/range unsupported");
+    VkDescriptorBufferInfo info{
+        reinterpret_cast<VkBuffer>(resource.native_buffer),
+        resource.offset + uniform.offset, uniform.size};
+    VkWriteDescriptorSet write{VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+    write.dstSet = descriptor_set;
+    write.dstBinding = uniform.binding;
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
+    write.pBufferInfo = &info;
+    V(vkUpdateDescriptorSets)(device, 1, &write, 0, nullptr);
+  }
+  struct TextureUpload {
+    VkImage image;
+    VkBuffer buffer;
+    uint32_t width, height;
+  };
+  std::vector<TextureUpload> uploads;
+  for (const auto &texture : draw.textures) {
+    VkBuffer staging{};
+    VkDeviceMemory staging_memory{};
+    buffer(texture.rgba8.size(), VK_BUFFER_USAGE_TRANSFER_SRC_BIT, staging,
+           staging_memory);
+    void *bytes{};
+    Check(V(vkMapMemory)(device, staging_memory, 0, texture.rgba8.size(), 0,
+                         &bytes),
+          "texture staging map");
+    std::memcpy(bytes, texture.rgba8.data(), texture.rgba8.size());
+    V(vkUnmapMemory)(device, staging_memory);
+    VkImageCreateInfo ci{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    ci.imageType = VK_IMAGE_TYPE_2D;
+    ci.format = VK_FORMAT_R8G8B8A8_UNORM;
+    ci.extent = {texture.width, texture.height, 1};
+    ci.mipLevels = 1;
+    ci.arrayLayers = 1;
+    ci.samples = VK_SAMPLE_COUNT_1_BIT;
+    ci.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ci.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+    ci.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    VkImage sampled{};
+    Check(V(vkCreateImage)(device, &ci, nullptr, &sampled), "texture image");
+    VkMemoryRequirements requirements{};
+    V(vkGetImageMemoryRequirements)(device, sampled, &requirements);
+    VkDeviceMemory allocation{};
+    try {
+      allocation = allocate(requirements, 0);
+    } catch (...) {
+      V(vkDestroyImage)(device, sampled, nullptr);
+      throw;
+    }
+    owner.release.push_back([&, device, sampled, allocation] {
+      V(vkDestroyImage)(device, sampled, nullptr);
+      V(vkFreeMemory)(device, allocation, nullptr);
+    });
+    Check(V(vkBindImageMemory)(device, sampled, allocation, 0), "texture bind");
+    VkImageViewCreateInfo vi{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    vi.image = sampled;
+    vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    vi.format = VK_FORMAT_R8G8B8A8_UNORM;
+    vi.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    VkImageView sampled_view{};
+    Check(V(vkCreateImageView)(device, &vi, nullptr, &sampled_view),
+          "texture view");
+    owner.release.push_back([&, device, sampled_view] {
+      V(vkDestroyImageView)(device, sampled_view, nullptr);
+    });
+    VkSamplerCreateInfo si{VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};
+    si.magFilter = si.minFilter = VK_FILTER_NEAREST;
+    si.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+    si.addressModeU = si.addressModeV = si.addressModeW =
+        VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    VkSampler sampler{};
+    Check(V(vkCreateSampler)(device, &si, nullptr, &sampler),
+          "texture sampler");
+    owner.release.push_back([&, device, sampler] {
+      V(vkDestroySampler)(device, sampler, nullptr);
+    });
+    VkDescriptorImageInfo info{sampler, sampled_view,
+                               VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+    VkWriteDescriptorSet write{VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+    write.dstSet = descriptor_set;
+    write.dstBinding = texture.binding;
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    write.pImageInfo = &info;
+    V(vkUpdateDescriptorSets)(device, 1, &write, 0, nullptr);
+    uploads.push_back({sampled, staging, texture.width, texture.height});
+  }
+  VkPipelineLayoutCreateInfo plci{
+      VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+  plci.setLayoutCount = 1;
+  plci.pSetLayouts = &descriptor_layout;
+  VkPipelineLayout layout{};
+  Check(V(vkCreatePipelineLayout)(device, &plci, nullptr, &layout),
+        "vkCreatePipelineLayout");
+  owner.release.push_back([&, device, layout] {
+    V(vkDestroyPipelineLayout)(device, layout, nullptr);
+  });
+  VkPipelineShaderStageCreateInfo stages[2]{};
+  for (int i = 0; i < 2; ++i) {
+    stages[i].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    stages[i].stage =
+        i == 0 ? VK_SHADER_STAGE_VERTEX_BIT : VK_SHADER_STAGE_FRAGMENT_BIT;
+    stages[i].module = shaders[i];
+    stages[i].pName = "main";
+  }
+  VkVertexInputBindingDescription binding{0, draw.stride,
+                                          VK_VERTEX_INPUT_RATE_VERTEX};
+  VkVertexInputAttributeDescription attribute{0, 0,
+                                              VK_FORMAT_R32G32B32A32_SFLOAT, 0};
+  VkPipelineVertexInputStateCreateInfo vi{
+      VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+  vi.vertexBindingDescriptionCount = 1;
+  vi.pVertexBindingDescriptions = &binding;
+  vi.vertexAttributeDescriptionCount = 1;
+  vi.pVertexAttributeDescriptions = &attribute;
+  VkPipelineInputAssemblyStateCreateInfo ia{
+      VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+  ia.topology = draw.topology == Topology::Triangles
+                    ? VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
+                    : VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP;
+  VkViewport viewport{draw.viewport.x,
+                      draw.viewport.y,
+                      draw.viewport.width,
+                      draw.viewport.height,
+                      0,
+                      1};
+  VkRect2D scissor{{int32_t(draw.scissor.x), int32_t(draw.scissor.y)},
+                   {draw.scissor.width, draw.scissor.height}};
+  VkPipelineViewportStateCreateInfo vp{
+      VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+  vp.viewportCount = 1;
+  vp.pViewports = &viewport;
+  vp.scissorCount = 1;
+  vp.pScissors = &scissor;
+  VkPipelineRasterizationStateCreateInfo raster{
+      VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+  raster.polygonMode = VK_POLYGON_MODE_FILL;
+  raster.cullMode = VK_CULL_MODE_NONE;
+  raster.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+  raster.lineWidth = 1;
+  VkPipelineMultisampleStateCreateInfo ms{
+      VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+  ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+  VkPipelineColorBlendAttachmentState ba{};
+  ba.colorWriteMask = 15;
+  if (draw.blend == Blend::SourceAlpha) {
+    ba.blendEnable = VK_TRUE;
+    ba.srcColorBlendFactor = VK_BLEND_FACTOR_SRC_ALPHA;
+    ba.dstColorBlendFactor = VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
+    ba.colorBlendOp = VK_BLEND_OP_ADD;
+    ba.srcAlphaBlendFactor = VK_BLEND_FACTOR_ONE;
+    ba.dstAlphaBlendFactor = VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
+    ba.alphaBlendOp = VK_BLEND_OP_ADD;
+  }
+  VkPipelineColorBlendStateCreateInfo blend{
+      VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+  blend.attachmentCount = 1;
+  blend.pAttachments = &ba;
+  VkGraphicsPipelineCreateInfo pci{
+      VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+  pci.stageCount = 2;
+  pci.pStages = stages;
+  pci.pVertexInputState = &vi;
+  pci.pInputAssemblyState = &ia;
+  pci.pViewportState = &vp;
+  pci.pRasterizationState = &raster;
+  pci.pMultisampleState = &ms;
+  pci.pColorBlendState = &blend;
+  pci.layout = layout;
+  pci.renderPass = pass;
+  VkPipeline pipeline{};
+  Check(V(vkCreateGraphicsPipelines)(device, VK_NULL_HANDLE, 1, &pci, nullptr,
+                                     &pipeline),
+        "vkCreateGraphicsPipelines");
+  owner.release.push_back([&, device, pipeline] {
+    V(vkDestroyPipeline)(device, pipeline, nullptr);
+  });
+  if (pipeline_only)
+    return {width, height, {}};
+  VkCommandPoolCreateInfo cpci{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+  cpci.queueFamilyIndex = family;
+  VkCommandPool pool{};
+  Check(V(vkCreateCommandPool)(device, &cpci, nullptr, &pool),
+        "vkCreateCommandPool");
+  owner.release.push_back(
+      [&, device, pool] { V(vkDestroyCommandPool)(device, pool, nullptr); });
+  VkCommandBufferAllocateInfo cbai{
+      VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+  cbai.commandPool = pool;
+  cbai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+  cbai.commandBufferCount = 1;
+  VkCommandBuffer cb{};
+  Check(V(vkAllocateCommandBuffers)(device, &cbai, &cb),
+        "vkAllocateCommandBuffers");
+  VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+  begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+  Check(V(vkBeginCommandBuffer)(cb, &begin), "vkBeginCommandBuffer");
+  for (const auto &texture : uploads) {
+    VkImageMemoryBarrier transition{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    transition.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    transition.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    transition.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    transition.srcQueueFamilyIndex = transition.dstQueueFamilyIndex =
+        VK_QUEUE_FAMILY_IGNORED;
+    transition.image = texture.image;
+    transition.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    V(vkCmdPipelineBarrier)(cb, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                            VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0,
+                            nullptr, 1, &transition);
+    VkBufferImageCopy upload{};
+    upload.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    upload.imageExtent = {texture.width, texture.height, 1};
+    V(vkCmdCopyBufferToImage)(cb, texture.buffer, texture.image,
+                              VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &upload);
+    transition.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    transition.newLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    transition.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    transition.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+    V(vkCmdPipelineBarrier)(cb, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                            VK_PIPELINE_STAGE_VERTEX_SHADER_BIT |
+                                VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+                            0, 0, nullptr, 0, nullptr, 1, &transition);
+  }
+  VkClearValue clear{};
+  clear.color.float32[3] = 1;
+  VkRenderPassBeginInfo rb{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+  rb.renderPass = pass;
+  rb.framebuffer = framebuffer;
+  rb.renderArea = {{0, 0}, {width, height}};
+  rb.clearValueCount = 1;
+  rb.pClearValues = &clear;
+  V(vkCmdBeginRenderPass)(cb, &rb, VK_SUBPASS_CONTENTS_INLINE);
+  V(vkCmdBindPipeline)(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+  VkDeviceSize offset = vertex_binding.offset;
+  V(vkCmdBindVertexBuffers)(cb, 0, 1, &vertex, &offset);
+  if (!program.set0.empty())
+    V(vkCmdBindDescriptorSets)(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, layout, 0,
+                               1, &descriptor_set, 0, nullptr);
+  if (draw.index_format == IndexFormat::None)
+    V(vkCmdDraw)(cb, draw.count, 1, draw.first, 0);
+  else {
+    V(vkCmdBindIndexBuffer)(
+        cb, reinterpret_cast<VkBuffer>(index_binding.native_buffer),
+        index_binding.offset,
+        draw.index_format == IndexFormat::Uint16 ? VK_INDEX_TYPE_UINT16
+                                                 : VK_INDEX_TYPE_UINT32);
+    V(vkCmdDrawIndexed)(cb, draw.count, 1, draw.first, 0, 0);
+  }
+  V(vkCmdEndRenderPass)(cb);
+  VkBufferImageCopy copy{};
+  copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  copy.imageExtent = {width, height, 1};
+  V(vkCmdCopyImageToBuffer)(cb, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                            readback, 1, &copy);
+  VkBufferMemoryBarrier barrier{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+  barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+  barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  barrier.buffer = readback;
+  barrier.size = VK_WHOLE_SIZE;
+  V(vkCmdPipelineBarrier)(cb, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_HOST_BIT, 0, 0, nullptr, 1,
+                          &barrier, 0, nullptr);
+  Check(V(vkEndCommandBuffer)(cb), "vkEndCommandBuffer");
+  VkFenceCreateInfo fci{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+  VkFence fence{};
+  Check(V(vkCreateFence)(device, &fci, nullptr, &fence), "vkCreateFence");
+  owner.release.push_back(
+      [&, device, fence] { V(vkDestroyFence)(device, fence, nullptr); });
+  // This cleanup is registered last, so outstanding GPU work finishes before
+  // any resource destruction.
+  owner.release.push_back([&, device, submitted] {
+    if (*submitted)
+      V(vkDeviceWaitIdle)(device);
+  });
+  VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+  submit.commandBufferCount = 1;
+  submit.pCommandBuffers = &cb;
+  Check(V(vkQueueSubmit)(queue, 1, &submit, fence), "vkQueueSubmit");
+  *submitted = true;
+  Check(V(vkWaitForFences)(device, 1, &fence, VK_TRUE, 5'000'000'000ull),
+        "vkWaitForFences");
+  *submitted = false;
+  DrawResult result{width, height,
+                    std::vector<std::byte>(uint64_t(width) * height * 4)};
+  Check(V(vkMapMemory)(device, readback_memory, 0, result.rgba8.size(), 0,
+                       &mapped),
+        "map readback");
+  std::memcpy(result.rgba8.data(), mapped, result.rgba8.size());
+  V(vkUnmapMemory)(device, readback_memory);
+  return result;
+}
+DrawResult DrawOffscreen(Resources &resources, GuestAddress device,
+                         const ProgramDescription &program,
+                         const DrawDescription &draw) {
+  return BuildOffscreen(resources, device, program, draw, false);
+}
+void CheckProgramPipeline(Resources &resources, GuestAddress device,
+                          const ProgramDescription &program) {
+  BuildOffscreen(resources, device, program, DrawDescription{}, true);
+}
+} // namespace native_nvn
diff --git a/native-runtime/nvn/draw.h b/native-runtime/nvn/draw.h
new file mode 100644
index 0000000000000000000000000000000000000000..0570e66014e330536a4b4b5b5e0de745796d1b24
--- /dev/null
+++ b/native-runtime/nvn/draw.h
@@ -0,0 +1,64 @@
+#pragma once
+#include "resources.h"
+#include <vector>
+namespace native_nvn {
+enum class DescriptorKind { UniformBuffer, CombinedImageSampler2D };
+enum class ShaderStage { Vertex, Fragment };
+struct DescriptorPlan {
+  uint32_t binding;
+  DescriptorKind kind;
+  ShaderStage stage;
+};
+struct ProgramDescription {
+  std::span<const uint32_t> vertex, fragment;
+  std::span<const DescriptorPlan> set0;
+};
+struct UniformBinding {
+  uint32_t binding;
+  GuestAddress buffer;
+  uint64_t offset, size;
+};
+struct Texture2D {
+  uint32_t binding, width, height;
+  std::span<const std::byte> rgba8;
+};
+enum class Topology { Triangles, TriangleStrip };
+enum class Blend { Disabled, SourceAlpha };
+enum class IndexFormat { None, Uint16, Uint32 };
+struct Viewport {
+  float x = 0, y = 0, width = 64, height = 64;
+};
+struct Scissor {
+  uint32_t x = 0, y = 0, width = 64, height = 64;
+};
+struct DrawDescription {
+  uint32_t width = 64, height = 64;
+  GuestAddress vertices = 0, indices = 0;
+  uint32_t stride = 16, first = 0, count = 3;
+  IndexFormat index_format = IndexFormat::None;
+  Topology topology = Topology::Triangles;
+  Blend blend = Blend::Disabled;
+  Viewport viewport;
+  Scissor scissor;
+  std::span<const UniformBinding> uniforms;
+  std::span<const Texture2D> textures;
+};
+struct DrawResult {
+  uint32_t width, height;
+  std::vector<std::byte> rgba8;
+};
+// Bounded synchronous single draw. All resource handles remain borrowed only
+// until its fence completes. Caller must complete prior external queue uses.
+// The supported vertex input is location 0 float4, with explicit stride.
+// Set0 contains scalar UBOs and nearest/clamp RGBA8 combined 2D samplers only.
+// Unknown capabilities, layouts and state fail before GPU submission.
+DrawResult DrawOffscreen(Resources &, GuestAddress device,
+                         const ProgramDescription &, const DrawDescription &);
+// Pure preflight; GPU methods use the backend's actually enabled feature value.
+void ValidateProgram(const ProgramDescription &,
+                     bool enabled_image_gather_extended);
+// Creates/destroys the native pipeline only: no resource contents, commands or
+// image.
+void CheckProgramPipeline(Resources &, GuestAddress device,
+                          const ProgramDescription &);
+} // namespace native_nvn
