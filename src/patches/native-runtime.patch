+++ b/native-runtime/event_registry.cpp
@@ -0,0 +1,147 @@
+#include "event_registry.h"
+#include <array>
+#include <limits>
+namespace native {
+struct EventRegistry::State {
+  static constexpr uint32_t Capacity = EventHandleEnd - EventHandleBegin;
+  struct Slot {
+    EventRef event;
+    uint64_t token{};
+    uint32_t next{};
+    bool reserved{}, published{};
+  };
+  std::array<Slot, Capacity> slots;
+  const std::thread::id owner = std::this_thread::get_id();
+  uint32_t free_head = 0;
+  uint64_t next_token = 1;
+  size_t reserved = 0, published = 0;
+  bool active = true;
+  State() {
+    for (uint32_t i = 0; i < Capacity; ++i)
+      slots[i].next = i + 1;
+  }
+  class Export final : public ScopedEventExport {
+  public:
+    Export(std::shared_ptr<State> state, uint32_t index, uint64_t token)
+        : state_(std::move(state)), index_(index), token_(token) {}
+    ~Export() override {
+      if (!armed_ || committed_)
+        return;
+      if (state_->owner != std::this_thread::get_id())
+        std::terminate();
+      auto &slot = state_->slots[index_];
+      if (state_->active && slot.reserved && slot.token == token_) {
+        slot.event.reset();
+        slot.reserved = false;
+        --state_->reserved;
+        slot.next = state_->free_head;
+        state_->free_head = index_;
+      }
+    }
+    uint32_t Handle() const noexcept override {
+      return EventHandleBegin + index_;
+    }
+    bool Commit() noexcept override {
+      if (committed_)
+        return true;
+      if (state_->owner != std::this_thread::get_id() || !state_->active)
+        return false;
+      auto &slot = state_->slots[index_];
+      if (!armed_ || !slot.reserved || slot.token != token_ || !slot.event)
+        return false;
+      slot.reserved = false;
+      slot.published = true;
+      --state_->reserved;
+      ++state_->published;
+      committed_ = true;
+      return true;
+    }
+    void Arm() noexcept { armed_ = true; }
+
+  private:
+    std::shared_ptr<State> state_;
+    uint32_t index_;
+    uint64_t token_;
+    bool armed_ = false, committed_ = false;
+  };
+};
+EventRegistry::~EventRegistry() {
+  if (!state_)
+    return;
+  if (owner_ != std::this_thread::get_id())
+    std::terminate();
+  state_->active = false;
+  for (auto &slot : state_->slots) {
+    slot.event.reset();
+    slot.reserved = false;
+    slot.published = false;
+  }
+  state_->reserved = state_->published = 0;
+}
+void EventRegistry::CheckOwner() const {
+  if (process_id_ && owner_ != std::this_thread::get_id())
+    throw std::runtime_error("native event registry owner mismatch");
+}
+void EventRegistry::Configure(uint64_t pid) {
+  CheckOwner();
+  if (!pid || (process_id_ && process_id_ != pid))
+    throw std::runtime_error("native event process ownership mismatch");
+  if (!process_id_) {
+    process_id_ = pid;
+    owner_ = std::this_thread::get_id();
+  }
+}
+std::unique_ptr<ScopedEventExport>
+EventRegistry::ReserveReadable(const EventRef &event, uint64_t pid) {
+  CheckOwner();
+  if (!process_id_ || pid != process_id_ || !event ||
+      event->OwnerProcessId() != pid)
+    return {};
+  if (!state_)
+    state_ = std::make_shared<State>();
+  auto state = state_;
+  if (!state->active || state->free_head == State::Capacity ||
+      state->next_token == UINT64_MAX)
+    return {};
+  auto index = state->free_head;
+  auto token = state->next_token;
+  // Allocate the transaction before consuming any slot or identity.
+  auto result = std::make_unique<State::Export>(state, index, token);
+  auto &slot = state->slots[index];
+  state->free_head = slot.next;
+  slot.event = event;
+  slot.token = token;
+  slot.reserved = true;
+  slot.published = false;
+  ++state->next_token;
+  ++state->reserved;
+  result->Arm();
+  return result;
+}
+EventRef EventRegistry::GetReadable(uint32_t handle) const {
+  CheckOwner();
+  if (!state_ || !state_->active || handle < EventHandleBegin ||
+      handle >= EventHandleEnd)
+    return {};
+  const auto &slot = state_->slots[handle - EventHandleBegin];
+  return slot.published ? slot.event : EventRef{};
+}
+bool EventRegistry::Close(uint32_t handle) {
+  CheckOwner();
+  if (!GetReadable(handle))
+    return false;
+  auto &slot = state_->slots[handle - EventHandleBegin];
+  slot.event.reset();
+  --state_->published;
+  // Published identities are never put back on the free list.
+  return true;
+}
+size_t EventRegistry::PublishedCount() const {
+  CheckOwner();
+  return state_ ? state_->published : 0;
+}
+size_t EventRegistry::ReservedCount() const {
+  CheckOwner();
+  return state_ ? state_->reserved : 0;
+}
+} // namespace native
