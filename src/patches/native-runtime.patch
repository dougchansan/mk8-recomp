+#include "window.h"
+#include <algorithm>
+#include <atomic>
+#include <exception>
+#include <stdexcept>
+#include <system_error>
+namespace native {
+namespace {
+std::atomic<uint64_t> next_class{0};
+[[noreturn]] void Error(const char *what) {
+  throw std::system_error(GetLastError(), std::system_category(), what);
+}
+} // namespace
+Window::Window(const wchar_t *title, size_t capacity)
+    : owner_(GetCurrentThreadId()), instance_(GetModuleHandleW(nullptr)),
+      capacity_(capacity) {
+  if (!capacity || capacity > queue_.size())
+    throw std::invalid_argument("window queue capacity");
+  source_id_ = ++next_class;
+  class_name_ = L"NativeObservationWindow_" +
+                std::to_wstring(GetCurrentProcessId()) + L"_" +
+                std::to_wstring(source_id_);
+  WNDCLASSEXW wc{};
+  wc.cbSize = sizeof(wc);
+  wc.hInstance = instance_;
+  wc.lpfnWndProc = Procedure;
+  wc.lpszClassName = class_name_.c_str();
+  wc.hCursor = LoadCursorW(nullptr, MAKEINTRESOURCEW(32512));
+  wc.hbrBackground = reinterpret_cast<HBRUSH>(COLOR_WINDOW + 1);
+  registration_ = RegisterClassExW(&wc);
+  if (!registration_)
+    Error("RegisterClassExW");
+  auto hwnd = CreateWindowExW(0, class_name_.c_str(), title,
+                              WS_OVERLAPPEDWINDOW, CW_USEDEFAULT, CW_USEDEFAULT,
+                              640, 360, nullptr, nullptr, instance_, this);
+  if (!hwnd) {
+    auto error = GetLastError();
+    UnregisterClassW(class_name_.c_str(), instance_);
+    registration_ = 0;
+    SetLastError(error);
+    Error("CreateWindowExW");
+  }
+  ShowWindow(hwnd, SW_SHOWNORMAL);
+}
+Window::~Window() {
+  if (GetCurrentThreadId() != owner_)
+    std::terminate();
+  Destroy();
+}
+void Window::Owner() const {
+  if (GetCurrentThreadId() != owner_)
+    throw std::logic_error("window owner thread required");
+}
+HWND Window::handle() const {
+  Owner();
+  return hwnd_;
+}
+HINSTANCE Window::instance_handle() const {
+  Owner();
+  return instance_;
+}
+std::array<uint32_t, 2> Window::client_extent() const {
+  Owner();
+  RECT r{};
+  if (!hwnd_ || IsIconic(hwnd_))
+    return {0, 0};
+  if (!GetClientRect(hwnd_, &r))
+    Error("GetClientRect");
+  return {uint32_t(r.right - r.left), uint32_t(r.bottom - r.top)};
+}
+std::shared_ptr<const uint8_t> Window::PinSurface() {
+  Owner();
+  if (!hwnd_)
+    throw std::logic_error("Window is destroyed");
+  return surface_pin_;
+}
+uint64_t Window::source_id() const {
+  Owner();
+  return source_id_;
+}
+uint64_t Window::process_id() const {
+  Owner();
+  return GetCurrentProcessId();
+}
+bool Window::overflowed() const {
+  Owner();
+  return overflow_;
+}
+bool Window::close_requested() const {
+  Owner();
+  return closed_;
+}
+bool Window::quit_requested() const {
+  Owner();
+  return quit_;
+}
+WindowFocus Window::focus() const {
+  Owner();
+  return focus_;
+}
+void Window::Observe(WindowSource source, UINT message, bool close) noexcept {
+  if (!accepting_)
+    return;
+  if (close && closed_)
+    return;
+  auto foreground = GetForegroundWindow();
+  auto focus = foreground ? (GetAncestor(foreground, GA_ROOT) == hwnd_
+                                 ? WindowFocus::Active
+                                 : WindowFocus::Inactive)
+                          : WindowFocus::Unknown;
+  const bool visible = IsWindowVisible(hwnd_) != FALSE,
+             minimized = IsIconic(hwnd_) != FALSE;
+  if (!close && observed_ && focus == focus_ && visible == visible_ &&
+      minimized == minimized_)
+    return;
+  observed_ = true;
+  focus_ = focus;
+  visible_ = visible;
+  minimized_ = minimized;
+  WindowObservation record{++sequence_, GetCurrentProcessId(),
+                           source_id_,  reinterpret_cast<uintptr_t>(hwnd_),
+                           source,      message,
+                           focus,       visible,
+                           minimized,   close};
+  if (close) {
+    closed_ = true;
+    close_record_ = record;
+    return;
+  }
+  if (overflow_)
+    return;
+  if (count_ == capacity_) {
+    overflow_ = true;
+    return;
+  }
+  queue_[(head_ + count_) % capacity_] = record;
+  ++count_;
+}
+LRESULT CALLBACK Window::Procedure(HWND hwnd, UINT message, WPARAM w,
+                                   LPARAM l) noexcept {
+  auto *self =
+      reinterpret_cast<Window *>(GetWindowLongPtrW(hwnd, GWLP_USERDATA));
+  if (message == WM_NCCREATE) {
+    self = static_cast<Window *>(
+        reinterpret_cast<CREATESTRUCTW *>(l)->lpCreateParams);
+    self->hwnd_ = hwnd;
+    SetWindowLongPtrW(hwnd, GWLP_USERDATA, reinterpret_cast<LONG_PTR>(self));
+  }
+  if (self)
+    switch (message) {
+    case WM_ACTIVATEAPP:
+      self->Observe(WindowSource::ActivateApp, message);
+      break;
+    case WM_ACTIVATE:
+      self->Observe(WindowSource::Activate, message);
+      break;
+    case WM_SHOWWINDOW:
+      self->Observe(WindowSource::Visibility, message);
+      break;
+    case WM_SIZE:
+      self->Observe(WindowSource::Minimize, message);
+      break;
+    case WM_CLOSE:
+      self->Observe(WindowSource::Close, message, true);
+      return 0;
+    case WM_QUERYENDSESSION:
+      self->Observe(WindowSource::SessionEnd, message, true);
+      return TRUE;
+    case WM_ENDSESSION:
+      if (w)
+        self->Observe(WindowSource::SessionEnd, message, true);
+      return 0;
+    case WM_NCDESTROY:
+      SetWindowLongPtrW(hwnd, GWLP_USERDATA, 0);
+      self->hwnd_ = nullptr;
+      break;
+    }
+  return DefWindowProcW(hwnd, message, w, l);
+}
+size_t Window::Pump(size_t limit) {
+  Owner();
+  if (!hwnd_)
+    return 0;
+  if (!limit || limit > 1024)
+    throw std::invalid_argument("window pump limit 1..1024");
+  MSG message{};
+  size_t n = 0;
+  while (n < limit && PeekMessageW(&message, nullptr, 0, 0, PM_REMOVE)) {
+    ++n;
+    if (message.message == WM_QUIT) {
+      if (!quit_) {
+        quit_ = true;
+        quit_record_ = WindowObservation{++sequence_,
+                                         GetCurrentProcessId(),
+                                         source_id_,
+                                         reinterpret_cast<uintptr_t>(hwnd_),
+                                         WindowSource::ThreadQuit,
+                                         WM_QUIT,
+                                         focus_,
+                                         visible_,
+                                         minimized_,
+                                         false};
+      }
+      break;
+    }
+    TranslateMessage(&message);
+    DispatchMessageW(&message);
+  }
+  Observe(WindowSource::ForegroundPoll, 0);
+  return n;
+}
+size_t Window::WaitAndPump(std::chrono::milliseconds timeout) {
+  Owner();
+  if (!hwnd_)
+    return 0;
+  if (timeout.count() < 0 || timeout.count() > 50)
+    throw std::invalid_argument("window idle wait 0..50ms");
+  const auto result = MsgWaitForMultipleObjectsEx(
+      0, nullptr, static_cast<DWORD>(timeout.count()), QS_ALLINPUT,
+      MWMO_INPUTAVAILABLE);
+  if (result == WAIT_FAILED)
+    Error("MsgWaitForMultipleObjectsEx");
+  return Pump();
+}
+std::optional<WindowObservation> Window::Poll() {
+  Owner();
+  if (quit_record_ &&
+      (!count_ || quit_record_->sequence < queue_[head_].sequence) &&
+      (!close_record_ || quit_record_->sequence < close_record_->sequence)) {
+    auto r = quit_record_;
+    quit_record_.reset();
+    return r;
+  }
+  if (close_record_ &&
+      (!count_ || close_record_->sequence < queue_[head_].sequence)) {
+    auto r = close_record_;
+    close_record_.reset();
+    return r;
+  }
+  if (!count_)
+    return {};
+  auto record = queue_[head_];
+  head_ = (head_ + 1) % capacity_;
+  --count_;
+  return record;
+}
+void Window::Destroy() {
+  Owner();
+  if (surface_pin_.use_count() != 1)
+    throw std::logic_error("Window retained by Vulkan surface");
+  accepting_ = false;
+  if (hwnd_ && !DestroyWindow(hwnd_))
+    Error("DestroyWindow");
+  if (registration_) {
+    if (!UnregisterClassW(class_name_.c_str(), instance_))
+      Error("UnregisterClassW");
+    registration_ = 0;
+  }
+}
+} // namespace native
