+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <span>
+#include <stdexcept>
+namespace nx::nvn {
+inline bool sdk53_sampler_descriptors_equal(std::span<const uint8_t> a, std::span<const uint8_t> b) {
+    if (a.size() < 0x50 || b.size() < 0x50)
+        throw std::invalid_argument("truncated SDK53 sampler descriptor");
+    if (std::memcmp(a.data() + 8, b.data() + 8, 0x1c) ||
+        std::memcmp(a.data() + 0x30, b.data() + 0x30, 0x18) ||
+        std::memcmp(a.data() + 0x4c, b.data() + 0x4c, 4)) return false;
+    for (const auto offset : {0x24, 0x28, 0x2c, 0x48}) {
+        float x, y;
+        std::memcpy(&x, a.data() + offset, 4);
+        std::memcpy(&y, b.data() + offset, 4);
+        if (x != y) return false;
+    }
+    return true;
+}
+}
