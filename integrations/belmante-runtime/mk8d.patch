+NativeEventWait::NativeEventWait(std::span<const EventRef> events,
+                                 int64_t timeout,
+                                 std::shared_ptr<const EventClock> clock,
+                                 bool cancelled) {
+  if (events.size() > 64)
+    throw std::invalid_argument("native wait object bound");
+  for (const auto &event : events)
+    if (!event)
+      throw std::invalid_argument("null native wait object");
+  auto state = std::make_shared<detail::EventWaitState>();
+  state->count = events.size();
+  state->clock = clock ? std::move(clock) : DefaultClock();
+  for (size_t i = 0; i < events.size(); ++i)
+    state->events[i] = events[i];
