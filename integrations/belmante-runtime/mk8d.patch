+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <bit>
+#include <cstdint>
+#include <numeric>
+#include <stdexcept>
+
+namespace nx::nvn {
+// Elapsed device ticks, modulo the queue family's timestamp width. Callers
+// must keep intervals shorter than one full wrap; invalid widths have no value.
+inline bool native_gpu_timestamp_delta(uint64_t start,uint64_t end,uint32_t bits,uint64_t& result) {
+    if(!bits||bits>64)return false;
+    result=end-start;
+    if(bits<64)result&=(uint64_t(1)<<bits)-1;
+    return true;
+}
+struct NativeCounterRatio { uint64_t numerator=0,denominator=0; };
+inline NativeCounterRatio native_counter_ratio(float period_ns) {
+    const uint32_t bits=std::bit_cast<uint32_t>(period_ns);
+    const uint32_t exponent=(bits>>23)&255;
+    if((bits>>31)||!exponent||exponent==255)throw std::invalid_argument("invalid native GPU timestamp period");
+    uint64_t numerator=uint64_t((bits&0x7fffff)|0x800000)*384,denominator=625;
+    int shift=int(exponent)-127-23;
+    while(shift<0&&!(numerator&1)){numerator>>=1;++shift;}
+    if(shift<0){if(-shift>54)throw std::invalid_argument("native GPU timestamp ratio is too small");denominator<<=-shift;}
+    else {if(shift>30||numerator>(UINT64_MAX>>shift))throw std::invalid_argument("native GPU timestamp ratio is too large");numerator<<=shift;}
+    const uint64_t divisor=std::gcd(numerator,denominator);numerator/=divisor;denominator/=divisor;
+    if(numerator>UINT32_MAX||denominator>UINT32_MAX)throw std::invalid_argument("native GPU timestamp ratio exceeds exact shader arithmetic");
+    return {numerator,denominator};
+}
+inline uint64_t native_gpu_counter_ticks(uint64_t ticks,NativeCounterRatio ratio) {
+    if(!ratio.numerator||!ratio.denominator||ratio.numerator>UINT32_MAX||ratio.denominator>UINT32_MAX)
+        throw std::invalid_argument("invalid native GPU timestamp ratio");
+    return (ticks/ratio.denominator)*ratio.numerator+((ticks%ratio.denominator)*ratio.numerator)/ratio.denominator;
+}
+inline uint64_t native_counter_timestamp_ns(uint64_t ticks) {
+    return (ticks/384)*625+((ticks%384)*625)/384;
+}
+inline bool native_counter_report_type(uint32_t type) { return type==0||type==1||type==16; }
+}
