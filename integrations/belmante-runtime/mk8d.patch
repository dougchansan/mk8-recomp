+inline int run_mutex() {
+    unsigned checks = 0;
+    auto check = [&](bool ok) {
+        ++checks;
+        if (!ok) throw std::runtime_error("frame mutex assertion " + std::to_string(checks));
+    };
+    check(nx::frame_context::enabled());
+    nx::memory_init();
+    nx::create_main_thread(0x4000);
+    auto* main = nx::self_thread();
+    auto& cpu = nx::current_cpu();
+    const auto top = cpu.x[31];
+    cpu.x[31] = top - 0x100;
+    cpu.x[29] = top - 0x80;
+    cpu.x[30] = 0x1111;
+    nx::st<uint64_t>(top - 0x80, 0);
+    nx::st<uint64_t>(top - 0x78, 0x2222);
+    const auto mutex = nx::kernel_alloc(32, 16);
+    nx::vm_set(mutex, 32, nx::kMemHeap, 3);
+    auto holder = std::make_shared<nx::KThread>();
+    holder->self = holder;
+    holder->id = nx::kstate::g_next_thread_id.fetch_add(1);
+    holder->handle = nx::handle_add(holder);
+    auto acquire = [&](uint64_t address) {
+        cpu.x[0] = holder->handle;
+        cpu.x[1] = address;
+        cpu.x[2] = main->handle;
+        std::array<uint8_t, sizeof(nx::CPU)> before{};
+        std::memcpy(before.data(), &cpu, before.size());
+        nx::svc(cpu, 0x1a, 0);
+        const bool success = cpu.x[0] == 0;
+        cpu.x[0] = holder->handle;
+        const bool preserved = !std::memcmp(before.data(), &cpu, before.size());
+        cpu.x[0] = 0;
+        return std::pair{success, preserved};
+    };
+    nx::g_frame = 0;
+    nx::st<uint32_t>(mutex, 0);
+    const auto fast = acquire(mutex);  // Original owner-word mismatch fast return; no blocking path.
+    check(fast.first);
+    check(fast.second);
+    check(nx::ld<uint32_t>(mutex) == 0);
+
+    const auto blocked_mutex = mutex + 16;
+    nx::st<uint32_t>(blocked_mutex, holder->handle | nx::kstate::kHandleWaitMask);
+    std::atomic<bool> observed_queue{false};
+    std::thread releaser([&] {
+        nx::kstate::t_self = holder.get();
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(3);
+        while (std::chrono::steady_clock::now() < deadline) {
+            bool queued;
+            {
+                std::lock_guard lock(nx::kstate::g_k);
+                queued = std::find(nx::kstate::g_mutex_waiters.begin(), nx::kstate::g_mutex_waiters.end(), main)
+                    != nx::kstate::g_mutex_waiters.end();
+            }
+            if (queued) { observed_queue = true; break; }
+            std::this_thread::yield();
+        }
+        // Release even on timeout so a failing queue assertion cannot strand the caller.
+        nx::CPU release{};
+        release.x[0] = blocked_mutex;
+        nx::svc(release, 0x1b, 0);
+        nx::kstate::t_self = nullptr;
+    });
+    const auto waited = acquire(blocked_mutex);
+    releaser.join();
+    check(waited.first);
+    check(waited.second);
+    check(observed_queue.load());
+    check(nx::ld<uint32_t>(blocked_mutex) == main->handle);
+    cpu.x[0] = blocked_mutex;
+    nx::svc(cpu, 0x1b, 0);
+    check(cpu.x[0] == 0 && nx::ld<uint32_t>(blocked_mutex) == 0);
+    check(nx::g_frame.load() == 0);
+    nx::handle_close(holder->handle);
+    std::cout << "native frame mutex checks=" << checks << " guest_modules=0 PASS\n";
+    return 0;
+}
