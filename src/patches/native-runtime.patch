index 0000000000000000000000000000000000000000..5b326906a6b9262494b48121629aebd3b5526fab
--- /dev/null
+++ b/tests/native_nvn/test.c
@@ -0,0 +1,43 @@
+#include "query.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+struct Bus { uint64_t expected; size_t width; unsigned reads; int fail; unsigned char data[8]; };
+static void require(int ok) { if (!ok) { fputs("native NVN query contract failed\n", stderr); exit(1); } }
+static int read_bus(void* user, uint64_t address, void* destination, size_t bytes) {
+    struct Bus* bus = (struct Bus*)user;
+    require(address == bus->expected && bytes == bus->width);
+    ++bus->reads;
+    if (bus->fail) return 0;
+    memcpy(destination, bus->data, bytes);
+    return 1;
+}
+int main(void) {
+    struct Bus bus = {0};
+    uint64_t result = UINT64_C(0x12345678), random = UINT64_C(0x73c29a);
+    require(native_nvn_query((enum NativeNvnQuery)999, 0, read_bus, &bus, &result) == NATIVE_NVN_UNSUPPORTED);
+    require(!bus.reads && result == UINT64_C(0x12345678));
+    require(native_nvn_query(NATIVE_NVN_BUFFER_DEBUG_ID, 0, 0, 0, &result) == NATIVE_NVN_OK && result == 0);
+    require(native_nvn_query(NATIVE_NVN_BUFFER_SIZE, 0, 0, 0, &result) == NATIVE_NVN_INVALID_ARGUMENT);
+    require(native_nvn_query(NATIVE_NVN_BUFFER_DEBUG_ID, 0, 0, 0, 0) == NATIVE_NVN_INVALID_ARGUMENT);
+    for (unsigned width = 4; width <= 8; width += 4) {
+        for (unsigned i = 0; i < 2000; ++i) {
+            uint64_t object = i < 2 ? UINT64_MAX - i : (random ^= random << 13, random ^= random >> 7, random ^= random << 17);
+            enum NativeNvnQuery op = width == 8 ? NATIVE_NVN_BUFFER_SIZE : NATIVE_NVN_VERTEX_STREAM_STRIDE;
+            uint64_t expected = 0;
+            bus.expected = object + (width == 8 ? 32 : 0);
+            bus.width = width; bus.reads = 0; bus.fail = 0;
+            for (unsigned j = 0; j < width; ++j) {
+                bus.data[j] = (unsigned char)(i * 19 + j * 41);
+                expected |= (uint64_t)bus.data[j] << (j * 8);
+            }
+            require(native_nvn_query(op, object, read_bus, &bus, &result) == NATIVE_NVN_OK);
+            require(bus.reads == 1 && result == expected);
+            bus.reads = 0; bus.fail = 1; result = UINT64_C(0x987654321);
+            require(native_nvn_query(op, object, read_bus, &bus, &result) == NATIVE_NVN_READ_FAULT);
+            require(bus.reads == 1 && result == UINT64_C(0x987654321));
+        }
+    }
+    puts("native NVN: 4000 object reads and fault/no-effect contracts passed");
+    return 0;
+}
