+inline void stage(nx::nvn::ShaderInfo& shader, const std::vector<uint32_t>& words, const char* hash, bool& ok) {
+    shader = {};
+    shader.hash = hash;
+    shader.spirv = words;
+    ok = nx::nvn::reflect_spirv(shader.spirv.data(), shader.spirv.size(), shader.refl);
+    shader.stage = shader.refl.stage;
+}
+
+// Every field a distinct, non-zero value.
+inline nx::nvn::PipelineKey busy_key() {
+    nx::nvn::PipelineKey k;
+    std::memset(&k, 0, sizeof k);
+    uint32_t v = 1;
+    k.topology = v++;
+    k.point_size = 2.5f;
+    for (auto& a : k.attribs) a.format = v++, a.offset = v++, a.stream = v++;
+    for (auto& s : k.streams) s.stride = v++, s.divisor = v++;
+    k.attrib_count = 16, k.stream_count = 15;
+    for (auto& b : k.blend) b.target = v++, b.src_rgb = v++, b.dst_rgb = v++, b.src_a = v++, b.dst_a = v++, b.eq_rgb = v++, b.eq_a = v++;
+    for (auto& e : k.color.blend_enable) e = uint8_t(v++);
+    k.color.alpha_test = v++, k.color.logic_op = v++;
+    for (auto& m : k.mask.mask) m = uint8_t(v++);
+    k.depth.depth_test = 1, k.depth.depth_write = 1, k.depth.stencil_test = 1, k.depth.depth_func = v++;
+    for (int f = 0; f < 2; f++)
+        k.depth.stencil_func[f] = v++, k.depth.stencil_fail[f] = v++, k.depth.depth_fail[f] = v++, k.depth.depth_pass[f] = v++;
+    k.polygon = {v++, v++, v++, v++};
+    for (auto& f : k.color_formats) f = VkFormat(v++);
+    k.color_count = 8, k.depth_format = VkFormat(v++), k.depth_clamp = 1, k.ufloat_colors = 0x5, k.alpha_to_coverage = 1;
+    k.uw_x = 0.75f;
+    return k;
+}
+
+template <class Check> void unit(Check check) {
+    using namespace nx::nvn;
+    namespace R = nx::nvn::recipes;
+    // Encoding: every field survives, nothing else is carried, malformed state is refused.
+    PipelineKey key = busy_key(), back;
+    const std::string state = R::encode_state(key);
+    check(R::decode_state(state, back));
+    PipelineKey bare = key;
+    bare.vs = bare.fs = nullptr;
+    check(std::memcmp(&bare, &back, sizeof back) == 0);
+    for (size_t field = 0; field < state.size(); field += 37) {  // each sampled byte changes the value
+        std::string changed = state;
+        changed[field] = char(changed[field] ^ 0x40);
+        PipelineKey other;
+        if (R::decode_state(changed, other)) check(std::memcmp(&other, &back, sizeof back) != 0);
+    }
+    check(!R::decode_state(state.substr(0, state.size() - 1), back));
+    check(!R::decode_state(state + '\0', back));
+    PipelineKey too_many = busy_key();
+    too_many.attrib_count = 17;
+    check(!R::decode_state(R::encode_state(too_many), back));
+    too_many = busy_key(), too_many.color_count = 9;
+    check(!R::decode_state(R::encode_state(too_many), back));
+
+    // Stage digests: equal content, equal digest; one word or one reflected field changes it.
+    const std::vector<uint32_t> vs_words(std::begin(native_point_vertex), std::end(native_point_vertex));
+    const std::vector<uint32_t> fs_words(std::begin(native_point_fragment), std::end(native_point_fragment));
+    ShaderInfo a, b, f;
+    bool ok = false;
+    stage(a, vs_words, "unit-vs-a", ok), check(ok);
+    stage(b, vs_words, "unit-vs-b", ok), check(ok);
+    stage(f, fs_words, "unit-fs", ok), check(ok);
+    check(R::stage_digest(a) == R::stage_digest(b));
+    check(R::stage_digest(a) != R::stage_digest(f));
+    b.spirv.push_back(0x00010000u);  // OpNop
+    check(R::stage_digest(a) != R::stage_digest(b));
+    ShaderInfo g = f;  // a reflected field the pipeline reads: the fragment output location
+    check(!g.refl.outputs.empty());
+    g.refl.outputs[0].location ^= 1;
+    check(R::stage_digest(f) != R::stage_digest(g));
+
+    // The file: round trip, then truncated, bit-flipped, foreign and oversized files are refused whole.
+    std::vector<R::Recipe> list;
+    for (uint32_t n = 0; n < 5; n++) {
+        R::Recipe r;
+        r.vs = {"vs" + std::to_string(n), R::stage_digest(a)};
+        if (n != 2) r.fs = {"fs" + std::to_string(n), R::stage_digest(f)};
+        PipelineKey k = busy_key();
+        k.topology = n;
+        r.state = R::encode_state(k);
+        r.order = n, r.runs = n + 1;
+        list.push_back(r);
+    }
+    R::FileInfo info{0x1234, 0x1002, 0x7550, 42};
+    const std::string bytes = R::serialize(list, info);
+    std::vector<R::Recipe> parsed;
+    R::FileInfo got;
+    std::string why;
+    check(R::parse(bytes, parsed, &got, &why));
+    check(parsed.size() == list.size() && got.profile == 0x1234 && got.vendor == 0x1002 && got.device == 0x7550 && got.driver == 42);
+    for (size_t n = 0; n < list.size(); n++)
+        check(parsed[n].vs.hash == list[n].vs.hash && parsed[n].vs.digest == list[n].vs.digest &&
+              parsed[n].fs.hash == list[n].fs.hash && parsed[n].fs.digest == list[n].fs.digest &&
+              parsed[n].state == list[n].state && parsed[n].order == list[n].order && parsed[n].runs == list[n].runs);
+    check(parsed[2].fs.hash.empty());
+    for (size_t cut : {size_t(0), size_t(7), size_t(79), size_t(80), bytes.size() / 2, bytes.size() - 1})
+        check(!R::parse(std::string_view(bytes).substr(0, cut), parsed, nullptr, &why) && parsed.empty());
+    for (size_t at = 0; at < bytes.size(); at += 7) {
+        // Reserved words, the profile and the device identity are diagnostic: not part of what is checked.
+        if ((at >= 20 && at < 48) || (at >= 76 && at < 80)) continue;
+        std::string flipped = bytes;
+        flipped[at] = char(flipped[at] ^ 0x01);
+        check(!R::parse(flipped, parsed, nullptr, &why) && parsed.empty());
+    }
+    std::string foreign = bytes;
+    foreign[8] = 2;  // schema 2
+    check(!R::parse(foreign, parsed, nullptr, &why) && why == "another schema");
+    foreign = bytes, foreign[12] = 9;  // key encoding 9
+    check(!R::parse(foreign, parsed, nullptr, &why) && why == "another key encoding");
+    check(!R::parse(bytes + "x", parsed, nullptr, &why));
+    check(R::parse(R::serialize({}, info), parsed, nullptr, &why) && parsed.empty());
+
+    // Atomic replacement in a scratch directory: the old file until the new one is complete, no temporary left.
+    const std::string path = (std::filesystem::temp_directory_path() /
+                              ("nx-recipe-unit-" + std::to_string(nx::plat::current_process_id()) + ".bin")).string();
+    std::remove(path.c_str());
+    check(R::write_atomic(path, bytes, &why));
+    std::string read;
+    check(R::read_whole_file(path, read, R::kMaxFileBytes) && read == bytes);
+    const std::string smaller = R::serialize({list[0]}, info);
+    check(R::write_atomic(path, smaller, &why));
+    check(R::read_whole_file(path, read, R::kMaxFileBytes) && read == smaller);
+    check(!R::read_whole_file(path, read, smaller.size() - 1));
+    FILE* tmp = nx::plat::fopen_utf8(path + ".tmp", "rb");
+    check(tmp == nullptr);
+    if (tmp) std::fclose(tmp);
+    std::remove(path.c_str());
+
+    // Saving: this run's first, older ones after by order, no duplicates, run counts carried, capped.
+    std::vector<R::Recipe> used{list[3], list[1]}, older{list[4], list[1], list[0]};
+    older[0].order = 9, older[2].order = 2;
+    std::vector<R::Recipe> merged = R::merge_for_save(used, older, 16);
+    check(merged.size() == 4);
+    check(merged[0].state == list[3].state && merged[1].state == list[1].state && merged[2].state == list[0].state &&
+          merged[3].state == list[4].state);
+    check(merged[0].runs == 1 && merged[1].runs == list[1].runs + 1 && merged[2].runs == list[0].runs);
+    for (uint32_t n = 0; n < merged.size(); n++) check(merged[n].order == n);
+    check(R::merge_for_save(used, older, 3).size() == 3 && R::merge_for_save(used, older, 1)[0].state == list[3].state);
+    std::vector<R::Recipe> twice{list[3], list[3]};
+    check(R::merge_for_save(twice, {}, 16).size() == 1);
+    // Saver owns the exact captured history, even when the engine changes later.
+    std::unordered_set<std::string> rejected{
+        R::value_key(list[0].vs.digest, list[0].fs.hash.empty() ? nullptr : &list[0].fs.digest, list[0].state)};
+    R::SaveSnapshot snapshot{used, older, rejected};
+    auto expected = merged;
+    expected.erase(expected.begin() + 2);
+    expected[2].order = 2;
+    const auto expected_bytes = R::serialize(expected, info);
+    check(R::serialize(snapshot.finish(16), info) == expected_bytes);
+    used.clear(), older.clear(), rejected.clear();
+    check(R::serialize(snapshot.finish(16), info) == expected_bytes);
+    auto moved = std::move(snapshot);
+    check(R::serialize(moved.finish(16), info) == expected_bytes);
+    check(moved.finish(1).size() == 1 && moved.finish(1)[0].state == list[3].state);
+    check(moved.finish(0).empty());
+    moved.rejected.clear();
+    check(R::serialize(moved.finish(16), info) == R::serialize(merged, info));
+
+}
+
+// One point through `pipeline` into an 8x8 RGBA8 target cleared black; the 64 pixels.
+template <class Check>
+std::vector<uint32_t> render(uint64_t key, nx::nvn::Targets& targets, VkPipeline pipeline, Check check) {
+    using namespace nx;
+    using namespace nx::nvn;
+    std::lock_guard lock(gpu_lock());
+    auto command = frame_begin(false);
+    clears_begin_submit();
+    auto* image = image_of(key);
+    check(image && image->format == VK_FORMAT_R8G8B8A8_UNORM);
+    transition(command, *image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    VkClearColorValue black{};
+    black.float32[3] = 1;
+    VkImageSubresourceRange range{VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    vk::p_vkCmdClearColorImage(command, image->image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &black, 1, &range);
+    image->rendered = true;
+    pass_begin(command, targets);
+    vk::p_vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+    VkViewport viewport{0, 0, 8, 8, 0, 1};
+    VkRect2D scissor{{0, 0}, {8, 8}};
+    vk::p_vkCmdSetViewport(command, 0, 1, &viewport);
+    vk::p_vkCmdSetScissor(command, 0, 1, &scissor);
+    const float blend[4] = {};
+    vk::p_vkCmdSetBlendConstants(command, blend);
+    vk::p_vkCmdSetDepthBias(command, 0, 0, 0);
+    vk::p_vkCmdSetStencilReference(command, VK_STENCIL_FACE_FRONT_AND_BACK, 0);
+    vk::p_vkCmdSetStencilCompareMask(command, VK_STENCIL_FACE_FRONT_AND_BACK, 255);
+    vk::p_vkCmdSetStencilWriteMask(command, VK_STENCIL_FACE_FRONT_AND_BACK, 255);
+    vk::p_vkCmdDraw(command, 1, 1, 0, 0);
+    pass_mark_written(1);
+    draw_end_rendering(command);
+    const auto result = upload_alloc(256, 16);
+    std::memset(result.ptr, 0xcd, 256);
+    transition(command, *image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    VkBufferImageCopy copy{};
+    copy.bufferOffset = result.offset;
+    copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    copy.imageExtent = {8, 8, 1};
+    vk::p_vkCmdCopyImageToBuffer(command, image->image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, result.buffer, 1, &copy);
+    VkBufferMemoryBarrier barrier{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+    barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+    barrier.srcQueueFamilyIndex = barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.buffer = result.buffer, barrier.offset = result.offset, barrier.size = 256;
+    vk::p_vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0, 0, nullptr, 1,
+                               &barrier, 0, nullptr);
+    frame_submit(VK_NULL_HANDLE, VK_NULL_HANDLE, {}, true);
+    std::vector<uint32_t> pixels(64);
+    std::memcpy(pixels.data(), result.ptr, 256);
+    return pixels;
+}
