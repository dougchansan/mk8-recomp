+bool native_conditional_target_valid(uint64_t address) {
+    if(!address||(address&15))return false;
+    uint64_t offset=0;auto* pool=pool_at_gpu(address,&offset);
+    if(!pool||offset>pool->size||24>pool->size-offset)return false;
+    if(pool->memory&&pool->memory>UINT64_MAX-offset)return false;
+    const auto host=pool_host(*pool,offset);
+    if(!host||host>UINT64_MAX-23||!native_guest_span(host,24,1))return false;
+    if(!pool->memory)
