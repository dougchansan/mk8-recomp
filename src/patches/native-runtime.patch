+      limited.usage = ColorTarget;
+      auto image = images.CreateImage(limited);
+      auto view = images.CreateView(image);
+      FrameEncoder f(images);
+      Reject([&] { f.Draw(producer, draw, {view, AttachmentLoad::Clear}); });
+      auto d = draw;
+      d.uniforms = {};
+      Reject([&] { f.Draw(producer, d, {av, AttachmentLoad::Clear}); });
+      SampleBinding binding{0, view, sampler};
+      Reject([&] {
+        f.Draw(consumer, d, {bv, AttachmentLoad::Clear},
