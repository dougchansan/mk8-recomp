+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "romfs_image.h"
+#include <array>
+#include <memory>
+#include <windows.h>
+#include <bcrypt.h>
+namespace nx {
+class NativeReadonlyStorage {
+    std::shared_ptr<RomfsImage> image_;uint64_t size_{};
+public:
+    NativeReadonlyStorage(const std::filesystem::path& path,const std::string& expected):image_(std::make_shared<RomfsImage>(path)) {
+        size_=std::filesystem::file_size(path);if(!size_||size_>32ull*1024*1024||expected.size()!=64)throw std::invalid_argument("native archive extent/digest");
+        std::vector<uint8_t> bytes(static_cast<size_t>(size_));if(image_->read({false,0,size_},0,bytes)!=size_)throw std::runtime_error("native archive hash read failed");
+        std::array<uint8_t,32> digest{};BCRYPT_ALG_HANDLE algorithm=nullptr;
+        if(BCryptOpenAlgorithmProvider(&algorithm,BCRYPT_SHA256_ALGORITHM,nullptr,0)<0)throw std::runtime_error("native archive hash provider failed");
+        const auto hashed=BCryptHash(algorithm,nullptr,0,bytes.data(),ULONG(bytes.size()),digest.data(),ULONG(digest.size()));const auto closed=BCryptCloseAlgorithmProvider(algorithm,0);
+        if(hashed<0||closed<0)throw std::runtime_error("native archive hash failed");
+        const char* hex="0123456789abcdef";std::string actual;for(auto value:digest){actual+=hex[value>>4];actual+=hex[value&15];}if(actual!=expected)throw std::invalid_argument("native archive digest mismatch");
+    }
+    uint64_t size()const{return size_;}
+    std::shared_ptr<RomfsImage> image()const{return image_;}
+    std::vector<uint8_t> read(uint64_t offset,uint64_t count){
+        if(offset>size_||count>size_-offset)throw std::out_of_range("native archive read range");
+        std::vector<uint8_t> bytes(static_cast<size_t>(count));if(image_->read({false,0,size_},offset,bytes)!=count)throw std::runtime_error("native archive read failed");return bytes;
+    }
+};
+}
