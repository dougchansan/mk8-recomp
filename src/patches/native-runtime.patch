+inline const char* NativeEntryH() {
+    return R"RT(
+#ifndef RECOMP_NATIVE_ENTRY_V1
+#define RECOMP_NATIVE_ENTRY_V1 1u
+/* Install/remove only while all guest threads are quiescent. The immutable
+   binding and user storage must outlive all dispatches. The callback must be
+   thread safe for independent contexts. Zero declines with NO guest effects;
+   one handles the complete bounded returning block (including PC), consuming
+   exactly its existing dispatch budget. Unsupported native behavior must set
+   an explicit guest fault/halt and return one, never report fabricated success.
+   This interface accepts guest addresses, never guest-visible host pointers. */
+typedef struct RecompNativeEntryBinding {
+  uint32_t revision;
+  uint32_t size;
+  uint64_t capabilities;
+  void* user;
+  int (*invoke)(void* user, GuestContext* c, uint32_t operation_id, uint64_t guest_entry);
+} RecompNativeEntryBinding;
+#define RECOMP_NATIVE_ENTRY_CAP_BOUNDED_RETURN UINT64_C(1)
+int recomp_native_entry_bind(const RecompNativeEntryBinding* binding);
+int recomp_try_native_entry(GuestContext* c,uint32_t operation_id,uint64_t guest_entry);
+#endif
+)RT";
+}
+
+inline const char* NativeEntryC() {
+    return R"RT(
+static const RecompNativeEntryBinding* recomp_native_entry_binding;
+int recomp_native_entry_bind(const RecompNativeEntryBinding* binding){
+  recomp_native_entry_binding=0;
+  if(!binding) return 1;
+  if(binding->revision!=RECOMP_NATIVE_ENTRY_V1 || binding->size!=sizeof(*binding) ||
+     binding->capabilities!=RECOMP_NATIVE_ENTRY_CAP_BOUNDED_RETURN || !binding->invoke) return 0;
+  recomp_native_entry_binding=binding;
+  return 1;
+}
+int recomp_try_native_entry(GuestContext* c,uint32_t operation_id,uint64_t guest_entry){
+  const RecompNativeEntryBinding* binding=recomp_native_entry_binding;
+  if(!binding || c->halted) return 0;
+  return binding->invoke(binding->user,c,operation_id,guest_entry)!=0;
+}
+)RT";
+}
