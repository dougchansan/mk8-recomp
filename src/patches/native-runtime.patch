index 0000000000000000000000000000000000000000..2dc763d68d490d35e1e77d27251aa04c105e877c
--- /dev/null
+++ b/native-runtime/shaders/native_shaders.h
@@ -0,0 +1,43 @@
+#pragma once
+#include "shader_recompiler/environment.h"
+#include <filesystem>
+#include <map>
+#include <span>
+#include <vector>
+namespace native_shaders {
+// Native-owned snapshot, independent of VideoCommon and guest memory.
+class Snapshot final : public Shader::Environment {
+public:
+  static std::vector<Snapshot> ReadFirstPair(std::span<const std::byte> bytes);
+  u64 ReadInstruction(u32 address) override;
+  u32 ReadCbufValue(u32 index, u32 offset) override;
+  Shader::TextureType ReadTextureType(u32 handle) override;
+  Shader::TexturePixelFormat ReadTexturePixelFormat(u32 handle) override;
+  bool IsTexturePixelFormatInteger(u32 handle) override;
+  u32 ReadViewportTransformState() override { return viewport; }
+  u32 TextureBoundBuffer() const override { return texture_bound; }
+  u32 LocalMemorySize() const override { return local_size; }
+  u32 SharedMemorySize() const override { return 0; }
+  std::array<u32, 3> WorkgroupSize() const override;
+  bool HasHLEMacroState() const override { return !replacements.empty(); }
+  std::optional<Shader::ReplaceConstant>
+  GetReplaceConstBuffer(u32 bank, u32 offset) override;
+  void Dump(u64, u64) override {}
+  size_t CodeBytes() const { return code.size() * 8; }
+  size_t CbufWords() const { return cbufs.size(); }
+  size_t TextureMetadata() const { return types.size(); }
+
+private:
+  std::vector<u64> code;
+  std::map<u32, Shader::TextureType> types;
+  std::map<u32, Shader::TexturePixelFormat> formats;
+  std::map<u64, u32> cbufs;
+  std::map<u64, Shader::ReplaceConstant> replacements;
+  u32 lowest = 0, highest = 0, local_size = 0, texture_bound = 0, viewport = 0;
+};
+struct CompiledPair {
+  std::vector<u32> vertex, fragment;
+  std::string resource_plan;
+};
+CompiledPair TranslatePair(std::vector<Snapshot> &snapshots);
+} // namespace native_shaders
diff --git a/native-runtime/shaders/probe.cpp b/native-runtime/shaders/probe.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..dd3b389abaa3eba3b93a65e080fec97784cdf5bd
--- /dev/null
+++ b/native-runtime/shaders/probe.cpp
@@ -0,0 +1,74 @@
+#include "native_shaders.h"
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+int main(int argc, char **argv) {
+  try {
+    if (argc != 3)
+      throw std::runtime_error(
+          "Usage: native_shader_probe owned-vulkan.bin output-dir");
+    std::ifstream in(argv[1], std::ios::binary | std::ios::ate);
+    if (!in)
+      throw std::runtime_error("Missing owned cache");
+    auto size = in.tellg();
+    if (size < 0 || size > 64 * 1024 * 1024)
+      throw std::runtime_error("Cache file size rejected");
+    std::vector<std::byte> bytes(static_cast<size_t>(size));
+    in.seekg(0);
+    if (!in.read(reinterpret_cast<char *>(bytes.data()), bytes.size()))
+      throw std::runtime_error("Cache read failed");
+    auto pair = native_shaders::Snapshot::ReadFirstPair(bytes);
+    unsigned rejected = 0;
+    auto reject = [&](auto call) {
+      try {
+        call();
+      } catch (const std::exception &) {
+        ++rejected;
+        return;
+      }
+      throw std::runtime_error("Expected bounds/metadata error absent");
+    };
+    reject([&] {
+      native_shaders::Snapshot::ReadFirstPair(std::span(bytes).first(8));
+    });
+    auto corrupt = bytes;
+    corrupt[8] = std::byte{0};
+    reject([&] { native_shaders::Snapshot::ReadFirstPair(corrupt); });
+    corrupt = bytes;
+    for (size_t i = 16; i < 24; ++i)
+      corrupt[i] = std::byte{0xff};
+    reject([&] { native_shaders::Snapshot::ReadFirstPair(corrupt); });
+    corrupt = bytes;
+    for (size_t i = 24; i < 32; ++i)
+      corrupt[i] = std::byte{0xff};
+    reject([&] { native_shaders::Snapshot::ReadFirstPair(corrupt); });
+    corrupt = bytes;
+    corrupt[80] = std::byte{5};
+    reject([&] { native_shaders::Snapshot::ReadFirstPair(corrupt); });
+    reject([&] { pair[0].ReadInstruction(UINT32_MAX); });
+    reject([&] { pair[0].ReadInstruction(pair[0].StartAddress() + 1); });
+    reject([&] { pair[0].ReadCbufValue(UINT32_MAX, UINT32_MAX); });
+    reject([&] { pair[0].ReadTextureType(UINT32_MAX); });
+    reject([&] { pair[0].ReadTexturePixelFormat(UINT32_MAX); });
+    auto compiled = native_shaders::TranslatePair(pair);
+    std::filesystem::create_directories(argv[2]);
+    auto out = std::filesystem::path(argv[2]);
+    for (auto &&item : {std::pair{"vertex", &compiled.vertex},
+                        std::pair{"fragment", &compiled.fragment}}) {
+      std::ofstream file(out / (std::string(item.first) + ".spv"),
+                         std::ios::binary);
+      file.write(reinterpret_cast<const char *>(item.second->data()),
+                 item.second->size() * 4);
+      if (!file)
+        throw std::runtime_error("SPIRV write failed");
+    }
+    std::ofstream(out / "resource-plan.json") << compiled.resource_plan;
+    std::cout << "{\"passed\":true,\"rejected_inputs\":" << rejected
+              << ",\"vertex_words\":" << compiled.vertex.size()
+              << ",\"fragment_words\":" << compiled.fragment.size() << "}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
