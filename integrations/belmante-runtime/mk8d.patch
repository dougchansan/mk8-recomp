+uint64_t Little(std::span<const uint8_t> bytes,size_t at,size_t size) {
+    if(at>bytes.size() || size>bytes.size()-at || size>8)throw std::invalid_argument("NPDM field bounds");
+    uint64_t result=0;for(size_t i=0;i<size;++i)result|=uint64_t(bytes[at+i])<<(8*i);return result;
+}
+uint64_t NewGeneration() {
+    static std::atomic<uint64_t> next{1};
+    auto current=next.load();
+    while(current!=UINT64_MAX){if(next.compare_exchange_weak(current,current+1))return current;}
+    throw std::runtime_error("native AOC context identities exhausted");
+}
+bool Room(uint64_t value){return value!=UINT64_MAX;}
+Reply Decline(Status status,std::string message){Reply r;r.status=status;r.diagnostic=std::move(message);return r;}
+void Scalar(Reply& reply,uint64_t value,size_t size) {
+    reply.payload.resize(size);for(size_t i=0;i<size;++i)reply.payload[i]=std::byte(value>>(8*i));
+}
+}
+MetadataDigest HashProgramMetadata(std::span<const uint8_t> bytes) {
+    if(bytes.size()<0x80 || bytes.size()>1024*1024)throw std::invalid_argument("bounded actual NPDM required");
+    BCRYPT_ALG_HANDLE algorithm=nullptr;MetadataDigest digest{};
+    if(BCryptOpenAlgorithmProvider(&algorithm,BCRYPT_SHA256_ALGORITHM,nullptr,0)<0)
+        throw std::runtime_error("NPDM SHA256 provider failed");
+    const auto result=BCryptHash(algorithm,nullptr,0,const_cast<PUCHAR>(bytes.data()),ULONG(bytes.size()),
+                                 digest.data(),ULONG(digest.size()));
+    const auto closed=BCryptCloseAlgorithmProvider(algorithm,0);
+    if(result<0 || closed<0)throw std::runtime_error("NPDM SHA256 failed");
+    return digest;
+}
+AddOnProgramIdentity AddOnProgramIdentity::Admit(std::span<const uint8_t> bytes,const MetadataDigest& expected) {
+    if(std::all_of(expected.begin(),expected.end(),[](uint8_t n){return n==0;}) || HashProgramMetadata(bytes)!=expected)
+        throw std::invalid_argument("NPDM is not the admitted SHA-bound metadata");
+    if(Little(bytes,0,4)!=0x4154454d)throw std::invalid_argument("NPDM META magic");
+    const auto aci=Little(bytes,0x70,4),size=Little(bytes,0x74,4);
+    if(aci<0x80 || aci>bytes.size() || size<0x40 || size>bytes.size()-aci ||
+       Little(bytes,size_t(aci),4)!=0x30494341)throw std::invalid_argument("NPDM ACI extent/magic");
+    const auto program=Little(bytes,size_t(aci)+0x10,8);
+    if(!program)throw std::invalid_argument("NPDM application ProgramID zero");
+    return AddOnProgramIdentity(program,bytes.size(),aci,size,expected);
+}
+MountedAddOnCatalog::MountedAddOnCatalog(std::vector<MountedAddOnEntry> input) {
+    if(input.size()>4096)throw std::invalid_argument("native mounted catalog bound");
+    for(const auto& entry:input)
+        if(entry.title_id && entry.kind==MountedContentKind::AddOnData && entry.parsed_success)
+            entries_.push_back(entry.title_id);
+    std::sort(entries_.begin(),entries_.end());
+    entries_.erase(std::unique(entries_.begin(),entries_.end()),entries_.end());
+}
+uint32_t CountMountedAddOns(uint64_t current,const MountedAddOnCatalog& catalog,
+                           std::span<const DisabledAddOnPolicy> disabled) {
+    if(!current)throw std::invalid_argument("native AOC current ProgramID required");
+    for(const auto& policy:disabled)if(policy.program_id==current && policy.dlc_disabled)return 0;
+    // Count's key is the actual current ProgramID; only entries are base-masked.
+    // Future List3 uses a different normalized current/policy key and stays closed.
+    return uint32_t(std::count_if(catalog.Entries().begin(),catalog.Entries().end(),
+        [current](uint64_t entry){return (entry&UINT64_C(0xffffffffffffe000))==current;}));
+}
+std::optional<uint64_t> AddOnBaseFallback(uint64_t program,AddOnControlState control) {
+    if(!program || control!=AddOnControlState::NotMounted)return {};
+    return (program&UINT64_C(0xffffffffffffe000))+0x1000;
+}
