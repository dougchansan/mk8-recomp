+void window_log(uint64_t frames) {
+    if (!stats_enabled()) return;
+    Engine& e = engine();
+    std::lock_guard guard(e.lock);
+    const Counters& n = e.c;
+    Counters& o = e.last_window;
+    auto d = [](uint64_t a, uint64_t b) { return (unsigned long long)(a - b); };
+    if (n.misses == o.misses && n.built == o.built && n.compute == o.compute && n.layouts == o.layouts) return;
+    log("nvn/vk: pipeline recipes over %llu frames: %llu misses (%.1f ms first-use stall), %llu adopted, %llu waited "
+        "(%.1f ms), %llu claimed, %llu built (%.1f ms worker), %llu failed, %llu rejected, %zu queued; driver cache "
+        "%llu/%llu hits; %llu layouts (%.2f ms), %llu compute (%.1f ms); private bytes %.1f MB",
+        (unsigned long long)frames, d(n.misses, o.misses), double(n.miss_ns - o.miss_ns) / 1e6,
+        d(n.adopted, o.adopted), d(n.waited, o.waited), double(n.wait_ns - o.wait_ns) / 1e6, d(n.claimed, o.claimed),
+        d(n.built, o.built), double(n.build_ns - o.build_ns) / 1e6, d(n.failed, o.failed), d(n.rejected, o.rejected),
+        e.queue.size(), d(n.feedback_hits, o.feedback_hits), d(n.feedback_valid, o.feedback_valid),
+        d(n.layouts, o.layouts), double(n.layout_ns - o.layout_ns) / 1e6, d(n.compute, o.compute),
+        double(n.compute_ns - o.compute_ns) / 1e6, double(private_bytes()) / (1 << 20));
+    o = n;
+}
