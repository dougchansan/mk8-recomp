+        c.x[0]=cb;c.x[1]=pool_key;c.x[2]=offset;c.x[3]=capacity;api("nvnCommandBufferAddCommandMemory");
+        c.x[0]=cb;c.x[1]=control+offset;c.x[2]=uint64_t(count+1)*4;api("nvnCommandBufferAddControlMemory");
+        c.x[0]=cb;api("nvnCommandBufferBeginRecording");
+        uint64_t before=0,after=0;const auto valid=read_thread_cycles(before);
+        const auto start=perf::now();
+        for(unsigned i=0;i<count;++i){
+            Cmd command{i%8?Cmd::SetViewport:Cmd::UpdateUniformBuffer};
+            command.a[0]=pool.gpu;command.a[1]=i;command.i[0]=list_index;command.i[1]=count;
+            std::array<uint32_t,4> payload{i,list_index,count,0xfeedbeef};
+            record(cb,command,i%8?nullptr:payload.data(),i%8?0:sizeof(payload));
+            payload.fill(0); // The recorded blob must own the bytes.
+        }
+        wall+=perf::now()-start;
+        if(read_thread_cycles(after)&&valid&&after>=before){cycles+=after-before;++cycle_samples;}
+        c.x[0]=cb;api("nvnCommandBufferEndRecording");const auto handle=c.x[0];check(handle!=0);
+        const auto list=command_list(handle);check(list&&list->cmds.size()==count&&list->blobs.size()==count/8);
+        for(unsigned i=0;i<count;++i){
+            const auto& command=list->cmds[i];
+            check(command.op==(i%8?Cmd::SetViewport:Cmd::UpdateUniformBuffer)&&command.a[0]==pool.gpu&&command.a[1]==i&&command.i[0]==int32_t(list_index)&&command.i[1]==int32_t(count));
+            if(!(i%8)){
+                const auto& blob=list->blobs.at(command.blob);std::array<uint32_t,4> payload{};
+                check(blob.size()==sizeof(payload));std::memcpy(payload.data(),blob.data(),blob.size());
+                check(payload==std::array<uint32_t,4>{i,list_index,count,0xfeedbeef});
+            }
+            checksum+=command.a[1]+uint64_t(command.i[0])*17+uint64_t(command.i[1])*31;
+        }
+        c.x[0]=cb;api("nvnCommandBufferGetCommandMemoryUsed");check(c.x[0]==capacity);
+        c.x[0]=cb;api("nvnCommandBufferGetControlMemoryUsed");check(c.x[0]==uint64_t(count+1)*4);
+        records+=count;offset+=capacity;
+    }
