+void Check(bool v, const char *w) {
+  if (!v)
+    throw std::runtime_error(w);
+}
+std::vector<uint32_t> Shader(bool vertex, bool sampled = false) {
+  Sirit::Module m(0x00010000);
+  m.AddCapability(spv::Capability::Shader);
+  m.SetMemoryModel(spv::AddressingModel::Logical, spv::MemoryModel::GLSL450);
+  auto f = m.TypeFloat(32), v = m.TypeVector(f, 4), v2 = m.TypeVector(f, 2);
+  auto out = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Output, v),
+                                 spv::StorageClass::Output);
+  Sirit::Id input{}, ubo{}, uniform_pointer{}, texture{}, sampled_type{};
+  if (vertex) {
+    m.Decorate(out, spv::Decoration::BuiltIn, spv::BuiltIn::Position);
+    input = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Input, v),
+                                spv::StorageClass::Input);
+    m.Decorate(input, spv::Decoration::Location, 0u);
+  } else {
+    m.Decorate(out, spv::Decoration::Location, 0u);
+    if (sampled) {
+      input = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Input, v),
+                                  spv::StorageClass::Input);
+      m.Decorate(input, spv::Decoration::BuiltIn, spv::BuiltIn::FragCoord);
+      auto image = m.TypeImage(f, spv::Dim::Dim2D, 0, false, false, 1,
+                               spv::ImageFormat::Unknown);
+      sampled_type = m.TypeSampledImage(image);
+      texture = m.AddGlobalVariable(
+          m.TypePointer(spv::StorageClass::UniformConstant, sampled_type),
+          spv::StorageClass::UniformConstant);
+      m.Decorate(texture, spv::Decoration::DescriptorSet, 0u);
+      m.Decorate(texture, spv::Decoration::Binding, 0u);
+    } else {
+      auto block = m.TypeStruct(v);
+      m.Decorate(block, spv::Decoration::Block);
+      m.MemberDecorate(block, 0u, spv::Decoration::Offset, 0u);
+      ubo =
+          m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Uniform, block),
+                              spv::StorageClass::Uniform);
+      uniform_pointer = m.TypePointer(spv::StorageClass::Uniform, v);
+      m.Decorate(ubo, spv::Decoration::DescriptorSet, 0u);
+      m.Decorate(ubo, spv::Decoration::Binding, 0u);
+    }
+  }
+  auto zero = m.Constant(m.TypeInt(32, false), 0u),
+       scale = m.Constant(f, 1.0f / 64);
+  auto fn = m.OpFunction(m.TypeVoid(), spv::FunctionControlMask::MaskNone,
+                         m.TypeFunction(m.TypeVoid()));
+  m.AddLabel();
+  if (vertex)
+    m.OpStore(out, m.OpLoad(v, input));
+  else if (sampled) {
+    auto coord = m.OpLoad(v, input);
+    auto x = m.OpFMul(f, m.OpCompositeExtract(f, coord, 0u), scale),
+         y = m.OpFMul(f, m.OpCompositeExtract(f, coord, 1u), scale);
+    auto uv = m.OpCompositeConstruct(v2, x, y);
+    m.OpStore(out, m.OpImageSampleImplicitLod(
+                       v, m.OpLoad(sampled_type, texture), uv));
+  } else
+    m.OpStore(out, m.OpLoad(v, m.OpAccessChain(uniform_pointer, ubo, zero)));
+  m.OpReturn();
+  m.OpFunctionEnd();
+  if (vertex)
+    m.AddEntryPoint(spv::ExecutionModel::Vertex, fn, "main", input, out);
+  else {
+    if (sampled)
+      m.AddEntryPoint(spv::ExecutionModel::Fragment, fn, "main", input, out);
+    else
+      m.AddEntryPoint(spv::ExecutionModel::Fragment, fn, "main", out);
+    m.AddExecutionMode(fn, spv::ExecutionMode::OriginUpperLeft);
+  }
+  return m.Assemble();
+}
+struct Memory {
+  std::array<std::byte, 4096> bytes{};
+  static bool Read(void *p, uint64_t a, std::span<std::byte> b) {
+    auto &m = *static_cast<Memory *>(p);
+    if (a < 0x10000 || a - 0x10000 > m.bytes.size() ||
+        b.size() > m.bytes.size() - (a - 0x10000))
+      return false;
+    std::copy_n(m.bytes.begin() + a - 0x10000, b.size(), b.begin());
+    return true;
+  }
+  static bool Write(void *, uint64_t, std::span<const std::byte>) {
+    return false;
+  }
+};
+} // namespace
+int main() {
+  try {
+    Memory memory;
+    float vertices[] = {-1, -1, 0, 1, 3, -1, 0, 1, -1, 3, 0, 1};
+    std::memcpy(memory.bytes.data(), vertices, sizeof(vertices));
