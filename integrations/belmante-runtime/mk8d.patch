+namespace nx {
+class NativeTouchPolicy{
+ std::mutex lock;bool initialized=false;uint64_t sampling=0;
+public:
+ static constexpr size_t StateBytes=16+16*40;
+ void initialize(){std::lock_guard guard(lock);initialized=true;}
+ unsigned states(std::span<uint8_t> output,unsigned capacity){std::lock_guard guard(lock);if(!initialized||!capacity)return 0;if(output.size()<StateBytes)throw std::invalid_argument("native touchscreen output extent");if(sampling==UINT64_MAX)throw std::overflow_error("native touch sampling exhausted");std::memset(output.data(),0,StateBytes);const auto next=++sampling;std::memcpy(output.data(),&next,8);return 1;}
+};
