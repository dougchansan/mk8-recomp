+namespace native_nvn {
+namespace {
+void Check(VkResult r, const char *operation) {
+  if (r != VK_SUCCESS)
+    throw std::runtime_error(std::string(operation) +
+                             " failed VkResult=" + std::to_string(r));
+}
+struct Owned {
+  HMODULE loader = LoadLibraryW(L"vulkan-1.dll");
+  std::vector<std::function<void()>> release;
+  ~Owned() {
+    for (auto i = release.rbegin(); i != release.rend(); ++i)
+      (*i)();
+    if (loader)
+      FreeLibrary(loader);
+  }
+  template <class T> T Get(const char *name) {
+    auto p = loader ? GetProcAddress(loader, name) : nullptr;
+    if (!p)
+      throw std::runtime_error(
+          std::string("Unsupported Vulkan loader export: ") + name);
+    return reinterpret_cast<T>(p);
+  }
+};
+#define V(name) owner.Get<PFN_##name>(#name)
+void Need(bool value, const char *message) {
+  if (!value)
+    throw std::runtime_error(message);
+}
+std::map<uint32_t, uint64_t>
+ValidateShader(std::span<const uint32_t> code, ShaderStage stage,
+               std::span<const DescriptorPlan> plan,
+               bool image_gather_extended) {
+  Need(code.size() >= 5 && code.size() <= 262144 && code[0] == 0x07230203 &&
+           code[1] <= 0x00010300,
+       "Unsupported SPIR-V header/version");
+  std::map<uint32_t, uint32_t> bindings, sets, storage;
+  std::map<uint32_t, uint32_t> variables, pointers, types, sampled_types,
+      image_types;
+  std::set<uint32_t> blocks;
+  std::map<uint32_t, std::vector<uint32_t>> type_words;
+  std::map<uint32_t, uint32_t> constants, array_stride;
+  std::map<std::pair<uint32_t, uint32_t>, uint32_t> member_offsets;
+  bool entry = false, model = false;
+  for (size_t offset = 5; offset < code.size();) {
+    const uint32_t size = code[offset] >> 16, op = code[offset] & 65535;
+    Need(size && size <= code.size() - offset, "Malformed SPIR-V instruction");
+    const auto *word = code.data() + offset;
+    if (op == 17)
+      Need(size == 2 &&
+               (word[1] == 0 || word[1] == 1 || word[1] == 50 ||
+                word[1] == 46 || (word[1] == 25 && image_gather_extended)),
+           "SPIR-V capability not enabled by native backend");
+    if (op == 10)
+      throw std::runtime_error("SPIR-V extensions unsupported");
+    if (op == 14) {
+      Need(size == 3 && word[1] == 0 && word[2] == 1,
+           "SPIR-V memory model unsupported");
+      model = true;
+    }
+    if (op == 15) {
+      Need(size >= 5 && word[1] == (stage == ShaderStage::Vertex ? 0u : 4u) &&
+               word[3] == 0x6e69616d && word[4] == 0,
+           "SPIR-V requires single main entry");
+      Need(!entry, "Multiple entry points unsupported");
+      entry = true;
+    }
+    if (op == 71 && size == 3 && word[2] == 2)
+      blocks.insert(word[1]);
+    if (op == 71 && size >= 4) {
+      if (word[2] == 6)
+        array_stride[word[1]] = word[3];
+      if (word[2] == 33)
+        bindings[word[1]] = word[3];
+      if (word[2] == 34)
+        sets[word[1]] = word[3];
+    }
+    if (op == 72 && size == 5 && word[3] == 35)
+      member_offsets[{word[1], word[2]}] = word[4];
+    if (op == 43 && size == 4)
+      constants[word[2]] = word[3];
+    if (op == 59) {
+      Need(size >= 4, "Malformed variable");
+      storage[word[2]] = word[3];
+      variables[word[2]] = word[1];
+      Need(word[3] != 9 && word[3] != 12,
+           "Push constants/storage buffers unsupported");
+    }
+    if (op >= 19 && op <= 33 && size >= 2) {
+      types[word[1]] = op;
+      type_words[word[1]] = std::vector<uint32_t>(word, word + size);
+    }
+    if (op == 32) {
+      Need(size == 4, "Malformed pointer type");
+      pointers[word[1]] = word[3];
+    }
+    if (op == 27) {
+      Need(size == 3, "Malformed sampled image type");
+      sampled_types[word[1]] = word[2];
+    }
+    if (op == 25)
+      Need(size >= 9 && word[3] == 1 && word[4] == 0 && word[5] == 0 &&
+               word[6] == 0 && word[7] == 1,
+           "Only sampled nonarray 2D float images supported");
+    if (op == 25)
+      image_types[word[1]] = word[2];
+    if (op == 21)
+      Need(size == 4 && word[2] == 32, "Only 32-bit integers supported");
+    if (op == 22)
+      Need(size == 3 && word[2] == 32, "Only 32-bit floats supported");
+    if (op >= 48 && op <= 52)
+      throw std::runtime_error("Specialization constants unsupported");
+    offset += size;
+  }
+  Need(entry && model, "Missing SPIR-V entry/model");
+  for (const auto &[id, kind] : storage)
+    if (kind == 0 || kind == 2)
+      Need(bindings.contains(id) && sets.contains(id),
+           "Undeclared shader descriptor");
+  std::set<uint32_t> found;
+  std::map<uint32_t, uint64_t> minimum;
+  std::set<uint32_t> sizing;
+  std::function<uint64_t(uint32_t)> byte_size = [&](uint32_t type) -> uint64_t {
+    Need(sizing.size() < 32 && sizing.insert(type).second &&
+             type_words.contains(type),
+         "Recursive/missing uniform type unsupported");
+    const auto &words = type_words.at(type);
+    uint64_t bytes = 0;
+    if (types[type] == 21 || types[type] == 22)
+      bytes = 4;
+    else if (types[type] == 23) {
+      Need(words.size() == 4 && words[3] <= 4, "Uniform vector unsupported");
+      bytes = byte_size(words[2]) * words[3];
+    } else if (types[type] == 28) {
+      Need(words.size() == 4 && constants.contains(words[3]) &&
+               array_stride.contains(type),
+           "Uniform array layout unknown");
+      const auto stride = array_stride.at(type), count = constants.at(words[3]);
+      const auto element = byte_size(words[2]);
+      Need(count && count <= 65536 && stride >= element,
+           "Uniform array stride/count invalid");
+      bytes = uint64_t(stride) * (count - 1) + element;
+    } else if (types[type] == 30) {
+      for (uint32_t i = 2; i < words.size(); i++) {
+        Need(member_offsets.contains({type, i - 2}),
+             "Uniform member offset unknown");
+        bytes = std::max(bytes, uint64_t(member_offsets.at({type, i - 2})) +
+                                    byte_size(words[i]));
+      }
+    } else
+      throw std::runtime_error(
+          "Uniform type requires unsupported layout metadata");
+    sizing.erase(type);
+    Need(bytes && bytes <= 65536, "Uniform block size unsupported");
+    return bytes;
+  };
+  for (const auto &[id, binding] : bindings) {
+    Need(sets.contains(id) && sets[id] == 0 && storage.contains(id),
+         "Only explicit descriptor set0 supported");
+    const DescriptorPlan *declared = nullptr;
+    for (const auto &item : plan)
+      if (item.binding == binding && item.stage == stage)
+        declared = &item;
+    if (!declared || !found.insert(binding).second)
+      throw std::runtime_error("Descriptor metadata mismatch");
+    Need(storage[id] ==
+             (declared->kind == DescriptorKind::UniformBuffer ? 2u : 0u),
+         "Descriptor storage class mismatch");
+    Need(pointers.contains(variables[id]), "Descriptor pointer type missing");
+    const auto type = pointers[variables[id]];
+    if (declared->kind == DescriptorKind::UniformBuffer) {
+      Need(types[type] == 30 && blocks.contains(type),
+           "Only scalar uniform blocks supported");
+      minimum[binding] = byte_size(type);
+    } else
+      Need(types[type] == 27 && sampled_types.contains(type) &&
+               types[sampled_types[type]] == 25 &&
+               types[image_types[sampled_types[type]]] == 22,
+           "Only scalar combined image descriptors supported");
+  }
+  for (const auto &item : plan)
+    if (item.stage == stage)
+      Need(found.contains(item.binding),
+           "Unused or missing descriptor plan entry");
+  return minimum;
+}
+uint32_t VertexBytes(VertexFormat format) {
+  switch (format) {
+  case VertexFormat::Float2:
+    return 8;
+  case VertexFormat::Float3:
+    return 12;
+  case VertexFormat::Float4:
+    return 16;
+  }
+  throw std::runtime_error("Unsupported vertex format");
+}
+VkBlendFactor Factor(BlendFactor f) {
+  switch (f) {
+  case BlendFactor::Zero:
+    return VK_BLEND_FACTOR_ZERO;
+  case BlendFactor::One:
+    return VK_BLEND_FACTOR_ONE;
+  case BlendFactor::SourceAlpha:
+    return VK_BLEND_FACTOR_SRC_ALPHA;
+  case BlendFactor::OneMinusSourceAlpha:
+    return VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
+  case BlendFactor::SourceColor:
+    return VK_BLEND_FACTOR_SRC_COLOR;
+  }
+  throw std::runtime_error("Unsupported blend factor");
+}
+bool ValidateVertexInputs(std::span<const uint32_t> code) {
+  bool active = false;
+  std::map<uint32_t, uint32_t> location, variable, pointer, float_bits,
+      vector_count, vector_type, storage;
+  std::set<uint32_t> builtin;
+  for (size_t o = 5; o < code.size();) {
+    auto n = code[o] >> 16, op = code[o] & 65535;
+    Need(n && n <= code.size() - o, "Malformed vertex shader");
+    auto *w = code.data() + o;
+    if (op == 71 && n >= 4) {
+      if (w[2] == 30)
+        location[w[1]] = w[3];
+      if (w[2] == 11)
+        builtin.insert(w[1]);
+    }
+    if (op == 22 && n == 3)
+      float_bits[w[1]] = w[2];
+    if (op == 23 && n == 4) {
+      vector_type[w[1]] = w[2];
+      vector_count[w[1]] = w[3];
+    }
+    if (op == 32 && n == 4)
+      pointer[w[1]] = w[3];
+    if (op == 59 && n >= 4) {
+      variable[w[2]] = w[1];
+      storage[w[2]] = w[3];
+    }
+    o += n;
+  }
+  for (auto &[id, type] : variable)
+    if (storage[id] == 1 && !builtin.contains(id)) {
+      active = true;
+      Need(location.contains(id) && location[id] == 0,
+           "Only vertex location0 supported");
+      auto scalar = pointer[type];
+      auto count = 1u;
+      if (vector_type.contains(scalar)) {
+        count = vector_count[scalar];
+        scalar = vector_type[scalar];
+      }
+      Need(float_bits[scalar] == 32 && count >= 2 && count <= 4,
+           "Vertex shader requires float2/3/4 input");
+    }
+  return active;
+}
+void Validate(Resources &resources, GuestAddress device,
+              const ProgramDescription &program, const DrawDescription &draw,
+              std::span<const NativeSample> native_samples = {},
+              ImageFormat target_format = ImageFormat::Rgba8Unorm) {
+  const auto native = resources.Backend(device).GetNativeHandles();
+  Owned owner;
+  VkPhysicalDeviceProperties limits{};
+  V(vkGetPhysicalDeviceProperties)(
+      reinterpret_cast<VkPhysicalDevice>(native.physical_device), &limits);
+  ValidateTypedState(draw, resources.Backend(device).GetCapabilities());
+  const auto target_support = QueryImageSupport(
+      resources, device, target_format, ColorTarget | TransferSource);
+  const auto blend = EffectiveBlend(draw);
+  ValidateImageUse(target_support, draw.width, draw.height, false,
+                   blend.enabled);
+  Need(draw.stride <= limits.limits.maxVertexInputBindingStride &&
+           draw.vertex_input.offset <=
+               limits.limits.maxVertexInputAttributeOffset,
+       "Vertex input device limit");
+  const bool active_vertex = ValidateVertexInputs(program.vertex);
+  Need(!draw.procedural_triangle ||
+           (!active_vertex && draw.vertices == 0 && draw.indices == 0 &&
+            draw.index_format == IndexFormat::None && draw.base_vertex == 0 &&
+            draw.first == 0 && draw.count == 3),
+       "Procedural triangle requires no vertex inputs/resources");
+  Need(draw.topology == Topology::Triangles ||
+           draw.topology == Topology::TriangleStrip,
+       "Topology unsupported");
+  Need(draw.blend == Blend::Disabled || draw.blend == Blend::SourceAlpha,
+       "Blend unsupported");
+  Need(draw.index_format == IndexFormat::None ||
+           draw.index_format == IndexFormat::Uint16 ||
+           draw.index_format == IndexFormat::Uint32,
+       "Index format unsupported");
+  const auto &vp = draw.viewport;
+  Need(std::isfinite(vp.x) && std::isfinite(vp.y) && std::isfinite(vp.width) &&
+           std::isfinite(vp.height) && vp.x >= 0 && vp.y >= 0 && vp.width > 0 &&
+           vp.height > 0 && vp.x + vp.width <= draw.width &&
+           vp.y + vp.height <= draw.height,
+       "Viewport unsupported");
+  Need(draw.scissor.width && draw.scissor.height &&
+           draw.scissor.x <= draw.width &&
+           draw.scissor.width <= draw.width - draw.scissor.x &&
+           draw.scissor.y <= draw.height &&
+           draw.scissor.height <= draw.height - draw.scissor.y,
+       "Scissor unsupported");
+  if (!draw.procedural_triangle) {
+    const auto vertices = resources.Binding(draw.vertices);
+    Need(vertices.offset <= UINT64_MAX - draw.vertex_input.offset &&
+             !((vertices.offset + draw.vertex_input.offset) & 3),
+         "Effective vertex buffer address must be float aligned");
+    Need(resources.BufferDevice(draw.vertices) == device,
+         "Vertex buffer device mismatch");
+    const auto capacity =
+        vertices.size >= uint64_t(draw.vertex_input.offset) +
+                             VertexBytes(draw.vertex_input.format)
+            ? (vertices.size - draw.vertex_input.offset -
+               VertexBytes(draw.vertex_input.format)) /
+                      draw.stride +
+                  1
+            : 0;
+    if (draw.index_format == IndexFormat::None)
+      Need(draw.base_vertex == 0 && draw.first <= capacity &&
+               draw.count <= capacity - draw.first,
+           "Vertex range/base invalid");
+    else {
+      const auto index = resources.Binding(draw.indices);
+      const uint32_t width = draw.index_format == IndexFormat::Uint16 ? 2 : 4;
+      Need(resources.BufferDevice(draw.indices) == device,
+           "Index buffer device mismatch");
+      Need(!(index.offset & (width - 1)) && draw.first <= index.size / width &&
+               draw.count <= index.size / width - draw.first,
+           "Index range invalid");
+      std::vector<std::byte> data(uint64_t(draw.count) * width);
+      resources.Backend(device).Download(resources.View(draw.indices),
+                                         uint64_t(draw.first) * width, data);
+      for (size_t i = 0; i < data.size(); i += width) {
+        uint32_t value = 0;
+        for (uint32_t k = 0; k < width; k++)
+          value |= uint32_t(data[i + k]) << (8 * k);
+        const int64_t adjusted = int64_t(value) + draw.base_vertex;
+        Need(adjusted >= 0 && uint64_t(adjusted) < capacity,
+             "Index/base references outside vertex view");
+      }
+    }
+  }
+  Need(program.set0.size() <= 8 && draw.uniforms.size() + draw.textures.size() +
+                                           native_samples.size() ==
+                                       program.set0.size(),
+       "Descriptor count unsupported");
+  std::set<uint32_t> used;
+  for (const auto &item : program.set0) {
+    Need(used.insert(item.binding).second && item.binding < 32,
+         "Duplicate/unsupported descriptor binding");
+    Need(item.stage == ShaderStage::Vertex ||
+             item.stage == ShaderStage::Fragment,
+         "Descriptor stage unsupported");
+    unsigned matches = 0;
+    if (item.kind == DescriptorKind::UniformBuffer) {
+      for (const auto &u : draw.uniforms)
+        if (u.binding == item.binding) {
+          auto b = resources.Binding(u.buffer);
+          Need(resources.BufferDevice(u.buffer) == device && u.size &&
+                   u.size <= 65536 && u.offset <= b.size &&
+                   u.size <= b.size - u.offset,
+               "Uniform range/device invalid");
+          Need((b.offset + u.offset) %
+                           limits.limits.minUniformBufferOffsetAlignment ==
+                       0 &&
+                   u.size <= limits.limits.maxUniformBufferRange,
+               "Uniform device alignment/range unsupported");
+          ++matches;
+        }
+    } else if (item.kind == DescriptorKind::CombinedImageSampler2D) {
+      for (const auto &t : draw.textures)
+        if (t.binding == item.binding) {
+          Need(t.width && t.height && t.width <= 2048 && t.height <= 2048 &&
+                   t.rgba8.size() == uint64_t(t.width) * t.height * 4,
+               "Texture extent/bytes invalid");
+          ++matches;
+        }
+      for (const auto &t : native_samples)
+        if (t.binding == item.binding) {
+          Need(t.image && t.view && t.sampler && t.width && t.height &&
+                   t.mip == 0 && t.mips == 1,
+               "Native sample invalid/exactly one mip required");
+          const auto support =
+              QueryImageSupport(resources, device, t.format, Sampled);
+          ValidateImageUse(support, t.width, t.height, t.linear_filter, false);
+          ++matches;
+        }
+    } else
+      throw std::runtime_error("Descriptor kind unsupported");
+    Need(matches == 1, "Missing/duplicate descriptor resource");
+  }
+  for (auto stage : {ShaderStage::Vertex, ShaderStage::Fragment}) {
+    const auto minimum = ValidateShader(
+        stage == ShaderStage::Vertex ? program.vertex : program.fragment, stage,
+        program.set0,
+        resources.Backend(device)
+            .GetNativeHandles()
+            .enabled_shader_image_gather_extended);
+    for (const auto &[binding, size] : minimum)
+      for (const auto &uniform : draw.uniforms)
+        if (uniform.binding == binding)
+          Need(uniform.size >= size, "Uniform range smaller than shader block");
+  }
+}
+
+} // namespace
+uint32_t ImageBytesPerTexel(ImageFormat f) {
+  switch (f) {
+  case ImageFormat::R8Unorm:
+    return 1;
+  case ImageFormat::Rg8Unorm:
+    return 2;
+  case ImageFormat::Rgba8Unorm:
+  case ImageFormat::Rgba8Srgb:
+  case ImageFormat::A2B10G10R10Unorm:
+    return 4;
+  }
+  throw std::runtime_error("Unsupported image format");
+}
+uint32_t NativeImageFormat(ImageFormat f) {
+  switch (f) {
+  case ImageFormat::R8Unorm:
+    return VK_FORMAT_R8_UNORM;
+  case ImageFormat::Rg8Unorm:
+    return VK_FORMAT_R8G8_UNORM;
+  case ImageFormat::Rgba8Unorm:
+    return VK_FORMAT_R8G8B8A8_UNORM;
+  case ImageFormat::Rgba8Srgb:
+    return VK_FORMAT_R8G8B8A8_SRGB;
+  case ImageFormat::A2B10G10R10Unorm:
+    return VK_FORMAT_A2B10G10R10_UNORM_PACK32;
+  }
+  throw std::runtime_error("Unsupported image format");
+}
+static ImageSupport QueryFormatSupport(Resources &r, GuestAddress key,
+                                       VkFormat format, uint32_t usage) {
+  Need(usage && !(usage & ~15u), "Unsupported image usages");
+  auto h = r.Backend(key).GetNativeHandles();
+  Owned owner;
+  auto physical = reinterpret_cast<VkPhysicalDevice>(h.physical_device);
+
+  VkImageUsageFlags flags = 0;
+  VkFormatFeatureFlags required = 0;
+  if (usage & ColorTarget) {
+    flags |= VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+    required |= VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT;
+  }
+  if (usage & Sampled) {
+    flags |= VK_IMAGE_USAGE_SAMPLED_BIT;
+    required |= VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+  }
+  if (usage & TransferSource)
+    flags |= VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+  if (usage & TransferDestination)
+    flags |= VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+  VkFormatProperties p{};
+  V(vkGetPhysicalDeviceFormatProperties)(physical, format, &p);
+  Need((p.optimalTilingFeatures & required) == required,
+       "Image format feature unsupported");
+  VkImageFormatProperties limits{};
+  Check(V(vkGetPhysicalDeviceImageFormatProperties)(
+            physical, format, VK_IMAGE_TYPE_2D, VK_IMAGE_TILING_OPTIMAL, flags,
+            0, &limits),
+        "Image format usages");
+  Need(limits.sampleCounts & VK_SAMPLE_COUNT_1_BIT,
+       "Image single sample unsupported");
+  return {limits.maxExtent.width, limits.maxExtent.height,
+          limits.maxResourceSize,
+          bool(p.optimalTilingFeatures &
+               VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT),
+          bool(p.optimalTilingFeatures &
+               VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BLEND_BIT)};
+}
+ImageSupport QueryImageSupport(Resources &r, GuestAddress key, ImageFormat f,
+                               uint32_t usage) {
+  return QueryFormatSupport(r, key, VkFormat(NativeImageFormat(f)), usage);
+}
+uint32_t NativePresentationFormat(PresentationFormat f) {
+  switch (f) {
+  case PresentationFormat::Rgba8Srgb:
+    return VK_FORMAT_R8G8B8A8_SRGB;
+  case PresentationFormat::Bgra8Srgb:
+    return VK_FORMAT_B8G8R8A8_SRGB;
+  case PresentationFormat::Rgba8Unorm:
+    return VK_FORMAT_R8G8B8A8_UNORM;
+  case PresentationFormat::Bgra8Unorm:
+    return VK_FORMAT_B8G8R8A8_UNORM;
+  }
+  throw std::runtime_error("Unsupported presentation format");
+}
+void ValidateImageUse(const ImageSupport &s, uint32_t width, uint32_t height,
+                      bool linear, bool blend) {
+  Need(width && height && width <= s.max_width && height <= s.max_height &&
+           (!linear || s.linear_filter) && (!blend || s.blend),
+       "Image format/filter/blend/device extent unsupported");
+}
+BlendState EffectiveBlend(const DrawDescription &d) {
+  if (d.blend_state) {
+    Need(d.blend == Blend::Disabled, "Conflicting legacy/explicit blend state");
+    return *d.blend_state;
+  }
+  Need(d.blend == Blend::Disabled || d.blend == Blend::SourceAlpha,
+       "Unsupported legacy blend");
+  BlendState b;
+  if (d.blend == Blend::SourceAlpha) {
+    b.enabled = true;
+    b.source_rgb = BlendFactor::SourceAlpha;
+    b.destination_rgb = BlendFactor::OneMinusSourceAlpha;
+    b.source_alpha = BlendFactor::One;
+    b.destination_alpha = BlendFactor::OneMinusSourceAlpha;
+  }
+  return b;
+}
+void ValidateTypedState(const DrawDescription &d,
+                        const native_graphics::GraphicsCapabilities &c) {
+  Need(d.width && d.height && d.width <= c.max_image_dimension_2d &&
+           d.height <= c.max_image_dimension_2d,
+       "Target size unsupported");
+  auto bytes = VertexBytes(d.vertex_input.format);
+  Need(!d.vertex_input.divisor && !(d.vertex_input.offset & 3) &&
+           uint64_t(d.vertex_input.offset) + bytes <= d.stride &&
+           d.stride <= 2048 && !(d.stride & 3) && d.count && d.count <= 1048576,
+       "Vertex stride/offset/divisor unsupported");
+  auto b = EffectiveBlend(d);
+  Factor(b.source_rgb);
+  Factor(b.destination_rgb);
+  Factor(b.source_alpha);
+  Factor(b.destination_alpha);
+  Need(b.rgb_equation == BlendEquation::Add &&
+           b.alpha_equation == BlendEquation::Add && !(b.write_mask & ~15u),
+       "Blend equation/mask unsupported");
+  const auto &r = d.raster;
+  Need((r.cull == CullFace::None || r.cull == CullFace::Back) &&
+           (r.front == FrontFace::Clockwise ||
+            r.front == FrontFace::CounterClockwise) &&
+           !r.depth_test && !r.depth_write && !r.stencil && !r.depth_bias &&
+           !r.discard,
+       "Raster state unsupported");
+  const auto &v = d.viewport;
+  Need(std::isfinite(v.x) && std::isfinite(v.y) && std::isfinite(v.width) &&
+           std::isfinite(v.height) && std::isfinite(v.min_depth) &&
+           std::isfinite(v.max_depth) && v.x >= 0 && v.y >= 0 && v.width > 0 &&
+           v.height > 0 && double(v.x) + v.width <= d.width &&
+           double(v.y) + v.height <= d.height &&
+           v.width <= c.max_viewport_dimensions[0] &&
+           v.height <= c.max_viewport_dimensions[1] &&
+           v.x >= c.viewport_bounds[0] && v.y >= c.viewport_bounds[0] &&
+           double(v.x) + v.width <= c.viewport_bounds[1] &&
+           double(v.y) + v.height <= c.viewport_bounds[1] && v.min_depth >= 0 &&
+           v.max_depth <= 1 && v.min_depth <= v.max_depth,
+       "Viewport bounds/depth invalid");
+  Need(v.orientation == ViewportOrientation::PositiveY ||
+           (v.orientation == ViewportOrientation::InvertY &&
+            c.negative_viewport_height),
+       "Viewport orientation not enabled");
+}
+void ValidateProgram(const ProgramDescription &program,
+                     bool image_gather_extended) {
+  Need(program.set0.size() <= 8, "Descriptor count unsupported");
+  std::set<uint32_t> used;
+  for (const auto &item : program.set0)
+    Need(item.binding < 32 && used.insert(item.binding).second &&
+             (item.stage == ShaderStage::Vertex ||
+              item.stage == ShaderStage::Fragment) &&
+             (item.kind == DescriptorKind::UniformBuffer ||
+              item.kind == DescriptorKind::CombinedImageSampler2D),
+         "Duplicate/unsupported descriptor binding");
+  ValidateShader(program.vertex, ShaderStage::Vertex, program.set0,
+                 image_gather_extended);
+  ValidateShader(program.fragment, ShaderStage::Fragment, program.set0,
+                 image_gather_extended);
+}
+static DrawResult
+BuildOffscreen(Resources &resources, GuestAddress device_key,
+               const ProgramDescription &program, const DrawDescription &draw,
+               bool pipeline_only, const NativeTarget *target = nullptr,
+               std::span<const NativeSample> native_samples = {},
+               std::span<const UniformSnapshot> snapshots = {}) {
+  if (!pipeline_only)
+    Validate(resources, device_key, program, draw, native_samples,
+             target ? target->format : ImageFormat::Rgba8Unorm);
+  auto &backend = resources.Backend(device_key);
+  const auto handles = backend.GetNativeHandles();
+  if (target && target->presentation_format) {
+    const auto support = QueryFormatSupport(
+        resources, device_key,
+        VkFormat(NativePresentationFormat(*target->presentation_format)),
+        ColorTarget);
+    ValidateImageUse(support, draw.width, draw.height, false,
+                     EffectiveBlend(draw).enabled);
+  }
+  ValidateProgram(program, handles.enabled_shader_image_gather_extended);
+  const auto vertex_binding = pipeline_only || draw.procedural_triangle
+                                  ? native_graphics::BufferBinding{}
+                                  : resources.Binding(draw.vertices);
+  native_graphics::BufferBinding index_binding{};
+  if (draw.index_format != IndexFormat::None)
+    index_binding = resources.Binding(draw.indices);
+  Owned owner;
+  const auto device = reinterpret_cast<VkDevice>(handles.device);
+  const auto physical =
+      reinterpret_cast<VkPhysicalDevice>(handles.physical_device);
+  const auto queue = reinterpret_cast<VkQueue>(handles.queue);
+  const auto family = handles.queue_family;
+  // Cleanup waits before freeing any resources if a later check throws after
+  // submission.
+  auto submitted = std::make_shared<bool>(false);
+  VkPhysicalDeviceMemoryProperties memory{};
+  V(vkGetPhysicalDeviceMemoryProperties)(physical, &memory);
+  auto allocate = [&](VkMemoryRequirements requirements,
+                      VkMemoryPropertyFlags flags) {
+    uint32_t index = memory.memoryTypeCount;
+    for (uint32_t i = 0; i < memory.memoryTypeCount; ++i)
+      if ((requirements.memoryTypeBits & (1u << i)) &&
+          (memory.memoryTypes[i].propertyFlags & flags) == flags) {
+        index = i;
+        break;
+      }
+    if (index == memory.memoryTypeCount)
+      throw std::runtime_error("Unsupported Vulkan memory type");
+    VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    ai.allocationSize = requirements.size;
+    ai.memoryTypeIndex = index;
+    VkDeviceMemory allocation{};
+    Check(V(vkAllocateMemory)(device, &ai, nullptr, &allocation),
+          "vkAllocateMemory");
+    return allocation;
+  };
+  auto buffer = [&](VkDeviceSize size, VkBufferUsageFlags usage,
+                    VkBuffer &handle, VkDeviceMemory &allocation) {
+    VkBufferCreateInfo bi{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+    bi.size = size;
+    bi.usage = usage;
+    bi.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    Check(V(vkCreateBuffer)(device, &bi, nullptr, &handle), "vkCreateBuffer");
+    VkMemoryRequirements requirements{};
+    V(vkGetBufferMemoryRequirements)(device, handle, &requirements);
