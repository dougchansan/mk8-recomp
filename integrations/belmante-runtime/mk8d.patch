+}
+
+void overlay_note_game_present(uint64_t) {
+    std::lock_guard lk(g_lock);
+    g_game++;
+}
+
+void overlay_note_shown(uint64_t now, uint32_t render_width, uint32_t render_height) {
+    std::lock_guard lk(g_lock);
+    if (!g_window_start) g_window_start = now;
+    if (g_last_shown) {
+        const uint64_t dt = now - g_last_shown;
+        g_sum += dt, g_worst = std::max(g_worst, dt), g_late += dt > 20'000'000;
+    }
+    g_last_shown = now, g_shown++, g_w = render_width, g_h = render_height;
+    const uint64_t span = now - g_window_start;
+    if (span < 500'000'000 || g_shown < 2) return;
+    char b[64];
+    std::vector<std::string> lines;
+    std::snprintf(b, sizeof b, "FPS %.1f", double(g_game) * 1e9 / double(span)), lines.push_back(b);
+    std::snprintf(b, sizeof b, "VPS %.1f", double(g_shown) * 1e9 / double(span)), lines.push_back(b);
+    std::snprintf(b, sizeof b, "FT %.2f MS", double(g_sum) / 1e6 / double(g_shown - 1 ? g_shown - 1 : 1)),
+        lines.push_back(b);
+    std::snprintf(b, sizeof b, "MAX %.2f MS", double(g_worst) / 1e6), lines.push_back(b);
+    std::snprintf(b, sizeof b, "LATE %llu", (unsigned long long)g_late), lines.push_back(b);
+    std::snprintf(b, sizeof b, "RES %uX%u", g_w, g_h), lines.push_back(b);
+    lines.push_back("FG OFF");
+    g_lines = lines;
+    g_window_start = now, g_game = 0, g_shown = 0, g_worst = 0, g_late = 0, g_sum = 0;
+}
+
+std::vector<std::string> overlay_lines() {
+    std::lock_guard lk(g_lock);
+    return g_lines;
+}
+
+}  // namespace nx
