+++ b/native-runtime/shaders/cache_index.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "native_shaders.h"
+#include <string_view>
+namespace native_shaders {
+enum class CapturedCodeLayout { SnapshotCode, InstructionsOnly };
+struct CachedEnvironment {
+  size_t record = 0, environment = 0, file_offset = 0;
+  u64 declared_shader_hash = 0;
+  Snapshot snapshot;
+  std::string code_sha256, instructions_sha256, metadata_sha256,
+      pipeline_key_sha256;
+  std::vector<std::byte> serialized_pipeline_key;
+};
+struct CacheMatch {
+  size_t canonical_entry = 0;
+  std::vector<size_t> identical_aliases;
+};
+// Complete version18 Win64 catalog. No public VideoCommon dependencies.
+class CacheIndex {
+public:
+  static CacheIndex Read(std::span<const std::byte> bytes);
+  const std::vector<CachedEnvironment> &Entries() const { return entries; }
+  size_t RecordCount() const { return records; }
+  std::span<const std::byte> Code(size_t entry,
+                                  CapturedCodeLayout layout) const;
+  CacheMatch
+  MatchComplete(Shader::Stage stage, std::span<const std::byte> complete_code,
+                CapturedCodeLayout layout,
+                std::string_view required_metadata_sha256 = {}) const;
+  std::string MetadataJson(size_t entry) const;
+  static std::string Sha256(std::span<const std::byte> bytes);
+
+private:
+  std::vector<CachedEnvironment> entries;
+  size_t records = 0;
+};
+} // namespace native_shaders
