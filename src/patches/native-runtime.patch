+#ifndef MK8_NATIVE_NVN_BUILDERS_H
+#define MK8_NATIVE_NVN_BUILDERS_H
+#include "query.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum NativeNvnBuilderOperation {
+    NATIVE_NVN_BUFFER_BUILDER_SET_DEVICE = 16,
+    NATIVE_NVN_BUFFER_BUILDER_SET_DEFAULTS = 17,
+    NATIVE_NVN_BUFFER_BUILDER_SET_STORAGE = 18,
+    NATIVE_NVN_MEMORY_POOL_BUILDER_SET_DEVICE = 19,
+    NATIVE_NVN_MEMORY_POOL_BUILDER_SET_DEFAULTS = 20,
+    NATIVE_NVN_MEMORY_POOL_BUILDER_SET_STORAGE = 21,
+    NATIVE_NVN_MEMORY_POOL_BUILDER_SET_FLAGS = 22,
+    NATIVE_NVN_DEVICE_BUILDER_SET_DEFAULTS = 23,
+    NATIVE_NVN_DEVICE_BUILDER_SET_FLAGS = 24
+};
+
+/* One guest store instruction per call. bytes is 4, 8, or 16 (a paired store).
+ * Source contains little-endian bytes. On failure the callback owns any partial
+ * effects of that instruction; earlier successful stores are not rolled back. */
+typedef int (*NativeNvnWrite)(void* user, uint64_t address, const void* source, size_t bytes);
+
+/* arguments[0..3] are guest x0..x3. No arguments or guest register state are
+ * modified. The adapter retains instruction-specific register effects (notably
+ * x8=0x21 for MemoryPoolBuilderSetDefaults) and the return PC. Address arithmetic
+ * wraps modulo 2^64; translation and fault policy belong to the write callback. */
+enum NativeNvnStatus native_nvn_build(enum NativeNvnBuilderOperation operation,
+                                     const uint64_t arguments[4], NativeNvnWrite write,
+                                     void* user);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/src/native_nvn/query.c b/src/native_nvn/query.c
new file mode 100644
--- /dev/null
+++ b/src/native_nvn/query.c
@@ -0,0 +1,29 @@
+#include "query.h"
+
+enum NativeNvnStatus native_nvn_query(enum NativeNvnQuery operation, uint64_t object,
+                                      NativeNvnRead read, void* user, uint64_t* result) {
+    unsigned char bytes[8];
+    size_t width;
+    uint64_t address, value = 0;
+    if (!result) return NATIVE_NVN_INVALID_ARGUMENT;
+    switch (operation) {
+    case NATIVE_NVN_BUFFER_DEBUG_ID:
+        *result = 0;
+        return NATIVE_NVN_OK;
+    case NATIVE_NVN_BUFFER_SIZE:
+        address = object + UINT64_C(32);
+        width = 8;
+        break;
+    case NATIVE_NVN_VERTEX_STREAM_STRIDE:
+        address = object;
+        width = 4;
+        break;
+    default:
+        return NATIVE_NVN_UNSUPPORTED;
+    }
+    if (!read) return NATIVE_NVN_INVALID_ARGUMENT;
+    if (!read(user, address, bytes, width)) return NATIVE_NVN_READ_FAULT;
+    for (size_t i = 0; i < width; ++i) value |= (uint64_t)bytes[i] << (8 * i);
+    *result = value;
+    return NATIVE_NVN_OK;
+}
