+inline bool parse(std::string_view text, Sites& out) {
+    Sites result;
+    while (!text.empty()) {
+        if (result.count == result.values.size()) return false;
+        const auto comma = text.find(',');
+        const auto item = text.substr(0, comma);
+        const auto colon = item.find(':');
+        Site site;
+        if (colon == item.npos || !number(item.substr(0, colon), site.caller, 16)) return false;
