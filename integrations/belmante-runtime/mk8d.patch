+# SPDX-License-Identifier: GPL-3.0-or-later
+# Local checked reader; not part of the upstream MIT code.
+import struct
+def require(ok, message):
+    if not ok: raise ValueError(message)
+def checked(data, offset, count):
+    require(0<=offset<=len(data) and 0<=count<=len(data)-offset, f'input bounds {offset:x}+{count:x}')
+    return data[offset:offset+count]
+
+def decompress(src, size):
+    """Checked independent LZ4-block reader for preparation, no external import."""
+    out=bytearray(); pos=0
+    def length(initial):
+        nonlocal pos
+        n=initial
+        if n==15:
+            while True:
+                b=checked(src,pos,1)[0]; pos+=1; n+=b
+                require(n<=size,'LZ4 length overflow')
+                if b!=255: break
+        return n
+    while pos<len(src):
+        token=src[pos]; pos+=1
+        n=length(token>>4); require(n<=size-len(out),'LZ4 literal overflow')
+        out.extend(checked(src,pos,n)); pos+=n
+        if pos==len(src): break
+        offset=struct.unpack('<H',checked(src,pos,2))[0]; pos+=2
+        require(0<offset<=len(out),'LZ4 invalid backreference')
+        n=length(token&15)+4; require(n<=size-len(out),'LZ4 match overflow')
+        for _ in range(n): out.append(out[-offset])
+    require(pos==len(src) and len(out)==size,'LZ4 exact size')
+    return bytes(out)
