+namespace native_services {
+inline constexpr uint32_t SessionHandleFirst=native::SessionHandleBegin;
+inline constexpr uint32_t SessionHandleLast=native::SessionHandleEnd-1;
+struct GuestMemory {
+    void* user{};
+    bool (*read)(void*, uint64_t, std::span<std::byte>){};
+    // Must preflight the complete destination: false means no bytes changed.
+    bool (*write)(void*, uint64_t, std::span<const std::byte>){};
+};
+enum class Status { Ok, Unsupported, Malformed, MemoryFault, InvalidHandle, InvalidProcess, InvalidState, Exhausted, SessionClosed };
+struct Outcome {
+    Status status{Status::Ok};
+    uint32_t kernel_result{};
+    uint32_t handle{};
+    std::string diagnostic;
+};
+struct Request {
+    uint32_t command{}, token{};
+    uint64_t process_id{}; // Supplied by the owning native process, never client PID bytes.
+    bool send_pid{};
+    std::span<const std::byte> payload;
+    struct ReadBuffer {
+        uint64_t address{}, size{};
+        // X buffers are copied into an actual owned per-session pointer arena.
+        // Borrowed only during Prepare; endpoints must not retain this view.
+        std::span<const std::byte> snapshot;
+        uint32_t pointer_index{UINT32_MAX};
+    };
+    std::span<const ReadBuffer> read_buffers;
+    GuestMemory memory;
+    // Every handle here passed the owning CPU's typed-process validator.
+    std::span<const uint32_t> copied_process_handles;
+    std::span<const uint32_t> incoming_domain_objects;
+    // Passive parse fact: domain payload has an explicit semantic CMIF size.
+    bool domain_payload{};
+};
+class Endpoint;
+struct Reply {
+    Status status{Status::Unsupported};
+    uint32_t service_result{};
+    std::vector<std::byte> payload;
+    std::string diagnostic;
+    // Prepare must not change externally visible state. Commit runs only after a
+    // successful complete response write. A delivery exception is fatal to native
+    // bring-up: the host must stop before resuming guest code, never swallow it.
+    std::function<void()> commit;
+    std::unique_ptr<Endpoint> moved_endpoint;
+    native::EventRef copied_event;
+    // Optional pure epoch check immediately before the response write.
+    std::function<bool()> validate;
+};
+class Endpoint {
+public:
+    virtual ~Endpoint() = default;
+    virtual bool AcceptsProcessHandles() const { return false; }
+    virtual bool AcceptsDomainObjects() const { return false; }
+    virtual Reply Prepare(const Request&) = 0;
+};
+class Router {
+public:
+    explicit Router(uint64_t process_id,uint16_t pointer_buffer_capacity=0);
+    // Factory must create a real implemented endpoint, without external effects.
+    bool Register(std::string name, std::function<std::unique_ptr<Endpoint>()> factory);
+    void SetProcessHandleValidator(std::function<bool(uint32_t,uint64_t)> validator) {
+        process_handle_validator_=std::move(validator);
+    }
+    void SetEventExporter(std::function<std::unique_ptr<native::ScopedEventExport>(
+                              const native::EventRef&,uint64_t)> exporter) {
+        event_exporter_=std::move(exporter);
+    }
+    Outcome Connect(std::string_view name);
+    Outcome Send(uint32_t handle, GuestMemory memory, uint64_t tls_base, uint64_t process_id);
+    Outcome Close(uint32_t handle);
+    size_t SessionCount() const { return sessions_.size(); }
+private:
+    struct ServiceState {
+        bool sm{},initialized{},domain{};
+        std::unique_ptr<Endpoint> endpoint;
+        uint32_t next_object_id{1};
+        std::map<uint32_t,std::unique_ptr<Endpoint>> domain_objects;
+    };
+    struct Session {
+        bool protocol_closed{};
+        uint64_t process{};
+        std::shared_ptr<ServiceState> state;
+        std::vector<std::byte> pointer_arena;
+    };
+    uint64_t process_id_;
+    uint16_t pointer_buffer_capacity_;
+    uint32_t next_handle_{SessionHandleFirst};
+    std::map<std::string, std::function<std::unique_ptr<Endpoint>()>> endpoints_;
+    std::map<uint32_t, Session> sessions_;
+    std::function<bool(uint32_t,uint64_t)> process_handle_validator_;
+    std::function<std::unique_ptr<native::ScopedEventExport>(const native::EventRef&,uint64_t)> event_exporter_;
+};
