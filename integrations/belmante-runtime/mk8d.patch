+    // RestrictedPeer selects only a fixed capability-zero port from the list above.
+    // The default retains pctl:s; no arbitrary name/mask or global policy is admitted.
+    static std::shared_ptr<ParentalControlContext> Unconfigured(uint64_t owned_process,
+        AddOnProgramIdentity,uint32_t capabilities=NamedPctlCapabilities);
