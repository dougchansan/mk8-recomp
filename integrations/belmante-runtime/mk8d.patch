+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+
+namespace nx::perf {
+enum class Region { Replay, Draw, Compute, Textures, Sets, Pipeline, SampledView, Upload,
+                    Dedup, Present, Timestamp, Focus, Logging, State, Clear, Copy, ListLookup, TargetRecording, TextureIdentity, SdkViewRead, Count };
+inline constexpr std::array names = {"replay", "draw", "compute", "textures", "sets", "pipeline",
+    "sampled-view", "upload", "dedup", "present", "timestamp", "focus-sampled-1024", "logging",
+    "state", "clear", "copy", "list-lookup", "target-recording", "texture-identity", "sdk-view-read"};
+static_assert(names.size() == size_t(Region::Count));
+struct Sample { uint64_t calls{}, inclusive_ns{}, exclusive_ns{}; };
+struct Counter { std::atomic<uint64_t> calls{}, inclusive_ns{}, exclusive_ns{}; };
+inline std::array<Counter, size_t(Region::Count)> counters;
+inline bool enabled() {
+    static const bool value = [] { const auto* e = std::getenv("NX_NATIVE_PERF"); return e && e[0] == '1'; }();
+    return value;
+}
+inline uint64_t now() {
+    return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+// Exclusive time subtracts instrumented children on the same thread. Regions on
+// different threads can overlap. A scope is assigned to the window when it ends.
+class Scope {
+    inline static thread_local Scope* current{};
+    Scope* parent{};
+    Region region;
+    uint64_t start{}, children{};
+    uint32_t weight;
+    bool active;
+public:
+    explicit Scope(Region value, bool on = enabled(), uint32_t sample_weight = 1)
+        : region(value), weight(sample_weight), active(on) {
+        if (active) { parent = current; current = this; start = now(); }
+    }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+    ~Scope() {
+        if (!active) return;
+        const auto elapsed = now() - start;
+        current = parent;
+        if (parent) parent->children += elapsed;
+        auto& c = counters[size_t(region)];
+        c.inclusive_ns.fetch_add(elapsed * weight, std::memory_order_relaxed);
+        c.exclusive_ns.fetch_add((elapsed > children ? elapsed - children : 0) * weight, std::memory_order_relaxed);
+        c.calls.fetch_add(weight, std::memory_order_relaxed);
+    }
+};
+inline Sample take(Region value) {
+    auto& c = counters[size_t(value)];
+    return {c.calls.exchange(0, std::memory_order_relaxed),
+            c.inclusive_ns.exchange(0, std::memory_order_relaxed),
+            c.exclusive_ns.exchange(0, std::memory_order_relaxed)};
+}
+}
