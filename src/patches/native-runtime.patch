+        consumer{vertex, sample, samplePlan};
+    UniformBinding uniforms[] = {{0, 0x3010, 0, 16}};
+    DrawDescription draw;
+    draw.vertices = 0x3000;
+    draw.uniforms = uniforms;
+    unsigned rejects = 0;
+    auto Reject = [&](auto action) {
+      try {
+        action();
+      } catch (const std::runtime_error &) {
+        ++rejects;
+        return;
+      }
+      throw std::runtime_error("Expected frame rejection");
+    };
+    FrameImages images(resources, 0x1000);
+    ImageDescription desc;
+    desc.backing = {1, 1, 0, 64 * 64 * 4};
+    auto a = images.CreateImage(desc);
+    Check(images.CreateImage(desc) == a, "Exact alias did not canonicalize");
+    auto bdesc = desc;
+    bdesc.backing.identity = 2;
+    auto b = images.CreateImage(bdesc);
+    auto av = images.CreateView(a), bv = images.CreateView(b);
+    auto sampler = images.CreateSampler();
+    Reject([&] { resources.DestroyDevice(0x1000); });
+    Reject([&] {
+      auto d = desc;
+      d.width = 0;
+      images.CreateImage(d);
+    });
+    Reject([&] {
+      auto d = desc;
+      d.mips = 2;
+      images.CreateImage(d);
+    });
+    Reject([&] {
+      auto d = desc;
+      d.usage = 128;
+      images.CreateImage(d);
+    });
+    Reject([&] {
+      auto d = desc;
+      d.backing.offset = 8;
+      images.CreateImage(d);
+    });
+    Reject([&] {
+      auto d = desc;
+      d.width = 32;
+      d.height = 128;
+      images.CreateImage(d);
+    });
+    Reject([&] {
+      auto d = desc;
+      d.backing.offset = UINT64_MAX - 4;
+      images.CreateImage(d);
+    });
+    Reject(
+        [&] { images.CreateView(a, {ImageFormat::Rgba8Unorm, 1, 1, 0, 1}); });
