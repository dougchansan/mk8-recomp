+      Reset();
+      auto invalid = binding;
+      if (mode == 0)
+        recomp_native_pending_bind_v3(nullptr);
+      if (mode == 1) {
+        invalid.revision = 2;
+        Check(!recomp_native_pending_bind_v3(&invalid), "revision reject");
+      }
+      if (mode == 2) {
+        invalid.size--;
+        Check(!recomp_native_pending_bind_v3(&invalid), "size reject");
+      }
+      if (mode == 3) {
+        invalid.context_size--;
+        Check(!recomp_native_pending_bind_v3(&invalid), "context reject");
+      }
+      if (mode == 4) {
+        invalid.layout_tag++;
+        Check(!recomp_native_pending_bind_v3(&invalid), "layout reject");
+      }
+      if (mode == 5) {
+        invalid.pending_halt = 2;
+        Check(!recomp_native_pending_bind_v3(&invalid), "tag collision reject");
+      }
+      if (mode == 6) {
+        invalid.capabilities ^= 1;
+        Check(!recomp_native_pending_bind_v3(&invalid), "cap reject");
+      }
+      if (mode == 7) {
+        invalid.admit = nullptr;
+        Check(!recomp_native_pending_bind_v3(&invalid), "handler reject");
+      }
+      if (mode == 8)
+        Check(!recomp_image_native_pending_v3(
+                  2, sizeof(GuestContext), RECOMP_NATIVE_PENDING_LAYOUT_V3,
+                  RECOMP_HALT_NATIVE_PENDING_V3, RECOMP_NATIVE_PENDING_CAPS_V3),
+              "old module host reject");
+      auto c = Fresh(0x1000), old = c;
+      Check(Slice(c) == 1, "unsupported actual entry counted once");
+      Check(c.halted == RECOMP_HALT_NATIVE_UNSUPPORTED_V3 && !model.admits &&
+                c.x[0] == old.x[0] && !model.output,
+            "strict no fallback");
+    }
+    // All return kinds, synchronous and parked. Pending changes only halt
+    // transport.
+    for (unsigned kind = 0; kind < 9; kind++)
+      for (bool sync : {false, true}) {
+        Reset();
+        model.sync = sync;
+        if (kind == 5)
+          model.result = 0x4500;
+        auto c = Fresh(0x1000 + kind * 0x20), old = c;
+        Check(Slice(c) == 1 && model.admits == 1, "single entry");
+        if (!sync) {
+          auto expected = old;
+          expected.halted = RECOMP_HALT_NATIVE_PENDING_V3;
+          Check(!std::memcmp(&c, &expected, sizeof(c)),
+                "only halt tag changes at pending");
+          Check(Resume(c) == RECOMP_NATIVE_V3_PARKED && !model.commits,
+                "incomplete returns parked");
+          model.input.fill(99);
+          Check(model.record.snapshot.bytes[0] == 1 &&
+                    model.record.snapshot.argument == old.x[0],
+                "immutable owned inputs");
+          Worker();
+          Check(Resume(c) == RECOMP_NATIVE_V3_COMMITTED, "owner commit");
+        }
+        Check(!c.halted && c.pc == old.x[30] && model.output == model.result &&
+                  model.commits == 1,
+              "return publication once");
+        Abi(c, old);
+        if (kind == 0)
+          Check(c.x[0] == 1, "bool canonical");
+        if (kind == 1 || kind == 2)
+          Check(c.x[0] == uint32_t(model.result), "32-bit W0 zero extension");
+        if (kind >= 3 && kind <= 5)
+          Check(c.x[0] == model.result, "64-bit/pointer result");
+        if (kind >= 6)
+          Check(c.x[0] == old.x[0],
+                "void/FP preserves integer result register");
+        if (kind == 7)
+          Check(c.vreg[0][0] == ((old.vreg[0][0] & 0xffffffff00000000ULL) |
+                                 uint32_t(model.result)) &&
+                    c.vreg[0][1] == old.vreg[0][1],
+                "s0 bits");
+        if (kind == 8)
+          Check(c.vreg[0][0] == model.result && c.vreg[0][1] == old.vreg[0][1],
+                "d0 bits");
+        Check(recomp_native_pending_counters_v3.calls == 1 &&
+                  recomp_native_pending_counters_v3.pending_jobs == !sync &&
+                  recomp_native_pending_counters_v3.yields == !sync &&
+                  recomp_native_pending_counters_v3.completions == 1 &&
+                  recomp_native_pending_counters_v3.work_units == 7,
+              "exact separate native counters");
+        if (!sync)
+          Check(Resume(c) == RECOMP_NATIVE_V3_NOT_PENDING && model.commits == 1,
+                "duplicate completion ignored");
+      }
+    for (bool sync : {false, true}) {
+      Reset();
+      model.sync = sync;
+      model.result = 0;
+      auto c = Fresh(0x1000);
+      Slice(c);
+      if (!sync) {
+        Worker();
+        Check(Resume(c) == RECOMP_NATIVE_V3_COMMITTED,
+              "completed false API result");
+      }
+      Check(!c.halted && c.pc == 0x5000 && c.x[0] == 0 &&
+                recomp_native_pending_counters_v3.completions == 1 &&
+                !recomp_native_pending_counters_v3.failures,
+            "public Boolean false differs from transport failure");
+    }
+    // Real entered-block accounting and LR continuation across both chain
+    // modes.
+    for (auto entry : {0x1000u, 0x1200u, 0x1210u, 0x3000u})
+      for (int budget : {0, 1, 2, 8}) {
+        Reset();
+        auto c = Fresh(entry, budget);
+        unsigned blocks = Slice(c, entry == 0x3000);
+        if (!budget) {
+          Check(!blocks && !model.admits, "exhausted budget");
+          continue;
+        }
+        if (c.pc == 0x1000 && !c.halted) {
+          c.chain_budget = 8;
+          blocks += Slice(c);
+        }
+        Check(c.halted == RECOMP_HALT_NATIVE_PENDING_V3 &&
+                  blocks == (entry == 0x1000 ? 1u : 2u) && model.admits == 1 &&
+                  c.x[10] == 0x1111000a,
+              "unwind before continuation");
+        const auto saved_lr = model.record.request.frame.return_pc;
+        Worker();
+        Check(Resume(c) == RECOMP_NATIVE_V3_COMMITTED && c.pc == saved_lr,
+              "saved guest LR");
+        if (entry != 0x1000) {
+          c.chain_budget = 8;
+          Check(Slice(c, entry == 0x3000) == 1 && c.x[10] == 0x1111000b &&
+                    c.pc == 0x5000,
+                "resume continuation in new allocation exactly once");
+        }
+      }
+    for (unsigned kind = 0; kind < 9; kind++)
+      for (auto offset : {4u, 16u, 20u}) {
+        Reset();
+        auto c = Fresh(0x1000 + kind * 0x20 + offset);
+        Slice(c);
+        Check(c.halted == RECOMP_HALT_NATIVE_UNSUPPORTED_V3 && !model.admits,
+              "strict interiors reject");
+      }
+    // Every revocation is checked after admission before publication.
+    for (unsigned mode = 0; mode < 6; mode++) {
+      Reset();
+      auto c = Fresh(0x1000);
+      Slice(c);
+      Worker();
+      if (mode == 0) {
+        model.provider++;
+        model.epoch++;
+      }
+      if (mode == 1) {
+        model.seal++;
+        model.epoch++;
+      }
+      if (mode == 2) {
+        model.space++;
+        model.epoch++;
+      }
+      if (mode == 3) {
+        model.descriptor++;
+        model.epoch++;
+      }
+      if (mode == 4)
+        recomp_native_pending_bind_v3(nullptr);
+      if (mode == 5)
+        recomp_image_native_pending_v3(
+            3, sizeof(GuestContext), RECOMP_NATIVE_PENDING_LAYOUT_V3,
+            RECOMP_HALT_NATIVE_PENDING_V3, RECOMP_NATIVE_PENDING_CAPS_V3);
+      Check(Resume(c) == RECOMP_NATIVE_V3_TERMINAL_FAILED && !model.commits &&
+                !model.output,
+            "revoked admission cannot commit");
+      Terminal(c, RECOMP_NATIVE_V3_TERMINAL_FAILED);
+      model.record.retained.reset();
+    }
+    for (unsigned phase = 0; phase < 3; phase++) {
+      Reset();
+      auto c = Fresh(0x1000);
+      Slice(c);
+      auto resource = std::weak_ptr<unsigned>(model.record.retained);
+      if (phase == 1)
+        model.record.started = true;
+      if (phase == 2)
+        Worker();
+      Check(AbortJob(c) == RECOMP_NATIVE_V3_TERMINAL_CANCELLED && !model.output,
+            "cancel no success");
+      if (phase == 1) {
+        Check(!resource.expired(), "running resource retained");
+        Worker();
+        Check(resource.expired() && model.late == 1,
+              "late private completion drained");
+      }
+      Terminal(c, RECOMP_NATIVE_V3_TERMINAL_CANCELLED);
+      model.record.retained.reset();
+    }
+    Reset();
+    {
+      auto c = Fresh(0x1000);
+      Slice(c);
+      Worker();
+      model.commit_fault = true;
+      Check(Resume(c) == RECOMP_NATIVE_V3_TERMINAL_FAILED &&
+                model.output == (model.result & 255),
+            "partial commit fault terminal");
+      Terminal(c, RECOMP_NATIVE_V3_TERMINAL_FAILED);
+    }
+    Reset();
+    {
+      auto c = Fresh(0x1000);
+      Slice(c);
+      const auto request = model.record.request;
+      const auto token = model.record.token;
+      auto reused = c;
+      const auto unchanged = reused;
+      Check(recomp_native_pending_poll_v3(&reused, &request, token,
+                                          model.thread, model.generation + 1,
+                                          token) == RECOMP_NATIVE_V3_STALE &&
+                !std::memcmp(&reused, &unchanged, sizeof(reused)),
+            "context generation reuse");
+      Check(recomp_native_pending_poll_v3(&reused, &request, token,
+                                          model.thread + 1, model.generation,
+                                          token) == RECOMP_NATIVE_V3_STALE &&
+                !std::memcmp(&reused, &unchanged, sizeof(reused)),
+            "thread reuse");
+      Check(recomp_native_pending_poll_v3(
+                &reused, &request, token, model.thread, model.generation,
+                token + 1) == RECOMP_NATIVE_V3_STALE &&
+                !std::memcmp(&reused, &unchanged, sizeof(reused)),
+            "new active token protected");
+      AbortJob(c);
+    }
+    for (bool sync : {false, true})
+      for (int outcome :
+           std::array<int, 2>{int(RECOMP_NATIVE_V3_COMMIT_CANCELLED), 99}) {
+        Reset();
+        model.sync = sync;
+        model.commit_override = outcome;
+        auto c = Fresh(0x1000);
+        Slice(c);
+        const auto expected = outcome == RECOMP_NATIVE_V3_COMMIT_CANCELLED
+                                  ? RECOMP_NATIVE_V3_TERMINAL_CANCELLED
+                                  : RECOMP_NATIVE_V3_TERMINAL_FAILED;
+        if (!sync) {
+          Worker();
+          Check(Resume(c) == expected, "explicit commit claim outcome");
+        }
+        Check(c.halted == (outcome == RECOMP_NATIVE_V3_COMMIT_CANCELLED
+                               ? RECOMP_HALT_NATIVE_CANCELLED_V3
+                               : RECOMP_HALT_NATIVE_FAILED_V3) &&
+                  !model.output &&
+                  !recomp_native_pending_counters_v3.completions,
+              "no success on cancelled or invalid commit");
+        Check(recomp_native_pending_counters_v3.cancellations ==
+                      (outcome == RECOMP_NATIVE_V3_COMMIT_CANCELLED) &&
+                  recomp_native_pending_counters_v3.failures ==
+                      (outcome != RECOMP_NATIVE_V3_COMMIT_CANCELLED),
+              "commit tri-state classification counters");
+        Terminal(c, expected);
+        model.record.retained.reset();
+      }
+    // Preparation/allocation/read/upload/compile/driver/deadline failures are
+    // synthetic worker terminal states here, not claims of real GPU behavior.
+    for (unsigned failure = 0; failure < 6; failure++) {
+      Reset();
+      auto c = Fresh(0x1000);
+      Slice(c);
+      model.record.state.store(RECOMP_NATIVE_V3_FAILED,
+                               std::memory_order_release);
+      Check(Resume(c) == RECOMP_NATIVE_V3_TERMINAL_FAILED && !model.commits &&
+                !model.output,
+            "failed/deadline job cannot publish success");
+      Terminal(c, RECOMP_NATIVE_V3_TERMINAL_FAILED);
+      model.record.retained.reset();
+    }
+    // Teardown cancels before context destruction; late work owns no context.
+    Reset();
+    {
+      auto c = Fresh(0x1000);
+      Slice(c);
+      model.record.started = true;
+      AbortJob(c);
+      ++model.generation;
+      ++model.epoch;
+    }
+    Worker();
+    Check(model.late == 1 && !model.output && !model.record.retained,
+          "process teardown safely drains private work");
+    std::cout
+        << "{\"passed\":true,\"chain_mode\":" << FIXTURE_CHAIN
+        << ",\"return_kinds\":9,\"routes\":4,\"budgets\":4,\"revocations\":6,"
+           "\"terminal_no_repeat\":true,\"gpu_work\":false}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
