new file mode 100644
--- /dev/null
+++ b/tests/native_pending/generate.cpp
@@ -0,0 +1,159 @@
+#include "core/recompiler/arm64_to_c.h"
+#include <iostream>
+using namespace suyu::recomp;
+using Files = std::map<std::string, std::string>;
+static Files Read(const std::filesystem::path &root) {
+  Files f;
+  for (auto &p : std::filesystem::recursive_directory_iterator(root))
+    if (p.is_regular_file()) {
+      std::ifstream input(p.path(), std::ios::binary);
+      f[p.path().lexically_relative(root).generic_string()] = {
+          std::istreambuf_iterator<char>(input), {}};
+    }
+  return f;
+}
+static void Replace(std::string &text, const std::string &from,
+                    const std::string &to) {
+  auto at = text.find(from);
+  if (at == std::string::npos)
+    throw std::runtime_error("fixture chain site missing");
+  text.replace(at, from.size(), to);
+}
+static void Chain(const std::filesystem::path &root, bool target) {
+  const auto path =
+      root / "src" /
+      (target ? "recompiled_pending_0.c" : "recompiled_pendingcaller_0.c");
+  std::ifstream input(path, std::ios::binary);
+  std::string text{std::istreambuf_iterator<char>(input), {}};
+  std::unordered_set<u64> blocks{0x1000};
+  g_chain_blocks = &blocks;
+  g_chain_mod = "pending";
+  if (target)
+    Replace(text, "c->pc=g_module_base+0x1000ULL; return;", ChainTo(0x1000));
+  Replace(text, "c->pc=_target; return;", ChainIndirect("_target"));
+  g_chain_blocks = nullptr;
+  g_chain_mod = nullptr;
+  std::ofstream(path, std::ios::binary) << text;
+}
+int main(int argc, char **argv) {
+  if (argc != 2 && (argc != 3 || std::string(argv[2]) != "--native-profile"))
+    return 2;
+  const std::filesystem::path root = argv[1];
+  if (argc == 3) {
+    g_emit_fastmem = true;
+    g_emit_guard_gen = true;
+    g_emit_fpx = true;
+    g_emit_fpx_shadow = false;
+  }
+  const std::string build(64, 'a'), digest(64, 'b'), contract(64, 'c');
+  std::vector<uint32_t> words(0x220 / 4, 0xd4200000);
+  std::vector<u64> roots;
+  std::vector<NativePendingDescriptor> descriptors;
+  for (unsigned i = 0; i < 9; i++) {
+    const auto entry = 0x1000 + i * 0x20, body = entry + 0x10;
+    const auto at = i * 8;
+    words[at] = 0xaa0003e8;
+    words[at + 1] = 0x14000003;
+    words[at + 4] = 0x52800c60;
+    words[at + 5] = 0xd65f03c0;
+    roots.push_back(entry);
+    descriptors.push_back({"pending",
+                           build,
+                           digest,
+                           contract,
+                           entry,
+                           i + 1,
+                           1,
+                           static_cast<NativePendingReturn>(i),
+                           false,
+                           {{entry, {words[at], words[at + 1]}},
+                            {body, {words[at + 4], words[at + 5]}}}});
+  }
+  words[0x200 / 4] = 0x97ffff80;
+  words[0x204 / 4] = 0x9100054a;
+  words[0x208 / 4] = 0xd61f02a0;
+  words[0x210 / 4] = 0xd63f0280;
+  words[0x214 / 4] = 0x9100054a;
+  words[0x218 / 4] = 0xd61f02a0;
+  roots.push_back(0x1200);
+  roots.push_back(0x1210);
+  auto emit = [&](const std::string &name,
+                  const std::string &id = std::string()) {
+    EmitProject("pending", reinterpret_cast<const u8 *>(words.data()),
+                words.size() * 4, 0x1000, (root / name).string(), true, nullptr,
+                0, nullptr, 0, 0, {}, &roots, 32u << 20,
+                id.empty() ? build : id, digest);
+    return Read(root / name);
+  };
+  const auto off = emit("off");
+  const std::vector<NativeApiRange> whole_ranges = {
+      {0x1200, {words[0x200 / 4]}},
+      {0x1204, {words[0x204 / 4], words[0x208 / 4]}}};
+  g_emit_native_apis = {
+      {"pending", build, digest, 0x1200, 55, 1, whole_ranges}};
+  try {
+    emit("v2-external-call");
+    return 6;
+  } catch (const std::runtime_error &) {
+  }
+  g_emit_native_apis.clear();
+  // A separate explicit whole-API contract may replace BL/indirect internals;
+  // this checks descriptor acceptance only, never invokes an unknown provider.
+  g_emit_native_pending = {{"pending", build, digest, contract, 0x1200, 55, 1,
+                            NativePendingReturn::Boolean, false, whole_ranges}};
+  emit("whole-contract");
+  g_emit_native_pending = descriptors;
+  emit("on");
+  emit("chain");
+  Chain(root / "chain", true);
+  if (emit("unknown", std::string(64, 'd')) != off)
+    return 3;
+  for (auto &d : g_emit_native_pending)
+    d.comparison_mode = true;
+  emit("comparison");
+  for (unsigned mode = 0; mode < 3; mode++) {
+    g_emit_native_pending = descriptors;
+    if (mode == 0)
+      g_emit_native_pending[0].ranges[1].words.pop_back();
+    if (mode == 1)
+      g_emit_native_pending[0].contract_sha256 = "unverified";
+    if (mode == 2)
+      g_emit_native_pending.push_back(descriptors[0]);
+    try {
+      emit("invalid" + std::to_string(mode));
+      return 4;
+    } catch (const std::runtime_error &) {
+    }
+  }
+  g_emit_native_pending.clear();
+  if (emit("off2") != off)
+    return 5;
+  const uint32_t caller[] = {0xd63f0280, 0x9100054a, 0xd61f02a0};
+  for (const auto &name : {"caller", "callerchain"})
+    EmitProject("pendingcaller", reinterpret_cast<const u8 *>(caller),
+                sizeof(caller), 0x3000, (root / name).string(), true);
+  Chain(root / "callerchain", false);
+  if (argc == 3) {
+    for (const auto &name : {"on", "chain", "comparison"}) {
+      const auto path = root / name / "src" / "recompiled_pending_0.c";
+      std::ifstream input(path, std::ios::binary);
+      std::string text{std::istreambuf_iterator<char>(input), {}};
+      Replace(text, "RECOMP_GG_GUARD(_expected,0U);",
+              "if(RECOMP_GG_LOAD(recomp_gg_seen[0])!=RECOMP_GG_LOAD(g_recomp_"
+              "gg_word)) ++pending_fixture_guard_misses; "
+              "RECOMP_GG_GUARD(_expected,0U);");
+      text = "#include <stdint.h>\nuint64_t pending_fixture_guard_misses;\n" +
+             text;
+      text += "\nuint32_t pending_fixture_guard_seen(void){return "
+              "RECOMP_GG_LOAD(recomp_gg_seen[0]);}\n";
+      std::ofstream(path, std::ios::binary) << text;
+    }
+  }
+  // Preserve append-only helper outputs for optional CPU-owner integration.
+  std::ofstream(root / "native-pending.h", std::ios::binary)
+      << NativePendingH();
+  std::ofstream(root / "native-pending.c", std::ios::binary)
+      << NativePendingC();
+  std::cout << "v3 off/on/off identity/contracts, explicit owned chain modes,9 "
+               "ABI kinds ready\n";
+}
