+bool overlay_raster(const std::vector<std::string>& lines, uint32_t scale, std::vector<uint32_t>& pixels,
+                    uint32_t& width, uint32_t& height) {
+    scale = std::clamp<uint32_t>(scale, 1, 8);
+    size_t columns = 1;
+    for (const auto& l : lines) columns = std::max(columns, l.size());
+    const uint32_t pad = 2 * scale, cell_w = 6 * scale, cell_h = 9 * scale;
+    width = uint32_t(columns) * cell_w + 2 * pad;
+    height = uint32_t(std::max<size_t>(1, lines.size())) * cell_h + 2 * pad;
+    pixels.assign(size_t(width) * height, 0xFF101010u);  // BGRA: dark grey panel, opaque
+    bool all = true;
+    for (size_t row = 0; row < lines.size(); row++)
+        for (size_t col = 0; col < lines[row].size(); col++) {
+            const char* g = glyph(lines[row][col]);
+            if (!g) all = false;
+            for (uint32_t gy = 0; gy < 7; gy++)
+                for (uint32_t gx = 0; gx < 5; gx++) {
+                    const bool on = g ? g[gy * 5 + gx] == '#' : (gx == 0 || gx == 4 || gy == 0 || gy == 6);
+                    if (!on) continue;
