+        Put(4,uint32_t((raw+24-cursor)/4)|(pid?0x80000000u:0));
+        if(pid) { Put(8,1); Put(12,0xdeadbeef); Put(16,0xfedcba98); }
+        Put(raw,0x49434653); Put(raw+8,command);
+        for(size_t i=0;i<name.size() && i<8;++i)bytes[raw+16+i]=std::byte(name[i]);
+    }
+    void LogRequest(bool map_alias=false) {
+        bytes.fill(std::byte{});
+        const size_t raw=map_alias?32:16,cursor=map_alias?20:16;
+        Put(0,4|(map_alias?(1<<20):(1<<16)));
+        Put(4,uint32_t((raw+24-cursor)/4));
+        if(map_alias) { Put(8,uint32_t(packet.size()));Put(12,0x3000); }
+        else { Put(8,uint32_t(packet.size())<<16);Put(12,0x3000); }
+        Put(raw,0x49434653);
+    }
+    void OpenApplicationRequest(uint32_t handle,bool pid=true) {
+        bytes.fill(std::byte{});
+        const size_t cursor=pid?24:16,raw=pid?32:16;
+        Put(0,4);Put(4,0x80000000u|uint32_t((raw+24-cursor)/4));
+        Put(8,pid?3:2);
+        if(pid) { Put(12,0x12345678);Put(16,0xffffffff); }
+        Put(pid?20:12,handle);
+        Put(raw,0x49434653);
+    }
+    void PointerRequest(unsigned count,unsigned size) {
+        bytes.fill(std::byte{});
+        const size_t cursor=8+count*8,raw=(cursor+15)&~size_t(15);
+        Put(0,4|(count<<16));Put(4,uint32_t((raw+24-cursor)/4));
+        for(unsigned i=0;i<count;++i) { Put(8+i*8,size<<16);Put(12+i*8,0x3000); }
+        Put(raw,0x49434653);Put(raw+8,7);
+    }
+    void DomainRequest(uint32_t object,uint32_t command,bool close=false,
+                       std::span<const uint32_t> incoming={}) {
+        bytes.fill(std::byte{});Put(0,4);
+        const size_t cmif_size=close?0:16;
+        Put(4,uint32_t((32+cmif_size+4*incoming.size())/4));
+        Put(16,(close?2u:1u)|(uint32_t(incoming.size())<<8)|(uint32_t(cmif_size)<<16));
+        Put(20,object);
+        if(!close) { Put(32,0x49434653);Put(40,command); }
+        for(size_t i=0;i<incoming.size();++i)Put(32+cmif_size+4*i,incoming[i]);
+    }
+};
