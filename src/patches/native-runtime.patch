+#ifndef MK8_NATIVE_NVN_QUERY_H
+#define MK8_NATIVE_NVN_QUERY_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Values identify contracts, never host addresses. */
+enum NativeNvnQuery {
+    NATIVE_NVN_BUFFER_SIZE = 1,
+    NATIVE_NVN_BUFFER_DEBUG_ID = 2,
+    NATIVE_NVN_VERTEX_STREAM_STRIDE = 3
+};
+enum NativeNvnStatus {
+    NATIVE_NVN_OK = 0,
+    NATIVE_NVN_UNSUPPORTED = 1,
+    NATIVE_NVN_READ_FAULT = 2,
+    NATIVE_NVN_INVALID_ARGUMENT = 3,
+    NATIVE_NVN_WRITE_FAULT = 4
+};
+/* Read exactly bytes into destination, or fail without modifying it. */
+typedef int (*NativeNvnRead)(void* user, uint64_t address, void* destination, size_t bytes);
+/* Object layout is the verified MK8D SDK build's compatibility representation.
+ * No device allocation, driver dispatch or graphics submission is performed here.
+ * On failure, result is unchanged. All guest addresses remain integer addresses. */
+enum NativeNvnStatus native_nvn_query(enum NativeNvnQuery operation, uint64_t object,
+                                      NativeNvnRead read, void* user, uint64_t* result);
+#ifdef __cplusplus
+}
+#endif
+#endif
