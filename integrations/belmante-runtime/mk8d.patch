+}
+void ParentalControlContext::Retire(){Owner();live_=false;retired_=true;pending_.reset();validated_=0;
+    for(const auto& child:children_)child->state.retired=true;}
+void ParentalControlContext::RetireChild(const std::shared_ptr<Child>& child) noexcept {
+    if(owner_!=std::this_thread::get_id())std::terminate();
+    child->state.retired=true;
+}
+std::shared_ptr<ParentalControlContext::Child> ParentalControlContext::NewChild(uint32_t command,bool initialize) {
+    Owner();if(!Live() || children_.size()>=1024 || !Room(child_constructions_))throw std::runtime_error("PCTL owned child capacity exhausted");
+    auto child=std::make_shared<Child>();child->state.generation=NewGeneration();child->state.create_command=command;
+    child->event=std::make_shared<native::NativeEvent>(process_);
+    // Root compatibility policy, not a claim that reference factory calls Initialize.
+    child->state.initialized=initialize;children_.push_back(child);++child_constructions_;return child;
+}
+ParentalReplyFacts& ParentalControlContext::Facts(Ticket t,const std::shared_ptr<Child>& child) {
+    if(t.manager){if(t.index>=manager_facts_.size())throw std::runtime_error("PCTL manager fact index");return manager_facts_[t.index];}
+    if(!child || t.index>=child->state.commands.size())throw std::runtime_error("PCTL child fact index");
+    return child->state.commands[t.index];
+}
+ParentalControlContext::Ticket ParentalControlContext::Prepare(bool manager,unsigned index,const std::shared_ptr<Child>& child,
+        bool initialize,bool publish,uint32_t result) {
+    Owner();if(!Live() || !Room(next_))throw std::runtime_error("PCTL reply authority exhausted");
+    Ticket t{next_+1,generation_,child?child->state.generation:0,index,manager,initialize,publish,result};auto& f=Facts(t,child);
+    if(!Room(f.prepared))throw std::runtime_error("PCTL prepared facts exhausted");
+    ++next_;pending_=t;validated_=0;++f.prepared;f.last_prepared_child_generation=t.child;return t;
+}
+bool ParentalControlContext::Validate(Ticket t,const std::shared_ptr<Child>& child) {
+    if(!Live() || !pending_ || pending_->ordinal!=t.ordinal || t.generation!=generation_ || t.ordinal<=consumed_ ||
+       pending_->child!=t.child || pending_->manager!=t.manager || pending_->index!=t.index)return false;
+    if(child && (child->state.generation!=t.child || child->state.retired ||
+        (t.publish?child->state.published:!child->state.published)))return false;
+    auto& f=Facts(t,child);if(!Room(f.validated))return false;validated_=t.ordinal;++f.validated;return true;
+}
+void ParentalControlContext::CommitAfterReplyWrite(Ticket t,const std::shared_ptr<Child>& child) {
+    Owner();auto& f=Facts(t,child);if(Room(f.commit_callbacks))++f.commit_callbacks;else uncertain_=true;
+    const bool child_live=!child || (child->state.generation==t.child && !child->state.retired &&
+        (t.publish?!child->state.published:child->state.published));
+    if(!Live() || !pending_ || pending_->ordinal!=t.ordinal || pending_->child!=t.child ||
+       pending_->manager!=t.manager || pending_->index!=t.index || t.generation!=generation_ ||
+       validated_!=t.ordinal || t.ordinal<=consumed_ || !child_live || !Room(f.committed)) {
+        uncertain_=true;live_=false;throw std::runtime_error("native PCTL post-write authority uncertainty; guest must stop");
+    }
+    if(child && t.publish)child->state.published=true;
+    if(child && t.initialize && !t.result)child->state.initialized=true;
+    consumed_=t.ordinal;pending_.reset();validated_=0;++f.committed;f.last_service_result=t.result;f.last_committed_child_generation=t.child;
+}
+Reply ParentalControlContext::Bind(Reply reply,bool manager,unsigned index,const std::shared_ptr<Child>& child,bool initialize,bool publish) {
+    const auto t=Prepare(manager,index,child,initialize,publish,reply.service_result);
+    auto self=shared_from_this();
+    reply.validate=[self,child,t]{return self->Validate(t,child);};
+    reply.commit=[self,child,t]{self->CommitAfterReplyWrite(t,child);};return reply;
+}
+class ParentalControlChildEndpoint final:public Endpoint {
+    std::shared_ptr<ParentalControlContext> context_;
+    std::shared_ptr<ParentalControlContext::Child> child_;
+public:
+    ParentalControlChildEndpoint(std::shared_ptr<ParentalControlContext> context,std::shared_ptr<ParentalControlContext::Child> child)
+        :context_(std::move(context)),child_(std::move(child)){}
+    ~ParentalControlChildEndpoint() override{context_->RetireChild(child_);}
+    Reply Prepare(const Request& r) override {
+        if(r.process_id!=context_->process_)return Decline(Status::InvalidProcess,"PCTL child owned process mismatch");
+        if(!context_->Live() || child_->state.retired || !child_->state.published)return Decline(Status::InvalidState,"PCTL child authority unpublished or retired");
+        unsigned index;
+        switch(r.command){case 1:index=0;break;case 1031:index=1;break;case 1062:index=2;break;case 1065:index=3;break;case 1432:index=4;break;
+        default:return Decline(Status::Unsupported,"PCTL child command has no owned native implementation: "+std::to_string(r.command));}
+        if(!Shape(r,false))return Decline(Status::Malformed,"PCTL child exact no-input shape required");
+        if(r.command!=1 && !child_->state.initialized)return Decline(Status::InvalidState,"PCTL child requires Initialize");
+        Reply reply;reply.status=Status::Ok;reply.service_result=ParentalCapabilityResult(context_->capabilities_,r.command);
+        if(r.command==1031)reply.payload={std::byte(reply.service_result?0:context_->pin_configured_)};
+        else if(r.command==1062)reply.payload={std::byte(reply.service_result?0:context_->stereo_restriction_)};
+        else if(r.command==1065){
+            if(context_->pin_configured_)return Decline(Status::Unsupported,"PCTL configured PIN permission policy is not implemented");
+            reply.payload={std::byte{1}}; // Primary helper's genuine no-PIN branch.
+        }else if(r.command==1432)reply.copied_event=child_->event;
+        return context_->Bind(std::move(reply),false,index,child_,r.command==1);
+    }
+};
+class ParentalControlManagerEndpoint final:public Endpoint {
+    std::shared_ptr<ParentalControlContext> context_;
+public:
+    explicit ParentalControlManagerEndpoint(std::shared_ptr<ParentalControlContext> context):context_(std::move(context)){}
+    Reply Prepare(const Request& r) override {
+        if(r.process_id!=context_->process_)return Decline(Status::InvalidProcess,"PCTL manager owned process mismatch");
+        if(!context_->Live())return Decline(Status::InvalidState,"PCTL manager context retired or owner invalid");
+        if(r.command!=0 && r.command!=1)return Decline(Status::Unsupported,"PCTL manager command is not implemented: "+std::to_string(r.command));
+        if(!Shape(r,true))return Decline(Status::Malformed,"PCTL manager PID descriptor/exact semantic body required");
+        // The raw ClientProcessId slot and arbitrary normal transport tail are
+        // ignored; authenticated Request.process_id and admitted ProgramID own state.
+        Reply reply;reply.status=Status::Ok;
+        if(r.command==0)reply.service_result=ParentalCapabilityResult(context_->capabilities_,1);
+        if(reply.service_result)return context_->Bind(std::move(reply),true,unsigned(r.command),{});
+        auto child=context_->NewChild(r.command,r.command==0);
+        reply.moved_endpoint=std::make_unique<ParentalControlChildEndpoint>(context_,child);
+        return context_->Bind(std::move(reply),true,unsigned(r.command),child,false,true);
+    }
+};
+std::unique_ptr<Endpoint> CreateParentalControlManager(std::shared_ptr<ParentalControlContext> context) {
+    if(!context || !context->Live())throw std::invalid_argument("PCTL requires live owned unconfigured policy");
+    context->Owner();if(!Room(context->manager_constructions_))throw std::runtime_error("PCTL manager constructions exhausted");
+    auto manager=std::make_unique<ParentalControlManagerEndpoint>(context);++context->manager_constructions_;return manager;
+}
