+// SPDX-License-Identifier: GPL-3.0-or-later
+// Pipeline recipes (runtime/src/nvn/nvn_pipeline_recipes.h): the encoding and file on the CPU, then prewarm,
+// adoption, rejection of changed stages, claiming, persistence and identical rendering on the GPU. Authored shaders
+// only (native_point_test_shaders.h).
+#pragma once
+#include "nvn/nvn_draw_state.h"
+#include "nvn/nvn_pipeline_recipes.h"
+#include "nvn/native_recipe_save_snapshot.h"
+#include "native_point_test_shaders.h"
