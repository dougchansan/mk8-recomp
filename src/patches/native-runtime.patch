+++ b/native-runtime/services/application.cpp
@@ -0,0 +1,269 @@
+// SPDX-FileCopyrightText: Copyright 2026 suyu Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Contract source: service/am/service/application_proxy_service.cpp,
+// application_proxy.cpp and window_controller.cpp. No Core/HLE objects linked.
+#include "application.h"
+#include <stdexcept>
+
+namespace native_services {
+ApplicationContext::ApplicationContext(uint64_t pid,uint64_t aruid,native::EventRef event)
+    :process_id_(pid),resource_id_(aruid),system_event_(std::move(event)) {
+    // Primary appletOE lookup identifies the application by the owning process's
+    // applet-resource user ID. Native boot creates exactly that application.
+    if (!pid || aruid!=pid)throw std::invalid_argument("native application identity must belong to its process");
+    if (system_event_ && (system_event_->OwnerProcessId()!=pid || system_event_->IsSignaled()))
+        throw std::invalid_argument("application requires an owned initially unsignaled lifecycle event");
+}
+native::EventRef ApplicationContext::SystemEvent() const {
+    std::lock_guard lock(mutex_);return system_event_;
+}
+std::optional<ApplicationMessageTicket> ApplicationContext::SelectMessageLocked() const {
+    if(close_pending_)return close_pending_;
+    if(focus_notifications_enabled_ && focus_pending_)return focus_pending_;
+    if(!messages_.empty())return messages_.front();
+    return std::nullopt;
+}
+void ApplicationContext::UpdateSystemEventLocked() {
+    if(!system_event_)return;
+    // Primary LifecycleManager caches availability. A guest Reset clears the
+    // manual-reset event independently; a nonempty queue is not a level trigger.
+    const bool available=bool(SelectMessageLocked());
+    if(available!=message_available_) {
+        if(available)system_event_->Signal();else system_event_->Clear();
+        message_available_=available;
+    }
+}
+bool ApplicationContext::ConsumeMessageLocked(ApplicationMessageTicket ticket) {
+    const auto selected=SelectMessageLocked();
+    if(!selected || *selected!=ticket)return false;
+    if(close_pending_ && *close_pending_==ticket)close_pending_.reset();
+    else if(focus_pending_ && *focus_pending_==ticket)focus_pending_.reset();
+    else messages_.pop_front();
+    UpdateSystemEventLocked();return true;
+}
+bool ApplicationContext::PushMessage(uint32_t message) {
+    switch(message) {
+    case 1:case 2:case 4:case 6:case 15:case 16:
+    case 20:case 21:case 22:case 23:case 24:case 25:case 26:case 27:case 28:
+    case 29:case 30:case 31:case 32:case 33:case 50:case 51:case 55:case 56:
+    case 57:case 60:case 90:case 91:case 92:case 93:break;
+    default:return false;
+    }
+    std::lock_guard lock(mutex_);
+    // Reserve two slots for genuine coalesced focus and close notifications.
+    if(!system_event_ || messages_.size()>=254 || next_message_sequence_==UINT64_MAX ||
+       (lifecycle_bound_ && (message==15 || message==4)))return false;
+    messages_.push_back({next_message_sequence_++,message});UpdateSystemEventLocked();return true;
+}
+std::optional<ApplicationMessageTicket> ApplicationContext::PeekReceiveMessage() const {
+    std::lock_guard lock(mutex_);return SelectMessageLocked();
+}
+bool ApplicationContext::CommitReceiveMessage(ApplicationMessageTicket ticket) {
+    std::lock_guard lock(mutex_);return ConsumeMessageLocked(ticket);
+}
+std::optional<uint32_t> ApplicationContext::PeekMessage() const {
+    const auto ticket=PeekReceiveMessage();return ticket?std::optional<uint32_t>(ticket->message):std::nullopt;
+}
+bool ApplicationContext::PopMessage(uint32_t expected) {
+    std::lock_guard lock(mutex_);const auto ticket=SelectMessageLocked();
+    return ticket && ticket->message==expected && ConsumeMessageLocked(*ticket);
+}
+size_t ApplicationContext::PendingMessages() const {
+    std::lock_guard lock(mutex_);return messages_.size()+size_t(bool(focus_pending_))+size_t(bool(close_pending_));
+}
+bool ApplicationContext::BindLifecycleSource(uint64_t pid,uint64_t source) {
+    std::lock_guard lock(mutex_);
+    if(pid!=process_id_ || !source || source<=last_source_id_ || lifecycle_bound_ || lifecycle_retired_ || !system_event_)return false;
+    lifecycle_bound_=true;source_id_=last_source_id_=source;observation_sequence_=0;
+    focus_=ApplicationFocus::Unknown;focus_acknowledged_=ApplicationFocus::Unknown;
+    focus_acknowledged_sequence_=0;return true;
+}
+bool ApplicationContext::ApplyLifecycleObservation(const LifecycleObservation& o) {
+    std::lock_guard lock(mutex_);
+    if(!lifecycle_bound_ || o.process_id!=process_id_ || o.source_id!=source_id_ ||
+       !o.sequence || o.sequence<=observation_sequence_ ||
+       (o.focus!=ApplicationFocus::Unknown && o.focus!=ApplicationFocus::InFocus && o.focus!=ApplicationFocus::NotInFocus))return false;
+    const bool changed=o.focus!=ApplicationFocus::Unknown && o.focus!=focus_;
+    const bool closing=o.close_requested && !close_requested_;
+    const unsigned needed=unsigned(changed && !focus_pending_)+unsigned(closing && !close_pending_);
+    if(next_message_sequence_>UINT64_MAX-needed)return false;
+    observation_sequence_=o.sequence;
+    if(o.focus!=ApplicationFocus::Unknown)focus_=o.focus;
+    if(changed && !focus_pending_)focus_pending_=ApplicationMessageTicket{next_message_sequence_++,15};
+    if(closing){close_requested_=true;close_pending_=ApplicationMessageTicket{next_message_sequence_++,4};}
+    UpdateSystemEventLocked();return true;
+}
+bool ApplicationContext::UnbindLifecycleSource(uint64_t source) {
+    std::lock_guard lock(mutex_);
+    if(!lifecycle_bound_ || source!=source_id_)return false;
+    lifecycle_bound_=false;lifecycle_retired_=true;focus_=ApplicationFocus::Unknown;
+    UpdateSystemEventLocked();return true;
+}
+ApplicationFocusSnapshot ApplicationContext::FocusSnapshot() const {
+    std::lock_guard lock(mutex_);return {focus_,source_id_,observation_sequence_};
+}
+bool ApplicationContext::AcknowledgeFocus(const ApplicationFocusSnapshot& snapshot) {
+    std::lock_guard lock(mutex_);
+    if(!lifecycle_bound_ || snapshot.source_id!=source_id_ || !snapshot.observation_sequence ||
+       snapshot.observation_sequence>observation_sequence_ || snapshot.observation_sequence<focus_acknowledged_sequence_ ||
+       (snapshot.focus!=ApplicationFocus::InFocus && snapshot.focus!=ApplicationFocus::NotInFocus))return false;
+    focus_acknowledged_=snapshot.focus;focus_acknowledged_sequence_=snapshot.observation_sequence;return true;
+}
+void ApplicationContext::SetFocusNotificationsEnabled(bool enabled) {
+    std::lock_guard lock(mutex_);focus_notifications_enabled_=enabled;UpdateSystemEventLocked();
+}
+namespace {
+Reply Reject(Status status,std::string text) { return {status,0,{},std::move(text),{},nullptr}; }
+Reply Child(std::unique_ptr<Endpoint> endpoint) {
+    Reply reply;reply.status=Status::Ok;reply.moved_endpoint=std::move(endpoint);return reply;
+}
+Reply Identity(uint64_t id) {
+    Reply reply;reply.status=Status::Ok;reply.payload.resize(8);
+    for(unsigned i=0;i<8;++i)reply.payload[i]=std::byte(id>>(8*i));
+    return reply;
+}
+bool Owner(const Request& r,const ApplicationContext& app) { return r.process_id==app.ProcessId(); }
+class ApplicationFunctions final:public Endpoint {
+    std::shared_ptr<ApplicationContext> app_;
+public:
+    explicit ApplicationFunctions(std::shared_ptr<ApplicationContext> app):app_(std::move(app)){}
+    Reply Prepare(const Request& r) override {
+        if(!Owner(r,*app_))return Reject(Status::InvalidProcess,"application functions are owned by another process");
+        // Creation is the observed command-20 contract. Individual operations
+        // require their real lifecycle, content metadata or resource provider;
+        // do not copy HLE stub values while those contracts are still absent.
+        return Reject(Status::Unsupported,"IApplicationFunctions command requires a native implementation: "+std::to_string(r.command));
+    }
+};
+class LibraryAppletCreator final:public Endpoint {
+    std::shared_ptr<ApplicationContext> app_;
+public:
+    explicit LibraryAppletCreator(std::shared_ptr<ApplicationContext> app):app_(std::move(app)){}
+    Reply Prepare(const Request& r) override {
+        if(!Owner(r,*app_))return Reject(Status::InvalidProcess,"library applet creator is owned by another process");
+        // Proxy command 11 only creates this owned interface. Actual applet UI,
+        // storage and transfer-memory operations need their observed contract
+        // and a real resource implementation before they can succeed.
+        return Reject(Status::Unsupported,"ILibraryAppletCreator command requires native applet/storage resources: "+std::to_string(r.command));
+    }
+};
+class CommonStateGetter final:public Endpoint {
+    std::shared_ptr<ApplicationContext> app_;
+public:
+    explicit CommonStateGetter(std::shared_ptr<ApplicationContext> app):app_(std::move(app)){}
+    Reply Prepare(const Request& r) override {
+        if(!Owner(r,*app_))return Reject(Status::InvalidProcess,"common state getter is owned by another process");
+        if(r.command==0) {
+            if(!r.read_buffers.empty())return Reject(Status::Unsupported,"GetEventHandle has unexpected buffers");
+            auto event=app_->SystemEvent();
+            if(!event)return Reject(Status::Unsupported,"CommonStateGetter lifecycle event backend is not installed");
+            Reply reply;reply.status=Status::Ok;reply.copied_event=std::move(event);return reply;
+        }
+        if(r.command==1) {
+            if(!r.read_buffers.empty())return Reject(Status::Malformed,"ReceiveMessage has unexpected buffers");
+            const auto ticket=app_->PeekReceiveMessage();
+            Reply reply;reply.status=Status::Ok;reply.payload.resize(4);
+            if(!ticket){reply.service_result=0x680;return reply;}
+            for(unsigned i=0;i<4;++i)reply.payload[i]=std::byte(ticket->message>>(8*i));
+            reply.commit=[app=app_,ticket=*ticket]{if(!app->CommitReceiveMessage(ticket))throw std::runtime_error("lifecycle message transaction changed before commit");};
+            return reply;
+        }
+        if(r.command==9) {
+            if(!r.read_buffers.empty())return Reject(Status::Malformed,"GetCurrentFocusState has unexpected buffers");
+            const auto snapshot=app_->FocusSnapshot();
+            if(snapshot.focus==ApplicationFocus::Unknown)return Reject(Status::Unsupported,"native application focus has not been observed");
+            Reply reply;reply.status=Status::Ok;reply.payload={std::byte(snapshot.focus)};
+            reply.commit=[app=app_,snapshot]{if(!app->AcknowledgeFocus(snapshot))throw std::runtime_error("lifecycle focus transaction changed before commit");};
+            return reply;
+        }
+        // No event handle, focus state or message is synthesized. Each operation
+        // requires its actual owned backend/state contract when first observed.
+        return Reject(Status::Unsupported,"ICommonStateGetter command requires native lifecycle/event state: "+std::to_string(r.command));
+    }
+};
+class SelfController final:public Endpoint {
+    std::shared_ptr<ApplicationContext> app_;
+public:
+    explicit SelfController(std::shared_ptr<ApplicationContext> app):app_(std::move(app)){}
+    Reply Prepare(const Request& r) override {
+        if(!Owner(r,*app_))return Reject(Status::InvalidProcess,"self controller is owned by another process");
+        return Reject(Status::Unsupported,"ISelfController command requires native lifecycle/display resources: "+std::to_string(r.command));
+    }
+};
+class AudioController final:public Endpoint {
+    std::shared_ptr<ApplicationContext> app_;
+public:
+    explicit AudioController(std::shared_ptr<ApplicationContext> app):app_(std::move(app)){}
+    Reply Prepare(const Request& r) override {
+        if(!Owner(r,*app_))return Reject(Status::InvalidProcess,"audio controller is owned by another process");
+        return Reject(Status::Unsupported,"IAudioController command requires native audio policy/resources: "+std::to_string(r.command));
+    }
+};
+class DisplayController final:public Endpoint {
+    std::shared_ptr<ApplicationContext> app_;
+public:
+    explicit DisplayController(std::shared_ptr<ApplicationContext> app):app_(std::move(app)){}
+    Reply Prepare(const Request& r) override {
+        if(!Owner(r,*app_))return Reject(Status::InvalidProcess,"display controller is owned by another process");
+        return Reject(Status::Unsupported,"IDisplayController command requires native display/capture resources: "+std::to_string(r.command));
+    }
+};
+class DebugFunctions final:public Endpoint {
+    std::shared_ptr<ApplicationContext> app_;
+public:
+    explicit DebugFunctions(std::shared_ptr<ApplicationContext> app):app_(std::move(app)){}
+    Reply Prepare(const Request& r) override {
+        if(!Owner(r,*app_))return Reject(Status::InvalidProcess,"debug functions are owned by another process");
+        // The primary interface exposes no implemented operations. Creating an
+        // identity does not grant debug privileges or synthesize debug results.
+        return Reject(Status::Unsupported,"IDebugFunctions command is not implemented: "+std::to_string(r.command));
+    }
+};
+class WindowController final:public Endpoint {
+    std::shared_ptr<ApplicationContext> app_;
+public:
+    explicit WindowController(std::shared_ptr<ApplicationContext> app):app_(std::move(app)){}
+    Reply Prepare(const Request& r) override {
+        if(!Owner(r,*app_))return Reject(Status::InvalidProcess,"window controller is owned by another application");
+        if(!r.read_buffers.empty())return Reject(Status::Unsupported,"window controller buffer descriptors are not implemented");
+        if(r.command==1)return Identity(app_->AppletResourceUserId());
+        return Reject(Status::Unsupported,"IWindowController command requires unimplemented owned window resources: "+std::to_string(r.command));
+    }
+};
+class ApplicationProxy final:public Endpoint {
+    std::shared_ptr<ApplicationContext> app_;
+public:
+    explicit ApplicationProxy(std::shared_ptr<ApplicationContext> app):app_(std::move(app)){}
+    Reply Prepare(const Request& r) override {
+        if(!Owner(r,*app_))return Reject(Status::InvalidProcess,"application proxy is owned by another process");
+        if(!r.read_buffers.empty())return Reject(Status::Unsupported,"application proxy buffer descriptors are not implemented");
+        if(r.command==2)return Child(std::make_unique<WindowController>(app_));
+        if(r.command==20)return Child(std::make_unique<ApplicationFunctions>(app_));
+        if(r.command==11)return Child(std::make_unique<LibraryAppletCreator>(app_));
+        if(r.command==0)return Child(std::make_unique<CommonStateGetter>(app_));
+        if(r.command==1)return Child(std::make_unique<SelfController>(app_));
+        if(r.command==3)return Child(std::make_unique<AudioController>(app_));
+        if(r.command==4)return Child(std::make_unique<DisplayController>(app_));
+        if(r.command==1000)return Child(std::make_unique<DebugFunctions>(app_));
+        return Reject(Status::Unsupported,"IApplicationProxy interface is not implemented: "+std::to_string(r.command));
+    }
+};
+class ApplicationProxyService final:public Endpoint {
+    std::shared_ptr<ApplicationContext> app_;
+public:
+    explicit ApplicationProxyService(std::shared_ptr<ApplicationContext> app):app_(std::move(app)){}
+    bool AcceptsProcessHandles() const override { return true; }
+    Reply Prepare(const Request& r) override {
+        if(!Owner(r,*app_))return Reject(Status::InvalidProcess,"appletOE is owned by another process");
+        if(r.command!=0)return Reject(Status::Unsupported,"appletOE command is not implemented: "+std::to_string(r.command));
+        if(!r.send_pid || r.copied_process_handles.size()!=1 || !r.read_buffers.empty())
+            return Reject(Status::Malformed,"OpenApplicationProxy requires PID descriptor and one validated process copy handle");
+        return Child(std::make_unique<ApplicationProxy>(app_));
+    }
+};
+} // namespace
+std::unique_ptr<Endpoint> CreateApplicationProxyService(std::shared_ptr<ApplicationContext> context) {
+    if(!context)throw std::invalid_argument("appletOE requires an actual process-owned application context");
+    return std::make_unique<ApplicationProxyService>(std::move(context));
+}
+} // namespace native_services
