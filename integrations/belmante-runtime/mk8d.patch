+#include "event.h"
+#include <array>
+#include <chrono>
+#include <mutex>
+namespace native {
+namespace {
+std::mutex synchronization;
+class SteadyClock final : public EventClock {
+  const std::chrono::steady_clock::time_point origin_ =
+      std::chrono::steady_clock::now();
+
+public:
+  uint64_t NowNs() const noexcept override {
+    const auto elapsed = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                             std::chrono::steady_clock::now() - origin_)
+                             .count();
+    return elapsed > 0 ? uint64_t(elapsed) : 0;
+  }
+};
+std::shared_ptr<const EventClock> DefaultClock() {
+  static const auto clock = std::make_shared<SteadyClock>();
+  return clock;
+}
+} // namespace
+namespace detail {
+struct EventWaitNode {
+  EventWaitState *state{};
+  NativeEvent *event{};
+  EventWaitNode *previous{}, *next{};
+  bool linked = false;
+};
+struct EventWaitState {
+  std::array<EventRef, 64> events;
+  std::array<EventWaitNode, 64> nodes;
+  size_t count = 0;
+  std::shared_ptr<const EventClock> clock;
+  uint64_t deadline = 0;
+  bool finite = false;
+  EventWaitOutcome outcome{EventWaitStatus::Pending, -1};
+  void Unlink() noexcept {
+    for (size_t i = 0; i < count; ++i) {
+      auto &node = nodes[i];
+      if (!node.linked)
+        continue;
+      if (node.previous)
+        node.previous->next = node.next;
+      else
+        node.event->waiters_ = node.next;
+      if (node.next)
+        node.next->previous = node.previous;
+      node.linked = false;
+      node.previous = node.next = nullptr;
+    }
+  }
+  bool Complete(EventWaitStatus status, int32_t index) noexcept {
+    if (outcome.status != EventWaitStatus::Pending)
+      return false;
+    outcome = {status, index};
+    Unlink();
+    return true;
+  }
+  bool Expire() noexcept {
+    return outcome.status == EventWaitStatus::Pending && finite &&
+           clock->NowNs() >= deadline &&
+           Complete(EventWaitStatus::TimedOut, -1);
+  }
+  void Notify(NativeEvent *event) noexcept {
+    if (Expire())
+      return;
+    for (size_t i = 0; i < count; ++i)
+      if (events[i].get() == event) {
+        Complete(EventWaitStatus::Signaled, int32_t(i));
+        return;
+      }
+  }
+  void Arm(int64_t timeout, bool cancelled) noexcept {
+    for (size_t i = 0; i < count; ++i)
+      if (events[i]->signaled_) {
+        outcome = {EventWaitStatus::Signaled, int32_t(i)};
+        return;
+      }
+    if (!timeout) {
+      outcome = {EventWaitStatus::TimedOut, 0};
+      return;
+    }
+    if (cancelled) {
+      outcome = {EventWaitStatus::Cancelled, 0};
+      return;
+    }
+    finite = timeout > 0;
+    if (finite) {
+      auto now = clock->NowNs();
+      auto ns = uint64_t(timeout);
+      deadline = now > UINT64_MAX - ns - 2 ? UINT64_MAX : now + ns + 2;
+    }
+    for (size_t i = 0; i < count; ++i) {
+      auto &node = nodes[i];
+      node.state = this;
+      node.event = events[i].get();
+      node.next = node.event->waiters_;
+      if (node.next)
+        node.next->previous = &node;
+      node.event->waiters_ = &node;
+      node.linked = true;
+    }
+  }
+};
+} // namespace detail
+NativeEvent::NativeEvent(uint64_t pid) : owner_(pid) {
+  if (!pid)
+    throw std::invalid_argument("event process ownership unavailable");
+}
+bool NativeEvent::IsSignaled() const noexcept {
+  std::lock_guard lock(synchronization);
+  return signaled_;
+}
+void NativeEvent::Signal() noexcept {
+  std::lock_guard lock(synchronization);
+  signaled_ = true;
+  while (waiters_)
+    waiters_->state->Notify(this);
+}
+void NativeEvent::Clear() noexcept {
