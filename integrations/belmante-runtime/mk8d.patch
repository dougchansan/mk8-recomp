+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "nvn/nvn_draw_state.h"
+#include "platform.h"
+#include <array>
+#include <cstdio>
+#include <vector>
+
+template<class Check> void native_bc3_snapshot_probe(uint64_t texture, Check check) {
+    using namespace nx;
+    using namespace nx::nvn;
+    std::lock_guard lock(gpu_lock());
+    auto* image = image_of(texture);
+    check(image && image->format == VK_FORMAT_BC3_UNORM_BLOCK);
+    const auto command = frame_begin(false);
+    for (uint32_t level = 0; level < 2; ++level)
+        for (uint32_t face = 0; face < 6; ++face) {
+            g_snap_level = level;
+            g_snap_layer = face;
+            debug_snapshot(command, *image, 0xcfff0030 + level * 16 + face);
+        }
+    g_snap_level = g_snap_layer = 0;
+    frame_submit(VK_NULL_HANDLE, VK_NULL_HANDLE, {}, true);
+    debug_snapshots_write();
+    constexpr uint32_t colours[] = {0xff0000ff, 0xff00ff00, 0xffff0000,
+                                    0xffffffff, 0xff00ffff, 0xffffff00};
+    for (uint32_t level = 0; level < 2; ++level)
+        for (uint32_t face = 0; face < 6; ++face) {
+            char suffix[64];
+            std::snprintf(suffix, sizeof suffix, "/frames/00000_%08x.raw", 0xcfff0030 + level * 16 + face);
+            FILE* file = plat::fopen_utf8(plat::data_root() + suffix, "rb");
+            check(file != nullptr);
+            std::array<uint32_t, 3> header{};
+            check(std::fread(header.data(), 4, 3, file) == 3);
+            const uint32_t extent = 8 >> level;
+            check(header[0] == extent && header[1] == extent && header[2] == VK_FORMAT_R8G8B8A8_UNORM);
+            std::vector<uint32_t> payload(extent * extent);
+            check(std::fread(payload.data(), 4, payload.size(), file) == payload.size());
+            check(std::fgetc(file) == EOF);
+            check(std::fclose(file) == 0);
+            bool exact = true;
+            for (auto pixel : payload) exact &= pixel == colours[(face + level) % 6];
+            check(exact); // Native BC3 conversion preserves the selected face, mip and alpha.
+        }
+}
