+      }
+  }
+  void DestroyImages() {
+    for (auto &i : images) {
+      if (i.present)
+        P(vkDestroyFence)(device, i.present, nullptr);
+      if (i.finished)
+        P(vkDestroySemaphore)(device, i.finished, nullptr);
+      if (i.view)
+        P(vkDestroyImageView)(device, i.view, nullptr);
+    }
