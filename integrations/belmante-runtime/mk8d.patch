+    VkBuffer buffer = VK_NULL_HANDLE;
+    VkDeviceMemory buffer_memory = VK_NULL_HANDLE;
+    std::map<std::tuple<VkImageViewType, uint32_t, uint32_t, uint32_t, uint32_t>, VkImageView> views;
