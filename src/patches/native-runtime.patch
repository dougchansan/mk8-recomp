+    space.map(0x3000, caller, 4096, 5, 3);
+    space.map(0x7000, {}, 4096, 3, 11);
+    space.map(0x9000, {}, 4096, 3, 4);
+    for (unsigned i = 0; i < 16; ++i)
+      space.write(0x9000 + i, 1, i + 1);
+    space.write(0x9100, 8, 0x12345678);
