+#pragma once
+#include <array>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+
+namespace native {
+enum class WindowFocus { Unknown, Active, Inactive };
+enum class WindowSource {
+  ForegroundPoll,
+  ActivateApp,
+  Activate,
+  Visibility,
+  Minimize,
+  Close,
+  SessionEnd,
+  ThreadQuit
+};
+// Values are copies; polling never exposes mutable queue storage. A Win32
+// message identifies its source, not whether another process synthesized that
+// message.
+struct WindowObservation {
+  uint64_t sequence{};
+  uint64_t process_id{}, source_id{};
+  uintptr_t owned_window{};
+  WindowSource source{};
+  uint32_t message{};
+  WindowFocus focus = WindowFocus::Unknown;
+  bool visible{}, minimized{}, close_requested{};
+};
+class Window final {
+public:
+  explicit Window(const wchar_t *title = L"Native application",
+                  size_t capacity = 128);
+  ~Window();
+  Window(const Window &) = delete;
+  Window &operator=(const Window &) = delete;
+  HWND handle() const;
+  HINSTANCE instance_handle() const;
+  std::array<uint32_t, 2> client_extent() const;
+  std::shared_ptr<const uint8_t> PinSurface();
+  uint64_t source_id() const;
+  uint64_t process_id() const;
+  size_t Pump(size_t limit = 64);
+  size_t WaitAndPump(std::chrono::milliseconds timeout);
+  std::optional<WindowObservation> Poll();
+  bool overflowed() const;
+  bool close_requested() const;
+  bool quit_requested() const;
+  WindowFocus focus() const;
+  void Destroy();
+
+private:
+  static LRESULT CALLBACK Procedure(HWND, UINT, WPARAM, LPARAM) noexcept;
+  void Owner() const;
+  void Observe(WindowSource, UINT, bool close = false) noexcept;
+  std::shared_ptr<const uint8_t> surface_pin_ =
+      std::make_shared<const uint8_t>(uint8_t{0});
+  DWORD owner_{};
+  HINSTANCE instance_{};
+  HWND hwnd_{};
+  std::wstring class_name_;
+  ATOM registration_{};
+  std::array<WindowObservation, 256> queue_{};
+  size_t capacity_{}, head_{}, count_{};
+  uint64_t sequence_{}, source_id_{};
+  std::optional<WindowObservation> close_record_, quit_record_;
+  bool quit_ = false;
+  WindowFocus focus_ = WindowFocus::Unknown;
+  bool accepting_ = true, overflow_ = false, closed_ = false;
+  bool observed_ = false, visible_ = false, minimized_ = false;
+};
+} // namespace native
