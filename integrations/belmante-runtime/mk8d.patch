+    if (!hid || !setup) return {};
+    using GetGuid = void(WINAPI*)(GUID*);
+    using GetDevs = HANDLE(WINAPI*)(const GUID*, PCWSTR, HWND, DWORD);
+    using EnumIf = BOOL(WINAPI*)(HANDLE, void*, const GUID*, DWORD, SP_DEVICE_INTERFACE_DATA*);
+    using IfDetail = BOOL(WINAPI*)(HANDLE, SP_DEVICE_INTERFACE_DATA*, SP_DEVICE_INTERFACE_DETAIL_DATA_W*, DWORD, DWORD*, void*);
+    using Destroy = BOOL(WINAPI*)(HANDLE);
+    auto get_guid = reinterpret_cast<GetGuid>(GetProcAddress(hid, "HidD_GetHidGuid"));
+    auto get_devs = reinterpret_cast<GetDevs>(GetProcAddress(setup, "SetupDiGetClassDevsW"));
+    auto enum_if = reinterpret_cast<EnumIf>(GetProcAddress(setup, "SetupDiEnumDeviceInterfaces"));
+    auto detail = reinterpret_cast<IfDetail>(GetProcAddress(setup, "SetupDiGetDeviceInterfaceDetailW"));
+    auto destroy = reinterpret_cast<Destroy>(GetProcAddress(setup, "SetupDiDestroyDeviceInfoList"));
+    if (!get_guid || !get_devs || !enum_if || !detail || !destroy) return {};
+    GUID guid{};
+    get_guid(&guid);
+    HANDLE devs = get_devs(&guid, nullptr, nullptr, DIGCF_PRESENT | DIGCF_DEVICEINTERFACE);
+    if (devs == INVALID_HANDLE_VALUE) return {};
+    std::wstring found;
+    for (DWORD i = 0; found.empty(); i++) {
+        SP_DEVICE_INTERFACE_DATA d{};
+        d.cbSize = sizeof d;
+        if (!enum_if(devs, nullptr, &guid, i, &d)) break;
+        DWORD need = 0;
+        detail(devs, &d, nullptr, 0, &need, nullptr);
+        if (!need) continue;
+        std::vector<uint8_t> buf(need);
+        auto* det = reinterpret_cast<SP_DEVICE_INTERFACE_DETAIL_DATA_W*>(buf.data());
+        det->cbSize = sizeof(SP_DEVICE_INTERFACE_DETAIL_DATA_W);
+        if (!detail(devs, &d, det, need, nullptr, nullptr)) continue;
