+             {packed_view, AttachmentLoad::Clear, AttachmentStore::Store, pd});
+      f.SubmitAndWait();
+      ++draws;
+    }
+    PackedPixels(images.ReadbackImage(packed), Quantize10(asDouble(pd)));
+    // Alpha2 quantization is checked exactly at four non-tie values.
+    for (float alpha : {.1f, .4f, .7f, .9f}) {
+      auto c = pc;
+      c[3] = alpha;
+      control(c);
+      packedDraw.blend_state->write_mask = 15;
+      FrameEncoder f(images);
+      f.Draw(program, packedDraw, {packed_view, AttachmentLoad::Clear});
+      f.SubmitAndWait();
+      ++draws;
+      PackedPixels(images.ReadbackImage(packed), Quantize10(asDouble(c)));
+    }
+    const std::array<unsigned, 4> baseline = {17, 513, 1001, 2};
+    std::vector<std::byte> base;
+    for (unsigned i = 0; i < 4096; ++i)
+      Append10(base, Pack10(baseline));
+    control(pc);
+    for (unsigned mask = 0; mask < 16; ++mask) {
+      images.UploadInitialContents(packed, base);
+      packedDraw.blend_state->write_mask = mask;
+      FrameEncoder f(images);
+      f.Draw(program, packedDraw, {packed_view, AttachmentLoad::Load});
+      f.SubmitAndWait();
+      ++draws;
+      auto packed_expected = baseline, source = Quantize10(asDouble(pc));
+      for (unsigned k = 0; k < 4; ++k)
+        if (mask >> k & 1)
+          packed_expected[k] = source[k];
+      PackedPixels(images.ReadbackImage(packed), packed_expected, mask);
+    }
+    const std::array<float, 4> blend_source = {.8f, .3f, .5f, .4f};
+    for (bool multiply : {false, true}) {
+      images.UploadInitialContents(packed, base);
+      control(blend_source);
+      packedDraw.blend_state = captured;
+      if (multiply) {
+        packedDraw.blend_state->source_rgb =
+            packedDraw.blend_state->source_alpha = BlendFactor::Zero;
+        packedDraw.blend_state->destination_rgb =
+            packedDraw.blend_state->destination_alpha =
+                BlendFactor::SourceColor;
+      }
+      FrameEncoder f(images);
+      f.Draw(program, packedDraw, {packed_view, AttachmentLoad::Load});
+      f.SubmitAndWait();
+      ++draws;
+      auto packed_expected = asDouble(blend_source);
+      for (unsigned k = 0; k < 4; ++k) {
+        double destination = double(baseline[k]) / (k == 3 ? 3 : 1023);
+        packed_expected[k] = multiply ? destination * blend_source[k]
+                                      : blend_source[k] * blend_source[3] +
+                                            destination * (1 - blend_source[3]);
+      }
+      PackedPixels(images.ReadbackImage(packed), Quantize10(packed_expected));
+    }
+    // Producer and consumer are both packed targets. No image readback/upload
+    // occurs between them, and non-8-bit-representable RGB must survive
+    // exactly.
+    auto second_desc = packed_desc;
+    second_desc.backing.identity = 901;
+    auto second = images.CreateImage(second_desc);
+    auto second_view = images.CreateView(second, packed_view_desc);
+    SamplerDescription ps;
+    ps.state = SamplerState{};
+    auto packed_sampler = images.CreateSampler(ps);
+    SampleBinding pb{1, packed_view, packed_sampler};
+    const auto before_chain = images.Counters();
+    control(pc);
+    packedDraw.blend_state = BlendState{};
+    {
+      FrameEncoder f(images);
+      f.Draw(program, packedDraw, {packed_view, AttachmentLoad::Clear});
+      control({.5f, .5f, 0, 0});
+      f.Draw(sampleprogram, draw, {second_view, AttachmentLoad::Clear},
+             std::span(&pb, 1));
+      f.SubmitAndWait();
+      draws += 2;
+    }
+    const auto producer_consumer = images.ReadbackImage(second);
+    const uint32_t expected_word = Pack10(Quantize10(asDouble(pc)));
+    for (size_t i = 0; i < producer_consumer.bytes.size(); i += 4)
+      Check(Word10(producer_consumer.bytes, i) == expected_word,
+            "Native packed producer/sample lost precision");
+    pixels += 4096;
+    Check(images.Counters().readbacks == before_chain.readbacks + 1,
+          "Packed chain used intermediate readback");
+    std::vector<std::byte> packed_texels;
+    Append10(packed_texels, Pack10({77, 511, 839, 1}));
+    Append10(packed_texels, Pack10({1023, 0, 128, 3}));
+    SamplerState packed_state;
+    sampled(ImageFormat::A2B10G10R10Unorm, 2, packed_texels, {}, packed_state,
+            {.25f, .5f}, {77 / 1023., 511 / 1023., 839 / 1023., 1 / 3.});
+    packed_state.min = packed_state.mag = TextureFilter::Linear;
+    sampled(ImageFormat::A2B10G10R10Unorm, 2, packed_texels, {}, packed_state,
+            {.5f, .5f},
+            {(77 + 1023) / 2046., 511 / 2046., (839 + 128) / 2046., 2 / 3.});
+    images.DestroyView(second_view);
+    images.DestroyImage(second);
+    images.DestroySampler(packed_sampler);
+    images.DestroyView(packed_view);
+    images.DestroyImage(packed);
+    std::cout << "{\"passed\":true,\"draws\":" << draws
+              << ",\"pixels\":" << pixels << ",\"rejected\":" << rejected
+              << ",\"wide5120\":" << (wide ? "true" : "false")
+              << ",\"negative_viewport\":"
+              << (caps.negative_viewport_height ? "true" : "false")
+              << ",\"api_version\":" << caps.api_version
+              << ",\"max_image_dimension\":" << caps.max_image_dimension_2d
+              << ",\"packed10\":true,\"actual_game\":false}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
diff --git a/native-runtime/pending_owner_v3.cpp b/native-runtime/pending_owner_v3.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/pending_owner_v3.cpp
@@ -0,0 +1,407 @@
+#include "pending_owner_v3.h"
+#include <limits>
+namespace native {
+namespace {
+std::atomic<uint64_t> next_generation{1}, next_operation{1};
+uint64_t Next(std::atomic<uint64_t> &counter) {
+  auto value = counter.load(std::memory_order_relaxed);
+  while (value != UINT64_MAX) {
+    if (counter.compare_exchange_weak(value, value + 1,
+                                      std::memory_order_relaxed))
+      return value;
+  }
+  throw std::runtime_error("native pending identity exhausted");
+}
+} // namespace
+PendingOwnerV3 *PendingOwnerV3::bound_ = nullptr;
+PendingOwnerV3::PendingOwnerV3(Host &host, std::shared_ptr<PendingWorkV3> work)
+    : host_(host), space_(host.address_space), work_(std::move(work)),
+      owner_(std::this_thread::get_id()),
+      context_generation_(Next(next_generation)) {
+  if (!work_)
+    throw std::invalid_argument("pending operation provider unavailable");
+  binding_ = {3,
+              sizeof(binding_),
+              sizeof(GuestContext),
+              RECOMP_HALT_NATIVE_PENDING_V3,
+              RECOMP_NATIVE_PENDING_LAYOUT_V3,
+              RECOMP_NATIVE_PENDING_CAPS_V3,
+              this,
+              identify,
+              validate,
+              admit,
+              job_poll,
+              commit,
+              cancel};
+}
+PendingOwnerV3::~PendingOwnerV3() {
+  if (!on_owner())
+    std::terminate();
+  request_cancel();
+  if (bound_ == this) {
+    auto r = record();
+    if (on_owner() && r && recognizes(uint32_t(host_.context.halted)))
+      recomp_native_pending_cancel_v3(&host_.context, &r->request, r->token,
+                                      live_thread(), context_generation_,
+                                      token());
+    recomp_native_pending_bind_v3(nullptr);
+    bound_ = nullptr;
+  }
+  auto r = record();
+  bool notify = false;
+  if (r) {
+    std::lock_guard lock(r->publication_mutex);
+    if (r->cancel_requested.load(std::memory_order_acquire) &&
+        !r->cancel_notified) {
+      r->cancel_notified = true;
+      notify = true;
+    }
+  }
+  if (notify)
+    r->work->cancel(r->token);
+}
+bool PendingOwnerV3::on_owner() const noexcept {
+  return std::this_thread::get_id() == owner_;
+}
+uint64_t PendingOwnerV3::live_thread() const noexcept {
+  auto thread = host_.find_thread(host_.current_thread_handle);
+  return thread && thread->context == &host_.context ? thread->id : 0;
+}
+std::shared_ptr<PendingOwnerV3::Record> PendingOwnerV3::record() const {
+  std::lock_guard lock(mutex_);
+  return record_;
+}
+bool PendingOwnerV3::bind() {
+  if (!on_owner() || host_.dispatch_active() ||
+      validation_epoch_ == UINT64_MAX || (bound_ && bound_ != this))
+    return false;
+  if (!recomp_native_pending_bind_v3(&binding_))
+    return false;
+  ++validation_epoch_;
+  bound_ = this;
+  return true;
+}
+bool PendingOwnerV3::recognizes(uint32_t halt) const noexcept {
+  return halt == RECOMP_HALT_NATIVE_PENDING_V3;
+}
+uint64_t PendingOwnerV3::token() const {
+  auto r = record();
+  return r ? r->token : 0;
+}
+int PendingOwnerV3::identify(void *u, const GuestContext *c, uint64_t *thread,
+                             uint64_t *generation, uint64_t *epoch) noexcept {
+  auto &self = *static_cast<PendingOwnerV3 *>(u);
+  if (!self.on_owner() || c != &self.host_.context || !self.live_thread())
+    return 0;
+  *thread = self.live_thread();
+  *generation = self.context_generation_;
+  *epoch = self.validation_epoch_;
+  return 1;
+}
+int PendingOwnerV3::validate(void *u, const GuestContext *c,
+                             const RecompNativePendingRequestV3 *q,
+                             uint64_t token) noexcept {
+  try {
+    auto &self = *static_cast<PendingOwnerV3 *>(u);
+    if (!self.on_owner() || c != &self.host_.context || !q ||
+        q->thread_id != self.live_thread() ||
+        q->context_generation != self.context_generation_ ||
+        q->validation_epoch != self.validation_epoch_ ||
+        self.host_.address_space != self.space_ || !self.space_ ||
+        !self.space_->code_sealed() || !self.host_.code_binding_valid())
+      return 0;
+    auto r = self.record();
+    if (token &&
+        (!r || r->token != token || r->request.descriptor != q->descriptor ||
+         r->request.binding_epoch != q->binding_epoch))
+      return 0;
+    return self.work_->validate(self.host_, *q) ? 1 : 0;
+  } catch (...) {
+    return 0;
+  }
+}
+int PendingOwnerV3::admit(void *u, const GuestContext *c,
+                          const RecompNativePendingRequestV3 *q,
+                          RecompNativePendingReplyV3 *reply) noexcept {
+  try {
+    auto &self = *static_cast<PendingOwnerV3 *>(u);
+    if (!self.on_owner() || !self.host_.guest_active() || !q ||
+        c != &self.host_.context)
+      return 0;
+    auto old = self.record();
+    if (old && (old->state.load(std::memory_order_acquire) == State::Pending ||
+                old->state.load(std::memory_order_acquire) == State::Ready))
+      return 0;
+
+    auto r = std::make_shared<Record>();
+    r->request = *q;
+    r->late = self.late_completions_;
+    r->work_units = self.work_units_;
+    r->work = self.work_;
+    for (unsigned i = 0; i < 8; ++i)
+      r->input.arguments[i] = c->x[i];
+    if (!r->work->snapshot(self.host_, *c, *q, r->input) ||
+        r->input.bytes.size() > (64u << 10))
+      return 0;
+    r->token = Next(next_operation);
+    {
+      std::lock_guard lock(self.mutex_);
+      self.record_ = r;
+    }
+    *reply = {RECOMP_NATIVE_V3_PENDING, 0, r->token, 0, 0};
+    return 1;
+  } catch (...) {
+    return 0;
+  }
+}
+int PendingOwnerV3::job_poll(void *u, const RecompNativePendingRequestV3 *,
+                             uint64_t token,
+                             RecompNativePendingReplyV3 *reply) noexcept {
+  try {
+    auto &self = *static_cast<PendingOwnerV3 *>(u);
+    auto r = self.record();
+    if (!self.on_owner() || !r || r->token != token)
+      return 0;
+    bool notify_cancel = false;
+    {
+      std::lock_guard lock(r->publication_mutex);
+      auto state = r->state.load(std::memory_order_acquire);
+      if (r->cancel_requested.load(std::memory_order_acquire) &&
+          state != State::Cancelled) {
+        notify_cancel = !r->cancel_notified;
+        r->cancel_notified = true;
+        state = State::Cancelled;
+        r->state.store(state, std::memory_order_release);
+      }
+      uint32_t value = state == State::Pending     ? RECOMP_NATIVE_V3_PENDING
+                       : state == State::Ready     ? RECOMP_NATIVE_V3_READY
+                       : state == State::Cancelled ? RECOMP_NATIVE_V3_CANCELLED
+                                                   : RECOMP_NATIVE_V3_FAILED;
+      *reply = {value, 0, token, r->result.bits, r->result.work_units};
+    }
+    if (notify_cancel)
+      r->work->cancel(token);
+    return 1;
+  } catch (...) {
+    return 0;
+  }
+}
+int PendingOwnerV3::commit(void *u, GuestContext *c,
+                           const RecompNativePendingRequestV3 *q,
+                           uint64_t token, uint64_t result) noexcept {
+  auto &self = *static_cast<PendingOwnerV3 *>(u);
+  if (!self.on_owner() || self.host_.guest_active() ||
+      !validate(u, c, q, token))
+    return RECOMP_NATIVE_V3_COMMIT_FAILED;
+  auto r = self.record();
+  if (!r)
+    return RECOMP_NATIVE_V3_COMMIT_FAILED;
+  bool cancelled = false;
+  {
+    std::lock_guard lock(r->publication_mutex);
+    if (r->cancel_requested.load(std::memory_order_acquire)) {
+      cancelled = true;
+      r->cancel_notified = true;
+      r->state.store(State::Cancelled, std::memory_order_release);
+    } else {
+      if (r->state.load(std::memory_order_acquire) != State::Ready)
+        return RECOMP_NATIVE_V3_COMMIT_FAILED;
+      if (!validate(u, c, q, token)) {
+        r->state.store(State::Failed, std::memory_order_release);
+        return RECOMP_NATIVE_V3_COMMIT_FAILED;
+      }
+      // The claim linearizes cancellation. Accepted cancellation precedes this;
+      // cancellation after it is rejected before guest publication can race.
+      r->state.store(State::Committing, std::memory_order_release);
+    }
+  }
+  if (cancelled) {
+    r->work->cancel(token);
+    return RECOMP_NATIVE_V3_COMMIT_CANCELLED;
+  }
+  const bool done = r->work->commit(self.host_, *c, *q, result);
+  {
+    std::lock_guard lock(r->publication_mutex);
+    r->state.store(done ? State::Committed : State::Failed,
+                   std::memory_order_release);
+  }
+  return done ? RECOMP_NATIVE_V3_COMMIT_DONE : RECOMP_NATIVE_V3_COMMIT_FAILED;
+}
+void PendingOwnerV3::cancel(void *u, const RecompNativePendingRequestV3 *,
+                            uint64_t token) noexcept {
+  auto &self = *static_cast<PendingOwnerV3 *>(u);
+  auto r = self.record();
+  if (!self.on_owner() || !r || r->token != token)
+    return;
+  {
+    std::lock_guard lock(r->publication_mutex);
+    auto state = r->state.load(std::memory_order_acquire);
+    if (state == State::Committing || state == State::Committed)
+      return;
+    r->cancel_requested.store(true, std::memory_order_release);
+    r->cancel_notified = true;
+    r->state.store(State::Cancelled, std::memory_order_release);
+  }
+  r->work->cancel(token);
+}
+PendingOwnerV3::Completion PendingOwnerV3::completion() const {
+  return Completion(record());
+}
+uint64_t PendingOwnerV3::Completion::token() const noexcept {
+  return record_ ? record_->token : 0;
+}
+const PendingInputV3 &PendingOwnerV3::Completion::input() const {
+  if (!record_)
+    throw std::runtime_error("empty native completion");
+  return record_->input;
+}
+bool PendingOwnerV3::Completion::publish(PendingResultV3 result) const {
+  auto r = record_;
+  if (!r)
+    return false;
+  std::lock_guard lock(r->publication_mutex);
+  if (!r->completion_reported) {
+    r->completion_reported = true;
+    r->work_units->fetch_add(result.work_units, std::memory_order_relaxed);
+  }
+  if (r->state.load(std::memory_order_acquire) != State::Pending ||
+      r->cancel_requested.load(std::memory_order_acquire)) {
+    r->late->fetch_add(1, std::memory_order_relaxed);
+    return false;
+  }
+  r->result = result;
+  r->state.store(result.success ? State::Ready : State::Failed,
+                 std::memory_order_release);
+  return true;
+}
+bool PendingOwnerV3::complete(uint64_t token, PendingResultV3 result) {
+  auto ticket = completion();
+  if (ticket.token() != token) {
+    late_completions_->fetch_add(1, std::memory_order_relaxed);
+    return false;
+  }
+  return ticket.publish(result);
+}
+bool PendingOwnerV3::run_ready_work() {
+  if (!on_owner() || host_.dispatch_active() || work_active_)
+    return false;
+  auto r = record();
+  if (!r || r->state.load(std::memory_order_acquire) != State::Pending ||
+      r->cancel_requested.load(std::memory_order_acquire))
+    return false;
+  work_active_ = true;
+  auto result = r->work->run(r->input);
+  work_active_ = false;
+  return complete(r->token, result);
+}
+bool PendingOwnerV3::request_cancel() {
+  auto r = record();
+  if (!r)
+    return false;
+  std::lock_guard lock(r->publication_mutex);
+  auto state = r->state.load(std::memory_order_acquire);
+  if (state != State::Pending && state != State::Ready)
+    return false;
+  r->cancel_requested.store(true, std::memory_order_release);
+  return true;
+}
+void PendingOwnerV3::revoke_admission() {
+  if (!on_owner() || host_.dispatch_active() || poll_active_ ||
+      validation_epoch_ == UINT64_MAX)
+    throw std::runtime_error(
+        "pending validation epoch exhausted/owner mismatch");
+  ++validation_epoch_;
+}
+void PendingOwnerV3::retire_context() {
+  if (!on_owner() || host_.dispatch_active() || poll_active_)
+    throw std::runtime_error("pending context owner mismatch");
+  request_cancel();
+  auto r = record();
+  bool notify = false;
+  if (r) {
+    std::lock_guard lock(r->publication_mutex);
+    r->state.store(State::Stale, std::memory_order_release);
+    notify = r->cancel_requested.load(std::memory_order_acquire) &&
+             !r->cancel_notified;
+    if (notify)
+      r->cancel_notified = true;
+  }
+  if (notify)
+    r->work->cancel(r->token);
+  context_generation_ = Next(next_generation);
+}
+PendingDispatch PendingOwnerV3::poll(Host &host) {
+  if (&host != &host_ || !on_owner() || host.guest_active())
+    throw std::runtime_error("pending owner mismatch");
+  if (poll_active_)
+    throw std::runtime_error("recursive pending poll");
+  struct PollScope {
+    bool &active;
+    ~PollScope() { active = false; }
+  } scope{poll_active_};
+  poll_active_ = true;
+  auto r = record();
+  if (!r)
+    throw std::runtime_error("unowned pending context");
+  if (r->state.load(std::memory_order_acquire) == State::Stale)
+    return PendingDispatch::Stale;
+  {
+    std::lock_guard lock(r->publication_mutex);
+    // Identity revocations are owner-only and quiescent. Claim an already
+    // invalid operation as failed before concurrent cancellation can be
+    // accepted. Subsequent worker actions can publish/cancel only, never revoke
+    // identity.
+    if (!r->cancel_requested.load(std::memory_order_acquire) &&
+        (!r->request.module_epoch_ptr ||
+         *r->request.module_epoch_ptr != r->request.module_epoch ||
+         !validate(this, &host.context, &r->request, r->token)))
+      r->state.store(State::Failed, std::memory_order_release);
+  }
+  int status;
+  if (r->cancel_requested.load(std::memory_order_acquire))
+    status = recomp_native_pending_cancel_v3(&host.context, &r->request,
+                                             r->token, live_thread(),
+                                             context_generation_, token());
+  else
+    status = recomp_native_pending_poll_v3(&host.context, &r->request, r->token,
+                                           live_thread(), context_generation_,
+                                           token());
+  switch (status) {
+  case RECOMP_NATIVE_V3_PARKED:
+    return PendingDispatch::Parked;
+  case RECOMP_NATIVE_V3_COMMITTED:
+    return PendingDispatch::Committed;
+  case RECOMP_NATIVE_V3_TERMINAL_CANCELLED:
+    r->state.store(State::Cancelled, std::memory_order_release);
+    return PendingDispatch::Cancelled;
+  case RECOMP_NATIVE_V3_STALE: {
+    bool notify = false;
+    {
+      std::lock_guard lock(r->publication_mutex);
+      r->state.store(State::Stale, std::memory_order_release);
+      r->cancel_requested.store(true, std::memory_order_release);
+      notify = !r->cancel_notified;
+      r->cancel_notified = true;
+    }
+    if (notify)
+      r->work->cancel(r->token);
+    return PendingDispatch::Stale;
+  }
+  default: {
+    bool notify = false;
+    {
+      std::lock_guard lock(r->publication_mutex);
+      r->state.store(State::Failed, std::memory_order_release);
+      r->cancel_requested.store(true, std::memory_order_release);
+      notify = !r->cancel_notified;
+      r->cancel_notified = true;
+    }
+    // Request staged-job cleanup; retained tickets keep unfinished work alive.
+    // This does not reclassify the transport failure as cancellation.
+    if (notify)
+      r->work->cancel(r->token);
+    return PendingDispatch::Failed;
+  }
+  }
+}
+} // namespace native
diff --git a/native-runtime/pending_owner_v3.h b/native-runtime/pending_owner_v3.h
new file mode 100644
--- /dev/null
+++ b/native-runtime/pending_owner_v3.h
@@ -0,0 +1,131 @@
+#pragma once
+#include "host.h"
+#ifndef RECOMP_NATIVE_PENDING_V3
+#error PendingOwnerV3 requires the optional emitted revision-3 runtime
+#endif
+#include <atomic>
+#include <cstddef>
+#include <mutex>
+#include <thread>
+namespace native {
+struct PendingInputV3 {
+  std::array<uint64_t, 8> arguments{};
+  std::vector<std::byte> bytes;
+};
+struct PendingResultV3 {
+  bool success{};
+  uint64_t bits{}, work_units{};
+};
+// Validate/snapshot have no external effects. Run sees owned immutable input
+// only. Commit and cancel execute on the context owner. GPU work is not
+// implemented here.
+class PendingWorkV3 {
+public:
+  virtual ~PendingWorkV3() = default;
+  virtual bool
+  validate(const Host &,
+           const RecompNativePendingRequestV3 &) const noexcept = 0;
+  virtual bool snapshot(const Host &, const GuestContext &,
+                        const RecompNativePendingRequestV3 &,
+                        PendingInputV3 &) const noexcept = 0;
+  virtual PendingResultV3 run(const PendingInputV3 &) noexcept = 0;
+  virtual bool commit(Host &, GuestContext &,
+                      const RecompNativePendingRequestV3 &,
+                      uint64_t) noexcept = 0;
+  virtual void cancel(uint64_t) noexcept {}
+};
+class PendingOwnerV3 final : public PendingScheduler {
+  struct Record;
+
+public:
+  class Completion {
+  public:
+    Completion() = default;
+    bool publish(PendingResultV3) const;
+    const PendingInputV3 &input() const;
+    uint64_t token() const noexcept;
+
+  private:
+    friend class PendingOwnerV3;
+    explicit Completion(std::shared_ptr<Record> r) : record_(std::move(r)) {}
+    std::shared_ptr<Record> record_;
+  };
+  PendingOwnerV3(Host &, std::shared_ptr<PendingWorkV3>);
+  ~PendingOwnerV3() override;
+  bool bind();
+  bool recognizes(uint32_t) const noexcept override;
+  PendingDispatch poll(Host &) override;
+  // Owner calls this only after Host::dispatch has returned through generated
+  // C.
+  bool run_ready_work();
+  // Thread-safe publication/cancellation: neither accesses GuestContext or
+  // memory.
+  bool complete(uint64_t token, PendingResultV3);
+  Completion completion() const;
+  // Returns false after commit has claimed publication; accepted cancellation
+  // always precedes guest output. Notification itself runs on the owner.
+  bool request_cancel();
+  void revoke_admission();
+  void retire_context();
+  uint64_t token() const;
+  uint64_t generation() const noexcept { return context_generation_; }
+  uint64_t work_units() const noexcept { return work_units_->load(); }
+  uint64_t late_completions() const noexcept {
+    return late_completions_->load();
+  }
+
+private:
+  enum class State {
+    Pending,
+    Ready,
+    Committing,
+    Committed,
+    Failed,
+    Cancelled,
+    Stale
+  };
+  struct Record {
+    mutable std::mutex publication_mutex;
+    std::shared_ptr<std::atomic<uint64_t>> late, work_units;
+    bool completion_reported = false, cancel_notified = false;
+    RecompNativePendingRequestV3 request{};
+    uint64_t token{};
+    PendingInputV3 input;
+    PendingResultV3 result;
+    std::shared_ptr<PendingWorkV3> work;
+    std::atomic<State> state{State::Pending};
+    std::atomic<bool> cancel_requested{false};
+  };
+  Host &host_;
+  const AddressSpace *space_;
+  std::shared_ptr<PendingWorkV3> work_;
+  const std::thread::id owner_;
+  uint64_t context_generation_, validation_epoch_ = 1;
+  bool work_active_ = false, poll_active_ = false;
+  mutable std::mutex mutex_;
+  std::shared_ptr<Record> record_;
+  std::shared_ptr<std::atomic<uint64_t>> late_completions_ =
+      std::make_shared<std::atomic<uint64_t>>(0);
+  std::shared_ptr<std::atomic<uint64_t>> work_units_ =
+      std::make_shared<std::atomic<uint64_t>>(0);
+  RecompNativePendingBindingV3 binding_{};
+  static PendingOwnerV3 *bound_;
+  bool on_owner() const noexcept;
+  uint64_t live_thread() const noexcept;
+  std::shared_ptr<Record> record() const;
+  static int identify(void *, const GuestContext *, uint64_t *, uint64_t *,
+                      uint64_t *) noexcept;
+  static int validate(void *, const GuestContext *,
+                      const RecompNativePendingRequestV3 *, uint64_t) noexcept;
+  static int admit(void *, const GuestContext *,
+                   const RecompNativePendingRequestV3 *,
+                   RecompNativePendingReplyV3 *) noexcept;
+  static int job_poll(void *, const RecompNativePendingRequestV3 *, uint64_t,
+                      RecompNativePendingReplyV3 *) noexcept;
+  static int commit(void *, GuestContext *,
+                    const RecompNativePendingRequestV3 *, uint64_t,
+                    uint64_t) noexcept;
+  static void cancel(void *, const RecompNativePendingRequestV3 *,
+                     uint64_t) noexcept;
+};
