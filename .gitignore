*.xci
*.nsp
*.nca
*.nso
*.nro
prod.keys
title.keys
keys/
firmware/
local/
generated/
traces/
# Per-target working directories. Coverage manifests written here quote
# instruction encodings and addresses out of the game, so this is game-derived
# output like generated/ and traces/, not documentation.
targets/
build/
exefs/
romfs/
# third_party/* rather than third_party/ so the negation below can take effect:
# git does not descend into an ignored directory, so a rule excluding the parent
# outright makes any un-ignore inside it unreachable.
third_party/*
# The suyu fork is a submodule pinned to an exact commit. The emulator source is
# the other half of this project and was previously ignored entirely, which
# meant the modified tree existed only on one disk and the patch files under
# src/patches were a hand-reconstructed substitute for it.
!third_party/suyu
__pycache__/
*.pyc
*.obj
*.exe
*.dll
*.lib
*.pdb

# Local agent/tooling state. Nothing here describes the project - it is scratch
# belonging to whatever tool happens to be driving the session.
.claude/
.omc/
