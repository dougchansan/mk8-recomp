+#include "builders.h"
+
+static int store(NativeNvnWrite write, void* user, uint64_t address, size_t width,
+                 uint64_t first, uint64_t second) {
+    unsigned char bytes[16];
+    for (size_t i = 0; i < width; ++i) {
+        const uint64_t value = i < 8 ? first : second;
+        bytes[i] = (unsigned char)(value >> (8 * (i % 8)));
+    }
+    return write(user, address, bytes, width);
+}
+
+enum NativeNvnStatus native_nvn_build(enum NativeNvnBuilderOperation operation,
+                                     const uint64_t arguments[4], NativeNvnWrite write,
+                                     void* user) {
+    uint64_t object, x1, x2, x3;
+    if (operation < NATIVE_NVN_BUFFER_BUILDER_SET_DEVICE ||
+        operation > NATIVE_NVN_DEVICE_BUILDER_SET_FLAGS) return NATIVE_NVN_UNSUPPORTED;
+    if (!arguments || !write) return NATIVE_NVN_INVALID_ARGUMENT;
+    /* Snapshot arguments before callbacks, including callbacks that alias them. */
+    object = arguments[0]; x1 = arguments[1]; x2 = arguments[2]; x3 = arguments[3];
+#define STORE(offset, width, first, second) \
+    do { if (!store(write, user, object + UINT64_C(offset), width, first, second)) \
+        return NATIVE_NVN_WRITE_FAULT; } while (0)
+    switch (operation) {
+    case NATIVE_NVN_BUFFER_BUILDER_SET_DEVICE:
+    case NATIVE_NVN_MEMORY_POOL_BUILDER_SET_DEVICE:
+        STORE(0, 8, x1, 0);
+        break;
+    case NATIVE_NVN_BUFFER_BUILDER_SET_DEFAULTS:
+        STORE(16, 16, 0, 0);
+        STORE(8, 8, 0, 0);
+        break;
+    case NATIVE_NVN_BUFFER_BUILDER_SET_STORAGE:
+        STORE(8, 16, x1, x2);
+        STORE(24, 8, x3, 0);
+        break;
+    case NATIVE_NVN_MEMORY_POOL_BUILDER_SET_DEFAULTS:
+        STORE(8, 16, 0, 0);
+        STORE(24, 4, 0x21, 0);
+        STORE(52, 4, 0, 0);
+        STORE(44, 8, 0, 0);
+        STORE(36, 8, 0, 0);
+        STORE(28, 8, 0, 0);
+        break;
+    case NATIVE_NVN_MEMORY_POOL_BUILDER_SET_STORAGE:
+        STORE(8, 16, x1, x2);
+        STORE(28, 4, 0, 0);
+        break;
+    case NATIVE_NVN_MEMORY_POOL_BUILDER_SET_FLAGS:
+        STORE(24, 4, x1, 0);
+        break;
+    case NATIVE_NVN_DEVICE_BUILDER_SET_DEFAULTS:
+        STORE(0, 16, 0, 0);
+        break;
+    case NATIVE_NVN_DEVICE_BUILDER_SET_FLAGS:
+        STORE(0, 4, x1, 0);
+        break;
+    default:
+        return NATIVE_NVN_UNSUPPORTED;
+    }
+#undef STORE
+    return NATIVE_NVN_OK;
+}
