+"""Independent native target bootstrap. Synthetic inputs; no game assets or keys."""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+parser=argparse.ArgumentParser()
+parser.add_argument('--build',type=Path,required=True)
+parser.add_argument('--lz4',type=Path)
+a=parser.parse_args()
+here=Path(__file__).resolve().parent
+source=here.parents[1]
+build=a.build.resolve()
+lz4=a.lz4 or next(iter((here.parents[2]/'current-host'/'kit'/'inputs').glob('*-lz4.lib')),None)
+configure=['cmake','-S',source/'native-runtime','-B',build]
+if lz4:configure+=['-DNATIVE_LZ4_LIBRARY='+str(lz4.resolve())]
+def run(command,expected=0):
+    print(' '.join(map(str,command)),flush=True)
+    result=subprocess.run(list(map(str,command)),creationflags=(subprocess.BELOW_NORMAL_PRIORITY_CLASS if os.name=='nt' else 0))
+    if result.returncode!=expected:raise RuntimeError(f'exit {result.returncode}, expected {expected}')
+def exe(name):
+    return next(p for p in (build/'Release'/(name+'.exe'),build/(name+'.exe'),build/name) if p.exists())
+run(configure)
+run(['cmake','--build',build,'--config','Release','--target','native_emit','--parallel','2'])
+run([exe('native_emit'),build/'generated',build/'fixture'])
+run(configure)
+run(['cmake','--build',build,'--config','Release','--parallel','2'])
+for primitive in ('ipc-wrapper','condition-signal','system-tick','memory-accounting','reservation-info','thread-priority','stack-info','aslr-info','entropy','real-clock','query','svc-registers','clock','pair-load','pair-store','alignment','pair-denied','glob','jump','negative','absolute','hidden','weak-addend','weak-negative','local','hidden-self','protected','ifunc','common'):
+    run([exe('native_primitive_test'),primitive])
+run([exe('native_loader_test'),build/'fixture',build/'nso-fixtures'])
+run([exe('native_ipc_test')])
+run([exe('native_platform_test'),build/'fixture'])
+run([exe('native_platform_test'),build/'fixture','guard'],86)
+run([exe('native_platform_test'),build/'fixture','seal-cache'])
+run([exe('native_platform_test'),build/'fixture','seal-bad'],86)
+
+# Malformed fixtures are private copies; unsupported shapes fail before execution.
+import struct
+negative=build/'negative'
+negative.mkdir(exist_ok=True)
+original={name:(build/'fixture'/name).read_bytes() for name in ('main','main.npdm','romfs.bin')}
+mutations={}
+def mutation(name,file,offset,data):
+    blobs=original.copy()
+    value=bytearray(blobs[file]);value[offset:offset+len(data)]=data;blobs[file]=bytes(value)
+    mutations[name]=blobs
+mutation('compressed-nso','main',12,struct.pack('<I',1))
+mutation('text-identity','main',0x124,b'\xff')
+mutation('segment-bounds','main',16,struct.pack('<I',0xffffffff))
+mutation('npdm-magic','main.npdm',0,b'FAIL')
+aci=struct.unpack_from('<I',original['main.npdm'],0x70)[0]
+kac,size=struct.unpack_from('<II',original['main.npdm'],aci+48)
+mutation('svc-capability','main.npdm',aci+kac,b'\0'*size)
+meta=struct.unpack_from('<Q',original['romfs.bin'],56)[0]
+mutation('romfs-bounds','romfs.bin',meta+16,struct.pack('<Q',0xffffffffffffffff))
+mutation('romfs-path','romfs.bin',meta+32,b'../')
+for name,blobs in mutations.items():
+    target=negative/name;target.mkdir(exist_ok=True)
+    for file,blob in blobs.items():(target/file).write_bytes(blob)
+    run([exe('native_platform_test'),target,'load'],1)
+if os.name=='nt':
+    import re
+    dumpbin=next(iter(sorted(Path('C:/Program Files/Microsoft Visual Studio').glob('*/*/VC/Tools/MSVC/*/bin/Hostx64/x64/dumpbin.exe'))),None)
+    assert dumpbin,'MSVC dumpbin required for static dependency proof'
+    for target in ('native_platform_test','native_loader_test','native_admit','native_primitive_test','native_ipc_test'):
+        text=(build/(target+'.map')).read_text(errors='replace')
+        assert not re.search(r'Dynarmic|ArmRecomp|KThread|Core@System|vulkan|SDL_|Qt[0-9]',text,re.I),'Forbidden host dependency in linked symbol map'
+        if dumpbin:
