+#include "draw.h"
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <iostream>
+#include <sirit/sirit.h>
+#include <stdexcept>
+using namespace native_nvn;
+namespace {
+std::vector<uint32_t> Shader(bool vertex) {
+  Sirit::Module m(0x00010000);
+  m.AddCapability(spv::Capability::Shader);
+  m.SetMemoryModel(spv::AddressingModel::Logical, spv::MemoryModel::GLSL450);
+  const auto f = m.TypeFloat(32), v = m.TypeVector(f, 4);
+  const auto out = m.AddGlobalVariable(
+      m.TypePointer(spv::StorageClass::Output, v), spv::StorageClass::Output);
+  Sirit::Id input{}, ubo{}, sampled_type{}, tex0{}, tex1{}, uniform_pointer{};
+  if (vertex) {
+    m.Decorate(out, spv::Decoration::BuiltIn, spv::BuiltIn::Position);
+    input = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Input, v),
+                                spv::StorageClass::Input);
+    m.Decorate(input, spv::Decoration::Location, 0u);
+  } else {
+    m.Decorate(out, spv::Decoration::Location, 0u);
+    auto block = m.TypeStruct(v);
+    m.Decorate(block, spv::Decoration::Block);
+    m.MemberDecorate(block, 0u, spv::Decoration::Offset, 0u);
+    ubo = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Uniform, block),
+                              spv::StorageClass::Uniform);
+    uniform_pointer = m.TypePointer(spv::StorageClass::Uniform, v);
+    m.Decorate(ubo, spv::Decoration::DescriptorSet, 0u);
+    m.Decorate(ubo, spv::Decoration::Binding, 0u);
+    auto image = m.TypeImage(f, spv::Dim::Dim2D, 0, false, false, 1,
+                             spv::ImageFormat::Unknown);
+    sampled_type = m.TypeSampledImage(image);
+    auto pointer =
+        m.TypePointer(spv::StorageClass::UniformConstant, sampled_type);
+    tex0 = m.AddGlobalVariable(pointer, spv::StorageClass::UniformConstant);
+    tex1 = m.AddGlobalVariable(pointer, spv::StorageClass::UniformConstant);
+    m.Decorate(tex0, spv::Decoration::DescriptorSet, 0u);
+    m.Decorate(tex0, spv::Decoration::Binding, 1u);
+    m.Decorate(tex1, spv::Decoration::DescriptorSet, 0u);
+    m.Decorate(tex1, spv::Decoration::Binding, 2u);
+  }
+  auto uv = m.ConstantComposite(m.TypeVector(f, 2), m.Constant(f, 0.5f),
+                                m.Constant(f, 0.5f));
+  auto zero = m.Constant(m.TypeInt(32, false), 0u);
+  auto fn = m.OpFunction(m.TypeVoid(), spv::FunctionControlMask::MaskNone,
+                         m.TypeFunction(m.TypeVoid()));
+  m.AddLabel();
+  if (vertex)
+    m.OpStore(out, m.OpLoad(v, input));
+  else {
+    auto tint = m.OpLoad(v, m.OpAccessChain(uniform_pointer, ubo, zero));
+    auto first =
+        m.OpImageSampleImplicitLod(v, m.OpLoad(sampled_type, tex0), uv);
+    auto second =
+        m.OpImageSampleImplicitLod(v, m.OpLoad(sampled_type, tex1), uv);
+    m.OpStore(out, m.OpFMul(v, m.OpFMul(v, first, second), tint));
+  }
+  m.OpReturn();
+  m.OpFunctionEnd();
+  if (vertex)
+    m.AddEntryPoint(spv::ExecutionModel::Vertex, fn, "main", input, out);
+  else {
+    m.AddEntryPoint(spv::ExecutionModel::Fragment, fn, "main", out);
+    m.AddExecutionMode(fn, spv::ExecutionMode::OriginUpperLeft);
+  }
+  return m.Assemble();
+}
+struct Memory {
+  std::array<std::byte, 4096> bytes{};
+  static bool Read(void *user, uint64_t address, std::span<std::byte> out) {
+    auto &memory = *static_cast<Memory *>(user);
+    if (address < 0x10000 || address - 0x10000 > memory.bytes.size() ||
+        out.size() > memory.bytes.size() - (address - 0x10000))
+      return false;
+    std::copy_n(memory.bytes.begin() + address - 0x10000, out.size(),
+                out.begin());
+    return true;
+  }
+  static bool Write(void *, uint64_t, std::span<const std::byte>) {
+    return false;
+  }
+};
+void Check(bool value, const char *why) {
+  if (!value)
+    throw std::runtime_error(why);
+}
+void Pixels(const DrawResult &result, unsigned green, bool scissor = false) {
+  for (uint32_t y = 0; y < result.height; y++)
+    for (uint32_t x = 0; x < result.width; x++) {
+      auto pixel = result.rgba8.data() + 4 * (y * result.width + x);
+      auto expected =
+          scissor && (x < 16 || x >= 48 || y < 16 || y >= 48) ? 0 : green;
+      Check(pixel[0] == std::byte{} && pixel[2] == std::byte{} &&
+                pixel[3] == std::byte{255} &&
+                std::abs(int(pixel[1]) - int(expected)) <= 1,
+            "Textured/uniform pixel mismatch");
+    }
+}
+} // namespace
+int main() {
+  try {
+    Memory memory;
+    const float vertices[12] = {-1, -1, 0, 1, 3, -1, 0, 1, -1, 3, 0, 1};
+    const uint16_t indices16[3] = {0, 1, 2};
+    const uint32_t indices32[3] = {0, 1, 2};
+    const float tint[4] = {0, 1, 0, 1};
+    std::memcpy(memory.bytes.data(), vertices, sizeof(vertices));
+    std::memcpy(memory.bytes.data() + 128, indices16, sizeof(indices16));
+    std::memcpy(memory.bytes.data() + 256, indices32, sizeof(indices32));
+    std::memcpy(memory.bytes.data() + 512, tint, sizeof(tint));
+    Resources resources({&memory, Memory::Read, Memory::Write});
+    resources.CreateDevice(0x1000);
+    resources.CreatePool(0x2000, {0x1000, 0x10000, 4096, CpuAccess::Cached});
+    resources.CreateBuffer(0x3000, {0x1000, 0x2000, 0, 48});
+    resources.CreateBuffer(0x3010, {0x1000, 0x2000, 128, 6});
+    resources.CreateBuffer(0x3020, {0x1000, 0x2000, 256, 12});
+    resources.CreateBuffer(0x3030, {0x1000, 0x2000, 512, 16});
+    auto vertex = Shader(true), fragment = Shader(false);
+    const DescriptorPlan plan[] = {
+        {0, DescriptorKind::UniformBuffer, ShaderStage::Fragment},
+        {1, DescriptorKind::CombinedImageSampler2D, ShaderStage::Fragment},
+        {2, DescriptorKind::CombinedImageSampler2D, ShaderStage::Fragment}};
+    const std::array<std::byte, 4> white = {std::byte{255}, std::byte{255},
+                                            std::byte{255}, std::byte{255}};
+    const std::array<std::byte, 4> green = {std::byte{255}, std::byte{128},
+                                            std::byte{255}, std::byte{255}};
+    const Texture2D textures[] = {{1, 1, 1, white}, {2, 1, 1, green}};
+    const UniformBinding uniforms[] = {{0, 0x3030, 0, 16}};
+    ProgramDescription program{vertex, fragment, plan};
+    DrawDescription draw;
+    draw.vertices = 0x3000;
+    draw.uniforms = uniforms;
+    draw.textures = textures;
+    unsigned draws = 0, rejected = 0;
+    auto reject = [&](auto action) {
+      try {
+        action();
+      } catch (const std::runtime_error &) {
+        ++rejected;
+        return;
+      }
+      throw std::runtime_error("Expected draw rejection");
+    };
+    auto gather = vertex;
+    gather.insert(gather.begin() + 5, {(2u << 16) | 17u, 25u});
+    ProgramDescription gather_program{gather, fragment, plan};
+    reject([&] { ValidateProgram(gather_program, false); });
+    ValidateProgram(gather_program, true);
+    auto core = vertex;
+    core.insert(core.begin() + 5,
+                {(2u << 16) | 17u, 46u, (2u << 16) | 17u, 50u});
+    ValidateProgram({core, fragment, plan}, false);
+    Pixels(DrawOffscreen(resources, 0x1000, program, draw), 128);
+    ++draws;
+    draw.index_format = IndexFormat::Uint16;
+    draw.indices = 0x3010;
+    Pixels(DrawOffscreen(resources, 0x1000, program, draw), 128);
+    ++draws;
+    draw.index_format = IndexFormat::Uint32;
+    draw.indices = 0x3020;
+    draw.topology = Topology::TriangleStrip;
+    Pixels(DrawOffscreen(resources, 0x1000, program, draw), 128);
+    ++draws;
+    draw.scissor = {16, 16, 32, 32};
+    Pixels(DrawOffscreen(resources, 0x1000, program, draw), 128, true);
+    ++draws;
+    draw.scissor = {0, 0, 64, 64};
+    draw.blend = Blend::SourceAlpha;
+    float alpha = 0.5f;
+    std::memcpy(memory.bytes.data() + 512 + 12, &alpha, 4);
+    resources.FlushBuffer(0x3030, 0, 16);
+    Pixels(DrawOffscreen(resources, 0x1000, program, draw), 64);
+    ++draws;
+    auto invalid = draw;
+    invalid.count = 4;
+    reject([&] { DrawOffscreen(resources, 0x1000, program, invalid); });
+    invalid = draw;
+    invalid.viewport.width = -1;
+    reject([&] { DrawOffscreen(resources, 0x1000, program, invalid); });
+    invalid = draw;
+    invalid.stride = 4;
+    reject([&] { DrawOffscreen(resources, 0x1000, program, invalid); });
+    invalid = draw;
+    invalid.width = 4096;
+    reject([&] { DrawOffscreen(resources, 0x1000, program, invalid); });
+    auto unsupported = vertex;
+    unsupported[6] = 11;
+    ProgramDescription bad{unsupported, fragment, plan};
+    reject([&] { DrawOffscreen(resources, 0x1000, bad, draw); });
+    ProgramDescription missing{vertex, fragment, {}};
+    reject([&] { DrawOffscreen(resources, 0x1000, missing, draw); });
+    const UniformBinding short_uniform[] = {{0, 0x3030, 0, 4}};
+    invalid = draw;
+    invalid.uniforms = short_uniform;
+    reject([&] { DrawOffscreen(resources, 0x1000, program, invalid); });
+    auto broken = vertex;
+    broken[5] = 0;
+    bad = {broken, fragment, plan};
+    reject([&] { DrawOffscreen(resources, 0x1000, bad, draw); });
+    auto memory_before = memory.bytes;
+    uint32_t invalid_index = 99;
+    std::memcpy(memory.bytes.data() + 256, &invalid_index, 4);
+    resources.FlushBuffer(0x3020, 0, 12);
+    reject([&] { DrawOffscreen(resources, 0x1000, program, draw); });
+    std::cout << "{\"passed\":true,\"native_draws\":" << draws
+              << ",\"uniforms\":1,\"combined_textures\":2,\"pixels_checked\":"
+              << draws * 4096 << ",\"rejected\":" << rejected
+              << ",\"actual_game_inputs\":false}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
