+++ b/src/native_nvn/query.c
@@ -0,0 +1,29 @@
+#include "query.h"
+
+enum NativeNvnStatus native_nvn_query(enum NativeNvnQuery operation, uint64_t object,
+                                      NativeNvnRead read, void* user, uint64_t* result) {
+    unsigned char bytes[8];
+    size_t width;
+    uint64_t address, value = 0;
+    if (!result) return NATIVE_NVN_INVALID_ARGUMENT;
+    switch (operation) {
+    case NATIVE_NVN_BUFFER_DEBUG_ID:
+        *result = 0;
+        return NATIVE_NVN_OK;
+    case NATIVE_NVN_BUFFER_SIZE:
+        address = object + UINT64_C(32);
+        width = 8;
+        break;
+    case NATIVE_NVN_VERTEX_STREAM_STRIDE:
+        address = object;
+        width = 4;
+        break;
+    default:
+        return NATIVE_NVN_UNSUPPORTED;
+    }
+    if (!read) return NATIVE_NVN_INVALID_ARGUMENT;
+    if (!read(user, address, bytes, width)) return NATIVE_NVN_READ_FAULT;
+    for (size_t i = 0; i < width; ++i) value |= (uint64_t)bytes[i] << (8 * i);
+    *result = value;
+    return NATIVE_NVN_OK;
+}
