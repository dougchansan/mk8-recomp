+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "nvn/nvn_draw_state.h"
+#include <cstring>
+#include <iostream>
+
+template<class Check> void native_rgb565_probe(Check check) {
+    using namespace nx;
+    using namespace nx::nvn;
+    // Authored primary colours. NVN RGB565 puts red in bits 0..4,
+    // green in 5..10 and blue in 11..15. No title data enters this fixture.
+    constexpr uint16_t expected[] = {0x001f, 0x07e0, 0xf800};
+    for (unsigned channel = 0; channel < 3; ++channel) {
+        const auto key = kernel_alloc(256, 4096);
+        auto& texture = make<Texture>(key);
+        texture.target = 1;
+        texture.width = texture.height = 2;
+        texture.depth = texture.levels = 1;
+        texture.format = 0x3c;
+        {
+            std::lock_guard lock(gpu_lock());
+            auto* image = image_of(key);
+            check(image && image->image && image->width == 2 && image->height == 2);
+            const auto command = frame_begin(false);
+            transition(command, *image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+            VkClearColorValue colour{};
+            colour.float32[channel] = colour.float32[3] = 1.0f;
+            const VkImageSubresourceRange range{VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+            vk::p_vkCmdClearColorImage(command, image->image,
+                VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &colour, 1, &range);
+            image->rendered = true;
+            const auto readback = upload_alloc(8, 4);
+            transition(command, *image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+            VkBufferImageCopy copy{};
+            copy.bufferOffset = readback.offset;
+            copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+            copy.imageExtent = {2, 2, 1};
+            vk::p_vkCmdCopyImageToBuffer(command, image->image,
+                VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, readback.buffer, 1, &copy);
+            VkBufferMemoryBarrier barrier{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+            barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+            barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+            barrier.srcQueueFamilyIndex = barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+            barrier.buffer = readback.buffer;
+            barrier.offset = readback.offset;
+            barrier.size = 8;
+            vk::p_vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                VK_PIPELINE_STAGE_HOST_BIT, 0, 0, nullptr, 1, &barrier, 0, nullptr);
+            frame_submit(VK_NULL_HANDLE, VK_NULL_HANDLE, {}, true);
+            for (unsigned pixel = 0; pixel < 4; ++pixel) {
+                uint16_t value = 0;
+                std::memcpy(&value, readback.ptr + pixel * 2, sizeof value);
+                if (value != expected[channel])
+                    std::cerr << "RGB565 channel=" << channel << " pixel=" << pixel
+                        << " packed=0x" << std::hex << value << " expected=0x"
+                        << expected[channel] << std::dec << '\n';
+                check(value == expected[channel]);
+            }
+        }
+        destroy(key);
+    }
+}
