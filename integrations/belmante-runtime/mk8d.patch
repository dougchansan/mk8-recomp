+ }
+ void visit_dir(uint32_t off,const std::string& parent,uint32_t expected_parent,unsigned depth){
+  if(depth>128 || (off&3) || !seen_dirs_.insert(off).second)throw std::runtime_error("RomFS directory cycle/depth");
