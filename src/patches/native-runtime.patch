@@ -0,0 +1,265 @@
+#include "clock.h"
+#include "host.h"
+#include "ipc_bridge.h"
+#include "nso.h"
+#include "services/logging.h"
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <iterator>
+#include <map>
+#include <stdexcept>
+#ifdef _WIN32
+#include <windows.h>
+
+#include <bcrypt.h>
+#endif
+#define MODULE(n)                                                              \
+  extern "C" {                                                                 \
+  BlockFn recomp_image_lookup_##n(uint64_t);                                   \
+  void recomp_image_run_slice_##n(GuestContext *);                             \
+  void recomp_image_set_base_##n(uint64_t);                                    \
+  unsigned recomp_image_guard_v2_##n(unsigned);                                \
+  unsigned recomp_image_abi_##n();                                             \
+  unsigned recomp_image_features_##n();                                        \
+  uint32_t *recomp_image_guard_gen_v1_##n(uint32_t, uint64_t *, uint64_t *,    \
+                                          const uint64_t **);                  \
+  unsigned recomp_image_fastmem_v1_##n(uint32_t, uint32_t, uint64_t, uint32_t, \
+                                       uint32_t);                              \
+  unsigned recomp_image_fpx_v1_##n(uint32_t, uint32_t, uint64_t);              \
+  }
+MODULE(rtld) MODULE(main) MODULE(subsdk0) MODULE(sdk) namespace {
+  struct Image {
+    const char *name;
+    BlockFn (*lookup)(uint64_t);
+    void (*slice)(GuestContext *);
+    void (*base)(uint64_t);
+    unsigned (*guard)(unsigned);
+    unsigned (*abi)();
+    unsigned (*features)();
+    uint32_t *(*gg)(uint32_t, uint64_t *, uint64_t *, const uint64_t **);
+    unsigned (*fm)(uint32_t, uint32_t, uint64_t, uint32_t, uint32_t);
+    unsigned (*fpx)(uint32_t, uint32_t, uint64_t);
+  };
+#define IMAGE(n)                                                               \
+  {                                                                            \
+    #n, recomp_image_lookup_##n, recomp_image_run_slice_##n,                   \
+        recomp_image_set_base_##n, recomp_image_guard_v2_##n,                  \
+        recomp_image_abi_##n, recomp_image_features_##n,                       \
+        recomp_image_guard_gen_v1_##n, recomp_image_fastmem_v1_##n,            \
+        recomp_image_fpx_v1_##n                                                \
+  }
+  const Image images[] = {IMAGE(rtld), IMAGE(main), IMAGE(subsdk0), IMAGE(sdk)};
+  uint64_t value(const std::vector<uint8_t> &bytes, size_t at, unsigned size) {
+    if (at > bytes.size() || size > bytes.size() - at)
+      throw std::runtime_error("NPDM extent");
+    uint64_t out = 0;
+    memcpy(&out, bytes.data() + at, size);
+    return out;
+  }
+  void dump(const native::Host &h, const std::string &reason) {
+    std::cout << "STOP reason=" << reason << " pc=0x" << std::hex
+              << h.context.pc << " pending_svc=0x" << h.context.pending_svc
+              << " halted=" << h.context.halted << std::dec
+              << " slices=" << h.slices << " blocks=" << h.blocks
+              << " reads=" << h.data_reads << " writes=" << h.data_writes
+              << " code_reads=" << h.instruction_reads
+              << " svc_calls=" << h.svc_calls << " last_address=0x" << std::hex
+              << h.last_address << std::dec
+              << " access_size=" << h.last_access_size
+              << " write=" << h.last_access_write << "\n";
+    for (unsigned i = 0; i < 32; ++i)
+      std::cout << "x" << std::dec << i << "=0x" << std::hex << h.context.x[i]
+                << (i % 4 == 3 ? '\n' : ' ');
+    std::cout << "nzcv=" << unsigned(h.context.n) << unsigned(h.context.z)
+              << unsigned(h.context.c) << unsigned(h.context.v) << " fpcr=0x"
+              << h.context.fpcr << " fpsr=0x" << h.context.fpsr << std::dec
+              << "\n";
+  }
+}
+int main(int argc, char **argv) {
+  native::Host host;
+  native::AddressSpace space;
+  std::unique_ptr<native_services::Router> service_router;
+  try {
+    if (argc < 2)
+      return 2;
+    std::filesystem::path root = argv[1];
+    std::vector<native::BootModule> modules;
+    std::vector<uint32_t *> generation_words;
+    uint64_t base = 0x80000000;
+    for (const auto &entry : images) {
+      auto image = native::load_nso(root / entry.name);
+      native::map_nso(space, image, base);
+      if (entry.abi() != 6 || entry.features() != 7 || entry.guard(2) != 2)
+        throw std::runtime_error("module ABI/features/guard mismatch");
+      entry.base(base);
+      uint64_t lo, end;
+      const uint64_t *stored_base;
+      auto word = entry.gg(2, &lo, &end, &stored_base);
+      if (!word || *stored_base != base || lo != 0 ||
+          end != image.segments[0].bytes.size() ||
+          entry.fm(12, 5, ~UINT64_C(3), offsetof(GuestContext, fm_table),
+                   offsetof(GuestContext, fm_limit)) != 1 ||
+          entry.fpx(offsetof(GuestContext, fpcr), offsetof(GuestContext, fpsr),
+                    RECOMP_FPX_INHIBIT) != (0x100 | RECOMP_FPX_HOST))
+        throw std::runtime_error("module capability layout mismatch");
+      generation_words.push_back(word);
+      std::cout << entry.name << " base=0x" << std::hex << base
+                << " id=" << native::build_id_hex(image) << std::dec
+                << " ABI=6 features=7 FPX=" << RECOMP_FPX_HOST
+                << " guard=first-verify-immutable-cache\n";
+      host.modules.push_back({entry.name, entry.lookup, entry.slice});
+      auto size = image.image_size;
+      modules.push_back({base, std::move(image)});
+      base += size;
+    }
+    std::cout << "rtld relocation slots="
+              << native::relocate_rtld(space, modules) << "\n";
+    std::ifstream file(root / "main.npdm", std::ios::binary);
+    std::vector<uint8_t> metadata((std::istreambuf_iterator<char>(file)), {});
+    if (value(metadata, 0, 4) != 0x4154454d || value(metadata, 12, 1) != 7)
+      throw std::runtime_error("NPDM mode");
+    auto stack_size = value(metadata, 0x1c, 4);
+    if (!stack_size || stack_size % 4096 || stack_size > 16 * 1024 * 1024)
+      throw std::runtime_error("NPDM stack bound");
+    auto aci = value(metadata, 0x70, 4), aci_size = value(metadata, 0x74, 4);
+    if (aci > metadata.size() || aci_size > metadata.size() - aci ||
+        value(metadata, aci, 4) != 0x30494341)
+      throw std::runtime_error("NPDM ACI");
+    auto kac = value(metadata, aci + 48, 4),
+         kac_size = value(metadata, aci + 52, 4);
+    if (kac > aci_size || kac_size > aci_size - kac || kac_size % 4)
+      throw std::runtime_error("NPDM KAC");
+    host.allowed_svcs.clear();
+    for (uint64_t i = 0; i < kac_size; i += 4) {
+      auto cap = value(metadata, aci + kac + i, 4);
+      if ((cap & 31) == 15)
+        for (unsigned bit = 0; bit < 24; ++bit)
+          if ((cap >> 5) & (UINT64_C(1) << bit))
+            host.allowed_svcs.push_back(unsigned((cap >> 29) * 24 + bit));
+    }
+    const auto memory_budget =
+        argc > 2 ? std::stoull(argv[2]) : (UINT64_C(4) << 30);
+    if (memory_budget > (UINT64_C(8) << 30))
+      throw std::runtime_error("native physical budget limit");
+    space.set_physical_budget(memory_budget);
+    const uint64_t stack = UINT64_C(0x7000000000), tls = UINT64_C(0x6000000000);
+    space.reserve(
+        UINT64_C(0x2000000000), UINT64_C(64) << 30,
+        7); // Native-owned alias virtual capacity, KAddressSpaceInfo39.
+    space.reserve(
+        UINT64_C(0x100000000), UINT64_C(8) << 30,
+        5); // Native-owned heap virtual capacity, initially uncommitted.
+    space.reserve(stack, UINT64_C(2) << 30,
+                  11); // KAddressSpaceInfo 39-bit Stack capacity, owned sparse
+                       // reservation.
+    space.map(stack, {}, stack_size, 3, 11);
+    space.map(tls, {}, 4096, 3, 12);
+    host.address_space = &space;
+    host.process_layout.emplace(
+        space.address_limit()); // Windows 39-bit native process configuration,
+                                // KAddressSpaceInfo Map39Bit contract.
+    native::SteadyCounter clock;
+    host.counter_override = [&] { return clock.ticks(); };
+    host.sleep_override = [&](uint64_t ns) { clock.sleep(ns); };
+    if (BCryptGenRandom(nullptr, reinterpret_cast<PUCHAR>(host.entropy.data()),
+                        ULONG(sizeof(host.entropy)),
+                        BCRYPT_USE_SYSTEM_PREFERRED_RNG) < 0)
+      throw std::runtime_error("native process entropy initialization");
+    host.entropy_available = true;
+    host.record_events = false;
+    host.context.pc = 0x80000000;
+    host.context.x[31] = stack + stack_size;
+    // k_thread.cpp ResetThreadContext64 permits any odd random x18; use a
+    // pinned odd value for this diagnostic.
+    host.context.x[18] = 1;
+    host.context.tpidrro_el0 = tls;
+    // The bootstrap handle names this actual owned context; unsupported handle
+    // operations remain fatal.
+    const auto main_handle = host.register_current_thread(
+        1, int32_t(value(metadata, 14, 1)), unsigned(value(metadata, 15, 1)));
+    host.context.x[0] = 0;
+    host.context.x[1] = main_handle;
+    // k_process.cpp publishes the owned main-thread handle at TLS+0x110.
+    space.write(tls + 0x110, 4, main_handle);
+    const auto process_id = uint64_t(GetCurrentProcessId());
+    service_router = std::make_unique<native_services::Router>(process_id);
+    if (argc > 3) {
+      auto sink = native_services::CreateFileLogSink(argv[3]);
+      service_router->Register(
+          "lm", [sink] { return native_services::CreateLoggingService(sink); });
+      std::cout << "native_lm_sink=" << argv[3] << "\n";
+    }
+    native::attach_services(host, *service_router, process_id);
+    auto send_request = host.send_sync_request;
+    host.send_sync_request = [&space, send_request](uint32_t handle,
+                                                    uint64_t tls) {
+      auto trace = [&](const char *phase) {
+        std::cout << "IPC " << phase << " handle=0x" << std::hex << handle;
+        for (unsigned i = 0; i < 16; ++i)
+          std::cout << " w" << std::dec << i << "=0x" << std::hex
+                    << space.read(tls + i * 4, 4);
+        std::cout << std::dec << "\n";
+      };
+      trace("request");
+      auto result = send_request(handle, tls);
+      trace("response");
+      std::cout << "IPC kernel_result=0x" << std::hex << result << std::dec
+                << "\n";
+      return result;
+    };
+
+    host.svc_observer = [](const GuestContext &c, bool complete) {
+      std::cout << "SVC " << (complete ? "response" : "request") << " id=0x"
+                << std::hex << c.pending_svc << " pc=0x" << c.pc << " x0=0x"
+                << c.x[0] << " x1=0x" << c.x[1] << " x2=0x" << c.x[2]
+                << " x3=0x" << c.x[3] << " lr=0x" << c.x[30] << std::dec
+                << "\n";
+    };
+    host.seal_code();
+    for (auto word : generation_words)
+      RECOMP_GG_STORE_RELEASE(*word, 1u);
+    std::cout << "clock=steady19.2MHz sleep=native-positive-single-thread "
+                 "entropy=OS-per-process\n";
+    std::cout << "EXECUTE initial_pc=0x80000000 stack_top=0x" << std::hex
+              << host.context.x[31] << " tls=0x" << tls << std::dec << "\n"
+              << std::flush;
+    host.dispatch(4096, 4096);
+    dump(host, "process exit");
+    return 0;
+  } catch (const std::exception &e) {
+    dump(host, e.what());
+    if (service_router)
+      std::cout << "native_sessions=" << service_router->SessionCount() << "\n";
+    if (host.address_space) {
+      uint64_t frame = host.context.x[29];
+      for (unsigned i = 0; i < 12 && frame; ++i) {
+        try {
+          auto next = host.address_space->read(frame, 8);
+          auto lr = host.address_space->read(frame + 8, 8);
+          std::cout << "frame" << i << "=0x" << std::hex << frame
+                    << " return=0x" << lr << std::dec << "\n";
+          if ((next & 15) || next <= frame)
+            break;
+          frame = next;
+        } catch (const std::exception &) {
+          break;
+        }
+      }
+    }
+
+    if (host.context.pending_svc == 33 && host.address_space) {
+      try {
+        for (unsigned i = 0; i < 64; ++i)
+          std::cout << "ipc_word" << std::dec << i << "=0x" << std::hex
+                    << host.address_space->read(
+                           host.context.tpidrro_el0 + 4 * i, 4)
+                    << "\n";
+      } catch (const std::exception &) {
+        std::cout << "IPC buffer unavailable\n";
+      }
+    }
+    return 3;
+  }
+}
diff --git a/native-runtime/clock.h b/native-runtime/clock.h
new file mode 100644
index 0000000000000000000000000000000000000000..ca52e7f89d3e935e35a2c8ccc2285a84a8e75dae
--- /dev/null
+++ b/native-runtime/clock.h
@@ -0,0 +1,31 @@
+#pragma once
+#include <chrono>
+#include <cstdint>
+#include <stdexcept>
+#include <thread>
+namespace native {
+class SteadyCounter {
+public:
+  uint64_t ticks() const {
+    auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                  std::chrono::steady_clock::now() - origin_)
+                  .count();
+    if (ns < 0)
+      throw std::runtime_error("steady clock moved backwards");
+    return (uint64_t(ns) / 1000000000) * 19200000 +
+           (uint64_t(ns) % 1000000000) * 19200000 / 1000000000;
+  }
+  void sleep(uint64_t nanoseconds) const {
+    if (nanoseconds > INT64_MAX)
+      throw std::runtime_error("native sleep interval overflow");
+    if (!nanoseconds)
+      std::this_thread::yield();
+    else
+      std::this_thread::sleep_for(std::chrono::nanoseconds(nanoseconds));
+  }
+
+private:
+  std::chrono::steady_clock::time_point origin_ =
+      std::chrono::steady_clock::now();
+};
+} // namespace native
