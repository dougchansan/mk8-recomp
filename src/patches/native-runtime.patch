+namespace native_nvn {
+struct ImageHandle {
+  uint64_t value = 0;
+  bool operator==(const ImageHandle &) const = default;
+};
+struct ViewHandle {
+  uint64_t value = 0;
+};
+struct SamplerHandle {
+  uint64_t value = 0;
+};
+// Physical identity is supplied by the checked mapping owner, never a virtual
+// pool key.
+struct ImageBacking {
+  uint64_t identity = 0, generation = 0, offset = 0, size = 0;
+};
+struct ImageDescription {
+  uint32_t width = 64, height = 64, mips = 1, layers = 1, samples = 1;
+  ImageFormat format = ImageFormat::Rgba8Unorm;
+  uint32_t usage = ColorTarget | Sampled | TransferSource | TransferDestination;
+  ImageBacking backing;
+};
+struct ViewDescription {
+  ImageFormat format = ImageFormat::Rgba8Unorm;
+  uint32_t mip = 0, mips = 1, layer = 0, layers = 1;
+  enum class Component { Zero, One, R, G, B, A };
+  std::array<Component, 4> swizzle{Component::R, Component::G, Component::B,
+                                   Component::A};
+};
+enum class TextureFilter { Nearest, Linear };
+enum class MipmapFilter { Nearest, Linear };
+enum class AddressMode { ClampToEdge, Repeat };
+struct SamplerState {
+  TextureFilter min = TextureFilter::Nearest, mag = TextureFilter::Nearest;
+  MipmapFilter mip = MipmapFilter::Nearest;
+  AddressMode u = AddressMode::ClampToEdge, v = AddressMode::ClampToEdge,
+              w = AddressMode::ClampToEdge;
+  float min_lod = 0, max_lod = 0, bias = 0, anisotropy = 1;
+  bool normalized = true, compare = false;
+};
+void ValidateSamplerState(const SamplerState &,
+                          const native_graphics::GraphicsCapabilities &);
+// Legacy fields preserve the Stage A nearest/clamp/zero-LOD preset.
+// Select state explicitly for additional supported semantic sampler choices.
+struct SamplerDescription {
+  bool nearest = true, clamp = true, compare = false;
+  float min_lod = 0, max_lod = 0;
+  std::optional<SamplerState> state;
+};
+struct SampleBinding {
+  uint32_t binding;
+  ViewHandle view;
+  SamplerHandle sampler;
+};
+struct TargetPass {
+  ViewHandle view;
+  AttachmentLoad load = AttachmentLoad::Load;
+  AttachmentStore store = AttachmentStore::Store;
+  std::array<float, 4> clear{0, 0, 0, 1};
+};
+enum class FrameRecordFault { None, AcquireBufferPin, PublishBufferPin };
+enum class FrameFault {
+  None,
+  BeforeSubmit,
+  SubmitFailure,
+  Timeout,
+  DeviceLoss
+};
+struct FrameCounters {
+  uint64_t recorded = 0, submitted = 0, completed = 0, readbacks = 0,
+           failures = 0;
+};
+struct ImageReadback {
+  ImageFormat format;
+  uint32_t width, height;
+  uint64_t row_bytes;
+  std::vector<std::byte> bytes;
+};
+class FrameEncoder;
+class PresentSource;
+// Owner-thread persistent typed image store. Resources must outlive API use; a
+// device lease retains backend teardown; external callers must not
+// destroy/mutate borrowed buffers until frame completion.
+class FrameImages {
+public:
+  FrameImages(Resources &, GuestAddress,
+              uint64_t allocation_budget = 256ull << 20);
+  ~FrameImages();
+  FrameImages(const FrameImages &) = delete;
+  ImageHandle CreateImage(const ImageDescription &);
+  ViewHandle CreateView(ImageHandle, const ViewDescription & = {});
+  SamplerHandle CreateSampler(const SamplerDescription & = {});
+  void DestroyImage(ImageHandle);
+  void DestroyView(ViewHandle);
+  void DestroySampler(SamplerHandle);
+  void UploadInitialContents(ImageHandle, std::span<const std::byte>);
+  DrawResult Readback(ImageHandle);
+  ImageReadback ReadbackImage(ImageHandle);
+  bool ContentValid(ImageHandle) const;
+  PresentSource BorrowPresentation(ViewHandle, SamplerHandle);
+  bool Terminal() const;
+  FrameCounters Counters() const;
+
+private:
+  struct Impl;
+  std::shared_ptr<Impl> impl_;
+  friend class FrameEncoder;
+  friend class PresentSource;
+};
+// Retains committed source image/view/sampler and its backend until GPU reading
+// completes. Host only; no native window handles or guest pointers are exposed.
+class PresentSource {
+public:
+  PresentSource(PresentSource &&) noexcept;
+  ~PresentSource();
+  PresentSource(const PresentSource &) = delete;
+  NativeSample Sample(uint32_t binding) const;
+  GuestAddress Device() const;
+  uintptr_t DeviceIdentity() const;
+  void CommitRead();
+  void Fail();
+
+private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+  explicit PresentSource(std::unique_ptr<Impl>);
+  friend class FrameImages;
+};
+// A frame records immutable programs, draw state, texture fixtures and UBO
+// versions. Submit preflights the complete graph before any effects, then
+// synchronously waits per draw (5s fence deadline; safe cleanup may require
+// device-idle drain).
+class FrameEncoder {
+public:
+  explicit FrameEncoder(FrameImages &);
+  ~FrameEncoder();
+  FrameEncoder(const FrameEncoder &) = delete;
+  void Draw(const ProgramDescription &, const DrawDescription &,
+            const TargetPass &, std::span<const SampleBinding> = {},
+            FrameRecordFault = FrameRecordFault::None);
+  // Optional diagnostic observer executes after real submission, before fence
+  // wait.
+  void SubmitAndWait(FrameFault = FrameFault::None,
+                     std::function<void()> after_submit = {});
+
+private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+};
+} // namespace native_nvn
