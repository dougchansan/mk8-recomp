+#pragma once
+#include "address_space.h"
+extern "C" {
+#include "recomp_runtime.h"
+}
+#include <array>
+#include <cstdint>
+#include <filesystem>
+#include <functional>
+#include <map>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <vector>
+namespace native {
+struct Module {
+  const char *name;
+  BlockFn (*lookup)(uint64_t);
+  void (*slice)(GuestContext *);
+};
+struct Page {
+  uintptr_t pointer{};
+  uint64_t block{}, address{}, watch{};
+};
+static_assert(sizeof(Page) == 32);
+struct Event {
+  uint64_t address, value;
+  unsigned bytes;
+  bool write;
+};
+struct ProcessLayout {
+  explicit ProcessLayout(uint64_t limit)
+      : aslr_address(0x8000000), aslr_size(limit - 0x8000000) {
+    if (limit != (UINT64_C(1) << 39))
+      throw std::runtime_error("unsupported process address width");
+  }
+  uint64_t aslr_address, aslr_size;
+};
+struct ThreadObject {
+  uint64_t id;
+  int32_t priority;
+  unsigned ideal_core;
+  uint64_t affinity_mask;
+  GuestContext *context;
+  uint64_t tls_address;
+};
+struct HandleResult {
+  uint32_t result, handle;
+};
+class Host {
+public:
+  Host();
+  Host(const Host &) = delete;
+  Host &operator=(const Host &) = delete;
+  Host(Host &&) = delete;
+  Host &operator=(Host &&) = delete;
+  AddressSpace *address_space =
+      nullptr; // Optional sparse bus; owned by the native process.
+  GuestContext context{};
+  RecompHostMem bridge{};
+  std::vector<uint8_t> memory;
+  std::array<Page, 64> table{};
+  std::array<uint8_t, 64> permissions{};
+  std::optional<ProcessLayout> process_layout;
+  std::map<uint32_t, ThreadObject> threads;
+  std::map<uint64_t, std::vector<uint32_t>> condition_waiters;
+  uint32_t current_thread_handle{};
+  std::array<uint64_t, 4> entropy{};
+  bool entropy_available = false;
+  std::function<uint64_t()> counter_override;
+  std::function<void(uint64_t)> sleep_override;
+  std::function<HandleResult(const std::string &)> connect_named_port;
+  std::function<uint32_t(uint32_t, uint64_t)> send_sync_request;
+  std::function<uint32_t(uint32_t)> close_session;
+  std::function<void(const GuestContext &, bool)> svc_observer;
+  bool record_events = true;
+  uint64_t data_reads{}, data_writes{}, instruction_reads{}, slices{}, blocks{},
+      svc_calls{};
+  std::vector<Event> events;
+  std::vector<Module> modules;
+  std::vector<unsigned> allowed_svcs{7, 11, 39};
+  uint64_t ticks{}, sleep_ns{}, reservation{}, reservation_epoch{}, epoch{};
+  uint64_t clock_remainder{};
+  uint64_t last_address{};
+  unsigned last_access_size{};
+  bool last_access_write{};
+  unsigned reservation_size{};
+  std::string output;
+  bool exited{}, interrupt{};
+  void map(uint64_t address, const void *bytes, size_t size,
+           unsigned permission);
+  uint64_t read(uint64_t address, unsigned size, bool instruction = false);
+  void write(uint64_t address, unsigned size, uint64_t value);
+  void dispatch(unsigned budget, unsigned max_slices = 1024);
+  void service();
+  void clear_reservation();
+  void check(uint64_t address, unsigned size, unsigned permission) const;
+  void advance_time(uint64_t nanoseconds);
+  void seal_code();
+  uint32_t register_current_thread(uint64_t id, int32_t priority,
+                                   unsigned core);
+  const ThreadObject *find_thread(uint32_t handle) const;
+
+private:
+  const AddressSpace *sealed_code_space_ = nullptr;
+};
+struct Loaded {
+  std::vector<uint8_t> image;
+  uint64_t program_id{};
+  std::vector<unsigned> allowed_svcs;
+  std::string romfs_name, romfs_data;
+};
+Loaded load_synthetic(const std::filesystem::path &root,
+                      const uint8_t *expected, size_t size);
+} // namespace native
diff --git a/native-runtime/ipc_bridge.cpp b/native-runtime/ipc_bridge.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..97a8e8eb45562b7b6d0891e955c055b5d098c6b0
--- /dev/null
+++ b/native-runtime/ipc_bridge.cpp
@@ -0,0 +1,90 @@
+#include "ipc_bridge.h"
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <stdexcept>
+namespace native {
+namespace {
+bool read_guest(void *user, uint64_t address,
+                std::span<std::byte> destination) {
+  auto &host = *static_cast<Host *>(user);
+  if (destination.size() > (64u << 10) ||
+      address > UINT64_MAX - destination.size())
+    return false;
+  try {
+    for (size_t i = 0; i < destination.size(); i += 8)
+      host.check(address + i,
+                 unsigned(std::min(size_t(8), destination.size() - i)), 1);
+    std::vector<std::byte> bytes(destination.size());
+    for (size_t i = 0; i < destination.size(); i += 8) {
+      auto n = std::min(size_t(8), destination.size() - i);
+      auto value = host.read(address + i, unsigned(n));
+      memcpy(bytes.data() + i, &value, n);
+    }
+    memcpy(destination.data(), bytes.data(), destination.size());
+    return true;
+  } catch (const std::exception &) {
+    return false;
+  }
+}
+bool write_guest(void *user, uint64_t address,
+                 std::span<const std::byte> bytes) {
+  auto &host = *static_cast<Host *>(user);
+  if (bytes.size() > 0x100 || address > UINT64_MAX - bytes.size())
+    return false;
+  try {
+    for (size_t i = 0; i < bytes.size(); i += 8)
+      host.check(address + i, unsigned(std::min(size_t(8), bytes.size() - i)),
+                 2);
+    if (host.record_events)
+      host.events.reserve(host.events.size() + (bytes.size() + 7) / 8);
+    for (size_t i = 0; i < bytes.size(); i += 8) {
+      auto n = std::min(size_t(8), bytes.size() - i);
+      uint64_t value = 0;
+      memcpy(&value, bytes.data() + i, n);
+      host.write(address + i, unsigned(n), value);
+    }
+    return true;
+  } catch (const std::exception &) {
+    return false;
+  }
+}
+uint32_t result(const native_services::Outcome &outcome) {
+  using native_services::Status;
+  switch (outcome.status) {
+  case Status::Ok:
+    return outcome.kernel_result;
+  case Status::InvalidHandle:
+  case Status::InvalidProcess:
+  case Status::InvalidState:
+  case Status::SessionClosed:
+  case Status::Exhausted:
+    if (!outcome.kernel_result)
+      throw std::runtime_error("invalid native IPC error result");
+    return outcome.kernel_result;
+  default:
+    throw std::runtime_error("native IPC bringup: " + outcome.diagnostic);
+  }
+}
+} // namespace
+void attach_services(Host &host, native_services::Router &router,
+                     uint64_t process_id) {
+  if (!process_id)
+    throw std::runtime_error("native IPC process identity unavailable");
+  host.connect_named_port = [&router](const std::string &name) {
+    auto outcome = router.Connect(name);
+    auto status = result(outcome);
+    return HandleResult{status, outcome.handle};
+  };
+  host.send_sync_request = [&host, &router, process_id](uint32_t handle,
+                                                        uint64_t tls) {
+    auto outcome = router.Send(
+        handle, native_services::GuestMemory{&host, read_guest, write_guest},
+        tls, process_id);
+    return result(outcome);
+  };
+  host.close_session = [&router](uint32_t handle) {
+    return result(router.Close(handle));
+  };
+}
+} // namespace native
