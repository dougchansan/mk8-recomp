+import argparse,subprocess,json,os
+from pathlib import Path
+p=argparse.ArgumentParser();p.add_argument('--build',type=Path,required=True);p.add_argument('--native-profile',action='store_true');a=p.parse_args()
+here=Path(__file__).resolve().parent;source=here.parents[1];build=a.build.resolve()
+logs=[]
+def run(command):
+ print(' '.join(map(str,command)),flush=True)
+ result=subprocess.run(list(map(str,command)),capture_output=True,text=True)
+ print(result.stdout,flush=True)
