+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+namespace nx::memory_epoch {
+inline std::atomic<uint64_t> generation{1};
+inline std::atomic<uint32_t> writers{};
+// Every runtime guest-map edit and Win32 reserve/commit/decommit participates.
+// Concurrent or nested writers keep caching disabled until all writers finish.
+struct Mutation {
+    Mutation() { writers.fetch_add(1); generation.fetch_add(1); }
+    ~Mutation() { generation.fetch_add(1); writers.fetch_sub(1); }
+    Mutation(const Mutation&) = delete;
+    Mutation& operator=(const Mutation&) = delete;
+};
+inline uint64_t stable() {
+    const auto value = generation.load(std::memory_order_acquire);
+    if (writers.load(std::memory_order_acquire)) return 0;
+    return generation.load(std::memory_order_acquire) == value ? value : 0;
+}
+}
