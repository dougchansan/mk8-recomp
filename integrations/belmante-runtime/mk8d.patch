+inline std::atomic<uint64_t> present_epoch{0}, lines{0};
+inline thread_local uint64_t submit_id=0, present_id=0;
+inline bool admit() {
+    static const uint64_t limit=[] { const char* e=std::getenv("NX_MEASURE_LIMIT"); return e?std::strtoull(e,nullptr,10):2'000'000ull; }();
+    const auto n=lines.fetch_add(1,std::memory_order_relaxed);
+    if(n==limit) log("measure: truncated limit %llu",(unsigned long long)limit);
+    return n<limit;
+}
+inline void event(const char* kind,uint64_t id,uint64_t start,uint64_t end,uint64_t value=0) {
