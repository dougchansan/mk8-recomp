+template<class Check> void native_bc3_block_probe(Check check) {
+    using namespace nx;
+    using namespace nx::nvn;
+    const auto key = kernel_alloc(256, 4096);
+    auto& texture = make<Texture>(key);
+    texture.target = 8;
+    texture.width = texture.height = 8;
+    texture.depth = 6;
+    texture.levels = 2;
+    texture.format = 0x44;
+    {
+        std::lock_guard lock(gpu_lock());
+        auto* image = image_of(key);
+        check(image && image->image && image->layers == 6 && image->levels == 2);
+        const auto format = view_format(*image, 0x2f);
+        if (format != VK_FORMAT_R32G32B32A32_UINT)
+            std::cerr << "BC3 integer block view rejected: actual Vulkan format=" << format << '\n';
+        check(format == VK_FORMAT_R32G32B32A32_UINT);
+        auto command = frame_begin(false);
+        clears_begin_submit();
+        constexpr uint16_t colours[] = {0xf800, 0x07e0, 0x001f, 0xffff, 0xffe0, 0x07ff};
+        for (unsigned level = 0; level < 2; ++level) {
+            Targets targets{};
+            targets.color_count = 6;
+            VkClearAttachment clear[6]{};
+            for (unsigned face = 0; face < 6; ++face) {
+                targets.colors[face] = key;
+                targets.views.format[face] = 0x2f;
+                targets.views.level[face] = level;
+                targets.views.layer[face] = face;
+                clear[face].aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+                clear[face].colorAttachment = face;
+                const uint32_t endpoint = colours[(face + level) % 6];
+                clear[face].clearValue.color.uint32[0] = 0x0000ffff;
+                clear[face].clearValue.color.uint32[2] = endpoint | (endpoint << 16);
+            }
+            pass_begin(command, targets);
+            const uint32_t extent = 2 >> level;
+            check(pass_extent().width == extent && pass_extent().height == extent);
+            VkClearRect rectangle{};
+            rectangle.rect.extent = {extent, extent};
+            rectangle.layerCount = 1;
+            vk::p_vkCmdClearAttachments(command, 6, clear, 1, &rectangle);
+            pass_mark_written(0x3f);
+            draw_end_rendering(command);
+        }
+        check(image->rendered && !image->uploaded && texture.memory == 0);
+        const auto readback = upload_alloc(480, 16);
+        transition(command, *image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+        VkBufferImageCopy copies[12]{};
+        uint32_t offset = 0;
+        for (unsigned level = 0; level < 2; ++level) {
+            const uint32_t extent = 8 >> level;
+            const uint32_t bytes = level ? 16 : 64;
+            for (unsigned face = 0; face < 6; ++face) {
+                auto& copy = copies[level * 6 + face];
+                copy.bufferOffset = readback.offset + offset;
+                copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, level, face, 1};
+                copy.imageExtent = {extent, extent, 1};
+                offset += bytes;
+            }
+        }
+        check(offset == 480);
+        vk::p_vkCmdCopyImageToBuffer(command, image->image,
+            VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, readback.buffer, 12, copies);
+        VkBufferMemoryBarrier barrier{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+        barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+        barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+        barrier.srcQueueFamilyIndex = barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        barrier.buffer = readback.buffer;
+        barrier.offset = readback.offset;
+        barrier.size = 480;
+        vk::p_vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TRANSFER_BIT,
+            VK_PIPELINE_STAGE_HOST_BIT, 0, 0, nullptr, 1, &barrier, 0, nullptr);
+        frame_submit(VK_NULL_HANDLE, VK_NULL_HANDLE, {}, true);
+        offset = 0;
+        for (unsigned level = 0; level < 2; ++level) {
+            for (unsigned face = 0; face < 6; ++face) {
+                const uint32_t endpoint = colours[(face + level) % 6];
+                const uint32_t expected[] = {0x0000ffff, 0, endpoint | (endpoint << 16), 0};
+                for (unsigned block = 0; block < (level ? 1u : 4u); ++block) {
+                    for (unsigned word = 0; word < 4; ++word) {
+                        uint32_t actual = 0;
+                        std::memcpy(&actual, readback.ptr + offset, sizeof actual);
+                        check(actual == expected[word]);
+                        offset += 4;
+                    }
+                }
+            }
+        }
+        check(offset == 480);
+    }
+    native_bc3_sample_probe(key, check);
+    native_bc3_snapshot_probe(key, check);
+    destroy(key);
+}
