+  Require(d.format == ImageFormat::Rgba8Unorm ||
+              d.format == ImageFormat::A2B10G10R10Unorm ||
+              !(d.usage & ColorTarget),
+          "Only linear RGBA8 or packed10 targets supported");
+  const auto support = QueryImageSupport(i.resources, i.key, d.format, d.usage);
+  const auto caps = i.device_lease.Backend().GetCapabilities();
+  Require(d.width <= caps.max_image_dimension_2d &&
+              d.height <= caps.max_image_dimension_2d &&
+              d.width <= support.max_width && d.height <= support.max_height,
+          "Image device dimensions unsupported");
+  Require(uint64_t(d.width) * d.height * ImageBytesPerTexel(d.format) <=
+              i.allocation_budget,
+          "Image byte budget exceeded");
+  Require(d.backing.offset <= UINT64_MAX - d.backing.size,
+          "Backing range overflow");
+  Require(d.backing.identity ||
+              (!d.backing.generation && !d.backing.offset && !d.backing.size),
+          "Backing metadata requires physical identity");
+  if (d.backing.identity) {
+    Require(d.backing.generation &&
+                d.backing.size ==
+                    uint64_t(d.width) * d.height * ImageBytesPerTexel(d.format),
+            "Invalid backing identity/extent");
+    for (auto &[id, img] : i.images) {
+      auto &b = img.d.backing;
+      if (b.identity != d.backing.identity ||
+          b.generation != d.backing.generation)
+        continue;
+      bool overlap = b.offset < d.backing.offset + d.backing.size &&
+                     d.backing.offset < b.offset + b.size;
+      if (overlap) {
+        Require(b.offset == d.backing.offset && b.size == d.backing.size &&
+                    Same(img.d, d),
+                "Partial/incompatible backing alias");
+        return {id};
+      }
+    }
+  }
+  Impl::Image image;
+  image.d = d;
+  VkImageCreateInfo ci{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+  ci.imageType = VK_IMAGE_TYPE_2D;
+  ci.format = VkFormat(NativeImageFormat(d.format));
+  ci.extent = {d.width, d.height, 1};
+  ci.mipLevels = ci.arrayLayers = 1;
+  ci.samples = VK_SAMPLE_COUNT_1_BIT;
+  ci.tiling = VK_IMAGE_TILING_OPTIMAL;
+  ci.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  if (d.usage & ColorTarget)
+    ci.usage |= VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+  if (d.usage & Sampled)
+    ci.usage |= VK_IMAGE_USAGE_SAMPLED_BIT;
+  if (d.usage & TransferSource)
+    ci.usage |= VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+  if (d.usage & TransferDestination)
+    ci.usage |= VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+  Check(i.F(vkCreateImage)(i.device, &ci, nullptr, &image.image),
+        "Create persistent image");
+  try {
+    VkMemoryRequirements req{};
+    i.F(vkGetImageMemoryRequirements)(i.device, image.image, &req);
+    Require(req.size <= i.allocation_budget - i.allocated_bytes &&
+                req.size <= support.max_resource_size,
+            "Image allocation budget exceeded");
+    image.allocation_size = req.size;
+    image.memory = i.Allocate(req, 0);
+    Check(i.F(vkBindImageMemory)(i.device, image.image, image.memory, 0),
+          "Bind persistent image");
+  } catch (...) {
+    i.F(vkDestroyImage)(i.device, image.image, nullptr);
+    if (image.memory)
+      i.F(vkFreeMemory)(i.device, image.memory, nullptr);
+    throw;
+  }
+  auto id = NewHandle();
+  try {
+    i.images.emplace(id, image);
+  } catch (...) {
+    i.F(vkDestroyImage)(i.device, image.image, nullptr);
+    i.F(vkFreeMemory)(i.device, image.memory, nullptr);
+    throw;
+  }
+  i.allocated_bytes += image.allocation_size;
+  return {id};
+}
+ViewHandle FrameImages::CreateView(ImageHandle h, const ViewDescription &d) {
+  auto &i = *impl_;
+  i.Ready();
+  auto &img = i.Get(h);
+  Require(d.format == img.d.format && d.mip == 0 && d.mips == 1 &&
+              d.layer == 0 && d.layers == 1,
+          "Unsupported image view interpretation/subresources");
+  VkImageViewCreateInfo ci{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+  ci.image = img.image;
+  ci.viewType = VK_IMAGE_VIEW_TYPE_2D;
+  ci.format = VkFormat(NativeImageFormat(d.format));
+  ci.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+  auto component = [](ViewDescription::Component c) {
+    switch (c) {
+    case ViewDescription::Component::Zero:
+      return VK_COMPONENT_SWIZZLE_ZERO;
+    case ViewDescription::Component::One:
+      return VK_COMPONENT_SWIZZLE_ONE;
+    case ViewDescription::Component::R:
+      return VK_COMPONENT_SWIZZLE_R;
+    case ViewDescription::Component::G:
+      return VK_COMPONENT_SWIZZLE_G;
+    case ViewDescription::Component::B:
+      return VK_COMPONENT_SWIZZLE_B;
+    case ViewDescription::Component::A:
+      return VK_COMPONENT_SWIZZLE_A;
+    }
+    throw std::runtime_error("Unsupported component swizzle");
+  };
+  for (auto c : d.swizzle)
+    component(c);
+  const std::array identity{
+      ViewDescription::Component::R, ViewDescription::Component::G,
+      ViewDescription::Component::B, ViewDescription::Component::A};
+  if (d.swizzle != identity)
+    ci.components = {component(d.swizzle[0]), component(d.swizzle[1]),
+                     component(d.swizzle[2]), component(d.swizzle[3])};
+  VkImageView v{};
+  Check(i.F(vkCreateImageView)(i.device, &ci, nullptr, &v),
+        "Create persistent view");
+  auto id = NewHandle();
+  try {
+    i.views.emplace(id, Impl::View{h.value, v, 0, d});
+  } catch (...) {
+    i.F(vkDestroyImageView)(i.device, v, nullptr);
+    throw;
+  }
+  ++img.views;
+  return {id};
+}
+SamplerHandle FrameImages::CreateSampler(const SamplerDescription &d) {
+  auto &i = *impl_;
+  i.Ready();
+  Require(d.nearest && d.clamp && !d.compare && d.min_lod == 0 &&
+              d.max_lod == 0,
+          "Unsupported/conflicting legacy sampler state");
+  const auto state = d.state.value_or(SamplerState{});
+  ValidateSamplerState(state, i.device_lease.Backend().GetCapabilities());
+  VkSamplerCreateInfo ci{VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};
+  ci.minFilter =
+      state.min == TextureFilter::Linear ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+  ci.magFilter =
+      state.mag == TextureFilter::Linear ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+  ci.mipmapMode = state.mip == MipmapFilter::Linear
+                      ? VK_SAMPLER_MIPMAP_MODE_LINEAR
+                      : VK_SAMPLER_MIPMAP_MODE_NEAREST;
+  auto address = [](AddressMode a) {
+    return a == AddressMode::Repeat ? VK_SAMPLER_ADDRESS_MODE_REPEAT
+                                    : VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+  };
+  ci.addressModeU = address(state.u);
+  ci.addressModeV = address(state.v);
+  ci.addressModeW = address(state.w);
+  ci.minLod = state.min_lod;
+  ci.maxLod = state.max_lod;
+  ci.mipLodBias = state.bias;
+  VkSampler s{};
+  Check(i.F(vkCreateSampler)(i.device, &ci, nullptr, &s),
+        "Create persistent sampler");
+  auto id = NewHandle();
+  try {
+    i.samplers.emplace(id, Impl::Sampler{s, 0, state});
+  } catch (...) {
+    i.F(vkDestroySampler)(i.device, s, nullptr);
+    throw;
+  }
+  return {id};
+}
+void FrameImages::DestroyImage(ImageHandle h) {
+  auto &i = *impl_;
+  i.Owner();
+  auto &v = i.Get(h);
+  Require(!v.references && !v.views, "Image retained by views/frame");
+  i.F(vkDestroyImage)(i.device, v.image, nullptr);
+  i.F(vkFreeMemory)(i.device, v.memory, nullptr);
+  i.allocated_bytes -= v.allocation_size;
+  i.images.erase(h.value);
+}
+void FrameImages::DestroyView(ViewHandle h) {
+  auto &i = *impl_;
+  i.Owner();
+  auto &v = i.Get(h);
+  Require(!v.references, "View retained by frame");
+  i.F(vkDestroyImageView)(i.device, v.view, nullptr);
+  --i.images.at(v.image).views;
+  i.views.erase(h.value);
+}
+void FrameImages::DestroySampler(SamplerHandle h) {
+  auto &i = *impl_;
+  i.Owner();
+  auto &s = i.Get(h);
+  Require(!s.references, "Sampler retained by frame");
+  i.F(vkDestroySampler)(i.device, s.sampler, nullptr);
+  i.samplers.erase(h.value);
+}
+void FrameImages::UploadInitialContents(ImageHandle h,
+                                        std::span<const std::byte> b) {
+  auto &i = *impl_;
+  auto &img = i.Get(h);
+  Require(b.size() == uint64_t(img.d.width) * img.d.height *
+                          ImageBytesPerTexel(img.d.format),
+          "Image upload extent mismatch");
+  std::vector<std::byte> copy(b.begin(), b.end());
+  i.Transfer(img, copy, true);
+}
+ImageReadback FrameImages::ReadbackImage(ImageHandle h) {
+  auto &i = *impl_;
+  auto &img = i.Get(h);
+  const uint64_t row = uint64_t(img.d.width) * ImageBytesPerTexel(img.d.format);
+  ImageReadback out{img.d.format, img.d.width, img.d.height, row,
+                    std::vector<std::byte>(row * img.d.height)};
+  i.Transfer(img, out.bytes, false);
+  return out;
+}
+DrawResult FrameImages::Readback(ImageHandle h) {
+  Require(impl_->Get(h).d.format == ImageFormat::Rgba8Unorm,
+          "Legacy RGBA8 readback requires linear RGBA8 format");
+  auto typed = ReadbackImage(h);
+  return {typed.width, typed.height, std::move(typed.bytes)};
+}
+bool FrameImages::ContentValid(ImageHandle h) const {
+  return impl_->Get(h).committed_valid;
+}
+bool FrameImages::Terminal() const {
+  impl_->Owner();
+  return impl_->terminal;
+}
+FrameCounters FrameImages::Counters() const {
+  impl_->Owner();
+  return impl_->counters;
+}
+struct PresentSource::Impl {
+  std::shared_ptr<FrameImages::Impl> owner;
+  ViewHandle view;
+  SamplerHandle sampler;
+  uint64_t image;
+  Impl(std::shared_ptr<FrameImages::Impl> o, ViewHandle v, SamplerHandle s)
+      : owner(std::move(o)), view(v), sampler(s) {
+    owner->Ready();
+    auto &vw = owner->Get(v);
+    auto &im = owner->images.at(vw.image);
+    owner->Get(s);
+    Require(im.committed_valid && (im.d.usage & Sampled),
+            "Presentation source undefined/not sampled");
+    Require(im.d.format == ImageFormat::Rgba8Unorm ||
+                im.d.format == ImageFormat::A2B10G10R10Unorm,
+            "Presentation requires linear RGBA8 or packed10 source");
+    image = vw.image;
+    ++vw.references;
+    ++im.references;
+    ++owner->Get(s).references;
+  }
+  ~Impl() {
+    owner->Owner();
+    --owner->Get(view).references;
+    --owner->Get(sampler).references;
+    --owner->images.at(image).references;
+  }
+};
+PresentSource::PresentSource(std::unique_ptr<Impl> p) : impl_(std::move(p)) {}
+PresentSource::PresentSource(PresentSource &&) noexcept = default;
+PresentSource::~PresentSource() = default;
+PresentSource FrameImages::BorrowPresentation(ViewHandle v, SamplerHandle s) {
+  return PresentSource(std::make_unique<PresentSource::Impl>(impl_, v, s));
+}
+NativeSample PresentSource::Sample(uint32_t binding) const {
+  Require(bool(impl_), "Moved presentation source");
+  impl_->owner->Ready();
+  const auto &image = impl_->owner->images.at(impl_->image);
+  Require(image.committed_valid && (image.d.usage & Sampled),
+          "Presentation source invalidated/undefined");
+  return impl_->owner->Sample({binding, impl_->view, impl_->sampler});
+}
+GuestAddress PresentSource::Device() const {
+  Require(bool(impl_), "Moved presentation source");
+  impl_->owner->Owner();
+  return impl_->owner->key;
+}
+uintptr_t PresentSource::DeviceIdentity() const {
+  Require(bool(impl_), "Moved presentation source");
+  impl_->owner->Owner();
+  return impl_->owner->handles.device;
+}
+void PresentSource::CommitRead() {
+  Require(bool(impl_), "Moved presentation source");
+  impl_->owner->Owner();
+  impl_->owner->images.at(impl_->image).committed_layout =
+      VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+}
+void PresentSource::Fail() {
+  Require(bool(impl_), "Moved presentation source");
+  impl_->owner->Owner();
+  impl_->owner->terminal = true;
+  impl_->owner->images.at(impl_->image).committed_valid = false;
+}
+struct FrameEncoder::Impl {
+  struct Record {
+    std::vector<uint32_t> vertex, fragment;
+    std::vector<DescriptorPlan> plan;
+    DrawDescription draw;
+    TargetPass pass;
+    std::vector<SampleBinding> samples;
+    std::vector<UniformBinding> uniforms;
+    std::vector<Texture2D> textures;
+    std::vector<std::vector<std::byte>> texture_data, uniform_data;
+  };
+  std::shared_ptr<FrameImages::Impl> retained_owner;
+  FrameImages::Impl &owner;
+  std::vector<std::unique_ptr<Record>> records;
+  std::set<uint64_t> images, views, samplers;
+  struct PinnedBuffer {
+    GuestAddress key;
+    Resources::Lease lease;
+  };
+  std::vector<PinnedBuffer> buffer_leases;
+  bool finished = false;
+  uint64_t snapshot_bytes = 0;
+  explicit Impl(std::shared_ptr<FrameImages::Impl> o)
+      : retained_owner(std::move(o)), owner(*retained_owner) {
+    owner.Ready();
+    ++owner.encoders;
+  }
+  void Retain(ViewHandle h) {
+    auto &v = owner.Get(h);
+    if (views.insert(h.value).second)
+      ++v.references;
+    if (images.insert(v.image).second)
+      ++owner.images.at(v.image).references;
+  }
+  void Release() {
+    for (auto h : views)
+      --owner.views.at(h).references;
+    for (auto h : images)
+      --owner.images.at(h).references;
+    for (auto h : samplers)
+      --owner.samplers.at(h).references;
+    views.clear();
+    images.clear();
+    samplers.clear();
+    buffer_leases.clear();
+  }
+  ~Impl() {
+    Release();
+    --owner.encoders;
+  }
+};
+FrameEncoder::FrameEncoder(FrameImages &o)
+    : impl_(std::make_unique<Impl>(o.impl_)) {}
+FrameEncoder::~FrameEncoder() = default;
+void FrameEncoder::Draw(const ProgramDescription &p,
+                        const DrawDescription &draw, const TargetPass &pass,
+                        std::span<const SampleBinding> samples,
+                        FrameRecordFault fault) {
+  auto &f = *impl_;
+  auto &o = f.owner;
+  o.Ready();
+  Require(!f.finished && f.records.size() < 1024, "Frame finished/too large");
+  auto &target = o.images.at(o.Get(pass.view).image);
+  Require(o.Get(pass.view).description.swizzle == ViewDescription{}.swizzle,
+          "Attachment view swizzle unsupported");
+  Require(draw.width == target.d.width && draw.height == target.d.height &&
+              (target.d.usage & ColorTarget) &&
+              (target.d.usage & TransferSource),
+          "Target extent/usage mismatch");
+  std::vector<NativeSample> native;
+  for (auto &s : samples) {
+    auto &v = o.Get(s.view);
+    auto &image = o.images.at(v.image);
+    Require((image.d.usage & Sampled) && v.image != o.Get(pass.view).image,
+            "Image feedback/sample usage unsupported");
+    native.push_back(o.Sample(s));
+  }
+  ValidateDraw(o.resources, o.key, p, draw, native, target.d.format);
+  uint64_t bytes = uint64_t(p.vertex.size() + p.fragment.size()) * 4;
+  for (const auto &u : draw.uniforms)
+    bytes += u.size;
+  for (const auto &t : draw.textures)
+    bytes += t.rgba8.size();
+  constexpr uint64_t MaximumSnapshotBytes = 64ull << 20;
+  Require(bytes <= MaximumSnapshotBytes - f.snapshot_bytes,
+          "Frame snapshot memory bound exceeded");
+  auto r = std::make_unique<Impl::Record>();
+  r->vertex.assign(p.vertex.begin(), p.vertex.end());
+  r->fragment.assign(p.fragment.begin(), p.fragment.end());
+  r->plan.assign(p.set0.begin(), p.set0.end());
+  r->draw = draw;
+  r->pass = pass;
+  r->samples.assign(samples.begin(), samples.end());
+  r->uniforms.assign(draw.uniforms.begin(), draw.uniforms.end());
+  r->textures.assign(draw.textures.begin(), draw.textures.end());
+  for (auto &u : r->uniforms) {
+    r->uniform_data.emplace_back(u.size);
+    o.resources.Backend(o.key).Download(o.resources.View(u.buffer), u.offset,
+                                        r->uniform_data.back());
+  }
+  for (auto &t : r->textures)
+    r->texture_data.emplace_back(t.rgba8.begin(), t.rgba8.end());
+  for (size_t i = 0; i < r->textures.size(); ++i)
+    r->textures[i].rgba8 = r->texture_data[i];
+  r->draw.uniforms = r->uniforms;
+  r->draw.textures = r->textures;
+  // Identity and ownership are one record. Stage all newly acquired leases;
+  // failures cannot publish a key without its corresponding owning lease.
+  std::vector<Impl::PinnedBuffer> staged;
+  auto pin = [&](GuestAddress key) {
+    for (const auto &p : f.buffer_leases)
+      if (p.key == key)
+        return;
+    for (const auto &p : staged)
+      if (p.key == key)
+        return;
+    if (fault == FrameRecordFault::AcquireBufferPin)
+      throw std::runtime_error("Injected buffer lease acquisition failure");
+    auto lease = o.resources.PinBuffer(key);
+    if (fault == FrameRecordFault::PublishBufferPin)
+      throw std::runtime_error(
+          "Injected buffer lease publication allocation failure");
+    staged.push_back({key, std::move(lease)});
+  };
+  if (!draw.procedural_triangle)
+    pin(draw.vertices);
+  if (draw.index_format != IndexFormat::None)
+    pin(draw.indices);
+  f.buffer_leases.reserve(f.buffer_leases.size() + staged.size());
+  for (auto &pin_record : staged)
+    f.buffer_leases.push_back(std::move(pin_record));
+  f.Retain(pass.view);
+  for (auto &s : samples) {
+    f.Retain(s.view);
+    auto &sampler = o.Get(s.sampler);
+    if (f.samplers.insert(s.sampler.value).second)
+      ++sampler.references;
+  }
+  f.records.push_back(std::move(r));
+  f.snapshot_bytes += bytes;
+  ++o.counters.recorded;
+}
+void FrameEncoder::SubmitAndWait(FrameFault fault,
+                                 std::function<void()> after_submit) {
+  auto &f = *impl_;
+  auto &o = f.owner;
+  o.Ready();
+  Require(!f.finished && !f.records.empty(), "Frame finished/empty");
+  struct State {
+    VkImageLayout layout;
+    bool valid;
+  };
+  std::map<uint64_t, State> planned;
+  for (auto id : f.images) {
+    auto &i = o.images.at(id);
+    planned[id] = {i.committed_layout, i.committed_valid};
+  }
+  // Pure graph preflight: never mutate committed layouts/content while
+  // recording.
+  for (auto &r : f.records) {
+    auto target = o.Get(r->pass.view).image;
+    auto &s = planned.at(target);
+    Require(r->pass.load != AttachmentLoad::Load || s.valid,
+            "Load of undefined contents");
+    Require(r->pass.load == AttachmentLoad::Load ||
+                r->pass.load == AttachmentLoad::Clear ||
+                r->pass.load == AttachmentLoad::Discard,
+            "Invalid attachment load");
+    Require(r->pass.store == AttachmentStore::Store ||
+                r->pass.store == AttachmentStore::Discard,
+            "Invalid attachment store");
+    for (auto &sample : r->samples) {
+      auto id = o.Get(sample.view).image;
+      Require(id != target && planned.at(id).valid,
+              "Sampling undefined/feedback contents");
+      planned.at(id).layout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    }
+    s.valid = r->pass.store == AttachmentStore::Store &&
+              (r->pass.load == AttachmentLoad::Clear ||
+               (r->pass.load == AttachmentLoad::Load && s.valid));
+    s.layout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    std::vector<NativeSample> native;
+    for (auto &sample : r->samples)
+      native.push_back(o.Sample(sample));
+    ValidateDraw(o.resources, o.key, {r->vertex, r->fragment, r->plan}, r->draw,
+                 native, o.images.at(target).d.format);
+  }
+  if (fault == FrameFault::BeforeSubmit) {
+    ++o.counters.failures;
+    throw std::runtime_error(
+        "Injected pre-submit failure; committed state unchanged");
+  }
+  struct SubmissionScope {
+    bool &active;
+    explicit SubmissionScope(bool &v) : active(v) { active = true; }
+    ~SubmissionScope() { active = false; }
+  } submission(o.submitting);
+  bool any_attempt = false;
+  try {
+    for (auto &r : f.records) {
+      auto &view = o.Get(r->pass.view);
+      auto &image = o.images.at(view.image);
+      std::vector<NativeSample> native;
+      for (auto &s : r->samples)
+        native.push_back(o.Sample(s));
+      std::vector<UniformSnapshot> snapshots;
+      for (size_t n = 0; n < r->uniforms.size(); ++n)
+        snapshots.push_back({r->uniforms[n].binding, r->uniform_data[n]});
+      bool attempted = false, accepted = false;
+      NativeTarget target{reinterpret_cast<uintptr_t>(image.image),
+                          reinterpret_cast<uintptr_t>(view.view),
+                          uint32_t(image.committed_layout),
+                          r->pass.load,
+                          r->pass.store,
+                          {r->pass.clear[0], r->pass.clear[1], r->pass.clear[2],
+                           r->pass.clear[3]},
+                          &attempted,
+                          &accepted};
+      target.format = image.d.format;
+      if (after_submit) {
+        target.after_submit = [](void *p) {
+          (*static_cast<std::function<void()> *>(p))();
+        };
+        target.observer = &after_submit;
+      }
+      target.fault =
+          fault == FrameFault::SubmitFailure ? NativeDrawFault::Submit
+          : fault == FrameFault::Timeout     ? NativeDrawFault::FenceTimeout
+          : fault == FrameFault::DeviceLoss  ? NativeDrawFault::DeviceLost
+                                             : NativeDrawFault::None;
+      try {
+        DrawIntoTarget(o.resources, o.key, {r->vertex, r->fragment, r->plan},
+                       r->draw, target, native, snapshots);
+      } catch (...) {
+        any_attempt |= attempted;
+        if (accepted)
+          ++o.counters.submitted;
+        throw;
+      }
+      any_attempt |= attempted;
+      ++o.counters.submitted;
+      for (auto &s : r->samples)
+        o.images.at(o.Get(s.view).image).committed_layout =
+            VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+      image.committed_layout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+      image.committed_valid =
+          r->pass.store == AttachmentStore::Store &&
+          (r->pass.load == AttachmentLoad::Clear ||
+           (r->pass.load == AttachmentLoad::Load && image.committed_valid));
+      ++o.counters.completed;
+    }
+    f.finished = true;
+    f.Release();
+  } catch (...) {
+    ++o.counters.failures;
+    if (any_attempt) {
+      o.terminal = true;
+      for (auto id : f.images)
+        o.images.at(id).committed_valid = false;
+      f.finished = true;
+      f.Release();
+    }
+    throw;
+  }
+}
+} // namespace native_nvn
