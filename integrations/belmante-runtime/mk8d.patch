+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace nx::nvn {
+inline bool native_point_size_supported(float size, bool large, float minimum, float maximum) {
+    return std::isfinite(size) && size > 0 && size >= minimum && size <= maximum && (large || size == 1.0f);
+}
+
+// Adapt an offline vertex module to NVN's fixed point size only when the
+// original program has no programmable PointSize output. No title ISA is decoded.
+inline bool patch_fixed_point_size(const std::vector<uint32_t>& input, float size,
+                                  std::vector<uint32_t>& output, bool* injected = nullptr) {
+    output.clear();
+    if (injected) *injected = false;
+    if (!std::isfinite(size) || size <= 0 || input.size() < 5 || input[0] != 0x07230203 ||
+        !input[3] || input[3] > UINT32_MAX - 4) return false;
+    size_t annotations = 0, declarations = 0, entry_offset = 0;
+    uint32_t entry = 0, function = 0, float_type = 0, entries = 0, returns = 0;
+    bool point_output = false;
+    for (size_t at = 5; at < input.size();) {
+        const uint32_t length = input[at] >> 16, op = input[at] & 0xffff;
+        if (!length || length > input.size() - at) return false;
+        if (op == 15) { // OpEntryPoint
+            if (length < 4 || input[at + 1] != 0 || ++entries != 1) return false;
+            entry = input[at + 2]; entry_offset = at;
+        }
+        if (!annotations && op >= 19 && op <= 39) annotations = at;
+        if (op == 22 && length == 3 && input[at + 2] == 32) float_type = input[at + 1];
+        if ((op == 71 && length >= 4 && input[at + 2] == 11 && input[at + 3] == 1) ||
+            (op == 72 && length >= 5 && input[at + 3] == 11 && input[at + 4] == 1)) point_output = true;
+        if (op == 54) { // OpFunction
+            if (length != 5 || function) return false;
+            if (!declarations) declarations = at;
+            function = input[at + 2];
+        }
+        if (op == 253 && function == entry) { if (length != 1) return false; ++returns; }
+        if (op == 254 && function == entry) return false;
+        if (op == 56) { if (length != 1 || !function) return false; function = 0; }
+        at += length;
+    }
+    if (entries != 1 || !entry || entry >= input[3] || !annotations || !declarations || !returns || function)
+        return false;
+    if (point_output) { output = input; return true; }
+    uint32_t next = input[3];
+    std::vector<uint32_t> globals;
+    if (!float_type) {
+        float_type = next++;
+        globals.insert(globals.end(), {(3u << 16) | 22u, float_type, 32});
+    }
+    const uint32_t pointer = next++, constant = next++, variable = next++;
+    uint32_t bits; std::memcpy(&bits, &size, sizeof bits);
+    globals.insert(globals.end(), {(4u << 16) | 32u, pointer, 3, float_type,
+        (4u << 16) | 43u, float_type, constant, bits,
+        (4u << 16) | 59u, pointer, variable, 3});
+    output.assign(input.begin(), input.begin() + 5); output[3] = next;
+    function = 0;
+    for (size_t at = 5; at < input.size();) {
+        const uint32_t length = input[at] >> 16, op = input[at] & 0xffff;
+        if (at == annotations) output.insert(output.end(), {(4u << 16) | 71u, variable, 11, 1});
+        if (at == declarations) output.insert(output.end(), globals.begin(), globals.end());
+        if (op == 54) function = input[at + 2];
+        if (op == 253 && function == entry) output.insert(output.end(), {(3u << 16) | 62u, variable, constant});
+        if (at == entry_offset) {
+            if (length == 0xffff) { output.clear(); return false; }
+            output.push_back(((length + 1) << 16) | op);
+            output.insert(output.end(), input.begin() + at + 1, input.begin() + at + length);
+            output.push_back(variable);
+        } else output.insert(output.end(), input.begin() + at, input.begin() + at + length);
+        if (op == 56) function = 0;
+        at += length;
+    }
+    if (injected) *injected = true;
+    return true;
+}
+}
