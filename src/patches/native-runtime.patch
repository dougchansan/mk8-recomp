--- /dev/null
+++ b/native-runtime/graphics/probe.cpp
@@ -0,0 +1,18 @@
+#include "native_graphics.h"
+#include <iostream>
+int main() {
+  auto r = native_graphics::RunOffscreenTriangle();
+  std::cout << "{\"passed\":" << (r.passed ? "true" : "false")
+            << ",\"device\":\"" << r.device
+            << "\",\"vendor_id\":" << r.vendor_id
+            << ",\"device_id\":" << r.device_id
+            << ",\"driver_version\":" << r.driver_version
+            << ",\"api_version\":" << r.api_version
+            << ",\"draw_count\":" << r.draw_count
+            << ",\"red_pixels\":" << r.red_pixels
+            << ",\"black_pixels\":" << r.black_pixels
+            << ",\"center_rgba\":" << r.center_rgba
+            << ",\"corner_rgba\":" << r.corner_rgba << ",\"error\":\""
+            << r.error << "\"}\n";
+  return r.passed ? 0 : 1;
+}
diff --git a/native-runtime/graphics/resource_test.cpp b/native-runtime/graphics/resource_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..46b745c778c737679961bcfb0fd6c26df44f9e4f
--- /dev/null
+++ b/native-runtime/graphics/resource_test.cpp
@@ -0,0 +1,98 @@
+#include "vulkan_resources.h"
+#include <array>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <thread>
+using namespace native_graphics;
+int main() {
+  try {
+    unsigned rejected = 0;
+    auto reject = [&](auto action) {
+      try {
+        action();
+      } catch (const std::runtime_error &) {
+        ++rejected;
+        return;
+      }
+      throw std::runtime_error("Expected strict resource error was not raised");
+    };
+    reject([] { VulkanDevice bad({false, false, 1}); });
+    VulkanDevice device({true, true, 0});
+    auto pool = device.CreatePool(4097);
+    auto info = device.GetPoolInfo(pool);
+    auto view = device.CreateView(pool, 17, 4096 - 17);
+    auto alias = device.CreateView(pool, 17, 64);
+    std::array<std::byte, 64> source{}, destination{};
+    for (size_t i = 0; i < source.size(); ++i)
+      source[i] = std::byte(i ^ 0x5a);
+    device.Upload(view, 0, source);
+    device.Flush(view, 1, 31);
+    device.Invalidate(view, 1, 31);
+    device.Download(alias, 0, destination);
+    if (source != destination)
+      throw std::runtime_error("Mapped Vulkan buffer roundtrip mismatch");
+    auto binding = device.GetBufferBinding(view);
+    auto handles = device.GetNativeHandles();
+    if (!binding.native_buffer || binding.offset != 17 ||
+        binding.size != 4079 || !handles.device || !handles.queue)
+      throw std::runtime_error("Invalid native buffer/device interop");
+    const auto address = device.GetDeviceAddress(view);
+    if (!info.device_address || address - info.device_address != 17)
+      throw std::runtime_error("Real Vulkan buffer address offset mismatch");
+    reject([&] { device.DestroyPool(pool); });
+    reject([&] { device.CreateView(pool, UINT64_MAX, 1); });
+    reject([&] { device.CreateView(pool, 4096, 2); });
+    reject([&] { device.CreateView(pool, 0, 0); });
+    reject([&] { device.Upload(alias, 63, source); });
+    reject([&] { device.Download(alias, UINT64_MAX, destination); });
+    reject([&] { device.Flush(alias, UINT64_MAX, 1); });
+    reject([&] { device.Invalidate(alias, 0, 65); });
+    reject([&] { device.CreatePool(0); });
+    reject([&] { device.CreatePool(32, 1); });
+    bool thread_rejected = false;
+    std::thread other([&] {
+      try {
+        device.GetPoolInfo(pool);
+      } catch (const std::runtime_error &) {
+        thread_rejected = true;
+      }
+    });
+    other.join();
+    if (!thread_rejected)
+      throw std::runtime_error("Owner thread contract not enforced");
+    VulkanDevice second;
+    reject([&] { second.GetPoolInfo(pool); });
+    auto p2 = second.CreatePool(64);
+    auto v2 = second.CreateView(p2, 0, 64);
+    reject([&] { second.GetDeviceAddress(v2); });
+    second.DestroyView(v2);
+    second.DestroyPool(p2);
+    device.DestroyView(alias);
+    reject([&] { device.DestroyView(alias); });
+    device.DestroyView(view);
+    reject([&] { device.Upload(view, 0, source); });
+    device.DestroyPool(pool);
+    reject([&] { device.DestroyPool(pool); });
+    reject([&] { device.GetPoolInfo(pool); });
+    // Device teardown also owns cleanup for intentionally retained pools/views.
+    {
+      VulkanDevice cleanup;
+      auto p = cleanup.CreatePool(256);
+      cleanup.CreateView(p, 0, 128);
+    }
+    std::cout << "{\"passed\":true,\"device\":\"" << device.DeviceName()
+              << "\",\"pool_bytes\":" << info.size
+              << ",\"enabled_shader_image_gather_extended\":"
+              << (handles.enabled_shader_image_gather_extended ? "true"
+                                                               : "false")
+              << ",\"coherent\":" << (info.coherent ? "true" : "false")
+              << ",\"real_device_address\":" << address
+              << ",\"rejected_operations\":" << rejected
+              << ",\"thread_rejected\":true,\"roundtrip_bytes\":64}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
diff --git a/native-runtime/graphics/vulkan_resources.cpp b/native-runtime/graphics/vulkan_resources.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0c3b5010d4aadb71836dbc4a60dd701c2f02d414
--- /dev/null
+++ b/native-runtime/graphics/vulkan_resources.cpp
@@ -0,0 +1,393 @@
+#include "vulkan_resources.h"
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#define VK_NO_PROTOTYPES
+#include <atomic>
+#include <cstring>
+#include <limits>
+#include <map>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+#include <vulkan/vulkan.h>
+#include <windows.h>
+namespace native_graphics {
+namespace {
+void Check(VkResult r, const char *what) {
+  if (r != VK_SUCCESS)
+    throw std::runtime_error(std::string(what) +
+                             ": VkResult=" + std::to_string(r));
+}
+void Range(uint64_t total, uint64_t offset, uint64_t size) {
+  if (offset > total || size > total - offset)
+    throw std::runtime_error("Resource range out of bounds");
+}
+std::atomic<uint64_t> next_handle{1};
+uint64_t Handle() {
+  auto h = next_handle.fetch_add(1);
+  if (!h)
+    throw std::runtime_error("Resource handle space exhausted");
+  return h;
+}
+} // namespace
+struct VulkanDevice::Impl {
+  struct Pool {
+    VkBuffer buffer{};
+    VkDeviceMemory memory{};
+    void *mapped{};
+    uint64_t size = 0, allocation_size = 0, address = 0;
+    bool coherent = false;
+    uint64_t views = 0;
+  };
+  struct View {
+    uint64_t pool, offset, size;
+  };
+  HMODULE loader{};
+  VkInstance instance{};
+  VkPhysicalDevice physical{};
+  VkDevice device{};
+  VkQueue queue{};
+  uint32_t queue_family = 0;
+  VkPhysicalDeviceProperties properties{};
+  VkPhysicalDeviceMemoryProperties memory{};
+  bool addresses = false, prefer_noncoherent = false;
+  bool enabled_shader_image_gather_extended = false;
+  std::thread::id owner = std::this_thread::get_id();
+  std::map<uint64_t, Pool> pools;
+  std::map<uint64_t, View> views;
+  template <class T> T Get(const char *name) const {
+    auto p = loader ? GetProcAddress(loader, name) : nullptr;
+    if (!p)
+      throw std::runtime_error(std::string("Unsupported Vulkan export: ") +
+                               name);
+    return reinterpret_cast<T>(p);
+  }
+  void Thread() const {
+    if (owner != std::this_thread::get_id())
+      throw std::runtime_error("VulkanDevice requires its owner thread");
+  }
+  Pool &GetPool(PoolHandle h) {
+    auto it = pools.find(h.value);
+    if (it == pools.end())
+      throw std::runtime_error("Invalid or destroyed pool handle");
+    return it->second;
+  }
+  const Pool &GetPool(PoolHandle h) const {
+    auto it = pools.find(h.value);
+    if (it == pools.end())
+      throw std::runtime_error("Invalid or destroyed pool handle");
+    return it->second;
+  }
+  View &GetView(BufferViewHandle h) {
+    auto it = views.find(h.value);
+    if (it == views.end())
+      throw std::runtime_error("Invalid or destroyed view handle");
+    return it->second;
+  }
+  const View &GetView(BufferViewHandle h) const {
+    auto it = views.find(h.value);
+    if (it == views.end())
+      throw std::runtime_error("Invalid or destroyed view handle");
+    return it->second;
+  }
+  void Release(Pool &p) {
+    if (p.mapped)
+      Get<PFN_vkUnmapMemory>("vkUnmapMemory")(device, p.memory);
+    if (p.buffer)
+      Get<PFN_vkDestroyBuffer>("vkDestroyBuffer")(device, p.buffer, nullptr);
+    if (p.memory)
+      Get<PFN_vkFreeMemory>("vkFreeMemory")(device, p.memory, nullptr);
+    p = {};
+  }
+  ~Impl() {
+    if (device) {
+      for (auto &[id, p] : pools)
+        Release(p);
+      Get<PFN_vkDestroyDevice>("vkDestroyDevice")(device, nullptr);
+    }
+    if (instance)
+      Get<PFN_vkDestroyInstance>("vkDestroyInstance")(instance, nullptr);
+    if (loader)
+      FreeLibrary(loader);
+  }
+  void Sync(BufferViewHandle h, uint64_t offset, uint64_t size,
+            bool invalidate) {
+    Thread();
+    auto &v = GetView(h);
+    Range(v.size, offset, size);
+    auto &p = GetPool({v.pool});
+    if (!size || p.coherent)
+      return;
+    const uint64_t start = v.offset + offset,
+                   atom = properties.limits.nonCoherentAtomSize;
+    const uint64_t aligned = start - start % atom;
+    const uint64_t end = start + size;
+    uint64_t length = VK_WHOLE_SIZE;
+    if (end <= p.allocation_size && end % atom == 0)
+      length = end - aligned;
+    else if (atom - end % atom <= p.allocation_size - end)
+      length = end + (atom - end % atom) - aligned;
+    VkMappedMemoryRange range{VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE};
+    range.memory = p.memory;
+    range.offset = aligned;
+    range.size = length;
+    if (invalidate)
+      Check(Get<PFN_vkInvalidateMappedMemoryRanges>(
+                "vkInvalidateMappedMemoryRanges")(device, 1, &range),
+            "vkInvalidateMappedMemoryRanges");
+    else
+      Check(Get<PFN_vkFlushMappedMemoryRanges>("vkFlushMappedMemoryRanges")(
+                device, 1, &range),
+            "vkFlushMappedMemoryRanges");
+  }
+};
+#define V(name) impl->Get<PFN_##name>(#name)
+VulkanDevice::VulkanDevice(DeviceOptions options)
+    : impl(std::make_unique<Impl>()) {
+  if (options.unsupported_flags)
+    throw std::runtime_error("Unsupported device flags");
+  impl->prefer_noncoherent = options.prefer_noncoherent;
+  impl->loader = LoadLibraryW(L"vulkan-1.dll");
+  if (!impl->loader)
+    throw std::runtime_error("System Vulkan loader unavailable");
+  VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+  app.pApplicationName = "native-resource-device";
+  app.apiVersion =
+      options.require_device_address ? VK_API_VERSION_1_2 : VK_API_VERSION_1_0;
+  VkInstanceCreateInfo ici{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+  ici.pApplicationInfo = &app;
+  Check(V(vkCreateInstance)(&ici, nullptr, &impl->instance),
+        "vkCreateInstance");
+  uint32_t n = 0;
+  Check(V(vkEnumeratePhysicalDevices)(impl->instance, &n, nullptr),
+        "vkEnumeratePhysicalDevices");
+  std::vector<VkPhysicalDevice> devices(n);
+  Check(V(vkEnumeratePhysicalDevices)(impl->instance, &n, devices.data()),
+        "vkEnumeratePhysicalDevices");
+  uint32_t family = 0;
+  for (auto p : devices) {
+    VkPhysicalDeviceProperties prop{};
+    V(vkGetPhysicalDeviceProperties)(p, &prop);
+    if (options.require_device_address && prop.apiVersion < VK_API_VERSION_1_2)
+      continue;
+    uint32_t count = 0;
+    V(vkGetPhysicalDeviceQueueFamilyProperties)(p, &count, nullptr);
+    std::vector<VkQueueFamilyProperties> q(count);
+    V(vkGetPhysicalDeviceQueueFamilyProperties)(p, &count, q.data());
+    for (uint32_t i = 0; i < count; ++i)
+      if (q[i].queueCount && (q[i].queueFlags & VK_QUEUE_GRAPHICS_BIT)) {
+        if (options.require_device_address) {
+          VkPhysicalDeviceBufferDeviceAddressFeatures bda{
+              VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_BUFFER_DEVICE_ADDRESS_FEATURES};
+          VkPhysicalDeviceFeatures2 features{
+              VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+          features.pNext = &bda;
+          V(vkGetPhysicalDeviceFeatures2)(p, &features);
+          if (!bda.bufferDeviceAddress)
+            continue;
+        }
+        impl->physical = p;
+        family = i;
+        break;
+      }
+    if (impl->physical)
+      break;
+  }
+  if (!impl->physical)
+    throw std::runtime_error("Unsupported graphics queue or requested buffer "
+                             "device address feature");
+  V(vkGetPhysicalDeviceProperties)(impl->physical, &impl->properties);
+  V(vkGetPhysicalDeviceMemoryProperties)(impl->physical, &impl->memory);
+  float priority = 1;
+  VkDeviceQueueCreateInfo q{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+  q.queueFamilyIndex = family;
+  q.queueCount = 1;
+  q.pQueuePriorities = &priority;
+  VkDeviceCreateInfo d{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+  d.queueCreateInfoCount = 1;
+  d.pQueueCreateInfos = &q;
+  VkPhysicalDeviceFeatures supported{}, enabled{};
+  V(vkGetPhysicalDeviceFeatures)(impl->physical, &supported);
+  enabled.shaderImageGatherExtended = supported.shaderImageGatherExtended;
+  d.pEnabledFeatures = &enabled;
+  VkPhysicalDeviceBufferDeviceAddressFeatures bda{
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_BUFFER_DEVICE_ADDRESS_FEATURES};
+  bda.bufferDeviceAddress = VK_TRUE;
+  if (options.require_device_address)
+    d.pNext = &bda;
+  Check(V(vkCreateDevice)(impl->physical, &d, nullptr, &impl->device),
+        "vkCreateDevice");
+  impl->addresses = options.require_device_address;
+  impl->enabled_shader_image_gather_extended =
+      enabled.shaderImageGatherExtended == VK_TRUE;
+  impl->queue_family = family;
+  V(vkGetDeviceQueue)(impl->device, family, 0, &impl->queue);
+}
+VulkanDevice::~VulkanDevice() = default;
+PoolHandle VulkanDevice::CreatePool(uint64_t size, uint32_t flags) {
+  impl->Thread();
+  if (flags)
+    throw std::runtime_error("Unsupported pool flags");
+  if (!size || size > std::numeric_limits<size_t>::max())
+    throw std::runtime_error("Invalid pool size");
+  Impl::Pool p{};
+  p.size = size;
+  VkBufferCreateInfo b{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+  b.size = size;
+  b.usage =
+      VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT |
+      VK_BUFFER_USAGE_VERTEX_BUFFER_BIT | VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT |
+      VK_BUFFER_USAGE_INDEX_BUFFER_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT;
+  if (impl->addresses)
+    b.usage |= VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT;
+  b.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  Check(V(vkCreateBuffer)(impl->device, &b, nullptr, &p.buffer),
+        "vkCreateBuffer");
+  try {
+    VkMemoryRequirements req{};
+    V(vkGetBufferMemoryRequirements)(impl->device, p.buffer, &req);
+    uint32_t index = impl->memory.memoryTypeCount;
+    int best = -1;
+    for (uint32_t i = 0; i < impl->memory.memoryTypeCount; ++i) {
+      auto f = impl->memory.memoryTypes[i].propertyFlags;
+      if (!(req.memoryTypeBits & (1u << i)) ||
+          !(f & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
+        continue;
+      int score = ((f & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) != 0) ==
+                          !impl->prefer_noncoherent
+                      ? 1
+                      : 0;
+      if (score > best) {
+        index = i;
+        best = score;
+      }
+    }
+    if (index == impl->memory.memoryTypeCount)
+      throw std::runtime_error("Unsupported host-visible Vulkan buffer memory");
+    p.coherent = (impl->memory.memoryTypes[index].propertyFlags &
+                  VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) != 0;
+    p.allocation_size = req.size;
+    VkMemoryAllocateFlagsInfo af{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO};
+    af.flags = VK_MEMORY_ALLOCATE_DEVICE_ADDRESS_BIT;
+    VkMemoryAllocateInfo a{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    a.allocationSize = req.size;
+    a.memoryTypeIndex = index;
+    if (impl->addresses)
+      a.pNext = &af;
+    Check(V(vkAllocateMemory)(impl->device, &a, nullptr, &p.memory),
+          "vkAllocateMemory");
+    Check(V(vkBindBufferMemory)(impl->device, p.buffer, p.memory, 0),
+          "vkBindBufferMemory");
+    Check(
+        V(vkMapMemory)(impl->device, p.memory, 0, VK_WHOLE_SIZE, 0, &p.mapped),
+        "vkMapMemory");
+    if (impl->addresses) {
+      VkBufferDeviceAddressInfo ai{
+          VK_STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO};
+      ai.buffer = p.buffer;
+      p.address = V(vkGetBufferDeviceAddress)(impl->device, &ai);
+      if (!p.address)
+        throw std::runtime_error("Driver returned zero buffer device address");
+    }
+    auto id = Handle();
+    impl->pools.emplace(id, p);
+    return {id};
+  } catch (...) {
+    impl->Release(p);
+    throw;
+  }
+}
+void VulkanDevice::DestroyPool(PoolHandle h) {
+  impl->Thread();
+  auto &p = impl->GetPool(h);
+  if (p.views)
+    throw std::runtime_error("Pool still owns live buffer views");
+  impl->Release(p);
+  impl->pools.erase(h.value);
+}
+BufferViewHandle VulkanDevice::CreateView(PoolHandle h, uint64_t offset,
+                                          uint64_t size) {
+  impl->Thread();
+  auto &p = impl->GetPool(h);
+  Range(p.size, offset, size);
+  if (!size)
+    throw std::runtime_error("Empty buffer view unsupported");
+  auto id = Handle();
+  impl->views.emplace(id, Impl::View{h.value, offset, size});
+  ++p.views;
+  return {id};
+}
+void VulkanDevice::DestroyView(BufferViewHandle h) {
+  impl->Thread();
+  auto v = impl->GetView(h);
+  --impl->GetPool({v.pool}).views;
+  impl->views.erase(h.value);
+}
+void VulkanDevice::Upload(BufferViewHandle h, uint64_t offset,
+                          std::span<const std::byte> bytes) {
+  impl->Thread();
+  auto v = impl->GetView(h);
+  Range(v.size, offset, bytes.size());
+  auto &p = impl->GetPool({v.pool});
+  if (!bytes.empty())
+    std::memcpy(static_cast<std::byte *>(p.mapped) + v.offset + offset,
+                bytes.data(), bytes.size());
+  impl->Sync(h, offset, bytes.size(), false);
+}
+void VulkanDevice::Download(BufferViewHandle h, uint64_t offset,
+                            std::span<std::byte> bytes) {
+  impl->Thread();
+  auto v = impl->GetView(h);
+  Range(v.size, offset, bytes.size());
+  impl->Sync(h, offset, bytes.size(), true);
+  auto &p = impl->GetPool({v.pool});
+  if (!bytes.empty())
+    std::memcpy(bytes.data(),
+                static_cast<std::byte *>(p.mapped) + v.offset + offset,
+                bytes.size());
+}
+void VulkanDevice::Flush(BufferViewHandle h, uint64_t offset, uint64_t size) {
+  impl->Sync(h, offset, size, false);
+}
+void VulkanDevice::Invalidate(BufferViewHandle h, uint64_t offset,
+                              uint64_t size) {
+  impl->Sync(h, offset, size, true);
+}
+PoolInfo VulkanDevice::GetPoolInfo(PoolHandle h) const {
+  impl->Thread();
+  auto &p = impl->GetPool(h);
+  return {p.size, p.coherent, p.address};
+}
+uint64_t VulkanDevice::GetDeviceAddress(BufferViewHandle h) const {
+  impl->Thread();
+  auto &v = impl->GetView(h);
+  auto &p = impl->GetPool({v.pool});
+  if (!impl->addresses)
+    throw std::runtime_error("Buffer device address feature was not requested");
+  if (v.offset > UINT64_MAX - p.address)
+    throw std::runtime_error("GPU device address overflow");
+  return p.address + v.offset;
+}
+std::string VulkanDevice::DeviceName() const {
+  impl->Thread();
+  return impl->properties.deviceName;
+}
+} // namespace native_graphics
+
+namespace native_graphics {
+BufferBinding VulkanDevice::GetBufferBinding(BufferViewHandle h) const {
+  impl->Thread();
+  auto &v = impl->GetView(h);
+  auto &p = impl->GetPool({v.pool});
+  return {reinterpret_cast<uint64_t>(p.buffer), v.offset, v.size};
+}
+VulkanHandles VulkanDevice::GetNativeHandles() const {
+  impl->Thread();
+  return {reinterpret_cast<uintptr_t>(impl->instance),
+          reinterpret_cast<uintptr_t>(impl->physical),
+          reinterpret_cast<uintptr_t>(impl->device),
+          reinterpret_cast<uintptr_t>(impl->queue),
+          impl->queue_family,
+          impl->enabled_shader_image_gather_extended};
+}
+} // namespace native_graphics
diff --git a/native-runtime/graphics/vulkan_resources.h b/native-runtime/graphics/vulkan_resources.h
new file mode 100644
index 0000000000000000000000000000000000000000..8708891ec40c291650a3aa956d118fb3d5edf96b
--- /dev/null
+++ b/native-runtime/graphics/vulkan_resources.h
@@ -0,0 +1,62 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <span>
+#include <string>
+namespace native_graphics {
+struct PoolHandle {
+  uint64_t value = 0;
+};
+struct BufferViewHandle {
+  uint64_t value = 0;
+};
+struct DeviceOptions {
+  bool require_device_address = false;
+  bool prefer_noncoherent = false;
+  uint32_t unsupported_flags = 0;
+};
+struct BufferBinding {
+  uint64_t native_buffer = 0, offset = 0, size = 0;
+};
+struct VulkanHandles {
+  uintptr_t instance = 0, physical_device = 0, device = 0, queue = 0;
+  uint32_t queue_family = 0;
+  bool enabled_shader_image_gather_extended = false;
+};
+struct PoolInfo {
+  uint64_t size = 0;
+  bool coherent = false;
+  uint64_t device_address = 0;
+};
+// Owner-thread API. No guest addresses or layouts are interpreted here.
+// Errors throw std::runtime_error; invalid operations leave existing resources
+// intact. Destroy views before pools. Device destruction releases all remaining
+// resources.
+class VulkanDevice {
+public:
+  explicit VulkanDevice(DeviceOptions options = {});
+  ~VulkanDevice();
+  VulkanDevice(const VulkanDevice &) = delete;
+  VulkanDevice &operator=(const VulkanDevice &) = delete;
+  PoolHandle CreatePool(uint64_t size, uint32_t unsupported_flags = 0);
+  void DestroyPool(PoolHandle pool);
+  BufferViewHandle CreateView(PoolHandle pool, uint64_t offset, uint64_t size);
+  void DestroyView(BufferViewHandle view);
+  void Upload(BufferViewHandle view, uint64_t offset,
+              std::span<const std::byte> bytes);
+  void Download(BufferViewHandle view, uint64_t offset,
+                std::span<std::byte> bytes);
+  void Flush(BufferViewHandle view, uint64_t offset, uint64_t size);
+  void Invalidate(BufferViewHandle view, uint64_t offset, uint64_t size);
+  PoolInfo GetPoolInfo(PoolHandle pool) const;
+  uint64_t GetDeviceAddress(BufferViewHandle view) const;
+  std::string DeviceName() const;
+  BufferBinding GetBufferBinding(BufferViewHandle view) const;
+  VulkanHandles GetNativeHandles() const;
+
+private:
+  struct Impl;
+  std::unique_ptr<Impl> impl;
+};
+} // namespace native_graphics
diff --git a/native-runtime/host.cpp b/native-runtime/host.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e47dde58bd3b359d2720133c710447dcc35a2830
--- /dev/null
+++ b/native-runtime/host.cpp
@@ -0,0 +1,445 @@
+#include "host.h"
+#include <algorithm>
+#include <cstring>
+#include <stdexcept>
+#if defined(_M_X64) || defined(__x86_64__)
+#include <xmmintrin.h>
+#endif
+namespace native {
+static Host &owner(void *p) { return *static_cast<Host *>(p); }
+static uint64_t load(void *p, uint64_t a, uint32_t n) {
+  auto &h = owner(p);
+  return n ? h.read(a, n) : h.read(a, 4, true) | UINT64_C(0x100000000);
+}
+static void store(void *p, uint64_t a, uint32_t n, uint64_t v) {
+  owner(p).write(a, n, v);
+}
+static uint64_t exclusive_load(void *p, uint64_t a, uint32_t n) {
+  auto &h = owner(p);
+  h.clear_reservation();
+  if (!n || n > 8 || (n & (n - 1)) || a % n)
+    throw std::runtime_error("exclusive load alignment");
+  h.check(a, n, 1);
+  auto v = h.read(a, n);
+  h.reservation = a;
+  h.reservation_size = n;
+  h.reservation_epoch = h.epoch;
+  return v;
+}
+static uint32_t exclusive_store(void *p, uint64_t a, uint32_t n, uint64_t v) {
+  auto &h = owner(p);
+  bool valid = h.reservation == a && h.reservation_size == n &&
+               h.reservation_epoch == h.epoch;
+  h.clear_reservation();
+  if (!n || n > 8 || (n & (n - 1)) || a % n)
+    throw std::runtime_error("exclusive store alignment");
+  if (!valid)
+    return 1;
+  h.check(a, n, 2);
+  h.write(a, n, v);
+  return 0;
+}
+static void clear(void *p) { owner(p).clear_reservation(); }
+static void pair_load(void *p, uint64_t a, uint32_t n, uint64_t *lo,
+                      uint64_t *hi) {
+  auto &h = owner(p);
+  h.clear_reservation();
+  if ((n != 4 && n != 8) || a % (2 * n))
+    throw std::runtime_error("exclusive pair load alignment");
+  h.check(a, 2 * n, 1);
+  const auto first = h.read(a, n), second = h.read(a + n, n);
+  *lo = first;
+  *hi = second;
+  h.reservation = a;
+  h.reservation_size = 2 * n;
+  h.reservation_epoch = h.epoch;
+}
+static uint32_t pair_store(void *p, uint64_t a, uint32_t n, uint64_t lo,
+                           uint64_t hi) {
+  auto &h = owner(p);
+  bool valid = h.reservation == a && h.reservation_size == 2 * n &&
+               h.reservation_epoch == h.epoch;
+  h.clear_reservation();
+  if ((n != 4 && n != 8) || a % (2 * n))
+    throw std::runtime_error("exclusive pair store alignment");
+  if (!valid)
+    return 1;
+  h.check(a, 2 * n, 2);
+  h.write(a, n, lo);
+  h.write(a + n, n, hi);
+  return 0;
+}
+static uint64_t counter(void *p) {
+  auto &h = owner(p);
+  return h.counter_override ? h.counter_override() : h.ticks;
+}
+Host::Host() : memory(64 * 4096) {
+  bridge.user = this;
+  bridge.load = load;
+  bridge.store = store;
+  bridge.excl_load = exclusive_load;
+  bridge.excl_store = exclusive_store;
+  bridge.clear_excl = clear;
+  bridge.excl_load_pair = pair_load;
+  bridge.excl_store_pair = pair_store;
+  bridge.read_cntpct = counter;
+  bridge.page_entries = nullptr; // Callback bus remains authoritative until
+                                 // fastmem invalidation is integrated.
+  bridge.page_entry_stride = sizeof(Page);
+  bridge.page_bits = 12;
+  bridge.pointer_mask = ~UINT64_C(3);
+  bridge.address_space_max = memory.size();
+  context.host_mem = &bridge;
+  context.fm_table = reinterpret_cast<const unsigned char *>(table.data());
+  context.fm_limit = 0;
+  context.pending_svc = ~UINT64_C(0);
+}
+void Host::map(uint64_t a, const void *bytes, size_t n, unsigned permission) {
+  if (!bytes || (permission != 1 && permission != 3 && permission != 5))
+    throw std::runtime_error("unsupported mapping permission/source");
+  if (a % 4096 || !n || n % 4096 || a > memory.size() || n > memory.size() - a)
+    throw std::runtime_error("map range/alignment");
+  for (size_t i = a / 4096; i < (a + n) / 4096; ++i)
+    if (permissions[i])
+      throw std::runtime_error("overlapping mapping");
+  memcpy(memory.data() + a, bytes, n);
+  for (size_t i = a / 4096; i < (a + n) / 4096; ++i) {
+    permissions[i] = permission;
+    table[i].pointer =
+        (permission == 3)
+            ? (reinterpret_cast<uintptr_t>(memory.data() + i * 4096) -
+               i * 4096) |
+                  1
+            : 0;
+    table[i].watch = (permission & 4) ? 1 : 0;
+  }
+}
+uint64_t Host::read(uint64_t a, unsigned n, bool instruction) {
+  last_address = a;
+  last_access_size = n;
+  last_access_write = false;
+  if (instruction)
+    ++instruction_reads;
+  else
+    ++data_reads;
+  if (address_space) {
+    auto value = address_space->read(a, n, instruction);
+    if (!instruction && record_events)
+      events.push_back({a, value, n, false});
+    return value;
+  }
+  if (!n || n > 8 || a > memory.size() || n > memory.size() - a)
+    throw std::runtime_error("read range");
+  for (unsigned i = 0; i < n; ++i)
+    if (!(permissions[(a + i) / 4096] & (instruction ? 4 : 1)))
+      throw std::runtime_error("read permission");
+  uint64_t value = 0;
+  memcpy(&value, memory.data() + a, n);
+  if (!instruction && record_events)
+    events.push_back({a, value, n, false});
+  return value;
+}
+void Host::write(uint64_t a, unsigned n, uint64_t v) {
+  last_address = a;
+  last_access_size = n;
+  last_access_write = true;
+  if (address_space) {
+    address_space->write(a, n, v);
+    if (record_events)
+      events.push_back({a, v, n, true});
+    ++data_writes;
+    ++epoch;
+    return;
+  }
+  if (!n || n > 8 || a > memory.size() || n > memory.size() - a)
+    throw std::runtime_error("write range");
+  for (unsigned i = 0; i < n; ++i)
+    if (!(permissions[(a + i) / 4096] & 2))
+      throw std::runtime_error("write permission");
+  if (record_events)
+    events.push_back({a, v, n, true});
+  ++data_writes;
+  memcpy(memory.data() + a, &v, n);
+  ++epoch;
+}
+void Host::clear_reservation() { reservation_size = 0; }
+uint32_t Host::register_current_thread(uint64_t id, int32_t priority,
+                                       unsigned core) {
+  if (current_thread_handle || !id || priority < 0 || priority > 63 || core > 3)
+    throw std::runtime_error("invalid native main thread registration");
+  current_thread_handle = 0x100;
+  threads.emplace(current_thread_handle,
+                  ThreadObject{id, priority, core, UINT64_C(1) << core,
+                               &context, context.tpidrro_el0});
+  return current_thread_handle;
+}
+const ThreadObject *Host::find_thread(uint32_t handle) const {
+  if (handle == 0xffff8000u)
+    handle = current_thread_handle;
+  auto it = threads.find(handle);
+  return it == threads.end() ? nullptr : &it->second;
+}
+void Host::seal_code() {
+  if (!address_space || sealed_code_space_)
+    throw std::runtime_error("invalid code seal binding");
+  address_space->seal_code();
+  sealed_code_space_ = address_space;
+}
+void Host::check(uint64_t a, unsigned n, unsigned permission) const {
+  if (!n || n > 16 || a > UINT64_MAX - n)
+    throw std::runtime_error("bus preflight range");
+  if (address_space) {
+    for (unsigned i = 0; i < n; i += 8)
+      address_space->check(a + i, std::min(8u, n - i), permission);
+    return;
+  }
+  if (a > memory.size() || n > memory.size() - a)
+    throw std::runtime_error("bus preflight bounds");
+  for (unsigned i = 0; i < n; ++i)
+    if ((permissions[(a + i) / 4096] & permission) != permission)
+      throw std::runtime_error("bus preflight permission");
+}
+void Host::advance_time(uint64_t ns) {
+  constexpr uint64_t frequency = 19200000, denominator = 1000000000;
+  if (clock_remainder >= denominator)
+    throw std::runtime_error("invalid virtual clock remainder");
+  const uint64_t fraction = (ns % denominator) * frequency + clock_remainder;
+  const uint64_t whole = (ns / denominator) * frequency;
+  const uint64_t increment = whole + fraction / denominator;
+  if (ns > UINT64_MAX - sleep_ns || increment > UINT64_MAX - ticks)
+    throw std::runtime_error("virtual clock overflow");
+  ticks += increment;
+  clock_remainder = fraction % denominator;
+  sleep_ns += ns;
+}
+void Host::service() {
+  const auto svc = context.pending_svc;
+  ++svc_calls;
+  if (svc_observer)
+    svc_observer(context, false);
+  if (std::find(allowed_svcs.begin(), allowed_svcs.end(), svc) ==
+      allowed_svcs.end())
+    throw std::runtime_error("SVC capability denied");
+  switch (svc) {
+  case 31: {
+    const auto address = context.x[1];
+    if (address > UINT64_MAX - 12)
+      throw std::runtime_error("native port name address overflow");
+    std::string name;
+    for (unsigned i = 0; i < 12; ++i) {
+      auto c = read(address + i, 1);
+      if (!c)
+        break;
+      name += char(c);
+    }
+    if (name.size() > 11)
+      name.resize(11);
+    if (!connect_named_port)
+      throw std::runtime_error("native named port provider unavailable: " +
+                               name);
+    auto result = connect_named_port(name);
+    if (!result.result &&
+        (result.handle < 0x10000u || find_thread(result.handle) ||
+         result.handle >= 0xffff8000u))
+      throw std::runtime_error("invalid native session handle");
+    context.x[0] = result.result;
+    context.x[1] = result.handle;
+    break;
+  }
+  case 33: {
+    if (!send_sync_request)
+      throw std::runtime_error("native synchronous IPC provider unavailable");
+    auto thread = find_thread(0xffff8000u);
+    if (!thread || thread->tls_address != context.tpidrro_el0)
+      throw std::runtime_error("native IPC TLS binding unavailable");
+    context.x[0] =
+        send_sync_request(uint32_t(context.x[0]), thread->tls_address);
+    break;
+  }
+  case 0x16: { // CloseHandle. 0x18 is WaitSynchronization and remains
+               // unsupported.
+    const auto handle = uint32_t(context.x[0]);
+    if (handle >= 0xffff8000u) {
+      context.x[0] = 1u | (114u << 9);
+      break;
+    }
+    if (find_thread(handle))
+      throw std::runtime_error("native thread handle closure unsupported");
+    if (!close_session)
+      throw std::runtime_error("native session closure provider unavailable");
+    context.x[0] = close_session(handle);
+    break;
+  }
+  case 29: {
+    const auto key = context.x[0] & ~UINT64_C(3);
+    auto it = condition_waiters.find(key);
+    if (it != condition_waiters.end() && !it->second.empty())
+      throw std::runtime_error(
+          "condition signal with blocked native waiters unsupported");
+    check(key, 4, 2);
+    write(key, 4, 0);
+    break;
+  }
+  case 30:
+    context.x[0] = bridge.read_cntpct(bridge.user);
+    break;
+  case 12: {
+    auto thread = find_thread(uint32_t(context.x[1]));
+    context.x[0] = thread ? 0 : 1u | (114u << 9);
+    context.x[1] = thread ? uint32_t(thread->priority) : 0;
+    break;
+  }
+  case 14: {
+    auto thread = find_thread(uint32_t(context.x[2]));
+    context.x[0] = thread ? 0 : 1u | (114u << 9);
+    context.x[1] = thread ? thread->ideal_core : 0;
+    context.x[2] = thread ? thread->affinity_mask : 0;
+    break;
+  }
+  case 16: {
+    auto thread = find_thread(0xffff8000u);
+    if (!thread)
+      throw std::runtime_error("native current thread unavailable");
+    context.x[0] = thread->ideal_core;
+    break;
+  }
+  case 37: {
+    auto thread = find_thread(uint32_t(context.x[1]));
+    context.x[0] = thread ? 0 : 1u | (114u << 9);
+    context.x[1] = thread ? thread->id : 0;
+    break;
+  }
+  case 6: {
+    if (!address_space)
+      throw std::runtime_error("QueryMemory requires process address space");
+    auto info = address_space->query(context.x[2]);
+    const auto destination = context.x[0];
+    if (destination > UINT64_MAX - 40)
+      throw std::runtime_error("QueryMemory output overflow");
+    for (unsigned i = 0; i < 40; i += 8)
+      check(destination + i, 8, 2);
+    write(destination, 8, info.address);
+    write(destination + 8, 8, info.size);
+    write(destination + 16, 8, info.state);
+    write(destination + 24, 8, info.permission);
+    write(destination + 32, 8, 0);
+    context.x[0] = 0;
+    context.x[1] = 0;
+    break;
+  }
+  case 41: {
+    const auto type = uint32_t(context.x[1]), handle = uint32_t(context.x[2]);
+    const auto sub = context.x[3];
+    uint64_t result = 0, output = 0;
+    if ((type >= 2 && type <= 7) || type == 12 || type == 13 || type == 14 ||
+        type == 15) {
+      if (sub)
+        result = 1u | (120u << 9);
+      else if (handle != 0xffff8001u)
+        result = 1u | (114u << 9);
+      else {
+        if (!process_layout)
+          throw std::runtime_error("native process layout unavailable");
+        if (type == 6 || type == 7) {
+          if (!address_space)
+            throw std::runtime_error("native memory accounting unavailable");
+          if (type == 6 && address_space->physical_budget() == UINT64_MAX)
+            throw std::runtime_error("native physical budget not configured");
+          output = type == 6 ? address_space->physical_budget()
+                             : address_space->committed_bytes();
+        } else if (type == 12 || type == 13)
+          output = type == 12 ? process_layout->aslr_address
+                              : process_layout->aslr_size;
+        else {
+          if (!address_space)
+            throw std::runtime_error(
+                "native process address space unavailable");
+          auto range = address_space->reserved_range(type < 4   ? 7
+                                                     : type < 6 ? 5
+                                                                : 11);
+          output = (type % 2) ? range.size : range.address;
+        }
+      }
+    } else if (type != 11)
+      throw std::runtime_error("unsupported GetInfo type " +
+                               std::to_string(type));
+    else if (handle)
+      result = 1u | (114u << 9);
+    else if (sub >= 4)
+      result = 1u | (116u << 9);
+    else {
+      if (!entropy_available)
+        throw std::runtime_error("process entropy unavailable");
+      output = entropy[size_t(sub)];
+    }
+    context.x[0] = result;
+    context.x[1] = output;
+    break;
+  }
+  case 0x27: {
+    if (context.x[1] > 4096)
+      throw std::runtime_error("debug string limit");
+    std::string text;
+    for (uint64_t i = 0; i < context.x[1]; ++i)
+      text += char(read(context.x[0] + i, 1));
+    output += text;
+    context.x[0] = 0;
+    break;
+  }
+  case 0xb:
+    if (context.x[0] > UINT64_C(1000000000))
+      throw std::runtime_error("unsupported sleep interval");
+    advance_time(context.x[0]);
+    if (sleep_override)
+      sleep_override(context.x[0]);
+    clear_reservation();
+    break;
+  case 7:
+    exited = true;
+    clear_reservation();
+    break;
+  default:
+    throw std::runtime_error("unsupported SVC " + std::to_string(svc));
+  }
+  if (svc_observer)
+    svc_observer(context, true);
+  context.pending_svc = ~UINT64_C(0);
+}
+void Host::dispatch(unsigned budget, unsigned max_slices) {
+  if (!budget || budget > 4096)
+    throw std::runtime_error("slice budget");
+  for (unsigned step = 0; step < max_slices && !exited; ++step) {
+    if (sealed_code_space_ &&
+        (address_space != sealed_code_space_ || !address_space->code_sealed()))
+      throw std::runtime_error("sealed code address-space binding changed");
+    if (interrupt)
+      return;
+    if (context.halted)
+      throw std::runtime_error("guest halted " +
+                               std::to_string(context.halted));
+    if (context.pending_svc != ~UINT64_C(0)) {
+      service();
+      continue;
+    }
+    const Module *selected = nullptr;
+    for (const auto &m : modules)
+      if (m.lookup(context.pc)) {
+        if (selected)
+          throw std::runtime_error("ambiguous module");
+        selected = &m;
+      }
+    if (!selected)
+      throw std::runtime_error("unresolved static PC/import");
+    context.chain_budget = budget;
+#if defined(RECOMP_FEATURE_FPX1) && (defined(_M_X64) || defined(__x86_64__))
+    _mm_setcsr((_mm_getcsr() & 0x3fu) | 0x1f80u);
+#endif
+    ++slices;
+    selected->slice(&context);
+    blocks += budget - unsigned(context.chain_budget) +
+              (context.chain_budget > 0 ? 1 : 0);
+  }
+  if (!exited && !interrupt)
+    throw std::runtime_error("execution budget exhausted");
+}
+} // namespace native
