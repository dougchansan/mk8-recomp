+namespace nx::nvn {
+struct ShaderInfo;
+bool native_shader_uses_sampled_float_profile(const ShaderInfo*);
+inline bool native_float_color_format(uint32_t format) {
+    if((format>=0x41&&format<=0x50)||(format>=0x79&&format<=0x9c))return true;
+    switch(format) {
+    case 1:case 2:case 5:case 6:case 7:case 0xa:case 0xd:case 0xe:
+    case 0x11:case 0x12:case 0x13:case 0x16:case 0x19:case 0x1a:
+    case 0x1d:case 0x1e:case 0x1f:case 0x22:case 0x25:case 0x26:
+    case 0x29:case 0x2a:case 0x2b:case 0x2e:case 0x37:case 0x38:
+    case 0x39:case 0x3a:case 0x3b:case 0x3c:case 0x3d:case 0x3f:case 0x40:return true;
+    default:return false;
+    }
+}
+inline bool native_sampled_2d_float_compatible(uint32_t target,uint32_t depth,uint32_t samples,uint32_t format) {
+    return target==1&&depth==1&&samples<=1&&native_float_color_format(format);
+}
+inline bool native_sampled_shadow_compatible(bool arrayed,uint32_t target,uint32_t layers,uint32_t samples,uint32_t format,uint32_t depth_mode,uint32_t compare_mode,uint32_t compare_func) {
+    return target==(arrayed?4u:1u)&&(arrayed?layers>0:layers==1)&&samples<=1&&format>=0x32&&format<=0x36&&depth_mode==0&&compare_mode==1&&compare_func>=1&&compare_func<=8;
+}
+inline bool native_sampled_array_shadow_compatible(uint32_t target,uint32_t layers,uint32_t samples,uint32_t format,uint32_t depth_mode,uint32_t compare_mode,uint32_t compare_func) {
+    return native_sampled_shadow_compatible(true,target,layers,samples,format,depth_mode,compare_mode,compare_func);
+}
+inline bool native_sampled_array_float_compatible(uint32_t target,uint32_t layers,uint32_t samples,uint32_t format){return target==4&&layers>0&&samples<=1&&native_float_color_format(format);}
+inline bool native_sampled_cube_array_float_compatible(uint32_t target,uint32_t width,uint32_t height,uint32_t layers,uint32_t samples,uint32_t format){return target==9&&width>0&&width==height&&layers>=6&&layers%6==0&&samples<=1&&native_float_color_format(format);}
+inline bool native_sampled_cube_float_compatible(uint32_t target,uint32_t width,uint32_t height,uint32_t samples,uint32_t format) {
+    return target==8&&width>0&&width==height&&samples<=1&&native_float_color_format(format);
