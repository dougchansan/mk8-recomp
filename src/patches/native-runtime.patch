new file mode 100644
index 0000000000000000000000000000000000000000..e5fd1a5e911a390ce50f0a459fc6f2b22f6cc597
--- /dev/null
+++ b/tests/native_platform/generate.cpp
@@ -0,0 +1,37 @@
+#include "core/recompiler/arm64_to_c.h"
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <stdexcept>
+using namespace suyu::recomp;
+static void emit(const char *name, const std::vector<uint32_t> &words,
+                 uint64_t base, const std::filesystem::path &out) {
+  EmitProject(name, reinterpret_cast<const uint8_t *>(words.data()),
+              words.size() * 4, base, (out / name).string(), true);
+}
+int main(int argc, char **argv) {
+  if (argc != 3)
+    return 2;
+  std::filesystem::path out = argv[1], fixture = argv[2];
+  g_emit_fastmem = true;
+  g_emit_guard_gen = true;
+  g_emit_rsqrt_lookup = false;
+  emit("a", {0xd61f0280}, 0x2000, out);
+  emit("b",
+       {0xf94000a4, 0xf90000c4, 0xd53be027, 0xd40004e1, 0xd2800c80, 0xd4000161,
+        0xd40000e1, 0xd4000fe1, 0xc85f7cad, 0xc80e7cad, 0xd5033bbf, 0xd4200000,
+        0xffffffff},
+       0x1000, out);
+  std::ifstream f(fixture / "main", std::ios::binary);
+  std::vector<uint8_t> bytes((std::istreambuf_iterator<char>(f)), {});
+  if (bytes.size() != 0x3100)
+    throw std::runtime_error("unexpected synthetic NSO");
+  EmitProject("fixture", bytes.data() + 0x100, 4096, 0,
+              (out / "fixture").string(), true);
+  std::ofstream expected(out / "fixture_expected.h");
+  expected << "static const unsigned char expected_text[]={";
+  for (size_t i = 0x100; i < 0x1100; ++i)
+    expected << unsigned(bytes[i]) << ",";
+  expected << "};\n";
+  return !expected;
+}
diff --git a/tests/native_platform/ipc_integration.cpp b/tests/native_platform/ipc_integration.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..414ee0a6460fcfba4b16560d699419d10a7942e1
--- /dev/null
+++ b/tests/native_platform/ipc_integration.cpp
@@ -0,0 +1,198 @@
+#include "ipc_bridge.h"
+#include <array>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+using namespace native;
+static void check(bool v, const char *m) {
+  if (!v)
+    throw std::runtime_error(m);
+}
+static void put(std::array<std::byte, 256> &bytes, size_t at, uint32_t value) {
+  memcpy(bytes.data() + at, &value, 4);
+}
+static std::array<std::byte, 256> request(unsigned command, bool pid = false,
+                                          const char *name = "") {
+  std::array<std::byte, 256> bytes{};
+  put(bytes, 0, 4);
+  const unsigned cursor = pid ? 20 : 8, raw = pid ? 32 : 16;
+  put(bytes, 4, (raw + 24 - cursor) / 4 | (pid ? 0x80000000u : 0));
+  if (pid) {
+    put(bytes, 8, 1);
+    put(bytes, 12, 0xdeadbeef);
+    put(bytes, 16, 0xfedcba98);
+  }
+  put(bytes, raw, 0x49434653);
+  put(bytes, raw + 8, command);
+  memcpy(bytes.data() + raw + 16, name, std::min(size_t(8), strlen(name)));
+  return bytes;
+}
+static void message(Host &h, uint64_t base,
+                    const std::array<std::byte, 256> &bytes) {
+  for (unsigned i = 0; i < 256; i += 8) {
+    uint64_t v;
+    memcpy(&v, bytes.data() + i, 8);
+    h.write(base + i, 8, v);
+  }
+}
+static void prepare(Host &h, AddressSpace &space, uint64_t tls) {
+  space.map(0x4000, {'s', 'm', ':', 0}, 4096, 3);
+  h.address_space = &space;
+  h.context.tpidrro_el0 = tls;
+  h.register_current_thread(1, 44, 0);
+  h.allowed_svcs.insert(h.allowed_svcs.end(), {31, 33, 22, 24});
+}
+static uint32_t connect(Host &h) {
+  h.context.pending_svc = 31;
+  h.context.x[1] = 0x4000;
+  h.context.x[2] = 0x123456;
+  h.service();
+  check(h.context.x[0] == 0 && h.context.x[1] >= 0x10000 &&
+            h.context.x[2] == 0x123456,
+        "native SM Connect ABI/handle ownership");
+  return uint32_t(h.context.x[1]);
+}
+class ReadProbe final : public native_services::Endpoint {
+public:
+  native_services::Reply Prepare(const native_services::Request &r) override {
+    std::vector<std::byte> bytes(512, std::byte{0x55});
+    check(r.memory.read(r.memory.user, 0x8000, bytes),
+          "descriptor read larger than TLS");
+    for (auto b : bytes)
+      check(b == std::byte{0x6b}, "descriptor full bytes");
+    std::fill(bytes.begin(), bytes.end(), std::byte{0x55});
+    check(!r.memory.read(r.memory.user, 0x9f00, bytes),
+          "descriptor denied boundary");
+    for (auto b : bytes)
+      check(b == std::byte{0x55},
+            "failed descriptor read preserves destination");
+    bytes.resize((64u << 10) + 1, std::byte{0x55});
+    check(!r.memory.read(r.memory.user, 0x8000, bytes),
+          "descriptor size bound");
+    native_services::Reply reply;
+    reply.status = native_services::Status::Ok;
+    return reply;
+  }
+};
+int main() {
+  try {
+    {
+      Host h;
+      AddressSpace space;
+      space.map(0x1000, {}, 4096, 3, 12);
+      prepare(h, space, 0x1000);
+      native_services::Router router(77);
+      attach_services(h, router, 77);
+      auto handle = connect(h);
+      check(router.SessionCount() == 1, "real native SM session allocated");
+      message(h, 0x1000, request(0, true));
+      h.context.pending_svc = 33;
+      h.context.x[0] = handle;
+      h.context.x[1] = 0xabcdef;
+      h.service();
+      check(h.context.x[0] == 0 && h.context.x[1] == 0xabcdef &&
+                h.read(0x1010, 4) == 0x4f434653 && h.read(0x1018, 4) == 0,
