+// SPDX-License-Identifier: GPL-3.0-or-later
+// Work to quiesce before the process exits through plat::exit_process (background pipeline workers leave the driver
+// first). Hooks run in registration order on the exiting thread; each must return within a bounded time.
+#pragma once
+#include <mutex>
+#include <vector>
+namespace nx {
+using ExitHook = void (*)();
+inline std::mutex& exit_hook_lock() { static std::mutex m; return m; }
+inline std::vector<ExitHook>& exit_hooks() { static std::vector<ExitHook> v; return v; }
+inline void add_exit_hook(ExitHook h) { std::lock_guard g(exit_hook_lock()); exit_hooks().push_back(h); }
+inline void run_exit_hooks() {
+    std::vector<ExitHook> hooks;
+    { std::lock_guard g(exit_hook_lock()); hooks = exit_hooks(); }
+    for (ExitHook h : hooks) h();
+}
