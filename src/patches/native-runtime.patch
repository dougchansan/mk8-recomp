+  }
+}
diff --git a/native-runtime/nvn/pipeline_check.cpp b/native-runtime/nvn/pipeline_check.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fccb700a55dc74155790a821ff409491020ffb51
--- /dev/null
+++ b/native-runtime/nvn/pipeline_check.cpp
@@ -0,0 +1,62 @@
+#include "draw.h"
+#include <fstream>
+#include <iostream>
+#include <sstream>
+#include <stdexcept>
+using namespace native_nvn;
+static std::vector<uint32_t> Read(const char *name) {
+  std::ifstream input(name, std::ios::binary | std::ios::ate);
+  if (!input || input.tellg() < 20 || input.tellg() > 1048576 ||
+      (uint64_t(input.tellg()) & 3))
+    throw std::runtime_error("Shader file size invalid");
+  std::vector<uint32_t> result(size_t(input.tellg()) / 4);
+  input.seekg(0);
+  if (!input.read(reinterpret_cast<char *>(result.data()), result.size() * 4))
+    throw std::runtime_error("Shader read failed");
+  return result;
+}
+int main(int argc, char **argv) {
+  try {
+    if (argc < 3)
+      throw std::runtime_error(
+          "Usage: pipeline_check vertex.spv fragment.spv "
+          "[vertex:ubo:N|fragment:ubo:N|fragment:sampler:N ...]");
+    auto vertex = Read(argv[1]), fragment = Read(argv[2]);
+    std::vector<DescriptorPlan> plan;
+    for (int i = 3; i < argc; i++) {
+      std::istringstream parser(argv[i]);
+      std::string stage, kind, binding;
+      if (!std::getline(parser, stage, ':') ||
+          !std::getline(parser, kind, ':') || !std::getline(parser, binding) ||
+          binding.empty())
+        throw std::runtime_error("Bad explicit descriptor plan");
+      size_t consumed = 0;
+      const auto number = std::stoul(binding, &consumed);
+      if (consumed != binding.size() || number >= 32 ||
+          (stage != "vertex" && stage != "fragment") ||
+          (kind != "ubo" && kind != "sampler"))
+        throw std::runtime_error("Unsupported descriptor plan");
+      plan.push_back(
+          {uint32_t(number),
+           kind == "ubo" ? DescriptorKind::UniformBuffer
+                         : DescriptorKind::CombinedImageSampler2D,
+           stage == "vertex" ? ShaderStage::Vertex : ShaderStage::Fragment});
+    }
+    Resources resources(
+        {nullptr, [](void *, uint64_t, std::span<std::byte>) { return false; },
+         [](void *, uint64_t, std::span<const std::byte>) { return false; }});
+    resources.CreateDevice(0x1000);
+    CheckProgramPipeline(resources, 0x1000, {vertex, fragment, plan});
+    const auto features = resources.Backend(0x1000).GetNativeHandles();
+    std::cout << "{\"pipeline_created\":true,\"image_gather_extended_enabled\":"
+              << (features.enabled_shader_image_gather_extended ? "true"
+                                                                : "false")
+              << ",\"descriptor_bindings\":" << plan.size()
+              << ",\"draws_submitted\":0,\"resource_contents_bound\":false,"
+                 "\"image_produced\":false}\n";
+    return 0;
+  } catch (const std::exception &error) {
+    std::cerr << error.what() << '\n';
+    return 1;
+  }
+}
diff --git a/native-runtime/nvn/resource_test.cpp b/native-runtime/nvn/resource_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a433c57d1b2875b7d9574c1b5398dabc99cc67ee
--- /dev/null
+++ b/native-runtime/nvn/resource_test.cpp
@@ -0,0 +1,228 @@
+#include "resources.h"
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#define VK_NO_PROTOTYPES
+#include <algorithm>
+#include <array>
+#include <iostream>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+#include <vulkan/vulkan.h>
+#include <windows.h>
+using namespace native_nvn;
+namespace {
+struct Memory {
+  std::array<std::byte, 16384> bytes{};
+  bool read_fault = false, write_fault = false;
+  unsigned reads = 0, writes = 0;
+  static bool Read(void *user, uint64_t address, std::span<std::byte> out) {
+    auto &m = *static_cast<Memory *>(user);
+    ++m.reads;
+    if (m.read_fault || address < 0x10000 ||
+        address - 0x10000 > m.bytes.size() ||
+        out.size() > m.bytes.size() - (address - 0x10000))
+      return false;
+    std::copy_n(m.bytes.begin() + address - 0x10000, out.size(), out.begin());
+    return true;
+  }
+  static bool Write(void *user, uint64_t address,
+                    std::span<const std::byte> in) {
+    auto &m = *static_cast<Memory *>(user);
+    ++m.writes;
+    if (address < 0x10000 || address - 0x10000 > m.bytes.size() ||
+        in.size() > m.bytes.size() - (address - 0x10000))
+      return false;
+    const auto count = m.write_fault ? in.size() / 2 : in.size();
+    std::copy_n(in.begin(), count, m.bytes.begin() + address - 0x10000);
+    return !m.write_fault;
+  }
+};
+void Check(bool yes, const char *why) {
+  if (!yes)
+    throw std::runtime_error(why);
+}
+void VkCheck(VkResult value) {
+  Check(value == VK_SUCCESS, "Vulkan copy operation failed");
+}
+// Actual queue execution, not merely mapped host memory roundtrip.
+void GpuCopy(native_graphics::VulkanDevice &backend,
+             native_graphics::BufferBinding binding) {
+  const auto handles = backend.GetNativeHandles();
+  const auto library = LoadLibraryW(L"vulkan-1.dll");
+  Check(library != nullptr, "Vulkan loader");
+  const auto instance_proc = reinterpret_cast<PFN_vkGetInstanceProcAddr>(
+      GetProcAddress(library, "vkGetInstanceProcAddr"));
+  const auto device_proc = reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+      instance_proc(reinterpret_cast<VkInstance>(handles.instance),
+                    "vkGetDeviceProcAddr"));
+  const auto device = reinterpret_cast<VkDevice>(handles.device);
+#define LOAD(name)                                                             \
+  const auto name = reinterpret_cast<PFN_##name>(device_proc(device, #name));  \
+  Check(name != nullptr, #name)
+  LOAD(vkCreateCommandPool);
+  LOAD(vkAllocateCommandBuffers);
+  LOAD(vkBeginCommandBuffer);
+  LOAD(vkCmdCopyBuffer);
+  LOAD(vkCmdPipelineBarrier);
+  LOAD(vkEndCommandBuffer);
+  LOAD(vkQueueSubmit);
+  LOAD(vkCreateFence);
+  LOAD(vkWaitForFences);
+  LOAD(vkDestroyFence);
+  LOAD(vkDestroyCommandPool);
+#undef LOAD
+  VkCommandPoolCreateInfo pool_info{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+  pool_info.queueFamilyIndex = handles.queue_family;
+  VkCommandPool pool{};
+  VkCheck(vkCreateCommandPool(device, &pool_info, nullptr, &pool));
+  VkCommandBufferAllocateInfo allocation{
+      VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+  allocation.commandPool = pool;
+  allocation.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+  allocation.commandBufferCount = 1;
+  VkCommandBuffer command{};
+  VkCheck(vkAllocateCommandBuffers(device, &allocation, &command));
+  VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+  VkCheck(vkBeginCommandBuffer(command, &begin));
+  VkBufferCopy copy{binding.offset, binding.offset + 128, 64};
+  vkCmdCopyBuffer(command, reinterpret_cast<VkBuffer>(binding.native_buffer),
+                  reinterpret_cast<VkBuffer>(binding.native_buffer), 1, &copy);
+  VkMemoryBarrier host_read{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+  host_read.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  host_read.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+  vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                       VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &host_read, 0, nullptr,
+                       0, nullptr);
+  VkCheck(vkEndCommandBuffer(command));
+  VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+  submit.commandBufferCount = 1;
+  submit.pCommandBuffers = &command;
+  const auto queue = reinterpret_cast<VkQueue>(handles.queue);
+  VkFenceCreateInfo fence_info{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+  VkFence fence{};
+  VkCheck(vkCreateFence(device, &fence_info, nullptr, &fence));
+  VkCheck(vkQueueSubmit(queue, 1, &submit, fence));
+  VkCheck(vkWaitForFences(device, 1, &fence, VK_TRUE, UINT64_C(5000000000)));
+  vkDestroyFence(device, fence, nullptr);
+  vkDestroyCommandPool(device, pool, nullptr);
+  FreeLibrary(library);
+}
+} // namespace
+int main() {
+  try {
+    Memory memory;
+    Resources resources({&memory, Memory::Read, Memory::Write});
+    unsigned rejected = 0;
+    auto reject = [&](auto action) {
+      try {
+        action();
+      } catch (const std::runtime_error &) {
+        ++rejected;
+        return;
+      }
+      throw std::runtime_error("Expected resource rejection");
+    };
+    resources.CreateDevice(0x1000);
+    PoolDescription pool{0x1000, 0x10000, 4096, CpuAccess::Cached};
+    for (size_t i = 0; i < 64; i++)
+      memory.bytes[i] = std::byte(i ^ 0x5a);
+    resources.CreatePool(0x2000, pool);
+    resources.CreateBuffer(0x3000, {0x1000, 0x2000, 0, 256});
+    resources.CreateBuffer(0x3010, {0x1000, 0x2000, 128, 64});
+    Check(resources.MapPool(0x2000) == 0x10000 &&
+              resources.MapBuffer(0x3010) == 0x10080,
+          "Guest integer mapping");
+    const auto gpu = resources.BufferGpuAddress(0x3000);
+    Check(gpu && resources.BufferGpuAddress(0x3010) == gpu + 128,
+          "Real GPU address view offset");
+    Check(resources.ResolveGpuAddress(0x1000, gpu + 128, 64).offset == 128,
+          "GPU owner resolution");
+    GpuCopy(resources.Backend(0x1000), resources.Binding(0x3000));
+    resources.InvalidateBuffer(0x3010, 0, 64);
+    Check(std::equal(memory.bytes.begin(), memory.bytes.begin() + 64,
+                     memory.bytes.begin() + 128),
+          "Actual GPU copy readback");
+    for (size_t i = 0; i < 64; i++)
+      memory.bytes[i] = std::byte(255 - i);
+    resources.FlushBuffer(0x3000, 0, 64);
+    std::array<std::byte, 64> downloaded{};
+    resources.Backend(0x1000).Download(resources.View(0x3000), 0, downloaded);
+    Check(
+        std::equal(downloaded.begin(), downloaded.end(), memory.bytes.begin()),
+        "Guest flush Vulkan backing");
+    memory.read_fault = true;
+    const auto before = downloaded;
+    reject([&] { resources.FlushBuffer(0x3000, 0, 64); });
+    memory.read_fault = false;
+    resources.Backend(0x1000).Download(resources.View(0x3000), 0, downloaded);
+    Check(downloaded == before, "Read fault leaves Vulkan bytes unchanged");
+    std::fill_n(memory.bytes.begin(), 64, std::byte{});
+    memory.write_fault = true;
+    reject([&] { resources.InvalidateBuffer(0x3000, 0, 64); });
+    memory.write_fault = false;
+    Check(std::equal(memory.bytes.begin(), memory.bytes.begin() + 32,
+                     before.begin()) &&
+              std::all_of(memory.bytes.begin() + 32, memory.bytes.begin() + 64,
+                          [](std::byte b) { return b == std::byte{}; }),
+          "Partial guest write fault remains explicit");
+    reject([&] { resources.CreatePool(0x2020, pool); });
+    reject([&] { resources.CreateDevice(0x1000); });
+    reject([&] { resources.DestroyDevice(0x1000); });
+    reject([&] { resources.DestroyPool(0x2000); });
+    reject([&] { resources.CreateBuffer(0x3020, {0x1000, 0x2000, 4095, 2}); });
+    reject([&] { resources.FlushBuffer(0x3000, UINT64_MAX, 1); });
+    reject([&] { resources.CreateBuffer(0x3001, {0x1000, 0x2000, 0, 64}); });
+    reject([&] { resources.ResolveGpuAddress(0x1000, gpu + 4096, 1); });
+    auto bad = pool;
+    bad.storage++;
+    reject([&] { resources.CreatePool(0x2020, bad); });
+    bad = pool;
+    bad.size = 4095;
+    reject([&] { resources.CreatePool(0x2020, bad); });
+    bad = pool;
+    bad.virtual_pool = true;
+    reject([&] { resources.CreatePool(0x2020, bad); });
+    bad = pool;
+    bad.physical_pool = true;
+    reject([&] { resources.CreatePool(0x2020, bad); });
+    bad = pool;
+    bad.gpu_cached = false;
+    reject([&] { resources.CreatePool(0x2020, bad); });
+    bad = pool;
+    bad.storage = 0x11000;
+    memory.read_fault = true;
+    reject([&] { resources.CreatePool(0x2020, bad); });
+    memory.read_fault = false;
+    bad.cpu = CpuAccess::None;
+    resources.CreatePool(0x2020, bad);
+    reject([&] { resources.MapPool(0x2020); });
+    reject([&] { resources.FlushPool(0x2020, 0, 64); });
+    resources.DestroyPool(0x2020);
+    bool wrong_thread = false;
+    std::thread other([&] {
+      try {
+        resources.MapPool(0x2000);
+      } catch (const std::runtime_error &) {
+        wrong_thread = true;
+      }
+    });
+    other.join();
+    Check(wrong_thread, "Owner thread");
+    resources.DestroyBuffer(0x3010);
+    resources.DestroyBuffer(0x3000);
+    resources.DestroyPool(0x2000);
+    resources.CreatePool(0x2000, pool);
+    resources.DestroyPool(0x2000);
+    resources.DestroyDevice(0x1000);
+    reject([&] { resources.MapBuffer(0x3000); });
+    std::cout << "{\"passed\":true,\"actual_gpu_copy_bytes\":64,\"rejected\":"
+              << rejected << ",\"guest_reads\":" << memory.reads
+              << ",\"guest_writes\":" << memory.writes
+              << ",\"key_reuse\":true,\"no_guest_host_pointers\":true}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
diff --git a/native-runtime/nvn/resources.cpp b/native-runtime/nvn/resources.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e5143b81ae9d430eff3ec099edf4d711d762c46d
--- /dev/null
+++ b/native-runtime/nvn/resources.cpp
@@ -0,0 +1,222 @@
+#include "resources.h"
+#include <algorithm>
+#include <stdexcept>
+#include <vector>
+
+namespace native_nvn {
+namespace {
+void Require(bool condition, const char *message) {
+  if (!condition)
+    throw std::runtime_error(message);
+}
+void Range(uint64_t offset, uint64_t size, uint64_t limit) {
+  Require(size && offset <= limit && size <= limit - offset,
+          "NVN resource range invalid");
+}
+bool Overlap(uint64_t a, uint64_t as, uint64_t b, uint64_t bs) {
+  return a <= b ? b - a < as : a - b < bs;
+}
+} // namespace
+Resources::Resources(GuestMemory memory)
+    : memory_(memory), owner_(std::this_thread::get_id()) {
+  Require(memory.read && memory.write, "NVN guest memory callbacks required");
+}
+Resources::~Resources() = default;
+void Resources::CheckOwner() const {
+  Require(owner_ == std::this_thread::get_id(),
+          "NVN resource owner thread required");
+}
+void Resources::CheckNewKey(GuestAddress key) const {
+  CheckOwner();
+  Require(key && !(key & 7) && !devices_.contains(key) &&
+              !pools_.contains(key) && !buffers_.contains(key),
+          "NVN object key invalid or already live");
+}
+native_graphics::VulkanDevice &Resources::GetDevice(GuestAddress key) const {
+  CheckOwner();
+  const auto found = devices_.find(key);
+  Require(found != devices_.end(), "NVN device is not live");
+  return *found->second.backend;
+}
+const Resources::Pool &Resources::GetPool(GuestAddress key) const {
+  CheckOwner();
+  const auto found = pools_.find(key);
+  Require(found != pools_.end(), "NVN pool is not live");
+  return found->second;
+}
+const Resources::Buffer &Resources::GetBuffer(GuestAddress key) const {
+  CheckOwner();
+  const auto found = buffers_.find(key);
+  Require(found != buffers_.end(), "NVN buffer is not live");
+  return found->second;
+}
+void Resources::CreateDevice(GuestAddress key) {
+  CheckNewKey(key);
+  auto backend = std::make_unique<native_graphics::VulkanDevice>(
+      native_graphics::DeviceOptions{true, false, 0});
+  devices_.emplace(key, Device{std::move(backend)});
+}
+void Resources::DestroyDevice(GuestAddress key) {
+  GetDevice(key);
+  for (const auto &[unused, pool] : pools_)
+    Require(pool.description.device != key, "NVN device still owns pools");
+  devices_.erase(key);
+}
+void Resources::CreatePool(GuestAddress key,
+                           const PoolDescription &description) {
+  CheckNewKey(key);
+  auto &backend = GetDevice(description.device);
+  Require(description.gpu_cached && !description.virtual_pool &&
+              !description.physical_pool,
+          "NVN pool mode unsupported");
+  Require(description.cpu == CpuAccess::None ||
+              description.cpu == CpuAccess::Cached,
+          "NVN CPU access mode unsupported");
+  Require(
+      description.storage && !(description.storage & (StorageAlignment - 1)) &&
+          description.size && !(description.size & (StorageAlignment - 1)) &&
+          description.size <= MaximumPoolSize &&
+          description.storage <= UINT64_MAX - description.size,
+      "NVN pool storage/size alignment or bound invalid");
+  for (const auto &[unused, pool] : pools_)
+    Require(!Overlap(description.storage, description.size,
+                     pool.description.storage, pool.description.size),
+            "NVN overlapping pool backing unsupported");
+  const auto handle = backend.CreatePool(description.size);
+  native_graphics::BufferViewHandle view;
+  try {
+    view = backend.CreateView(handle, 0, description.size);
+    Pool pool{description, handle, view};
+    for (uint64_t offset = 0; offset < description.size;
+         offset += MaximumTransferSize)
+      Transfer(pool, offset,
+               std::min(MaximumTransferSize, description.size - offset), true);
+    pools_.emplace(key, pool);
+  } catch (...) {
+    if (view.value)
+      backend.DestroyView(view);
+    backend.DestroyPool(handle);
+    throw;
+  }
+}
+void Resources::DestroyPool(GuestAddress key) {
+  const auto &pool = GetPool(key);
+  for (const auto &[unused, buffer] : buffers_)
+    Require(buffer.description.pool != key, "NVN pool still owns buffers");
+  auto &backend = GetDevice(pool.description.device);
+  backend.DestroyView(pool.view);
+  backend.DestroyPool(pool.handle);
+  pools_.erase(key);
+}
+void Resources::CreateBuffer(GuestAddress key,
+                             const BufferDescription &description) {
+  CheckNewKey(key);
+  const auto &pool = GetPool(description.pool);
+  Require(description.device == pool.description.device,
+          "NVN buffer device mismatch");
+  Range(description.offset, description.size, pool.description.size);
+  auto &backend = GetDevice(description.device);
+  const auto view =
+      backend.CreateView(pool.handle, description.offset, description.size);
+  try {
+    buffers_.emplace(key, Buffer{description, view});
+  } catch (...) {
+    backend.DestroyView(view);
+    throw;
+  }
+}
+void Resources::DestroyBuffer(GuestAddress key) {
+  const auto &buffer = GetBuffer(key);
+  GetDevice(buffer.description.device).DestroyView(buffer.view);
+  buffers_.erase(key);
+}
+GuestAddress Resources::MapPool(GuestAddress key) const {
+  const auto &pool = GetPool(key);
+  Require(pool.description.cpu == CpuAccess::Cached,
+          "NVN pool denies CPU mapping");
+  return pool.description.storage;
+}
+GuestAddress Resources::MapBuffer(GuestAddress key) const {
+  const auto &buffer = GetBuffer(key);
+  return MapPool(buffer.description.pool) + buffer.description.offset;
+}
+void Resources::Transfer(const Pool &pool, uint64_t offset, uint64_t size,
+                         bool upload) {
+  Range(offset, size, pool.description.size);
+  Require(size <= MaximumTransferSize,
+          "NVN transfer exceeds bounded call limit");
+  std::vector<std::byte> bytes(static_cast<size_t>(size));
+  auto &backend = GetDevice(pool.description.device);
+  if (upload) {
+    Require(
+        memory_.read(memory_.user, pool.description.storage + offset, bytes),
+        "NVN guest read fault");
+    backend.Upload(pool.view, offset, bytes);
+    backend.Flush(pool.view, offset, size);
+  } else {
+    backend.Invalidate(pool.view, offset, size);
+    backend.Download(pool.view, offset, bytes);
+    Require(
+        memory_.write(memory_.user, pool.description.storage + offset, bytes),
+        "NVN guest write fault");
+  }
+}
+void Resources::FlushPool(GuestAddress key, uint64_t offset, uint64_t size) {
+  const auto &pool = GetPool(key);
+  MapPool(key);
+  Transfer(pool, offset, size, true);
+}
+void Resources::InvalidatePool(GuestAddress key, uint64_t offset,
+                               uint64_t size) {
+  const auto &pool = GetPool(key);
+  MapPool(key);
+  Transfer(pool, offset, size, false);
+}
+void Resources::FlushBuffer(GuestAddress key, uint64_t offset, uint64_t size) {
+  const auto &buffer = GetBuffer(key);
+  Range(offset, size, buffer.description.size);
+  FlushPool(buffer.description.pool, buffer.description.offset + offset, size);
+}
+void Resources::InvalidateBuffer(GuestAddress key, uint64_t offset,
+                                 uint64_t size) {
+  const auto &buffer = GetBuffer(key);
+  Range(offset, size, buffer.description.size);
+  InvalidatePool(buffer.description.pool, buffer.description.offset + offset,
+                 size);
+}
+uint64_t Resources::PoolGpuAddress(GuestAddress key) const {
+  const auto &pool = GetPool(key);
+  return GetDevice(pool.description.device).GetDeviceAddress(pool.view);
+}
+uint64_t Resources::BufferGpuAddress(GuestAddress key) const {
+  const auto &buffer = GetBuffer(key);
+  return GetDevice(buffer.description.device).GetDeviceAddress(buffer.view);
+}
+ResolvedAddress Resources::ResolveGpuAddress(GuestAddress device,
+                                             uint64_t address,
+                                             uint64_t size) const {
+  GetDevice(device);
+  for (const auto &[key, pool] : pools_) {
+    if (pool.description.device != device)
+      continue;
+    const auto base = PoolGpuAddress(key);
+    if (address >= base && address - base <= pool.description.size && size &&
+        size <= pool.description.size - (address - base))
+      return {key, address - base};
+  }
+  throw std::runtime_error("NVN GPU address has no live pool owner");
+}
+native_graphics::VulkanDevice &Resources::Backend(GuestAddress device) {
+  return GetDevice(device);
+}
+native_graphics::BufferViewHandle Resources::View(GuestAddress buffer) const {
+  return GetBuffer(buffer).view;
+}
+native_graphics::BufferBinding Resources::Binding(GuestAddress buffer) const {
+  const auto &value = GetBuffer(buffer);
+  return GetDevice(value.description.device).GetBufferBinding(value.view);
+}
+GuestAddress Resources::BufferDevice(GuestAddress buffer) const {
+  return GetBuffer(buffer).description.device;
+}
+} // namespace native_nvn
diff --git a/native-runtime/nvn/resources.h b/native-runtime/nvn/resources.h
new file mode 100644
index 0000000000000000000000000000000000000000..4521e42b83208e5af7559b4a098e2eeabcb54e01
--- /dev/null
+++ b/native-runtime/nvn/resources.h
@@ -0,0 +1,89 @@
+#pragma once
+#include "../graphics/vulkan_resources.h"
+#include <map>
+#include <thread>
+
+namespace native_nvn {
+using GuestAddress = uint64_t;
+enum class CpuAccess { None, Cached };
+struct GuestMemory {
+  void *user = nullptr;
+  bool (*read)(void *, GuestAddress, std::span<std::byte>) = nullptr;
+  bool (*write)(void *, GuestAddress, std::span<const std::byte>) = nullptr;
+};
+struct PoolDescription {
+  GuestAddress device = 0, storage = 0;
+  uint64_t size = 0;
+  CpuAccess cpu = CpuAccess::Cached;
+  bool gpu_cached = true, virtual_pool = false, physical_pool = false;
+};
+struct BufferDescription {
+  GuestAddress device = 0, pool = 0;
+  uint64_t offset = 0, size = 0;
+};
+struct ResolvedAddress {
+  GuestAddress pool = 0;
+  uint64_t offset = 0;
+};
+
+// Native owned objects; guest keys are opaque aligned integer identities.
+// Owner-thread API, including destruction. Borrowed backend handles require
+// external GPU completion before mutation/destruction. Callbacks are bounded,
+// synchronous, non-reentrant, and never retain spans. A failed write can have
+// guest partial effects; failures are reported and never converted to success.
+class Resources {
+public:
+  static constexpr uint64_t StorageAlignment = 4096;
+  static constexpr uint64_t MaximumPoolSize = 16u << 20;
+  static constexpr uint64_t MaximumTransferSize = 1u << 20;
+  explicit Resources(GuestMemory memory);
+  ~Resources();
+  Resources(const Resources &) = delete;
+  Resources &operator=(const Resources &) = delete;
+  void CreateDevice(GuestAddress key);
+  void DestroyDevice(GuestAddress key);
+  void CreatePool(GuestAddress key, const PoolDescription &description);
+  void DestroyPool(GuestAddress key);
+  void CreateBuffer(GuestAddress key, const BufferDescription &description);
+  void DestroyBuffer(GuestAddress key);
+  GuestAddress MapPool(GuestAddress key) const;
+  GuestAddress MapBuffer(GuestAddress key) const;
+  void FlushPool(GuestAddress key, uint64_t offset, uint64_t size);
+  void InvalidatePool(GuestAddress key, uint64_t offset, uint64_t size);
+  void FlushBuffer(GuestAddress key, uint64_t offset, uint64_t size);
+  void InvalidateBuffer(GuestAddress key, uint64_t offset, uint64_t size);
+  uint64_t PoolGpuAddress(GuestAddress key) const;
+  uint64_t BufferGpuAddress(GuestAddress key) const;
+  ResolvedAddress ResolveGpuAddress(GuestAddress device, uint64_t address,
+                                    uint64_t size) const;
+  native_graphics::VulkanDevice &Backend(GuestAddress device);
+  native_graphics::BufferViewHandle View(GuestAddress buffer) const;
+  native_graphics::BufferBinding Binding(GuestAddress buffer) const;
+  GuestAddress BufferDevice(GuestAddress buffer) const;
+
+private:
+  struct Device {
+    std::unique_ptr<native_graphics::VulkanDevice> backend;
+  };
+  struct Pool {
+    PoolDescription description;
+    native_graphics::PoolHandle handle;
+    native_graphics::BufferViewHandle view;
+  };
+  struct Buffer {
+    BufferDescription description;
+    native_graphics::BufferViewHandle view;
+  };
+  GuestMemory memory_;
+  std::thread::id owner_;
+  std::map<GuestAddress, Device> devices_;
+  std::map<GuestAddress, Pool> pools_;
+  std::map<GuestAddress, Buffer> buffers_;
+  void CheckOwner() const;
+  void CheckNewKey(GuestAddress key) const;
+  const Pool &GetPool(GuestAddress key) const;
+  const Buffer &GetBuffer(GuestAddress key) const;
+  native_graphics::VulkanDevice &GetDevice(GuestAddress key) const;
+  void Transfer(const Pool &pool, uint64_t offset, uint64_t size, bool upload);
+};
+} // namespace native_nvn
diff --git a/native-runtime/relocations.cpp b/native-runtime/relocations.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8a3f2e56d74e6d474289abf0c27f1dd2cc110499
--- /dev/null
+++ b/native-runtime/relocations.cpp
@@ -0,0 +1,222 @@
+#include "nso.h"
+#include <map>
+#include <stdexcept>
+#include <unordered_map>
+namespace native {
+namespace {
+uint64_t add(uint64_t a, uint64_t b) {
+  if (a > UINT64_MAX - b)
+    throw std::runtime_error("relocation address overflow");
+  return a + b;
+}
+struct Symbol {
+  std::string name;
+  uint64_t value{};
+  bool defined{}, weak{};
+  unsigned binding{}, visibility{}, type{}, section{};
+};
+Symbol symbol(const AddressSpace &space, const BootModule &m, unsigned index) {
+  const auto &ro = m.image.segments[1];
+  if (m.image.dynsym_size % 24 || index >= m.image.dynsym_size / 24)
+    throw std::runtime_error("dynamic symbol index");
+  auto p = add(
+      m.base, add(ro.offset, add(m.image.dynsym_offset, uint64_t(index) * 24)));
+  auto name = space.read(p, 4);
+  if (name >= m.image.dynstr_size)
+    throw std::runtime_error("dynamic string offset");
+  Symbol out;
+  out.value = space.read(p + 8, 8);
+  out.section = unsigned(space.read(p + 6, 2));
+  out.defined = out.section != 0;
+  auto info = space.read(p + 4, 1);
+  out.binding = unsigned(info >> 4);
+  out.type = unsigned(info & 15);
+  out.visibility = unsigned(space.read(p + 5, 1) & 3);
+  out.weak = out.binding == 2;
+  auto string = add(m.base, add(ro.offset, m.image.dynstr_offset));
+  for (uint64_t i = name; i < m.image.dynstr_size; ++i) {
+    auto c = space.read(string + i, 1);
+    if (!c)
+      return out;
+    if (out.name.size() >= 4096)
+      throw std::runtime_error("dynamic symbol name limit");
+    out.name += char(c);
+  }
+  throw std::runtime_error("unterminated dynamic symbol");
+}
+uint64_t symbol_address(const BootModule &m, const Symbol &s) {
+  if (s.binding > 2 || s.type > 3)
+    throw std::runtime_error("unsupported dynamic symbol class");
+  if (s.section == 0xfff1)
+    return s.value;
+  if (!s.section || s.section >= 0xff00 || s.value > m.image.image_size)
+    throw std::runtime_error("unsupported dynamic symbol section/value");
+  return add(m.base, s.value);
+}
+void extents(const NsoImage &image) {
+  const auto &ro = image.segments[1];
+  for (auto [offset, size] :
+       {std::pair{image.dynstr_offset, image.dynstr_size},
+        std::pair{image.dynsym_offset, image.dynsym_size}})
+    if (offset > ro.bytes.size() || size > ro.bytes.size() - offset)
+      throw std::runtime_error("NSO dynamic extent");
+}
+} // namespace
+size_t relocate_rtld(AddressSpace &space,
+                     const std::vector<BootModule> &modules,
+                     std::vector<RelocationRecord> *audit) {
+  std::unordered_map<std::string, uint64_t> exports;
+  const BootModule *rtld = nullptr;
+  for (const auto &m : modules) {
+    extents(m.image);
+    if (m.image.name == "rtld") {
+      if (rtld)
+        throw std::runtime_error("duplicate rtld");
+      rtld = &m;
+    }
+    for (unsigned i = 1; i < m.image.dynsym_size / 24; ++i) {
+      auto s = symbol(space, m, i);
+      if (s.defined && !s.name.empty() && (s.binding == 1 || s.binding == 2) &&
+          (s.visibility == 0 || s.visibility == 3) && s.type <= 3)
+        exports.emplace(s.name, symbol_address(m, s));
+    }
+  }
+  if (!rtld)
+    throw std::runtime_error("missing rtld");
+  const auto &m = *rtld;
+  if (m.image.segments[0].offset != 0)
+    throw std::runtime_error("rtld text placement");
+  auto mod0 = add(m.base, space.read(m.base + 4, 4));
+  if (mod0 < m.base || mod0 - m.base >= m.image.image_size ||
+      space.read(mod0, 4) != 0x30444f4d)
+    throw std::runtime_error("rtld MOD0");
+  auto relative = static_cast<int32_t>(space.read(mod0 + 4, 4));
+  uint64_t dynamic;
+  if (relative < 0) {
+    auto distance = uint64_t(-int64_t(relative));
+    if (distance > mod0 - m.base)
+      throw std::runtime_error("negative MOD0 dynamic extent");
+    dynamic = mod0 - distance;
+  } else
+    dynamic = add(mod0, uint64_t(relative));
+  std::map<uint64_t, std::pair<uint64_t, uint64_t>> tags;
+  bool terminated = false;
+  for (unsigned i = 0; i < 1024; ++i) {
+    auto p = add(dynamic, uint64_t(i) * 16);
+    if (p < m.base || p - m.base > m.image.image_size - 16)
+      throw std::runtime_error("dynamic table extent");
+    auto tag = space.read(p, 8), value = space.read(p + 8, 8);
+    if (!tag) {
+      terminated = true;
+      break;
+    }
+    if (tag == 2 || tag == 5 || tag == 6 || tag == 7 || tag == 8 || tag == 9 ||
+        tag == 17 || tag == 18 || tag == 20 || tag == 23) {
+      if (!tags.emplace(tag, std::pair{value, p + 8}).second)
+        throw std::runtime_error("duplicate relocation dynamic tag");
+    }
+  }
+  if (!terminated)
+    throw std::runtime_error("unterminated dynamic table");
+  auto get = [&](uint64_t tag) {
+    auto it = tags.find(tag);
+    return it == tags.end() ? UINT64_C(0) : it->second.first;
+  };
+  if (get(17) || get(18) || (get(20) && get(20) != 7) ||
+      (get(9) && get(9) != 24))
+    throw std::runtime_error("unsupported REL/RELA layout");
+  if (get(6) &&
+      get(6) != uint64_t(m.image.segments[1].offset) + m.image.dynsym_offset)
+    throw std::runtime_error("dynamic symtab/header mismatch");
+  if (get(5) &&
+      get(5) != uint64_t(m.image.segments[1].offset) + m.image.dynstr_offset)
+    throw std::runtime_error("dynamic strtab/header mismatch");
+  struct Patch {
+    uint64_t address, value;
+  };
+  std::vector<Patch> patches;
+  std::vector<RelocationRecord> records;
+  auto table = [&](uint64_t offset, uint64_t size) {
+    if (!size)
+      return;
+    if (size % 24 || offset > m.image.image_size ||
+        size > m.image.image_size - offset)
+      throw std::runtime_error("RELA extent");
+    for (uint64_t i = 0; i < size; i += 24) {
+      auto p = add(m.base, offset + i), target = add(m.base, space.read(p, 8)),
+           info = space.read(p + 8, 8), addend = space.read(p + 16, 8);
+      auto type = uint32_t(info), index = unsigned(info >> 32);
+      uint64_t value;
+      std::string symbol_name;
+      bool weak_null = false;
+      if (type == 0)
+        continue;
+      else if (type == 0x403) {
+        if (index)
+          throw std::runtime_error("RELATIVE symbol index");
+        value = m.base + addend;
+      } else if (type == 0x101 || type == 0x401 || type == 0x402) {
+        auto s = symbol(space, m, index);
+        symbol_name = s.name;
+        bool synthetic = true;
+        if (s.name == "__rela_dyn_start" || s.name == "__rel_dyn_start")
+          value = add(m.base, get(7));
+        else if (s.name == "__rela_dyn_end" || s.name == "__rel_dyn_end")
+          value = add(m.base, add(get(7), get(8)));
+        else if (s.name == "__rela_plt_start" || s.name == "__rel_plt_start")
+          value = add(m.base, get(23));
+        else if (s.name == "__rela_plt_end" || s.name == "__rel_plt_end")
+          value = add(m.base, add(get(23), get(2)));
+        else
+          synthetic = false;
+        if (!synthetic) {
+          if (type == 0x101 && index == 0)
+            value = 0;
+          else if (s.binding > 2 || s.type > 3 ||
+                   (!s.defined &&
+                    (s.value || s.binding == 0 || s.visibility == 3)))
+            throw std::runtime_error("unsupported referenced symbol class: " +
+                                     s.name);
+          else if (s.defined && (s.binding == 0 || s.visibility != 0))
+            value = symbol_address(m, s);
+          else if (s.visibility == 0 && exports.contains(s.name))
+            value = exports.at(s.name);
+          else if (s.defined)
+            value = symbol_address(m, s);
+          else if (s.weak) {
+            value = 0;
+            weak_null = true;
+          } else
+            throw std::runtime_error("unresolved strong rtld import: " +
+                                     s.name);
+        }
+        value += addend;
+      } else
+        throw std::runtime_error("unsupported rtld relocation type " +
+                                 std::to_string(type));
+      if (target < m.base || target - m.base > m.image.image_size - 8)
+        throw std::runtime_error("rtld relocation target outside rtld");
+      space.check(target, 8, 2);
+      patches.push_back({target, value});
+      records.push_back({target, value, type, symbol_name, weak_null});
+    }
+  };
+  table(get(7), get(8));
+  table(get(23), get(2));
+  auto count = patches.size();
+  for (uint64_t tag : {8u, 2u})
+    if (auto it = tags.find(tag); it != tags.end()) {
+      space.check(it->second.second, 8, 2);
+      patches.push_back({it->second.second, 0});
+    }
+  for (auto patch : patches)
+    space.write(patch.address, 8, patch.value);
+  if (audit)
+    *audit = std::move(records);
+  return count;
+}
+size_t relocate_rtld(AddressSpace &space,
+                     const std::vector<BootModule> &modules) {
+  return relocate_rtld(space, modules, nullptr);
+}
+} // namespace native
