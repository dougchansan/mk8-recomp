+// Pipeline recipes: stage digests, the field-by-field key encoding and the file (nvn_pipeline_recipes.h). No Vulkan
+// calls and no runtime state: the prewarm engine is nvn_pipeline_prewarm.cpp.
+#include "nvn_pipeline_recipes.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <unordered_map>
+#include <unordered_set>
+
+#include "platform.h"
+
+#ifdef _WIN32
+#include <io.h>
+#include <windows.h>
+#endif
+
+namespace nx::nvn::recipes {
+
+// A new PipelineKey field needs a new kKeyEncoding and a line in each of encode_state and decode_state.
+static_assert(sizeof(PipelineKey) == 712, "PipelineKey changed: update encode_state/decode_state and kKeyEncoding");
+
+namespace {
+
+constexpr char kMagic[8] = {'N', 'X', 'P', 'R', 'C', 'P', 0, 1};
+constexpr size_t kHeaderBytes = 80;  // magic, 4 x u32, u64, 4 x u32, u64 length, SHA-1, u32
+constexpr size_t kMaxHashBytes = 64;
+
+struct Writer {
+    std::string out;
+    void u8(uint8_t v) { out.push_back(char(v)); }
+    void u32(uint32_t v) {
+        for (int k = 0; k < 4; k++) out.push_back(char(v >> (8 * k)));
+    }
+    void u64(uint64_t v) {
+        for (int k = 0; k < 8; k++) out.push_back(char(v >> (8 * k)));
+    }
+    void f32(float v) {
+        uint32_t bits;
+        std::memcpy(&bits, &v, 4);
+        u32(bits);
+    }
+    void bytes(const void* p, size_t n) { out.append(static_cast<const char*>(p), n); }
+};
+
+struct Reader {
+    std::string_view in;
+    size_t at = 0;
+    bool ok = true;
+    bool need(size_t n) {
+        if (!ok || in.size() - at < n) ok = false;
+        return ok;
+    }
+    uint8_t u8() { return need(1) ? uint8_t(in[at++]) : 0; }
+    uint32_t u32() {
+        if (!need(4)) return 0;
+        uint32_t v = 0;
+        for (int k = 0; k < 4; k++) v |= uint32_t(uint8_t(in[at + k])) << (8 * k);
+        at += 4;
+        return v;
+    }
+    uint64_t u64() {
+        uint64_t lo = u32(), hi = u32();
+        return lo | hi << 32;
+    }
+    float f32() {
+        uint32_t bits = u32();
+        float v;
+        std::memcpy(&v, &bits, 4);
+        return v;
+    }
+    void bytes(void* p, size_t n) {
+        if (need(n)) std::memcpy(p, in.data() + at, n), at += n;
+    }
+    std::string_view take(size_t n) {
+        if (!need(n)) return {};
+        std::string_view v = in.substr(at, n);
+        at += n;
+        return v;
+    }
+};
+
+void digest_io(Sha1& h, const std::vector<ShaderIo>& list) {
+    uint32_t n = uint32_t(list.size());
+    h.update(&n, 4);
+    for (const ShaderIo& io : list) {
+        uint32_t v[5] = {io.location, io.component, uint32_t(io.type), io.components, io.array};
+        h.update(v, sizeof v);
+    }
+}
+
+Digest sha1(std::string_view bytes) {
+    Sha1 h;
+    h.update(bytes.data(), bytes.size());
+    Digest d;
+    h.finish(d.data());
+    return d;
+}
+
+std::string merge_key(const Recipe& r) {
+    return value_key(r.vs.digest, r.fs.hash.empty() ? nullptr : &r.fs.digest, r.state);
+}
+
+}  // namespace
+
+Digest stage_digest(const ShaderInfo& s) {
+    Sha1 h;
+    static const char tag[] = "nx pipeline stage v1";
+    h.update(tag, sizeof tag);
+    uint32_t head[2] = {uint32_t(s.stage), uint32_t(s.spirv.size())};
+    h.update(head, sizeof head);
+    h.update(s.spirv.data(), s.spirv.size() * 4);
+    digest_io(h, s.refl.inputs);
+    digest_io(h, s.refl.outputs);
+    uint32_t n = uint32_t(s.refl.bindings.size());
+    h.update(&n, 4);
+    for (const DescriptorBinding& b : s.refl.bindings) {
+        uint32_t v[4] = {b.set, b.binding, uint32_t(b.type), b.count};
+        h.update(v, sizeof v);
+    }
+    Digest d;
+    h.finish(d.data());
+    return d;
+}
+
+std::string encode_state(const PipelineKey& k) {
+    Writer w;
+    w.u32(k.topology);
+    w.f32(k.point_size);
+    for (const VertexAttrib& a : k.attribs) w.u32(a.format), w.u32(a.offset), w.u32(a.stream);
+    for (const VertexStream& s : k.streams) w.u32(s.stride), w.u32(s.divisor);
+    w.u32(k.attrib_count), w.u32(k.stream_count);
+    for (const BlendTarget& b : k.blend)
+        w.u32(b.target), w.u32(b.src_rgb), w.u32(b.dst_rgb), w.u32(b.src_a), w.u32(b.dst_a), w.u32(b.eq_rgb),
+            w.u32(b.eq_a);
+    w.bytes(k.color.blend_enable, 8);
+    w.u32(k.color.alpha_test), w.u32(k.color.logic_op);
+    w.bytes(k.mask.mask, 8);
+    w.u8(k.depth.depth_test), w.u8(k.depth.depth_write), w.u8(k.depth.stencil_test);
+    w.u32(k.depth.depth_func);
+    for (int f = 0; f < 2; f++)
+        w.u32(k.depth.stencil_func[f]), w.u32(k.depth.stencil_fail[f]), w.u32(k.depth.depth_fail[f]),
+            w.u32(k.depth.depth_pass[f]);
+    w.u32(k.polygon.cull), w.u32(k.polygon.front), w.u32(k.polygon.mode), w.u32(k.polygon.offset_enables);
+    for (VkFormat f : k.color_formats) w.u32(uint32_t(f));
+    w.u32(k.color_count);
+    w.u32(uint32_t(k.depth_format));
+    w.u32(k.depth_clamp), w.u32(k.ufloat_colors), w.u32(k.alpha_to_coverage);
+    w.f32(k.uw_x);
+    return w.out;
+}
+
+bool decode_state(std::string_view bytes, PipelineKey& k) {
+    std::memset(&k, 0, sizeof k);  // as draw_call builds them: compared byte for byte
+    Reader r{bytes};
+    k.topology = r.u32();
+    k.point_size = r.f32();
+    for (VertexAttrib& a : k.attribs) a.format = r.u32(), a.offset = r.u32(), a.stream = r.u32();
+    for (VertexStream& s : k.streams) s.stride = r.u32(), s.divisor = r.u32();
+    k.attrib_count = r.u32(), k.stream_count = r.u32();
+    for (BlendTarget& b : k.blend)
+        b.target = r.u32(), b.src_rgb = r.u32(), b.dst_rgb = r.u32(), b.src_a = r.u32(), b.dst_a = r.u32(),
+        b.eq_rgb = r.u32(), b.eq_a = r.u32();
+    r.bytes(k.color.blend_enable, 8);
+    k.color.alpha_test = r.u32(), k.color.logic_op = r.u32();
+    r.bytes(k.mask.mask, 8);
+    k.depth.depth_test = r.u8(), k.depth.depth_write = r.u8(), k.depth.stencil_test = r.u8();
+    k.depth.depth_func = r.u32();
+    for (int f = 0; f < 2; f++)
+        k.depth.stencil_func[f] = r.u32(), k.depth.stencil_fail[f] = r.u32(), k.depth.depth_fail[f] = r.u32(),
+        k.depth.depth_pass[f] = r.u32();
+    k.polygon.cull = r.u32(), k.polygon.front = r.u32(), k.polygon.mode = r.u32(), k.polygon.offset_enables = r.u32();
+    for (VkFormat& f : k.color_formats) f = VkFormat(r.u32());
+    k.color_count = r.u32();
+    k.depth_format = VkFormat(r.u32());
+    k.depth_clamp = r.u32(), k.ufloat_colors = r.u32(), k.alpha_to_coverage = r.u32();
+    k.uw_x = r.f32();
+    bool ok = r.ok && r.at == bytes.size() && k.attrib_count <= 16 && k.stream_count <= 16 && k.color_count <= 8;
+    if (!ok) std::memset(&k, 0, sizeof k);
+    return ok;
+}
+
+std::string value_key(const Digest& vs, const Digest* fs, std::string_view state) {
+    std::string v;
+    v.reserve(kValuePrefix + state.size());
+    v.append(reinterpret_cast<const char*>(vs.data()), vs.size());
+    v.push_back(fs ? 1 : 0);
+    Digest none{};
+    const Digest& f = fs ? *fs : none;
+    v.append(reinterpret_cast<const char*>(f.data()), f.size());
+    v.append(state.data(), state.size());
+    return v;
+}
+
+std::string serialize(const std::vector<Recipe>& recipes, const FileInfo& info) {
+    Writer payload;
+    for (const Recipe& r : recipes) {
+        Writer rec;
+        rec.u32(r.order), rec.u32(r.runs);
+        rec.u8(uint8_t(r.vs.hash.size())), rec.bytes(r.vs.hash.data(), r.vs.hash.size());
+        rec.bytes(r.vs.digest.data(), 20);
+        rec.u8(r.fs.hash.empty() ? 0 : 1);
+        if (!r.fs.hash.empty())
+            rec.u8(uint8_t(r.fs.hash.size())), rec.bytes(r.fs.hash.data(), r.fs.hash.size()),
+                rec.bytes(r.fs.digest.data(), 20);
+        rec.u32(uint32_t(r.state.size())), rec.bytes(r.state.data(), r.state.size());
+        payload.u32(uint32_t(rec.out.size()));
+        payload.out += rec.out;
+    }
+    Writer w;
+    w.bytes(kMagic, 8);
+    w.u32(kSchema), w.u32(kKeyEncoding), w.u32(uint32_t(recipes.size())), w.u32(0);
+    w.u64(info.profile), w.u32(info.vendor), w.u32(info.device), w.u32(info.driver), w.u32(0);
+    w.u64(payload.out.size());
+    Digest d = sha1(payload.out);
+    w.bytes(d.data(), 20);
+    w.u32(0);
+    w.out += payload.out;
+    return w.out;
+}
+
+bool parse(std::string_view bytes, std::vector<Recipe>& out, FileInfo* info, std::string* why) {
+    out.clear();
+    auto fail = [&](const char* reason) {
+        if (why) *why = reason;
+        out.clear();
+        return false;
+    };
+    if (bytes.size() < kHeaderBytes) return fail("shorter than the header");
+    if (bytes.size() > kMaxFileBytes) return fail("larger than the limit");
+    if (std::memcmp(bytes.data(), kMagic, 8) != 0) return fail("not a recipe file");
+    Reader h{bytes.substr(0, kHeaderBytes)};
+    h.at = 8;
+    uint32_t schema = h.u32(), encoding = h.u32(), count = h.u32();
+    h.u32();
+    FileInfo fi;
+    fi.profile = h.u64(), fi.vendor = h.u32(), fi.device = h.u32(), fi.driver = h.u32();
+    h.u32();
+    uint64_t length = h.u64();
+    Digest stored;
+    h.bytes(stored.data(), 20);
+    if (schema != kSchema) return fail("another schema");
+    if (encoding != kKeyEncoding) return fail("another key encoding");
+    if (count > kMaxRecipes) return fail("too many recipes");
+    if (length != bytes.size() - kHeaderBytes) return fail("truncated or extended payload");
+    std::string_view payload = bytes.substr(kHeaderBytes);
+    if (sha1(payload) != stored) return fail("payload checksum mismatch");
+    Reader r{payload};
+    PipelineKey scratch;
+    for (uint32_t n = 0; n < count; n++) {
+        uint32_t size = r.u32();
+        std::string_view rec_bytes = r.take(size);
+        if (!r.ok) return fail("record past the end");
+        Reader rec{rec_bytes};
+        Recipe x;
+        x.order = rec.u32(), x.runs = rec.u32();
+        size_t vs_len = rec.u8();
+        if (vs_len == 0 || vs_len > kMaxHashBytes) return fail("bad vertex stage name");
+        x.vs.hash = std::string(rec.take(vs_len));
+        rec.bytes(x.vs.digest.data(), 20);
+        uint8_t has_fs = rec.u8();
+        if (has_fs > 1) return fail("bad fragment stage flag");
+        if (has_fs) {
+            size_t fs_len = rec.u8();
+            if (fs_len == 0 || fs_len > kMaxHashBytes) return fail("bad fragment stage name");
+            x.fs.hash = std::string(rec.take(fs_len));
+            rec.bytes(x.fs.digest.data(), 20);
+        }
+        uint32_t state_len = rec.u32();
+        x.state = std::string(rec.take(state_len));
+        if (!rec.ok || rec.at != rec_bytes.size()) return fail("malformed record");
+        if (!decode_state(x.state, scratch)) return fail("malformed pipeline state");
+        out.push_back(std::move(x));
+    }
+    if (r.at != payload.size()) return fail("bytes after the last record");
+    if (info) *info = fi;
+    return true;
+}
+
+bool read_whole_file(const std::string& path, std::string& bytes, size_t limit) {
+    bytes.clear();
+    FILE* f = plat::fopen_utf8(path, "rb");
+    if (!f) return false;
+    plat::fseek64(f, 0, SEEK_END);
+    int64_t n = plat::ftell64(f);
+    plat::fseek64(f, 0, SEEK_SET);
+    bool ok = n >= 0 && uint64_t(n) <= limit;
+    if (ok) {
+        bytes.resize(size_t(n));
+        ok = std::fread(bytes.data(), 1, bytes.size(), f) == bytes.size();
+    }
+    std::fclose(f);
+    if (!ok) bytes.clear();
+    return ok;
+}
+
+bool write_atomic(const std::string& path, const std::string& bytes, std::string* why) {
+    const std::string tmp = path + ".tmp";
+    FILE* f = plat::fopen_utf8(tmp, "wb");
+    if (!f) {
+        if (why) *why = "cannot create the temporary file";
+        return false;
+    }
+    bool ok = std::fwrite(bytes.data(), 1, bytes.size(), f) == bytes.size();
+    ok = std::fflush(f) == 0 && ok;
+#ifdef _WIN32
+    ok = _commit(_fileno(f)) == 0 && ok;  // on disk before it replaces the old file
+#endif
+    ok = std::fclose(f) == 0 && ok;
+    if (!ok) {
+        std::remove(tmp.c_str());
+        if (why) *why = "temporary file write failed";
+        return false;
+    }
+#ifdef _WIN32
+    auto wide = [](const std::string& s) {
+        int n = MultiByteToWideChar(CP_UTF8, 0, s.c_str(), -1, nullptr, 0);
+        std::wstring w(n > 0 ? size_t(n) : 0, L'\0');
+        if (n > 0) MultiByteToWideChar(CP_UTF8, 0, s.c_str(), -1, w.data(), n);
+        if (!w.empty()) w.pop_back();
+        return w;
+    };
+    ok = MoveFileExW(wide(tmp).c_str(), wide(path).c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+#else
+    ok = std::rename(tmp.c_str(), path.c_str()) == 0;  // atomic on POSIX
+#endif
+    if (!ok) {
+        std::remove(tmp.c_str());
+        if (why) *why = "replacing the file failed";
+    }
+    return ok;
+}
+
+std::vector<Recipe> merge_for_save(const std::vector<Recipe>& used, const std::vector<Recipe>& older, size_t cap) {
+    std::vector<Recipe> out;
+    std::unordered_map<std::string, uint32_t> runs;
+    for (const Recipe& r : older) runs.emplace(merge_key(r), r.runs);
+    std::unordered_set<std::string> kept;
+    for (const Recipe& r : used) {
+        if (out.size() >= cap) break;
+        std::string key = merge_key(r);
+        if (!kept.insert(key).second) continue;
+        Recipe x = r;
+        auto it = runs.find(key);
+        x.runs = it == runs.end() ? 1 : std::min<uint32_t>(it->second, 0xFFFFFFFEu) + 1;
+        x.order = uint32_t(out.size());
+        out.push_back(std::move(x));
+    }
+    std::vector<const Recipe*> rest;
+    for (const Recipe& r : older)
+        if (!kept.count(merge_key(r))) rest.push_back(&r);
+    std::stable_sort(rest.begin(), rest.end(), [](const Recipe* a, const Recipe* b) { return a->order < b->order; });
+    for (const Recipe* r : rest) {
+        if (out.size() >= cap) break;
+        if (!kept.insert(merge_key(*r)).second) continue;
+        Recipe x = *r;
+        x.order = uint32_t(out.size());
+        out.push_back(std::move(x));
+    }
+    return out;
+}
