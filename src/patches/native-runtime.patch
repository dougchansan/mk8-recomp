+ request.frame.entry=c->pc;request.frame.return_pc=c->x[30];request.frame.sp=c->x[31];
+ request.frame.pending_svc=c->pending_svc;request.frame.chain_budget=c->chain_budget;
+ request.frame.fpcr=c->fpcr;request.frame.fpsr=c->fpsr;request.frame.x0=c->x[0];
+ request.frame.v0[0]=c->vreg[0][0];request.frame.v0[1]=c->vreg[0][1];
+ for(i=0;i<14;i++)request.frame.gpr[i]=c->x[18+i];
+ for(i=0;i<8;i++){request.frame.simd[i][0]=c->vreg[8+i][0];request.frame.simd[i][1]=c->vreg[8+i][1];}
+ if(!b || !request.module_epoch || (c->x[31]&15) || c->pending_svc!=~UINT64_C(0) ||
+    module_base>UINT64_MAX-descriptor->relative_entry || c->pc!=module_base+descriptor->relative_entry ||
+    !b->identify(b->user,c,&request.thread_id,&request.context_generation,&request.validation_epoch) ||
+    !request.thread_id || !request.context_generation || !request.validation_epoch || !recomp_np_valid_v3(c,&request,0)){
+  if(descriptor->comparison_mode)return 0;
+  c->halted=RECOMP_HALT_NATIVE_UNSUPPORTED_V3;return 1;
+ }
+ if(!b->admit(b->user,c,&request,&reply) || reply.state==RECOMP_NATIVE_V3_DECLINE){
+  if(descriptor->comparison_mode)return 0;
+  c->halted=RECOMP_HALT_NATIVE_UNSUPPORTED_V3;return 1;
+ }
+ recomp_np_add_v3(&recomp_native_pending_counters_v3.calls,1);
+ if(reply.reserved || (reply.state!=RECOMP_NATIVE_V3_FAILED && reply.state!=RECOMP_NATIVE_V3_CANCELLED && !reply.token)){
+  recomp_np_terminal_v3(c,&request,0);return 1;
+ }
+ if(reply.state==RECOMP_NATIVE_V3_READY){recomp_np_commit_v3(c,&request,&reply);return 1;}
+ if(reply.state==RECOMP_NATIVE_V3_FAILED || reply.state==RECOMP_NATIVE_V3_CANCELLED){recomp_np_add_v3(&recomp_native_pending_counters_v3.work_units,reply.work_units);recomp_np_terminal_v3(c,&request,reply.state==RECOMP_NATIVE_V3_CANCELLED);return 1;}
+ if(reply.state!=RECOMP_NATIVE_V3_PENDING){recomp_np_terminal_v3(c,&request,0);return 1;}
+ recomp_np_restore_v3(c,&request);c->pc=request.frame.entry;c->halted=RECOMP_HALT_NATIVE_PENDING_V3;
+ recomp_np_add_v3(&recomp_native_pending_counters_v3.pending_jobs,1);recomp_np_add_v3(&recomp_native_pending_counters_v3.yields,1);
+ return 1;
+}
+static int recomp_np_current_v3(GuestContext* c,const RecompNativePendingRequestV3* request,uint64_t token,uint64_t thread,uint64_t generation,uint64_t active_token){
+ if(!request || !token || token!=active_token || thread!=request->thread_id || generation!=request->context_generation){
+  recomp_np_add_v3(&recomp_native_pending_counters_v3.late_completions,1);return RECOMP_NATIVE_V3_STALE;
+ }
+ if(c->halted==RECOMP_HALT_NATIVE_FAILED_V3)return RECOMP_NATIVE_V3_TERMINAL_FAILED;
+ if(c->halted==RECOMP_HALT_NATIVE_CANCELLED_V3)return RECOMP_NATIVE_V3_TERMINAL_CANCELLED;
+ if(c->halted==RECOMP_HALT_NATIVE_UNSUPPORTED_V3)return RECOMP_NATIVE_V3_UNSUPPORTED;
+ if(c->halted!=RECOMP_HALT_NATIVE_PENDING_V3){recomp_np_add_v3(&recomp_native_pending_counters_v3.late_completions,1);return RECOMP_NATIVE_V3_NOT_PENDING;}
+ return RECOMP_NATIVE_V3_PARKED;
+}
+int recomp_native_pending_poll_v3(GuestContext* c,const RecompNativePendingRequestV3* request,uint64_t token,uint64_t thread,uint64_t generation,uint64_t active_token){
+ RecompNativePendingReplyV3 reply={0};const RecompNativePendingBindingV3* b=recomp_native_pending_binding_v3;
+ int state=recomp_np_current_v3(c,request,token,thread,generation,active_token);if(state!=RECOMP_NATIVE_V3_PARKED)return state;
+ if(c->pc!=request->frame.entry || c->x[31]!=request->frame.sp)return recomp_np_terminal_v3(c,request,0);
+ if(!token || !recomp_np_valid_v3(c,request,token))return recomp_np_terminal_v3(c,request,0);
+ if(!b->poll(b->user,request,token,&reply) || reply.reserved || reply.token!=token)return recomp_np_terminal_v3(c,request,0);
+ if(reply.state==RECOMP_NATIVE_V3_PENDING)return RECOMP_NATIVE_V3_PARKED;
+ if(reply.state==RECOMP_NATIVE_V3_READY)return recomp_np_commit_v3(c,request,&reply);
+ recomp_np_add_v3(&recomp_native_pending_counters_v3.work_units,reply.work_units);
+ return recomp_np_terminal_v3(c,request,reply.state==RECOMP_NATIVE_V3_CANCELLED);
+}
+int recomp_native_pending_cancel_v3(GuestContext* c,const RecompNativePendingRequestV3* request,uint64_t token,uint64_t thread,uint64_t generation,uint64_t active_token){
+ const RecompNativePendingBindingV3* b=recomp_native_pending_binding_v3;
+ int state=recomp_np_current_v3(c,request,token,thread,generation,active_token);if(state!=RECOMP_NATIVE_V3_PARKED)return state;
+ if(b && request->binding_epoch==recomp_native_pending_epoch_v3)b->cancel(b->user,request,token);
+ return recomp_np_terminal_v3(c,request,1);
+}
+)NP";
+}
