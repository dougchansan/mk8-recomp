+FrameImages::FrameImages(Resources &r, GuestAddress d, uint64_t budget)
+    : impl_(std::make_shared<Impl>(r, d, budget)) {}
+FrameImages::~FrameImages() = default;
+ImageHandle FrameImages::CreateImage(const ImageDescription &d) {
