+        region[0],region[1],region[2],region[3],region[4],region[5],view.base_level,(unsigned long long)row_stride,(unsigned long long)image_stride);
+    if(source->target!=1||source->depth!=1||format_aspect(source->format))
+        throw std::invalid_argument("native texture readback requires uncompressed 2D color");
+    const auto bytes=native_buffer_texture_bytes(source->width,source->height,source->levels,source->format,source->samples,view,region,0);
+    const auto rows=uint64_t(region[4]),row_bytes=bytes/rows;
+    if(!row_stride)row_stride=row_bytes;
