+      }
+      check(f->host.poll_wait(), "owner poll completes cancel/timeout");
+      before.x[0] = 1u | ((mode ? 117u : 118u) << 9);
+      before.x[1] = 0xffffffff;
+      before.pending_svc = ~UINT64_C(0);
+      check(memcmp(&before, &f->host.context, sizeof(before)) == 0 &&
+                !f->host.waiting(),
+            "queued wait exact result/index canaries zero extension");
+    }
+    for (auto count :
+         {uint64_t(65), uint64_t(0xffffffff), UINT64_C(0x123400000001)}) {
+      auto f = std::make_unique<Fixture>();
