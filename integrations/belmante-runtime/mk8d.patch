+// The recipe engine (nvn_pipeline_recipes.h): records the graphics pipelines a run makes, loads the last run's
+// recipes and builds them on bounded background workers, and hands them to the draws that need them.
+//
+// Workers never take the GPU lock: they build from their own copies of the stages (the offline .spv files, checked
+// against the recipe's digest), their own modules and pipeline layouts, through the same create_graphics_pipeline
+// a draw uses, with the shared (internally synchronized) VkPipelineCache. A draw adopts a pipeline only for a key
+// that encodes to the same value and only when its program's set layouts are the very same handles, so the adopted
+// pipeline is the one the draw would have made.
+#include <algorithm>
+#include <atomic>
+#include <condition_variable>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <tuple>
+#include <unordered_map>
+#include <unordered_set>
+
+#include "native_exit_hooks.h"
+#include "nvn_pipeline_recipes.h"
+#include "platform.h"
+
+#ifdef _WIN32
+#include <windows.h>
+#include <psapi.h>
+#endif
+
+namespace nx::nvn::recipes {
+
+using namespace nx::vk;
+
+namespace {
+
+enum class State : uint8_t { Queued, Building, Ready, Failed, Claimed };
+
+struct Entry {
+    Recipe recipe;
+    State state = State::Queued;
+    VkPipeline pipeline = VK_NULL_HANDLE;
+    std::array<VkDescriptorSetLayout, 4> sets{};  // the layout it was made with
+};
+
+struct Stage {
+    bool tried = false, ok = false;
+    ShaderInfo info;
+    Digest digest{};
+};
+
+using SetKey = std::array<VkDescriptorSetLayout, 4>;
+
+struct Engine {
+    std::mutex lock;
+    std::condition_variable changed;
+    bool started = false, stopping = false, prewarm = false, drained_logged = false;
+    std::string path;
+    FileInfo info;
+    std::unordered_map<std::string, Entry> table;  // value key -> entry; references stay valid
+    std::deque<std::string> queue;                  // value keys, first-use order
+    std::vector<std::string> used_order;            // this run's value keys in first-use order
+    std::unordered_map<std::string, Recipe> used;
+    std::vector<Recipe> older;                      // the loaded file, kept for the next save
+    std::unordered_set<std::string> rejected;       // loaded recipes whose stages changed or vanished
+    std::unordered_map<const ShaderInfo*, Digest> digests;
+    size_t active = 0;
+    uint64_t prewarm_start_ns = 0;
+    Counters c, last_window;
+    uint64_t dirty = 0;
+    std::atomic<bool> saving{false};
+
+    std::mutex stage_lock;  // stages by hash, built once
+    std::map<std::string, std::unique_ptr<Stage>> stages;
+    std::vector<std::pair<std::string, std::vector<uint32_t>>> sources;
+
+    std::mutex module_lock;
+    std::map<std::tuple<Digest, std::string, uint32_t, uint32_t>, VkShaderModule> modules;
+    std::mutex layout_lock;
+    std::map<SetKey, VkPipelineLayout> layouts;
+};
+
+Engine& engine() {
+    static Engine* e = new Engine;  // never destroyed: workers and savers may outlive static destruction
+    return *e;
+}
+
+std::atomic<int> g_mode{-1};
+
+Mode env_mode() {
+    const char* e = std::getenv("NX_PIPELINE_RECIPES");
+    if (!e || !*e || std::strcmp(e, "0") == 0) return Mode::Off;
+    if (std::strcmp(e, "capture") == 0) return Mode::Capture;
+    return Mode::Prewarm;
+}
+
+uint64_t private_bytes() {
+#ifdef _WIN32
+    PROCESS_MEMORY_COUNTERS_EX pmc{};
+    if (GetProcessMemoryInfo(GetCurrentProcess(), reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&pmc), sizeof pmc))
+        return pmc.PrivateUsage;
+#endif
+    return 0;
+}
+
+// The switches that change how a key becomes a pipeline in this build (logged and stored, never a gate).
+uint64_t translation_profile() {
+    uint64_t h = 1469598103934665603ull;
+    auto mix = [&](const char* s) {
+        for (; s && *s; s++) h = (h ^ uint8_t(*s)) * 1099511628211ull;
+        h = (h ^ 0xff) * 1099511628211ull;
+    };
+    for (const char* name : {"NX_INT_ATTRIBS", "NX_CLIP_Z_PATCH", "NX_ULTRAWIDE", "NX_ZERO_VS_OUTPUTS", "NX_INVARIANT",
+                             "NX_FLOAT_CONTROLS", "NX_DYNAMIC_UBO", "NX_NO_ALPHA_TO_COVERAGE", "NX_EQUAL_ALWAYS",
+                             "NX_EQUAL_SLACK", "NX_NO_STENCIL", "NX_R11G11B10_RAW", "NX_RENDER_PASS_OBJECTS"}) {
+        mix(name), mix(std::getenv(name));
+    }
+    const VkPhysicalDeviceFeatures& f = vk_features();
+    char bits[8] = {char('0' + f.depthClamp), char('0' + f.largePoints), char('0' + vk_depth_clip_control()),
+                    char('0' + depth_remap()), 0};
+    mix(bits);
+    return h;
+}
+
+const Digest& digest_of(Engine& e, const ShaderInfo* s) {  // under e.lock
+    auto it = e.digests.find(s);
+    if (it == e.digests.end()) it = e.digests.emplace(s, stage_digest(*s)).first;
+    return it->second;
+}
+
+// The prewarm copy of a stage: its SPIR-V from the fixture's sources or <data root>/spirv/<hash>.spv, reflected as
+// shader_for does. Null when missing, malformed or not the content the recipe was recorded with.
+const ShaderInfo* stage_for(Engine& e, const StageRef& ref) {
+    std::lock_guard guard(e.stage_lock);
+    auto& slot = e.stages[ref.hash];
+    if (!slot) slot = std::make_unique<Stage>();
+    Stage& st = *slot;
+    if (!st.tried) {
+        st.tried = true;
+        std::vector<uint32_t> words;
+        bool found = false;
+        for (const auto& [hash, code] : e.sources)
+            if (hash == ref.hash) words = code, found = true;
+        if (!found && ref.hash.find_first_of("/\\.:") == std::string::npos) {
+            std::string bytes;
+            if (read_whole_file(plat::data_root() + "/spirv/" + ref.hash + ".spv", bytes, 16u << 20) &&
+                !bytes.empty() && bytes.size() % 4 == 0) {
+                words.resize(bytes.size() / 4);
+                std::memcpy(words.data(), bytes.data(), bytes.size());
+                found = true;
+            }
+        }
+        if (found && reflect_spirv(words.data(), words.size(), st.info.refl)) {
+            st.info.hash = ref.hash;
+            st.info.stage = st.info.refl.stage;
+            st.info.spirv = std::move(words);
+            st.digest = stage_digest(st.info);
+            st.ok = true;
+        }
+    }
+    return st.ok && st.digest == ref.digest ? &st.info : nullptr;
+}
+
+VkShaderModule prewarm_module(void* ctx, const ShaderInfo* s, const uint8_t* kinds, uint32_t unwritten,
+                              float point_size) {
+    Engine& e = *static_cast<Engine*>(ctx);
+    const std::string k = module_kinds(kinds);
+    uint32_t point_bits = 0;
+    std::memcpy(&point_bits, &point_size, 4);
+    Digest d;
+    {
+        std::lock_guard guard(e.stage_lock);
+        d = e.stages.at(s->hash)->digest;
+    }
+    auto key = std::make_tuple(d, k, unwritten, point_bits);
+    {
+        std::lock_guard guard(e.module_lock);
+        if (auto it = e.modules.find(key); it != e.modules.end()) return it->second;
+    }
+    VkShaderModule m = make_module(s, k, unwritten, point_size, nullptr);  // outside the lock: patching takes time
+    std::lock_guard guard(e.module_lock);
+    auto [it, inserted] = e.modules.emplace(key, m);
+    if (!inserted && m) p_vkDestroyShaderModule(vk_device(), m, nullptr);
+    return it->second;
+}
+
+// The pipeline layout over a program's set layouts, one per distinct tuple of set layouts.
+VkPipelineLayout prewarm_layout(Engine& e, const std::vector<const ShaderInfo*>& stages, SetKey& sets) {
+    ProgramLayout pl;
+    program_set_layouts(stages, pl);
+    std::copy(std::begin(pl.sets), std::end(pl.sets), sets.begin());
+    std::lock_guard guard(e.layout_lock);
+    VkPipelineLayout& l = e.layouts[sets];
+    if (!l) {
+        VkPipelineLayoutCreateInfo ci{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+        ci.setLayoutCount = 4;
+        ci.pSetLayouts = sets.data();
+        if (p_vkCreatePipelineLayout(vk_device(), &ci, nullptr, &l) != VK_SUCCESS) l = VK_NULL_HANDLE;
+    }
+    return l;
+}
+
+// Builds one recipe; false with `rejected` when it cannot describe a pipeline of this build (stages changed or
+// gone, malformed state, or a key the draw path would refuse).
+VkPipeline build(Engine& e, const Recipe& r, SetKey& sets, Feedback& fb, bool& rejected) {
+    rejected = true;
+    const ShaderInfo* vs = stage_for(e, r.vs);
+    const ShaderInfo* fs = r.fs.hash.empty() ? nullptr : stage_for(e, r.fs);
+    if (!vs || vs->stage != ShaderStage::Vertex || (!r.fs.hash.empty() && (!fs || fs->stage != ShaderStage::Fragment)))
+        return VK_NULL_HANDLE;
+    PipelineKey key;
+    if (!decode_state(r.state, key)) return VK_NULL_HANDLE;
+    key.vs = vs, key.fs = fs;
+    if (!graphics_key_admitted(key)) return VK_NULL_HANDLE;
+    std::vector<const ShaderInfo*> program{vs};
+    if (fs) program.push_back(fs);
+    VkPipelineLayout layout = prewarm_layout(e, program, sets);
+    if (!layout) return VK_NULL_HANDLE;
+    rejected = false;
+    return create_graphics_pipeline(key, layout, prewarm_module, &e, nullptr, &fb);
+}
+
+void count_feedback(Counters& c, const Feedback& fb) {
+    if (fb.flags & VK_PIPELINE_CREATION_FEEDBACK_VALID_BIT) {
+        c.feedback_valid++;
+        if (fb.flags & VK_PIPELINE_CREATION_FEEDBACK_APPLICATION_PIPELINE_CACHE_HIT_BIT) c.feedback_hits++;
+    }
+}
+
+// Modules are not needed once their pipelines exist (Vulkan allows destroying them right after creation), nor the
+// stage copies: both are made again if more recipes come.
+void release_prewarm_inputs(Engine& e) {  // under e.lock, no worker active
+    {
+        std::lock_guard guard(e.module_lock);
+        for (auto& [key, module] : e.modules)
+            if (module) p_vkDestroyShaderModule(vk_device(), module, nullptr), e.c.released_modules++;
+        e.modules.clear();
+    }
+    std::lock_guard guard(e.stage_lock);
+    e.stages.clear();
+}
+
+void log_drained(Engine& e) {  // under e.lock, once the queue is empty and no worker builds
+    if (e.drained_logged || !e.prewarm || !e.prewarm_start_ns || e.active || !e.queue.empty()) return;
+    e.drained_logged = true;
+    release_prewarm_inputs(e);
+    log("nvn/vk: pipeline prewarm done in %.1f ms: %llu built (%.1f ms of worker time), %llu failed, %llu rejected, "
+        "%llu claimed by draws first, %llu modules released; private bytes %.1f MB",
+        double(plat::monotonic_ns() - e.prewarm_start_ns) / 1e6, (unsigned long long)e.c.built,
+        double(e.c.build_ns) / 1e6, (unsigned long long)e.c.failed, (unsigned long long)e.c.rejected,
+        (unsigned long long)e.c.claimed, (unsigned long long)e.c.released_modules, double(private_bytes()) / (1 << 20));
+}
+
+void worker(Engine* ep) {
+    Engine& e = *ep;
+    plat::set_thread_name("nx-pipeline-prewarm");
+#ifdef _WIN32
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+#endif
+    std::unique_lock lk(e.lock);
+    for (;;) {
+        if (e.stopping || e.queue.empty()) break;
+        std::string value = std::move(e.queue.front());
+        e.queue.pop_front();
+        Entry& en = e.table.at(value);
+        if (en.state != State::Queued) continue;  // a draw claimed it
+        en.state = State::Building;
+        Recipe r = en.recipe;
+        lk.unlock();
+        SetKey sets{};
+        Feedback fb{};
+        bool rejected = false;
+        const uint64_t t0 = plat::monotonic_ns();
+        VkPipeline p = build(e, r, sets, fb, rejected);
+        const uint64_t dt = plat::monotonic_ns() - t0;
+        lk.lock();
+        en.state = p ? State::Ready : State::Failed;
+        en.pipeline = p, en.sets = sets;
+        if (p) e.c.built++, e.c.build_ns += dt, count_feedback(e.c, fb);
+        else if (rejected) e.c.rejected++, e.rejected.insert(value);
+        else e.c.failed++;
+        e.changed.notify_all();
+    }
+    e.active--;
+    log_drained(e);
+    e.changed.notify_all();
+}
+
+void record_use(Engine& e, const std::string& value, const ShaderInfo* vs, const ShaderInfo* fs) {  // under e.lock
+    if (e.used.count(value)) return;
+    Recipe r;
+    r.vs = {vs->hash, digest_of(e, vs)};
+    if (fs) r.fs = {fs->hash, digest_of(e, fs)};
+    r.state = value.substr(kValuePrefix);
+    r.order = uint32_t(e.used_order.size());
+    e.used_order.push_back(value);
+    e.used.emplace(value, std::move(r));
+    e.c.recorded++;
+    e.dirty++;
+}
+
+void enqueue_locked(Engine& e, const std::vector<Recipe>& list) {
+    for (const Recipe& r : list) {
+        if (e.table.size() >= kMaxRecipes * 2) break;
+        std::string value = value_key(r.vs.digest, r.fs.hash.empty() ? nullptr : &r.fs.digest, r.state);
+        auto [it, inserted] = e.table.try_emplace(value);
+        if (!inserted) continue;
+        it->second.recipe = r;
+        e.queue.push_back(std::move(value));
+        e.c.queued++;
+    }
+}
+
+void start_workers(Engine& e) {  // under e.lock
+    static const unsigned wanted = [] {
+        const char* w = std::getenv("NX_PIPELINE_PREWARM_WORKERS");
+        int n = w ? std::atoi(w) : 2;
+        return unsigned(std::clamp(n, 1, 4));
+    }();
+    if (e.prewarm_start_ns == 0) e.prewarm_start_ns = plat::monotonic_ns();
+    while (e.active < wanted && e.active < e.queue.size()) {
+        e.active++;
+        std::thread(worker, &e).detach();  // the engine outlives them; stop() waits for them
+    }
+}
+
+void exit_hook() { stop(500); }
+
+}  // namespace
+
+Mode mode() {
+    int m = g_mode.load(std::memory_order_acquire);
+    if (m < 0) {
+        int expected = -1;
+        g_mode.compare_exchange_strong(expected, int(env_mode()));
+        m = g_mode.load(std::memory_order_acquire);
+    }
+    return Mode(m);
+}
+
+bool stats_enabled() {
+    static const bool stats = [] {
+        const char* e = std::getenv("NX_PIPELINE_STATS");
+        return e && e[0] == '1';
+    }();
+    return stats || mode() != Mode::Off;
+}
+
+void start() {
+    if (mode() == Mode::Off) return;
+    Engine& e = engine();
+    std::lock_guard guard(e.lock);
+    if (e.started) return;
+    e.started = true;
+    const char* directory = std::getenv("NX_PIPELINE_CACHE_DIR");
+    e.path = (directory && *directory ? std::string(directory) : plat::data_root()) + "/pipeline_recipes_v1.bin";
+    VkPhysicalDeviceProperties p{};
+    p_vkGetPhysicalDeviceProperties(vk_physical(), &p);
+    e.info = {translation_profile(), p.vendorID, p.deviceID, p.driverVersion};
+    add_exit_hook(exit_hook);
+    const bool diagnostics = std::getenv("NX_SPIRV_OPT") || std::getenv("NX_SPIRV_TOOL");
+    e.prewarm = mode() == Mode::Prewarm && !render_pass_objects() && !diagnostics;
+    std::string bytes, why = "no file";
+    FileInfo saved;
+    bool loaded = read_whole_file(e.path, bytes, kMaxFileBytes) && parse(bytes, e.older, &saved, &why);
+    bool have_recipes = loaded;
+    log("nvn/vk: pipeline recipes %s: %s%s, %zu loaded (profile %016llx, saved %016llx)%s", e.path.c_str(),
+        mode() == Mode::Capture ? "capture" : "prewarm", e.prewarm || mode() == Mode::Capture ? "" : " disabled here",
+        e.older.size(), (unsigned long long)e.info.profile, (unsigned long long)(loaded ? saved.profile : 0),
+        loaded ? "" : (" (" + why + ")").c_str());
+    // Import a prior local capture without sharing a mutable cache/data root.
+    // Keep the active file's priority and runs metadata; the catalog is read-only.
+    const char* seed_path = std::getenv("NX_PIPELINE_RECIPE_SEED");
+    if (seed_path && *seed_path && e.path != seed_path) {
+        std::string seed_bytes, seed_why = "unreadable or oversized file";
+        std::vector<Recipe> seed;
+        if (read_whole_file(seed_path, seed_bytes, kMaxFileBytes) && parse(seed_bytes, seed, nullptr, &seed_why)) {
+            std::vector<Recipe> combined = e.older;
+            combined.insert(combined.end(), seed.begin(), seed.end());
+            for (size_t i = 0; i < combined.size(); ++i) combined[i].order = uint32_t(i);
+            e.older = merge_for_save({}, combined, kMaxRecipes);
+            have_recipes = true;
+            log("nvn/vk: pipeline seed catalog %s: %zu entries, %zu merged; read-only", seed_path, seed.size(), e.older.size());
+        } else {
+            log("nvn/vk: pipeline seed catalog %s not loaded: %s", seed_path, seed_why.c_str());
+        }
+    }
+    if (e.prewarm && have_recipes) {
+        enqueue_locked(e, e.older);
+        log("nvn/vk: pipeline prewarm: %zu queued; private bytes %.1f MB", e.queue.size(),
+            double(private_bytes()) / (1 << 20));
+        start_workers(e);
+    }
+}
+
+VkPipeline begin_miss(const PipelineKey& key, const ProgramLayout& layout, Miss& miss) {
+    if (mode() == Mode::Off || !key.vs) return VK_NULL_HANDLE;
+    Engine& e = engine();
+    std::unique_lock lk(e.lock);
+    miss.active = true;
+    miss.vs = key.vs, miss.fs = key.fs;
+    const Digest vs = digest_of(e, key.vs);
+    const Digest fs = key.fs ? digest_of(e, key.fs) : Digest{};
+    miss.value = value_key(vs, key.fs ? &fs : nullptr, encode_state(key));
+    e.c.misses++;
+    auto it = e.table.find(miss.value);
+    if (it == e.table.end()) return VK_NULL_HANDLE;
+    Entry& en = it->second;
+    if (en.state == State::Building) {
+        const uint64_t t0 = plat::monotonic_ns();
+        e.changed.wait(lk, [&] { return en.state != State::Building; });
+        e.c.waited++, e.c.wait_ns += plat::monotonic_ns() - t0;
+    }
+    if (en.state == State::Queued) {
+        en.state = State::Claimed;
+        miss.claimed = true;
+        e.c.claimed++;
+        return VK_NULL_HANDLE;
+    }
+    if (en.state != State::Ready || !en.pipeline) return VK_NULL_HANDLE;
+    if (!std::equal(std::begin(layout.sets), std::end(layout.sets), en.sets.begin())) {
+        e.c.layout_mismatch++;  // another program shape: made by the draw, under its own layout
+        return VK_NULL_HANDLE;
+    }
+    e.c.adopted++;
+    record_use(e, miss.value, key.vs, key.fs);
+    return en.pipeline;
+}
+
+void end_miss(const Miss& miss, const ProgramLayout& layout, VkPipeline made, uint64_t stall_ns, const Feedback& fb) {
+    if (!miss.active) return;
+    Engine& e = engine();
+    std::lock_guard guard(e.lock);
+    e.c.miss_ns += stall_ns;
+    count_feedback(e.c, fb);
+    auto [it, inserted] = e.table.try_emplace(miss.value);
+    Entry& en = it->second;
+    if (inserted || miss.claimed) {  // later misses with the same value (and layout) take this one
+        en.state = made ? State::Ready : State::Failed;
+        en.pipeline = made;
+        std::copy(std::begin(layout.sets), std::end(layout.sets), en.sets.begin());
+        e.changed.notify_all();
+    }
+    if (made) record_use(e, miss.value, miss.vs, miss.fs);
+    log_drained(e);
+}
+
+void note_layout_created(uint64_t ns) {
+    Engine& e = engine();
