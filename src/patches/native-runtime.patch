index 0000000000000000000000000000000000000000..ab515e865f05a65e3d691496e5d34f80746c48ca
--- /dev/null
+++ b/tests/native_entry/generate.cpp
@@ -0,0 +1,51 @@
+#include "core/recompiler/arm64_to_c.h"
+#include <iostream>
+using namespace suyu::recomp;
+using Files = std::map<std::string, std::string>;
+static Files read(const std::filesystem::path& root) {
+    Files result;
+    for (auto& p : std::filesystem::recursive_directory_iterator(root)) {
+        if (!p.is_regular_file()) continue;
+        std::ifstream file(p.path(), std::ios::binary);
+        result[p.path().lexically_relative(root).generic_string()] =
+            {std::istreambuf_iterator<char>(file), {}};
+    }
+    return result;
+}
+int main(int argc, char** argv) {
+    if (argc != 2) return 2;
+    const std::filesystem::path root = argv[1];
+    g_emit_fastmem = true;
+    g_emit_guard_gen = true;
+    // Synthetic query: load x0 from [x0+32], return. No NVN assumption.
+    const uint32_t words[] = {0x14000004,0xd4200000,0xd4200000,0xd4200000,
+                             0xf9401000,0xd65f03c0,0xd4200000,0xd4200000,
+                             0xd61f0280};
+    const std::vector<u64> roots = {0x1010,0x1020};
+    auto emit = [&](const std::string& name, const std::string& id="synthetic-v1") {
+        EmitProject("entry", reinterpret_cast<const u8*>(words), sizeof(words), 0x1000,
+                    (root/name).string(), true, nullptr, 0, nullptr, 0, 0, {}, &roots,
+                    32u<<20, id);
+        return read(root/name);
+    };
+    auto off = emit("off");
+    const NativeEntryDescriptor descriptor{"entry","synthetic-v1",0x1010,7,
+                                           {0xf9401000,0xd65f03c0}};
+    g_emit_native_entries = {descriptor};
+    emit("on");
+    if (emit("wrong-identity","unknown") != off) return 3;
+    for (int mode=0; mode<3; ++mode) {
+        g_emit_native_entries = {descriptor};
+        if(mode==0) g_emit_native_entries[0].words[0]^=0x20;
+        if(mode==1) g_emit_native_entries[0].words.pop_back();
+        if(mode==2) g_emit_native_entries.push_back(descriptor);
+        try { emit("invalid"+std::to_string(mode)); return 4; }
+        catch(const std::runtime_error&) {}
+    }
+    g_emit_native_entries.clear();
+    if(emit("off2") != off) return 5;
+    const uint32_t indirect = 0xd61f0280;
+    EmitProject("entrycaller", reinterpret_cast<const u8*>(&indirect), sizeof(indirect),
+                0x3000, (root/"caller").string(), true);
+    std::cout << "default bytes, identity fallback, full-range and duplicate rejection passed\n";
+}
