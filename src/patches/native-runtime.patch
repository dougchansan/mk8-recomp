+                    ? VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
+                    : VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP;
+  VkViewport viewport{draw.viewport.x,         draw.viewport.y,
+                      draw.viewport.width,     draw.viewport.height,
+                      draw.viewport.min_depth, draw.viewport.max_depth};
+  if (draw.viewport.orientation == ViewportOrientation::InvertY) {
+    viewport.y += viewport.height;
+    viewport.height = -viewport.height;
+  }
+  VkRect2D scissor{{int32_t(draw.scissor.x), int32_t(draw.scissor.y)},
+                   {draw.scissor.width, draw.scissor.height}};
+  VkPipelineViewportStateCreateInfo vp{
+      VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+  vp.viewportCount = 1;
+  vp.pViewports = &viewport;
+  vp.scissorCount = 1;
+  vp.pScissors = &scissor;
+  VkPipelineRasterizationStateCreateInfo raster{
+      VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+  raster.polygonMode = VK_POLYGON_MODE_FILL;
+  raster.cullMode = draw.raster.cull == CullFace::Back ? VK_CULL_MODE_BACK_BIT
+                                                       : VK_CULL_MODE_NONE;
+  raster.frontFace = draw.raster.front == FrontFace::Clockwise
+                         ? VK_FRONT_FACE_CLOCKWISE
+                         : VK_FRONT_FACE_COUNTER_CLOCKWISE;
+  raster.lineWidth = 1;
+  VkPipelineMultisampleStateCreateInfo ms{
+      VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+  ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+  VkPipelineColorBlendAttachmentState ba{};
+  const auto blend_state = EffectiveBlend(draw);
+  ba.colorWriteMask = blend_state.write_mask;
+  if (blend_state.enabled) {
+    ba.blendEnable = VK_TRUE;
+    ba.srcColorBlendFactor = Factor(blend_state.source_rgb);
+    ba.dstColorBlendFactor = Factor(blend_state.destination_rgb);
+    ba.colorBlendOp = VK_BLEND_OP_ADD;
+    ba.srcAlphaBlendFactor = Factor(blend_state.source_alpha);
+    ba.dstAlphaBlendFactor = Factor(blend_state.destination_alpha);
+    ba.alphaBlendOp = VK_BLEND_OP_ADD;
+  }
+  VkPipelineColorBlendStateCreateInfo blend{
+      VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+  blend.attachmentCount = 1;
+  blend.pAttachments = &ba;
+  VkGraphicsPipelineCreateInfo pci{
+      VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+  pci.stageCount = 2;
+  pci.pStages = stages;
+  pci.pVertexInputState = &vi;
+  pci.pInputAssemblyState = &ia;
+  pci.pViewportState = &vp;
+  pci.pRasterizationState = &raster;
+  pci.pMultisampleState = &ms;
+  pci.pColorBlendState = &blend;
+  pci.layout = layout;
+  pci.renderPass = pass;
+  VkPipeline pipeline{};
+  Check(V(vkCreateGraphicsPipelines)(device, VK_NULL_HANDLE, 1, &pci, nullptr,
+                                     &pipeline),
+        "vkCreateGraphicsPipelines");
+  owner.release.push_back([&, device, pipeline] {
+    V(vkDestroyPipeline)(device, pipeline, nullptr);
+  });
+  if (pipeline_only)
+    return {width, height, {}};
+  VkCommandPoolCreateInfo cpci{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+  cpci.queueFamilyIndex = family;
+  VkCommandPool pool{};
+  Check(V(vkCreateCommandPool)(device, &cpci, nullptr, &pool),
+        "vkCreateCommandPool");
+  owner.release.push_back(
+      [&, device, pool] { V(vkDestroyCommandPool)(device, pool, nullptr); });
+  VkCommandBufferAllocateInfo cbai{
+      VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+  cbai.commandPool = pool;
+  cbai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+  cbai.commandBufferCount = 1;
+  VkCommandBuffer cb{};
+  Check(V(vkAllocateCommandBuffers)(device, &cbai, &cb),
+        "vkAllocateCommandBuffers");
+  VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+  begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+  Check(V(vkBeginCommandBuffer)(cb, &begin), "vkBeginCommandBuffer");
+  for (const auto &texture : uploads) {
+    VkImageMemoryBarrier transition{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    transition.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    transition.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    transition.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    transition.srcQueueFamilyIndex = transition.dstQueueFamilyIndex =
+        VK_QUEUE_FAMILY_IGNORED;
+    transition.image = texture.image;
+    transition.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    V(vkCmdPipelineBarrier)(cb, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                            VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0,
+                            nullptr, 1, &transition);
+    VkBufferImageCopy upload{};
+    upload.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    upload.imageExtent = {texture.width, texture.height, 1};
+    V(vkCmdCopyBufferToImage)(cb, texture.buffer, texture.image,
+                              VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &upload);
+    transition.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    transition.newLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    transition.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    transition.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+    V(vkCmdPipelineBarrier)(cb, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                            VK_PIPELINE_STAGE_VERTEX_SHADER_BIT |
+                                VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+                            0, 0, nullptr, 0, nullptr, 1, &transition);
+  }
+  auto transition_image = [&](VkImage handle, VkImageLayout old_layout,
+                              VkImageLayout layout, VkAccessFlags access,
+                              VkPipelineStageFlags stage) {
+    VkImageMemoryBarrier b{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    b.oldLayout = old_layout;
+    b.newLayout = layout;
+    b.srcAccessMask =
+        old_layout == VK_IMAGE_LAYOUT_UNDEFINED
+            ? 0
+            : VK_ACCESS_MEMORY_WRITE_BIT | VK_ACCESS_MEMORY_READ_BIT;
+    b.dstAccessMask = access;
+    b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.image = handle;
+    b.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    V(vkCmdPipelineBarrier)(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, stage, 0, 0,
+                            nullptr, 0, nullptr, 1, &b);
+  };
+  for (const auto &sample : native_samples)
+    transition_image(
+        reinterpret_cast<VkImage>(sample.image), VkImageLayout(sample.layout),
+        VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_ACCESS_SHADER_READ_BIT,
+        VK_PIPELINE_STAGE_VERTEX_SHADER_BIT |
+            VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT);
+  if (target)
+    transition_image(image, VkImageLayout(target->layout),
+                     VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+                     VK_ACCESS_COLOR_ATTACHMENT_READ_BIT |
+                         VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                     VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT);
+  VkClearValue clear{};
+  clear.color.float32[3] = 1;
+  if (target)
+    std::memcpy(clear.color.float32, target->clear, sizeof(target->clear));
+  VkRenderPassBeginInfo rb{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+  rb.renderPass = pass;
+  rb.framebuffer = framebuffer;
+  rb.renderArea = {{0, 0}, {width, height}};
+  rb.clearValueCount = 1;
+  rb.pClearValues = &clear;
+  V(vkCmdBeginRenderPass)(cb, &rb, VK_SUBPASS_CONTENTS_INLINE);
+  V(vkCmdBindPipeline)(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+  VkDeviceSize offset = vertex_binding.offset;
+  if (!draw.procedural_triangle)
+    V(vkCmdBindVertexBuffers)(cb, 0, 1, &vertex, &offset);
+  if (!program.set0.empty())
+    V(vkCmdBindDescriptorSets)(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, layout, 0,
+                               1, &descriptor_set, 0, nullptr);
+  if (draw.index_format == IndexFormat::None)
+    V(vkCmdDraw)(cb, draw.count, 1, draw.first, 0);
+  else {
+    V(vkCmdBindIndexBuffer)(
+        cb, reinterpret_cast<VkBuffer>(index_binding.native_buffer),
+        index_binding.offset,
+        draw.index_format == IndexFormat::Uint16 ? VK_INDEX_TYPE_UINT16
+                                                 : VK_INDEX_TYPE_UINT32);
+    V(vkCmdDrawIndexed)(cb, draw.count, 1, draw.first, draw.base_vertex, 0);
+  }
+  V(vkCmdEndRenderPass)(cb);
+  if (!target) {
+    VkBufferImageCopy copy{};
+    copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    copy.imageExtent = {width, height, 1};
+    V(vkCmdCopyImageToBuffer)(cb, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                              readback, 1, &copy);
+    VkBufferMemoryBarrier barrier{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+    barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+    barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.buffer = readback;
+    barrier.size = VK_WHOLE_SIZE;
+    V(vkCmdPipelineBarrier)(cb, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                            VK_PIPELINE_STAGE_HOST_BIT, 0, 0, nullptr, 1,
+                            &barrier, 0, nullptr);
+  }
+  Check(V(vkEndCommandBuffer)(cb), "vkEndCommandBuffer");
+  VkFenceCreateInfo fci{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+  VkFence fence{};
+  Check(V(vkCreateFence)(device, &fci, nullptr, &fence), "vkCreateFence");
+  owner.release.push_back(
+      [&, device, fence] { V(vkDestroyFence)(device, fence, nullptr); });
+  // This cleanup is registered last, so outstanding GPU work finishes before
+  // any resource destruction.
+  owner.release.push_back([&, device, submitted] {
+    if (*submitted)
+      V(vkDeviceWaitIdle)(device);
+  });
+  VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+  submit.commandBufferCount = 1;
+  submit.pCommandBuffers = &cb;
+  VkSemaphore wait = target
+                         ? reinterpret_cast<VkSemaphore>(target->wait_semaphore)
+                         : VK_NULL_HANDLE;
+  VkSemaphore signal =
+      target ? reinterpret_cast<VkSemaphore>(target->signal_semaphore)
+             : VK_NULL_HANDLE;
+  VkPipelineStageFlags wait_stage =
+      VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+  if (wait) {
+    submit.waitSemaphoreCount = 1;
+    submit.pWaitSemaphores = &wait;
+    submit.pWaitDstStageMask = &wait_stage;
+  }
+  if (signal) {
+    submit.signalSemaphoreCount = 1;
+    submit.pSignalSemaphores = &signal;
+  }
+  if (target && target->submission_attempted)
+    *target->submission_attempted = true;
+  *submitted =
+      true; // Conservatively drain even when submission reports failure.
+  if (target && target->fault == NativeDrawFault::Submit)
+    Check(VK_ERROR_UNKNOWN, "Injected vkQueueSubmit failure");
+  Check(V(vkQueueSubmit)(queue, 1, &submit, fence), "vkQueueSubmit");
+  if (target && target->submission_accepted)
+    *target->submission_accepted = true;
+  if (target && target->after_submit)
+    target->after_submit(target->observer);
+  if (target && target->fault == NativeDrawFault::FenceTimeout)
+    Check(VK_TIMEOUT, "Injected vkWaitForFences timeout");
+  if (target && target->fault == NativeDrawFault::DeviceLost)
+    Check(VK_ERROR_DEVICE_LOST, "Injected vkWaitForFences device loss");
+  if (target && target->pump) {
+    const auto deadline =
+        std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    VkResult result;
+    do {
+      result = V(vkWaitForFences)(device, 1, &fence, VK_TRUE, 1'000'000);
+      target->pump();
+    } while (result == VK_TIMEOUT &&
+             std::chrono::steady_clock::now() < deadline);
+    Check(result, "Pumped vkWaitForFences");
+  } else
+    Check(V(vkWaitForFences)(device, 1, &fence, VK_TRUE, 5'000'000'000ull),
+          "vkWaitForFences");
+  *submitted = false;
+  if (target)
+    return {width, height, {}};
+  DrawResult result{width, height,
+                    std::vector<std::byte>(uint64_t(width) * height * 4)};
+  Check(V(vkMapMemory)(device, readback_memory, 0, result.rgba8.size(), 0,
+                       &mapped),
+        "map readback");
+  std::memcpy(result.rgba8.data(), mapped, result.rgba8.size());
+  V(vkUnmapMemory)(device, readback_memory);
+  return result;
+}
+void ValidateDraw(Resources &r, GuestAddress d, const ProgramDescription &p,
+                  const DrawDescription &draw,
+                  std::span<const NativeSample> samples,
+                  ImageFormat target_format) {
+  Validate(r, d, p, draw, samples, target_format);
+}
+void DrawIntoTarget(Resources &r, GuestAddress d, const ProgramDescription &p,
+                    const DrawDescription &draw, const NativeTarget &target,
+                    std::span<const NativeSample> samples,
+                    std::span<const UniformSnapshot> snapshots) {
+  BuildOffscreen(r, d, p, draw, false, &target, samples, snapshots);
+}
+DrawResult DrawOffscreen(Resources &resources, GuestAddress device,
+                         const ProgramDescription &program,
+                         const DrawDescription &draw) {
+  // Preserve the historical fixture adapter's size contract. Persistent typed
+  // targets use ValidateDraw and the actual device limits instead.
+  Need(draw.width <= 2048 && draw.height <= 2048,
+       "Legacy fixture target size unsupported");
+  return BuildOffscreen(resources, device, program, draw, false);
+}
+void CheckProgramPipeline(Resources &resources, GuestAddress device,
+                          const ProgramDescription &program) {
+  BuildOffscreen(resources, device, program, DrawDescription{}, true);
+}
+} // namespace native_nvn
diff --git a/native-runtime/nvn/draw.h b/native-runtime/nvn/draw.h
new file mode 100644
--- /dev/null
+++ b/native-runtime/nvn/draw.h
@@ -0,0 +1,178 @@
+#pragma once
+#include "resources.h"
+#include <array>
+#include <functional>
+#include <optional>
+#include <vector>
+namespace native_nvn {
+enum class DescriptorKind { UniformBuffer, CombinedImageSampler2D };
+enum class ShaderStage { Vertex, Fragment };
+struct DescriptorPlan {
+  uint32_t binding;
+  DescriptorKind kind;
+  ShaderStage stage;
+};
+struct ProgramDescription {
+  std::span<const uint32_t> vertex, fragment;
+  std::span<const DescriptorPlan> set0;
+};
+struct UniformBinding {
+  uint32_t binding;
+  GuestAddress buffer;
+  uint64_t offset, size;
+};
+struct Texture2D {
+  uint32_t binding, width, height;
+  std::span<const std::byte> rgba8;
+};
+enum class ImageFormat {
+  Rgba8Unorm,
+  R8Unorm,
+  Rg8Unorm,
+  Rgba8Srgb,
+  A2B10G10R10Unorm
+};
+enum ImageUsage : uint32_t {
+  ColorTarget = 1,
+  Sampled = 2,
+  TransferSource = 4,
+  TransferDestination = 8
+};
+uint32_t ImageBytesPerTexel(ImageFormat);
+uint32_t NativeImageFormat(ImageFormat); // Internal Vulkan format mapping.
+struct ImageSupport {
+  uint32_t max_width = 0, max_height = 0;
+  uint64_t max_resource_size = 0;
+  bool linear_filter = false, blend = false;
+};
+ImageSupport QueryImageSupport(Resources &, GuestAddress, ImageFormat,
+                               uint32_t usage);
+void ValidateImageUse(const ImageSupport &, uint32_t width, uint32_t height,
+                      bool linear, bool blend);
+enum class BlendFactor {
+  Zero,
+  One,
+  SourceAlpha,
+  OneMinusSourceAlpha,
+  SourceColor
+};
+enum class BlendEquation { Add };
+struct BlendState {
+  bool enabled = false;
+  BlendFactor source_rgb = BlendFactor::One,
+              destination_rgb = BlendFactor::Zero;
+  BlendFactor source_alpha = BlendFactor::One,
+              destination_alpha = BlendFactor::Zero;
+  BlendEquation rgb_equation = BlendEquation::Add,
+                alpha_equation = BlendEquation::Add;
+  uint32_t write_mask = 15;
+};
+enum class VertexFormat { Float2, Float3, Float4 };
+struct VertexInput {
+  VertexFormat format = VertexFormat::Float4;
+  uint32_t offset = 0, divisor = 0;
+};
+enum class CullFace { None, Back };
+enum class FrontFace { Clockwise, CounterClockwise };
+struct RasterState {
+  CullFace cull = CullFace::None;
+  FrontFace front = FrontFace::CounterClockwise;
+  bool depth_test = false, depth_write = false, stencil = false,
+       depth_bias = false, discard = false;
+};
+enum class ViewportOrientation { PositiveY, InvertY };
+enum class Topology { Triangles, TriangleStrip };
+enum class Blend { Disabled, SourceAlpha };
+enum class IndexFormat { None, Uint16, Uint32 };
+struct Viewport {
+  float x = 0, y = 0, width = 64, height = 64;
+  float min_depth = 0, max_depth = 1;
+  ViewportOrientation orientation = ViewportOrientation::PositiveY;
+};
+struct Scissor {
+  uint32_t x = 0, y = 0, width = 64, height = 64;
+};
+struct DrawDescription {
+  uint32_t width = 64, height = 64;
+  GuestAddress vertices = 0, indices = 0;
+  uint32_t stride = 16, first = 0, count = 3;
+  IndexFormat index_format = IndexFormat::None;
+  Topology topology = Topology::Triangles;
+  Blend blend = Blend::Disabled;
+  Viewport viewport;
+  Scissor scissor;
+  std::span<const UniformBinding> uniforms;
+  std::span<const Texture2D> textures;
+  std::optional<BlendState> blend_state;
+  VertexInput vertex_input;
+  RasterState raster;
+  int32_t base_vertex = 0;
+  bool procedural_triangle = false;
+};
+struct DrawResult {
+  uint32_t width, height;
+  std::vector<std::byte> rgba8;
+};
+// Internal shared backend boundary: handles are borrowed from FrameImages.
+// No persistent image is uploaded/read back here. Queue completion is
+// synchronous.
+struct NativeSample {
+  uint32_t binding, width, height;
+  uintptr_t image, view, sampler;
+  uint32_t layout;
+  ImageFormat format = ImageFormat::Rgba8Unorm;
+  uint32_t mip = 0, mips = 1;
+  bool linear_filter = false;
+};
+struct UniformSnapshot {
+  uint32_t binding;
+  std::span<const std::byte> bytes;
+};
+enum class AttachmentLoad { Load, Clear, Discard };
+enum class AttachmentStore { Store, Discard };
+enum class PresentationFormat { Rgba8Srgb, Bgra8Srgb, Rgba8Unorm, Bgra8Unorm };
+uint32_t NativePresentationFormat(PresentationFormat);
+enum class NativeDrawFault { None, Submit, FenceTimeout, DeviceLost };
+struct NativeTarget {
+  uintptr_t image, view;
+  uint32_t layout;
+  AttachmentLoad load;
+  AttachmentStore store;
+  float clear[4];
+  bool *submission_attempted;
+  bool *submission_accepted;
+  void (*after_submit)(void *) = nullptr;
+  void *observer = nullptr;
+  NativeDrawFault fault = NativeDrawFault::None;
+  ImageFormat format = ImageFormat::Rgba8Unorm;
+  std::optional<PresentationFormat> presentation_format;
+  uintptr_t wait_semaphore = 0, signal_semaphore = 0;
+  std::function<void()> pump;
+};
+void ValidateDraw(Resources &, GuestAddress, const ProgramDescription &,
+                  const DrawDescription &, std::span<const NativeSample> = {},
+                  ImageFormat target_format = ImageFormat::Rgba8Unorm);
+void DrawIntoTarget(Resources &, GuestAddress, const ProgramDescription &,
+                    const DrawDescription &, const NativeTarget &,
+                    std::span<const NativeSample>,
+                    std::span<const UniformSnapshot>);
+BlendState EffectiveBlend(const DrawDescription &);
+// Pure validation supports deterministic unsupported-capability/bounds tests.
+void ValidateTypedState(const DrawDescription &,
+                        const native_graphics::GraphicsCapabilities &);
+// Bounded synchronous single draw. All resource handles remain borrowed only
+// until its fence completes. Caller must complete prior external queue uses.
+// Default vertex input is location0 float4; explicit typed input also supports
+// float2/3. Fixture Texture2D remains nearest/clamp RGBA8; persistent sampled
+// image/view/sampler state is supplied through FrameEncoder.
+// Unknown capabilities, layouts and state fail before GPU submission.
+DrawResult DrawOffscreen(Resources &, GuestAddress device,
+                         const ProgramDescription &, const DrawDescription &);
+// Pure preflight; GPU methods use the backend's actually enabled feature value.
+void ValidateProgram(const ProgramDescription &,
+                     bool enabled_image_gather_extended);
+// Creates/destroys the native pipeline only: no resource contents, commands or
+// image.
+void CheckProgramPipeline(Resources &, GuestAddress device,
+                          const ProgramDescription &);
+} // namespace native_nvn
diff --git a/native-runtime/nvn/draw_test.cpp b/native-runtime/nvn/draw_test.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/nvn/draw_test.cpp
@@ -0,0 +1,217 @@
+#include "draw.h"
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <iostream>
+#include <sirit/sirit.h>
+#include <stdexcept>
+using namespace native_nvn;
+namespace {
+std::vector<uint32_t> Shader(bool vertex) {
+  Sirit::Module m(0x00010000);
+  m.AddCapability(spv::Capability::Shader);
+  m.SetMemoryModel(spv::AddressingModel::Logical, spv::MemoryModel::GLSL450);
+  const auto f = m.TypeFloat(32), v = m.TypeVector(f, 4);
+  const auto out = m.AddGlobalVariable(
+      m.TypePointer(spv::StorageClass::Output, v), spv::StorageClass::Output);
+  Sirit::Id input{}, ubo{}, sampled_type{}, tex0{}, tex1{}, uniform_pointer{};
+  if (vertex) {
+    m.Decorate(out, spv::Decoration::BuiltIn, spv::BuiltIn::Position);
+    input = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Input, v),
+                                spv::StorageClass::Input);
+    m.Decorate(input, spv::Decoration::Location, 0u);
+  } else {
+    m.Decorate(out, spv::Decoration::Location, 0u);
+    auto block = m.TypeStruct(v);
+    m.Decorate(block, spv::Decoration::Block);
+    m.MemberDecorate(block, 0u, spv::Decoration::Offset, 0u);
+    ubo = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Uniform, block),
+                              spv::StorageClass::Uniform);
+    uniform_pointer = m.TypePointer(spv::StorageClass::Uniform, v);
+    m.Decorate(ubo, spv::Decoration::DescriptorSet, 0u);
+    m.Decorate(ubo, spv::Decoration::Binding, 0u);
+    auto image = m.TypeImage(f, spv::Dim::Dim2D, 0, false, false, 1,
+                             spv::ImageFormat::Unknown);
+    sampled_type = m.TypeSampledImage(image);
+    auto pointer =
+        m.TypePointer(spv::StorageClass::UniformConstant, sampled_type);
+    tex0 = m.AddGlobalVariable(pointer, spv::StorageClass::UniformConstant);
+    tex1 = m.AddGlobalVariable(pointer, spv::StorageClass::UniformConstant);
+    m.Decorate(tex0, spv::Decoration::DescriptorSet, 0u);
+    m.Decorate(tex0, spv::Decoration::Binding, 1u);
+    m.Decorate(tex1, spv::Decoration::DescriptorSet, 0u);
+    m.Decorate(tex1, spv::Decoration::Binding, 2u);
+  }
+  auto uv = m.ConstantComposite(m.TypeVector(f, 2), m.Constant(f, 0.5f),
+                                m.Constant(f, 0.5f));
+  auto zero = m.Constant(m.TypeInt(32, false), 0u);
+  auto fn = m.OpFunction(m.TypeVoid(), spv::FunctionControlMask::MaskNone,
+                         m.TypeFunction(m.TypeVoid()));
+  m.AddLabel();
+  if (vertex)
+    m.OpStore(out, m.OpLoad(v, input));
+  else {
+    auto tint = m.OpLoad(v, m.OpAccessChain(uniform_pointer, ubo, zero));
+    auto first =
+        m.OpImageSampleImplicitLod(v, m.OpLoad(sampled_type, tex0), uv);
+    auto second =
+        m.OpImageSampleImplicitLod(v, m.OpLoad(sampled_type, tex1), uv);
+    m.OpStore(out, m.OpFMul(v, m.OpFMul(v, first, second), tint));
+  }
+  m.OpReturn();
+  m.OpFunctionEnd();
+  if (vertex)
+    m.AddEntryPoint(spv::ExecutionModel::Vertex, fn, "main", input, out);
+  else {
+    m.AddEntryPoint(spv::ExecutionModel::Fragment, fn, "main", out);
+    m.AddExecutionMode(fn, spv::ExecutionMode::OriginUpperLeft);
+  }
+  return m.Assemble();
+}
+struct Memory {
+  std::array<std::byte, 4096> bytes{};
+  static bool Read(void *user, uint64_t address, std::span<std::byte> out) {
+    auto &memory = *static_cast<Memory *>(user);
+    if (address < 0x10000 || address - 0x10000 > memory.bytes.size() ||
+        out.size() > memory.bytes.size() - (address - 0x10000))
+      return false;
+    std::copy_n(memory.bytes.begin() + address - 0x10000, out.size(),
+                out.begin());
+    return true;
+  }
+  static bool Write(void *, uint64_t, std::span<const std::byte>) {
+    return false;
+  }
+};
+void Check(bool value, const char *why) {
+  if (!value)
+    throw std::runtime_error(why);
+}
+void Pixels(const DrawResult &result, unsigned green, bool scissor = false) {
+  for (uint32_t y = 0; y < result.height; y++)
+    for (uint32_t x = 0; x < result.width; x++) {
+      auto pixel = result.rgba8.data() + 4 * (y * result.width + x);
+      auto expected =
+          scissor && (x < 16 || x >= 48 || y < 16 || y >= 48) ? 0 : green;
+      Check(pixel[0] == std::byte{} && pixel[2] == std::byte{} &&
+                pixel[3] == std::byte{255} &&
+                std::abs(int(pixel[1]) - int(expected)) <= 1,
+            "Textured/uniform pixel mismatch");
+    }
+}
+} // namespace
+int main() {
+  try {
+    Memory memory;
+    const float vertices[12] = {-1, -1, 0, 1, 3, -1, 0, 1, -1, 3, 0, 1};
+    const uint16_t indices16[3] = {0, 1, 2};
+    const uint32_t indices32[3] = {0, 1, 2};
+    const float tint[4] = {0, 1, 0, 1};
+    std::memcpy(memory.bytes.data(), vertices, sizeof(vertices));
+    std::memcpy(memory.bytes.data() + 128, indices16, sizeof(indices16));
+    std::memcpy(memory.bytes.data() + 256, indices32, sizeof(indices32));
+    std::memcpy(memory.bytes.data() + 512, tint, sizeof(tint));
+    Resources resources({&memory, Memory::Read, Memory::Write});
+    resources.CreateDevice(0x1000);
+    resources.CreatePool(0x2000, {0x1000, 0x10000, 4096, CpuAccess::Cached});
+    resources.CreateBuffer(0x3000, {0x1000, 0x2000, 0, 48});
+    resources.CreateBuffer(0x3010, {0x1000, 0x2000, 128, 6});
+    resources.CreateBuffer(0x3020, {0x1000, 0x2000, 256, 12});
+    resources.CreateBuffer(0x3030, {0x1000, 0x2000, 512, 16});
+    auto vertex = Shader(true), fragment = Shader(false);
+    const DescriptorPlan plan[] = {
+        {0, DescriptorKind::UniformBuffer, ShaderStage::Fragment},
+        {1, DescriptorKind::CombinedImageSampler2D, ShaderStage::Fragment},
+        {2, DescriptorKind::CombinedImageSampler2D, ShaderStage::Fragment}};
+    const std::array<std::byte, 4> white = {std::byte{255}, std::byte{255},
+                                            std::byte{255}, std::byte{255}};
+    const std::array<std::byte, 4> green = {std::byte{255}, std::byte{128},
+                                            std::byte{255}, std::byte{255}};
+    const Texture2D textures[] = {{1, 1, 1, white}, {2, 1, 1, green}};
+    const UniformBinding uniforms[] = {{0, 0x3030, 0, 16}};
+    ProgramDescription program{vertex, fragment, plan};
+    DrawDescription draw;
+    draw.vertices = 0x3000;
+    draw.uniforms = uniforms;
+    draw.textures = textures;
+    unsigned draws = 0, rejected = 0;
+    auto reject = [&](auto action) {
+      try {
+        action();
+      } catch (const std::runtime_error &) {
+        ++rejected;
+        return;
+      }
+      throw std::runtime_error("Expected draw rejection");
+    };
+    auto gather = vertex;
+    gather.insert(gather.begin() + 5, {(2u << 16) | 17u, 25u});
+    ProgramDescription gather_program{gather, fragment, plan};
+    reject([&] { ValidateProgram(gather_program, false); });
+    ValidateProgram(gather_program, true);
+    auto core = vertex;
+    core.insert(core.begin() + 5,
+                {(2u << 16) | 17u, 46u, (2u << 16) | 17u, 50u});
+    ValidateProgram({core, fragment, plan}, false);
+    Pixels(DrawOffscreen(resources, 0x1000, program, draw), 128);
+    ++draws;
+    draw.index_format = IndexFormat::Uint16;
+    draw.indices = 0x3010;
+    Pixels(DrawOffscreen(resources, 0x1000, program, draw), 128);
+    ++draws;
+    draw.index_format = IndexFormat::Uint32;
+    draw.indices = 0x3020;
+    draw.topology = Topology::TriangleStrip;
+    Pixels(DrawOffscreen(resources, 0x1000, program, draw), 128);
+    ++draws;
+    draw.scissor = {16, 16, 32, 32};
+    Pixels(DrawOffscreen(resources, 0x1000, program, draw), 128, true);
+    ++draws;
+    draw.scissor = {0, 0, 64, 64};
+    draw.blend = Blend::SourceAlpha;
+    float alpha = 0.5f;
+    std::memcpy(memory.bytes.data() + 512 + 12, &alpha, 4);
+    resources.FlushBuffer(0x3030, 0, 16);
+    Pixels(DrawOffscreen(resources, 0x1000, program, draw), 64);
+    ++draws;
+    auto invalid = draw;
+    invalid.count = 4;
+    reject([&] { DrawOffscreen(resources, 0x1000, program, invalid); });
+    invalid = draw;
+    invalid.viewport.width = -1;
+    reject([&] { DrawOffscreen(resources, 0x1000, program, invalid); });
+    invalid = draw;
+    invalid.stride = 4;
+    reject([&] { DrawOffscreen(resources, 0x1000, program, invalid); });
+    invalid = draw;
+    invalid.width = 4096;
+    reject([&] { DrawOffscreen(resources, 0x1000, program, invalid); });
+    auto unsupported = vertex;
+    unsupported[6] = 11;
+    ProgramDescription bad{unsupported, fragment, plan};
+    reject([&] { DrawOffscreen(resources, 0x1000, bad, draw); });
+    ProgramDescription missing{vertex, fragment, {}};
+    reject([&] { DrawOffscreen(resources, 0x1000, missing, draw); });
+    const UniformBinding short_uniform[] = {{0, 0x3030, 0, 4}};
+    invalid = draw;
+    invalid.uniforms = short_uniform;
+    reject([&] { DrawOffscreen(resources, 0x1000, program, invalid); });
+    auto broken = vertex;
+    broken[5] = 0;
+    bad = {broken, fragment, plan};
+    reject([&] { DrawOffscreen(resources, 0x1000, bad, draw); });
+    auto memory_before = memory.bytes;
+    uint32_t invalid_index = 99;
+    std::memcpy(memory.bytes.data() + 256, &invalid_index, 4);
+    resources.FlushBuffer(0x3020, 0, 12);
+    reject([&] { DrawOffscreen(resources, 0x1000, program, draw); });
+    std::cout << "{\"passed\":true,\"native_draws\":" << draws
+              << ",\"uniforms\":1,\"combined_textures\":2,\"pixels_checked\":"
+              << draws * 4096 << ",\"rejected\":" << rejected
+              << ",\"actual_game_inputs\":false}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
