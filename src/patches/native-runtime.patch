+    const auto peer=m.Get(12);CHECK(peer==0x10003);
+    m.bytes.fill(std::byte{});m.Put(0,2);
+    CHECK(r.Send(apm,m.Bus(),0x1000,42).status==Status::Ok);
+    CHECK(r.Close(apm).status==Status::Ok); // Child sessions share independent policy lifetime.
+    m.Request(1);m.Put(32,1);
+    CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::Ok && m.Get(32)==0x20003);
+    m.Request(0);m.Put(32,1);m.Put(36,0x92220009);m.writable=false;
+    CHECK(r.Send(session,m.Bus(),0x1000,42).status==Status::MemoryFault);
