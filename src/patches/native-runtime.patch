+    host.register_current_thread(7, 44, 0);
+    for (unsigned i = 0; i < 32; ++i)
+      host.context.x[i] = 0x100 + i;
+    host.context.x[0] = 0x9000;
+    host.context.x[1] = 16;
+    host.context.x[20] = 0x1000;
+    host.context.x[21] = 0x5000;
+    host.context.x[30] = 0x5000;
+    host.context.x[31] = 0x8000;
+    host.context.pc = entry;
+    host.modules = {{"pending", recomp_image_lookup, recomp_image_run_slice},
+                    {"caller", recomp_image_lookup_pendingcaller,
+                     recomp_image_run_slice_pendingcaller},
+                    {"terminal", end_lookup, terminal}};
+    recomp_image_set_base(0);
+    recomp_image_set_base_pendingcaller(0);
+    check(recomp_image_guard_v2(2) == 2 &&
+              recomp_image_guard_v2_pendingcaller(2) == 2,
+          "guard negotiation");
+#ifdef RECOMP_FEATURE_GUARD_GEN1
+    uint64_t lo = 0, end = 0;
+    const uint64_t *base = nullptr;
+    auto *generation_word = recomp_image_guard_gen_v1(2, &lo, &end, &base);
+    auto *caller_generation =
+        recomp_image_guard_gen_v1_pendingcaller(2, &lo, &end, &base);
+    check(generation_word && caller_generation && recomp_image_features() == 7,
+          "native profile GG/features");
+    check(recomp_image_fastmem_v1(12, 5, RECOMP_FM_PTR_MASK,
+                                  offsetof(GuestContext, fm_table),
+                                  offsetof(GuestContext, fm_limit)) &&
+              recomp_image_fastmem_v1_pendingcaller(
+                  12, 5, RECOMP_FM_PTR_MASK, offsetof(GuestContext, fm_table),
+                  offsetof(GuestContext, fm_limit)),
+          "FM handshake");
+    check(recomp_image_fpx_v1(offsetof(GuestContext, fpcr),
+                              offsetof(GuestContext, fpsr),
+                              RECOMP_FPX_INHIBIT) &&
+              recomp_image_fpx_v1_pendingcaller(offsetof(GuestContext, fpcr),
+                                                offsetof(GuestContext, fpsr),
+                                                RECOMP_FPX_INHIBIT),
+          "FPX handshake");
+#endif
+    acknowledge();
+    host.seal_code();
+#ifdef RECOMP_FEATURE_GUARD_GEN1
+    RECOMP_GG_STORE_RELEASE(*generation_word, 1);
+    RECOMP_GG_STORE_RELEASE(*caller_generation, 1);
+#endif
+    auto scheduler = std::make_unique<PendingOwnerV3>(host, work);
+    owner = scheduler.get();
+    host.pending_scheduler = std::move(scheduler);
+    check(owner->bind(), "owner binding");
+  }
+  void park(unsigned budget) {
+    host.dispatch(budget, 64);
+    check(host.context.halted == RECOMP_HALT_NATIVE_PENDING_V3 &&
+              owner->token() != 0,
+          "emitted entry parks");
+    check(work->snapshots == 1 && work->snapshot_in_guest && work->runs == 0 &&
+              work->commits == 0,
+          "admit copied before unwind, work deferred");
+  }
+};
+static void unchanged_terminal(Fixture &f, int halt) {
+  check(f.host.context.halted == halt, "exact terminal halt");
+  auto context = f.host.context;
+  auto blocks = f.host.blocks, slices = f.host.slices;
+  auto runs = f.work->runs, commits = f.work->commits,
+       snapshots = f.work->snapshots;
+  for (unsigned i = 0; i < 3; ++i)
+    check(rejects([&] { f.host.dispatch(4096, 64); }),
+          "terminal redispatch rejects");
