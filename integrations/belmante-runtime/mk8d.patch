+namespace nx {
+inline bool native_thread_priority_enabled(){
+#if defined(_WIN32)
+ static const bool enabled=[] {const char* e=std::getenv("NX_NATIVE_THREAD_PRIORITY");return e&&e[0]=='1';}();return enabled;
+#else
+ return false;
+#endif
+}
+inline void apply_native_thread_priority(int64_t tid,int priority,bool announce=false){
+#if defined(_WIN32)
+ if(!native_thread_priority_enabled()||tid<=0||uint64_t(tid)>0xffffffffull||priority<0||priority>63)return;
+ // Bounded relative priorities only. Keep the process class unchanged and do
+ // not request REALTIME or TIME_CRITICAL scheduling.
+ const int level=priority<24?THREAD_PRIORITY_HIGHEST:priority<40?THREAD_PRIORITY_ABOVE_NORMAL:priority<48?THREAD_PRIORITY_NORMAL:priority<56?THREAD_PRIORITY_BELOW_NORMAL:THREAD_PRIORITY_LOWEST;
+ const bool self=DWORD(tid)==GetCurrentThreadId();
+ HANDLE thread=self?GetCurrentThread():OpenThread(THREAD_SET_INFORMATION|THREAD_QUERY_LIMITED_INFORMATION,FALSE,DWORD(tid));
+ if(!thread){log("native thread priority: tid=%llu guest=%d applied=0 error=%lu",(unsigned long long)tid,priority,GetLastError());return;}
+ DWORD status=0;const bool owned=GetProcessIdOfThread(thread)==GetCurrentProcessId();
+ const bool active=owned&&GetExitCodeThread(thread,&status)&&status==STILL_ACTIVE;
+ const bool applied=active&&SetThreadPriority(thread,level);const DWORD error=applied?0:GetLastError();
+ const int actual=applied?GetThreadPriority(thread):THREAD_PRIORITY_ERROR_RETURN;
+ if(!self)CloseHandle(thread);
+ static const bool trace=[] {const char* e=std::getenv("NX_TRACE_THREAD_PRIORITY");return e&&e[0]=='1';}();
+ if(announce||trace||!applied)log("native thread priority: tid=%llu guest=%d requested=%d actual=%d applied=%u error=%lu",(unsigned long long)tid,priority,level,actual,unsigned(applied),error);
+#else
+ (void)tid;(void)priority;(void)announce;
+#endif
+}
+}
