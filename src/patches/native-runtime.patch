+++ b/native-runtime/textures/test_cli.py
@@ -0,0 +1,44 @@
+"""Synthetic CLI collision/no-overwrite regression; no title content."""
+import json
+import os
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+
+executable, build = Path(sys.argv[1]), Path(sys.argv[2]).resolve()
+with tempfile.TemporaryDirectory(prefix="texture-cli-", dir=build) as temporary:
+    root = Path(temporary).resolve()
+    assert root.is_relative_to(build)
+    words = [8 | (2 << 7) | (2 << 10) | (2 << 13) | (2 << 16) |
+             (2 << 19) | (3 << 22) | (4 << 25) | (5 << 28), 0, 2 << 21, 1,
+             (1 << 23) | (7 << 29), 1 << 31, 0, 0]
+    descriptor, storage = root / "input.tic", root / "input.storage"
+    descriptor.write_bytes(struct.pack("<8I", *words))
+    storage.write_bytes(bytes(range(32)))
+
+    def run(first, second, expected):
+        result = subprocess.run([str(executable), str(descriptor), str(storage), str(first), str(second)],
+                                capture_output=True, text=True)
+        assert result.returncode == expected, (result.stdout, result.stderr)
+
+    output = root / "result.bin"
+    run(output, output, 1)
+    assert not output.exists()
+    sub = root / "sub"
+    sub.mkdir()
+    run(output, sub / ".." / "result.bin", 1)
+    assert not output.exists()
+    if os.name == "nt":
+        run(output, root / "RESULT.BIN", 1)
+        assert not output.exists()
+    output.write_bytes(b"sentinel")
+    run(output, root / "unused.json", 1)
+    assert output.read_bytes() == b"sentinel" and not (root / "unused.json").exists()
+    texels, metadata = root / "new.bin", root / "new.json"
+    run(texels, metadata, 0)
+    assert texels.read_bytes() == bytes(range(4))
+    value = json.loads(metadata.read_text())
+    assert value["format"] == "RGBA8_UNORM" and value["bytes"] == 4
+print("PASS exclusive outputs, normalized/case aliases, preserved existing files and complete output")
