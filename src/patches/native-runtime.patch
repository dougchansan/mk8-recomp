+// SPDX-FileCopyrightText: Copyright 2026 suyu Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "router.h"
+#include <filesystem>
+
+namespace native_services {
+struct LogRecord {
+    uint64_t process_id{}, claimed_process_id{}, thread_id{};
+    uint32_t destination{};
+    uint8_t flags{}, severity{}, verbosity{};
+    std::vector<std::byte> packet;
+    std::string text;
+};
+class LogSink {
+public:
+    virtual ~LogSink() = default;
+    // Must actually deliver the record, or fail. Failure stops bring-up before
+    // returning to guest code; logging success is never silently fabricated.
+    virtual bool Deliver(const LogRecord&) = 0;
+};
+// Creates a new file exclusively. Never overwrites or appends an existing file.
+// Caller supplies an explicitly owned diagnostic output path.
+std::shared_ptr<LogSink> CreateFileLogSink(const std::filesystem::path& path,
+                                        uint64_t max_bytes = 8u << 20,
+                                        uint64_t max_records = 4096);
+std::unique_ptr<Endpoint> CreateLoggingService(std::shared_ptr<LogSink> sink);
+} // namespace native_services
diff --git a/native-runtime/services/router.cpp b/native-runtime/services/router.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..da00167ff9799ff19e0eb9e1f87c26a8fab1a947
--- /dev/null
+++ b/native-runtime/services/router.cpp
@@ -0,0 +1,210 @@
+// SPDX-FileCopyrightText: Copyright 2026 suyu Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Wire layout follows src/core/hle/ipc.h, service/ipc_helpers.h and
+// service/hle_ipc.cpp; SM command meanings follow service/sm/sm.cpp.
+#include "router.h"
+#include <array>
+#include <limits>
+#include <stdexcept>
+
+namespace native_services {
+namespace {
+constexpr uint32_t Result(unsigned description) { return 1u | (description << 9); }
+Outcome Failure(Status status, std::string diagnostic) {
+    unsigned description = 14;
+    if (status == Status::Unsupported) description = 33;
+    if (status == Status::InvalidHandle) description = 114;
+    if (status == Status::MemoryFault) description = 102;
+    if (status == Status::InvalidState || status == Status::InvalidProcess) description = 125;
+    if (status == Status::Exhausted) description = 105;
+    if (status == Status::SessionClosed) description = 123;
+    return {status, Result(description), 0, std::move(diagnostic)};
+}
+uint32_t U32(std::span<const std::byte> b, size_t offset) {
+    uint32_t value = 0;
+    for (unsigned i = 0; i < 4; ++i) value |= uint32_t(b[offset+i]) << (8*i);
+    return value;
+}
+void Put(std::span<std::byte> b, size_t offset, uint32_t value) {
+    for (unsigned i = 0; i < 4; ++i) b[offset+i] = std::byte(value >> (8*i));
+}
+bool ValidName(std::string_view name) {
+    if (name.empty() || name.size() > 8) return false;
+    for (unsigned char c : name) if (c < 0x21 || c > 0x7e) return false;
+    return true;
+}
+struct Parsed { Request request; bool close{}; std::vector<Request::ReadBuffer> buffers; };
+Outcome Parse(std::span<const std::byte> b, Parsed& parsed) {
+    const uint32_t low=U32(b,0), high=U32(b,4), type=low&0xffff;
+    const size_t x=(low>>16)&15, a=(low>>20)&15, rb=(low>>24)&15, w=(low>>28)&15;
+    const size_t data_words=high&1023, cflag=(high>>10)&15;
+    if (high&0x7fffc000) return Failure(Status::Malformed,"HIPC reserved header bits");
+    if (type==2) {
+        if (low!=2 || high) return Failure(Status::Malformed,"HIPC close has extra fields");
+        parsed.close=true; return {};
+    }
+    if (type!=4) return Failure(Status::Unsupported,"HIPC command type "+std::to_string(type));
+    size_t cursor=8, copy=0, move=0;
+    bool pid=false;
+    if (high>>31) {
+        const uint32_t handles=U32(b,cursor); cursor+=4;
+        if (handles&~0x1ffu) return Failure(Status::Malformed,"HIPC reserved handle bits");
+        pid=bool(handles&1); copy=(handles>>1)&15; move=(handles>>5)&15;
+        cursor+=(pid?8:0)+4*(copy+move);
+    }
+    const size_t descriptor_start=cursor;
+    cursor+=x*8+(a+rb+w)*12;
+    if (cursor>b.size() || data_words>(b.size()-cursor)/4)
+        return Failure(Status::Malformed,"HIPC raw data exceeds TLS message buffer");
+    const size_t end=cursor+data_words*4;
+    const size_t ccount=cflag<2?0:(cflag==2?1:cflag-2);
+    if (ccount>(b.size()-end)/8) return Failure(Status::Malformed,"HIPC receive descriptors exceed TLS message buffer");
+    const size_t raw=(cursor+15)&~size_t(15);
+    if (raw>end || end-raw<16) return Failure(Status::Malformed,"HIPC truncated aligned CMIF header");
+    if (copy || move || rb || w || cflag)
+        return Failure(Status::Unsupported,"HIPC copy/move handles or writable/receive descriptors are not implemented");
+    std::vector<Request::ReadBuffer> xs, as;
+    for (size_t i=0;i<x;++i) {
+        const auto pos=descriptor_start+i*8;
+        const uint32_t first=U32(b,pos);
+        xs.push_back({uint64_t(U32(b,pos+4)) | (uint64_t((first>>12)&15)<<32) |
+                      (uint64_t((first>>6)&7)<<36),first>>16});
+    }
+    for (size_t i=0;i<a;++i) {
+        const auto pos=descriptor_start+x*8+i*12;
+        const uint32_t last=U32(b,pos+8);
+        if (last&0x00ffffe0u) return Failure(Status::Malformed,"HIPC reserved map-alias descriptor bits");
+        as.push_back({uint64_t(U32(b,pos+4)) | (uint64_t(last>>28)<<32) |
+                      (uint64_t((last>>2)&7)<<36),
+                      uint64_t(U32(b,pos)) | (uint64_t((last>>24)&15)<<32)});
+    }
+    // Match HLERequestContext::ReadBuffer: nonempty A takes precedence over X.
+    for (size_t i=0;i<(x>a?x:a);++i) {
+        if (i<as.size() && as[i].size) parsed.buffers.push_back(as[i]);
+        else if (i<xs.size()) parsed.buffers.push_back(xs[i]);
+        else parsed.buffers.push_back({});
+    }
+    if (U32(b,raw)!=0x49434653) return Failure(Status::Malformed,"CMIF SFCI magic missing");
+    if (U32(b,raw+4) || U32(b,raw+12))
+        return Failure(Status::Unsupported,"CMIF version/high command word is not implemented");
+    parsed.request.command=U32(b,raw+8);
+    parsed.request.send_pid=pid;
+    parsed.request.payload=b.subspan(raw+16,end-raw-16);
+    return {};
+}
+bool Response(std::array<std::byte,256>& out, const Reply& reply, uint32_t moved_handle) {
+    const size_t normal_words=2+(reply.payload.size()+3)/4;
+    // Match ResponseBuilder's mandatory padding and raw-data accounting.
+    const size_t data_words=2*normal_words+6;
+    const size_t cursor=moved_handle?16:8;
+    const size_t raw=(cursor+15)&~size_t(15);
+    if (data_words>1023 || cursor+data_words*4>out.size() ||
+        reply.payload.size()>out.size()-raw-16) return false;
+    Put(out,4,uint32_t(data_words)|(moved_handle?0x80000000u:0));
+    if (moved_handle) { Put(out,8,1u<<5); Put(out,12,moved_handle); }
+    Put(out,raw,0x4f434653); // SFCO, reserved/version zero
+    Put(out,raw+8,reply.service_result);
+    for (size_t i=0;i<reply.payload.size();++i) out[raw+16+i]=reply.payload[i];
+    return true;
+}
+} // namespace
+
+Router::Router(uint64_t process_id):process_id_(process_id) {
+    if (!process_id) throw std::invalid_argument("native service process ID must be owned and nonzero");
+}
+bool Router::Register(std::string name, std::function<std::unique_ptr<Endpoint>()> factory) {
+    if (!ValidName(name) || name=="sm:" || !factory) return false;
+    return endpoints_.emplace(std::move(name),std::move(factory)).second;
+}
+Outcome Router::Connect(std::string_view name) {
+    if (name!="sm:") return Failure(Status::Unsupported,"named port is not implemented: "+std::string(name));
+    if (next_handle_==std::numeric_limits<uint32_t>::max()) return Failure(Status::Exhausted,"native session handle space exhausted");
+    const uint32_t handle=next_handle_;
+    sessions_.emplace(handle,Session{true,false,process_id_,nullptr});
+    ++next_handle_;
+    return {Status::Ok,0,handle,{}};
+}
+Outcome Router::Close(uint32_t handle) {
+    if (!sessions_.erase(handle)) return Failure(Status::InvalidHandle,"session handle is not owned");
+    return {};
+}
+Outcome Router::Send(uint32_t handle, GuestMemory memory, uint64_t tls_base, uint64_t process_id) {
+    auto current=sessions_.find(handle);
+    if (current==sessions_.end()) return Failure(Status::InvalidHandle,"session handle is not owned");
+    if (process_id!=process_id_ || current->second.process!=process_id)
+        return Failure(Status::InvalidProcess,"IPC caller is not the owning native process");
+    if (current->second.protocol_closed)
+        return Failure(Status::SessionClosed,"IPC endpoint is closed; client handle remains owned until CloseHandle");
+    if (!memory.read || !memory.write || tls_base>UINT64_MAX-255)
+        return Failure(Status::MemoryFault,"TLS message range is invalid");
+    std::array<std::byte,256> input{},output{};
+    if (!memory.read(memory.user,tls_base,input)) return Failure(Status::MemoryFault,"TLS message read failed");
+    Parsed parsed;
+    auto result=Parse(input,parsed);
+    if (result.status!=Status::Ok) return result;
+    if (parsed.close) {
+        // HIPC Close tears down the protocol endpoint, not the caller's kernel
+        // handle-table entry. The SDK separately issues svcCloseHandle next.
+        // See KSession::OnServerClosed / ResultSessionClosed and the
+        // KHandleTable removal performed by svc CloseHandle.
+        current->second.protocol_closed=true;
+        current->second.initialized=false;
+        current->second.endpoint.reset();
+        return {};
+    }
+    parsed.request.process_id=process_id_; // Claimed PID descriptor bytes are deliberately ignored.
+    parsed.request.read_buffers=parsed.buffers;
+    parsed.request.memory=memory;
+    Reply reply;
+    uint32_t moved=0;
+    std::unique_ptr<Endpoint> pending_endpoint;
+    bool initialize=false;
+    if (current->second.sm) {
+        if (!parsed.buffers.empty()) return Failure(Status::Unsupported,"SM request has unexpected buffer descriptors");
+        if (parsed.request.command==0) {
+            if (!parsed.request.send_pid || parsed.request.payload.size()<8)
+                return Failure(Status::Malformed,"SM Initialize requires PID descriptor and 64-bit argument");
+            initialize=true;
+            reply.status=Status::Ok;
+        } else if (parsed.request.command==1) {
+            if (!current->second.initialized) return Failure(Status::InvalidState,"SM GetService before Initialize");
+            if (parsed.request.payload.size()<8) return Failure(Status::Malformed,"SM GetService truncated service name");
+            std::string name;
+            bool zero=false;
+            for (auto value:parsed.request.payload.first(8)) {
+                const char c=char(value);
+                if (!c) { zero=true; continue; }
+                if (zero) return Failure(Status::Malformed,"SM service name has nonzero bytes after terminator");
+                name.push_back(c);
+            }
+            if (!ValidName(name)) return Failure(Status::Malformed,"SM service name is invalid");
+            const auto factory=endpoints_.find(name);
+            if (factory==endpoints_.end()) return Failure(Status::Unsupported,"required native service is not implemented: "+name);
+            pending_endpoint=factory->second();
+            if (!pending_endpoint) return Failure(Status::Unsupported,"native endpoint factory declined: "+name);
+            if (next_handle_==UINT32_MAX) return Failure(Status::Exhausted,"native session handle space exhausted");
+            moved=next_handle_;
+            reply.status=Status::Ok;
+        } else return Failure(Status::Unsupported,"SM command is not implemented: "+std::to_string(parsed.request.command));
+    } else {
+        reply=current->second.endpoint->Prepare(parsed.request);
+        if (reply.status!=Status::Ok) return Failure(reply.status,reply.diagnostic.empty()?"endpoint command is not implemented":reply.diagnostic);
+        if (reply.moved_endpoint) {
+            if (next_handle_==UINT32_MAX) return Failure(Status::Exhausted,"native session handle space exhausted");
+            moved=next_handle_;
+            pending_endpoint=std::move(reply.moved_endpoint);
+        }
+    }
+    if (!Response(output,reply,moved)) return Failure(Status::Malformed,"endpoint reply exceeds TLS message buffer");
+    // Allocate the session node before writing a response that exposes its handle.
+    if (moved) sessions_.emplace(moved,Session{false,false,process_id_,std::move(pending_endpoint)});
+    if (!memory.write(memory.user,tls_base,output)) {
+        if (moved) sessions_.erase(moved);
+        return Failure(Status::MemoryFault,"TLS response write failed");
+    }
+    if (moved) ++next_handle_;
+    if (initialize) current->second.initialized=true;
+    if (reply.commit) reply.commit();
+    return {};
+}
+} // namespace native_services
diff --git a/native-runtime/services/router.h b/native-runtime/services/router.h
new file mode 100644
index 0000000000000000000000000000000000000000..8fe29f11ffe5e874278d19a3189f35b13a7297b1
--- /dev/null
+++ b/native-runtime/services/router.h
@@ -0,0 +1,75 @@
+// SPDX-FileCopyrightText: Copyright 2026 suyu Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <memory>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace native_services {
+struct GuestMemory {
+    void* user{};
+    bool (*read)(void*, uint64_t, std::span<std::byte>){};
+    // Must preflight the complete destination: false means no bytes changed.
+    bool (*write)(void*, uint64_t, std::span<const std::byte>){};
+};
+enum class Status { Ok, Unsupported, Malformed, MemoryFault, InvalidHandle, InvalidProcess, InvalidState, Exhausted, SessionClosed };
+struct Outcome {
+    Status status{Status::Ok};
+    uint32_t kernel_result{};
+    uint32_t handle{};
+    std::string diagnostic;
+};
+struct Request {
+    uint32_t command{}, token{};
+    uint64_t process_id{}; // Supplied by the owning native process, never client PID bytes.
+    bool send_pid{};
+    std::span<const std::byte> payload;
+    struct ReadBuffer { uint64_t address{}, size{}; };
+    std::span<const ReadBuffer> read_buffers;
+    GuestMemory memory;
+};
+class Endpoint;
+struct Reply {
+    Status status{Status::Unsupported};
+    uint32_t service_result{};
+    std::vector<std::byte> payload;
+    std::string diagnostic;
+    // Prepare must not change externally visible state. Commit runs only after a
+    // successful complete response write. A delivery exception is fatal to native
+    // bring-up: the host must stop before resuming guest code, never swallow it.
+    std::function<void()> commit;
+    std::unique_ptr<Endpoint> moved_endpoint;
+};
+class Endpoint {
+public:
+    virtual ~Endpoint() = default;
+    virtual Reply Prepare(const Request&) = 0;
+};
+class Router {
+public:
+    explicit Router(uint64_t process_id);
+    // Factory must create a real implemented endpoint, without external effects.
+    bool Register(std::string name, std::function<std::unique_ptr<Endpoint>()> factory);
+    Outcome Connect(std::string_view name);
+    Outcome Send(uint32_t handle, GuestMemory memory, uint64_t tls_base, uint64_t process_id);
+    Outcome Close(uint32_t handle);
+    size_t SessionCount() const { return sessions_.size(); }
+private:
+    struct Session {
+        bool sm{}, initialized{};
+        uint64_t process{};
+        std::unique_ptr<Endpoint> endpoint;
+        bool protocol_closed{};
+    };
+    uint64_t process_id_;
+    uint32_t next_handle_{0x10000};
+    std::map<std::string, std::function<std::unique_ptr<Endpoint>()>> endpoints_;
+    std::map<uint32_t, Session> sessions_;
+};
+} // namespace native_services
diff --git a/native-runtime/services/tests/test.cpp b/native-runtime/services/tests/test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7098465f01081ad24ecf901db31a55d9db8d1c17
--- /dev/null
+++ b/native-runtime/services/tests/test.cpp
@@ -0,0 +1,243 @@
+// SPDX-FileCopyrightText: Copyright 2026 suyu Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "router.h"
+#include "logging.h"
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+#include <fstream>
+using namespace native_services;
+#define CHECK(x) do { if (!(x)) throw std::runtime_error(#x); } while (false)
+namespace {
+struct Memory {
+    std::array<std::byte,256> bytes{};
+    bool readable=true,writable=true;
+    unsigned writes=0;
+    std::vector<std::byte> packet;
+    bool packet_readable=true;
+    static bool Read(void* u,uint64_t a,std::span<std::byte> b) {
+        auto& m=*static_cast<Memory*>(u);
+        if(a==0x3000 && b.size()==m.packet.size() && m.packet_readable) {
+            std::memcpy(b.data(),m.packet.data(),b.size());return true;
+        }
+        if (!m.readable || a!=0x1000 || b.size()!=256) return false;
+        std::memcpy(b.data(),m.bytes.data(),256); return true;
+    }
+    static bool Write(void* u,uint64_t a,std::span<const std::byte> b) {
+        auto& m=*static_cast<Memory*>(u);
+        if (!m.writable || a!=0x1000 || b.size()!=256) return false;
+        std::memcpy(m.bytes.data(),b.data(),256); ++m.writes; return true;
+    }
+    GuestMemory Bus() { return {this,Read,Write}; }
+    void Put(size_t o,uint32_t v) { for(unsigned i=0;i<4;++i) bytes[o+i]=std::byte(v>>(8*i)); }
+    uint32_t Get(size_t o) const { uint32_t v=0;for(unsigned i=0;i<4;++i)v|=uint32_t(bytes[o+i])<<(8*i);return v; }
+    void Request(uint32_t command,bool pid=false,std::string_view name={}) {
+        bytes.fill(std::byte{});
+        Put(0,4);
+        // Actual HIPC special header / PID slot precedes 16-byte CMIF alignment.
+        const size_t cursor=pid?20:8, raw=pid?32:16;
+        Put(4,uint32_t((raw+24-cursor)/4)|(pid?0x80000000u:0));
+        if(pid) { Put(8,1); Put(12,0xdeadbeef); Put(16,0xfedcba98); }
+        Put(raw,0x49434653); Put(raw+8,command);
+        for(size_t i=0;i<name.size() && i<8;++i)bytes[raw+16+i]=std::byte(name[i]);
+    }
+    void LogRequest(bool map_alias=false) {
+        bytes.fill(std::byte{});
+        const size_t raw=map_alias?32:16,cursor=map_alias?20:16;
+        Put(0,4|(map_alias?(1<<20):(1<<16)));
+        Put(4,uint32_t((raw+24-cursor)/4));
+        if(map_alias) { Put(8,uint32_t(packet.size()));Put(12,0x3000); }
+        else { Put(8,uint32_t(packet.size())<<16);Put(12,0x3000); }
+        Put(raw,0x49434653);
+    }
+};
+struct State { unsigned prepared=0,committed=0,created=0,destroyed=0; uint64_t pid=0; };
+class TestEndpoint final:public Endpoint {
+    State& s;
+public:
+    explicit TestEndpoint(State& state):s(state) { ++s.created; }
+    ~TestEndpoint() override { ++s.destroyed; }
+    Reply Prepare(const native_services::Request& r) override {
+        ++s.prepared; s.pid=r.process_id;
+        if(r.command!=7)return {Status::Unsupported,0,{},"test endpoint unsupported command",{}};
+        return {Status::Ok,0x1234,{std::byte{0x42}}, {},[this]{++s.committed;}};
+    }
+};
+void Init(Router& r,Memory& m,uint32_t h) {
+    m.Request(0,true);
+    CHECK(r.Send(h,m.Bus(),0x1000,42).status==Status::Ok);
+    CHECK(m.Get(16)==0x4f434653 && m.Get(24)==0 && m.Get(4)==10);
+}
+void TestWireAndOwnership() {
+    Router r(42); Memory m; State state;
+    CHECK(r.Connect("nvdrv").status==Status::Unsupported);
+    CHECK(r.SessionCount()==0);
+    auto sm=r.Connect("sm:");CHECK(sm.status==Status::Ok && sm.handle==0x10000);
+    m.Request(1,false,"test"); auto before=m.bytes;
+    CHECK(r.Send(sm.handle,m.Bus(),0x1000,42).status==Status::InvalidState && m.bytes==before);
+    m.Request(0,true);
+    CHECK(r.Send(sm.handle,m.Bus(),0x1000,99).status==Status::InvalidProcess);
+    Init(r,m,sm.handle);
+    m.Request(1,false,"nvdrv");before=m.bytes;
+    auto missing=r.Send(sm.handle,m.Bus(),0x1000,42);
+    CHECK(missing.status==Status::Unsupported && missing.diagnostic.find("nvdrv")!=std::string::npos);
+    CHECK(r.SessionCount()==1 && before==m.bytes);
+    CHECK(r.Register("test",[&]{return std::make_unique<TestEndpoint>(state);}));
+    CHECK(!r.Register("test",[&]{return std::make_unique<TestEndpoint>(state);}));
+    CHECK(!r.Register("sm:",[&]{return std::make_unique<TestEndpoint>(state);}));
+    m.Request(1,false,"test");
+    CHECK(r.Send(sm.handle,m.Bus(),0x1000,42).status==Status::Ok);
+    CHECK(m.Get(4)==0x8000000au && m.Get(8)==32 && m.Get(12)==0x10001);
+    CHECK(m.Get(16)==0x4f434653 && r.SessionCount()==2 && state.created==1);
+    const uint32_t endpoint=m.Get(12);
+    m.Request(7,true);
+    CHECK(r.Send(endpoint,m.Bus(),0x1000,42).status==Status::Ok);
+    CHECK(state.pid==42 && state.committed==1 && m.Get(24)==0x1234 && m.bytes[32]==std::byte{0x42});
+    m.Request(8);before=m.bytes;
+    CHECK(r.Send(endpoint,m.Bus(),0x1000,42).status==Status::Unsupported && m.bytes==before);
+    CHECK(state.committed==1);
+    CHECK(r.Close(12).status==Status::InvalidHandle && r.SessionCount()==2);
+    m.bytes.fill(std::byte{});m.Put(0,2);
+    CHECK(r.Send(endpoint,m.Bus(),0x1000,42).status==Status::Ok);
+    CHECK(state.destroyed==1 && r.SessionCount()==2);
+    const auto closed=r.Send(endpoint,m.Bus(),0x1000,42);
+    CHECK(closed.status==Status::SessionClosed && closed.kernel_result==(1u|(123u<<9)));
+    CHECK(r.Close(endpoint).status==Status::Ok && r.SessionCount()==1);
+    CHECK(r.Close(endpoint).status==Status::InvalidHandle);
+    CHECK(r.Close(sm.handle).status==Status::Ok && r.SessionCount()==0);
+}
+void TestRollbackAndFraming() {
+    Router r(42);Memory m;State state;const auto sm=r.Connect("sm:").handle;
+    m.Request(0,true);m.writable=false;auto before=m.bytes;
+    CHECK(r.Send(sm,m.Bus(),0x1000,42).status==Status::MemoryFault && m.bytes==before);
+    m.writable=true;m.Request(1,false,"test");
+    CHECK(r.Send(sm,m.Bus(),0x1000,42).status==Status::InvalidState);
+    Init(r,m,sm);
+    CHECK(r.Register("test",[&]{return std::make_unique<TestEndpoint>(state);}));
+    m.Request(1,false,"test");m.writable=false;
+    CHECK(r.Send(sm,m.Bus(),0x1000,42).status==Status::MemoryFault);
+    CHECK(r.SessionCount()==1 && state.created==state.destroyed);
+    m.writable=true;m.Request(1,false,"test");
+    CHECK(r.Send(sm,m.Bus(),0x1000,42).status==Status::Ok && m.Get(12)==0x10001);
+    const auto endpoint=m.Get(12);
+    m.Request(7);m.writable=false;
+    CHECK(r.Send(endpoint,m.Bus(),0x1000,42).status==Status::MemoryFault && state.committed==0);
+    m.writable=true;
+    for(unsigned variant=0;variant<8;++variant) {
+        m.Request(0,true);
+        if(variant==0)m.Put(4,0x800003ffu); // Out-of-buffer raw size
+        if(variant==1)m.Put(32,0); // Bad magic
+        if(variant==2)m.Put(4,0x80000001u); // Short aligned CMIF data
+        if(variant==3)m.Put(8,1|(1<<1)); // Incoming copy handle, never accepted
+        if(variant==4)m.Put(8,1|(1<<5)); // Incoming move handle, never accepted
+        if(variant==5)m.Put(0,4|(15<<20)|(15<<24)); // Descriptor overflow
+        if(variant==6)m.Put(0,5); // Domain/control explicit unsupported
+        if(variant==7)m.Put(4,0x80004009u); // Reserved bits
+        before=m.bytes;const size_t sessions=r.SessionCount();
+        CHECK(r.Send(sm,m.Bus(),0x1000,42).status!=Status::Ok);
+        CHECK(m.bytes==before && r.SessionCount()==sessions);
+    }
+    m.Request(0);before=m.bytes;
+    CHECK(r.Send(sm,m.Bus(),0x1000,42).status==Status::Malformed && before==m.bytes);
+    CHECK(r.Send(sm,m.Bus(),UINT64_MAX-100,42).status==Status::MemoryFault);
+    m.readable=false;CHECK(r.Send(sm,m.Bus(),0x1000,42).status==Status::MemoryFault);
+    CHECK(state.committed==0);
+}
+struct ActualTestSink final:LogSink {
+    std::vector<LogRecord> records;
+    bool fail=false;
+    bool Deliver(const LogRecord& r) override {
+        if(fail)return false;
+        records.push_back(r);return true;
+    }
+};
+void MakePacket(Memory& m,unsigned flags,std::span<const std::byte> payload) {
+    m.packet.assign(24+payload.size(),std::byte{});
+    m.packet[0]=std::byte{99}; // Untrusted packet PID, not the owner identity.
+    m.packet[8]=std::byte{12};
+    m.packet[16]=std::byte(flags);m.packet[18]=std::byte{1};
+    for(unsigned i=0;i<4;++i)m.packet[20+i]=std::byte(payload.size()>>(8*i));
+    std::copy(payload.begin(),payload.end(),m.packet.begin()+24);
+}
+void TestRealLogging() {
+    Router r(42);Memory m;auto sink=std::make_shared<ActualTestSink>();
+    CHECK(r.Register("lm",[sink]{return CreateLoggingService(sink);}));
+    auto sm=r.Connect("sm:").handle;Init(r,m,sm);
+    m.Request(1,false,"lm");CHECK(r.Send(sm,m.Bus(),0x1000,42).status==Status::Ok);
+    const auto lm=m.Get(12);
+    m.Request(0,true);m.writable=false;
+    CHECK(r.Send(lm,m.Bus(),0x1000,42).status==Status::MemoryFault && r.SessionCount()==2);
+    m.writable=true;m.Request(0,true);
+    CHECK(r.Send(lm,m.Bus(),0x1000,42).status==Status::Ok);
+    const auto logger=m.Get(12);CHECK(logger==0x10002 && r.SessionCount()==3);
+    // Actual SDK sequence: close the LM protocol endpoint, then close its client
+    // kernel handle. The returned ILogger child remains independently owned.
+    m.bytes.fill(std::byte{});m.Put(0,2);
+    m.readable=false;
+    CHECK(r.Send(lm,m.Bus(),0x1000,42).status==Status::MemoryFault && r.SessionCount()==3);
+    m.readable=true;m.Put(4,1); // A malformed close must not change endpoint state.
+    CHECK(r.Send(lm,m.Bus(),0x1000,42).status==Status::Malformed && r.SessionCount()==3);
+    m.Put(4,0);
+    CHECK(r.Send(lm,m.Bus(),0x1000,42).status==Status::Ok);
+    CHECK(r.SessionCount()==3);
+    CHECK(r.Close(lm).status==Status::Ok && r.SessionCount()==2);
+    CHECK(r.Close(lm).status==Status::InvalidHandle);
+    m.Request(1);m.Put(32,2);
+    CHECK(r.Send(logger,m.Bus(),0x1000,42).status==Status::Ok);
+    const std::array text{std::byte{2},std::byte{5},std::byte{'h'},std::byte{'e'},std::byte{'l'},std::byte{'l'},std::byte{'o'}};
+    MakePacket(m,7,text);m.LogRequest();m.writable=false;
+    CHECK(r.Send(logger,m.Bus(),0x1000,42).status==Status::MemoryFault && sink->records.empty());
+    m.writable=true;m.LogRequest();
+    CHECK(r.Send(logger,m.Bus(),0x1000,42).status==Status::Ok && sink->records.size()==1);
+    CHECK(sink->records[0].text=="hello" && sink->records[0].packet==m.packet);
+    CHECK(sink->records[0].process_id==42 && sink->records[0].claimed_process_id==99 && sink->records[0].destination==2);
+    // Map-alias A descriptors use the same actual packet delivery path.
+    MakePacket(m,5,std::span(text).first(3));m.LogRequest(true);
+    CHECK(r.Send(logger,m.Bus(),0x1000,42).status==Status::Ok);
+    MakePacket(m,6,std::span(text).subspan(3));m.LogRequest(true);
+    CHECK(r.Send(logger,m.Bus(),0x1000,42).status==Status::Ok && sink->records.back().text=="hello");
+    const auto delivered=sink->records.size();
+    MakePacket(m,6,text);m.LogRequest();auto before=m.bytes;
+    CHECK(r.Send(logger,m.Bus(),0x1000,42).status==Status::Malformed && before==m.bytes);
+    MakePacket(m,7,text);m.packet[20]=std::byte{127};m.LogRequest();
+    CHECK(r.Send(logger,m.Bus(),0x1000,42).status==Status::Malformed);
+    const std::array truncated{std::byte{2},std::byte{12},std::byte{'x'}};
+    MakePacket(m,7,truncated);m.LogRequest();
+    CHECK(r.Send(logger,m.Bus(),0x1000,42).status==Status::Malformed);
+    MakePacket(m,7,text);m.LogRequest();m.packet_readable=false;
+    CHECK(r.Send(logger,m.Bus(),0x1000,42).status==Status::MemoryFault);
+    m.packet_readable=true;m.Request(2);
+    CHECK(r.Send(logger,m.Bus(),0x1000,42).status==Status::Unsupported && sink->records.size()==delivered);
+    // An actual sink failure is fatal before the guest can observe a success.
+    sink->fail=true;MakePacket(m,7,text);m.LogRequest();bool failed=false;
+    try { (void)r.Send(logger,m.Bus(),0x1000,42); } catch(const std::runtime_error&) { failed=true; }
+    CHECK(failed && sink->records.size()==delivered);
+    CHECK(r.Close(logger).status==Status::Ok && r.SessionCount()==1);
+    bool null_rejected=false;
+    try { (void)CreateLoggingService(nullptr); } catch(const std::invalid_argument&) { null_rejected=true; }
+    CHECK(null_rejected);
+}
+void TestOwnedFileDelivery() {
+    const auto suffix=std::chrono::steady_clock::now().time_since_epoch().count();
+    const auto path=std::filesystem::current_path()/("lm-unit-"+std::to_string(suffix)+".jsonl");
+    {
+        auto sink=CreateFileLogSink(path,4096,1);
+        bool exclusive=false;
+        try { (void)CreateFileLogSink(path); } catch(const std::runtime_error&) { exclusive=true; }
+        CHECK(exclusive);
+        LogRecord record;record.process_id=42;record.text="hello\n\"world\"";record.packet={std::byte{0xab}};
+        CHECK(sink->Deliver(record));CHECK(!sink->Deliver(record));
+    }
+    std::ifstream file(path);const std::string content((std::istreambuf_iterator<char>(file)),{});file.close();
+    CHECK(content.find("\"packet_hex\":\"ab\"")!=std::string::npos);
+    CHECK(content.find("hello\\u000a\\\"world\\\"")!=std::string::npos);
+    CHECK(std::filesystem::remove(path));
+}
+} // namespace
+int main() {
+    try { TestWireAndOwnership();TestRollbackAndFraming();TestRealLogging();TestOwnedFileDelivery(); }
+    catch(const std::exception& e) { std::fprintf(stderr,"%s\n",e.what());return 1; }
+    std::puts("native SM/HIPC/CMIF ownership and framing contracts passed");
+}
