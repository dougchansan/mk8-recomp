+namespace nx {
+// CPU cycles consumed by this thread, including kernel execution. These are
+// not elapsed-time units and must never be converted to nanoseconds.
+inline bool read_thread_cycles(uint64_t& value) {
+#ifdef _WIN32
+    ULONG64 cycles = 0;
+    const bool valid = QueryThreadCycleTime(GetCurrentThread(), &cycles) != 0;
+    value = cycles;
+    return valid;
+#else
+    value = 0;
+    return false;
+#endif
+}
+inline uint64_t profile_thread_id() {
+#ifdef _WIN32
+    return GetCurrentThreadId();
+#else
+    return 0;
+#endif
