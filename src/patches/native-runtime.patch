diff --git a/native-runtime/services/router.cpp b/native-runtime/services/router.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/services/router.cpp
@@ -0,0 +1,362 @@
+// SPDX-FileCopyrightText: Copyright 2026 suyu Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Wire layout follows src/core/hle/ipc.h, service/ipc_helpers.h and
+// service/hle_ipc.cpp; SM command meanings follow service/sm/sm.cpp.
+#include "router.h"
+#include <array>
+#include <limits>
+#include <stdexcept>
+
+namespace native_services {
+namespace {
+constexpr uint32_t Result(unsigned description) { return 1u | (description << 9); }
+Outcome Failure(Status status, std::string diagnostic) {
+    unsigned description = 14;
+    if (status == Status::Unsupported) description = 33;
+    if (status == Status::InvalidHandle) description = 114;
+    if (status == Status::MemoryFault) description = 102;
+    if (status == Status::InvalidState || status == Status::InvalidProcess) description = 125;
+    if (status == Status::Exhausted) description = 105;
+    if (status == Status::SessionClosed) description = 123;
+    return {status, Result(description), 0, std::move(diagnostic)};
+}
+uint32_t U32(std::span<const std::byte> b, size_t offset) {
+    uint32_t value = 0;
+    for (unsigned i = 0; i < 4; ++i) value |= uint32_t(b[offset+i]) << (8*i);
+    return value;
+}
+void Put(std::span<std::byte> b, size_t offset, uint32_t value) {
+    for (unsigned i = 0; i < 4; ++i) b[offset+i] = std::byte(value >> (8*i));
+}
+bool ValidName(std::string_view name) {
+    if (name.empty() || name.size() > 8) return false;
+    for (unsigned char c : name) if (c < 0x21 || c > 0x7e) return false;
+    return true;
+}
+struct Parsed {
+    Request request;
+    bool close{};
+    bool control{};
+    bool domain{},domain_close{};
+    uint32_t object_id{};
+    std::vector<uint32_t> incoming_objects;
+    std::vector<Request::ReadBuffer> buffers;
+    std::vector<Request::ReadBuffer> pointer_buffers;
+    std::vector<uint32_t> copied_process_handles;
+};
+Outcome Parse(std::span<const std::byte> b, Parsed& parsed,bool is_domain) {
+    const uint32_t low=U32(b,0), high=U32(b,4), type=low&0xffff;
+    const size_t x=(low>>16)&15, a=(low>>20)&15, rb=(low>>24)&15, w=(low>>28)&15;
+    const size_t data_words=high&1023, cflag=(high>>10)&15;
+    if (high&0x7fffc000) return Failure(Status::Malformed,"HIPC reserved header bits");
+    if (type==2) {
+        if (low!=2 || high) return Failure(Status::Malformed,"HIPC close has extra fields");
+        parsed.close=true; return {};
+    }
+    if (type!=4 && type!=5) return Failure(Status::Unsupported,"HIPC command type "+std::to_string(type));
+    parsed.control=type==5;
+    size_t cursor=8, copy=0, move=0;
+    bool pid=false;
+    if (high>>31) {
+        const uint32_t handles=U32(b,cursor); cursor+=4;
+        if (handles&~0x1ffu) return Failure(Status::Malformed,"HIPC reserved handle bits");
+        pid=bool(handles&1); copy=(handles>>1)&15; move=(handles>>5)&15;
+        const size_t handle_start=cursor+(pid?8:0);
+        if (handle_start+4*(copy+move)>b.size())
+            return Failure(Status::Malformed,"HIPC handles exceed TLS message buffer");
+        for (size_t i=0;i<copy;++i) parsed.copied_process_handles.push_back(U32(b,handle_start+i*4));
+        cursor+=(pid?8:0)+4*(copy+move);
+    }
+    const size_t descriptor_start=cursor;
+    cursor+=x*8+(a+rb+w)*12;
+    if (cursor>b.size() || data_words>(b.size()-cursor)/4)
+        return Failure(Status::Malformed,"HIPC raw data exceeds TLS message buffer");
+    const size_t end=cursor+data_words*4;
+    const size_t ccount=cflag<2?0:(cflag==2?1:cflag-2);
+    if (ccount>(b.size()-end)/8) return Failure(Status::Malformed,"HIPC receive descriptors exceed TLS message buffer");
+    const size_t raw=(cursor+15)&~size_t(15);
+    if (raw>end || end-raw<16) return Failure(Status::Malformed,"HIPC truncated aligned CMIF/domain header");
+    if (move || rb || w || cflag)
+        return Failure(Status::Unsupported,"HIPC move handles or writable/receive descriptors are not implemented");
+    std::vector<Request::ReadBuffer> xs, as;
+    for (size_t i=0;i<x;++i) {
+        const auto pos=descriptor_start+i*8;
+        const uint32_t first=U32(b,pos);
+        xs.push_back({uint64_t(U32(b,pos+4)) | (uint64_t((first>>12)&15)<<32) |
+                      (uint64_t((first>>6)&7)<<36),first>>16,{},uint32_t(i)});
+    }
+    for (size_t i=0;i<a;++i) {
+        const auto pos=descriptor_start+x*8+i*12;
+        const uint32_t last=U32(b,pos+8);
+        if (last&0x00ffffe0u) return Failure(Status::Malformed,"HIPC reserved map-alias descriptor bits");
+        as.push_back({uint64_t(U32(b,pos+4)) | (uint64_t(last>>28)<<32) |
+                      (uint64_t((last>>2)&7)<<36),
+                      uint64_t(U32(b,pos)) | (uint64_t((last>>24)&15)<<32)});
+    }
+    // Match HLERequestContext::ReadBuffer: nonempty A takes precedence over X.
+    for (size_t i=0;i<(x>a?x:a);++i) {
+        if (i<as.size() && as[i].size) parsed.buffers.push_back(as[i]);
+        else if (i<xs.size()) parsed.buffers.push_back(xs[i]);
+        else parsed.buffers.push_back({});
+    }
+    parsed.pointer_buffers=std::move(xs);
+    size_t cmif=raw,cmif_end=end;
+    if (is_domain && !parsed.control) {
+        parsed.domain=true;
+        const uint32_t header=U32(b,raw),command=header&255,count=(header>>8)&255;
+        const size_t size=header>>16;
+        parsed.object_id=U32(b,raw+4);
+        if (!parsed.object_id)return Failure(Status::InvalidHandle,"domain object ID zero is invalid");
+        if (U32(b,raw+8) || U32(b,raw+12))
+            return Failure(Status::Unsupported,"domain context/reserved words are not implemented");
+        if (size>end-raw-16 || count>(end-raw-16-size)/4)
+            return Failure(Status::Malformed,"domain CMIF size/input object array exceeds raw payload");
+        if (count>16)return Failure(Status::Malformed,"domain incoming object count exceeds native bound");
+        cmif=raw+16;cmif_end=cmif+size;
+        for (size_t i=0;i<count;++i)parsed.incoming_objects.push_back(U32(b,cmif_end+4*i));
+        if (command==2) {
+            if (size || count || pid || copy || !parsed.buffers.empty())
+                return Failure(Status::Malformed,"domain CloseVirtualHandle has unexpected data or objects");
+            parsed.domain_close=true;return {};
+        }
+        if (command!=1)return Failure(Status::Unsupported,"domain command is not implemented: "+std::to_string(command));
+        if (size<16)return Failure(Status::Malformed,"domain CMIF data header is truncated");
+    }
+    if (U32(b,cmif)!=0x49434653) return Failure(Status::Malformed,"CMIF SFCI magic missing");
+    if (U32(b,cmif+4) || U32(b,cmif+12))
+        return Failure(Status::Unsupported,"CMIF version/high command word is not implemented");
+    parsed.request.command=U32(b,cmif+8);
+    parsed.request.send_pid=pid;
+    parsed.request.payload=b.subspan(cmif+16,cmif_end-cmif-16);
+    return {};
+}
+bool Response(std::array<std::byte,256>& out, const Reply& reply, uint32_t moved_handle,
+              bool domain=false,uint32_t domain_object=0,uint32_t copied_handle=0) {
+    const size_t normal_words=2+(reply.payload.size()+3)/4;
+    // Match ResponseBuilder's mandatory padding and raw-data accounting.
+    const size_t data_words=2*normal_words+6+(domain?4:0)+(domain_object?1:0);
+    const bool handles=moved_handle || copied_handle;
+    const size_t cursor=handles?12+(moved_handle?4:0)+(copied_handle?4:0):8;
+    const size_t raw=(cursor+15)&~size_t(15);
+    const size_t cmif=raw+(domain?16:0);
+    if (data_words>1023 || cursor+data_words*4>out.size() ||
+        reply.payload.size()>out.size()-cmif-16) return false;
+    Put(out,4,uint32_t(data_words)|(handles?0x80000000u:0));
+    if (handles) {
+        Put(out,8,(copied_handle?2u:0u)|(moved_handle?32u:0u));
+        if(copied_handle)Put(out,12,copied_handle);
+        if(moved_handle)Put(out,copied_handle?16:12,moved_handle);
+    }
+    if (domain)Put(out,raw,domain_object?1:0);
+    Put(out,cmif,0x4f434653); // SFCO, reserved/version zero
+    Put(out,cmif+8,reply.service_result);
+    for (size_t i=0;i<reply.payload.size();++i) out[cmif+16+i]=reply.payload[i];
+    if (domain_object) {
+        const size_t array=cmif+16+((reply.payload.size()+3)&~size_t(3));
+        if (array>out.size()-4)return false;
+        Put(out,array,domain_object);
+    }
+    return true;
+}
+} // namespace
+
+Router::Router(uint64_t process_id,uint16_t pointer_capacity)
+    :process_id_(process_id),pointer_buffer_capacity_(pointer_capacity) {
+    if (!process_id) throw std::invalid_argument("native service process ID must be owned and nonzero");
+}
+bool Router::Register(std::string name, std::function<std::unique_ptr<Endpoint>()> factory) {
+    if (!ValidName(name) || name=="sm:" || !factory) return false;
+    return endpoints_.emplace(std::move(name),std::move(factory)).second;
+}
+Outcome Router::Connect(std::string_view name) {
+    if (name!="sm:") return Failure(Status::Unsupported,"named port is not implemented: "+std::string(name));
+    if (next_handle_>SessionHandleLast) return Failure(Status::Exhausted,"native session handle partition exhausted");
+    const uint32_t handle=next_handle_;
+    sessions_.emplace(handle,Session{true,false,process_id_,nullptr,false,
+                                    std::vector<std::byte>(pointer_buffer_capacity_)});
+    ++next_handle_;
+    return {Status::Ok,0,handle,{}};
+}
+Outcome Router::Close(uint32_t handle) {
+    if (!sessions_.erase(handle)) return Failure(Status::InvalidHandle,"session handle is not owned");
+    return {};
+}
+Outcome Router::Send(uint32_t handle, GuestMemory memory, uint64_t tls_base, uint64_t process_id) {
+    auto current=sessions_.find(handle);
+    if (current==sessions_.end()) return Failure(Status::InvalidHandle,"session handle is not owned");
+    if (process_id!=process_id_ || current->second.process!=process_id)
+        return Failure(Status::InvalidProcess,"IPC caller is not the owning native process");
+    if (current->second.protocol_closed)
+        return Failure(Status::SessionClosed,"IPC endpoint is closed; client handle remains owned until CloseHandle");
+    if (!memory.read || !memory.write || tls_base>UINT64_MAX-255)
+        return Failure(Status::MemoryFault,"TLS message range is invalid");
+    std::array<std::byte,256> input{},output{};
+    if (!memory.read(memory.user,tls_base,input)) return Failure(Status::MemoryFault,"TLS message read failed");
+    Parsed parsed;
+    auto result=Parse(input,parsed,current->second.domain);
+    if (result.status!=Status::Ok) return result;
+    if (parsed.close) {
+        // HIPC Close tears down the protocol endpoint, not the caller's kernel
+        // handle-table entry. The SDK separately issues svcCloseHandle next.
+        // See KSession::OnServerClosed / ResultSessionClosed and the
+        // KHandleTable removal performed by svc CloseHandle.
+        current->second.protocol_closed=true;
+        current->second.initialized=false;
+        current->second.endpoint.reset();
+        current->second.domain_objects.clear();
+        current->second.pointer_arena.clear();
+        return {};
+    }
+    Endpoint* target=current->second.endpoint.get();
+    if (parsed.domain) {
+        const auto object=current->second.domain_objects.find(parsed.object_id);
+        if (object==current->second.domain_objects.end())return Failure(Status::InvalidHandle,"domain object is not live in this session");
+        target=object->second.get();
+        for (const auto id:parsed.incoming_objects)
+            if (!id || !current->second.domain_objects.contains(id))
+                return Failure(Status::InvalidHandle,"incoming domain object is not live in this session");
+        if (!parsed.incoming_objects.empty() && !target->AcceptsDomainObjects())
+            return Failure(Status::Unsupported,"endpoint has no incoming domain object contract");
+        parsed.request.incoming_domain_objects=parsed.incoming_objects;
+    }
+    if (parsed.control && (parsed.request.send_pid || !parsed.copied_process_handles.empty() ||
+                           !parsed.buffers.empty()))
+        return Failure(Status::Unsupported,"HIPC control query has unexpected handles or buffers");
+    // Account for every X descriptor, even where an A descriptor takes precedence
+    // for ReadBuffer. Never promise more than the arena this session really owns.
+    size_t used=0;
+    for (const auto& pointer:parsed.pointer_buffers) {
+        used=(used+15)&~size_t(15);
+        if (used>current->second.pointer_arena.size() ||
+            pointer.size>current->second.pointer_arena.size()-used)
+            return Failure(Status::Unsupported,"HIPC pointer descriptors exceed owned session pointer-buffer capacity");
+        used+=size_t(pointer.size);
+    }
+    used=0;
+    for (auto& pointer:parsed.pointer_buffers) {
+        used=(used+15)&~size_t(15);
+        auto storage=std::span(current->second.pointer_arena).subspan(used,size_t(pointer.size));
+        if (pointer.size && (pointer.address>UINT64_MAX-pointer.size ||
+            !memory.read(memory.user,pointer.address,storage)))
+            return Failure(Status::MemoryFault,"HIPC pointer-buffer snapshot read failed");
+        pointer.snapshot=storage;used+=size_t(pointer.size);
+    }
+    for (auto& buffer:parsed.buffers)
+        if (buffer.pointer_index!=UINT32_MAX)
+            buffer.snapshot=parsed.pointer_buffers[buffer.pointer_index].snapshot;
+    parsed.request.process_id=process_id_; // Claimed PID descriptor bytes are deliberately ignored.
+    parsed.request.read_buffers=parsed.buffers;
+    parsed.request.memory=memory;
+    if (!parsed.copied_process_handles.empty()) {
+        if (current->second.sm || !target || !target->AcceptsProcessHandles() ||
+            !process_handle_validator_)
+            return Failure(Status::Unsupported,"endpoint has no owned process-copy-handle contract");
+        for (const auto copied:parsed.copied_process_handles)
+            if (!process_handle_validator_(copied,process_id_))
+                return Failure(Status::InvalidHandle,"IPC copied handle is not a live owned process object");
+        parsed.request.copied_process_handles=parsed.copied_process_handles;
+    }
+    Reply reply;
+    uint32_t moved=0;
+    std::unique_ptr<Endpoint> pending_endpoint;
+    bool initialize=false;
+    bool convert=false;
+    uint32_t domain_object=0;
+    if (parsed.control) {
+        if (parsed.request.command==0) {
+            if (current->second.domain)return Failure(Status::InvalidState,"session is already a domain");
+            if (current->second.sm || !target)
+                return Failure(Status::Unsupported,"SM domain conversion/AlwaysMoveHandles semantics are not implemented");
+            convert=true;domain_object=current->second.next_object_id;
+            reply.status=Status::Ok;reply.payload.resize(4);
+            Put(reply.payload,0,domain_object);
+        } else if (parsed.request.command==3) {
+            const auto capacity=current->second.pointer_arena.size();
+            reply.status=Status::Ok;
+            reply.payload={std::byte(capacity),std::byte(capacity>>8)};
+        } else
+            return Failure(Status::Unsupported,"HIPC control command is not implemented: "+std::to_string(parsed.request.command));
+    } else if (parsed.domain_close) {
+        reply.status=Status::Ok;
+    } else if (current->second.sm) {
+        if (!parsed.buffers.empty()) return Failure(Status::Unsupported,"SM request has unexpected buffer descriptors");
+        if (parsed.request.command==0) {
+            if (!parsed.request.send_pid || parsed.request.payload.size()<8)
+                return Failure(Status::Malformed,"SM Initialize requires PID descriptor and 64-bit argument");
+            initialize=true;
+            reply.status=Status::Ok;
+        } else if (parsed.request.command==1) {
+            if (!current->second.initialized) return Failure(Status::InvalidState,"SM GetService before Initialize");
+            if (parsed.request.payload.size()<8) return Failure(Status::Malformed,"SM GetService truncated service name");
+            std::string name;
+            bool zero=false;
+            for (auto value:parsed.request.payload.first(8)) {
+                const char c=char(value);
+                if (!c) { zero=true; continue; }
+                if (zero) return Failure(Status::Malformed,"SM service name has nonzero bytes after terminator");
+                name.push_back(c);
+            }
+            if (!ValidName(name)) return Failure(Status::Malformed,"SM service name is invalid");
+            const auto factory=endpoints_.find(name);
+            if (factory==endpoints_.end()) return Failure(Status::Unsupported,"required native service is not implemented: "+name);
+            pending_endpoint=factory->second();
+            if (!pending_endpoint) return Failure(Status::Unsupported,"native endpoint factory declined: "+name);
+            if (next_handle_>SessionHandleLast) return Failure(Status::Exhausted,"native session handle partition exhausted");
+            moved=next_handle_;
+            reply.status=Status::Ok;
+        } else return Failure(Status::Unsupported,"SM command is not implemented: "+std::to_string(parsed.request.command));
+    } else {
+        reply=target->Prepare(parsed.request);
+        if (reply.status!=Status::Ok) return Failure(reply.status,reply.diagnostic.empty()?"endpoint command is not implemented":reply.diagnostic);
+        if (reply.moved_endpoint) {
+            if (reply.service_result)return Failure(Status::Malformed,"failed endpoint reply cannot expose a new object");
+            if (parsed.domain) {
+                if (current->second.next_object_id==UINT32_MAX || current->second.domain_objects.size()>=1024)
+                    return Failure(Status::Exhausted,"native domain object capacity exhausted");
+                domain_object=current->second.next_object_id;
+            } else {
+                if (next_handle_>SessionHandleLast) return Failure(Status::Exhausted,"native session handle partition exhausted");
+                moved=next_handle_;
+            }
+            pending_endpoint=std::move(reply.moved_endpoint);
+        }
+    }
+    std::unique_ptr<native::ScopedEventExport> event_export;
+    uint32_t copied_handle=0;
+    if (reply.copied_event) {
+        if (reply.service_result)return Failure(Status::Malformed,"failed service reply cannot expose an event");
+        if (reply.copied_event->OwnerProcessId()!=process_id_)
+            return Failure(Status::InvalidProcess,"readable event belongs to another native process");
+        if (!event_exporter_)return Failure(Status::Unsupported,"native readable event export backend is not installed");
+        event_export=event_exporter_(reply.copied_event,process_id_);
+        if (!event_export)return Failure(Status::Exhausted,"native readable event registry reservation failed");
+        copied_handle=event_export->Handle();
+        if (copied_handle<native::EventHandleBegin || copied_handle>=native::EventHandleEnd)
+            return Failure(Status::InvalidHandle,"event export is outside the owned event handle partition");
+    }
+    if (!Response(output,reply,moved,parsed.domain,parsed.domain?domain_object:0,copied_handle))
+        return Failure(Status::Malformed,"endpoint reply exceeds TLS message buffer");
+    // Allocate the session node before writing a response that exposes its handle.
+    if (moved) sessions_.emplace(moved,Session{false,false,process_id_,std::move(pending_endpoint),false,
+                                             std::vector<std::byte>(pointer_buffer_capacity_)});
+    if (convert)current->second.domain_objects.emplace(domain_object,std::move(current->second.endpoint));
+    else if (domain_object)current->second.domain_objects.emplace(domain_object,std::move(pending_endpoint));
+    if (!memory.write(memory.user,tls_base,output)) {
+        if (moved) sessions_.erase(moved);
+        if (convert) {
+            current->second.endpoint=std::move(current->second.domain_objects.at(domain_object));
+            current->second.domain_objects.erase(domain_object);
+        } else if (domain_object)current->second.domain_objects.erase(domain_object);
+        return Failure(Status::MemoryFault,"TLS response write failed");
+    }
+    if (moved) ++next_handle_;
+    if (domain_object)++current->second.next_object_id;
+    if (convert)current->second.domain=true;
+    if (parsed.domain_close)current->second.domain_objects.erase(parsed.object_id);
+    if (initialize) current->second.initialized=true;
+    if (event_export && !event_export->Commit())
+        throw std::runtime_error("native readable event export was revoked before commit; guest must not resume");
+    if (reply.commit) reply.commit();
+    return {};
+}
