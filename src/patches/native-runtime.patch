+#include "pending_owner_v3.h"
+#include <cstring>
+#include <iostream>
+#include <numeric>
+extern "C" {
+#ifdef RECOMP_FEATURE_GUARD_GEN1
+extern uint32_t *recomp_image_guard_gen_v1(uint32_t, uint64_t *, uint64_t *,
+                                           const uint64_t **);
+extern uint32_t *recomp_image_guard_gen_v1_pendingcaller(uint32_t, uint64_t *,
+                                                         uint64_t *,
+                                                         const uint64_t **);
+extern unsigned recomp_image_fastmem_v1(uint32_t, uint32_t, uint64_t, uint32_t,
+                                        uint32_t);
+extern unsigned recomp_image_fastmem_v1_pendingcaller(uint32_t, uint32_t,
+                                                      uint64_t, uint32_t,
+                                                      uint32_t);
+extern unsigned recomp_image_fpx_v1(uint32_t, uint32_t, uint64_t);
+extern unsigned recomp_image_fpx_v1_pendingcaller(uint32_t, uint32_t, uint64_t);
+extern unsigned recomp_image_features(void);
+extern uint64_t pending_fixture_guard_misses;
+extern uint32_t pending_fixture_guard_seen(void);
+#endif
+void recomp_image_set_base(uint64_t);
+unsigned recomp_image_guard_v2(unsigned);
+BlockFn recomp_image_lookup(uint64_t);
+void recomp_image_run_slice(GuestContext *);
+unsigned recomp_image_native_pending_v3(unsigned, unsigned, uint64_t, unsigned,
+                                        uint64_t);
+void recomp_image_set_base_pendingcaller(uint64_t);
+unsigned recomp_image_guard_v2_pendingcaller(unsigned);
+BlockFn recomp_image_lookup_pendingcaller(uint64_t);
+void recomp_image_run_slice_pendingcaller(GuestContext *);
+}
+using namespace native;
+static void check(bool value, const char *text) {
+  if (!value)
+    throw std::runtime_error(text);
+}
+template <class F> static bool rejects(F fn) {
+  try {
+    fn();
+  } catch (const std::exception &) {
+    return true;
+  }
+  return false;
+}
+static void acknowledge() {
+  check(recomp_image_native_pending_v3(
+            3, sizeof(GuestContext), RECOMP_NATIVE_PENDING_LAYOUT_V3,
+            RECOMP_HALT_NATIVE_PENDING_V3, RECOMP_NATIVE_PENDING_CAPS_V3) == 3,
+        "v3 module negotiation");
+}
+struct Work final : PendingWorkV3 {
+  bool resource = true, descriptor = true, fail = false, commit_fault = false,
+       dirty_abi = false;
+  unsigned snapshots = 0, runs = 0, commits = 0, cancels = 0;
+  bool snapshot_in_guest = false;
+  std::thread::id owner = std::this_thread::get_id();
+  std::function<void()> during_run, on_validate, on_commit;
+  bool validate(const Host &h,
+                const RecompNativePendingRequestV3 &r) const noexcept override {
+    try {
+      if (on_validate)
+        on_validate();
+      return resource && descriptor && r.descriptor &&
+             r.descriptor->operation == 1 && r.descriptor->signature == 1 &&
+             h.address_space->read(0x9100, 8) == 0x12345678;
+    } catch (...) {
+      return false;
+    }
+  }
+  bool snapshot(const Host &h, const GuestContext &c,
+                const RecompNativePendingRequestV3 &,
+                PendingInputV3 &input) const noexcept override {
+    try {
+      auto &self = const_cast<Work &>(*this);
+      ++self.snapshots;
+      self.snapshot_in_guest = h.guest_active();
+      if (c.x[1] != 16)
+        return false;
+      input.bytes.resize(16);
+      for (unsigned i = 0; i < 16; ++i)
+        input.bytes[i] = std::byte(h.address_space->read(c.x[0] + i, 1));
+      return true;
+    } catch (...) {
+      return false;
+    }
+  }
+  PendingResultV3 run(const PendingInputV3 &input) noexcept override {
+    ++runs;
+    if (std::this_thread::get_id() != owner)
+      return {};
+    if (during_run)
+      during_run();
+    uint64_t sum = 0;
+    for (auto b : input.bytes)
+      sum += std::to_integer<unsigned>(b);
+    return {!fail, sum, 17};
+  }
+  bool commit(Host &h, GuestContext &c, const RecompNativePendingRequestV3 &,
+              uint64_t result) noexcept override {
+    if (commit_fault || h.guest_active() || std::this_thread::get_id() != owner)
+      return false;
+    try {
+      if (on_commit)
+        on_commit();
+      h.write(0x9200, 8, result);
+      if (dirty_abi) {
+        for (unsigned i = 18; i < 32; ++i)
+          c.x[i] = 0xdead;
+        for (unsigned i = 8; i < 16; ++i)
+          c.vreg[i][0] = c.vreg[i][1] = 0xbeef;
+        c.fpcr = c.fpsr = 0;
+        c.pending_svc = 9;
+        c.x[0] = 0;
+        c.vreg[0][0] = c.vreg[0][1] = 0;
+      }
+      ++commits;
+      return true;
+    } catch (...) {
+      return false;
+    }
+  }
+  void cancel(uint64_t) noexcept override { ++cancels; }
+};
+static void terminal(GuestContext *c) { c->pending_svc = 7; }
+static BlockFn end_lookup(uint64_t pc) {
+  return pc == 0x5000 ? terminal : nullptr;
+}
+struct Fixture {
