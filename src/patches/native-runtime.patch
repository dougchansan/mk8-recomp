+#pragma once
+#include "address_space.h"
+#include <array>
+#include <filesystem>
+#include <string>
+namespace native {
+struct NsoSegment {
+  uint32_t offset{};
+  uint64_t memory_size{};
+  unsigned permission{};
+  std::vector<uint8_t> bytes;
+};
+struct NsoImage {
+  std::string name;
+  std::array<uint8_t, 32> build_id{};
+  std::array<NsoSegment, 3> segments;
+  uint64_t image_size{};
+  uint32_t dynstr_offset{}, dynstr_size{}, dynsym_offset{}, dynsym_size{};
+};
+NsoImage load_nso(const std::filesystem::path &path);
+void map_nso(AddressSpace &space, const NsoImage &image, uint64_t base);
+struct BootModule {
+  uint64_t base;
+  NsoImage image;
+};
+// Pre-relocate rtld only. Other modules remain byte-identical for the guest
+// linker.
+struct RelocationRecord {
+  uint64_t address, value;
+  uint32_t type;
+  std::string symbol;
+  bool weak_null;
+};
+size_t relocate_rtld(AddressSpace &space,
+                     const std::vector<BootModule> &modules,
+                     std::vector<RelocationRecord> *audit);
+size_t relocate_rtld(AddressSpace &space,
+                     const std::vector<BootModule> &modules);
+std::string build_id_hex(const NsoImage &image);
+} // namespace native
