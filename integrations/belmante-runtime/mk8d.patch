+namespace nx::nvn {
+struct Sdk53SamplerValues {uint64_t device{};uint32_t min{},mag{},mode{},func{},reduction{};std::array<uint32_t,3> wrap{};float lod_min{},lod_max{},bias{},anisotropy{};std::array<float,4> border{};};
+inline Sdk53SamplerValues sdk53_sampler_values(std::span<const uint8_t> bytes){
+ if(bytes.size()<0x50)throw std::invalid_argument("truncated SDK53 sampler values");
+ auto get=[&]<class T>(size_t offset){T value;std::memcpy(&value,bytes.data()+offset,sizeof value);return value;};
+ Sdk53SamplerValues s;s.device=get.template operator()<uint64_t>(8);s.min=get.template operator()<uint32_t>(0x10);s.mag=get.template operator()<uint32_t>(0x14);
+ for(size_t i=0;i<3;++i)s.wrap[i]=get.template operator()<uint32_t>(0x18+i*4);
+ s.lod_min=get.template operator()<float>(0x24);s.lod_max=get.template operator()<float>(0x28);s.bias=get.template operator()<float>(0x2c);s.mode=get.template operator()<uint32_t>(0x30);s.func=get.template operator()<uint32_t>(0x34);
+ for(size_t i=0;i<4;++i)s.border[i]=get.template operator()<float>(0x38+i*4);
+ s.anisotropy=get.template operator()<float>(0x48);s.reduction=get.template operator()<uint32_t>(0x4c);
+ if(!s.device||s.min>5||s.mag>1||s.mode>1||s.func<1||s.func>8||s.reduction>2||!std::isfinite(s.lod_min)||!std::isfinite(s.lod_max)||!std::isfinite(s.bias)||!std::isfinite(s.anisotropy)||s.anisotropy<1)throw std::invalid_argument("invalid SDK53 sampler values");
+ for(auto wrap:s.wrap)if(wrap>7)throw std::invalid_argument("invalid SDK53 sampler wrap");
+ for(auto border:s.border)if(!std::isfinite(border))throw std::invalid_argument("invalid SDK53 sampler border");
+ return s;
+}
+}
