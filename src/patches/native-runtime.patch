+                h.event_registry.GetReadable(copied) == event,
+            "failed event reply consumes no client identity; next reply owns "
+            "actual event");
+    }
+    std::cout << "PASS CPU SVC/native SM/TLS bridge ownership, actual wire and "
+                 "atomic rejection\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << "FAIL " << e.what() << "\n";
+    return 1;
+  }
+}
