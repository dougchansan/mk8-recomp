+                !f->host.waiting(),
+            "cooperative owner yields after real SVC unwind without servicing");
+      f->host.dispatch(3, 1, true);
+      check(f->host.waiting() && f->host.blocks == 1 && f->host.svc_calls == 1,
+            "cooperative owner services wait exactly once on next turn");
+      const auto saved = f->host.context;
+      f->host.dispatch(3, 1, true);
+      check(memcmp(&saved, &f->host.context, sizeof(saved)) == 0 &&
+                f->host.blocks == 1,
+            "cooperative parked turns preserve context and budget");
+    }
+    for (unsigned mode = 0; mode < 2; ++mode) {
+      auto f = std::make_unique<Fixture>();
+      if (mode)
+        f->host.context.x[3] = 5;
+      f->host.dispatch(3, 64);
+      auto before = f->host.context;
+      if (mode)
