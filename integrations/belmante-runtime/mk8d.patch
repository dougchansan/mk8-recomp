+        if (data[0] == 0) {
+            return false;
+        }
+
+        std::size_t index = 1;
+        while (index < MaxNameSize && data[index] != 0) {
+            index++;
+        }
+        while (index < MaxNameSize && data[index] == 0) {
+            index++;
+        }
+        return index == MaxNameSize;
