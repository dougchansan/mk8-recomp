+        acquired_index.reset();
+      } catch (...) {
+        terminal = true;
+        if (!forever && std::chrono::steady_clock::now() >= deadline)
+          throw;
+        Pump();
+        Sleep(1);
+      }
+    }
+  }
+  void Close() {
+    Owner();
+    if (closed)
+      return;
+    RetireFlight(true);
+    RetireImages(true);
+    DestroyImages();
+    if (acquire)
+      P(vkDestroySemaphore)(device, acquire, nullptr);
+    acquire = VK_NULL_HANDLE;
+    closed = true;
+  }
+  ~Impl() {
+    try {
+      Close();
+    } catch (...) {
+      std::terminate();
+    }
+  }
+};
+Presenter::Presenter(Resources &r, GuestAddress d,
+                     std::shared_ptr<native::Window> w)
+    : impl_(std::make_unique<Impl>(r, d, std::move(w))) {}
+Presenter::~Presenter() = default;
+std::array<uint32_t, 2> Presenter::Extent() {
+  auto &o = *impl_;
+  o.Owner();
+  o.Pump();
+  if (o.closed)
+    return {0, 0};
+  const auto client = o.window->client_extent();
+  if (client != o.extent && !o.terminal)
+    o.Recreate();
+  return o.extent;
+}
+PresentationResult Presenter::Present(PresentSource &source,
+                                      SourceEncoding encoding) {
+  auto &o = *impl_;
+  o.Owner();
+  Need(encoding == SourceEncoding::LinearSrgb,
+       "Unsupported source color encoding");
+  Need(!o.terminal && !o.closed, "Presenter closed/terminal");
+  Need(source.Device() == o.key && source.DeviceIdentity() == o.handles.device,
+       "Presentation source belongs to another device");
+  o.Pump();
+  if (o.window->close_requested() || o.window->quit_requested())
+    return PresentationResult::Closed;
+  auto sample =
+      source.Sample(0); // Revalidate retained source before any acquire.
+  auto size = Extent();
+  if (!size[0] || !size[1])
+    return PresentationResult::Paused;
+  if (sample.width != size[0] || sample.height != size[1])
+    return PresentationResult::ResizeRequired;
+  uint32_t index = 0;
+  auto acquired = o.P(vkAcquireNextImageKHR)(o.device, o.swapchain, 0,
+                                             o.acquire, VK_NULL_HANDLE, &index);
+  if (acquired == VK_NOT_READY || acquired == VK_TIMEOUT)
+    return PresentationResult::Pending;
+  if (acquired == VK_ERROR_OUT_OF_DATE_KHR) {
+    o.Recreate();
+    return PresentationResult::ResizeRequired;
+  }
+  if (acquired != VK_SUCCESS && acquired != VK_SUBOPTIMAL_KHR) {
+    o.terminal = true;
+    Check(acquired, "Acquire next image");
+  }
+  Need(index < o.images.size(), "Acquired image outside swapchain");
+  auto &image = o.images[index];
+  ++o.counters.acquired;
+  auto &flight = o.flight;
+  flight = PresentationFlight{};
+  o.acquired_index = index;
+  flight.Acquire(acquired == VK_SUBOPTIMAL_KHR ? AcquireStatus::Suboptimal
+                                               : AcquireStatus::Ready);
+  try {
+    if (o.window->close_requested() || o.window->client_extent() != o.extent) {
+      o.Consume(o.acquire);
+      flight.SynchronizationConsumed();
+      o.Release(index);
+      flight.Retired();
+      o.acquired_index.reset();
+      return o.window->close_requested() ? PresentationResult::Closed
+                                         : PresentationResult::ResizeRequired;
+    }
+    if (image.present_pending) {
+      Need(o.Wait(image.present, false), "Previous presentation still pending");
+      image.present_pending = false;
+    }
+    Check(o.P(vkResetFences)(o.device, 1, &image.present),
+          "Reset retired present fence");
+    bool attempted = false, accepted = false;
+    NativeTarget target{reinterpret_cast<uintptr_t>(image.image),
+                        reinterpret_cast<uintptr_t>(image.view),
+                        uint32_t(image.initialized
+                                     ? VK_IMAGE_LAYOUT_PRESENT_SRC_KHR
+                                     : VK_IMAGE_LAYOUT_UNDEFINED),
+                        AttachmentLoad::Clear,
+                        AttachmentStore::Store,
+                        {0, 0, 0, 1},
+                        &attempted,
+                        &accepted};
+    target.presentation_format = o.format;
+    target.wait_semaphore = reinterpret_cast<uintptr_t>(o.acquire);
+    target.signal_semaphore = reinterpret_cast<uintptr_t>(image.finished);
+    target.pump = [&] { o.Pump(); };
+    DrawDescription draw;
+    draw.width = size[0];
+    draw.height = size[1];
+    draw.viewport.width = float(size[0]);
+    draw.viewport.height = float(size[1]);
+    draw.scissor.width = size[0];
+    draw.scissor.height = size[1];
+    draw.procedural_triangle = true;
+    try {
+      DrawIntoTarget(o.resources, o.key,
+                     {o.vertex, o.fragment, std::span(&o.plan, 1)}, draw,
+                     target, std::span(&sample, 1), {});
+    } catch (...) {
+      if (accepted) {
+        flight.RenderComplete();
+        source.Fail();
+      } else if (attempted) {
+        o.terminal = true;
+      }
+      throw;
+    }
+    ++o.counters.submitted;
+    flight.RenderComplete();
+    source.CommitRead();
+    image.initialized = true;
+    VkSwapchainPresentFenceInfoKHR fence{
+        VK_STRUCTURE_TYPE_SWAPCHAIN_PRESENT_FENCE_INFO_KHR};
+    fence.swapchainCount = 1;
+    fence.pFences = &image.present;
+    VkPresentInfoKHR info{VK_STRUCTURE_TYPE_PRESENT_INFO_KHR};
+    info.pNext = &fence;
+    info.waitSemaphoreCount = 1;
+    info.pWaitSemaphores = &image.finished;
+    info.swapchainCount = 1;
+    info.pSwapchains = &o.swapchain;
+    info.pImageIndices = &index;
+    auto result = o.P(vkQueuePresentKHR)(o.queue, &info);
+    if (result == VK_SUCCESS || result == VK_SUBOPTIMAL_KHR ||
+        result == VK_ERROR_OUT_OF_DATE_KHR ||
+        result == VK_ERROR_SURFACE_LOST_KHR) {
+      image.present_pending = true;
+      ++o.counters.present_queued;
+      flight.Present(result == VK_SUCCESS          ? PresentStatus::Queued
+                     : result == VK_SUBOPTIMAL_KHR ? PresentStatus::Suboptimal
+                                                   : PresentStatus::OutOfDate);
+      Need(o.Wait(image.present, false),
+           "Presentation retirement deadline exceeded");
+      image.present_pending = false;
+      ++o.counters.retired;
+      flight.Retired();
+      o.acquired_index.reset();
+      if (result == VK_ERROR_SURFACE_LOST_KHR) {
+        o.terminal = true;
+        throw std::runtime_error("Surface lost");
+      }
+      if (result != VK_SUCCESS || acquired == VK_SUBOPTIMAL_KHR) {
+        o.Recreate();
+        return PresentationResult::ResizeRequired;
+      }
+      return PresentationResult::Presented;
+    }
+    if (result == VK_ERROR_DEVICE_LOST) {
+      o.device_lost = o.terminal = true;
+      flight.Present(PresentStatus::DeviceLost);
+      Check(result, "Present device lost");
+    }
+    flight.Present(PresentStatus::NotEnqueued);
+    Check(result, "Present not enqueued");
+  } catch (...) {
+    ++o.counters.failures;
+    o.terminal = true;
+    o.RetireFlight(true);
+    throw;
+  }
+  throw std::runtime_error("Unexpected present status");
+}
+void Presenter::Close() { impl_->Close(); }
+PresentationCounters Presenter::Counters() const {
+  impl_->Owner();
+  return impl_->counters;
+}
+PresentationFormat Presenter::Format() const {
+  impl_->Owner();
+  return impl_->format;
+}
+} // namespace native_nvn
diff --git a/native-runtime/nvn/presentation.h b/native-runtime/nvn/presentation.h
new file mode 100644
--- /dev/null
+++ b/native-runtime/nvn/presentation.h
@@ -0,0 +1,65 @@
+#pragma once
+#include "frame.h"
+#include <memory>
+namespace native_nvn {
+enum class AcquireStatus { Ready, Suboptimal, Pending, OutOfDate, Failed };
+enum class PresentStatus {
+  Queued,
+  Suboptimal,
+  OutOfDate,
+  NotEnqueued,
+  DeviceLost
+};
+enum class Retirement {
+  None,
+  ConsumeAcquire,
+  ConsumeRender,
+  ReleaseImage,
+  WaitPresent
+};
+// Pure policy exercised before any WSI fixture. A queued presentation is not
+// retired by render completion; a separate present fence owns that transition.
+struct PresentationFlight {
+  bool acquired = false, acquire_consumed = false, rendered = false,
+       render_consumed = false, present_pending = false, recreate = false,
+       terminal = false;
+  void Acquire(AcquireStatus);
+  void RenderComplete();
+  void Present(PresentStatus);
+  void SynchronizationConsumed();
+  void Retired();
+  Retirement RequiredRetirement() const;
+};
+double EncodeSrgb(double linear);
+std::vector<uint32_t> PresentationVertexShader();
+std::vector<uint32_t> PresentationFragmentShader(bool encode_srgb);
+std::shared_ptr<const native_graphics::Win32SurfaceTarget>
+    RetainPresentationWindow(std::shared_ptr<native::Window>);
+enum class SourceEncoding { LinearSrgb };
+enum class PresentationResult {
+  Presented,
+  Pending,
+  Paused,
+  ResizeRequired,
+  Closed
+};
+struct PresentationCounters {
+  uint64_t acquired = 0, submitted = 0, present_queued = 0, retired = 0,
+           recreated = 0, failures = 0;
+};
+class Presenter {
+public:
+  Presenter(Resources &, GuestAddress, std::shared_ptr<native::Window>);
+  ~Presenter();
+  Presenter(const Presenter &) = delete;
+  std::array<uint32_t, 2> Extent();
+  PresentationResult Present(PresentSource &, SourceEncoding);
+  void Close();
+  PresentationCounters Counters() const;
+  PresentationFormat Format() const;
+
+private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+};
+} // namespace native_nvn
diff --git a/native-runtime/nvn/presentation_conversion_test.cpp b/native-runtime/nvn/presentation_conversion_test.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/nvn/presentation_conversion_test.cpp
@@ -0,0 +1,95 @@
+#include "presentation.h"
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <iostream>
+using namespace native_nvn;
+void Need(bool b, const char *w) {
+  if (!b)
+    throw std::runtime_error(w);
+}
+int main() {
+  try {
+    Resources resources(
+        {nullptr,
+         [](void *, GuestAddress, std::span<std::byte>) { return false; },
+         [](void *, GuestAddress, std::span<const std::byte>) {
+           return false;
+         }});
+    resources.CreateDevice(0x1000);
+    uint64_t pixels = 0;
+    unsigned rejected = 0;
+    for (bool packed : {false, true}) {
+      FrameImages images(resources, 0x1000);
+      ImageDescription d;
+      d.width = d.height = 1;
+      d.format =
+          packed ? ImageFormat::A2B10G10R10Unorm : ImageFormat::Rgba8Unorm;
+      auto source = images.CreateImage(d);
+      std::array<std::byte, 4> bytes;
+      std::array<double, 3> linear;
+      if (packed) {
+        uint32_t word = 77u | (511u << 10) | (839u << 20) | (1u << 30);
+        for (unsigned i = 0; i < 4; ++i)
+          bytes[i] = std::byte(word >> (i * 8));
+        linear = {77 / 1023., 511 / 1023., 839 / 1023.};
+      } else {
+        bytes = {std::byte{64}, std::byte{128}, std::byte{192}, std::byte{85}};
+        linear = {64 / 255., 128 / 255., 192 / 255.};
+      }
+      images.UploadInitialContents(source, bytes);
+      ViewDescription vd;
+      vd.format = d.format;
+      auto view = images.CreateView(source, vd);
+      auto sampler = images.CreateSampler();
+      auto target = images.CreateImage({});
+      auto tv = images.CreateView(target);
+      auto vertex = PresentationVertexShader(),
+           fragment = PresentationFragmentShader(true);
+      DescriptorPlan plan{0, DescriptorKind::CombinedImageSampler2D,
+                          ShaderStage::Fragment};
+      DrawDescription draw;
+      draw.procedural_triangle = true;
+      SampleBinding sample{0, view, sampler};
+      {
+        FrameEncoder f(images);
+        f.Draw({vertex, fragment, std::span(&plan, 1)}, draw,
+               {tv, AttachmentLoad::Clear}, std::span(&sample, 1));
+        f.SubmitAndWait();
+      }
+      auto result = images.Readback(target);
+      for (size_t i = 0; i < result.rgba8.size(); i += 4) {
+        for (unsigned k = 0; k < 3; ++k) {
+          int expected = int(std::lround(EncodeSrgb(linear[k]) * 255));
+          Need(std::abs(int(result.rgba8[i + k]) - expected) <= 1,
+               "GPU presentation encode differs from independent CPU oracle");
+        }
+        Need(result.rgba8[i + 3] == std::byte{255},
+             "Opaque presentation alpha differs");
+        ++pixels;
+      }
+      auto retained = images.BorrowPresentation(view, sampler);
+      retained.Fail();
+      auto before = images.Counters();
+      bool declined = false;
+      try {
+        retained.Sample(0);
+      } catch (const std::runtime_error &) {
+        declined = true;
+      }
+      Need(declined, "Invalid retained source accepted");
+      auto after = images.Counters();
+      Need(before.submitted == after.submitted &&
+               before.recorded == after.recorded,
+           "Invalid retained source changed frame counters");
+      ++rejected;
+    }
+    std::cout << "{\"passed\":true,\"presentation_encode_pixels\":" << pixels
+              << ",\"rgba8_and_packed10\":true,\"terminal_source_rejected\":"
+              << rejected << ",\"window_calls\":0}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
diff --git a/native-runtime/nvn/presentation_fixture.cpp b/native-runtime/nvn/presentation_fixture.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/nvn/presentation_fixture.cpp
@@ -0,0 +1,428 @@
+#include "../window.h"
+#include "presentation.h"
+#include <chrono>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <sirit/sirit.h>
+#include <sstream>
+using namespace native_nvn;
+namespace {
+void Need(bool b, const char *w) {
+  if (!b)
+    throw std::runtime_error(w);
+}
+std::vector<uint32_t> Pattern() {
+  Sirit::Module m(0x00010000);
+  m.AddCapability(spv::Capability::Shader);
+  m.SetMemoryModel(spv::AddressingModel::Logical, spv::MemoryModel::GLSL450);
+  auto f = m.TypeFloat(32), v2 = m.TypeVector(f, 2), v4 = m.TypeVector(f, 4);
+  auto input = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Input, v2),
+                                   spv::StorageClass::Input),
+       out = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Output, v4),
+                                 spv::StorageClass::Output);
+  m.Decorate(input, spv::Decoration::Location, 0u);
+  m.Decorate(out, spv::Decoration::Location, 0u);
+  auto zero = m.Constant(f, 0.f), one = m.Constant(f, 1.f),
+       quarter = m.Constant(f, .25f);
+  auto fn = m.OpFunction(m.TypeVoid(), spv::FunctionControlMask::MaskNone,
+                         m.TypeFunction(m.TypeVoid()));
+  m.AddLabel();
+  auto uv = m.OpLoad(v2, input), u = m.OpCompositeExtract(f, uv, 0u),
+       v = m.OpCompositeExtract(f, uv, 1u);
+  auto corner =
+      m.OpLogicalAnd(m.TypeBool(), m.OpFOrdLessThan(m.TypeBool(), u, quarter),
+                     m.OpFOrdLessThan(m.TypeBool(), v, quarter));
+  m.OpStore(out,
+            m.OpCompositeConstruct(v4, m.OpSelect(f, corner, one, u),
+                                   m.OpSelect(f, corner, zero, v),
+                                   m.OpSelect(f, corner, zero, quarter), one));
+  m.OpReturn();
+  m.OpFunctionEnd();
+  m.AddEntryPoint(spv::ExecutionModel::Fragment, fn, "main", input, out);
+  m.AddExecutionMode(fn, spv::ExecutionMode::OriginUpperLeft);
+  return m.Assemble();
+}
+void Capture(HWND window, const std::filesystem::path &path) {
+  // Desktop DC coordinates are physical pixels. All extent/origin and
+  // occlusion checks must use that same DPI context, not virtualized units.
+  const auto previous =
+      SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
+  if (!previous)
+    throw std::runtime_error("Physical-pixel capture DPI context unavailable");
+  struct RestoreDpi {
+    DPI_AWARENESS_CONTEXT value;
+    ~RestoreDpi() { SetThreadDpiAwarenessContext(value); }
+  } restore{previous};
+  RECT r{};
+  Need(GetClientRect(window, &r), "Capture client rectangle");
+  const int width = r.right, height = r.bottom;
+  Need(width > 0 && height > 0 &&
+           uint64_t(width) * height * 4 <= 64ull * 1024 * 1024,
+       "Capture extent/budget invalid");
+  POINT origin{0, 0};
+  Need(ClientToScreen(window, &origin) != FALSE, "Capture client origin");
+  auto verify_owner = [&] {
+    Need(IsWindowVisible(window) && !IsIconic(window),
+         "Capture window not visible");
+    RECT client{origin.x, origin.y, origin.x + width, origin.y + height};
+    for (int gy = 0; gy < 3; ++gy)
+      for (int gx = 0; gx < 3; ++gx) {
+        POINT pt{origin.x + 1 + (width - 3) * gx / 2,
+                 origin.y + 1 + (height - 3) * gy / 2};
+        const auto hit = WindowFromPoint(pt), root = GetAncestor(hit, GA_ROOT);
+        if (root != window) {
+          RECT wr{};
+          GetWindowRect(window, &wr);
+          DWORD pid = 0;
+          const auto thread = GetWindowThreadProcessId(root, &pid);
+          std::ostringstream error;
+          error << "Capture declined owner/root: expected="
+                << reinterpret_cast<uintptr_t>(window)
+                << " hit=" << reinterpret_cast<uintptr_t>(hit)
+                << " root=" << reinterpret_cast<uintptr_t>(root)
+                << " root_pid=" << pid << " root_thread=" << thread
+                << " point=" << pt.x << ',' << pt.y << " client=" << client.left
+                << ',' << client.top << ',' << client.right << ','
+                << client.bottom << " window=" << wr.left << ',' << wr.top
+                << ',' << wr.right << ',' << wr.bottom
+                << " dpi=" << GetDpiForWindow(window);
+          throw std::runtime_error(error.str());
+        }
+      }
+    unsigned checked = 0;
+    for (HWND above = GetWindow(window, GW_HWNDPREV); above;
+         above = GetWindow(above, GW_HWNDPREV)) {
+      Need(++checked <= 1024, "Capture Z-order bound exceeded");
+      if (!IsWindowVisible(above) || IsIconic(above))
+        continue;
+      RECT bounds{}, overlap{};
+      Need(GetWindowRect(above, &bounds) != FALSE, "Capture occlusion bounds");
+      if (IntersectRect(&overlap, &client, &bounds)) {
+        DWORD pid = 0;
+        GetWindowThreadProcessId(above, &pid);
+        std::ostringstream error;
+        error << "Capture declined occlusion: above="
+              << reinterpret_cast<uintptr_t>(above) << " pid=" << pid
+              << " client=" << client.left << ',' << client.top << ','
+              << client.right << ',' << client.bottom
+              << " overlap=" << overlap.left << ',' << overlap.top << ','
+              << overlap.right << ',' << overlap.bottom;
+        throw std::runtime_error(error.str());
+      }
+    }
+  };
+  verify_owner();
+  HDC dc = GetDC(nullptr);
+  if (!dc)
+    throw std::runtime_error("Capture window DC");
+  HDC copy = CreateCompatibleDC(dc);
+  BITMAPINFO info{};
+  info.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+  info.bmiHeader.biWidth = width;
+  info.bmiHeader.biHeight = -height;
+  info.bmiHeader.biPlanes = 1;
+  info.bmiHeader.biBitCount = 32;
+  void *pixels = nullptr;
+  HBITMAP bitmap =
+      CreateDIBSection(dc, &info, DIB_RGB_COLORS, &pixels, nullptr, 0);
+  if (!copy || !bitmap || !pixels) {
+    if (bitmap)
+      DeleteObject(bitmap);
+    if (copy)
+      DeleteDC(copy);
+    ReleaseDC(nullptr, dc);
+    throw std::runtime_error("Capture bitmap allocation");
+  }
+  auto prior = SelectObject(copy, bitmap);
+  bool ok = BitBlt(copy, 0, 0, width, height, dc, origin.x, origin.y,
+                   SRCCOPY | CAPTUREBLT) != FALSE;
+  GdiFlush();
+  try {
+    verify_owner();
+  } catch (...) {
+    ok = false;
+  }
+  if (ok) {
+    BITMAPFILEHEADER header{};
+    header.bfType = 0x4d42;
+    header.bfOffBits = sizeof(header) + sizeof(BITMAPINFOHEADER);
+    header.bfSize = header.bfOffBits + DWORD(width * height * 4);
+    std::filesystem::create_directories(path.parent_path());
+    std::ofstream file(path, std::ios::binary);
+    file.write(reinterpret_cast<const char *>(&header), sizeof(header));
+    file.write(reinterpret_cast<const char *>(&info.bmiHeader),
+               sizeof(info.bmiHeader));
+    file.write(static_cast<const char *>(pixels), width * height * 4);
+    ok = bool(file);
+  }
+  SelectObject(copy, prior);
+  DeleteObject(bitmap);
+  DeleteDC(copy);
+  ReleaseDC(nullptr, dc);
+  Need(ok, "Owned-window capture failed");
+}
+} // namespace
+int main(int argc, char **argv) {
+  bool visible = false, resize = false;
+  unsigned frames = 90;
+  std::filesystem::path prefix;
+  for (int i = 1; i < argc; ++i) {
+    std::string arg = argv[i];
+    if (arg == "--visible")
+      visible = true;
+    else if (arg == "--exercise-resize")
+      resize = true;
+    else if (arg == "--frames" && i + 1 < argc)
+      frames = unsigned(std::stoul(argv[++i]));
+    else if (arg == "--capture-prefix" && i + 1 < argc)
+      prefix = argv[++i];
+    else {
+      std::cerr << "Unsupported fixture arguments\n";
+      return 1;
+    }
+  }
+  if (!visible || frames < 45 || frames > 600) {
+    std::cerr << "Explicit --visible required; frames45..600. Synthetic window "
+                 "only.\n";
+    return 1;
+  }
+  try {
+    // Select the fixture's physical-pixel policy before HWND creation; changing
+    // only the capture call context leaves an unaware HWND virtualized.
+    const auto old_dpi = SetThreadDpiAwarenessContext(
+        DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
+    if (!old_dpi)
+      throw std::runtime_error("Per-monitor-aware fixture context unavailable");
+    struct FixtureDpi {
+      DPI_AWARENESS_CONTEXT prior;
+      ~FixtureDpi() { SetThreadDpiAwarenessContext(prior); }
+    } dpi{old_dpi};
+    auto window = std::make_shared<native::Window>(
+        L"Native synthetic Vulkan presentation - no game");
+    auto surface = RetainPresentationWindow(window);
+    auto ownerpid = window->process_id(), sourceid = window->source_id();
+    auto start = std::chrono::steady_clock::now();
+    PresentationCounters counters;
+    uint64_t reads = 0;
+    bool both_rgba = false, both_packed = false, paused = false,
+         close_checked = false;
+    PresentationFormat selected{};
+    native_graphics::PresentationDiagnostics diagnostics;
+    {
+      Resources resources(
+          {nullptr,
+           [](void *, GuestAddress, std::span<std::byte>) { return false; },
+           [](void *, GuestAddress, std::span<const std::byte>) {
+             return false;
+           }});
+      native_graphics::DeviceOptions options{true, false, 0};
+      options.presentation = surface;
+      resources.CreateDevice(0x1000, options);
+      diagnostics = resources.Backend(0x1000).GetPresentationDiagnostics();
+      bool destroy_rejected = false;
+      try {
+        window->Destroy();
+      } catch (const std::logic_error &) {
+        destroy_rejected = true;
+      }
+      Need(destroy_rejected, "Live surface did not retain window");
+      Presenter presenter(resources, 0x1000, window);
+      FrameImages images(resources, 0x1000);
+      auto vs = PresentationVertexShader(), fs = Pattern();
+      ProgramDescription pattern{vs, fs, {}};
+      { // A retained source invalidated after borrowing must not
+        // acquire/submit.
+        const auto size = presenter.Extent();
+        Need(size[0] && size[1], "Initial fixture extent unavailable");
+        FrameImages probe(resources, 0x1000);
+        ImageDescription d;
+        d.width = size[0];
+        d.height = size[1];
+        auto image = probe.CreateImage(d);
+        auto view = probe.CreateView(image);
+        auto sampler = probe.CreateSampler();
+        DrawDescription draw;
+        draw.width = size[0];
+        draw.height = size[1];
+        draw.viewport.width = float(size[0]);
+        draw.viewport.height = float(size[1]);
+        draw.scissor.width = size[0];
+        draw.scissor.height = size[1];
+        draw.procedural_triangle = true;
+        {
+          FrameEncoder frame(probe);
+          frame.Draw(pattern, draw, {view, AttachmentLoad::Clear});
+          frame.SubmitAndWait();
+        }
+        auto retained = probe.BorrowPresentation(view, sampler);
+        retained.Fail();
+        const auto before = presenter.Counters();
+        bool rejected = false;
+        try {
+          presenter.Present(retained, SourceEncoding::LinearSrgb);
+        } catch (const std::runtime_error &) {
+          rejected = true;
+        }
+        const auto after = presenter.Counters();
+        Need(rejected && before.acquired == after.acquired &&
+                 before.submitted == after.submitted &&
+                 before.present_queued == after.present_queued,
+             "Invalid retained source caused presentation effects");
+      }
+
+      ImageHandle image;
+      ViewHandle view;
+      SamplerHandle sampler = images.CreateSampler();
+      std::array<uint32_t, 2> current{};
+      ImageFormat current_format = ImageFormat::Rgba8Unorm;
+      unsigned presented = 0;
+      bool minimized_once = false, resized_once = false;
+      while (presented < frames) {
+        window->Pump();
+        if (window->close_requested())
+          break;
+        Need(
+            std::chrono::steady_clock::now() - start < std::chrono::seconds(30),
+            "Fixture wall budget exceeded (driver calls are not hard bounded)");
+        auto extent = presenter.Extent();
+        if (!extent[0] || !extent[1]) {
+          window->WaitAndPump(std::chrono::milliseconds(10));
+          continue;
+        }
+        auto format = presented >= frames / 2 ? ImageFormat::A2B10G10R10Unorm
+                                              : ImageFormat::Rgba8Unorm;
+        if (current != extent || format != current_format || !image.value) {
+          if (view.value)
+            images.DestroyView(view);
+          if (image.value)
+            images.DestroyImage(image);
+          ImageDescription d;
+          d.width = extent[0];
+          d.height = extent[1];
+          d.format = format;
+          image = images.CreateImage(d);
+          ViewDescription vd;
+          vd.format = format;
+          view = images.CreateView(image, vd);
+          current = extent;
+          current_format = format;
+        }
+        DrawDescription draw;
+        draw.width = current[0];
+        draw.height = current[1];
+        draw.viewport.width = float(current[0]);
+        draw.viewport.height = float(current[1]);
+        draw.scissor.width = current[0];
+        draw.scissor.height = current[1];
+        draw.procedural_triangle = true;
+        {
+          FrameEncoder encoder(images);
+          encoder.Draw(pattern, draw, {view, AttachmentLoad::Clear});
+          encoder.SubmitAndWait();
+        }
+        {
+          auto source = images.BorrowPresentation(view, sampler);
+          auto result = presenter.Present(source, SourceEncoding::LinearSrgb);
+          if (result == PresentationResult::Presented) {
+            ++presented;
+            both_rgba |= format == ImageFormat::Rgba8Unorm;
+            both_packed |= format == ImageFormat::A2B10G10R10Unorm;
+          } else if (result == PresentationResult::Closed)
+            break;
+          else
+            window->WaitAndPump(std::chrono::milliseconds(2));
+        }
+        if (!prefix.empty() && (presented == 5 || presented == frames - 5)) {
+          window->WaitAndPump(std::chrono::milliseconds(40));
+          Capture(window->handle(),
+                  prefix.string() +
+                      (presented == 5 ? "-rgba.bmp" : "-packed.bmp"));
+        }
+        if (resize && presented >= 10 && !minimized_once) {
+          ShowWindow(window->handle(), SW_MINIMIZE);
+          window->Pump();
+          Need(presenter.Extent() == std::array<uint32_t, 2>{0, 0},
+               "Minimized presentation did not pause");
+          {
+            auto source = images.BorrowPresentation(view, sampler);
+            paused = presenter.Present(source, SourceEncoding::LinearSrgb) ==
+                     PresentationResult::Paused;
+          }
+          window->WaitAndPump(std::chrono::milliseconds(30));
+          ShowWindow(window->handle(), SW_RESTORE);
+          window->Pump();
+          minimized_once = true;
+        }
+        if (resize && presented >= 20 && !resized_once) {
+          Need(SetWindowPos(window->handle(), nullptr, 0, 0, 800, 480,
+                            SWP_NOMOVE | SWP_NOZORDER) != FALSE,
+               "Fixture resize");
+          window->Pump();
+          resized_once = true;
+        }
+      }
+      Need(presented == frames && both_rgba && both_packed,
+           "Fixture did not present both native source formats");
+      PostMessageW(window->handle(), WM_CLOSE, 0, 0);
+      window->Pump();
+      {
+        auto source = images.BorrowPresentation(view, sampler);
+        close_checked = presenter.Present(source, SourceEncoding::LinearSrgb) ==
+                        PresentationResult::Closed;
+      }
+      presenter.Close();
+      counters = presenter.Counters();
+      selected = presenter.Format();
+      reads = images.Counters().readbacks;
+      Need(reads == 0 && counters.present_queued == counters.retired,
+           "Presentation used CPU readback or leaked pending present "
+           "references");
+      if (resize)
+        Need(paused && counters.recreated >= 2,
+             "Resize/minimize not exercised");
+      Need(close_checked, "Close not observed");
+      images.DestroyView(view);
+      images.DestroyImage(image);
+      images.DestroySampler(sampler);
+    }
+    surface.reset();
+    window->Destroy();
+    std::cout << "{\"wsi_capabilities\":true,\"api_version\":"
+              << diagnostics.api_version
+              << ",\"driver_version\":" << diagnostics.driver_version
+              << ",\"vendor_id\":" << diagnostics.vendor_id
+              << ",\"device_id\":" << diagnostics.device_id
+              << ",\"queue_family\":" << diagnostics.queue_family
+              << ",\"maintenance_khr\":"
+              << (diagnostics.maintenance_khr ? "true" : "false")
+              << ",\"instance_extensions\":[";
+    for (size_t i = 0; i < diagnostics.instance_extensions.size(); ++i) {
+      if (i)
+        std::cout << ',';
+      std::cout << '"' << diagnostics.instance_extensions[i] << '"';
+    }
+    std::cout << "],\"device_extensions\":[";
+    for (size_t i = 0; i < diagnostics.device_extensions.size(); ++i) {
+      if (i)
+        std::cout << ',';
+      std::cout << '"' << diagnostics.device_extensions[i] << '"';
+    }
+    std::cout << "]}\n";
+    std::cout << "{\"passed\":true,\"synthetic_only\":true,\"pid\":" << ownerpid
+              << ",\"window_source_id\":" << sourceid
+              << ",\"present_queued\":" << counters.present_queued
+              << ",\"retired\":" << counters.retired
+              << ",\"recreated\":" << counters.recreated
+              << ",\"source_readbacks\":" << reads
+              << ",\"rgba8_and_packed10\":true,\"format\":" << int(selected)
+              << ",\"visible_witness_required\":true,\"validation_layers\":"
+                 "false,\"actual_game\":false}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << "Presentation fixture failed/unsupported: " << e.what()
+              << '\n';
+    return 2;
+  }
+}
diff --git a/native-runtime/nvn/presentation_policy_test.cpp b/native-runtime/nvn/presentation_policy_test.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/nvn/presentation_policy_test.cpp
@@ -0,0 +1,71 @@
+#include "presentation.h"
+#include <cmath>
+#include <iostream>
+#include <stdexcept>
+using namespace native_nvn;
+void Check(bool b) {
+  if (!b)
+    throw std::runtime_error("Presentation policy assertion");
+}
+int main() {
+  try {
+    unsigned scenarios = 0;
+    for (auto status : {AcquireStatus::Pending, AcquireStatus::OutOfDate,
+                        AcquireStatus::Failed}) {
+      PresentationFlight f;
+      f.Acquire(status);
+      Check(f.RequiredRetirement() == Retirement::None);
+      ++scenarios;
+    }
+    for (auto acquire : {AcquireStatus::Ready, AcquireStatus::Suboptimal}) {
+      PresentationFlight f;
+      f.Acquire(acquire);
+      Check(f.RequiredRetirement() == Retirement::ConsumeAcquire);
+      f.SynchronizationConsumed();
+      Check(f.RequiredRetirement() == Retirement::ReleaseImage);
+      f.Retired();
+      Check(f.RequiredRetirement() == Retirement::None);
+      ++scenarios;
+      for (auto result : {PresentStatus::Queued, PresentStatus::Suboptimal,
+                          PresentStatus::OutOfDate, PresentStatus::NotEnqueued,
+                          PresentStatus::DeviceLost}) {
+        PresentationFlight p;
+        p.Acquire(acquire);
+        p.RenderComplete();
+        Check(p.RequiredRetirement() == Retirement::ConsumeRender);
+        p.Present(result);
+        if (result == PresentStatus::Queued ||
+            result == PresentStatus::Suboptimal ||
+            result == PresentStatus::OutOfDate) {
+          Check(p.RequiredRetirement() == Retirement::WaitPresent);
+          Check(p.present_pending);
+        } else {
+          Check(p.RequiredRetirement() == Retirement::ConsumeRender);
+          p.SynchronizationConsumed();
+          Check(p.RequiredRetirement() == Retirement::ReleaseImage);
+        }
+        p.Retired();
+        Check(p.RequiredRetirement() == Retirement::None);
+        ++scenarios;
+      }
+    }
+    PresentationFlight bad;
+    bool rejected = false;
+    try {
+      bad.RenderComplete();
+    } catch (const std::runtime_error &) {
+      rejected = true;
+    }
+    Check(rejected);
+    Check(std::abs(EncodeSrgb(0)) < 1e-12 &&
+          std::abs(EncodeSrgb(1) - 1) < 1e-12 &&
+          std::abs(EncodeSrgb(.0031308) - .040449936) < 1e-9 &&
+          std::abs(EncodeSrgb(.5) - .735356983) < 1e-8);
+    std::cout << "{\"passed\":true,\"retirement_scenarios\":" << scenarios
+              << ",\"gpu_calls\":0,\"window_calls\":0}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
diff --git a/native-runtime/nvn/resource_test.cpp b/native-runtime/nvn/resource_test.cpp
new file mode 100644
--- /dev/null
+++ b/native-runtime/nvn/resource_test.cpp
@@ -0,0 +1,275 @@
+#include "resources.h"
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#define VK_NO_PROTOTYPES
+#include <algorithm>
+#include <array>
+#include <iostream>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+#include <vulkan/vulkan.h>
+#include <windows.h>
+using namespace native_nvn;
+namespace {
+struct Memory {
+  std::array<std::byte, 16384> bytes{};
+  bool read_fault = false, write_fault = false;
+  unsigned reads = 0, writes = 0;
+  static bool Read(void *user, uint64_t address, std::span<std::byte> out) {
+    auto &m = *static_cast<Memory *>(user);
+    ++m.reads;
+    if (m.read_fault || address < 0x10000 ||
+        address - 0x10000 > m.bytes.size() ||
+        out.size() > m.bytes.size() - (address - 0x10000))
+      return false;
+    std::copy_n(m.bytes.begin() + address - 0x10000, out.size(), out.begin());
+    return true;
+  }
+  static bool Write(void *user, uint64_t address,
+                    std::span<const std::byte> in) {
+    auto &m = *static_cast<Memory *>(user);
+    ++m.writes;
+    if (address < 0x10000 || address - 0x10000 > m.bytes.size() ||
+        in.size() > m.bytes.size() - (address - 0x10000))
+      return false;
+    const auto count = m.write_fault ? in.size() / 2 : in.size();
+    std::copy_n(in.begin(), count, m.bytes.begin() + address - 0x10000);
+    return !m.write_fault;
+  }
+};
+void Check(bool yes, const char *why) {
+  if (!yes)
+    throw std::runtime_error(why);
+}
+void VkCheck(VkResult value) {
+  Check(value == VK_SUCCESS, "Vulkan copy operation failed");
+}
+// Actual queue execution, not merely mapped host memory roundtrip.
+void GpuCopy(native_graphics::VulkanDevice &backend,
+             native_graphics::BufferBinding binding) {
+  const auto handles = backend.GetNativeHandles();
+  const auto library = LoadLibraryW(L"vulkan-1.dll");
+  Check(library != nullptr, "Vulkan loader");
+  const auto instance_proc = reinterpret_cast<PFN_vkGetInstanceProcAddr>(
+      GetProcAddress(library, "vkGetInstanceProcAddr"));
+  const auto device_proc = reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+      instance_proc(reinterpret_cast<VkInstance>(handles.instance),
+                    "vkGetDeviceProcAddr"));
+  const auto device = reinterpret_cast<VkDevice>(handles.device);
+#define LOAD(name)                                                             \
+  const auto name = reinterpret_cast<PFN_##name>(device_proc(device, #name));  \
+  Check(name != nullptr, #name)
+  LOAD(vkCreateCommandPool);
+  LOAD(vkAllocateCommandBuffers);
+  LOAD(vkBeginCommandBuffer);
+  LOAD(vkCmdCopyBuffer);
+  LOAD(vkCmdPipelineBarrier);
+  LOAD(vkEndCommandBuffer);
+  LOAD(vkQueueSubmit);
+  LOAD(vkCreateFence);
+  LOAD(vkWaitForFences);
+  LOAD(vkDestroyFence);
+  LOAD(vkDestroyCommandPool);
+#undef LOAD
+  VkCommandPoolCreateInfo pool_info{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+  pool_info.queueFamilyIndex = handles.queue_family;
+  VkCommandPool pool{};
+  VkCheck(vkCreateCommandPool(device, &pool_info, nullptr, &pool));
+  VkCommandBufferAllocateInfo allocation{
+      VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+  allocation.commandPool = pool;
+  allocation.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+  allocation.commandBufferCount = 1;
+  VkCommandBuffer command{};
+  VkCheck(vkAllocateCommandBuffers(device, &allocation, &command));
+  VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+  VkCheck(vkBeginCommandBuffer(command, &begin));
+  VkBufferCopy copy{binding.offset, binding.offset + 128, 64};
+  vkCmdCopyBuffer(command, reinterpret_cast<VkBuffer>(binding.native_buffer),
+                  reinterpret_cast<VkBuffer>(binding.native_buffer), 1, &copy);
+  VkMemoryBarrier host_read{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+  host_read.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  host_read.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+  vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                       VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &host_read, 0, nullptr,
+                       0, nullptr);
+  VkCheck(vkEndCommandBuffer(command));
+  VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+  submit.commandBufferCount = 1;
+  submit.pCommandBuffers = &command;
+  const auto queue = reinterpret_cast<VkQueue>(handles.queue);
+  VkFenceCreateInfo fence_info{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+  VkFence fence{};
+  VkCheck(vkCreateFence(device, &fence_info, nullptr, &fence));
+  VkCheck(vkQueueSubmit(queue, 1, &submit, fence));
+  VkCheck(vkWaitForFences(device, 1, &fence, VK_TRUE, UINT64_C(5000000000)));
+  vkDestroyFence(device, fence, nullptr);
+  vkDestroyCommandPool(device, pool, nullptr);
+  FreeLibrary(library);
+}
+} // namespace
+int main() {
+  try {
+    Memory memory;
+    Resources resources({&memory, Memory::Read, Memory::Write});
+    unsigned rejected = 0;
+    auto reject = [&](auto action) {
+      try {
+        action();
+      } catch (const std::runtime_error &) {
+        ++rejected;
+        return;
+      }
+      throw std::runtime_error("Expected resource rejection");
+    };
+    resources.CreateDevice(0x1000);
+    PoolDescription pool{0x1000, 0x10000, 4096, CpuAccess::Cached};
+    for (size_t i = 0; i < 64; i++)
+      memory.bytes[i] = std::byte(i ^ 0x5a);
+    resources.CreatePool(0x2000, pool);
+    resources.CreateBuffer(0x3000, {0x1000, 0x2000, 0, 256});
+    resources.CreateBuffer(0x3010, {0x1000, 0x2000, 128, 64});
+    Check(resources.MapPool(0x2000) == 0x10000 &&
+              resources.MapBuffer(0x3010) == 0x10080,
+          "Guest integer mapping");
+    const auto gpu = resources.BufferGpuAddress(0x3000);
+    Check(gpu && resources.BufferGpuAddress(0x3010) == gpu + 128,
+          "Real GPU address view offset");
+    Check(resources.ResolveGpuAddress(0x1000, gpu + 128, 64).offset == 128,
+          "GPU owner resolution");
+    GpuCopy(resources.Backend(0x1000), resources.Binding(0x3000));
+    resources.InvalidateBuffer(0x3010, 0, 64);
+    Check(std::equal(memory.bytes.begin(), memory.bytes.begin() + 64,
+                     memory.bytes.begin() + 128),
+          "Actual GPU copy readback");
+    for (size_t i = 0; i < 64; i++)
+      memory.bytes[i] = std::byte(255 - i);
+    resources.FlushBuffer(0x3000, 0, 64);
+    std::array<std::byte, 64> downloaded{};
+    resources.Backend(0x1000).Download(resources.View(0x3000), 0, downloaded);
+    Check(
+        std::equal(downloaded.begin(), downloaded.end(), memory.bytes.begin()),
+        "Guest flush Vulkan backing");
+    memory.read_fault = true;
+    const auto before = downloaded;
+    reject([&] { resources.FlushBuffer(0x3000, 0, 64); });
+    memory.read_fault = false;
+    resources.Backend(0x1000).Download(resources.View(0x3000), 0, downloaded);
+    Check(downloaded == before, "Read fault leaves Vulkan bytes unchanged");
+    std::fill_n(memory.bytes.begin(), 64, std::byte{});
+    memory.write_fault = true;
+    reject([&] { resources.InvalidateBuffer(0x3000, 0, 64); });
+    memory.write_fault = false;
+    Check(std::equal(memory.bytes.begin(), memory.bytes.begin() + 32,
+                     before.begin()) &&
+              std::all_of(memory.bytes.begin() + 32, memory.bytes.begin() + 64,
+                          [](std::byte b) { return b == std::byte{}; }),
+          "Partial guest write fault remains explicit");
+    reject([&] { resources.CreatePool(0x2020, pool); });
+    reject([&] { resources.CreateDevice(0x1000); });
+    reject([&] { resources.DestroyDevice(0x1000); });
+    reject([&] { resources.DestroyPool(0x2000); });
+    reject([&] { resources.CreateBuffer(0x3020, {0x1000, 0x2000, 4095, 2}); });
+    reject([&] { resources.FlushBuffer(0x3000, UINT64_MAX, 1); });
+    reject([&] { resources.CreateBuffer(0x3001, {0x1000, 0x2000, 0, 64}); });
+    reject([&] { resources.ResolveGpuAddress(0x1000, gpu + 4096, 1); });
+    auto bad = pool;
+    bad.storage++;
+    reject([&] { resources.CreatePool(0x2020, bad); });
+    bad = pool;
+    bad.size = 4095;
+    reject([&] { resources.CreatePool(0x2020, bad); });
+    bad = pool;
+    bad.virtual_pool = true;
+    reject([&] { resources.CreatePool(0x2020, bad); });
+    bad = pool;
+    bad.physical_pool = true;
+    reject([&] { resources.CreatePool(0x2020, bad); });
+    bad = pool;
+    bad.gpu_cached = false;
+    reject([&] { resources.CreatePool(0x2020, bad); });
+    bad = pool;
+    bad.storage = 0x11000;
+    memory.read_fault = true;
+    reject([&] { resources.CreatePool(0x2020, bad); });
+    memory.read_fault = false;
+    bad.cpu = CpuAccess::None;
+    resources.CreatePool(0x2020, bad);
+    reject([&] { resources.MapPool(0x2020); });
+    reject([&] { resources.FlushPool(0x2020, 0, 64); });
+    resources.DestroyPool(0x2020);
+    bool wrong_thread = false;
+    std::thread other([&] {
+      try {
+        resources.MapPool(0x2000);
+      } catch (const std::runtime_error &) {
+        wrong_thread = true;
+      }
+    });
+    other.join();
+    Check(wrong_thread, "Owner thread");
+    Check(Resources::TransferConflictsPin(false, 128, 16, 0, 64),
+          "Noncoherent mutation must exclude disjoint bytes in same pool");
+    Check(!Resources::TransferConflictsPin(true, 64, 16, 0, 64) &&
+              Resources::TransferConflictsPin(true, 63, 16, 0, 64),
+          "Coherent exclusion must preserve exact adjacent/overlapping "
+          "boundaries");
+    Check(Resources::TransferConflictsPin(false, UINT64_MAX - 15, 15, 0, 64),
+          "Noncoherent exclusion must not rely on guessed atom rounding");
+    { // A pin owns backend lifetime and protects all overlapping buffer
+      // aliases.
+      auto lease = resources.PinBuffer(0x3000);
+      reject([&] { resources.DestroyBuffer(0x3000); });
+      reject([&] { resources.DestroyPool(0x2000); });
+      reject([&] { resources.DestroyDevice(0x1000); });
+      reject([&] { resources.FlushBuffer(0x3000, 0, 16); });
+      reject([&] { resources.FlushPool(0x2000, 0, 16); });
+      reject([&] { resources.InvalidateBuffer(0x3000, 0, 16); });
+      bool lease_thread = false;
+      std::thread wrong([&] {
+        try {
+          lease.Release();
+        } catch (const std::runtime_error &) {
+          lease_thread = true;
+        }
+      });
+      wrong.join();
+      Check(lease_thread, "Lease release must run on owner thread");
+      lease.Release();
+      reject([&] { lease.Backend(); });
+      resources.FlushBuffer(0x3000, 0, 16);
+    }
+    resources.DestroyBuffer(0x3010);
+    resources.DestroyBuffer(0x3000);
+    resources.DestroyPool(0x2000);
+    resources.CreatePool(0x2000, pool);
+    resources.DestroyPool(0x2000);
+    {
+      auto device_pin = resources.PinDevice(0x1000);
+      reject([&] { resources.DestroyDevice(0x1000); });
+      device_pin.Release();
+    }
+    resources.DestroyDevice(0x1000);
+    reject([&] { resources.PinDevice(0x1000); });
+    reject([&] { resources.PinBuffer(0x3000); });
+    reject([&] { resources.MapBuffer(0x3000); });
+    { // Parent teardown does not invalidate an independently retained backend.
+      auto parent = std::make_unique<Resources>(
+          GuestMemory{&memory, Memory::Read, Memory::Write});
+      parent->CreateDevice(0x1000);
+      auto lease = parent->PinDevice(0x1000);
+      parent.reset();
+      Check(!lease.Backend().DeviceName().empty(),
+            "Pinned backend lost at parent teardown");
+    }
+    std::cout << "{\"passed\":true,\"actual_gpu_copy_bytes\":64,\"rejected\":"
+              << rejected << ",\"guest_reads\":" << memory.reads
+              << ",\"guest_writes\":" << memory.writes
+              << ",\"key_reuse\":true,\"no_guest_host_pointers\":true}\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
