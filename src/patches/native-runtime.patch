index 0000000000000000000000000000000000000000..421b8c5a21b632a1109f826512c9282a3c71cc80
--- /dev/null
+++ b/native-runtime/graphics/native_graphics.cpp
@@ -0,0 +1,461 @@
+#include "native_graphics.h"
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#define VK_NO_PROTOTYPES
+#include <cstring>
+#include <functional>
+#include <memory>
+#include <sirit/sirit.h>
+#include <stdexcept>
+#include <vector>
+#include <vulkan/vulkan.h>
+#include <windows.h>
+namespace native_graphics {
+namespace {
+void Check(VkResult r, const char *operation) {
+  if (r != VK_SUCCESS)
+    throw std::runtime_error(std::string(operation) +
+                             " failed VkResult=" + std::to_string(r));
+}
+struct Owned {
+  HMODULE loader = LoadLibraryW(L"vulkan-1.dll");
+  std::vector<std::function<void()>> release;
+  ~Owned() {
+    for (auto i = release.rbegin(); i != release.rend(); ++i)
+      (*i)();
+    if (loader)
+      FreeLibrary(loader);
+  }
+  template <class T> T Get(const char *name) {
+    auto p = loader ? GetProcAddress(loader, name) : nullptr;
+    if (!p)
+      throw std::runtime_error(
+          std::string("Unsupported Vulkan loader export: ") + name);
+    return reinterpret_cast<T>(p);
+  }
+};
+#define V(name) owner.Get<PFN_##name>(#name)
+std::vector<uint32_t> Shader(bool vertex) {
+  Sirit::Module m(0x00010000);
+  m.AddCapability(spv::Capability::Shader);
+  m.SetMemoryModel(spv::AddressingModel::Logical, spv::MemoryModel::GLSL450);
+  auto f = m.TypeFloat(32), v = m.TypeVector(f, 4),
+       out = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Output, v),
+                                 spv::StorageClass::Output);
+  if (vertex)
+    m.Decorate(out, spv::Decoration::BuiltIn, spv::BuiltIn::Position);
+  else
+    m.Decorate(out, spv::Decoration::Location, 0u);
+  Sirit::Id input{};
+  if (vertex) {
+    input = m.AddGlobalVariable(m.TypePointer(spv::StorageClass::Input, v),
+                                spv::StorageClass::Input);
+    m.Decorate(input, spv::Decoration::Location, 0u);
+  }
+  auto zero = m.Constant(f, 0.0f), one = m.Constant(f, 1.0f),
+       red = m.ConstantComposite(v, one, zero, zero, one);
+  auto fn = m.OpFunction(m.TypeVoid(), spv::FunctionControlMask::MaskNone,
+                         m.TypeFunction(m.TypeVoid()));
+  m.AddLabel();
+  m.OpStore(out, vertex ? m.OpLoad(v, input) : red);
+  m.OpReturn();
+  m.OpFunctionEnd();
+  if (vertex)
+    m.AddEntryPoint(spv::ExecutionModel::Vertex, fn, "main", input, out);
+  else {
+    m.AddEntryPoint(spv::ExecutionModel::Fragment, fn, "main", out);
+    m.AddExecutionMode(fn, spv::ExecutionMode::OriginUpperLeft);
+  }
+  return m.Assemble();
+}
+} // namespace
+Result RunOffscreenTriangle() {
+  Result result;
+  try {
+    Owned owner;
+    if (!owner.loader)
+      throw std::runtime_error("System vulkan-1.dll unavailable");
+    VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+    app.pApplicationName = "native-offscreen-fixture";
+    app.apiVersion = VK_API_VERSION_1_0;
+    VkInstanceCreateInfo ici{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+    ici.pApplicationInfo = &app;
+    VkInstance instance{};
+    Check(V(vkCreateInstance)(&ici, nullptr, &instance), "vkCreateInstance");
+    owner.release.push_back(
+        [&, instance] { V(vkDestroyInstance)(instance, nullptr); });
+    uint32_t n = 0;
+    Check(V(vkEnumeratePhysicalDevices)(instance, &n, nullptr),
+          "physical device count");
+    if (!n)
+      throw std::runtime_error("No Vulkan physical device");
+    std::vector<VkPhysicalDevice> devices(n);
+    Check(V(vkEnumeratePhysicalDevices)(instance, &n, devices.data()),
+          "physical devices");
+    VkPhysicalDevice physical{};
+    uint32_t family = 0;
+    for (auto p : devices) {
+      uint32_t count = 0;
+      V(vkGetPhysicalDeviceQueueFamilyProperties)(p, &count, nullptr);
+      std::vector<VkQueueFamilyProperties> q(count);
+      V(vkGetPhysicalDeviceQueueFamilyProperties)(p, &count, q.data());
+      for (uint32_t i = 0; i < count; ++i)
+        if (q[i].queueCount && (q[i].queueFlags & VK_QUEUE_GRAPHICS_BIT)) {
+          physical = p;
+          family = i;
+          break;
+        }
+      if (physical)
+        break;
+    }
+    if (!physical)
+      throw std::runtime_error("Unsupported: no graphics queue");
+    VkPhysicalDeviceProperties properties{};
+    V(vkGetPhysicalDeviceProperties)(physical, &properties);
+    result.device = properties.deviceName;
+    result.vendor_id = properties.vendorID;
+    result.device_id = properties.deviceID;
+    result.driver_version = properties.driverVersion;
+    result.api_version = properties.apiVersion;
+    VkFormatProperties format{};
+    V(vkGetPhysicalDeviceFormatProperties)(physical, VK_FORMAT_R8G8B8A8_UNORM,
+                                           &format);
+    if (!(format.optimalTilingFeatures &
+          VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT))
+      throw std::runtime_error("Unsupported RGBA8 color attachment");
+    float priority = 1;
+    VkDeviceQueueCreateInfo qci{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+    qci.queueFamilyIndex = family;
+    qci.queueCount = 1;
+    qci.pQueuePriorities = &priority;
+    VkDeviceCreateInfo dci{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+    dci.queueCreateInfoCount = 1;
+    dci.pQueueCreateInfos = &qci;
+    VkDevice device{};
+    Check(V(vkCreateDevice)(physical, &dci, nullptr, &device),
+          "vkCreateDevice");
+    owner.release.push_back(
+        [&, device] { V(vkDestroyDevice)(device, nullptr); });
+    VkQueue queue{};
+    V(vkGetDeviceQueue)(device, family, 0, &queue);
+    // Cleanup waits before freeing any resources if a later check throws after
+    // submission.
+    auto submitted = std::make_shared<bool>(false);
+    VkPhysicalDeviceMemoryProperties memory{};
+    V(vkGetPhysicalDeviceMemoryProperties)(physical, &memory);
+    auto allocate = [&](VkMemoryRequirements requirements,
+                        VkMemoryPropertyFlags flags) {
+      uint32_t index = memory.memoryTypeCount;
+      for (uint32_t i = 0; i < memory.memoryTypeCount; ++i)
+        if ((requirements.memoryTypeBits & (1u << i)) &&
+            (memory.memoryTypes[i].propertyFlags & flags) == flags) {
+          index = i;
+          break;
+        }
+      if (index == memory.memoryTypeCount)
+        throw std::runtime_error("Unsupported Vulkan memory type");
+      VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+      ai.allocationSize = requirements.size;
+      ai.memoryTypeIndex = index;
+      VkDeviceMemory allocation{};
+      Check(V(vkAllocateMemory)(device, &ai, nullptr, &allocation),
+            "vkAllocateMemory");
+      return allocation;
+    };
+    auto buffer = [&](VkDeviceSize size, VkBufferUsageFlags usage,
+                      VkBuffer &handle, VkDeviceMemory &allocation) {
+      VkBufferCreateInfo bi{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+      bi.size = size;
+      bi.usage = usage;
+      bi.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+      Check(V(vkCreateBuffer)(device, &bi, nullptr, &handle), "vkCreateBuffer");
+      VkMemoryRequirements requirements{};
+      V(vkGetBufferMemoryRequirements)(device, handle, &requirements);
+      try {
+        allocation =
+            allocate(requirements, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                       VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+      } catch (...) {
+        V(vkDestroyBuffer)(device, handle, nullptr);
+        throw;
+      }
+      auto b = handle;
+      auto a = allocation;
+      owner.release.push_back([&, device, b, a] {
+        V(vkDestroyBuffer)(device, b, nullptr);
+        V(vkFreeMemory)(device, a, nullptr);
+      });
+      Check(V(vkBindBufferMemory)(device, handle, allocation, 0),
+            "vkBindBufferMemory");
+    };
+    constexpr uint32_t width = 64, height = 64;
+    VkBuffer vertex{}, readback{};
+    VkDeviceMemory vertex_memory{}, readback_memory{};
+    buffer(48, VK_BUFFER_USAGE_VERTEX_BUFFER_BIT, vertex, vertex_memory);
+    buffer(width * height * 4, VK_BUFFER_USAGE_TRANSFER_DST_BIT, readback,
+           readback_memory);
+    const float vertices[12] = {-0.75f, -0.75f, 0, 1,     0.75f, -0.75f,
+                                0,      1,      0, 0.75f, 0,     1};
+    void *mapped{};
+    Check(V(vkMapMemory)(device, vertex_memory, 0, 48, 0, &mapped),
+          "map vertex");
+    std::memcpy(mapped, vertices, sizeof(vertices));
+    V(vkUnmapMemory)(device, vertex_memory);
+    VkImageCreateInfo image_ci{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    image_ci.imageType = VK_IMAGE_TYPE_2D;
+    image_ci.format = VK_FORMAT_R8G8B8A8_UNORM;
+    image_ci.extent = {width, height, 1};
+    image_ci.mipLevels = 1;
+    image_ci.arrayLayers = 1;
+    image_ci.samples = VK_SAMPLE_COUNT_1_BIT;
+    image_ci.tiling = VK_IMAGE_TILING_OPTIMAL;
+    image_ci.usage =
+        VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    image_ci.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    VkImage image{};
+    Check(V(vkCreateImage)(device, &image_ci, nullptr, &image),
+          "vkCreateImage");
+    VkMemoryRequirements ir{};
+    V(vkGetImageMemoryRequirements)(device, image, &ir);
+    VkDeviceMemory image_memory{};
+    try {
+      image_memory = allocate(ir, 0);
+    } catch (...) {
+      V(vkDestroyImage)(device, image, nullptr);
+      throw;
+    }
+    owner.release.push_back([&, device, image, image_memory] {
+      V(vkDestroyImage)(device, image, nullptr);
+      V(vkFreeMemory)(device, image_memory, nullptr);
+    });
+    Check(V(vkBindImageMemory)(device, image, image_memory, 0),
+          "vkBindImageMemory");
+    VkImageViewCreateInfo ivci{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    ivci.image = image;
+    ivci.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    ivci.format = VK_FORMAT_R8G8B8A8_UNORM;
+    ivci.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    VkImageView view{};
+    Check(V(vkCreateImageView)(device, &ivci, nullptr, &view),
+          "vkCreateImageView");
+    owner.release.push_back(
+        [&, device, view] { V(vkDestroyImageView)(device, view, nullptr); });
+    VkAttachmentDescription attachment{};
+    attachment.format = VK_FORMAT_R8G8B8A8_UNORM;
+    attachment.samples = VK_SAMPLE_COUNT_1_BIT;
+    attachment.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+    attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    attachment.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+    attachment.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+    attachment.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    attachment.finalLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    VkAttachmentReference color{0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+    VkSubpassDescription sub{};
+    sub.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+    sub.colorAttachmentCount = 1;
+    sub.pColorAttachments = &color;
+    VkSubpassDependency dep{};
+    dep.srcSubpass = 0;
+    dep.dstSubpass = VK_SUBPASS_EXTERNAL;
+    dep.srcStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+    dep.dstStageMask = VK_PIPELINE_STAGE_TRANSFER_BIT;
+    dep.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    dep.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    VkRenderPassCreateInfo rpci{VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO};
+    rpci.attachmentCount = 1;
+    rpci.pAttachments = &attachment;
+    rpci.subpassCount = 1;
+    rpci.pSubpasses = &sub;
+    rpci.dependencyCount = 1;
+    rpci.pDependencies = &dep;
+    VkRenderPass pass{};
+    Check(V(vkCreateRenderPass)(device, &rpci, nullptr, &pass),
+          "vkCreateRenderPass");
+    owner.release.push_back(
+        [&, device, pass] { V(vkDestroyRenderPass)(device, pass, nullptr); });
+    VkFramebufferCreateInfo fbci{VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+    fbci.renderPass = pass;
+    fbci.attachmentCount = 1;
+    fbci.pAttachments = &view;
+    fbci.width = width;
+    fbci.height = height;
+    fbci.layers = 1;
+    VkFramebuffer framebuffer{};
+    Check(V(vkCreateFramebuffer)(device, &fbci, nullptr, &framebuffer),
+          "vkCreateFramebuffer");
+    owner.release.push_back([&, device, framebuffer] {
+      V(vkDestroyFramebuffer)(device, framebuffer, nullptr);
+    });
+    VkShaderModule shaders[2]{};
+    for (int i = 0; i < 2; ++i) {
+      auto code = Shader(i == 0);
+      VkShaderModuleCreateInfo ci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+      ci.codeSize = code.size() * 4;
+      ci.pCode = code.data();
+      Check(V(vkCreateShaderModule)(device, &ci, nullptr, &shaders[i]),
+            "vkCreateShaderModule");
+      auto shader = shaders[i];
+      owner.release.push_back([&, device, shader] {
+        V(vkDestroyShaderModule)(device, shader, nullptr);
+      });
+    }
+    VkPipelineLayoutCreateInfo plci{
+        VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+    VkPipelineLayout layout{};
+    Check(V(vkCreatePipelineLayout)(device, &plci, nullptr, &layout),
+          "vkCreatePipelineLayout");
+    owner.release.push_back([&, device, layout] {
+      V(vkDestroyPipelineLayout)(device, layout, nullptr);
+    });
+    VkPipelineShaderStageCreateInfo stages[2]{};
+    for (int i = 0; i < 2; ++i) {
+      stages[i].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+      stages[i].stage =
+          i == 0 ? VK_SHADER_STAGE_VERTEX_BIT : VK_SHADER_STAGE_FRAGMENT_BIT;
+      stages[i].module = shaders[i];
+      stages[i].pName = "main";
+    }
+    VkVertexInputBindingDescription binding{0, 16, VK_VERTEX_INPUT_RATE_VERTEX};
+    VkVertexInputAttributeDescription attribute{
+        0, 0, VK_FORMAT_R32G32B32A32_SFLOAT, 0};
+    VkPipelineVertexInputStateCreateInfo vi{
+        VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+    vi.vertexBindingDescriptionCount = 1;
+    vi.pVertexBindingDescriptions = &binding;
+    vi.vertexAttributeDescriptionCount = 1;
+    vi.pVertexAttributeDescriptions = &attribute;
+    VkPipelineInputAssemblyStateCreateInfo ia{
+        VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+    ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    VkViewport viewport{0, 0, float(width), float(height), 0, 1};
+    VkRect2D scissor{{0, 0}, {width, height}};
+    VkPipelineViewportStateCreateInfo vp{
+        VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+    vp.viewportCount = 1;
+    vp.pViewports = &viewport;
+    vp.scissorCount = 1;
+    vp.pScissors = &scissor;
+    VkPipelineRasterizationStateCreateInfo raster{
+        VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+    raster.polygonMode = VK_POLYGON_MODE_FILL;
+    raster.cullMode = VK_CULL_MODE_NONE;
+    raster.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+    raster.lineWidth = 1;
+    VkPipelineMultisampleStateCreateInfo ms{
+        VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+    ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+    VkPipelineColorBlendAttachmentState ba{};
+    ba.colorWriteMask = 15;
+    VkPipelineColorBlendStateCreateInfo blend{
+        VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+    blend.attachmentCount = 1;
+    blend.pAttachments = &ba;
+    VkGraphicsPipelineCreateInfo pci{
+        VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+    pci.stageCount = 2;
+    pci.pStages = stages;
+    pci.pVertexInputState = &vi;
+    pci.pInputAssemblyState = &ia;
+    pci.pViewportState = &vp;
+    pci.pRasterizationState = &raster;
+    pci.pMultisampleState = &ms;
+    pci.pColorBlendState = &blend;
+    pci.layout = layout;
+    pci.renderPass = pass;
+    VkPipeline pipeline{};
+    Check(V(vkCreateGraphicsPipelines)(device, VK_NULL_HANDLE, 1, &pci, nullptr,
+                                       &pipeline),
+          "vkCreateGraphicsPipelines");
+    owner.release.push_back([&, device, pipeline] {
+      V(vkDestroyPipeline)(device, pipeline, nullptr);
+    });
+    VkCommandPoolCreateInfo cpci{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+    cpci.queueFamilyIndex = family;
+    VkCommandPool pool{};
+    Check(V(vkCreateCommandPool)(device, &cpci, nullptr, &pool),
+          "vkCreateCommandPool");
+    owner.release.push_back(
+        [&, device, pool] { V(vkDestroyCommandPool)(device, pool, nullptr); });
+    VkCommandBufferAllocateInfo cbai{
+        VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+    cbai.commandPool = pool;
+    cbai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    cbai.commandBufferCount = 1;
+    VkCommandBuffer cb{};
+    Check(V(vkAllocateCommandBuffers)(device, &cbai, &cb),
+          "vkAllocateCommandBuffers");
+    VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+    begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    Check(V(vkBeginCommandBuffer)(cb, &begin), "vkBeginCommandBuffer");
+    VkClearValue clear{};
+    clear.color.float32[3] = 1;
+    VkRenderPassBeginInfo rb{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+    rb.renderPass = pass;
+    rb.framebuffer = framebuffer;
+    rb.renderArea = scissor;
+    rb.clearValueCount = 1;
+    rb.pClearValues = &clear;
+    V(vkCmdBeginRenderPass)(cb, &rb, VK_SUBPASS_CONTENTS_INLINE);
+    V(vkCmdBindPipeline)(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+    VkDeviceSize offset = 0;
+    V(vkCmdBindVertexBuffers)(cb, 0, 1, &vertex, &offset);
+    V(vkCmdDraw)(cb, 3, 1, 0, 0);
+    V(vkCmdEndRenderPass)(cb);
+    VkBufferImageCopy copy{};
+    copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    copy.imageExtent = {width, height, 1};
+    V(vkCmdCopyImageToBuffer)(cb, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                              readback, 1, &copy);
+    VkBufferMemoryBarrier barrier{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+    barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+    barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.buffer = readback;
+    barrier.size = VK_WHOLE_SIZE;
+    V(vkCmdPipelineBarrier)(cb, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                            VK_PIPELINE_STAGE_HOST_BIT, 0, 0, nullptr, 1,
+                            &barrier, 0, nullptr);
+    Check(V(vkEndCommandBuffer)(cb), "vkEndCommandBuffer");
+    VkFenceCreateInfo fci{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+    VkFence fence{};
+    Check(V(vkCreateFence)(device, &fci, nullptr, &fence), "vkCreateFence");
+    owner.release.push_back(
+        [&, device, fence] { V(vkDestroyFence)(device, fence, nullptr); });
+    // This cleanup is registered last, so outstanding GPU work finishes before
+    // any resource destruction.
+    owner.release.push_back([&, device, submitted] {
+      if (*submitted)
+        V(vkDeviceWaitIdle)(device);
+    });
+    VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    submit.commandBufferCount = 1;
+    submit.pCommandBuffers = &cb;
+    Check(V(vkQueueSubmit)(queue, 1, &submit, fence), "vkQueueSubmit");
+    *submitted = true;
+    Check(V(vkWaitForFences)(device, 1, &fence, VK_TRUE, 5'000'000'000ull),
+          "vkWaitForFences");
+    result.draw_count = 1;
+    Check(V(vkMapMemory)(device, readback_memory, 0, width * height * 4, 0,
+                         &mapped),
+          "map readback");
+    auto pixels = static_cast<const uint32_t *>(mapped);
+    result.center_rgba = pixels[(height / 2) * width + width / 2];
+    result.corner_rgba = pixels[0];
+    for (uint32_t i = 0; i < width * height; ++i) {
+      result.red_pixels += pixels[i] == 0xff0000ffu;
+      result.black_pixels += pixels[i] == 0xff000000u;
+    }
+    V(vkUnmapMemory)(device, readback_memory);
+    if (result.center_rgba != 0xff0000ffu ||
+        result.corner_rgba != 0xff000000u || result.red_pixels < 1000 ||
+        result.red_pixels > 1300 ||
+        result.black_pixels + result.red_pixels != width * height)
+      throw std::runtime_error("Triangle readback pixel verification failed");
+    result.passed = true;
+  } catch (const std::exception &e) {
+    result.error = e.what();
+  }
+  return result;
+}
+} // namespace native_graphics
diff --git a/native-runtime/graphics/native_graphics.h b/native-runtime/graphics/native_graphics.h
new file mode 100644
index 0000000000000000000000000000000000000000..190e5e8668eda0d35f4f99a76a69ed48d7ca73f7
--- /dev/null
+++ b/native-runtime/graphics/native_graphics.h
@@ -0,0 +1,16 @@
+#pragma once
+#include <cstdint>
+#include <string>
+namespace native_graphics {
+// Independent native Vulkan fixture. Unsupported hardware/API returns a strict
+// error. This proves resources, one draw and synchronized readback; it is not
+// an NVN adapter.
+struct Result {
+  bool passed = false;
+  std::string device, error;
+  uint32_t vendor_id = 0, device_id = 0, driver_version = 0, api_version = 0;
+  uint32_t draw_count = 0, red_pixels = 0, black_pixels = 0;
+  uint32_t center_rgba = 0, corner_rgba = 0;
+};
+Result RunOffscreenTriangle();
+} // namespace native_graphics
diff --git a/native-runtime/graphics/probe.cpp b/native-runtime/graphics/probe.cpp
new file mode 100644
