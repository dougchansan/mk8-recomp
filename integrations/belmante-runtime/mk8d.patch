+    log("measure event: %s id %llu submit %llu present %llu epoch %llu start %llu end %llu value %llu tid %lld",kind,
+        (unsigned long long)id,(unsigned long long)submit_id,(unsigned long long)present_id,
+        (unsigned long long)present_epoch.load(std::memory_order_relaxed),(unsigned long long)start,
+        (unsigned long long)end,(unsigned long long)value,(long long)plat::current_thread_id());
+}
