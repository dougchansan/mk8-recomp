+// SPDX-License-Identifier: GPL-3.0-or-later
+// NVN storage facts, independent of any SDK image address or Vulkan substitutions.
+#pragma once
+#include <array>
+#include <cstdint>
+#include <stdexcept>
+namespace nx::nvn {
+struct NativeTextureBlock{uint32_t block_w=1,block_h=1,bytes=0;};
+inline NativeTextureBlock native_texture_block(uint32_t format){
+ NativeTextureBlock f;
+ if(format>=0x41&&format<=0x50){f.block_w=f.block_h=4;f.bytes=(format==0x41||format==0x42||format==0x45||format==0x46||format==0x49||format==0x4a)?8:16;return f;}
+ if(format>=0x79&&format<=0x94){constexpr std::array<std::array<uint32_t,2>,14> dims={{{4,4},{5,4},{5,5},{6,5},{6,6},{8,5},{8,6},{8,8},{10,5},{10,6},{10,8},{10,10},{12,10},{12,12}}};const auto& d=dims[(format-0x79)%14];return {d[0],d[1],16};}
+ if(format>=1&&format<=4)f.bytes=1;
+ else if(format<=9&&format>=5)f.bytes=2;
+ else if(format<=0xc&&format>=0xa)f.bytes=4;
+ else if(format<=0x10&&format>=0xd)f.bytes=2;
+ else if(format<=0x15&&format>=0x11)f.bytes=4;
+ else if(format<=0x18&&format>=0x16)f.bytes=8;
+ else if(format<=0x1c&&format>=0x19)f.bytes=3;
+ else if(format<=0x21&&format>=0x1d)f.bytes=6;
+ else if(format<=0x24&&format>=0x22)f.bytes=12;
+ else if(format<=0x28&&format>=0x25)f.bytes=4;
+ else if(format<=0x2d&&format>=0x29)f.bytes=8;
+ else if(format<=0x30&&format>=0x2e)f.bytes=16;
+ else if(format==0x31)f.bytes=1;
+ else if(format==0x32||(format>=0x39&&format<=0x3c)||(format>=0x95&&format<=0x98))f.bytes=2;
+ else if(format==0x36)f.bytes=8;
+ else if((format>=0x33&&format<=0x38)||(format>=0x3d&&format<=0x40)||(format>=0x99&&format<=0x9c))f.bytes=4;
+ else throw std::invalid_argument("unsupported NVN texture storage format");
+ return f;
+}
+}
