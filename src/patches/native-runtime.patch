@@ -0,0 +1,68 @@
+#include "core/recompiler/arm64_to_c.h"
+#include <iostream>
+using namespace suyu::recomp;
+static const std::string build(64, 'a'), digest(64, 'b');
+using Files = std::map<std::string, std::string>;
+static Files Read(const std::filesystem::path &root) {
+  Files files;
+  for (auto &p : std::filesystem::recursive_directory_iterator(root))
+    if (p.is_regular_file()) {
+      std::ifstream input(p.path(), std::ios::binary);
+      files[p.path().lexically_relative(root).generic_string()] = {
+          std::istreambuf_iterator<char>(input), {}};
+    }
+  return files;
+}
+int main(int argc, char **argv) {
+  if (argc != 2)
+    return 2;
+  std::filesystem::path root = argv[1];
+  // Owned synthetic three-block bool API: CBZ x0,failure; true; RET; false;
+  // RET.
+  const uint32_t words[] = {0xb4000060, 0x52800020, 0xd65f03c0,
+                            0x52800000, 0xd65f03c0, 0x17fffffb};
+  auto emit = [&](const std::string &name, const std::string &hash = digest) {
+    EmitProject("api", reinterpret_cast<const u8 *>(words), sizeof(words),
+                0x1000, (root / name).string(), true, nullptr, 0, nullptr, 0, 0,
+                {}, nullptr, 32u << 20, build, hash);
+    return Read(root / name);
+  };
+  const auto off = emit("off");
+  NativeApiDescriptor descriptor{"api",
+                                 build,
+                                 digest,
+                                 0x1000,
+                                 17,
+                                 1,
+                                 {{0x1000, {words[0]}},
+                                  {0x1004, {words[1], words[2]}},
+                                  {0x100c, {words[3], words[4]}}}};
+  g_emit_native_apis = {descriptor};
+  emit("on");
+  if (emit("unknown", std::string(64, 'c')) != off)
+    return 3;
+  for (unsigned mode = 0; mode < 4; mode++) {
+    g_emit_native_apis = {descriptor};
+    if (mode == 0)
+      g_emit_native_apis[0].ranges[1].words[1] ^= 1;
+    if (mode == 1)
+      g_emit_native_apis[0].ranges.pop_back();
+    if (mode == 2)
+      g_emit_native_apis[0].ranges[1].words.pop_back();
+    if (mode == 3)
+      g_emit_native_apis.push_back(descriptor);
+    try {
+      emit("invalid" + std::to_string(mode));
+      return 4;
+    } catch (const std::runtime_error &) {
+    }
+  }
+  g_emit_native_apis.clear();
+  if (emit("off2") != off)
+    return 5;
+  const uint32_t indirect = 0xd61f0280;
+  EmitProject("apicaller", reinterpret_cast<const u8 *>(&indirect), 4, 0x3000,
+              (root / "caller").string(), true);
+  std::cout
+      << "v2 default-off identity/ranges/closure/duplicate checks passed\n";
+}
