+      std::vector<uint8_t> page(4096, 0x71);
+      h.map(0x3000, page.data(), page.size(), 3);
+      h.reservation = 0x3ff8;
+      h.reservation_size = 16;
+      h.reservation_epoch = h.epoch;
+      auto before = h.memory;
+      check(rejects([&] { h.bridge.excl_store_pair(&h, 0x3ff8, 8, 1, 2); }),
+            "pair store misalignment rejection");
+      check(h.memory == before && h.events.empty() && !h.reservation_size,
+            "pair store preflight beforeeffects and clears reservation");
+    } else if (test == "alignment") {
+      Host h;
+      std::vector<uint8_t> page(4096);
+      h.map(0x3000, page.data(), page.size(), 3);
+      h.reservation_size = 8;
+      check(rejects([&] { h.bridge.excl_load(&h, 0x3001, 8); }) &&
+                !h.reservation_size && h.events.empty(),
+            "scalar exclusives require natural alignment");
+    } else if (test == "glob" || test == "jump" || test == "negative" ||
+               test == "absolute" || test == "hidden") {
+      AddressSpace space;
+      auto module = image(test == "jump"       ? 0x402
+                          : test == "absolute" ? 0x101
+                                               : 0x401,
+                          0x10, 0, test == "absolute" ? 0xfff1 : 1,
+                          test == "negative"   ? UINT64_MAX - 7
+                          : test == "absolute" ? 0
+                                               : 0x20);
+      BootModule rtld{0x80000000, module};
+      std::vector<BootModule> modules{rtld};
+      if (test == "hidden") {
+        modules[0].image = image(0x401, 0x10, 0, 0);
+        auto other = image(0x401, 0x10, 2, 1);
+        other.name = "main";
+        modules.push_back({0x80004000, other});
+      }
+      for (const auto &m : modules)
+        map_nso(space, m.image, m.base);
+      if (test == "hidden")
+        check(rejects([&] { relocate_rtld(space, modules); }),
+              "hidden symbols are not globally exported");
+      else {
+        relocate_rtld(space, modules);
+        uint64_t expected =
+            test == "absolute"
+                ? 0x80
+                : UINT64_C(0x80000080) +
+                      (test == "negative" ? UINT64_MAX - 7 : 0x20);
+        check(space.read(rtld.base + 0x2200, 8) == expected,
+              "ELF relocation addend/absolute classification");
+      }
+    } else if (test == "weak-addend" || test == "weak-negative" ||
+               test == "local" || test == "hidden-self" ||
+               test == "protected" || test == "ifunc" || test == "common") {
+      AddressSpace space;
+      const bool weak = test.starts_with("weak-");
+      const uint64_t addend = test == "weak-negative" ? UINT64_MAX - 7 : 0x20;
+      auto entry = image(0x402,
+                         weak              ? 0x20
+                         : test == "local" ? 0
+                         : test == "ifunc" ? 0x1a
+                                           : 0x10,
+                         test == "hidden-self" ? 2
+                         : test == "protected" ? 3
+                                               : 0,
+                         weak               ? 0
+                         : test == "common" ? 0xfff2
+                                            : 1,
+                         addend);
+      BootModule rtld{0x80000000, entry};
+      map_nso(space, entry, rtld.base);
+      if (test == "ifunc" || test == "common")
+        check(rejects([&] { relocate_rtld(space, {rtld}); }),
+              "unsupported symbol class fails closed");
+      else {
+        relocate_rtld(space, {rtld});
+        check(space.read(rtld.base + 0x2200, 8) ==
+                  (weak ? 0 : rtld.base + 0x80) + addend,
+              "weak/local/hidden/protected symbol semantics");
+      }
+    } else if (test == "pair-denied") {
+      Host h;
+      std::vector<uint8_t> page(4096, 0x71);
+      h.map(0x3000, page.data(), page.size(), 1);
+      auto before = h.memory;
+      h.reservation = 0x3000;
+      h.reservation_size = 16;
+      h.reservation_epoch = h.epoch;
+      check(rejects([&] { h.bridge.excl_store_pair(&h, 0x3000, 8, 1, 2); }) &&
+                h.memory == before && h.events.empty() && !h.reservation_size,
+            "aligned denied pair store noeffects");
+      uint64_t lo = 3, hi = 4;
+      h.reservation_size = 16;
+      check(
+          rejects([&] { h.bridge.excl_load_pair(&h, 0x4000, 8, &lo, &hi); }) &&
+              lo == 3 && hi == 4 && !h.reservation_size,
+          "aligned unmapped pair load preserves canaries and clears "
+          "reservation");
+    } else if (test == "query") {
+      AddressSpace space;
+      auto code = image(0x401);
+      map_nso(space, code, 0x80000000);
+      space.map(0x90000000, std::vector<uint8_t>(4096, 0x71), 4096, 3);
+      Host h;
+      h.address_space = &space;
+      h.allowed_svcs.push_back(6);
+      auto query = [&](uint64_t address) {
+        h.context.pending_svc = 6;
+        h.context.x[0] = 0x90000000;
+        h.context.x[1] = UINT64_MAX;
+        h.context.x[2] = address;
+        h.service();
+        check(h.context.x[0] == 0 && h.context.x[1] == 0,
+              "QueryMemory PageInfo is scalar register output");
+      };
+      query(0);
+      check(space.read(0x90000000, 8) == 0 &&
+                space.read(0x90000008, 8) == 0x80000000 &&
+                space.read(0x90000010, 4) == 0,
+            "QueryMemory exact free hole");
+      query(0x80000010);
+      check(space.read(0x90000000, 8) == 0x80000000 &&
+                space.read(0x90000008, 8) == 4096 &&
+                space.read(0x90000010, 4) == 3 &&
+                space.read(0x90000018, 4) == 5,
+            "QueryMemory Code metadata");
+      query(0x80002010);
+      check(space.read(0x90000010, 4) == 4 && space.read(0x90000018, 4) == 3,
+            "QueryMemory CodeData metadata");
+      query(UINT64_MAX);
+      check(space.read(0x90000000, 8) == (UINT64_C(1) << 39) &&
+                space.read(0x90000008, 8) == (0 - (UINT64_C(1) << 39)) &&
+                space.read(0x90000010, 4) == 16,
+            "QueryMemory inaccessible range matches native kernel ABI");
+      auto before = space.read(0x90000ff0, 8);
+      h.context.pending_svc = 6;
+      h.context.x[0] = 0x90000ff0;
+      h.context.x[2] = 0;
+      auto epoch = h.epoch;
+      check(rejects([&] { h.service(); }) &&
+                space.read(0x90000ff0, 8) == before && h.epoch == epoch,
+            "QueryMemory output buffer preflight beforewrites");
+    } else if (test == "svc-registers") {
+      Host h;
+      std::vector<uint8_t> page(4096);
+      memcpy(page.data(), "OK", 2);
+      h.map(0x3000, page.data(), 4096, 3);
+      for (unsigned i = 0; i < 32; ++i)
+        h.context.x[i] = 100 + i;
+      h.context.n = 1;
+      h.context.c = 1;
+      h.context.fpcr = 0x400000;
+      h.context.fpsr = 0x100;
+      h.context.pending_svc = 39;
+      h.context.x[0] = 0x3000;
+      h.context.x[1] = 2;
+      auto expected = h.context;
+      expected.pending_svc = ~UINT64_C(0);
+      expected.x[0] = 0;
+      h.service();
+      check(!memcmp(&h.context, &expected, sizeof(expected)) &&
+                h.output == "OK",
+            "OutputDebugString modifies only result x0");
+      h.context.pending_svc = 11;
+      h.context.x[0] = 100;
+      expected = h.context;
+      expected.pending_svc = ~UINT64_C(0);
+      h.service();
+      check(!memcmp(&h.context, &expected, sizeof(expected)),
+            "SleepThread is void and preserves x0 input/all other registers");
+      h.context.pending_svc = 7;
+      h.context.x[0] = 77;
+      expected = h.context;
+      expected.pending_svc = ~UINT64_C(0);
+      h.service();
+      check(!memcmp(&h.context, &expected, sizeof(expected)) && h.exited,
+            "ExitProcess is void and preserves registers");
+    } else if (test == "entropy") {
+      Host h;
+      h.allowed_svcs.push_back(41);
+      h.entropy = {11, 22, UINT64_C(0xabcdef0123456789), 44};
+      h.entropy_available = true;
+      auto get = [&](uint64_t handle, uint64_t sub) {
+        for (unsigned i = 0; i < 32; ++i)
+          h.context.x[i] = 0x1000 + i;
+        h.context.pending_svc = 41;
+        h.context.x[1] = 11;
+        h.context.x[2] = handle;
+        h.context.x[3] = sub;
+        auto before = h.context;
+        h.service();
+        for (unsigned i = 2; i < 32; ++i)
+          check(h.context.x[i] == before.x[i],
+                "GetInfo preserves non-output registers");
+      };
+      get(0, 2);
+      check(h.context.x[0] == 0 && h.context.x[1] == h.entropy[2],
+            "per-process entropy output");
+      get(0, 2);
+      check(h.context.x[1] == h.entropy[2], "per-process entropy stable");
+      get(1, 0);
+      check(h.context.x[0] == (1u | (114u << 9)) && h.context.x[1] == 0,
+            "GetInfo invalidhandle realerror");
+      get(0, 4);
+      check(h.context.x[0] == (1u | (116u << 9)) && h.context.x[1] == 0,
+            "GetInfo invalidcombination realerror");
+      h.entropy_available = false;
+      h.context.pending_svc = 41;
+      h.context.x[1] = 11;
+      h.context.x[2] = 0;
+      h.context.x[3] = 0;
+      check(rejects([&] { h.service(); }),
+            "uninitialized entropy fails closed");
+    } else if (test == "real-clock") {
+      SteadyCounter clock;
+      const auto first = clock.ticks();
+      clock.sleep(2000000);
+      const auto second = clock.ticks();
+      check(second >= first + 38400,
+            "real native clock 19.2MHz and positive sleep");
+      Host h;
+      uint64_t slept = 0;
+      h.counter_override = [&] { return slept * 19200000 / 1000000000; };
+      h.sleep_override = [&](uint64_t ns) { slept += ns; };
+      h.context.pending_svc = 11;
+      h.context.x[0] = 100000000;
+      h.service();
+      check(slept == 100000000 && h.bridge.read_cntpct(&h) == 1920000 &&
+                h.context.x[0] == 100000000,
+            "clock/sleep adapters preserve real SVC register semantics");
+    } else if (test == "aslr-info") {
+      Host h;
+      h.allowed_svcs.push_back(41);
+      h.process_layout.emplace(UINT64_C(1) << 39);
+      auto get = [&](uint64_t type, uint64_t handle, uint64_t sub) {
+        h.context.pending_svc = 41;
+        h.context.x[1] = type;
+        h.context.x[2] = handle;
+        h.context.x[3] = sub;
+        auto before = h.context;
+        h.service();
+        for (unsigned i = 2; i < 32; ++i)
+          check(h.context.x[i] == before.x[i],
+                "process GetInfo register canaries");
+      };
+      get(12, 0xffff8001, 0);
+      check(h.context.x[0] == 0 && h.context.x[1] == 0x8000000,
+            "native owned ASLR region address");
+      get(13, 0xffff8001, 0);
+      check(h.context.x[1] == (UINT64_C(1) << 39) - 0x8000000,
+            "native owned ASLR region size");
+      get(12, 0, 0);
+      check(h.context.x[0] == (1u | (114u << 9)) && h.context.x[1] == 0,
+            "process info validates current-process handle");
+      get(12, 0xffff8001, 1);
+      check(h.context.x[0] == (1u | (120u << 9)) && h.context.x[1] == 0,
+            "process info validates subtype");
+    } else if (test == "stack-info") {
+      Host h;
+      AddressSpace space;
+      space.reserve(0x7000000000, UINT64_C(2) << 30, 11);
+      space.map(0x7000000000, {}, 4096, 3, 11);
+      h.address_space = &space;
+      h.process_layout.emplace(space.address_limit());
+      h.allowed_svcs.push_back(41);
+      auto get = [&](uint64_t type) {
+        h.context.pending_svc = 41;
+        h.context.x[1] = type;
+        h.context.x[2] = 0xffff8001;
+        h.context.x[3] = 0;
+        h.service();
+        check(h.context.x[0] == 0, "stack info result");
+      };
+      get(14);
+      check(h.context.x[1] == 0x7000000000, "GetInfo stack reserved address");
+      get(15);
+      check(h.context.x[1] == (UINT64_C(2) << 30),
+            "GetInfo stack reserved capacity distinct from committed");
+      check(space.committed_bytes() == 4096 &&
+                space.query(0x7000001000).state == 0,
+            "reservation does not fabricate mapped pages");
+      check(rejects([&] { space.map(0x7000001000, {}, 4096, 3, 5); }),
+            "heap mapping cannot invade stack reservation");
+    } else if (test == "thread-priority") {
+      Host h;
+      h.allowed_svcs.push_back(12);
+      auto handle = h.register_current_thread(7, 44, 0);
+      check(h.find_thread(handle) &&
+                h.find_thread(handle)->context == &h.context,
+            "native thread handle owns live context");
+      auto query = [&](uint64_t thread) {
+        h.context.pending_svc = 12;
+        h.context.x[1] = thread;
+        h.context.x[2] = 0xabcdef;
+        h.service();
+        check(h.context.x[2] == 0xabcdef,
+              "GetThreadPriority preserves canaries");
+      };
+      query(handle);
+      check(h.context.x[0] == 0 && h.context.x[1] == 44,
+            "GetThreadPriority reads actual registered metadata");
+      query(0xffff8000);
+      check(h.context.x[0] == 0 && h.context.x[1] == 44,
+            "current-thread pseudo handle resolves real object");
+      query(0x999);
+      check(h.context.x[0] == (1u | (114u << 9)) && h.context.x[1] == 0,
+            "unknown thread handle returns real invalidhandle error");
+    } else if (test == "reservation-info") {
+      Host h;
+      AddressSpace space;
+      space.reserve(UINT64_C(0x2000000000), UINT64_C(64) << 30, 7);
+      space.reserve(UINT64_C(0x100000000), UINT64_C(8) << 30, 5);
+      h.address_space = &space;
+      h.process_layout.emplace(space.address_limit());
+      h.allowed_svcs.push_back(41);
+      for (unsigned type = 2; type <= 5; ++type) {
+        h.context.pending_svc = 41;
+        h.context.x[1] = type;
+        h.context.x[2] = 0xffff8001;
+        h.context.x[3] = 0;
+        h.service();
+        auto range = space.reserved_range(type < 4 ? 7 : 5);
+        check(h.context.x[0] == 0 &&
+                  h.context.x[1] == (type % 2 ? range.size : range.address),
+              "GetInfo reports actual owned alias/heap reservations");
+      }
+      check(space.committed_bytes() == 0 && space.query(0x100000000).state == 0,
+            "reservation is virtual capacity not fabricated mapped RAM");
+      check(rejects([&] { space.map(0x2000000000, {}, 4096, 3, 5); }),
+            "normal memory cannot invade alias reservation");
+    } else if (test == "memory-accounting") {
+      Host h;
+      AddressSpace space;
+      space.set_physical_budget(8192);
+      space.map(0x1000, {}, 4096, 3);
+      h.address_space = &space;
+      h.process_layout.emplace(space.address_limit());
+      h.allowed_svcs.push_back(41);
+      auto get = [&](unsigned type) {
+        h.context.pending_svc = 41;
+        h.context.x[1] = type;
+        h.context.x[2] = 0xffff8001;
+        h.context.x[3] = 0;
+        h.service();
+        check(h.context.x[0] == 0, "memory info result");
+      };
+      get(6);
+      check(h.context.x[1] == 8192,
+            "total physical budget is actual enforced policy");
+      get(7);
+      check(h.context.x[1] == 4096,
+            "used physical memory is exact committed backing");
+      space.map(0x2000, {}, 4096, 3);
+      check(rejects([&] { space.map(0x3000, {}, 4096, 3); }) &&
+                space.committed_bytes() == 8192,
+            "memory budget rejects allocation beforeeffects");
+      check(rejects([&] { space.set_physical_budget(4096); }) &&
+                space.physical_budget() == 8192,
+            "budget cannot fall below committed backing");
+    } else if (test == "condition-signal") {
+      Host h;
+      std::vector<uint8_t> page(4096, 0x71);
+      h.map(0x3000, page.data(), 4096, 3);
+      h.allowed_svcs.push_back(29);
+      for (unsigned i = 0; i < 32; ++i)
+        h.context.x[i] = 0x100 + i;
+      h.context.pending_svc = 29;
+      h.context.x[0] = 0x3005;
+      h.context.x[1] = UINT64_MAX;
+      auto expected = h.context;
+      expected.pending_svc = ~UINT64_C(0);
+      h.service();
+      check(!memcmp(&h.context, &expected, sizeof(expected)) &&
+                h.read(0x3004, 4) == 0,
+            "SignalProcessWideKey aligns key, clears no-waiter flag, preserves "
+            "void-register ABI");
+      auto handle = h.register_current_thread(1, 44, 0);
+      h.condition_waiters[0x3004].push_back(handle);
+      h.write(0x3004, 4, 0xabcdef);
+      h.context.pending_svc = 29;
+      auto epoch = h.epoch;
+      check(rejects([&] { h.service(); }) && h.read(0x3004, 4) == 0xabcdef &&
+                h.epoch == epoch,
+            "unsupported blocked-waiter transition fails before effects");
+    } else if (test == "system-tick") {
+      Host h;
+      h.allowed_svcs.push_back(30);
+      h.counter_override = []() { return UINT64_C(0x123456789); };
+      h.context.pending_svc = 30;
+      h.context.x[1] = 0xabcdef;
+      h.service();
+      check(h.context.x[0] == 0x123456789 && h.context.x[1] == 0xabcdef,
+            "GetSystemTick has one direct counter output");
+    } else if (test == "ipc-wrapper") {
+      Host h;
+      std::vector<uint8_t> page(4096);
+      memcpy(page.data(), "test:", 6);
+      h.map(0x3000, page.data(), 4096, 3);
+      h.map(0x4000, page.data(), 4096, 3);
+      h.context.tpidrro_el0 = 0x4000;
+      h.register_current_thread(1, 44, 0);
+      h.allowed_svcs.insert(h.allowed_svcs.end(), {31, 33, 22, 24});
+      std::map<uint32_t, std::string> sessions;
+      h.connect_named_port = [&](const std::string &name) -> HandleResult {
+        check(name == "test:", "native named port decode");
+        sessions.emplace(0x10000, name);
+        return {0, 0x10000};
+      };
+      h.send_sync_request = [&](uint32_t handle, uint64_t tls) {
+        check(sessions.contains(handle) && tls == 0x4000,
+              "IPC endpoint owns handle and actual TLS binding");
+        h.write(tls, 4, 0xc0def00d);
+        return 0;
+      };
+      h.close_session = [&](uint32_t handle) {
+        return sessions.erase(handle) ? 0u : 1u | (114u << 9);
+      };
+      for (unsigned i = 0; i < 32; ++i)
+        h.context.x[i] = 0x1000 + i;
+      h.context.pending_svc = 31;
+      h.context.x[1] = 0x3000;
+      auto before = h.context;
+      h.service();
+      check(h.context.x[0] == 0 && h.context.x[1] == 0x10000 &&
+                sessions.contains(0x10000),
+            "Connect returns real owned session result/handle");
+      for (unsigned i = 2; i < 32; ++i)
+        check(h.context.x[i] == before.x[i],
+              "Connect preserves non-output registers");
+      h.context.pending_svc = 33;
+      h.context.x[0] = 0x10000;
+      before = h.context;
+      h.service();
+      check(h.context.x[0] == 0 && h.read(0x4000, 4) == 0xc0def00d,
+            "SendSyncRequest transport writes response via actual bus");
+      for (unsigned i = 1; i < 32; ++i)
+        check(h.context.x[i] == before.x[i],
+              "SendSyncRequest has only result output");
+      h.context.pending_svc = 22;
+      h.context.x[0] = 0x10000;
+      before = h.context;
+      h.service();
+      check(h.context.x[0] == 0 && sessions.empty(),
+            "Close removes actual session object");
+      for (unsigned i = 1; i < 32; ++i)
+        check(h.context.x[i] == before.x[i], "Close preserves other registers");
+      h.context.pending_svc = 24;
+      h.context.x[0] = 0x10000;
+      check(rejects([&] { h.service(); }),
+            "Svc0x18 WaitSynchronization must not be routed to CloseHandle");
+      h.connect_named_port = {};
+      h.context.pending_svc = 31;
+      h.context.x[1] = 0x3000;
+      check(rejects([&] { h.service(); }),
+            "missing provider fails explicitly without fake handle");
+    } else
+      throw std::runtime_error("unknown test");
+    std::cout << "PASS " << test << "\n";
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << "FAIL " << e.what() << "\n";
+    return 1;
+  }
+}
