+#include "host.h"
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <new>
+#include <thread>
+static std::atomic<bool> fail_allocation{false};
+void *operator new(size_t size) {
+  if (fail_allocation.exchange(false))
+    throw std::bad_alloc();
+  if (auto p = std::malloc(size ? size : 1))
+    return p;
+  throw std::bad_alloc();
+}
+void operator delete(void *p) noexcept { std::free(p); }
+void operator delete(void *p, size_t) noexcept { std::free(p); }
+using namespace native;
+static void check(bool value, const char *text) {
+  if (!value)
+    throw std::runtime_error(text);
+}
+template <class F> static bool rejects(F f) {
+  try {
+    f();
+  } catch (const std::exception &) {
+    return true;
+  }
+  return false;
+}
+template <class F> static void allocation_failure(F f) {
+  bool caught = false;
+  fail_allocation = true;
+  try {
+    f();
+  } catch (const std::bad_alloc &) {
+    caught = true;
+  }
+  fail_allocation = false;
+  check(caught, "injected actual allocation failure");
+}
+int main() {
+  try {
+    check(rejects([] { NativeEvent invalid(0); }),
+          "event requires real process ownership");
+    auto event = std::make_shared<NativeEvent>(77);
+    check(!event->IsSignaled() && !event->Reset(),
+          "native event starts unsignaled/reset invalid state");
+    event->Signal();
+    event->Signal();
+    check(event->IsSignaled() && event->Reset() && !event->IsSignaled(),
+          "manual reset/idempotent signal");
+    event->Clear();
+    event->Clear();
+    check(!event->IsSignaled(), "clear always clears");
+    std::thread producer([event] { event->Signal(); });
+    producer.join();
+    check(event->IsSignaled() && event->Reset(),
+          "real cross-thread event signal publication");
+    {
+      EventRegistry registry;
+      check(!registry.ReserveReadable(event, 77),
+            "unconfigured event ownership rejected");
+      registry.Configure(77);
+      registry.Configure(77);
+      check(rejects([&] { registry.Configure(88); }),
+            "process ownership cannot be rebound");
+      check(!registry.ReserveReadable(std::make_shared<NativeEvent>(88), 77) &&
+                !registry.ReserveReadable(event, 88) &&
+                !registry.ReserveReadable({}, 77),
+            "foreign/null event rejected before reservation");
+      allocation_failure([&] { registry.ReserveReadable(event, 77); });
+      check(registry.PublishedCount() == 0 && registry.ReservedCount() == 0,
+            "state allocation failure no handles");
+      auto transaction = registry.ReserveReadable(event, 77);
+      check(transaction && transaction->Handle() == EventHandleBegin &&
+                registry.ReservedCount() == 1 &&
+                !registry.GetReadable(transaction->Handle()) &&
+                !registry.Close(transaction->Handle()),
+            "reserved handle hidden until whole reply committed");
+      transaction.reset();
+      check(registry.ReservedCount() == 0,
+            "RAII failure rollback releases reservation");
+      allocation_failure([&] { registry.ReserveReadable(event, 77); });
+      check(registry.PublishedCount() == 0 && registry.ReservedCount() == 0,
+            "transaction allocation failure no slot/ID consumption");
+      transaction = registry.ReserveReadable(event, 77);
+      auto handle = transaction->Handle();
+      check(
+          handle == EventHandleBegin && transaction->Commit() &&
+              transaction->Commit(),
+          "rollback reclaims unpublished ID; commit idempotent/no allocation");
+      check(registry.PublishedCount() == 1 && registry.ReservedCount() == 0 &&
+                registry.GetReadable(handle) == event,
+            "published readable capability owns actual event");
+      for (auto invalid :
+           {MainThreadHandle, SessionHandleBegin, SessionHandleEnd - 1,
+            EventHandleEnd, CurrentProcessHandle, CurrentThreadHandle})
+        check(!registry.GetReadable(invalid) && !registry.Close(invalid),
+              "typed handle partitions/pseudos never alias event");
+      bool wrong_owner = false;
+      std::thread foreign([&] {
+        wrong_owner = rejects([&] { registry.GetReadable(handle); });
+      });
+      foreign.join();
+      check(wrong_owner, "registry mutation/query belongs to scheduler owner");
+      std::weak_ptr<NativeEvent> retained = event;
+      event.reset();
+      check(!retained.expired() && registry.Close(handle) &&
+                !registry.Close(handle) && retained.expired(),
+            "close once releases last readable reference");
+      auto next =
+          registry.ReserveReadable(std::make_shared<NativeEvent>(77), 77);
+      check(next->Handle() == EventHandleBegin + 1,
+            "published closed identities never reused");
+    }
+    {
+      std::unique_ptr<ScopedEventExport> transaction;
+      std::weak_ptr<NativeEvent> weak;
+      {
+        auto registry = std::make_unique<EventRegistry>();
+        registry->Configure(77);
+        auto resource = std::make_shared<NativeEvent>(77);
+        weak = resource;
+        transaction = registry->ReserveReadable(resource, 77);
+        resource.reset();
+        check(!weak.expired(), "reservation retains actual object");
+        registry.reset();
+        check(weak.expired(), "process teardown releases kernel references");
+      }
+      check(!transaction->Commit(),
+            "revoked process export cannot publish after teardown");
+      transaction.reset();
+    }
+    {
+      EventRegistry registry;
+      registry.Configure(77);
+      auto resource = std::make_shared<NativeEvent>(77);
+      for (uint32_t expected = EventHandleBegin; expected < EventHandleEnd;
+           ++expected) {
+        auto transaction = registry.ReserveReadable(resource, 77);
+        check(transaction && transaction->Handle() == expected &&
+                  transaction->Commit() && registry.Close(expected),
+              "bounded event allocation monotonic/no wrap");
+      }
+      check(!registry.ReserveReadable(resource, 77) &&
+                registry.ReservedCount() == 0 && registry.PublishedCount() == 0,
+            "partition exhaustion explicit without wrap/collision");
+    }
+    {
+      auto h = std::make_unique<Host>();
+      h->event_registry.Configure(77);
+      h->allowed_svcs.push_back(22);
+      auto resource = std::make_shared<NativeEvent>(77);
+      auto transaction = h->event_registry.ReserveReadable(resource, 77);
+      auto handle = transaction->Handle();
+      check(transaction->Commit(), "actual host event capability");
+      h->context.x[1] = 0x12345678;
+      h->context.pending_svc = 22;
+      h->context.x[0] = handle;
+      auto expected = h->context;
+      h->service();
+      expected.x[0] = 0;
+      expected.pending_svc = ~UINT64_C(0);
+      check(memcmp(&expected, &h->context, sizeof(expected)) == 0 &&
+                h->event_registry.PublishedCount() == 0,
+            "real SVC CloseHandle exact register canaries/event routing");
+      h->context.pending_svc = 22;
+      h->context.x[0] = handle;
+      h->service();
+      check(h->context.x[0] == (1u | (114u << 9)),
+            "double event close actual InvalidHandle");
+      h->context.pending_svc = 22;
+      h->context.x[0] = EventHandleEnd;
+      h->service();
+      check(h->context.x[0] == (1u | (114u << 9)),
+            "unknown handle namespace invalid without session fallback");
+    }
+    std::cout << "PASS native event: real signal/reset, typed ownership, "
+                 "allocation/rollback, lifetimes,65536 IDs, SVC canaries\n";
+    return 0;
+  } catch (const std::exception &e) {
+    fail_allocation = false;
+    std::cerr << "FAIL " << e.what() << "\n";
+    return 1;
+  }
+}
