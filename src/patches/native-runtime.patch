+# Native window test entry
+
+The standalone build and component instructions are in
+`native-runtime/window/CMakeLists.txt` and `native-runtime/window/README.md`.
+The test source remains `tests/native_platform/window_test.cpp`.
+This directory is a compatibility CMake entry that delegates to the component.
diff --git a/tests/native_platform/window_test.cpp b/tests/native_platform/window_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/native_platform/window_test.cpp
@@ -0,0 +1,131 @@
+#include "window.h"
+#include <atomic>
+#include <iostream>
+#include <memory>
+#include <stdexcept>
+#include <thread>
+using namespace native;
+void Check(bool value, const char *message) {
+  if (!value)
+    throw std::runtime_error(message);
+}
+void Drain(Window &window) {
+  while (window.Poll()) {
+  }
+}
+int main() {
+  try {
+    unsigned records = 0, active = 0, inactive = 0;
+    uint64_t last_source = 0;
+    for (unsigned iteration = 0; iteration < 3; ++iteration) {
+      auto owner =
+          std::make_unique<Window>(L"Native lifecycle observation test");
+      auto &window = *owner;
+      Check(window.source_id() > last_source &&
+                window.process_id() == GetCurrentProcessId(),
+            "fresh owned generation");
+      last_source = window.source_id();
+      Check(IsWindow(window.handle()) && IsWindowVisible(window.handle()),
+            "real visible owned HWND");
+      Check(GetWindowThreadProcessId(window.handle(), nullptr) ==
+                GetCurrentThreadId(),
+            "owner thread");
+      window.Pump();
+      uint64_t sequence = 0;
+      while (auto r = window.Poll()) {
+        Check(r->sequence > sequence &&
+                  r->owned_window ==
+                      reinterpret_cast<uintptr_t>(window.handle()),
+              "immutable owned ordered observation");
+        sequence = r->sequence;
+        ++records;
+        active += r->focus == WindowFocus::Active;
+        inactive += r->focus == WindowFocus::Inactive;
+      }
+      const auto before = window.focus();
+      // Synthetic same-state OS-message delivery tests suppression, not
+      // activation.
+      SendMessageW(window.handle(), WM_ACTIVATEAPP, TRUE, 0);
+      Drain(window);
+      SendMessageW(window.handle(), WM_ACTIVATEAPP, TRUE, 0);
+      Check(!window.Poll(), "duplicate snapshot suppressed");
+      Check(window.focus() == before,
+            "synthetic activation cannot invent foreground");
+      std::atomic<bool> rejected = false;
+      std::thread wrong([&] {
+        try {
+          window.Pump();
+        } catch (const std::logic_error &) {
+          rejected = true;
+        }
+      });
+      wrong.join();
+      Check(rejected, "wrong owner rejected");
+      const auto hwnd = window.handle();
+      // Posted close is explicitly synthetic test stimulus, not user-close
+      // proof.
+      std::thread post([hwnd] {
+        Sleep(10);
+        PostMessageW(hwnd, WM_CLOSE, 0, 0);
+      });
+      for (unsigned n = 0; n < 8 && !window.close_requested(); ++n)
+        window.WaitAndPump(std::chrono::milliseconds(50));
+      post.join();
+      Check(window.close_requested() && IsWindow(hwnd),
+            "idle pump observes close without destroying");
+      SendMessageW(hwnd, WM_CLOSE, 0, 0);
+      unsigned closes = 0;
+      while (auto r = window.Poll())
+        closes += r->close_requested;
+      Check(closes == 1, "close once");
+      wchar_t class_name[256]{};
+      Check(GetClassNameW(hwnd, class_name, 256) > 0, "registered class");
+      window.Destroy();
+      WNDCLASSEXW wc{};
+      wc.cbSize = sizeof(wc);
+      Check(!GetClassInfoExW(GetModuleHandleW(nullptr), class_name, &wc),
+            "class unregistered");
+      window.Destroy();
+      Check(!IsWindow(hwnd), "idempotent teardown");
+      Check(!window.Poll(), "teardown not close request");
+    }
+    {
+      auto owner = std::make_unique<Window>(L"Native bounded queue test", 1);
+      auto &window = *owner;
+      window.Pump();
+      Drain(window);
+      ShowWindow(window.handle(), SW_HIDE);
+      ShowWindow(window.handle(), SW_SHOWNOACTIVATE);
+      window.Pump();
+      Check(window.overflowed(),
+            "distinct real visibility transitions overflow explicitly");
+      SendMessageW(window.handle(), WM_CLOSE, 0, 0);
+      unsigned closes = 0;
+      while (auto r = window.Poll())
+        closes += r->close_requested;
+      Check(closes == 1, "overflow retains close");
+    }
+    {
+      auto owner = std::make_unique<Window>(L"Native thread quit distinction");
+      auto &window = *owner;
+      Drain(window);
+      PostQuitMessage(7);
+      window.Pump();
+      Check(window.quit_requested() && !window.close_requested(),
+            "thread quit distinct from exit request");
+      bool quit = false;
+      while (auto r = window.Poll())
+        if (r->source == WindowSource::ThreadQuit)
+          quit = !r->close_requested;
+      Check(quit, "quit observation retained");
+    }
+    std::cout << "{\"passed\":true,\"real_os_records\":" << records
+              << ",\"observed_active\":" << active
+              << ",\"observed_inactive\":" << inactive
+              << ",\"synthetic_close_test\":true,\"forced_foreground\":false,"
+                 "\"gpu\":false}\n";
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
