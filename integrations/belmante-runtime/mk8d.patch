+// Serialized graphics pipeline recipes and their bounded prewarm (docs/native-pipeline-recipes.md).
+//
+// A recipe is a value description of a graphics pipeline a previous run created: its two stages (the .spv name and
+// a digest of what pipeline creation reads from them) and every PipelineKey field except the stage pointers,
+// encoded field by field. Recipes are hints: workers build their pipelines ahead of use, and a draw whose pointer
+// cache misses adopts one only when its own key encodes to exactly the same value, in the same process. A stale
+// recipe can only cost prewarm work. NX_PIPELINE_RECIPES=1 (load, prewarm, record), capture (record only), unset/0:
+// off, nothing here runs. NX_PIPELINE_PREWARM_WORKERS=1..4 (2). NX_PIPELINE_STATS=1: the counters alone.
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "nvn_pipeline.h"
+
+namespace nx::nvn {
+
+// nvn_pipeline.cpp internals shared with the prewarm workers. Each is safe off the replay thread.
+using ModuleSource = VkShaderModule (*)(void* ctx, const ShaderInfo* s, const uint8_t* kinds, uint32_t unwritten,
+                                        float point_size);
+std::string module_kinds(const uint8_t* kinds);  // the 16 bytes a module is patched for (all zero: none)
+VkShaderModule make_module(const ShaderInfo* s, const std::string& kinds, uint32_t unwritten, float point_size,
+                           bool* patched);
+// The set layouts and dynamic uniform mask of a program (no pipeline layout made).
+void program_set_layouts(const std::vector<const ShaderInfo*>& stages, ProgramLayout& out);
+namespace recipes { struct Feedback; }
+// A new pipeline for `key` (no cache): what graphics_pipeline makes on a miss. Null when the driver refuses.
+VkPipeline create_graphics_pipeline(const PipelineKey& key, VkPipelineLayout layout, ModuleSource modules,
+                                    void* modules_ctx, uint64_t* create_ns, recipes::Feedback* made);
+// What graphics_pipeline would stop the process for (unsupported point size, fragment output type): false.
+bool graphics_key_admitted(const PipelineKey& key);
+
+namespace recipes {
+
+constexpr uint32_t kSchema = 1;       // the file's layout
+constexpr uint32_t kKeyEncoding = 1;  // encode_state's field list
+constexpr size_t kMaxRecipes = 8192;  // kept in the file (and prewarmed) at most
+constexpr size_t kMaxFileBytes = 64u << 20;
+
+using Digest = std::array<uint8_t, 20>;
+// value_key: the vertex digest, a fragment flag byte, the fragment digest (zero without one), then the state.
+constexpr size_t kValuePrefix = 2 * std::tuple_size_v<Digest> + 1;
+
+// SHA-1 over a domain tag, the stage, its SPIR-V words and the reflection fields pipeline creation reads (input and
+// output locations, components, types, arrays; bindings' set, binding, type, count).
+Digest stage_digest(const ShaderInfo& s);
+
+struct StageRef {
+    std::string hash;  // the .spv name; empty: no stage
+    Digest digest{};
+};
+struct Recipe {
+    StageRef vs, fs;
+    std::string state;   // encode_state
+    uint32_t order = 0;  // first use in the run that saved it
+    uint32_t runs = 1;   // runs that used it
+};
+
+// Every PipelineKey field except vs and fs, little-endian, in declaration order. decode_state rejects wrong sizes
+// and out-of-range counts; vs and fs come back null.
+std::string encode_state(const PipelineKey& k);
+bool decode_state(std::string_view bytes, PipelineKey& k);
+// The in-process identity a draw is matched by.
+std::string value_key(const Digest& vs, const Digest* fs, std::string_view state);
+
+struct FileInfo {
+    uint64_t profile = 0;                          // translation switches (diagnostic, not a compatibility gate)
+    uint32_t vendor = 0, device = 0, driver = 0;  // the device that saved it (diagnostic)
+};
+std::string serialize(const std::vector<Recipe>& recipes, const FileInfo& info);
+// False with a reason for a foreign, older, truncated, oversized or corrupted file; `out` is then empty.
+bool parse(std::string_view bytes, std::vector<Recipe>& out, FileInfo* info, std::string* why);
+// `.tmp` beside it, flushed, then moved over the old file in one step.
+bool write_atomic(const std::string& path, const std::string& bytes, std::string* why);
+bool read_whole_file(const std::string& path, std::string& bytes, size_t limit);
+// What a save keeps: this run's recipes in first-use order, then the older ones by their order, at most `cap`.
+std::vector<Recipe> merge_for_save(const std::vector<Recipe>& used, const std::vector<Recipe>& older, size_t cap);
+
+// ---- the engine (nvn_pipeline_prewarm.cpp) --------------------------------------------------------------------
+
+enum class Mode : uint8_t { Off, Capture, Prewarm };
+Mode mode();
+bool stats_enabled();  // recipes on, or NX_PIPELINE_STATS=1
+
+struct Feedback {
+    VkPipelineCreationFeedbackFlags flags = 0;
+    uint64_t duration = 0;
+};
+// graphics_pipeline's pointer-cache miss: a prewarmed pipeline for exactly this key and these set layouts (waiting
+// for one a worker is building), or null with `miss` set up for end_miss once the caller made it (a queued recipe is
+// claimed, so no worker builds it twice).
+struct Miss {
+    bool active = false;  // recipes on: end_miss records the key
+    std::string value;
+    bool claimed = false;
+    const ShaderInfo* vs = nullptr;
+    const ShaderInfo* fs = nullptr;
+};
+VkPipeline begin_miss(const PipelineKey& key, const ProgramLayout& layout, Miss& miss);
+void end_miss(const Miss& miss, const ProgramLayout& layout, VkPipeline made, uint64_t stall_ns, const Feedback& fb);
+void note_layout_created(uint64_t ns);
+void note_graphics_feedback(const Feedback& fb);  // a draw-path creation with recipes off (NX_PIPELINE_STATS=1)
+void note_compute_created(uint64_t ns, const Feedback& fb);
+
+void start();                          // after pipeline_cache(): loads the file, queues, starts the workers
+void window_log(uint64_t frames);      // one line per timing window (creation_log)
+void save_async();                     // the file, when this run added recipes (a background write)
+void stop(uint64_t wait_ms);           // workers leave between pipelines; waits for them at most wait_ms
+
+// Fixture hooks (tests/native_pipeline_recipe_probe.h).
+struct Counters {
+    uint64_t misses = 0, adopted = 0, waited = 0, claimed = 0, recorded = 0;
+    uint64_t built = 0, failed = 0, rejected = 0, queued = 0, layout_mismatch = 0;
+    uint64_t miss_ns = 0, wait_ns = 0, build_ns = 0;
+    uint64_t feedback_valid = 0, feedback_hits = 0, layouts = 0, layout_ns = 0, compute = 0, compute_ns = 0;
+    uint64_t released_modules = 0;
+};
+Counters counters();
+// Resets an idle engine to `m`, with recipes saved to `directory` and stages from `sources` (hash -> SPIR-V) before
+// the .spv files.
+void configure_for_test(Mode m, const std::string& directory,
+                        std::vector<std::pair<std::string, std::vector<uint32_t>>> sources);
+void enqueue(const std::vector<Recipe>& recipes);
+bool wait_idle(uint64_t timeout_ms);
+std::vector<Recipe> used_recipes();  // this run's, in first-use order
+bool save_now(std::string* why);
+std::string file_path();
+
+}  // namespace recipes
