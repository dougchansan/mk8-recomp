diff --git a/tests/native_nvn_builders/test.c b/tests/native_nvn_builders/test.c
new file mode 100644
index 0000000000000000000000000000000000000000..9cf048388df69799d6aeeb994d3b4336fb7fab52
--- /dev/null
+++ b/tests/native_nvn_builders/test.c
@@ -0,0 +1,145 @@
+#include "builders.h"
+#include <stdio.h>
+#include <string.h>
+
+#define CHECK(condition) do { if (!(condition)) { \
+    fprintf(stderr, "line %d: %s\n", __LINE__, #condition); return 1; } } while (0)
+
+typedef struct Trace {
+    uint64_t address;
+    size_t width;
+    unsigned char bytes[16];
+} Trace;
+typedef struct Fixture {
+    uint64_t base;
+    unsigned char memory[128];
+    Trace trace[8];
+    size_t calls, fail_call, partial;
+    uint64_t* alias_arguments;
+} Fixture;
+typedef struct ExpectedStore {
+    unsigned offset;
+    size_t width;
+    uint64_t first, second;
+} ExpectedStore;
+typedef struct Contract {
+    enum NativeNvnBuilderOperation operation;
+    size_t count;
+    ExpectedStore stores[6];
+} Contract;
+
+/* Independently transcribed from matched SDK instruction sequences: paired
+ * stores stay one trace event, and unscaled defaults stores remain reversed. */
+static const Contract contracts[] = {
+    {NATIVE_NVN_BUFFER_BUILDER_SET_DEVICE, 1, {{0,8,0x1122334455667788,0}}},
+    {NATIVE_NVN_BUFFER_BUILDER_SET_DEFAULTS, 2, {{16,16,0,0},{8,8,0,0}}},
+    {NATIVE_NVN_BUFFER_BUILDER_SET_STORAGE, 2,
+        {{8,16,0x1122334455667788,0x8877665544332211},{24,8,0xfedcba9876543210,0}}},
+    {NATIVE_NVN_MEMORY_POOL_BUILDER_SET_DEVICE, 1, {{0,8,0x1122334455667788,0}}},
+    {NATIVE_NVN_MEMORY_POOL_BUILDER_SET_DEFAULTS, 6,
+        {{8,16,0,0},{24,4,0x21,0},{52,4,0,0},{44,8,0,0},{36,8,0,0},{28,8,0,0}}},
+    {NATIVE_NVN_MEMORY_POOL_BUILDER_SET_STORAGE, 2,
+        {{8,16,0x1122334455667788,0x8877665544332211},{28,4,0,0}}},
+    {NATIVE_NVN_MEMORY_POOL_BUILDER_SET_FLAGS, 1, {{24,4,0x55667788,0}}},
+    {NATIVE_NVN_DEVICE_BUILDER_SET_DEFAULTS, 1, {{0,16,0,0}}},
+    {NATIVE_NVN_DEVICE_BUILDER_SET_FLAGS, 1, {{0,4,0x55667788,0}}}
+};
+
+static void reset(Fixture* f, uint64_t base) {
+    memset(f, 0, sizeof(*f));
+    f->base = base;
+    memset(f->memory, 0xa5, sizeof(f->memory));
+}
+static unsigned char expected_byte(const ExpectedStore* s, size_t i) {
+    return (unsigned char)((i < 8 ? s->first : s->second) >> (8 * (i % 8)));
+}
+static int write_guest(void* user, uint64_t address, const void* source, size_t width) {
+    Fixture* f = user;
+    Trace* t = &f->trace[f->calls++];
+    const unsigned char* bytes = source;
+    const int fail = f->calls == f->fail_call;
+    size_t written = fail ? f->partial : width;
+    t->address = address; t->width = width;
+    memcpy(t->bytes, source, width);
+    if (f->alias_arguments) f->alias_arguments[3] = 0;
+    for (size_t i = 0; i < written; ++i) {
+        uint64_t offset = address + (uint64_t)i - f->base;
+        if (offset >= sizeof(f->memory)) return 0;
+        f->memory[(size_t)offset] = bytes[i];
+    }
+    return !fail;
+}
+
+static int verify_contracts(void) {
+    const uint64_t bases[] = {0, 0x1003, UINT64_MAX - 12};
+    for (size_t c = 0; c < sizeof(contracts)/sizeof(contracts[0]); ++c) {
+        const Contract* contract = &contracts[c];
+        for (size_t b = 0; b < sizeof(bases)/sizeof(bases[0]); ++b) {
+            Fixture f;
+            uint64_t args[4] = {bases[b],0x1122334455667788,0x8877665544332211,0xfedcba9876543210};
+            uint64_t before[4];
+            unsigned char expected[128];
+            memcpy(before, args, sizeof(args));
+            memset(expected, 0xa5, sizeof(expected));
+            reset(&f, bases[b]);
+            CHECK(native_nvn_build(contract->operation,args,write_guest,&f)==NATIVE_NVN_OK);
+            CHECK(memcmp(args,before,sizeof(args))==0);
+            CHECK(f.calls==contract->count);
+            for (size_t k=0;k<contract->count;++k) {
+                const ExpectedStore* s=&contract->stores[k];
+                CHECK(f.trace[k].address==bases[b]+s->offset);
+                CHECK(f.trace[k].width==s->width);
+                for (size_t i=0;i<s->width;++i) {
+                    CHECK(f.trace[k].bytes[i]==expected_byte(s,i));
+                    expected[s->offset+i]=expected_byte(s,i);
+                }
+            }
+            CHECK(memcmp(f.memory,expected,sizeof(expected))==0);
+        }
+    }
+    return 0;
+}
+
+static int verify_faults(void) {
+    for (size_t c=0;c<sizeof(contracts)/sizeof(contracts[0]);++c) {
+        const Contract* contract=&contracts[c];
+        for (size_t fail=1;fail<=contract->count;++fail) {
+            Fixture f;
+            uint64_t args[4]={0x1001,0x1122334455667788,0x8877665544332211,0xfedcba9876543210};
+            unsigned char expected[128];
+            reset(&f,args[0]); f.fail_call=fail; f.partial=3;
+            memset(expected,0xa5,sizeof(expected));
+            CHECK(native_nvn_build(contract->operation,args,write_guest,&f)==NATIVE_NVN_WRITE_FAULT);
+            CHECK(f.calls==fail);
+            for (size_t k=0;k<fail;++k) {
+                const ExpectedStore* s=&contract->stores[k];
+                size_t written=k+1==fail?3:s->width;
+                for(size_t i=0;i<written;++i) expected[s->offset+i]=expected_byte(s,i);
+            }
+            CHECK(memcmp(f.memory,expected,sizeof(expected))==0);
+        }
+    }
+    return 0;
+}
+
+int main(void) {
+    Fixture f;
+    uint64_t args[4]={0,0x1122334455667788,0x8877665544332211,0xfedcba9876543210};
+    CHECK(verify_contracts()==0);
+    CHECK(verify_faults()==0);
+    reset(&f,0);
+    CHECK(native_nvn_build((enum NativeNvnBuilderOperation)15,args,write_guest,&f)==NATIVE_NVN_UNSUPPORTED);
+    CHECK(native_nvn_build((enum NativeNvnBuilderOperation)25,args,write_guest,&f)==NATIVE_NVN_UNSUPPORTED);
+    CHECK(native_nvn_build((enum NativeNvnBuilderOperation)-1,NULL,NULL,&f)==NATIVE_NVN_UNSUPPORTED);
+    CHECK(f.calls==0);
+    CHECK(native_nvn_build(NATIVE_NVN_BUFFER_BUILDER_SET_STORAGE,NULL,write_guest,&f)==NATIVE_NVN_INVALID_ARGUMENT);
+    CHECK(native_nvn_build(NATIVE_NVN_BUFFER_BUILDER_SET_STORAGE,args,NULL,&f)==NATIVE_NVN_INVALID_ARGUMENT);
+    CHECK(f.calls==0);
+    /* Callback effects may overlap the caller's argument array: inputs are
+     * captured before the first store, so later stores retain original values. */
+    f.alias_arguments=args;
+    CHECK(native_nvn_build(NATIVE_NVN_BUFFER_BUILDER_SET_STORAGE,args,write_guest,&f)==NATIVE_NVN_OK);
+    CHECK(f.trace[1].bytes[0]==0x10 && f.trace[1].bytes[7]==0xfe);
+    puts("native NVN builder instruction contracts passed");
+    return 0;
+}
